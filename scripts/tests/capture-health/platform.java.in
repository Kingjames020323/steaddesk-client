// Split at each package declaration to build the small public Android API surface
// used by the two production classes. The fixtures run on a host JVM.
package android.content;
public class Context {
    public void enforceCallingPermission(String permission, String message) {}
    public android.content.pm.PackageManager getPackageManager() {
        return new android.content.pm.PackageManager();
    }
}

package android.content;
public class ComponentName {
    public ComponentName(String app, String target) {}
}

package android.content;
public interface ServiceConnection {}

package android.content;
public class Intent {}

package android.content.pm;
public class PackageManager {
    public String[] getPackagesForUid(int uid) { return new String[] {"com.steaddesk.agent"}; }
}

package android.app;
public abstract class Service extends android.content.Context {
    public abstract android.os.IBinder onBind(android.content.Intent intent);
}

package android.os;
public interface IBinder {
    int FIRST_CALL_TRANSACTION = 1, FLAG_ONEWAY = 1;
    boolean transact(int code, Parcel data, Parcel reply, int flags) throws RemoteException;
}

package android.os;
public class Binder implements IBinder {
    public boolean transact(int code, Parcel data, Parcel reply, int flags) throws RemoteException {
        return onTransact(code, data, reply, flags);
    }
    protected boolean onTransact(int code, Parcel data, Parcel reply, int flags) throws RemoteException {
        return false;
    }
    public static int getCallingUid() { return 1; }
    public static long clearCallingIdentity() { return 1; }
    public static void restoreCallingIdentity(long token) {}
}

package android.os;
public class Parcel {
    public int value = -1;
    public void writeInt(int result) { value = result; }
    public void writeNoException() {}
    public void enforceInterface(String descriptor) {}
    public int dataAvail() { return 0; }
    public int readInt() { throw new IllegalStateException("Empty fixture parcel"); }
    public String readString() { throw new IllegalStateException("Empty fixture parcel"); }
}

package android.os;
public class RemoteException extends Exception {}

package com.steaddesk.recovery;
import android.content.*;
public class PeerWatchdog {
    public PeerWatchdog(Context context, ComponentName peer, String descriptor) {}
    public static ServiceConnection publish(Context context, Class<?> endpoint) { return null; }
    public static void unpublish(Context context, ServiceConnection connection) {}
    public void start() {}
    public void stop() {}
    public boolean isPaused() { return false; }
    public boolean isPeerUserStopped() { return false; }
    public String freshPeerUserStopped() { return ""; }
}

package androidx.annotation;
public @interface Keep {}
