+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/recent_search.dart';
+import 'package:flutter_hbb/steaddesk/windows_volumes.dart';
+
+void main() {
+  test(
+      'last ten distinct selections retain type, label and order after restart',
+      () {
+    final history = RecentSearchHistory('');
+    for (int i = 0; i < 12; i++) {
+      history.remember(RecentSearch('group/$i', 'Store $i', SearchKind.store));
+    }
+    history.remember(
+        const RecentSearch('group/4', 'Renamed store', SearchKind.store));
+    final restored = RecentSearchHistory(history.encode());
+    expect(restored.items.map((r) => r.key),
+        [4, 11, 10, 9, 8, 7, 6, 5, 3, 2].map((i) => 'group/$i'));
+    expect(restored.items.first.label, 'Renamed store');
+    expect(restored.items.first.kind, SearchKind.store);
+    restored.items.removeAt(0);
+    expect(RecentSearchHistory(restored.encode()).items.length, 9);
+    restored.items.clear();
+    expect(RecentSearchHistory(restored.encode()).items, isEmpty);
+  });
+  test('different support accounts use distinct local preference keys', () {
+    expect(RecentSearchHistory.option('a/b'),
+        isNot(RecentSearchHistory.option('a%2Fb')));
+  });
+  test('damaged preferences recover without blocking the search box', () {
+    for (final value in ['corrupt', '{}', '[["a","b","future"]]']) {
+      expect(RecentSearchHistory(value).items, isEmpty);
+    }
+  });
+  test('Windows lists the runner system volume and available bytes', () async {
+    final system = Platform.environment['SystemDrive']!.toUpperCase();
+    final drives = await readWindowsVolumes();
+    expect(drives.map((v) => v.root).toSet().length, drives.length);
+    final drive = drives.singleWhere((v) => v.root.substring(0, 2) == system);
+    expect(await Directory(drive.root).exists(), isTrue);
+    expect(drive.freeBytes, greaterThanOrEqualTo(0));
+  }, skip: !Platform.isWindows);
+}
