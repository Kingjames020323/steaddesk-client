diff --git a/flutter/lib/steaddesk/windows_volumes.dart b/flutter/lib/steaddesk/windows_volumes.dart
new file mode 100644
index 0000000..628ce04
--- /dev/null
+++ b/flutter/lib/steaddesk/windows_volumes.dart
@@ -0,0 +1,46 @@
+import 'dart:ffi';
+import 'dart:isolate';
+import 'package:ffi/ffi.dart';
+import 'package:win32/win32.dart';
+
+typedef LocalVolume = ({String root, String label, int? freeBytes});
+
+Future<List<LocalVolume>> readWindowsVolumes() => Isolate.run(_enumerate);
+
+List<LocalVolume> _enumerate() => using((arena) {
+      final volumes = <LocalVolume>[];
+      final oldMode = arena<Uint32>();
+      final changed = SetThreadErrorMode(
+              THREAD_ERROR_MODE.SEM_FAILCRITICALERRORS, oldMode) !=
+          0;
+      try {
+        final mask = GetLogicalDrives();
+        final label = arena<Uint16>(261).cast<Utf16>();
+        final available = arena<Uint64>();
+        for (int i = 0; i < 26; i++) {
+          if ((mask & (1 << i)) == 0) continue;
+          final root = '${String.fromCharCode(65 + i)}:\\';
+          final path = root.toNativeUtf16(allocator: arena);
+          final type = GetDriveType(path);
+          if (type == DRIVE_NO_ROOT_DIR || type == DRIVE_UNKNOWN) continue;
+          final named = GetVolumeInformation(
+                  path, label, 261, nullptr, nullptr, nullptr, nullptr, 0) !=
+              0;
+          if (!named && type == DRIVE_CDROM) {
+            final error = GetLastError();
+            if (error == WIN32_ERROR.ERROR_NOT_READY ||
+                error == WIN32_ERROR.ERROR_NO_MEDIA_IN_DRIVE) continue;
+          }
+          final free =
+              GetDiskFreeSpaceEx(path, available, nullptr, nullptr) != 0;
+          volumes.add((
+            root: root,
+            label: named ? label.toDartString() : '',
+            freeBytes: free ? available.value : null
+          ));
+        }
+      } finally {
+        if (changed) SetThreadErrorMode(oldMode.value, nullptr);
+      }
+      return volumes;
+    });
