+    /// Return the locally configured identity without exporting the secret half.
+    pub fn staging_public_identity() -> Option<(String, Vec<u8>)> {
+        let cfg = CONFIG.read().ok()?;
+        if !(9..=10).contains(&cfg.id.len()) || !cfg.id.bytes().all(|c| c.is_ascii_digit())
+            || cfg.key_pair.1.len() != 32 {
+            return None;
+        }
+        Some((cfg.id.clone(), cfg.key_pair.1.clone()))
+    }
+
     pub fn get_cached_pk() -> Option<Vec<u8>> {
         KEY_PAIR.lock().unwrap().clone().map(|k| k.1)
     }
