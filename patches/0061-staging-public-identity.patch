+    /// Read only an existing on-disk identity; Config::load may generate a new ID.
+    #[cfg(target_os = "android")]
+    pub fn staging_public_identity() -> Option<(String, Vec<u8>)> {
+        #[derive(Deserialize)]
+        struct StoredIdentity {
+            #[serde(default)]
+            id: String,
+            #[serde(default)]
+            enc_id: String,
+            key_pair: (serde::de::IgnoredAny, Vec<u8>),
+        }
+
+        let text = std::fs::read_to_string(Self::file_("")).ok()?;
+        let stored: StoredIdentity = toml::from_str(&text).ok()?;
+        let public = stored.key_pair.1;
+        let key = sodiumoxide::crypto::secretbox::Key::from_slice(&public)?;
+        let id = if stored.enc_id.is_empty() {
+            stored.id
+        } else {
+            let encoded = stored.enc_id.strip_prefix("00")?;
+            let bytes = base64::decode(encoded, base64::Variant::Original).ok()?;
+            let id = crate::password_security::open_secretbox_payload(&bytes, &key).ok()?;
+            String::from_utf8(id).ok()?
+        };
+        if !(9..=10).contains(&id.len()) || !id.bytes().all(|c| c.is_ascii_digit()) {
+            return None;
+        }
+        Some((id, public))
+    }
