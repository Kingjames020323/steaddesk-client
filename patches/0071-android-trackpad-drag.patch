@@ -0,0 +1,32 @@
+package com.carriez.flutter_hbb
+
+import android.accessibilityservice.GestureDescription
+import android.graphics.Path
+import android.os.Build
+import androidx.annotation.RequiresApi
+import kotlin.math.min
+
+internal object MerchantPinch {
+    // The wire value is (cumulative scale - 1) * 1000. Commit one two-finger
+    // gesture on release so successive accessibility dispatches cannot cancel it.
+    @RequiresApi(Build.VERSION_CODES.N)
+    fun gesture(x: Int, y: Int, width: Int, height: Int, delta: Int): GestureDescription? {
+        if (width < 8 || height < 2 || delta == 0) return null
+        val ratio = 1f + delta.coerceIn(-750, 3000) / 1000f
+        val maxRadius = (width - 1) / 2f
+        val initial = min(min(width, height) * 0.12f, maxRadius / maxOf(1f, ratio))
+        val target = initial * ratio
+        val radius = maxOf(initial, target)
+        val center = x.toFloat().coerceIn(radius, maxOf(radius, width - 1f - radius))
+        val cy = y.coerceIn(0, height - 1).toFloat()
+        val builder = GestureDescription.Builder()
+        for (side in listOf(-1, 1)) {
+            val path = Path().apply {
+                moveTo(center + side * initial, cy)
+                lineTo(center + side * target, cy)
+            }
+            builder.addStroke(GestureDescription.StrokeDescription(path, 0, 150))
+        }
+        return builder.build()
+    }
+}
