@@ -0,0 +1,37 @@
+import 'dart:ui';
+import 'package:flutter/gestures.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/models/android_trackpad_drag.dart';
+
+// Exercise the same signal classification, gesture timer and mouse serialization
+// that feed sessionSendMouse. No peer or platform accessibility API is required.
+void main() {
+  testWidgets('fine Windows scroll signals send one anchored left drag',
+      (tester) async {
+    final packets = <Map<String, String>>[];
+    final drag = AndroidTrackpadDrag(packets.add, () => true);
+    const position = Offset(80, 70);
+    for (var i = 0; i < 3; i++) {
+      final event = PointerScrollEvent(
+          position: position,
+          scrollDelta: const Offset(-4, 2),
+          timeStamp: Duration(milliseconds: i * 8),
+          kind: PointerDeviceKind.mouse);
+      drag.update(event.position, AndroidTrackpadDrag.wheelDragDelta(event)!,
+          const Rect.fromLTWH(0, 0, 200, 100), event.timeStamp);
+      await tester.pump(const Duration(milliseconds: 8));
+    }
+    await tester.pump(const Duration(milliseconds: 91));
+    expect(packets.last['type'], '');
+    await tester.pump(const Duration(milliseconds: 1));
+    expect(packets.map((p) => [p['type'], p['buttons'], p['x'], p['y']]), [
+      ['', '', '80', '70'],
+      ['down', 'left', '0', '0'],
+      ['', 'left', '84', '68'],
+      ['', 'left', '88', '66'],
+      ['', 'left', '92', '64'],
+      ['', 'left', '104', '58'],
+      ['up', 'left', '0', '0'],
+    ]);
+  });
+}
