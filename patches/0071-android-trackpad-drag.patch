index 0000000..db231ba
--- /dev/null
+++ b/flutter/test/steaddesk/android_trackpad_test.dart
@@ -0,0 +1,83 @@
+import 'dart:ui';
+import 'package:flutter/gestures.dart';
+import 'package:flutter_hbb/models/android_trackpad_drag.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  const bounds = Rect.fromLTWH(5, 10, 100, 60);
+  const origin = Offset(10, 20);
+  final packets = <Map<String, String>>[];
+  late AndroidTrackpadDrag drag;
+  var allowed = true;
+  void pan(double x, double y, int ms) =>
+      drag.update(origin, Offset(x, y), bounds, Duration(milliseconds: ms));
+  setUp(() {
+    packets.clear();
+    allowed = true;
+    drag = AndroidTrackpadDrag(packets.add, () => allowed);
+  });
+  tearDown(() => drag.cancel());
+
+  test('fractional motion accumulates and clamps both axes including inertia',
+      () {
+    pan(2.2, 2.2, 0);
+    pan(0.4, 0.4, 8);
+    expect(packets.last, {'type': '', 'buttons': 'left', 'x': '13', 'y': '23'});
+    pan(500, -400, 16);
+    drag.finish();
+    expect(packets[packets.length - 2],
+        {'type': '', 'buttons': 'left', 'x': '104', 'y': '10'});
+    expect(packets.where((p) => p['type'] == 'up'), hasLength(1));
+  });
+
+  test('stationary edge pressure and subpixel jitter cannot synthesize a tap',
+      () {
+    drag.update(
+        const Offset(5, 10), const Offset(-12, -12), bounds, Duration.zero);
+    drag.finish();
+    pan(0.3, 0.4, 0);
+    drag.finish();
+    expect(packets, isEmpty);
+  });
+
+  test('99ms gap continues, 100ms gap releases and reanchors', () {
+    pan(0, 3, 0);
+    pan(0, 3, 99);
+    pan(-2, 0, 199);
+    expect(packets.where((p) => p['type'] == 'down'), hasLength(2));
+    expect(packets.where((p) => p['type'] == 'up'), hasLength(1));
+    expect(packets.last['x'], '8');
+  });
+
+  testWidgets(
+      'release, loss of control and disconnected cancellation stop delayed moves',
+      (tester) async {
+    pan(1, 2, 0);
+    pan(5, 10, 8);
+    allowed = false;
+    final n = packets.length;
+    await tester.pump(AndroidTrackpadDrag.gap);
+    expect(packets.length, n + 1);
+    expect(packets.last['type'], 'up');
+    pan(2, 3, 110);
+    expect(packets.length, n + 1);
+    allowed = true;
+    pan(2, 3, 120);
+    drag.cancel(release: false);
+    final afterDisconnect = packets.length;
+    await tester.pump(const Duration(seconds: 2));
+    expect(packets, hasLength(afterDisconnect));
+  });
+
+  test('ordinary wheel keeps detents while forced drag trial reaches the edge',
+      () {
+    const wheel = PointerScrollEvent(scrollDelta: Offset(0, 120));
+    expect(AndroidTrackpadDrag.wheelDragDelta(wheel), isNull);
+    drag.update(origin, -wheel.scrollDelta, bounds, Duration.zero);
+    expect(packets.last['y'], '10');
+    drag.cancel();
+    const precise = PointerScrollEvent(
+        kind: PointerDeviceKind.trackpad, scrollDelta: Offset(0, 120));
+    expect(AndroidTrackpadDrag.wheelDragDelta(precise), const Offset(0, -120));
+  });
+}
diff --git a/flutter/test/windows_smoke/android_trackpad_test.dart b/flutter/test/windows_smoke/android_trackpad_test.dart
