+import 'dart:async';
+import 'dart:math' as math;
+import 'dart:ui';
+import 'package:flutter/gestures.dart';
+
+const reverseAndroidTrackpadKey = 'steaddesk-reverse-android-trackpad';
+
+/// Mouse packets consumed by session_send_mouse. Button events use the last
+/// absolute position, so every new drag starts with an unpressed move.
+class AndroidTrackpadDrag {
+  AndroidTrackpadDrag(this.send, this.canMove);
+  final void Function(Map<String, String>) send;
+  final bool Function() canMove;
+
+  static const gap = Duration(milliseconds: 100);
+  Timer? _idle;
+  Duration? _last;
+  Offset _point = Offset.zero;
+  Offset _velocity = Offset.zero;
+  Rect _bounds = Rect.zero;
+  Offset _origin = Offset.zero;
+  bool _pressed = false;
+  bool get active => _last != null;
+
+  /// Some Windows drivers expose only mouse-like scroll signals. Tiny deltas
+  /// are a heuristic in that case. Native PanZoom does not need this fallback.
+  static Offset? wheelDragDelta(PointerScrollEvent event) {
+    final delta = event.scrollDelta;
+    if (delta == Offset.zero) return null;
+    final fine = math.max(delta.dx.abs(), delta.dy.abs()) < 12;
+    return event.kind == PointerDeviceKind.trackpad || fine ? -delta : null;
+  }
+
+  void update(Offset origin, Offset delta, Rect bounds, Duration time) {
+    if (delta == Offset.zero || bounds.width < 1 || bounds.height < 1) return;
+    if (!canMove()) {
+      cancel();
+      return;
+    }
+    final last = _last;
+    if (last != null &&
+        (bounds != _bounds || time < last || time - last >= gap)) {
+      finish(inertia: bounds == _bounds && time >= last);
+    }
+    _bounds = bounds;
+    if (!active) {
+      _point = _clamp(origin);
+      _origin = _point;
+      _velocity = Offset.zero;
+    } else {
+      final ms = (time - _last!).inMicroseconds / 1000;
+      if (ms > 0) _velocity = delta / math.max(1.0, ms);
+    }
+    _last = time;
+    _move(delta);
+    _idle?.cancel();
+    _idle = Timer(gap, finish);
+  }
+
+  Offset _clamp(Offset p) => Offset(
+      p.dx.clamp(_bounds.left, _bounds.right - 1).toDouble(),
+      p.dy.clamp(_bounds.top, _bounds.bottom - 1).toDouble());
+
+  Map<String, String> _packet(String type, String buttons, Offset p) => {
+        'type': type,
+        'buttons': buttons,
+        'x': '${p.dx.round()}',
+        'y': '${p.dy.round()}'
+      };
+
+  void _move(Offset delta) {
+    final next = _clamp(_point + delta);
+    if (!_pressed) {
+      // Accumulate subpixel input without turning stationary jitter into taps.
+      if ((next - _origin).distance < 2) {
+        _point = next;
+        return;
+      }
+      send(_packet('', '', _origin));
+      send(_packet('down', 'left', Offset.zero));
+      _pressed = true;
+    }
+    if (_point.dx.round() != next.dx.round() ||
+        _point.dy.round() != next.dy.round()) {
+      send(_packet('', 'left', next));
+    }
+    _point = next;
+  }
+
+  void finish({bool inertia = true}) {
+    if (!active) return;
+    if (_pressed && inertia && canMove()) {
+      final tail = _velocity * 24;
+      if (tail.distance >= 1) {
+        _move(tail.distance > 48 ? tail * (48 / tail.distance) : tail);
+      }
+    }
+    cancel();
+  }
+
+  void cancel({bool release = true}) {
+    _idle?.cancel();
+    _idle = null;
+    if (_pressed && release) send(_packet('up', 'left', Offset.zero));
+    _pressed = false;
+    _last = null;
+    _velocity = Offset.zero;
+  }
+}
