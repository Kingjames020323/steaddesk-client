--- a/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/BootReceiver.kt
+++ b/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/BootReceiver.kt
@@ -30,7 +30,7 @@ class BootReceiver : BroadcastReceiver() {
                 action = ACT_INIT_MEDIA_PROJECTION_AND_SERVICE
                 putExtra(EXT_INIT_FROM_BOOT, true)
             }
-            if (!fromUpdate) {
+            if (!fromUpdate && BuildConfig.SHOW_BOOT_TOAST) {
                 Toast.makeText(context, R.string.steaddesk_service_started, Toast.LENGTH_LONG).show()
             }
             if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
