Subject: Default merchant boot recovery to silent and show the version on both panels

diff --git a/flutter/android/app/build.gradle b/flutter/android/app/build.gradle
index e7f9b32..d26bfe7 100644
--- a/flutter/android/app/build.gradle
+++ b/flutter/android/app/build.gradle
@@ -61,13 +61,18 @@ protobuf {
     }
 }
 
+def merchantEdition = file('../../../libs/hbb_common/src/steaddesk_support.rs').text.trim() == 'false'
+// Merchant recovery is silent by default. Package updates are always silent.
+def showMerchantBootToast = false
+
 android {
     namespace "com.carriez.flutter_hbb"
     compileSdkVersion 36
+    buildFeatures { buildConfig = true }
     sourceSets {
         main.java.srcDirs += 'src/main/kotlin'
         // The same build-time selector governs the native policy and provider packaging.
-        if (file('../../../libs/hbb_common/src/steaddesk_support.rs').text.trim() == 'false') {
+        if (merchantEdition) {
             main.manifest.srcFile 'src/steaddeskStaging/AndroidManifest.xml'
             main.java.srcDir 'src/steaddeskStaging/java'
         }
@@ -85,6 +90,7 @@ android {
     defaultConfig {
         // TODO: Specify your own unique Application ID (https://developer.android.com/studio/build/application-id.html).
         applicationId "com.steaddesk.remote"
+        buildConfigField "boolean", "SHOW_BOOT_TOAST", (!merchantEdition || showMerchantBootToast).toString()
         minSdkVersion 22
         targetSdkVersion 36
         versionCode releaseCode
diff --git a/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/BootReceiver.kt b/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/BootReceiver.kt
