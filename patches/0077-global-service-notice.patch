+    await h.close(t);
+  });
+
+  testWidgets(
+      'stale admin save displays latest, retains drafts and requires explicit resubmit',
+      (t) async {
+    final h = _Harness(true)..api.publish();
+    await h.mount(t);
+    await h.open(t);
+    await t.enterText(find.byKey(const ValueKey('notice-zh')), '我的维护提示');
+    await t.pump();
+    expect(find.text('我的维护提示'), findsNWidgets(2));
+    h.api.publish(zh: '另一位管理员的提示', level: 'outage');
+    await t.tap(find.text('保存'));
+    await t.pumpAndSettle();
+    expect(find.text('这条提示刚被别人改过，已显示最新内容，请确认后再保存。'), findsOneWidget);
+    expect(find.text('中文 · 另一位管理员的提示'), findsOneWidget);
+    expect(find.text('服务器版本 2'), findsOneWidget);
+    expect(find.text('我的维护提示'), findsNWidgets(2));
+    expect(h.api.writes.map((w) => w.version), [1]);
+    await t.tap(find.text('确认后保存'));
+    await t.pumpAndSettle();
+    expect(find.byType(AlertDialog), findsNothing);
+    expect(find.text('我的维护提示'), findsOneWidget);
+    expect(h.api.writes.map((w) => w.version), [1, 2]);
+    expect(h.api.writes.last.key, isNot(h.api.writes.first.key));
+    await h.open(t);
+    await t.tap(find.text('结束提示'));
+    await t.pumpAndSettle();
+    expect(h.api.writes, hasLength(2));
+    await t.tap(find.text('确认结束'));
+    await t.pumpAndSettle();
+    expect(h.api.row.version, 4);
