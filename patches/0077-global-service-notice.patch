@@ -0,0 +1,278 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:uuid/uuid.dart';
+import '../ops_health.dart' show HealthFailure;
+import '../service_notice.dart';
+import 'notice.dart';
+
+const _levelNames = {'info': '消息', 'degraded': '服务受影响', 'outage': '服务中断'};
+const _languages = {'zh': '中文', 'en': 'English', 'es': 'Español'};
+
+class NoticeEditor extends StatefulWidget {
+  final StaffNotices notices;
+  final String language;
+  const NoticeEditor(this.notices, this.language, {super.key});
+
+  @override
+  State<NoticeEditor> createState() => _NoticeEditorState();
+}
+
+class _NoticeEditorState extends State<NoticeEditor> {
+  final _form = GlobalKey<FormState>();
+  final _texts = {'zh': '', 'en': '', 'es': ''};
+  late String _previewLanguage;
+  String _level = 'info', _minutes = '60';
+  String? _error;
+  NoticeSnapshot? _base, _conflict;
+  bool _busy = true, _clearConfirmation = false;
+  ({String key, NoticeBody? body})? _pending;
+  late final Timer _session;
+
+  bool get _authorized =>
+      mounted && widget.notices.active && widget.notices.admin;
+
+  @override
+  void initState() {
+    super.initState();
+    final saved = widget.language.toLowerCase().split(RegExp('[-_]')).first;
+    _previewLanguage = _languages.containsKey(saved) ? saved : 'en';
+    _load();
+    _session = Timer.periodic(const Duration(milliseconds: 400), (_) {
+      if (mounted && !_authorized) {
+        final route = ModalRoute.of(context);
+        if (route != null && route.isActive) {
+          route.navigator?.removeRoute(route);
+        }
+      }
+    });
+  }
+
+  @override
+  void dispose() {
+    _session.cancel();
+    super.dispose();
+  }
+
+  Future<void> _load() async {
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    try {
+      final latest = await widget.notices.read();
+      if (!_authorized) return;
+      final notice = latest.notice;
+      setState(() {
+        _base = latest;
+        if (notice != null) {
+          _level = notice.level;
+          for (final lang in _languages.keys) {
+            _texts[lang] = notice.textFor(lang);
+          }
+          _minutes =
+              ((notice.endsAt.difference(widget.notices.now()).inSeconds / 60)
+                      .ceil()
+                      .clamp(1, 1440))
+                  .toString();
+        }
+      });
+    } catch (_) {
+      if (_authorized) setState(() => _error = '无法读取服务状态提示，请重试。');
+    } finally {
+      if (_authorized) setState(() => _busy = false);
+    }
+  }
+
+  void _changed(VoidCallback apply) => setState(() {
+        apply();
+        _pending = null;
+        _error = null;
+        _clearConfirmation = false;
+      });
+
+  Future<void> _save({bool clear = false}) async {
+    if (_busy || !_authorized || _base == null) return;
+    if (!clear && !_form.currentState!.validate()) return;
+    if (clear && !_clearConfirmation) {
+      setState(() => _clearConfirmation = true);
+      return;
+    }
+    if (_pending == null || (_pending!.body == null) != clear) {
+      final start = widget.notices.now().millisecondsSinceEpoch ~/ 1000;
+      _pending = (
+        key: const Uuid().v4(),
+        body: clear
+            ? null
+            : {
+                'level': _level,
+                for (final lang in _languages.keys) 'text_$lang': _texts[lang]!,
+                'starts_at': start,
+                'ends_at': start + int.parse(_minutes) * 60,
+              }
+      );
+    }
+    final request = _pending!;
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    try {
+      await widget.notices.write(_base!.version, request.key, request.body);
+      if (_authorized) Navigator.pop(context);
+    } on NoticeConflict catch (e) {
+      if (_authorized) {
+        setState(() {
+          _base = _conflict = e.latest;
+          _pending = null;
+          _clearConfirmation = false;
+          _error = '这条提示刚被别人改过，已显示最新内容，请确认后再保存。';
+        });
+      }
+    } catch (e) {
+      if (_authorized) {
+        setState(() => _error = switch (e) {
+              HealthFailure(status: 400) => '请检查三种提示文字和时长，不可包含链接或 HTML。',
+              HealthFailure(status: 403) => '只有管理员可以修改服务状态提示。',
+              _ => '提交未确认，请重试。',
+            });
+      }
+    } finally {
+      if (_authorized) setState(() => _busy = false);
+    }
+  }
+
+  Widget _latest(NoticeSnapshot snapshot) {
+    final n = snapshot.notice;
+    final material = MaterialLocalizations.of(context);
+    String format(DateTime value) {
+      final local = value.toLocal();
+      return '${material.formatShortDate(local)} ${material.formatTimeOfDay(TimeOfDay.fromDateTime(local))}';
+    }
+
+    return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+      Text('服务器版本 ${snapshot.version}',
+          style: Theme.of(context).textTheme.titleSmall),
+      if (n == null)
+        const Text('当前没有有效提示。')
+      else ...[
+        Text(
+            '${_levelNames[n.level]} · ${format(n.startsAt)} – ${format(n.endsAt)}'),
+        for (final lang in _languages.keys)
+          Text('${_languages[lang]} · ${n.textFor(lang)}'),
+      ],
+    ]);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final editable = !_busy && _authorized;
+    final now = widget.notices.now();
+    final preview = _texts[_previewLanguage]!;
+    return AlertDialog(
+      title: const Text('服务状态提示'),
+      scrollable: true,
+      content: SizedBox(
+          width: 480,
+          child: Form(
+            key: _form,
+            child: Column(
+                mainAxisSize: MainAxisSize.min,
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  if (_base != null) ...[
+                    DropdownButtonFormField<String>(
+                        value: _level,
+                        decoration: const InputDecoration(labelText: '级别'),
+                        items: [
+                          for (final level in _levelNames.entries)
+                            DropdownMenuItem(
+                                value: level.key, child: Text(level.value))
+                        ],
+                        onChanged: editable
+                            ? (v) => _changed(() => _level = v!)
+                            : null),
+                    for (final lang in _languages.entries)
+                      TextFormField(
+                          key: ValueKey('notice-${lang.key}'),
+                          initialValue: _texts[lang.key],
+                          enabled: editable,
+                          decoration: InputDecoration(labelText: lang.value),
+                          onChanged: (s) =>
+                              _changed(() => _texts[lang.key] = s),
+                          validator: (s) =>
+                              s != null && validServiceNoticeText(s)
+                                  ? null
+                                  : '请输入 1–140 个字符的单行纯文本，不能包含链接或 HTML。'),
+                    TextFormField(
+                        key: const ValueKey('notice-duration'),
+                        initialValue: _minutes,
+                        enabled: editable,
+                        keyboardType: TextInputType.number,
+                        decoration: const InputDecoration(labelText: '时长（分钟）'),
+                        validator: (s) {
+                          final n = int.tryParse(s ?? '');
+                          return n != null && n >= 1 && n <= 1440
+                              ? null
+                              : '请输入 1 至 1440 分钟。';
+                        },
+                        onChanged: (s) => _changed(() => _minutes = s)),
+                    const SizedBox(height: 12),
+                    Row(children: [
+                      Expanded(
+                          child: Text('预览',
+                              style: Theme.of(context).textTheme.titleSmall)),
+                      DropdownButton<String>(
+                          value: _previewLanguage,
+                          items: [
+                            for (final lang in _languages.entries)
+                              DropdownMenuItem(
+                                  value: lang.key, child: Text(lang.value))
+                          ],
+                          onChanged: (v) =>
+                              setState(() => _previewLanguage = v!)),
+                    ]),
+                    if (validServiceNoticeText(preview))
+                      ServiceNoticeBanner(
+                          notice: ServiceNotice(
+                              level: _level,
+                              textZh: _texts['zh']!,
+                              textEn: _texts['en']!,
+                              textEs: _texts['es']!,
+                              startsAt: now,
+                              endsAt: now.add(const Duration(minutes: 1)),
+                              version: _base!.version),
+                          language: _previewLanguage)
+                    else
+                      const Text('输入提示文字后可预览。'),
+                  ],
+                  if (_busy) const LinearProgressIndicator(),
+                  if (_error != null)
+                    Padding(
+                        padding: const EdgeInsets.symmetric(vertical: 8),
+                        child: Text(_error!,
+                            style: TextStyle(
+                                color: Theme.of(context).colorScheme.error))),
+                  if (_conflict case final latest?) _latest(latest),
+                  if (_clearConfirmation) const Text('确认结束当前服务状态提示？'),
+                ]),
+          )),
+      actions: [
+        if (_base?.notice != null)
+          TextButton(
+              onPressed: editable ? () => _save(clear: true) : null,
+              child: Text(_clearConfirmation ? '确认结束' : '结束提示')),
+        TextButton(
+            onPressed: _busy ? null : () => Navigator.pop(context),
+            child: const Text('取消')),
+        if (_base == null)
+          TextButton(
+              onPressed: editable ? _load : null, child: const Text('重新读取'))
+        else
+          FilledButton(
+              onPressed: editable ? () => _save() : null,
+              child: Text(_conflict == null ? '保存' : '确认后保存')),
+      ],
+    );
+  }
+}
