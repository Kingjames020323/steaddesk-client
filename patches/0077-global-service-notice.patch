diff --git a/flutter/test/steaddesk/merchant_service_notice_test.dart b/flutter/test/steaddesk/merchant_service_notice_test.dart
new file mode 100644
index 0000000..1ecb47d
--- /dev/null
+++ b/flutter/test/steaddesk/merchant_service_notice_test.dart
@@ -0,0 +1,181 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/steaddesk/help/merchant_help_widget.dart';
+import 'package:flutter_hbb/steaddesk/service_notice.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+Map<String, dynamic> wire(
+        {String level = 'info', int start = 100, int end = 700}) =>
+    {
+      'level': level,
+      'text_zh': '服务维护',
+      'text_en': 'Service maintenance',
+      'text_es': 'Mantenimiento del servicio',
+      'starts_at': start,
+      'ends_at': end,
+      'version': 1
+    };
+
+void main() {
+  test('notice response and full language fallback', () {
+    expect(ServiceNotice.fromResponse({'notice': null}), isNull);
+    expect(() => ServiceNotice.fromResponse({}), throwsFormatException);
+    expect(() => ServiceNotice.fromResponse({'notice': {}}),
+        throwsFormatException);
+    for (final json in [
+      wire(end: 86501),
+      wire(end: 99),
+      wire(start: -1),
+      wire(level: 'other'),
+      {...wire(), 'version': 0},
+      {...wire(), 'text_es': ''}
+    ]) {
+      expect(() => ServiceNotice.fromJson(json), throwsFormatException);
+    }
+    final n = ServiceNotice.fromJson(wire());
+    expect([n.textFor('zh-CN'), n.textFor('es_MX'), n.textFor('fr-FR')],
+        [n.textZh, n.textEs, n.textEn]);
+    expect(n.activeAt(n.startsAt), isTrue);
+    expect(n.activeAt(n.endsAt), isFalse);
+  });
+
+  test('plain text counts Unicode code points and rejects unsafe input', () {
+    for (final text in [
+      '',
+      ' ',
+      'a' * 141,
+      'a\nb',
+      'https',
+      '<',
+      'example.com',
+      'http：／／example.com',
+      'ｗｗｗ．example．com',
+      '192.0.2.1',
+      'mailto:user',
+      'tel:123',
+      'abc\u2028x',
+      'abc\u200Dx'
+    ]) {
+      expect(validServiceNoticeText(text), isFalse, reason: text);
+    }
+    expect(validServiceNoticeText('🧰' * 140), isTrue);
+    expect(validServiceNoticeText('计划维护完成。'), isTrue);
+    expect(validServiceNoticeText('El servicio está disponible.'), isTrue);
+  });
+
+  testWidgets('three severity icons, palettes and locales in both themes',
+      (t) async {
+    final backgrounds = <Color>{};
+    for (final mode in [Brightness.light, Brightness.dark]) {
+      for (final item in [
+        ('info', 'zh-CN', Icons.info_outline),
+        ('degraded', 'es', Icons.warning_amber_rounded),
+        ('outage', 'en', Icons.error_outline)
+      ]) {
+        final n = ServiceNotice.fromJson(wire(level: item.$1));
+        await t.pumpWidget(MaterialApp(
+            themeAnimationDuration: Duration.zero,
+            theme: ThemeData(brightness: mode),
+            home: Scaffold(
+                body: ServiceNoticeBanner(notice: n, language: item.$2))));
+        expect(find.text(n.textFor(item.$2)), findsOneWidget);
+        expect(find.byIcon(item.$3), findsOneWidget);
+        final colored = find.descendant(
+            of: find.byType(ServiceNoticeBanner),
+            matching: find.byType(ColoredBox));
+        backgrounds.add(t.widget<ColoredBox>(colored).color);
+      }
+    }
+    expect(backgrounds, hasLength(6));
+  });
+
+  testWidgets(
+      'panel and queued help share one read, keep cached on failure, expire independently',
+      (t) async {
+    int calls = 0;
+    final start = t.binding.clock.now();
+    final second = start.millisecondsSinceEpoch ~/ 1000;
+    final finish = Completer<ServiceNotice?>();
+    Future<ServiceNotice?> read() async {
+      calls++;
+      if (calls == 1)
+        return ServiceNotice.fromJson(wire(start: second, end: second + 330));
+      if (calls == 2) throw StateError('offline');
+      return finish.future;
+    }
+
+    final wait = HelpWaiting(
+        view: const {'state': 'queued'},
+        cards: const [],
+        now: second,
+        online: false,
+        busy: false,
+        label: (x) => x,
+        act: (_, __) {});
+    Widget host(String lang) => MaterialApp(
+        home: Scaffold(
+            body: MerchantNoticeHost(
+                now: t.binding.clock.now,
+                read: read,
+                language: lang,
+                child: wait)));
+    await t.pumpWidget(host('zh-CN'));
+    await t.pump();
+    expect(find.text('服务维护'), findsOneWidget);
+    expect(find.text('Waiting for 0 min'), findsOneWidget);
+    expect(t.getTopLeft(find.byType(ServiceNoticeBanner)).dy,
+        lessThan(t.getTopLeft(find.byType(HelpWaiting)).dy));
+    await t.pumpWidget(host('es'));
+    expect(find.text('Mantenimiento del servicio'), findsOneWidget);
+    expect(calls, 1);
+    await t.pump(const Duration(minutes: 5));
+    expect(calls, 2);
+    expect(find.byType(ServiceNoticeBanner), findsOneWidget);
+    await t.pump(const Duration(seconds: 30));
+    expect(find.byType(ServiceNoticeBanner), findsNothing);
+    await t.pump(const Duration(minutes: 5));
+    expect(calls, 3);
+    await t.pumpWidget(const SizedBox());
+    finish.complete(null);
+    await t.pump();
+    expect(t.takeException(), isNull);
+  });
+
+  testWidgets(
+      'cold failures, late starts, clear, and resume respect polling interval',
+      (t) async {
+    int calls = 0;
+    final second = t.binding.clock.now().millisecondsSinceEpoch ~/ 1000;
+    Future<ServiceNotice?> read() async {
+      calls++;
+      if (calls == 1) throw StateError('unavailable');
+      if (calls == 2)
+        return ServiceNotice.fromJson(
+            wire(start: second + 310, end: second + 950));
+      return null;
+    }
+
+    await t.pumpWidget(MaterialApp(
+        home: MerchantNoticeHost(
+            language: 'en',
+            read: read,
+            now: t.binding.clock.now,
+            child: const SizedBox())));
+    await t.pump();
+    expect(find.byType(ServiceNoticeBanner), findsNothing);
+    await t.pump(const Duration(minutes: 5));
+    expect(calls, 2);
+    expect(find.byType(ServiceNoticeBanner), findsNothing);
+    await t.pump(const Duration(seconds: 10));
+    expect(find.text('Service maintenance'), findsOneWidget);
+    t.binding.handleAppLifecycleStateChanged(AppLifecycleState.paused);
+    await t.pump(const Duration(minutes: 5));
+    expect(calls, 2);
+    t.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+    await t.pump(Duration.zero);
+    expect(calls, 3);
+    expect(find.byType(ServiceNoticeBanner), findsNothing);
+    await t.pumpWidget(const SizedBox());
+  });
+}
