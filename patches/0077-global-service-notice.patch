diff --git a/flutter/lib/steaddesk/today/notice.dart b/flutter/lib/steaddesk/today/notice.dart
new file mode 100644
index 0000000..5a97754
--- /dev/null
+++ b/flutter/lib/steaddesk/today/notice.dart
@@ -0,0 +1,104 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import '../ops_health.dart' show HealthFailure;
+import '../service_notice.dart';
+
+typedef NoticeSnapshot = ({int version, ServiceNotice? notice});
+typedef NoticeBody = Map<String, dynamic>;
+
+NoticeSnapshot decodeNotice(Object? version, NoticeBody data) {
+  if (version is! int || version < 0 || !data.containsKey('notice')) {
+    throw const FormatException('无效的服务提示版本');
+  }
+  final notice = ServiceNotice.fromResponse(data);
+  if (notice != null && notice.version != version) {
+    throw const FormatException('服务提示版本不一致');
+  }
+  return (version: version, notice: notice);
+}
+
+class NoticeConflict implements Exception {
+  final NoticeSnapshot latest;
+  NoticeConflict(this.latest);
+}
+
+abstract interface class StaffNoticeApi {
+  Future<NoticeSnapshot> fetchNotice();
+  Future<NoticeSnapshot> changeNotice(
+      int version, String key, NoticeBody? body);
+}
+
+class StaffNotices extends ChangeNotifier {
+  final StaffNoticeApi api;
+  final bool admin;
+  final bool Function() current;
+  final DateTime Function() now;
+  StaffNotices(this.api, this.current,
+      {required this.admin, DateTime Function()? now})
+      : now = now ?? DateTime.now;
+  NoticeSnapshot? snapshot;
+  Timer? _expiry, _poll;
+  bool _closed = false;
+  bool get active => !_closed && current();
+  ServiceNotice? get visible {
+    final row = snapshot?.notice;
+    return active && row != null && row.activeAt(now()) ? row : null;
+  }
+
+  void start() {
+    unawaited(refresh());
+    _poll = Timer.periodic(const Duration(minutes: 5), (_) => refresh());
+  }
+
+  void _accept(NoticeSnapshot value) {
+    if (!active || value.version < (snapshot?.version ?? -1)) return;
+    snapshot = value;
+    _expiry?.cancel();
+    final row = visible;
+    if (row != null) {
+      _expiry = Timer(row.endsAt.difference(now()), () {
+        if (active) notifyListeners();
+      });
+    }
+    notifyListeners();
+  }
+
+  Future<NoticeSnapshot> read() async {
+    if (!active) throw const HealthFailure(401);
+    final value = await api.fetchNotice();
+    if (!active) throw const HealthFailure(401);
+    _accept(value);
+    return snapshot!;
+  }
+
+  Future<void> refresh() async {
+    try {
+      await read();
+    } catch (e) {
+      if (active && e is HealthFailure && {401, 403}.contains(e.status)) {
+        snapshot = null;
+        _expiry?.cancel();
+        notifyListeners();
+      }
+    }
+  }
+
+  Future<void> write(int version, String key, NoticeBody? body) async {
+    if (!active || !admin) throw const HealthFailure(403);
+    try {
+      _accept(await api.changeNotice(version, key, body));
+    } on NoticeConflict catch (conflict) {
+      _accept(conflict.latest);
+      rethrow;
+    }
+  }
+
+  @override
+  void dispose() {
+    _closed = true;
+    _expiry?.cancel();
+    _poll?.cancel();
+    super.dispose();
+  }
+}
