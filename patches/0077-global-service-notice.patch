new file mode 100644
index 0000000..2eb11a2
--- /dev/null
+++ b/flutter/lib/steaddesk/service_notice.dart
@@ -0,0 +1,248 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+final _noticeLink = RegExp(
+    r'http|[<>]|[a-z][a-z0-9+.\-]*://|www\.|(?:mailto|tel|data|javascript):'
+    r'|(?:[a-z0-9-]+\.)+(?:[a-z]{2,63}|[0-9]{1,3})(?![a-z0-9-])',
+    caseSensitive: false);
+final _noticeControl = RegExp(r'[\p{C}\p{Z}]', unicode: true);
+
+bool validServiceNoticeText(String value) {
+  if (value.trim().isEmpty ||
+      value.runes.length > 140 ||
+      _noticeControl.hasMatch(value.replaceAll(' ', ''))) return false;
+  // Full-width punctuation and letters are commonly entered with a CJK keyboard.
+  final folded = String.fromCharCodes(
+      value.runes.map((r) => r >= 0xff01 && r <= 0xff5e ? r - 0xfee0 : r));
+  return !_noticeLink.hasMatch(folded);
+}
+
+class ServiceNotice {
+  final String level, textZh, textEn, textEs;
+  final DateTime startsAt, endsAt;
+  final int version;
+
+  const ServiceNotice({
+    required this.level,
+    required this.textZh,
+    required this.textEn,
+    required this.textEs,
+    required this.startsAt,
+    required this.endsAt,
+    required this.version,
+  });
+
+  factory ServiceNotice.fromJson(Map<String, dynamic> json) {
+    final level = json['level'];
+    final zh = json['text_zh'], en = json['text_en'], es = json['text_es'];
+    final start = json['starts_at'],
+        end = json['ends_at'],
+        version = json['version'];
+    if (!const {'info', 'degraded', 'outage'}.contains(level) ||
+        zh is! String ||
+        en is! String ||
+        es is! String ||
+        ![zh, en, es].every(validServiceNoticeText) ||
+        start is! int ||
+        end is! int ||
+        start < 0 ||
+        end > 253402300799 ||
+        end <= start ||
+        end - start > 86400 ||
+        version is! int ||
+        version <= 0) {
+      throw const FormatException('Invalid service notice');
+    }
+    return ServiceNotice(
+        level: level,
+        textZh: zh,
+        textEn: en,
+        textEs: es,
+        startsAt:
+            DateTime.fromMillisecondsSinceEpoch(start * 1000, isUtc: true),
+        endsAt: DateTime.fromMillisecondsSinceEpoch(end * 1000, isUtc: true),
+        version: version);
+  }
+
+  static ServiceNotice? fromResponse(Map<String, dynamic> response) {
+    final item = response['notice'];
+    if (item == null && response.containsKey('notice')) return null;
+    if (item is! Map<String, dynamic>) {
+      throw const FormatException('Missing service notice');
+    }
+    return ServiceNotice.fromJson(item);
+  }
+
+  bool activeAt(DateTime now) =>
+      !now.isBefore(startsAt) && now.isBefore(endsAt);
+
+  String textFor(String language) =>
+      switch (language.toLowerCase().split(RegExp('[-_]')).first) {
+        'zh' => textZh,
+        'es' => textEs,
+        _ => textEn,
+      };
+}
+
+class ServiceNoticeBanner extends StatelessWidget {
+  final ServiceNotice notice;
+  final String language;
+  const ServiceNoticeBanner(
+      {super.key, required this.notice, required this.language});
+
+  @override
+  Widget build(BuildContext context) {
+    final dark = Theme.of(context).brightness == Brightness.dark;
+    final (icon, background, foreground) = switch ((notice.level, dark)) {
+      ('degraded', false) => (
+          Icons.warning_amber_rounded,
+          const Color(0xffffefc2),
+          const Color(0xff734600)
+        ),
+      ('degraded', true) => (
+          Icons.warning_amber_rounded,
+          const Color(0xff463315),
+          const Color(0xffffd48a)
+        ),
+      ('outage', false) => (
+          Icons.error_outline,
+          const Color(0xffffe4e2),
+          const Color(0xff98271e)
+        ),
+      ('outage', true) => (
+          Icons.error_outline,
+          const Color(0xff4d252b),
+          const Color(0xffffb9b2)
+        ),
+      (_, true) => (
+          Icons.info_outline,
+          const Color(0xff19394e),
+          const Color(0xffa8ddff)
+        ),
+      _ => (
+          Icons.info_outline,
+          const Color(0xffe0f2ff),
+          const Color(0xff145778)
+        ),
+    };
+    return Semantics(
+        liveRegion: true,
+        child: ColoredBox(
+            color: background,
+            child: Padding(
+                padding:
+                    const EdgeInsets.symmetric(horizontal: 16, vertical: 9),
+                child: Row(children: [
+                  Icon(icon, size: 19, color: foreground),
+                  const SizedBox(width: 9),
+                  Expanded(
+                      child: Text(notice.textFor(language),
+                          style: TextStyle(
+                              color: foreground,
+                              fontSize: 14,
+                              fontWeight: FontWeight.w600,
+                              height: 1.3))),
+                ]))));
+  }
+}
+
+class MerchantNoticeHost extends StatefulWidget {
+  final Future<ServiceNotice?> Function() read;
+  final DateTime Function() now;
+  final String language;
+  final Widget child;
+
+  const MerchantNoticeHost(
+      {super.key,
+      required this.read,
+      required this.language,
+      required this.child,
+      this.now = DateTime.now});
+
+  @override
+  State<MerchantNoticeHost> createState() => _MerchantNoticeHostState();
+}
+
+class _MerchantNoticeHostState extends State<MerchantNoticeHost>
+    with WidgetsBindingObserver {
+  static const interval = Duration(minutes: 5);
+  ServiceNotice? cached;
+  Timer? poll, boundary;
+  DateTime? nextPoll;
+  bool busy = false, foreground = true;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    refresh();
+  }
+
+  Future<void> refresh() async {
+    if (busy || !foreground) return;
+    busy = true;
+    nextPoll = widget.now().add(interval);
+    try {
+      final value = await widget.read();
+      if (mounted) cached = value;
+    } catch (_) {
+      // Keep the last successful response until its independent expiry.
+    } finally {
+      busy = false;
+      if (mounted && foreground) schedule();
+    }
+  }
+
+  void schedule() {
+    poll?.cancel();
+    boundary?.cancel();
+    final now = widget.now();
+    final value = cached;
+    if (value != null) {
+      if (!now.isBefore(value.endsAt)) {
+        cached = null;
+      } else {
+        final at = now.isBefore(value.startsAt) ? value.startsAt : value.endsAt;
+        boundary = Timer(at.difference(now), schedule);
+      }
+    }
+    setState(() {});
+    if (!busy) poll = Timer((nextPoll ?? now).difference(now), refresh);
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    foreground = state == AppLifecycleState.resumed;
+    if (foreground) {
+      schedule();
+    } else {
+      poll?.cancel();
+      boundary?.cancel();
+    }
+  }
+
+  @override
+  void dispose() {
+    poll?.cancel();
+    boundary?.cancel();
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final now = widget.now();
+    final language = widget.language.isEmpty
+        ? WidgetsBinding.instance.platformDispatcher.locale.toLanguageTag()
+        : widget.language;
+    final notice = cached;
+    // The queued help view is embedded in this panel. Keep a single banner
+    // above its scrollable content throughout the help flow.
+    return Column(children: [
+      if (notice != null && notice.activeAt(now))
+        ServiceNoticeBanner(notice: notice, language: language),
+      Expanded(child: widget.child),
+    ]);
+  }
+}
