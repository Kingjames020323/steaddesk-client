+
+  testWidgets(
+      'validates text and duration, retries identical intent and closes on account change',
+      (t) async {
+    final h = _Harness(true);
+    await h.mount(t);
+    await h.open(t);
+    for (final lang in ['zh', 'en', 'es']) {
+      await t.enterText(find.byKey(ValueKey('notice-$lang')),
+          lang == 'en' ? 'https://example.org' : 'Maint');
+    }
+    final duration = find.byKey(const ValueKey('notice-duration'));
+    await t.enterText(duration, '1441');
+    await t.tap(find.text('保存'));
+    await t.pumpAndSettle();
+    expect(find.textContaining('请输入 1–140'), findsOneWidget);
+    expect(find.text('请输入 1 至 1440 分钟。'), findsOneWidget);
+    expect(h.api.writes, isEmpty);
+    await t.enterText(find.byKey(const ValueKey('notice-en')), 'Maintenance');
+    await t.enterText(duration, '1440');
+    h.api.uncertain = true;
+    await t.tap(find.text('保存'));
+    await t.pumpAndSettle();
+    expect(find.text('提交未确认，请重试。'), findsOneWidget);
+    h.now = h.now.add(const Duration(seconds: 10));
+    h.api.uncertain = false;
+    await t.tap(find.text('保存'));
+    await t.pumpAndSettle();
+    expect(h.api.writes, hasLength(2));
+    expect(h.api.writes.first, h.api.writes.last);
+    expect(h.api.row.notice!.endsAt.difference(h.api.row.notice!.startsAt),
+        const Duration(days: 1));
+    await h.open(t);
+    h.current = false;
+    await t.pump(const Duration(seconds: 1));
+    await t.pumpAndSettle();
+    expect(find.byType(AlertDialog), findsNothing);
+    expect(h.api.writes, hasLength(2));
+    await h.close(t);
+  });
+}
