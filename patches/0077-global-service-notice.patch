index 0000000..e6db6ed
--- /dev/null
+++ b/flutter/test/steaddesk/today_notice_test.dart
@@ -0,0 +1,189 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/ops_health.dart' show HealthFailure;
+import 'package:flutter_hbb/steaddesk/service_notice.dart';
+import 'package:flutter_hbb/steaddesk/today/data.dart';
+import 'package:flutter_hbb/steaddesk/today/notice.dart';
+import 'package:flutter_hbb/steaddesk/today/panel.dart';
+import 'today_test.dart' show Fixture;
+
+class _Api implements StaffNoticeApi {
+  final DateTime now;
+  bool failed = false, uncertain = false;
+  final writes = <({int version, String key, NoticeBody? body})>[];
+  NoticeSnapshot row = (version: 0, notice: null);
+  _Api(this.now);
+  void publish(
+      {String zh = '系统维护',
+      String en = 'Scheduled maintenance',
+      String es = 'Mantenimiento programado',
+      String level = 'info',
+      int seconds = 3600}) {
+    final version = row.version + 1;
+    row = (
+      version: version,
+      notice: ServiceNotice(
+          level: level,
+          textZh: zh,
+          textEn: en,
+          textEs: es,
+          startsAt: now,
+          endsAt: now.add(Duration(seconds: seconds)),
+          version: version)
+    );
+  }
+
+  @override
+  Future<NoticeSnapshot> fetchNotice() async {
+    if (failed) throw const HealthFailure(503);
+    return row;
+  }
+
+  @override
+  Future<NoticeSnapshot> changeNotice(
+      int version, String key, NoticeBody? body) async {
+    writes.add((version: version, key: key, body: body));
+    if (uncertain) throw const HealthFailure(503);
+    if (version != row.version) throw NoticeConflict(row);
+    return row = body == null
+        ? (version: version + 1, notice: null)
+        : decodeNotice(version + 1, {
+            'notice': {...body, 'version': version + 1}
+          });
+  }
+}
+
+class _Harness {
+  final fixture = Fixture();
+  final bool admin;
+  bool current = true;
+  DateTime now = DateTime.utc(2026, 11, 20);
+  late final api = _Api(now);
+  late final notices =
+      StaffNotices(api, () => current, admin: admin, now: () => now);
+  late final store = TodayStore(fixture, () => current, notices: notices);
+  _Harness(this.admin);
+  Future<void> mount(WidgetTester t, {String language = 'zh'}) async {
+    t.view.physicalSize = const Size(1100, 850);
+    t.view.devicePixelRatio = 1;
+    addTearDown(t.view.resetPhysicalSize);
+    addTearDown(t.view.resetDevicePixelRatio);
+    store.start();
+    await t.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: TodayPanel(store: store, noticeLanguage: language))));
+    await t.pump();
+  }
+
+  Future<void> close(WidgetTester t) async {
+    await t.pumpWidget(const SizedBox());
+    store.dispose();
+  }
+
+  Future<void> open(WidgetTester t) async {
+    await t.tap(find.text('服务状态提示'));
+    await t.pumpAndSettle();
+    expect(find.byType(AlertDialog), findsOneWidget);
+  }
+}
+
+void main() {
+  testWidgets(
+      'staff see only active localized notice; polling failures, SSE and expiry',
+      (t) async {
+    final h = _Harness(false)..api.failed = true;
+    await h.mount(t, language: 'es-MX');
+    expect(find.byType(ServiceNoticeBanner), findsNothing);
+    expect(find.text('服务状态提示'), findsNothing);
+    h.api.failed = false;
+    h.api.publish(seconds: 12, level: 'degraded');
+    h.fixture.feed.add('service.notice.changed');
+    await t.pumpAndSettle();
+    expect(find.text('Mantenimiento programado'), findsOneWidget);
+    h.api.failed = true;
+    await h.notices.refresh();
+    expect(find.text('Mantenimiento programado'), findsOneWidget);
+    h.now = h.now.add(const Duration(seconds: 12));
+    await t.pump(const Duration(seconds: 12));
+    expect(find.byType(ServiceNoticeBanner), findsNothing);
+    await expectLater(
