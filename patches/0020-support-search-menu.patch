+part of 'support_home.dart';
+
+typedef _Choice = ({String key, String label, _Entry? row, String? scope});
+
+class _SupportSearchField extends StatefulWidget {
+  final TextEditingController search;
+  final FocusNode focus;
+  final ValueChanged<String> onSearch, jump;
+  final _DirectoryState? Function() directory;
+  const _SupportSearchField(
+      {required this.search,
+      required this.focus,
+      required this.onSearch,
+      required this.jump,
+      required this.directory});
+  @override
+  State<_SupportSearchField> createState() => _SupportSearchFieldState();
+}
+
+class _SupportSearchFieldState extends State<_SupportSearchField> {
+  final portal = OverlayPortalController();
+  final scroll = ScrollController();
+  final tileKeys = <String, GlobalKey>{};
+  String? selected;
+  bool menuOpen = false;
+  @override
+  void initState() {
+    super.initState();
+    widget.focus.addListener(_focus);
+  }
+
+  @override
+  void dispose() {
+    widget.focus.removeListener(_focus);
+    scroll.dispose();
+    super.dispose();
+  }
+
+  void _focus() {
+    if (widget.focus.hasFocus) {
+      if (widget.search.text.trim().isNotEmpty) portal.show();
+    } else if (!menuOpen) {
+      _close();
+    }
+  }
+
+  void _close() {
+    selected = null;
+    if (portal.isShowing) portal.hide();
+  }
+
+  void _change(String value) {
+    selected = null;
+    widget.onSearch(value);
+    if (value.trim().isEmpty) {
+      _close();
+      return;
+    }
+    portal.show();
+  }
+
+  List<_Choice> _choices(List<_Entry> entries) {
+    final q = widget.search.text.trim();
+    final term = q.toLowerCase();
+    final groups = <String, String>{};
+    for (final e in entries) {
+      final d = e.device;
+      // Group navigation targets the address-book tree, not history-only peers.
+      if (d.merchant == null ||
+          (e.source.tab != PeerTabIndex.ab &&
+              e.source.tab != PeerTabIndex.group)) continue;
+      final merchant = d.merchant!;
+      final label =
+          [if (d.groupName.isNotEmpty) d.groupName, merchant].join(' · ');
+      final store = '$merchant/${d.store}';
+      if (label.toLowerCase().contains(term)) groups[merchant] = label;
+      if ('$label ${d.store}'.toLowerCase().contains(term) ||
+          store.toLowerCase().contains(term)) {
+        groups[store] = '$label › ${d.store}';
+      }
+    }
+    return [
+      if (RegExp(r'^[0-9 ]+$').hasMatch(q))
+        (key: 'direct', label: q, row: null, scope: null),
+      for (final e
+          in entries.where((e) => e.device.matchesSuggestion(q)).take(8))
+        (
+          key: 'peer/${e.device.id}',
+          label: e.device.alias.isNotEmpty
+              ? e.device.alias
+              : e.device.name.isNotEmpty
+                  ? e.device.name
+                  : e.device.id,
+          row: e,
+          scope: null
+        ),
+      for (final g in groups.entries)
+        (key: 'group/${g.key}', label: g.value, row: null, scope: g.key)
+    ];
+  }
+
+  bool _enabled(_Choice c) =>
+      c.key != 'direct' || directSupportId(widget.search.text) != null;
+
+  void _activate(_Choice? item) {
+    final dir = widget.directory();
+    if (dir == null) return;
+    final query = widget.search.text;
+    if (item != null && !_enabled(item)) return;
+    _close();
+    if (item?.scope != null) {
+      widget.jump(item!.scope!);
+      return;
+    }
+    if (item?.row != null) {
+      dir._connect(item!.row!);
+      return;
+    }
+    dir.submit(query, dir._entries(searchIndex: true));
+  }
+
+  KeyEventResult _key(FocusNode node, KeyEvent event) {
+    if (event is KeyUpEvent || !widget.search.value.composing.isCollapsed)
+      return KeyEventResult.ignored;
+    final k = event.logicalKey;
+    if (k == LogicalKeyboardKey.enter || k == LogicalKeyboardKey.numpadEnter) {
+      if (event is KeyDownEvent) _submit(widget.search.text);
+      return KeyEventResult.handled;
+    }
+    if (!portal.isShowing) return KeyEventResult.ignored;
+    if (k == LogicalKeyboardKey.escape) {
+      _close();
+      return KeyEventResult.handled;
+    }
+    if (k != LogicalKeyboardKey.arrowDown && k != LogicalKeyboardKey.arrowUp)
+      return KeyEventResult.ignored;
+    final dir = widget.directory();
+    if (dir == null) return KeyEventResult.ignored;
+    final items =
+        _choices(dir._entries(searchIndex: true)).where(_enabled).toList();
+    if (items.isNotEmpty) {
+      final i = items.indexWhere((x) => x.key == selected);
+      final j = i < 0
+          ? (k == LogicalKeyboardKey.arrowDown ? 0 : items.length - 1)
+          : (i + (k == LogicalKeyboardKey.arrowDown ? 1 : -1))
+              .clamp(0, items.length - 1)
+              .toInt();
+      setState(() => selected = items[j].key);
+      WidgetsBinding.instance.addPostFrameCallback((_) {
+        final ctx = tileKeys[items[j].key]?.currentContext;
+        if (ctx != null) Scrollable.ensureVisible(ctx, alignment: .5);
+      });
+    }
+    return KeyEventResult.handled;
+  }
+
+  void _submit(String _) {
+    final dir = widget.directory();
+    if (dir == null) return;
+    final items = _choices(dir._entries(searchIndex: true));
+    _activate(portal.isShowing
+        ? items.firstWhereOrNull((c) => c.key == selected)
+        : null);
+  }
+
+  @override
+  Widget build(BuildContext context) => LayoutBuilder(builder: (ctx, size) {
+        return OverlayPortal(
+            controller: portal,
+            overlayChildBuilder: (overlayContext) {
+              final box = ctx.findRenderObject() as RenderBox;
+              final overlay =
+                  Overlay.of(ctx).context.findRenderObject() as RenderBox;
+              final anchor = overlay
+                  .globalToLocal(box.localToGlobal(Offset(0, box.size.height)));
+              final space = overlay.size.height - anchor.dy - 8;
+              return Positioned(
+                  left: anchor.dx,
+                  top: anchor.dy + 4,
+                  width: size.maxWidth,
+                  child: TextFieldTapRegion(
+                      child: ConstrainedBox(
+                          constraints: BoxConstraints(
+                              maxHeight: space.clamp(0.0, 420.0).toDouble()),
+                          child: Material(
+                              color: Colors.white,
+                              shape: RoundedRectangleBorder(
+                                  borderRadius: BorderRadius.circular(8),
+                                  side: const BorderSide(
+                                      color: Color(0xffe5e7eb))),
+                              clipBehavior: Clip.antiAlias,
+                              elevation: 2,
+                              shadowColor: const Color(0x330b2e42),
+                              child: AnimatedBuilder(
+                                  animation: Listenable.merge([
+                                    gFFI.recentPeersModel,
+                                    if (widget.directory() case final dir?)
+                                      dir.presenceChanges,
+                                    gFFI.favoritePeersModel
+                                  ]),
+                                  builder: (_, __) => Obx(_results))))));
+            },
+            child: Focus(
+                onKeyEvent: _key,
+                canRequestFocus: false,
+                child: TextField(
+                    controller: widget.search,
+                    focusNode: widget.focus,
+                    onChanged: _change,
+                    onTap: _focus,
+                    onEditingComplete: () {},
+                    onSubmitted: _submit,
+                    textInputAction: TextInputAction.search,
+                    decoration: InputDecoration(
+                        isDense: true,
+                        prefixIcon: const Icon(Icons.search),
+                        hintText: translate(
+                            'Search merchants, stores, devices or IDs'),
+                        suffixIcon: widget.search.text.isEmpty
+                            ? null
+                            : IconButton(
+                                icon: const Icon(Icons.clear),
+                                tooltip: translate('Clear'),
+                                onPressed: () {
+                                  widget.search.clear();
+                                  _change('');
+                                  widget.focus.requestFocus();
+                                }),
+                        border: const OutlineInputBorder(
+                            borderRadius:
+                                BorderRadius.all(Radius.circular(8)))))));
+      });
+
+  Widget _results() {
+    final signedIn = gFFI.userModel.isLogin;
+    final dir = widget.directory();
+    final entries = dir?._entries(searchIndex: true) ?? <_Entry>[];
+    final items = _choices(entries);
+    final keys = items.map((c) => c.key).toSet();
+    tileKeys.removeWhere((key, _) => !keys.contains(key));
+    final devices = items.where((c) => c.row != null);
+    final groups = items.where((c) => c.scope != null);
+    Widget heading(String s) => Padding(
+        padding: const EdgeInsets.fromLTRB(12, 8, 12, 4),
+        child: Text(translate(s),
+            style: const TextStyle(fontSize: 12, color: Color(0xff4b5563))));
+    return Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Flexible(
+              child: SingleChildScrollView(
+                  controller: scroll,
+                  child: Column(
+                      crossAxisAlignment: CrossAxisAlignment.stretch,
+                      children: [
+                        for (final c in items.where((c) => c.key == 'direct'))
+                          _tile(c, dir),
+                        heading('Devices'),
+                        for (final c in devices) _tile(c, dir),
+                        if (devices.isEmpty) heading('No devices'),
+                        if (signedIn) heading('Merchants and stores'),
+                        for (final c in groups) _tile(c, dir),
+                        if (signedIn && groups.isEmpty)
+                          heading('No matching groups'),
+                      ]))),
+          const Divider(height: 1),
+          Padding(
+              padding: const EdgeInsets.all(8),
+              child: Text(
+                  translate(
+                      '↑↓ Select   Enter Connect   Right-click More   Esc Close'),
+                  style: const TextStyle(fontSize: 12))),
+        ]);
+  }
+
+  Widget _tile(_Choice c, _DirectoryState? dir) {
+    final d = c.row?.device;
+    final prefix = widget.search.text.trim().replaceAll(' ', '');
+    final bold = d != null && d.id.startsWith(prefix) ? prefix.length : 0;
+    final key = tileKeys.putIfAbsent(c.key, () => GlobalKey());
+    final tile = Material(
+        key: key,
+        color: selected == c.key ? const Color(0xffe6f5fb) : Colors.white,
+        child: InkWell(
+            canRequestFocus: false,
+            hoverColor: const Color(0xfff3f4f6),
+            onTap: _enabled(c) ? () => _activate(c) : null,
+            child: Padding(
+                padding:
+                    const EdgeInsets.symmetric(horizontal: 12, vertical: 7),
+                child: d == null
+                    ? Text(
+                        c.key == 'direct'
+                            ? '${translate("Direct connect ID")} ${c.label}'
+                            : c.label,
+                        style:
+                            TextStyle(color: _enabled(c) ? _ink : Colors.grey))
+                    : Row(children: [
+                        Expanded(
+                            child: Column(
+                                crossAxisAlignment: CrossAxisAlignment.start,
+                                children: [
+                              Text(c.label,
+                                  maxLines: 1, overflow: TextOverflow.ellipsis),
+                              Text.rich(
+                                  TextSpan(children: [
+                                    TextSpan(
+                                        text: d.id.substring(0, bold),
+                                        style: const TextStyle(
+                                            fontWeight: FontWeight.bold)),
+                                    TextSpan(
+                                        text: [
+                                      d.id.substring(bold),
+                                      if (d.groupName.isNotEmpty) d.groupName,
+                                      if (d.merchant != null) d.merchant,
+                                      if (d.store != null) d.store
+                                    ].join(' · '))
+                                  ]),
+                                  maxLines: 1,
+                                  overflow: TextOverflow.ellipsis,
+                                  style: const TextStyle(fontSize: 12))
+                            ])),
+                        Text(translate(d.online == null
+                            ? 'Unknown'
+                            : d.online!
+                                ? 'Online'
+                                : 'Offline')),
+                        if (d.model.isNotEmpty)
+                          Flexible(
+                              child: Padding(
+                                  padding: const EdgeInsets.only(left: 10),
+                                  child: Text(d.model,
+                                      maxLines: 1,
+                                      overflow: TextOverflow.ellipsis)))
+                      ]))));
+    if (c.row == null || dir == null) return tile;
+    return _DeviceMenu(
+        row: c.row!,
+        directory: dir,
+        onOpenChanged: (open) {
+          menuOpen = open;
+          if (!open && mounted && !widget.focus.hasFocus) _close();
+        },
+        child: tile);
+  }
+}
