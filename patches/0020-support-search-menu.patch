+// This desktop-local file is shared with the personal group UI. Group names
+// are JSON keys, never path components. Keep other operators' lists intact.
+class _PersonalGroups {
+  static Future<File> _file() async {
+    final dir = await getApplicationSupportDirectory();
+    return File('${dir.path}/support-groups-v1.json');
+  }
+
+  static Future<Map<String, dynamic>> _read(File file) async {
+    if (!await file.exists())
+      return {'version': 1, 'accounts': <String, dynamic>{}};
+    final doc = jsonDecode(await file.readAsString()) as Map<String, dynamic>;
+    if (doc['version'] != 1 || doc['accounts'] is! Map<String, dynamic>)
+      throw const FormatException();
+    return doc;
+  }
+
+  static Map<String, dynamic> _groups(
+      Map<String, dynamic> doc, String account) {
+    final accounts = doc['accounts'] as Map<String, dynamic>;
+    return accounts.putIfAbsent(account, () => <String, dynamic>{})
+        as Map<String, dynamic>;
+  }
+
+  static Future<List<String>> names(String account) async =>
+      _groups(await _read(await _file()), account).keys.toList()..sort();
+  static Future<void> _pending = Future.value();
+  static Future<void> add(String account, String name, String id) {
+    final next = _pending.then((_) => _write(account, name, id));
+    _pending = next.catchError((Object _) {});
+    return next;
+  }
+
+  static Future<void> _write(String account, String name, String id) async {
+    final file = await _file();
+    await file.parent.create(recursive: true);
+    final lock = await File('${file.path}.lock').open(mode: FileMode.append);
+    try {
+      await lock.lock(FileLock.blockingExclusive);
+      final doc = await _read(file);
+      final groups = _groups(doc, account);
+      final ids = List<String>.from(groups[name] ?? []);
+      if (ids.contains(id)) return;
+      groups[name] = [...ids, id];
+      final next = File('${file.path}.tmp');
+      await next.writeAsString(jsonEncode(doc), flush: true);
+      await next.rename(file.path);
+    } finally {
+      await lock.close();
+    }
+  }
+}
+
+class _DeviceMenu extends StatefulWidget {
+  final _Entry row;
+  final _DirectoryState directory;
+  final Widget child;
+  final ValueChanged<bool>? onOpenChanged;
+  const _DeviceMenu(
+      {required this.row,
+      required this.directory,
+      required this.child,
+      this.onOpenChanged});
+  @override
+  State<_DeviceMenu> createState() => _DeviceMenuState();
+}
+
+class _DeviceMenuState extends State<_DeviceMenu> {
+  final controller = MenuController();
+  List<String> names = [];
+  bool favorite = false;
+  List<String> stores = [];
+  String owner = "";
+  int opening = 0;
+  String get account => gFFI.userModel.userName.value;
+  void _error() => showToast(translate('Operation failed'));
+  Future<void> _open(TapDownDetails tap) async {
+    final serial = ++opening;
+    final id = widget.row.device.id, user = account;
+    final position = tap.localPosition;
+    try {
+      final favs = await bind.mainGetFav();
+      List<String> groups = [];
+      if (user.isNotEmpty) {
+        try {
+          groups = await _PersonalGroups.names(user);
+        } catch (_) {
+          if (mounted) _error();
+        }
+      }
+      if (!mounted ||
+          widget.row.device.id != id ||
+          serial != opening ||
+          user != account) return;
+      setState(() {
+        favorite = favs.contains(id);
+        names = groups;
+        owner = user;
+        stores = user.isNotEmpty && gFFI.userModel.isAdmin.value
+            ? _managedStores(widget.directory)
+            : [];
+      });
+      controller.open(position: position);
+    } catch (_) {
+      if (mounted) _error();
+    }
+  }
+
+  Future<void> _favorite(String id, bool add) async {
+    try {
+      final ids = (await bind.mainGetFav()).toList();
+      if (add && !ids.contains(id)) {
+        ids.add(id);
+      } else if (!add) {
+        ids.remove(id);
+      }
+      await bind.mainStoreFav(favs: ids);
+      await bind.mainLoadFavPeers();
+    } catch (_) {
+      _error();
+    }
+  }
+
+  Future<void> _add(String name, String user, String id) async {
+    if (user != account) return;
+    try {
+      await _PersonalGroups.add(user, name, id);
+      showToast(translate('Successful'));
+    } catch (_) {
+      _error();
+    }
+  }
+
+  Future<void> _newGroup(String user, String id) async {
+    var name = '';
+    final result = await showDialog<String>(
+        context: widget.directory.context,
+        builder: (ctx) => AlertDialog(
+                title: Text(translate('New group')),
+                content: TextField(
+                    autofocus: true,
+                    maxLength: 80,
+                    onChanged: (v) => name = v.trim(),
+                    onSubmitted: (v) {
+                      if (v.trim().isNotEmpty) Navigator.pop(ctx, v.trim());
+                    }),
+                actions: [
+                  TextButton(
+                      onPressed: () => Navigator.pop(ctx),
+                      child: Text(translate('Cancel'))),
+                  TextButton(
+                      onPressed: () {
+                        if (name.isNotEmpty) Navigator.pop(ctx, name);
+                      },
+                      child: Text(translate('Add')))
+                ]));
+    if (result != null) await _add(result, user, id);
+  }
+
+  Widget _button(String label, VoidCallback? action) =>
+      MenuItemButton(onPressed: action, child: Text(translate(label)));
+  @override
+  Widget build(BuildContext context) {
+    final row = widget.row, dir = widget.directory, id = row.device.id;
+    final style = MenuStyle(
+        backgroundColor: const WidgetStatePropertyAll(Colors.white),
+        side:
+            const WidgetStatePropertyAll(BorderSide(color: Color(0xffe5e7eb))),
+        shadowColor: const WidgetStatePropertyAll(Color(0x330b2e42)));
+    return MenuAnchor(
+        style: style,
+        controller: controller,
+        onOpen: () => widget.onOpenChanged?.call(true),
+        onClose: () => widget.onOpenChanged?.call(false),
+        menuChildren: [
+          _button('Connect', () => dir._connect(row)),
+          _button(
+              'Transfer file',
+              () => connectInPeerTab(
+                  dir.context, row.source.peer, row.source.tab,
+                  addressBook: row.source.book, isFileTransfer: true)),
+          _button('Device status', () => dir._details(row)),
+          const Divider(height: 1),
+          SubmenuButton(
+              menuStyle: style,
+              menuChildren: [
+                _button('My groups', null),
+                if (owner == account)
+                  for (final name in names)
+                    MenuItemButton(
+                        onPressed: () => _add(name, owner, id),
+                        child: Text(name)),
+                if (stores.isNotEmpty &&
+                    account == owner &&
+                    gFFI.userModel.isAdmin.value) ...[
+                  _button('My merchants', null),
+                  for (final store in stores)
+                    MenuItemButton(onPressed: null, child: Text(store)),
+                ],
+                const Divider(height: 1),
+                _button(
+                    'New group…',
+                    owner.isEmpty || owner != account
+                        ? null
+                        : () => _newGroup(owner, id)),
+              ],
+              child: Text(translate('Add to group'))),
+          _button(favorite ? 'Remove from Favorites' : 'Add to Favorites',
+              () => _favorite(id, !favorite)),
+          _button('Copy ID', () => Clipboard.setData(ClipboardData(text: id))),
+        ],
+        child: GestureDetector(
+            behavior: HitTestBehavior.translucent,
+            onSecondaryTapDown: _open,
+            child: widget.child));
+  }
+
+  List<String> _managedStores(_DirectoryState dir) {
+    final stores = <String>{};
+    for (final row in dir._entries(searchIndex: true)) {
+      final d = row.device;
+      if ((row.source.tab == PeerTabIndex.ab ||
+              row.source.tab == PeerTabIndex.group) &&
+          d.merchant != null) {
+        stores.add([
+          if (d.groupName.isNotEmpty) d.groupName,
+          d.merchant!,
+          d.store!
+        ].join(' › '));
+      }
+    }
+    return stores.toList()..sort();
+  }
+}
