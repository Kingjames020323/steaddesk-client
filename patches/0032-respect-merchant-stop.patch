diff --git a/flutter/lib/steaddesk/merchant_pause_button.dart b/flutter/lib/steaddesk/merchant_pause_button.dart
new file mode 100644
index 0000000..fd2223a
--- /dev/null
+++ b/flutter/lib/steaddesk/merchant_pause_button.dart
@@ -0,0 +1,66 @@
+import 'package:flutter/material.dart';
+
+class MerchantPauseButton extends StatefulWidget {
+  final bool? paused;
+  final bool busy;
+  final String Function(String) label;
+  final Future<void> Function(bool) change;
+
+  const MerchantPauseButton({
+    super.key,
+    required this.paused,
+    required this.busy,
+    required this.label,
+    required this.change,
+  });
+
+  @override
+  State<MerchantPauseButton> createState() => _MerchantPauseButtonState();
+}
+
+class _MerchantPauseButtonState extends State<MerchantPauseButton> {
+  bool confirming = false;
+
+  Future<void> press() async {
+    if (confirming || widget.paused == null || widget.busy) return;
+    if (widget.paused == true) {
+      await widget.change(false);
+      return;
+    }
+    setState(() => confirming = true);
+    try {
+      final confirmed = await showDialog<bool>(
+        context: context,
+        builder: (context) => AlertDialog(
+          title: Text(widget.label('Pause remote support')),
+          content: Text(widget
+              .label('This will end remote support until you resume it.')),
+          actions: [
+            TextButton(
+              onPressed: () => Navigator.pop(context, false),
+              child: Text(widget.label('Cancel')),
+            ),
+            FilledButton(
+              onPressed: () => Navigator.pop(context, true),
+              child: Text(widget.label('Pause remote support')),
+            ),
+          ],
+        ),
+      );
+      if (mounted && confirmed == true && widget.paused == false) {
+        await widget.change(true);
+      }
+    } finally {
+      if (mounted) setState(() => confirming = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => OutlinedButton(
+        onPressed:
+            confirming || widget.busy || widget.paused == null ? null : press,
+        child: Text(widget.label(widget.paused == true
+            ? 'Resume remote support'
+            : 'Pause remote support')),
+      );
+}
diff --git a/flutter/test/steaddesk/merchant_pause_test.dart b/flutter/test/steaddesk/merchant_pause_test.dart
new file mode 100644
index 0000000..23258be
--- /dev/null
+++ b/flutter/test/steaddesk/merchant_pause_test.dart
@@ -0,0 +1,46 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/merchant_pause_button.dart';
+
+void main() {
+  testWidgets('cancel, confirm pause, and explicitly resume', (tester) async {
+    final writes = <bool>[];
+    bool? paused;
+    final widget = MaterialApp(
+      home: Scaffold(body: StatefulBuilder(builder: (context, setState) {
+        return MerchantPauseButton(
+          paused: paused,
+          busy: false,
+          label: (s) => s,
+          change: (value) async {
+            writes.add(value);
+            setState(() => paused = value);
+          },
+        );
+      })),
+    );
+    await tester.pumpWidget(widget);
+    expect(tester.widget<OutlinedButton>(find.byType(OutlinedButton)).onPressed,
+        isNull);
+
+    paused = false;
+    await tester.pumpWidget(const SizedBox());
+    await tester.pumpWidget(widget);
+    await tester.tap(find.byType(OutlinedButton));
+    await tester.pumpAndSettle();
+    expect(writes, isEmpty);
+    await tester.tap(find.text('Cancel'));
+    await tester.pumpAndSettle();
+    expect(writes, isEmpty);
+
+    await tester.tap(find.byType(OutlinedButton));
+    await tester.pumpAndSettle();
+    await tester.tap(find.byType(FilledButton));
+    await tester.pumpAndSettle();
+    expect(writes, [true]);
+    expect(find.text('Resume remote support'), findsOneWidget);
+    await tester.tap(find.byType(OutlinedButton));
+    await tester.pumpAndSettle();
+    expect(writes, [true, false]);
+  });
+}
