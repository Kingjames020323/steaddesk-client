+// Register before sending the login challenge. Pause closes every registered channel,
+// including pending logins and tunnels, and rejects later arrivals under the same lock.
+#[cfg(all(target_os = "android", steaddesk_merchant))]
+mod merchant_pause {
+    use super::*;
+
+    struct State {
+        paused: bool,
+        next_token: u64,
+        connections: HashMap<u64, mpsc::UnboundedSender<ipc::Data>>,
+    }
+
+    lazy_static::lazy_static! {
+        // The Android service explicitly opens admission after checking the persisted choice.
+        static ref STATE: Mutex<State> = Mutex::new(State {
+            paused: true,
+            next_token: 0,
+            connections: HashMap::new(),
+        });
+    }
+
+    pub(super) struct Registration(u64);
+
+    impl Drop for Registration {
+        fn drop(&mut self) {
+            STATE.lock().unwrap().connections.remove(&self.0);
+        }
+    }
+
+    pub(super) fn admit(tx: &mpsc::UnboundedSender<ipc::Data>) -> Option<Registration> {
+        let mut state = STATE.lock().unwrap();
+        if state.paused {
+            return None;
+        }
+        // Protocol IDs are scoped to a Server. Use a process-wide token for teardown.
+        let token = state.next_token;
+        state.next_token = token.checked_add(1)?;
+        state.connections.insert(token, tx.clone());
+        Some(Registration(token))
+    }
+
+    pub fn set_paused(paused: bool) {
+        let mut state = STATE.lock().unwrap();
+        state.paused = paused;
+        if paused {
+            for tx in state.connections.values() {
+                let _ = tx.send(ipc::Data::Close);
+            }
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        #[test]
+        fn pause_closes_active_and_pending_connections_and_refuses_new_ones() {
+            let (active, mut active_rx) = mpsc::unbounded_channel();
+            let (pending, mut pending_rx) = mpsc::unbounded_channel();
+            // Separate servers can assign the same local protocol ID.
+            let first_server = (1, active);
+            let second_server = (1, pending);
+            assert_eq!(first_server.0, second_server.0);
+            assert!(admit(&first_server.1).is_none());
+            set_paused(false);
+            let active_registration = admit(&first_server.1).unwrap();
+            let pending_registration = admit(&second_server.1).unwrap();
+            set_paused(true);
+            assert!(matches!(active_rx.try_recv(), Ok(ipc::Data::Close)));
+            assert!(matches!(pending_rx.try_recv(), Ok(ipc::Data::Close)));
+            assert!(admit(&second_server.1).is_none());
+
+            drop(active_registration);
+            set_paused(false);
+            set_paused(true);
+            assert!(matches!(pending_rx.try_recv(), Ok(ipc::Data::Close)));
+            drop(pending_registration);
+            set_paused(false);
+            assert!(admit(&second_server.1).is_some());
+        }
+    }
+}
