+package com.carriez.flutter_hbb;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.Build;
+
+/** PackageManager persists the merchant's choice across process death, updates and reboot. */
+public final class MerchantPause {
+    private static ComponentName marker(Context context) {
+        return new ComponentName(context, MerchantRemotePaused.class);
+    }
+
+    public static boolean isPaused(Context context) {
+        PackageManager pm = context.getPackageManager();
+        ComponentName component = marker(context);
+        try {
+            pm.getReceiverInfo(component, PackageManager.MATCH_DISABLED_COMPONENTS);
+            int setting = pm.getComponentEnabledSetting(component);
+            return setting != PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
+                    && setting != PackageManager.COMPONENT_ENABLED_STATE_DISABLED;
+        } catch (PackageManager.NameNotFoundException | RuntimeException unavailable) {
+            return true;
+        }
+    }
+
+    public static boolean setPaused(Context context, boolean paused) {
+        try {
+            PackageManager pm = context.getPackageManager();
+            ComponentName component = marker(context);
+            pm.getReceiverInfo(component, PackageManager.MATCH_DISABLED_COMPONENTS);
+            int state = paused ? PackageManager.COMPONENT_ENABLED_STATE_ENABLED
+                    : PackageManager.COMPONENT_ENABLED_STATE_DISABLED;
+            int flags = PackageManager.DONT_KILL_APP;
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) flags |= PackageManager.SYNCHRONOUS;
+            pm.setComponentEnabledSetting(component, state, flags);
+            return pm.getComponentEnabledSetting(component) == state;
+        } catch (PackageManager.NameNotFoundException | RuntimeException unavailable) {
+            return false;
+        }
+    }
+
+    private MerchantPause() {}
+}
