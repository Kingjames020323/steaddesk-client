@@ -0,0 +1,68 @@
+package com.carriez.flutter_hbb;
+
+import android.annotation.TargetApi;
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Color;
+import android.os.Build;
+import android.text.TextUtils;
+
+import androidx.core.app.NotificationCompat;
+
+/** Maintains the Android foreground service's channel, including while the service is stopped. */
+public final class ServiceNotificationChannel extends BroadcastReceiver {
+    private static final String ID = "SteadDesk";
+    private static final String LEGACY_ID = "RustDesk";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (Intent.ACTION_MY_PACKAGE_REPLACED.equals(intent.getAction())
+                || Intent.ACTION_LOCALE_CHANGED.equals(intent.getAction())) {
+            refreshExisting(context);
+        }
+    }
+
+    static void refreshExisting(Context context) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) configure(context, false);
+    }
+
+    static NotificationCompat.Builder builder(Context context) {
+        String id = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O ? configure(context, true) : "";
+        return new NotificationCompat.Builder(context, id);
+    }
+
+    @TargetApi(Build.VERSION_CODES.O)
+    private static String configure(Context context, boolean create) {
+        NotificationManager manager = context.getSystemService(NotificationManager.class);
+        NotificationChannel channel = manager.getNotificationChannel(LEGACY_ID);
+        NotificationChannel branded = manager.getNotificationChannel(ID);
+        // An upgrade must keep the user's channel, even if its importance is NONE.
+        // If a downgrade left both IDs, also respect a block on the branded one.
+        if (channel == null || (branded != null
+                && branded.getImportance() == NotificationManager.IMPORTANCE_NONE)) {
+            channel = branded;
+        }
+        if (channel == null && !create) return "";
+
+        String name = MerchantLanguage.text(context, R.string.merchant_channel);
+        String description = MerchantLanguage.text(context, R.string.merchant_channel_description);
+        if (channel == null) {
+            channel = new NotificationChannel(ID, name, NotificationManager.IMPORTANCE_HIGH);
+            channel.setLightColor(Color.BLUE);
+            channel.setLockscreenVisibility(Notification.VISIBILITY_PRIVATE);
+        } else {
+            if (TextUtils.equals(channel.getName(), name)
+                    && TextUtils.equals(channel.getDescription(), description)) {
+                return channel.getId();
+            }
+            channel.setName(name);
+        }
+        channel.setDescription(description);
+        manager.createNotificationChannel(channel);
+        return channel.getId();
+    }
+}
