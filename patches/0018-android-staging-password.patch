+#[cfg(target_os = "android")]
+mod staging_passwords {
+    use hbb_common::{config, sodiumoxide};
+    use jni::{
+        objects::{JByteArray, JClass, JString},
+        sys::jboolean,
+        JNIEnv,
+    };
+    use std::{path::Path, sync::Once};
+    use zeroize::Zeroizing;
+
+    fn prepare(env: &mut JNIEnv, dir: &JString) -> bool {
+        let Ok(dir) = env.get_string(dir) else {
+            return false;
+        };
+        let dir = String::from(dir);
+        if !Path::new(&dir).is_absolute() {
+            return false;
+        }
+        {
+            let mut active = config::APP_DIR.write().unwrap();
+            if active.is_empty() {
+                *active = dir;
+            } else if *active != dir {
+                return false;
+            }
+        }
+        // Flutter's mainInit supplies an empty customClientConfig on Android.
+        static LOAD_CUSTOM: Once = Once::new();
+        LOAD_CUSTOM.call_once(crate::load_custom_client);
+        sodiumoxide::init().is_ok()
+    }
+
+    #[no_mangle]
+    pub extern "system" fn Java_com_steaddesk_remote_staging_StagingPasswords_set(
+        mut env: JNIEnv,
+        _class: JClass,
+        dir: JString,
+        input: JByteArray,
+    ) -> jboolean {
+        const ALPHABET: &[u8] = b"ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789";
+        if env.get_array_length(&input).ok() != Some(20) {
+            return 0;
+        }
+        let mut bytes = Zeroizing::new([0u8; 20]);
+        // JNI's jbyte is i8; GetByteArrayRegion writes these same 20 bytes.
+        let signed = unsafe {
+            std::slice::from_raw_parts_mut(bytes.as_mut_ptr().cast::<i8>(), bytes.len())
+        };
+        if env.get_byte_array_region(&input, 0, signed).is_err()
+            || !bytes.iter().all(|b| ALPHABET.contains(b))
+            || !prepare(&mut env, &dir)
+        {
+            return 0;
+        }
+        let Ok(password) = std::str::from_utf8(&bytes[..]) else {
+            return 0;
+        };
+        (crate::ui_interface::set_permanent_password_with_result(password)
+            && config::Config::persisted_local_permanent_password_matches(Some(password)))
+        .into()
+    }
+
+    #[no_mangle]
+    pub extern "system" fn Java_com_steaddesk_remote_staging_StagingPasswords_isSet(
+        mut env: JNIEnv,
+        _class: JClass,
+        dir: JString,
+    ) -> jboolean {
+        (prepare(&mut env, &dir)
+            && config::Config::persisted_local_permanent_password_matches(None))
+        .into()
+    }
+}
