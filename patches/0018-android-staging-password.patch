+    /// Confirm that the Android service can authenticate with the same local
+    /// credential after process restart. The shared setter's store logs errors
+    /// and has no disk acknowledgment, so staging must read the file back.
+    #[cfg(target_os = "android")]
+    pub fn persisted_local_permanent_password_matches(expected: Option<&str>) -> bool {
+        let Ok(mut stored) = confy::load_path::<Config>(Self::file()) else {
+            return false;
+        };
+        if stored.password.is_empty() {
+            return false;
+        }
+        let live = CONFIG.read().unwrap();
+        if stored.salt != live.salt {
+            return false;
+        }
+        if let Some(h1) = decode_permanent_password_h1_from_storage(&stored.password) {
+            return !stored.salt.is_empty()
+                && stored.password == live.password
+                && !stored.key_pair.0.is_empty()
+                && stored.key_pair.1 == live.key_pair.1
+                && expected.map_or(true, |password| {
+                    sodiumoxide::utils::memcmp(
+                        &h1,
+                        &compute_permanent_password_h1(password, &stored.salt),
+                    )
+                });
+        }
+        // New writes must use the current encrypted hash. Older local passwords
+        // still count for status when they decode under the usual loader.
+        expected.is_none()
+            && !stored
+                .password
+                .starts_with(permanent_password::PERMANENT_PASSWORD_ENC_VERSION)
+            && Self::validate_or_decrypt_permanent_password_storage(&mut stored).is_ok()
+            && stored.password == live.password
+            && local_permanent_password_storage_is_usable_for_auth(&live.password, &live.salt)
+    }
