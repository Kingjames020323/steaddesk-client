diff --git a/flutter/lib/steaddesk/session_reconnect.dart b/flutter/lib/steaddesk/session_reconnect.dart
new file mode 100644
index 0000000..d827dcf
--- /dev/null
+++ b/flutter/lib/steaddesk/session_reconnect.dart
@@ -0,0 +1,287 @@
+import 'dart:async';
+
+enum _Phase {
+  ready,
+  delay,
+  response,
+  frame,
+  blocked,
+  verified,
+  exhaustedFrame,
+  exhausted,
+  closed
+}
+
+/// One instance per window, with a single dispatch owner per native session.
+class SessionReconnect {
+  SessionReconnect({
+    required this.send,
+    required this.changed,
+    bool owner = true,
+    DateTime Function()? clock,
+  })  : _owner = owner,
+        _clock = clock ?? DateTime.now;
+
+  /// The dispatch owner calls this once per native request; only true counts for M-1.
+  final void Function(bool automatic) send;
+
+  /// Refresh the UI and publish snapshot() on the owning window. Never sends.
+  final void Function() changed;
+  final DateTime Function() _clock;
+  bool _owner;
+  int _revision = 0;
+  int _lastReceived = -1;
+  bool _localLock = false;
+  bool _localBlock = false;
+  bool _localAuth = false;
+  bool _localFrame = false;
+  _Phase _phase = _Phase.ready;
+  int _attempt = 0;
+  DateTime? _deadline;
+  Timer? _timer;
+  static const _responseTimeout = Duration(seconds: 15);
+  static const _maxAttempts = 3;
+
+  bool get isOwner => _owner;
+  bool get active =>
+      _phase == _Phase.delay ||
+      _phase == _Phase.response ||
+      _phase == _Phase.frame;
+  bool get exhausted =>
+      _phase == _Phase.exhausted || _phase == _Phase.exhaustedFrame;
+  bool get blocked =>
+      _localBlock ||
+      _phase == _Phase.blocked ||
+      _phase == _Phase.verified ||
+      _phase == _Phase.closed;
+  int get attempt => _attempt;
+  bool get inputLocked => _localLock || _phase != _Phase.ready;
+
+  void disconnect() {
+    if (_phase == _Phase.closed) return;
+    if (!_owner) {
+      _lockMirror(false);
+      return;
+    }
+    switch (_phase) {
+      case _Phase.ready:
+      case _Phase.frame:
+        _nextAttempt();
+        break;
+      case _Phase.exhaustedFrame:
+        _set(_Phase.exhausted);
+        changed();
+        break;
+      case _Phase.verified:
+        block();
+        break;
+      default:
+        // Transport error notifications have no per-attempt identity. A burst
+        // cannot turn the third dispatch into three failures; its timer owns it.
+        break;
+    }
+  }
+
+  void _nextAttempt() {
+    if (_attempt >= _maxAttempts) {
+      _set(_Phase.exhausted);
+    } else {
+      _set(_Phase.delay, Duration(seconds: 1 << _attempt));
+    }
+    changed();
+  }
+
+  void _dispatch(bool automatic) {
+    if (automatic) _attempt++;
+    _set(_Phase.response, _responseTimeout);
+    try {
+      send(automatic);
+    } finally {
+      if (_phase != _Phase.closed) changed();
+    }
+  }
+
+  void _lockMirror(bool security) {
+    final notify = !_localLock || (security && !_localBlock);
+    _localLock = true;
+    _localBlock = _localBlock || security;
+    _localAuth = false;
+    _localFrame = false;
+    if (notify) changed();
+  }
+
+  void block() {
+    if (_phase == _Phase.closed) return;
+    if (!_owner) {
+      _lockMirror(true);
+      return;
+    }
+    if (_phase == _Phase.blocked) return;
+    _set(_Phase.blocked);
+    changed();
+  }
+
+  /// Caller verifies the live session and excludes cached peer info.
+  void authenticated() {
+    if (!_owner) {
+      if (_localLock && _phase != _Phase.closed) _localAuth = true;
+      return;
+    }
+    if (_phase == _Phase.response || _phase == _Phase.delay) {
+      _set(_Phase.frame, _responseTimeout);
+    } else if (_phase == _Phase.exhausted) {
+      _set(_Phase.exhaustedFrame);
+    } else if (_phase == _Phase.blocked) {
+      // A fresh explicit authentication can clear a security block. It must
+      // still present a live frame, and a missing frame cannot auto-retry.
+      _set(_Phase.verified);
+    } else {
+      return;
+    }
+    changed();
+  }
+
+  void firstFrame({bool cached = false}) {
+    if (cached || _phase == _Phase.closed) return;
+    if (!_owner) {
+      if (_localLock && _localAuth) {
+        _localFrame = true;
+        if (_unlockMirror()) changed();
+      }
+      return;
+    }
+    if (_phase != _Phase.frame &&
+        _phase != _Phase.verified &&
+        _phase != _Phase.exhaustedFrame) {
+      return;
+    }
+    _attempt = 0;
+    _set(_Phase.ready);
+    changed();
+  }
+
+  void retry() {
+    if (!_owner || !exhausted) return;
+    _attempt = 0;
+    _dispatch(false);
+  }
+
+  void close() {
+    if (_phase == _Phase.closed) return;
+    _attempt = 0;
+    _set(_Phase.closed);
+  }
+
+  bool _unlockMirror() {
+    if (!_localLock ||
+        !_localFrame ||
+        _phase != _Phase.ready ||
+        _lastReceived < 0) return false;
+    _clearMirrorLock();
+    return true;
+  }
+
+  void _clearMirrorLock() {
+    _localLock = false;
+    _localBlock = false;
+    _localAuth = false;
+    _localFrame = false;
+  }
+
+  Map<String, dynamic> snapshot({bool detach = false}) {
+    final state = <String, dynamic>{
+      'phase': _phase.name,
+      'attempt': _attempt,
+      'deadline': _deadline?.millisecondsSinceEpoch,
+      'revision': _revision,
+    };
+    if (detach && _owner) {
+      _owner = false;
+      _lastReceived = _revision;
+      _timer?.cancel();
+      _timer = null;
+    }
+    return state;
+  }
+
+  /// Ordinary monitor updates cannot change window ownership. An explicit
+  /// handoff continues from the newest received state, including its deadline.
+  void restore(Map<String, dynamic> state, {required bool owner}) {
+    if (_phase == _Phase.closed || (_owner && !owner)) return;
+    final incoming = state['revision'] ?? 0;
+    if (incoming is! int || incoming < 0) return;
+    final promoting = owner && !_owner;
+    if (_owner && (_lastReceived >= 0 || _revision > 0)) return;
+    if (!promoting && incoming <= _lastReceived) return;
+    final useCurrent = promoting && incoming < _lastReceived;
+    final data = useCurrent ? snapshot() : state;
+    final phase =
+        _Phase.values.where((p) => p.name == data['phase']).firstOrNull;
+    final count = data['attempt'];
+    final deadline = data['deadline'];
+    _owner = owner;
+    if (incoming > _lastReceived) _lastReceived = incoming;
+    _revision = _lastReceived;
+
+    if (phase == null ||
+        count is! int ||
+        count < 0 ||
+        count > _maxAttempts ||
+        (_timed(phase) && deadline is! int)) {
+      _attempt = 0;
+      _set(_Phase.blocked);
+    } else {
+      _attempt = count;
+      if (owner &&
+          _localLock &&
+          !_localFrame &&
+          (_localBlock || phase == _Phase.ready)) {
+        final secured = _localBlock;
+        final authenticated = _localAuth;
+        _clearMirrorLock();
+        if (secured) {
+          _set(authenticated ? _Phase.verified : _Phase.blocked);
+        } else if (authenticated) {
+          _set(_Phase.frame, _responseTimeout);
+        } else {
+          _nextAttempt();
+          return;
+        }
+      } else {
+        _set(
+            phase,
+            _timed(phase)
+                ? DateTime.fromMillisecondsSinceEpoch(deadline as int)
+                    .difference(_clock())
+                : null);
+      }
+    }
+    if (owner) {
+      _clearMirrorLock();
+    } else {
+      _unlockMirror();
+    }
+    changed();
+  }
+
+  bool _timed(_Phase phase) =>
+      phase == _Phase.delay ||
+      phase == _Phase.response ||
+      phase == _Phase.frame;
+
+  void _set(_Phase phase, [Duration? delay]) {
+    _timer?.cancel();
+    _timer = null;
+    _phase = phase;
+    if (_owner) _revision++;
+    _deadline = delay == null ? null : _clock().add(delay);
+    if (!_owner || delay == null) return;
+    _timer = Timer(delay.isNegative ? Duration.zero : delay, () {
+      if (phase == _Phase.delay) {
+        _dispatch(true);
+      } else {
+        _nextAttempt();
+      }
+    });
+  }
+}
