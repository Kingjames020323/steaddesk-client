@@ -0,0 +1,38 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../../lib/steaddesk/reconnect_overlay.dart';
+
+void main() {
+  testWidgets('only offers manual actions after the last automatic attempt',
+      (tester) async {
+    var retries = 0;
+    var ends = 0;
+    Widget overlay(int attempt, bool exhausted, {bool chinese = true}) =>
+        MaterialApp(
+          home: Scaffold(
+            body: ReconnectOverlay(
+              attempt: attempt,
+              exhausted: exhausted,
+              chinese: chinese,
+              onRetry: () => retries++,
+              onEnd: () => ends++,
+            ),
+          ),
+        );
+
+    for (var attempt = 1; attempt <= 3; attempt++) {
+      await tester.pumpWidget(overlay(attempt, false));
+      expect(find.text('正在重连 $attempt/3'), findsOneWidget);
+      expect(find.byType(FilledButton), findsNothing);
+      expect(find.byType(OutlinedButton), findsNothing);
+    }
+    await tester.pumpWidget(overlay(3, true));
+    await tester.tap(find.text('重试'));
+    await tester.tap(find.text('结束会话'));
+    expect((retries, ends), (1, 1));
+
+    await tester.pumpWidget(overlay(2, false, chinese: false));
+    expect(find.text('Reconnecting 2/3'), findsOneWidget);
+  });
+}
diff --git a/flutter/test/steaddesk/session_reconnect_test.dart b/flutter/test/steaddesk/session_reconnect_test.dart
new file mode 100644
index 0000000..7de8aff
--- /dev/null
+++ b/flutter/test/steaddesk/session_reconnect_test.dart
@@ -0,0 +1,314 @@
+import 'package:flutter_hbb/steaddesk/session_reconnect.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  testWidgets('duplicates and silence produce three real dispatches per round',
+      (tester) async {
+    final sends = <bool>[];
+    final states = <String>[];
+    late SessionReconnect session;
+    session = SessionReconnect(
+      send: sends.add,
+      changed: () => states.add('${session.attempt}/${session.inputLocked}'),
+      clock: tester.binding.clock.now,
+    );
+    session.disconnect();
+    session.firstFrame();
+    for (var nth = 1; nth <= 3; nth++) {
+      for (var i = 0; i < 5; i++) session.disconnect();
+      await tester.pump(Duration(seconds: 1 << (nth - 1)));
+      expect(sends, List.filled(nth, true));
+      expect(session.attempt, nth);
+      for (var i = 0; i < 5; i++) session.disconnect();
+      session.firstFrame();
+      await tester.pump(const Duration(seconds: 14));
+      expect(session.exhausted, false);
+      expect(session.inputLocked, true);
+      await tester.pump(const Duration(seconds: 1));
+    }
+    expect(session.exhausted, true);
+    final snapshot = session.snapshot();
+    session.firstFrame();
+    session.disconnect();
+    await tester.pump(const Duration(days: 1));
+    expect(session.snapshot(), snapshot);
+    session.retry();
+    session.retry();
+    expect(sends, [true, true, true, false]);
+    expect(session.attempt, 0);
+    session.firstFrame();
+    expect(session.inputLocked, true);
+    session.authenticated();
+    session.firstFrame();
+    expect(session.active, false);
+    expect(session.inputLocked, false);
+    expect(states.last, '0/false');
+    session.disconnect();
+    await tester.pump(const Duration(seconds: 1));
+    expect(sends, [true, true, true, false, true]);
+    session.close();
+  });
+
+  testWidgets(
+      'fresh authentication and frame cancel timers, security locks persist',
+      (tester) async {
+    final sends = <bool>[];
+    final session = SessionReconnect(send: sends.add, changed: () {});
+    session.disconnect();
+    await tester.pump(const Duration(seconds: 1));
+    session.firstFrame();
+    expect(session.inputLocked, true);
+    session.authenticated();
+    expect(session.inputLocked, true);
+    session.firstFrame();
+    expect(session.inputLocked, false);
+    await tester.pump(const Duration(minutes: 1));
+    expect(sends, [true]);
+    session.disconnect();
+    session.block();
+    session.disconnect();
+    session.retry();
+    session.firstFrame();
+    expect(session.inputLocked, true);
+    await tester.pump(const Duration(minutes: 1));
+    expect(sends, [true]);
+    session.authenticated();
+    session.disconnect();
+    session.firstFrame();
+    expect(session.inputLocked, true);
+    session.authenticated();
+    session.firstFrame();
+    expect(session.inputLocked, false);
+    session.close();
+  });
+
+  testWidgets(
+      'owner transfer retains deadline and dispatch count; mirror stays passive',
+      (tester) async {
+    final sends = <String>[];
+    SessionReconnect make(String name, {bool owner = true}) => SessionReconnect(
+        owner: owner,
+        send: (auto) => sends.add('$name/$auto'),
+        changed: () {},
+        clock: tester.binding.clock.now);
+    final main = make('original');
+    final monitor = make('monitor', owner: false);
+    expect(monitor.isOwner, false);
+    monitor.disconnect();
+    expect(monitor.inputLocked, true);
+    expect(monitor.blocked, false);
+    monitor.authenticated();
+    monitor.firstFrame();
+    expect(monitor.inputLocked, true);
+    main.disconnect();
+    await tester.pump(const Duration(seconds: 1));
+    await tester.pump(const Duration(seconds: 10));
+    final sent = main.snapshot(detach: true);
+    monitor.restore(sent, owner: true);
+    expect(monitor.isOwner, true);
+    expect(monitor.attempt, 1);
+    await tester.pump(const Duration(seconds: 5));
+    expect(sends, ['original/true']);
+    await tester.pump(const Duration(seconds: 2));
+    expect(sends, ['original/true', 'monitor/true']);
+    monitor.authenticated();
+    main.restore(monitor.snapshot(), owner: false);
+    main.firstFrame();
+    expect(main.inputLocked, true);
+    monitor.firstFrame();
+    main.restore(monitor.snapshot(), owner: false);
+    expect(main.inputLocked, false);
+    main.block();
+    expect(main.inputLocked, true);
+    expect(main.blocked, true);
+    await tester.pump(const Duration(minutes: 3));
+    expect(sends, ['original/true', 'monitor/true']);
+    main.close();
+    monitor.close();
+  });
+
+  testWidgets(
+      'security block, pending first frame and exhaustion survive owner handoff',
+      (tester) async {
+    final sends = <bool>[];
+    final session = SessionReconnect(
+        send: sends.add, changed: () {}, clock: tester.binding.clock.now);
+    void transfer() {
+      final snapshot = session.snapshot(detach: true);
+      session.restore(snapshot, owner: true);
+    }
+
+    session.block();
+    transfer();
+    session.disconnect();
+    await tester.pump(const Duration(minutes: 1));
+    expect(sends, isEmpty);
+    session.authenticated();
+    transfer();
+    expect(session.inputLocked, true);
+    session.firstFrame();
+    session.disconnect();
+    for (var i = 0; i < 3; i++) {
+      await tester.pump(Duration(seconds: 1 << i));
+      await tester.pump(const Duration(seconds: 15));
+    }
+    transfer();
+    expect(session.exhausted, true);
+    expect(session.attempt, 3);
+    await tester.pump(const Duration(hours: 1));
+    expect(sends, [true, true, true]);
+    session.close();
+  });
+
+  testWidgets(
+      'fresh peer info in countdown and after exhaustion needs a live frame',
+      (tester) async {
+    final sends = <bool>[];
+    final session = SessionReconnect(send: sends.add, changed: () {});
+    session.disconnect();
+    session.firstFrame();
+    expect(session.inputLocked, true);
+    session.authenticated();
+    session.firstFrame(cached: true);
+    expect(session.inputLocked, true);
+    session.firstFrame();
+    await tester.pump(const Duration(seconds: 30));
+    expect(sends, isEmpty);
+    expect(session.inputLocked, false);
+    session.disconnect();
+    for (var i = 0; i < 3; i++) {
+      await tester.pump(Duration(seconds: 1 << i));
+      await tester.pump(const Duration(seconds: 15));
+    }
+    session.authenticated();
+    session.firstFrame(cached: true);
+    await tester.pump(const Duration(hours: 1));
+    expect(session.exhausted, true);
+    expect(session.inputLocked, true);
+    expect(sends, [true, true, true]);
+    session.firstFrame();
+    expect(session.inputLocked, false);
+    expect(session.exhausted, false);
+    expect(session.attempt, 0);
+    session.close();
+  });
+
+  testWidgets(
+      'late ready cannot unlock local stop or overwrite a newer snapshot',
+      (tester) async {
+    final sends = <bool>[];
+    final owner = SessionReconnect(send: sends.add, changed: () {});
+    final mirror =
+        SessionReconnect(owner: false, send: sends.add, changed: () {});
+    final initial = owner.snapshot();
+    mirror.restore(initial, owner: false);
+    owner.disconnect();
+    owner.authenticated();
+    owner.firstFrame();
+    final previousReady = owner.snapshot();
+    mirror.block();
+    mirror.restore(previousReady, owner: false);
+    mirror.restore(initial, owner: false);
+    mirror.firstFrame();
+    expect(mirror.inputLocked, true);
+    expect(mirror.blocked, true);
+    owner.block();
+    final blocked = owner.snapshot();
+    mirror.restore(blocked, owner: false);
+    mirror.restore(previousReady, owner: false);
+    expect(mirror.inputLocked, true);
+    owner.authenticated();
+    owner.firstFrame();
+    final recovered = owner.snapshot();
+    mirror.restore(recovered, owner: false);
+    mirror.authenticated();
+    mirror.firstFrame(cached: true);
+    expect(mirror.inputLocked, true);
+    mirror.firstFrame();
+    expect(mirror.inputLocked, false);
+    mirror.restore(blocked, owner: false);
+    expect(mirror.inputLocked, false);
+    expect(sends, isEmpty);
+    mirror.close();
+    owner.close();
+  });
+
+  testWidgets(
+      'handoff uses newer mirrored dispatch, stale or duplicate restore cannot send again',
+      (tester) async {
+    final sends = <String>[];
+    SessionReconnect make(String label, bool owner) => SessionReconnect(
+        owner: owner,
+        send: (_) => sends.add(label),
+        changed: () {},
+        clock: tester.binding.clock.now);
+    final first = make('old', true);
+    final second = make('new', false);
+    first.disconnect();
+    final waiting = first.snapshot();
+    second.restore(waiting, owner: false);
+    await tester.pump(const Duration(seconds: 1));
+    final dispatched = first.snapshot(detach: true);
+    second.restore(dispatched, owner: false);
+    second.restore(waiting, owner: true);
+    final promoted = second.snapshot();
+    second.restore(dispatched, owner: true);
+    second.restore(waiting, owner: false);
+    expect(second.isOwner, true);
+    expect(second.snapshot(), promoted);
+    expect(second.attempt, 1);
+    expect(sends, ['old']);
+    await tester.pump(const Duration(seconds: 15));
+    await tester.pump(const Duration(seconds: 2));
+    expect(sends, ['old', 'new']);
+    first.close();
+    second.close();
+  });
+
+  testWidgets(
+      'first handoff during a locally observed stop preserves the block',
+      (tester) async {
+    final session = SessionReconnect(send: (_) {}, changed: () {});
+    final mirror = SessionReconnect(
+        owner: false,
+        send: (_) => fail('blocked monitor dispatched'),
+        changed: () {});
+    mirror.block();
+    mirror.restore(session.snapshot(detach: true), owner: true);
+    expect(mirror.isOwner, true);
+    expect(mirror.blocked, true);
+    await tester.pump(const Duration(minutes: 2));
+    expect(mirror.inputLocked, true);
+    mirror.authenticated();
+    mirror.firstFrame();
+    expect(mirror.inputLocked, false);
+    mirror.close();
+    session.close();
+  });
+
+  testWidgets('close is permanent and silent across timers and late callbacks',
+      (tester) async {
+    final sends = <bool>[];
+    var notifications = 0;
+    final session = SessionReconnect(
+      send: sends.add,
+      changed: () => notifications++,
+    );
+    session.disconnect();
+    final stale = session.snapshot();
+    session.close();
+    final before = notifications;
+    session.restore(stale, owner: true);
+    session.firstFrame();
+    session.authenticated();
+    session.disconnect();
+    session.retry();
+    session.block();
+    session.close();
+    await tester.pump(const Duration(hours: 1));
+    expect(sends, isEmpty);
+    expect(notifications, before);
+    expect(session.attempt, 0);
+    expect(session.inputLocked, true);
+  });
+}
