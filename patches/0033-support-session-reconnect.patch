+import 'package:flutter_hbb/models/os_password_input.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  Future<List<String>> run({String value = 'sample', int? expireAfter}) async {
+    final actions = <String>[];
+    await sendOsPasswordInRound(
+      password: value,
+      current: () => expireAfter == null || actions.length < expireAfter,
+      mouse: (type, button, x, y) async =>
+          actions.add('mouse $type $button $x $y'),
+      text: (text) async {
+        expect(text, value);
+        actions.add('text');
+      },
+      enter: () async => actions.add('enter'),
+      delay: (duration) async => actions.add('wait ${duration.inMilliseconds}'),
+    );
+    return actions;
+  }
+
+  test('preserves activation and sends the sequence before Return', () async {
+    expect(await run(), [
+      'mouse up left 0 0',
+      'wait 50',
+      'mouse move  0 0',
+      'wait 50',
+      'mouse move  3 3',
+      'wait 50',
+      'mouse down left 0 0',
+      'mouse up left 0 0',
+      'wait 1200',
+      'text',
+      'enter',
+    ]);
+    final activateOnly = await run(value: '');
+    expect(activateOnly.last, 'mouse up right 0 0');
+    expect(activateOnly, isNot(contains('text')));
+    expect(activateOnly, isNot(contains('enter')));
+  });
+
+  test('closing or changing round cancels every pending action', () async {
+    final complete = await run();
+    for (int i = 0; i < complete.length; i++) {
+      expect(await run(expireAfter: i), complete.take(i).toList(),
+          reason: 'round expired after $i completed operations');
+    }
+  });
+}
diff --git a/flutter/test/steaddesk/reconnect_input_test.dart b/flutter/test/steaddesk/reconnect_input_test.dart
new file mode 100644
index 0000000..a875f45
--- /dev/null
+++ b/flutter/test/steaddesk/reconnect_input_test.dart
@@ -0,0 +1,54 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/models/reconnect_input.dart';
+
+void main() {
+  test(
+      'authentication and neutral keyboard/mouse required before input resumes',
+      () {
+    final input = ReconnectInput();
+    final old = input.generation;
+    input.disconnect();
+    expect(input.restoreIfNeutral(false), isFalse);
+    input.authenticated();
+    expect(input.restoreIfNeutral(true), isFalse); // held Ctrl or mouse button
+    expect(input.blocked, isTrue);
+    expect(input.isCurrent(old), isFalse);
+    expect(input.restoreIfNeutral(false), isTrue);
+    expect(input.isCurrent(old), isFalse); // old delayed key-up
+    expect(input.isCurrent(input.generation), isTrue);
+  });
+
+  test('held or disconnected physical keys cannot replay repeats and releases',
+      () {
+    final input = ReconnectInput();
+    const key = 42;
+    expect(input.acceptKey(key, up: false, repeat: false), isTrue);
+    input.disconnect();
+    expect(input.acceptKey(key, up: false, repeat: true), isFalse);
+    expect(input.acceptKey(7, up: false, repeat: false), isFalse);
+    input.authenticated();
+    input.restoreIfNeutral(false);
+    expect(input.acceptKey(key, up: false, repeat: true), isFalse);
+    expect(input.acceptKey(key, up: true, repeat: false), isFalse);
+    expect(input.acceptKey(7, up: true, repeat: false), isFalse);
+    expect(input.acceptKey(key, up: false, repeat: false), isTrue);
+    expect(input.acceptKey(key, up: false, repeat: true), isTrue);
+    expect(input.acceptKey(key, up: true, repeat: false), isTrue);
+  });
+
+  test('Windows neutral snapshot includes mouse and keyboard high bits', () {
+    expect(anyWindowsInputDown((vk) => 1), isFalse);
+    expect(anyWindowsInputDown((vk) => vk == 1 ? -32768 : 0), isTrue);
+    expect(anyWindowsInputDown((vk) => vk == 0xa2 ? 0x8001 : 0), isTrue);
+  });
+
+  test('a second disconnect invalidates a pending neutral-state check', () {
+    final input = ReconnectInput()
+      ..disconnect()
+      ..authenticated();
+    expect(input.restoreIfNeutral(true), isFalse);
+    input.disconnect();
+    expect(input.restoreIfNeutral(false), isFalse);
+    expect(input.blocked, isTrue);
+  });
+}
diff --git a/flutter/test/steaddesk/reconnect_message_test.dart b/flutter/test/steaddesk/reconnect_message_test.dart
new file mode 100644
index 0000000..8ad809f
--- /dev/null
+++ b/flutter/test/steaddesk/reconnect_message_test.dart
@@ -0,0 +1,44 @@
+import 'package:flutter_hbb/steaddesk/reconnect_message.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  ReconnectMessage classify(String type, String title, String text,
+          {bool retry = false, bool offline = false}) =>
+      reconnectMessage(type, title, text,
+          retry: retry, retryOffline: (_, __, ___) => offline);
+
+  test('authentication and encryption override even a stale retry hint', () {
+    for (final type in [
+      're-input-password',
+      'input-password',
+      'input-2fa',
+      'wait-remote-accept-nook',
+      'confirm-insecure-connection'
+    ]) {
+      expect(classify(type, 'Connection Error', '', retry: true),
+          ReconnectMessage.stop);
+    }
+    expect(
+        classify('error', 'Connection Error', '连接未加密，已拒绝，请联系管理员', retry: true),
+        ReconnectMessage.stop);
+    expect(classify('error', 'Login Error', 'Wrong Password', retry: true),
+        ReconnectMessage.stop);
+  });
+  test('native timers, restart, peer gone and scoped offline retry converge',
+      () {
+    for (final type in ['restarting', 'restarting-show']) {
+      expect(classify(type, 'Connecting...', ''), ReconnectMessage.retry);
+    }
+    expect(classify('error', 'Connection Error', 'Timeout', retry: true),
+        ReconnectMessage.retry);
+    expect(
+        classify('error', 'Connection Error', 'Remote desktop is offline',
+            offline: true),
+        ReconnectMessage.retry);
+    expect(classify('error', 'Connection Error', 'Remote desktop is offline'),
+        ReconnectMessage.stop);
+    expect(classify('error', 'Connection Error', 'Closed manually by the peer'),
+        ReconnectMessage.stop);
+    expect(classify('info', 'Privacy mode', ''), ReconnectMessage.other);
+  });
+}
