diff --git a/flutter/lib/steaddesk/reconnect_message.dart b/flutter/lib/steaddesk/reconnect_message.dart
new file mode 100644
index 0000000..8ef065d
--- /dev/null
+++ b/flutter/lib/steaddesk/reconnect_message.dart
@@ -0,0 +1,25 @@
+enum ReconnectMessage { retry, stop, other }
+
+/// Native hasRetry is authoritative for ordinary transport failures. The
+/// offline exception belongs to the existing UI and includes its time limit.
+ReconnectMessage reconnectMessage(String type, String title, String text,
+    {required bool retry,
+    required bool Function(String, String, String) retryOffline}) {
+  if (title == 'Login Error' ||
+      type == 'input-password' ||
+      type == 're-input-password' ||
+      type == 'input-2fa' ||
+      type == 'wait-remote-accept-nook' ||
+      type.contains('insecure-connection') ||
+      text == '连接未加密，已拒绝，请联系管理员') {
+    return ReconnectMessage.stop;
+  }
+  if (type == 'restarting' || type == 'restarting-show') {
+    return ReconnectMessage.retry;
+  }
+  if (title != 'Connection Error') return ReconnectMessage.other;
+  if (type == 'error' && (retry || retryOffline(type, title, text))) {
+    return ReconnectMessage.retry;
+  }
+  return ReconnectMessage.stop;
+}
