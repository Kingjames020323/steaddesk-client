--- /dev/null
+++ b/flutter/lib/models/os_password_input.dart
@@ -0,0 +1,32 @@
+/// Wakes the OS login screen using the upstream activate_os sequence. Each
+/// action belongs to the session round which started it, including after delays.
+Future<void> sendOsPasswordInRound({
+  required String password,
+  required bool Function() current,
+  required Future<void> Function(String type, String button, int x, int y)
+      mouse,
+  required Future<void> Function(String) text,
+  required Future<void> Function() enter,
+  Future<void> Function(Duration) delay = Future<void>.delayed,
+}) async {
+  if (!current()) return;
+  await mouse('up', 'left', 0, 0);
+  for (final position in [0, 3]) {
+    if (!current()) return;
+    await delay(const Duration(milliseconds: 50));
+    if (!current()) return;
+    await mouse('move', '', position, position);
+  }
+  if (!current()) return;
+  await delay(const Duration(milliseconds: 50));
+  if (!current()) return;
+  final button = password.isEmpty ? 'right' : 'left';
+  await mouse('down', button, 0, 0);
+  if (!current()) return;
+  await mouse('up', button, 0, 0);
+  if (!current() || password.isEmpty) return;
+  await delay(const Duration(milliseconds: 1200));
+  if (!current()) return;
+  await text(password);
+  if (current()) await enter();
+}
