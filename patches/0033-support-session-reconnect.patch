new file mode 100644
index 0000000..f089c61
--- /dev/null
+++ b/flutter/lib/models/reconnect_input.dart
@@ -0,0 +1,43 @@
+/// Per-session input remains disarmed through authentication and until the
+/// keyboard and mouse are released. Delayed synthetic input belongs to one round.
+class ReconnectInput {
+  final _pressed = <int>{};
+  int generation = 0;
+  bool disconnected = false;
+  bool blocked = false;
+
+  void disconnect() {
+    generation++;
+    _pressed.clear();
+    disconnected = true;
+    blocked = true;
+  }
+
+  void authenticated() => disconnected = false;
+
+  bool restoreIfNeutral(bool physicalInputDown) {
+    if (disconnected || physicalInputDown) return false;
+    blocked = false;
+    return true;
+  }
+
+  bool acceptKey(int key, {required bool up, required bool repeat}) {
+    if (blocked) return false;
+    if (generation == 0) return true;
+    if (up) return _pressed.remove(key);
+    if (repeat) return _pressed.contains(key);
+    _pressed.add(key);
+    return true;
+  }
+
+  bool isCurrent(int captured) => !blocked && generation == captured;
+}
+
+/// GetAsyncKeyState's high bit describes physical state; its low bit can
+/// remain set after release. Virtual keys 1–6 include mouse buttons.
+bool anyWindowsInputDown(int Function(int) readKeyState) {
+  for (var vk = 1; vk < 255; vk++) {
+    if ((readKeyState(vk) & 0x8000) != 0) return true;
+  }
+  return false;
+}
diff --git a/flutter/lib/models/windows_input_state.dart b/flutter/lib/models/windows_input_state.dart
new file mode 100644
index 0000000..8d61521
--- /dev/null
+++ b/flutter/lib/models/windows_input_state.dart
@@ -0,0 +1,24 @@
+import 'dart:ffi';
+import 'dart:io';
+
+import 'package:ffi/ffi.dart';
+import 'package:win32/win32.dart'
+    show GetAsyncKeyState, GetForegroundWindow, GetWindowThreadProcessId;
+
+import 'reconnect_input.dart';
+
+/// Windows may return zero for an inaccessible desktop. Only accept a neutral
+/// snapshot when a window in this client process is in the foreground.
+bool windowsPhysicalInputDown() {
+  final window = GetForegroundWindow();
+  if (window == 0) return true;
+  final owner = calloc<Uint32>();
+  try {
+    if (GetWindowThreadProcessId(window, owner) == 0 || owner.value != pid) {
+      return true;
+    }
+    return anyWindowsInputDown(GetAsyncKeyState);
+  } finally {
+    calloc.free(owner);
+  }
+}
