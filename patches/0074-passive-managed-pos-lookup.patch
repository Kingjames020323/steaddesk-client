+import 'package:flutter/material.dart';
+
+import '../ops_health.dart' show HealthFailure;
+import 'check.dart' show Json;
+import 'managed_inventory.dart';
+
+typedef _PosMatch = ({InventoryDraft draft, bool registered});
+
+typedef _Observation = ({DateTime time, List<_PosMatch> rows});
+
+_Observation? _parse(Json data, String storeId) {
+  if (data['store_id'] != storeId || !data.containsKey('observation')) {
+    throw const FormatException();
+  }
+  final observation = data['observation'];
+  if (observation == null) return null;
+  if (observation
+      case {
+        'observed_at': int at,
+        'message': 'POS 端口清单未配置',
+        'rows': List matches,
+      }) {
+    final time = DateTime.fromMillisecondsSinceEpoch(at * 1000);
+    if (DateTime.now().difference(time) >= const Duration(days: 7)) return null;
+    final seen = <String>{};
+    final rows = <_PosMatch>[];
+    for (final match in matches) {
+      if (match is! Json || match['registered'] is! bool) {
+        throw const FormatException();
+      }
+      final draft = managedSuggestions([match], []).singleOrNull;
+      if (draft == null) throw const FormatException();
+      if (seen.add(draft.ip)) {
+        rows.add((draft: draft, registered: match['registered'] as bool));
+      }
+    }
+    return (time: time, rows: rows);
+  }
+  throw const FormatException();
+}
+
+class ManagedPosLookup extends StatefulWidget {
+  final String storeId;
+  final bool readLatestOnMount;
+  final List<Json> entries;
+  final bool Function() canView;
+  final Future<Json> Function(bool start) request;
+  final VoidCallback onOpen;
+  final ValueChanged<InventoryDraft> onAdd;
+
+  const ManagedPosLookup({
+    super.key,
+    required this.storeId,
+    required this.readLatestOnMount,
+    required this.entries,
+    required this.canView,
+    required this.request,
+    required this.onOpen,
+    required this.onAdd,
+  });
+
+  @override
+  State<ManagedPosLookup> createState() => _ManagedPosLookupState();
+}
+
+class _ManagedPosLookupState extends State<ManagedPosLookup> {
+  bool busy = false, opened = false;
+  String? error;
+  _Observation? observation;
+
+  @override
+  void initState() {
+    super.initState();
+    if (widget.readLatestOnMount) read(false);
+  }
+
+  Future<void> read(bool start, {InventoryDraft? add}) async {
+    if (busy || !widget.canView()) return;
+    final previous = observation?.time;
+    widget.onOpen();
+    setState(() {
+      busy = opened = true;
+      observation = null;
+      error = null;
+    });
+    InventoryDraft? selection;
+    try {
+      final data = await widget.request(start);
+      if (!mounted || !widget.canView()) return;
+      final latest = _parse(data, widget.storeId);
+      observation = latest;
+      if (latest != null &&
+          latest.time == previous &&
+          add != null &&
+          latest.rows.any((row) => row.draft == add && !row.registered) &&
+          !widget.entries.any((entry) => entry['ip'] == add.ip)) {
+        selection = add;
+      }
+    } catch (e) {
+      if (!mounted || !widget.canView()) return;
+      error = switch (e) {
+        HealthFailure(status: 401 || 403) => '当前没有查询权限或门店未批准。',
+        HealthFailure(status: 409) => '设备已暂停、已停止或状态过期。请确认门店状态后重试。',
+        HealthFailure(status: 429) => '本店最近已查询，请在十分钟后重试。',
+        HealthFailure(status: 404) => '此服务暂不支持 POS 自报地址查询。',
+        _ => '无法取得 POS 查询结果，请刷新后重试。',
+      };
+    } finally {
+      if (mounted) setState(() => busy = false);
+    }
+    if (mounted && widget.canView() && selection != null) {
+      widget.onAdd(selection);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!widget.canView()) return const SizedBox.shrink();
+    return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+      Wrap(children: [
+        TextButton(
+            onPressed: busy ? null : () => read(true),
+            child: const Text('找 POS 设备')),
+        TextButton(
+            onPressed: busy ? null : () => read(false),
+            child: const Text('查看最近 POS 查询')),
+      ]),
+      const Text('POS 端口清单未配置。仅匹配本店已管理设备的自报地址，不探测网络。'),
+      if (busy)
+        const LinearProgressIndicator()
+      else if (error != null)
+        Text(error!)
+      else if (opened && observation == null)
+        const Text('暂无有效 POS 查询记录。')
+      else if (observation case final result?) ...[
+        Text(
+            '查询时间 ${result.time.toLocal().toString().split('.').first} · 在线状态未经验证'),
+        if (result.rows.isEmpty) const Text('没有匹配的自报地址。'),
+        for (final row in result.rows)
+          ListTile(
+            contentPadding: EdgeInsets.zero,
+            title: Text('已管理设备：${row.draft.name}'),
+            subtitle: Text(row.draft.ip),
+            trailing: row.registered ||
+                    widget.entries.any((entry) => entry['ip'] == row.draft.ip)
+                ? const Text('已登记')
+                : TextButton(
+                    onPressed: widget.entries.length < 32
+                        ? () => read(false, add: row.draft)
+                        : null,
+                    child: const Text('添加')),
+          ),
+      ],
+    ]);
+  }
+}
