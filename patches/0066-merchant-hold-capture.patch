--- a/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/MainService.kt
+++ b/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/MainService.kt
@@ -551,6 +551,26 @@ class MainService : Service() {
         if (restartCapture) {
             captureRestartPending = false
             startCapture(restartInVoiceCall)
+        } else {
+            holdVirtualDisplay(projection)
+        }
+    }
+
+    // Android 14 rejects a projection whose first virtual display is created after the
+    // grant has idled, so the merchant edition opens it paused until a session attaches.
+    private fun holdVirtualDisplay(projection: MediaProjection) {
+        if (!BuildConfig.MERCHANT_EDITION || !reuseVirtualDisplay || virtualDisplay != null) return
+        if (SCREEN_INFO.width <= 0 || SCREEN_INFO.height <= 0) return
+        try {
+            virtualDisplay = projection.createVirtualDisplay(
+                "RustDeskVD",
+                SCREEN_INFO.width, SCREEN_INFO.height, SCREEN_INFO.dpi, VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR,
+                null, null, null
+            )
+            Log.d(logTag, "holdVirtualDisplay: ${virtualDisplay != null}")
+        } catch (e: SecurityException) {
+            Log.w(logTag, "holdVirtualDisplay: got SecurityException", e)
+            handleVirtualDisplayFailure()
         }
     }
 
