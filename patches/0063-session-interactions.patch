diff --git a/flutter/test/steaddesk/power_menu_test.dart b/flutter/test/steaddesk/power_menu_test.dart
new file mode 100644
index 0000000..2c096be
--- /dev/null
+++ b/flutter/test/steaddesk/power_menu_test.dart
@@ -0,0 +1,70 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/power_menu.dart';
+
+void main() {
+  testWidgets(
+      'burst waits after the last tap and keeps the original connection',
+      (t) async {
+    var connection = 'first';
+    final sent = <int>[];
+    Widget screen(bool android) => MaterialApp(
+            home: Scaffold(
+                body: Row(children: [
+          PowerMenuButton(
+              visible: android,
+              enabled: true,
+              tooltip: 'Power menu',
+              activeConnection: () => connection,
+              send: (_, count) async => sent.add(count))
+        ])));
+    final button = find.byTooltip('Power menu');
+    await t.pumpWidget(screen(false));
+    expect(button, findsNothing);
+    await t.pumpWidget(screen(true));
+    await t.tap(button);
+    await t.pump(const Duration(milliseconds: 599));
+    expect(sent, isEmpty);
+    await t.pump(const Duration(milliseconds: 1));
+    expect(sent, [1]);
+    await t.tap(button);
+    await t.pump(const Duration(milliseconds: 550));
+    await t.tap(button);
+    await t.pump(const Duration(milliseconds: 599));
+    expect(sent, [1]);
+    await t.pump(const Duration(milliseconds: 1));
+    expect(sent, [1, 2]);
+    for (var i = 0; i < 7; i++) {
+      await t.tap(button);
+    }
+    await t.pump(powerBurstDelay);
+    expect(sent, [1, 2, 5]);
+    await t.tap(button);
+    connection = 'replacement';
+    await t.pump(powerBurstDelay);
+    expect(sent, [1, 2, 5]);
+    await t.tap(button);
+    await t.pumpWidget(screen(false));
+    await t.pump(powerBurstDelay);
+    expect(sent, [1, 2, 5]);
+  });
+
+  testWidgets('power notice passes clicks through to the canvas', (t) async {
+    var taps = 0;
+    var shown = true;
+    await t.pumpWidget(MaterialApp(
+        home: StatefulBuilder(
+            builder: (_, update) => Stack(fit: StackFit.expand, children: [
+                  GestureDetector(
+                      behavior: HitTestBehavior.opaque, onTap: () => taps++),
+                  if (shown)
+                    PowerNotice('Sent',
+                        onDismiss: () => update(() => shown = false)),
+                ]))));
+    await t.pump(const Duration(milliseconds: 1499));
+    await t.tapAt(t.getCenter(find.text('Sent')));
+    await t.pump(const Duration(milliseconds: 1));
+    expect(find.text('Sent'), findsNothing);
+    expect(taps, 1);
+  });
+}
diff --git a/flutter/test/steaddesk/session_rail_test.dart b/flutter/test/steaddesk/session_rail_test.dart
new file mode 100644
index 0000000..b69eafd
--- /dev/null
+++ b/flutter/test/steaddesk/session_rail_test.dart
@@ -0,0 +1,65 @@
+import 'package:flutter/gestures.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/session_rail.dart';
+
+void main() {
+  testWidgets(
+      'hover floats above canvas, re-entry cancels close, focus keeps notes open',
+      (t) async {
+    const canvasKey = Key('canvas');
+    bool pinned = false;
+    await t.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: StatefulBuilder(
+                builder: (context, state) => SessionRail(
+                    pinned: pinned,
+                    collapsedWidth: 44,
+                    expandedWidth: 240,
+                    panel: (expanded) => Column(children: [
+                          IconButton(
+                              icon: Icon(expanded
+                                  ? Icons.chevron_left
+                                  : Icons.chevron_right),
+                              onPressed: () => state(() => pinned = !pinned)),
+                          if (expanded) const TextField(),
+                        ]),
+                    canvas: GestureDetector(
+                        key: canvasKey,
+                        behavior: HitTestBehavior.opaque,
+                        onTap: () =>
+                            FocusManager.instance.primaryFocus?.unfocus()))))));
+    final canvas = find.byKey(canvasKey);
+    final before = t.getRect(canvas);
+    final mouse = await t.createGesture(kind: PointerDeviceKind.mouse);
+    await mouse.addPointer(location: const Offset(500, 120));
+    await mouse.moveTo(const Offset(20, 20));
+    await t.pump();
+    expect(t.getRect(canvas), before);
+    expect(find.byType(TextField), findsOneWidget);
+    await mouse.moveTo(const Offset(400, 20));
+    await t.pump(const Duration(milliseconds: 1400));
+    await mouse.moveTo(const Offset(100, 40));
+    await t.pump();
+    await t.pump(const Duration(milliseconds: 200));
+    expect(find.byType(TextField), findsOneWidget);
+    await t.tap(find.byType(TextField));
+    await t.pump();
+    await mouse.moveTo(const Offset(500, 20));
+    await t.pump(const Duration(seconds: 2));
+    expect(find.byType(TextField), findsOneWidget);
+    await t.tapAt(const Offset(500, 120));
+    await t.pump();
+    await t.pump(const Duration(milliseconds: 1500));
+    expect(find.byType(TextField), findsNothing);
+    await mouse.moveTo(const Offset(20, 20));
+    await t.pump();
+    await t.tap(find.byIcon(Icons.chevron_left));
+    await t.pump();
+    expect(t.getRect(canvas).left, 240);
+    await mouse.moveTo(const Offset(500, 20));
+    await t.pump(const Duration(seconds: 2));
+    expect(find.byType(TextField), findsOneWidget);
+    await mouse.removePointer();
+  });
+}
