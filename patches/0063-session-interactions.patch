index 0000000..d3cac59
--- /dev/null
+++ b/flutter/lib/steaddesk/session_rail.dart
@@ -0,0 +1,96 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+/// Keeps the canvas at its collapsed width throughout a hover preview.
+class SessionRail extends StatefulWidget {
+  const SessionRail(
+      {super.key,
+      required this.pinned,
+      required this.collapsedWidth,
+      required this.expandedWidth,
+      required this.panel,
+      required this.canvas});
+  final bool pinned;
+  final double collapsedWidth, expandedWidth;
+  final Widget Function(bool expanded) panel;
+  final Widget canvas;
+
+  @override
+  State<SessionRail> createState() => _SessionRailState();
+}
+
+class _SessionRailState extends State<SessionRail> {
+  Timer? timer;
+  bool hovering = false, inside = false, editing = false;
+
+  final scope = FocusScopeNode();
+
+  @override
+  void initState() {
+    super.initState();
+    FocusManager.instance.addListener(handleFocus);
+  }
+
+  void handleFocus() {
+    final active = FocusManager.instance.primaryFocus;
+    final next = scope.hasFocus &&
+        active?.context?.findAncestorStateOfType<EditableTextState>() != null;
+    if (editing == next) return;
+    editing = next;
+    scheduleCollapse();
+  }
+
+  void scheduleCollapse() {
+    timer?.cancel();
+    if (inside || editing || widget.pinned || !hovering) return;
+    timer = Timer(const Duration(milliseconds: 1500), () {
+      if (mounted) setState(() => hovering = false);
+    });
+  }
+
+  @override
+  void didUpdateWidget(SessionRail old) {
+    super.didUpdateWidget(old);
+    if (old.pinned != widget.pinned ||
+        old.collapsedWidth != widget.collapsedWidth) {
+      timer?.cancel();
+      hovering = false;
+    }
+  }
+
+  @override
+  void dispose() {
+    timer?.cancel();
+    FocusManager.instance.removeListener(handleFocus);
+    scope.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final expanded = widget.pinned || hovering;
+    return Stack(fit: StackFit.expand, children: [
+      Positioned.fill(
+          left: widget.pinned ? widget.expandedWidth : widget.collapsedWidth,
+          child: widget.canvas),
+      Positioned(
+          top: 0,
+          left: 0,
+          bottom: 0,
+          width: expanded ? widget.expandedWidth : widget.collapsedWidth,
+          child: MouseRegion(
+              onEnter: (_) {
+                inside = true;
+                timer?.cancel();
+                if (!widget.pinned && !hovering)
+                  setState(() => hovering = true);
+              },
+              onExit: (_) {
+                inside = false;
+                scheduleCollapse();
+              },
+              child: FocusScope(node: scope, child: widget.panel(expanded)))),
+    ]);
+  }
+}
