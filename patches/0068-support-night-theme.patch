diff --git a/flutter/test/steaddesk/support_appearance_test.dart b/flutter/test/steaddesk/support_appearance_test.dart
new file mode 100644
index 0000000..3dfebe8
--- /dev/null
+++ b/flutter/test/steaddesk/support_appearance_test.dart
@@ -0,0 +1,37 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/support_appearance.dart';
+
+void main() {
+  testWidgets('system changes live; explicit choices override OS brightness',
+      (t) async {
+    final platform = t.platformDispatcher;
+    addTearDown(platform.clearPlatformBrightnessTestValue);
+    Future<void> mount(String saved) async {
+      await t.pumpWidget(MaterialApp(
+          theme: ThemeData.light(),
+          darkTheme: supportNightTheme(ThemeData.dark()),
+          themeMode: supportMode(saved),
+          home: Builder(
+              builder: (c) => Text(c.night ? 'night' : 'day',
+                  style: TextStyle(color: c.supportInk)))));
+      await t.pumpAndSettle();
+    }
+
+    platform.platformBrightnessTestValue = Brightness.light;
+    await mount('');
+    expect(find.text('day'), findsOneWidget);
+    platform.platformBrightnessTestValue = Brightness.dark;
+    await t.pumpAndSettle();
+    expect(find.text('night'), findsOneWidget);
+    await mount('light');
+    expect(find.text('day'), findsOneWidget);
+    platform.platformBrightnessTestValue = Brightness.light;
+    await mount('dark');
+    final c = t.element(find.text('night'));
+    expect(Theme.of(c).scaffoldBackgroundColor, Night.window);
+    expect(Theme.of(c).colorScheme.onPrimary, Night.window);
+    expect(c.supportAccent, Night.accent);
+    expect(supportMode('unknown'), ThemeMode.system);
+  });
+}
