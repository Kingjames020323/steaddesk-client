diff --git a/flutter/lib/steaddesk/support_appearance.dart b/flutter/lib/steaddesk/support_appearance.dart
new file mode 100644
index 0000000..d696852
--- /dev/null
+++ b/flutter/lib/steaddesk/support_appearance.dart
@@ -0,0 +1,101 @@
+import 'package:flutter/material.dart';
+
+const appearanceOption = 'support-appearance';
+ThemeMode supportMode(String value) => ThemeMode.values
+    .firstWhere((mode) => mode.name == value, orElse: () => ThemeMode.system);
+
+class Night {
+  static const window = Color(0xff08090a),
+      panel = Color(0xff0f1011),
+      overlay = Color(0xff191a1b),
+      weak = Color(0x0dffffff),
+      line = Color(0x14ffffff),
+      strong = Color(0x1fffffff),
+      selection = Color(0x291fa7e0),
+      accent = Color(0xff1fa7e0),
+      text = Color(0xfff3f4f6),
+      muted = Color(0xff9ca3af),
+      online = Color(0xff4ade80),
+      warning = Color(0xfff59e0b),
+      error = Color(0xfff87171),
+      danger = Color(0xffdc2626);
+}
+
+extension SupportAppearance on BuildContext {
+  bool get night => Theme.of(this).brightness == Brightness.dark;
+  Color shade(Color day, Color dark) => night ? dark : day;
+  Color get supportAccent => shade(const Color(0xff0a6fa8), Night.accent);
+  Color get supportInk => shade(const Color(0xff0b2e42), Night.text);
+  Color get supportMuted => shade(const Color(0xff4b5563), Night.muted);
+  Color get supportLine => shade(const Color(0xffe5e7eb), Night.line);
+  Color get supportHairline => shade(const Color(0xffeef0f2), Night.weak);
+  Color get supportHover => shade(const Color(0xfff3f4f6), Night.overlay);
+  Color get supportSelection => shade(const Color(0xffdff2fa), Night.selection);
+}
+
+ThemeData supportNightTheme(ThemeData upstream) {
+  const rounded = RoundedRectangleBorder(
+      borderRadius: BorderRadius.all(Radius.circular(6)));
+  final colors = upstream.colorScheme.copyWith(
+      primary: Night.accent,
+      onPrimary: Night.window,
+      secondary: Night.accent,
+      surface: Night.panel,
+      onSurface: Night.text,
+      error: Night.error,
+      outline: Night.strong);
+  return upstream.copyWith(
+    colorScheme: colors,
+    scaffoldBackgroundColor: Night.window,
+    canvasColor: Night.panel,
+    cardColor: Night.overlay,
+    dividerColor: Night.line,
+    hoverColor: Night.overlay,
+    shadowColor: Colors.transparent,
+    dialogBackgroundColor: Night.overlay,
+    dialogTheme: upstream.dialogTheme.copyWith(
+        backgroundColor: Night.overlay,
+        elevation: 0,
+        surfaceTintColor: Colors.transparent,
+        shape: const RoundedRectangleBorder(
+            borderRadius: BorderRadius.all(Radius.circular(8)),
+            side: BorderSide(color: Night.strong))),
+    inputDecorationTheme:
+        upstream.inputDecorationTheme.copyWith(fillColor: Night.panel),
+    textButtonTheme: TextButtonThemeData(
+        style: TextButton.styleFrom(
+            foregroundColor: Night.accent, shape: rounded)),
+    popupMenuTheme:
+        upstream.popupMenuTheme.copyWith(color: Night.overlay, elevation: 0),
+    menuTheme: const MenuThemeData(
+        style: MenuStyle(
+            elevation: WidgetStatePropertyAll(0.0),
+            backgroundColor: WidgetStatePropertyAll(Night.overlay),
+            side: WidgetStatePropertyAll(BorderSide(color: Night.strong)))),
+    filledButtonTheme: FilledButtonThemeData(
+        style: FilledButton.styleFrom(
+            foregroundColor: Night.window,
+            backgroundColor: Night.accent,
+            shape: rounded)),
+  );
+}
+
+ThemeData supportHomeFonts(ThemeData base) {
+  const family = 'Inter';
+  const fallback = ['Microsoft YaHei UI', 'Segoe UI'];
+  TextStyle style(double size, double height, int weight) => TextStyle(
+      fontFamily: family,
+      fontFamilyFallback: fallback,
+      fontSize: size,
+      height: height / size,
+      fontVariations: [FontVariation('wght', weight.toDouble())]);
+  final text =
+      base.textTheme.apply(fontFamily: family, fontFamilyFallback: fallback);
+  return base.copyWith(
+      textTheme: text.copyWith(
+          labelSmall: text.labelSmall?.merge(style(11, 16, 400)),
+          bodySmall: text.bodySmall?.merge(style(12, 16, 400)),
+          bodyMedium: text.bodyMedium?.merge(style(13, 20, 400)),
+          titleMedium: text.titleMedium?.merge(style(16, 24, 510)),
+          titleLarge: text.titleLarge?.merge(style(20, 28, 590))));
+}
