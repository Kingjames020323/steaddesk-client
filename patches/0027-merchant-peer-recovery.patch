@@ -0,0 +1,46 @@
+package com.carriez.flutter_hbb;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.ServiceConnection;
+import com.steaddesk.recovery.PeerWatchdog;
+
+/** Loaded only by the merchant edition. Native state also covers sessions during FGS teardown. */
+public final class MerchantRecovery {
+    private static PeerWatchdog watchdog;
+    private static ServiceConnection publication;
+
+    static { System.loadLibrary("rustdesk"); }
+    private static native int sessionState();
+
+    public static synchronized void start(MainService service) {
+        if (watchdog != null) return;
+        watchdog = new PeerWatchdog(service, new ComponentName("com.steaddesk.agent",
+                "com.meshcentral.agent.MerchantWakeService"), "com.steaddesk.agent.IWakeConnection");
+        publication = PeerWatchdog.publish(service, AgentWakeService.class);
+        watchdog.start();
+    }
+
+    public static synchronized void stop(MainService service) {
+        if (watchdog == null) return;
+        watchdog.stop();
+        PeerWatchdog.unpublish(service, publication);
+        publication = null;
+        watchdog = null;
+    }
+
+    static synchronized int status() {
+        int session = sessionState();
+        return session == 0 ? (watchdog == null ? 0 : 1) : session;
+    }
+
+    static synchronized boolean restore(Context context) {
+        return status() != 0 || BootReceiver.resumeService(context);
+    }
+
+    public static synchronized String paused() {
+        return watchdog == null ? "" : Boolean.toString(watchdog.isPaused());
+    }
+
+    private MerchantRecovery() {}
+}
