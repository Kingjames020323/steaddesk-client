@@ -0,0 +1,36 @@
+package com.carriez.flutter_hbb;
+
+import android.app.Service;
+import android.content.Intent;
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+/** The exported Binder never accepts a component, Intent or arguments from the caller. */
+public final class AgentWakeService extends Service {
+    private final Binder endpoint = new Binder() {
+        @Override protected boolean onTransact(int code, Parcel data, Parcel reply, int flags) throws RemoteException {
+            if (code != FIRST_CALL_TRANSACTION && code != FIRST_CALL_TRANSACTION + 1)
+                return super.onTransact(code, data, reply, flags);
+            data.enforceInterface("com.steaddesk.remote.IWakeService");
+            enforceCallingPermission("com.steaddesk.remote.permission.WAKE_SERVICE", "Agent signature required");
+            String[] packages = getPackageManager().getPackagesForUid(Binder.getCallingUid());
+            if (packages == null || packages.length != 1 || !"com.steaddesk.agent".equals(packages[0]))
+                throw new SecurityException("Agent UID required");
+            long identity = Binder.clearCallingIdentity();
+            try {
+                int state = MerchantRecovery.status();
+                if (code == FIRST_CALL_TRANSACTION && state == 0 && !MerchantRecovery.restore(AgentWakeService.this))
+                    throw new IllegalStateException("Recovery unavailable");
+                if (reply != null) {
+                    reply.writeNoException();
+                    if (code == FIRST_CALL_TRANSACTION + 1) reply.writeInt(state);
+                }
+                return true;
+            } finally { Binder.restoreCallingIdentity(identity); }
+        }
+    };
+
+    @Override public IBinder onBind(Intent intent) { return endpoint; }
+}
diff --git a/flutter/android/app/src/steaddeskMerchant/java/com/carriez/flutter_hbb/MerchantRecovery.java b/flutter/android/app/src/steaddeskMerchant/java/com/carriez/flutter_hbb/MerchantRecovery.java
