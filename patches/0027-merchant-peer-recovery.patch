+++ b/flutter/android/app/src/steaddeskMerchant/java/com/steaddesk/recovery/PeerWatchdog.java
@@ -0,0 +1,299 @@
+package com.steaddesk.recovery;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.RestrictionsManager;
+import android.content.ServiceConnection;
+import android.content.SharedPreferences;
+import android.content.pm.PackageManager;
+import android.content.pm.ServiceInfo;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.preference.PreferenceManager;
+import android.util.AtomicFile;
+import android.util.Log;
+import org.json.JSONObject;
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileNotFoundException;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/** One fixed peer per build. Passive probing must not restart a stopped package. */
+public final class PeerWatchdog {
+    private static final long PERIOD = 300_000L, HOUR = 3_600_000L;
+    private static final int MAX_WAKES = 3;
+    private static final int WAKE = IBinder.FIRST_CALL_TRANSACTION, STATUS = WAKE + 1;
+    private final Context app;
+    private final ComponentName peer;
+    private final String descriptor;
+    private final SharedPreferences budget;
+    private final HandlerThread thread = new HandlerThread("Peer health");
+    private Handler worker;
+    private Probe active;
+    private volatile boolean running;
+
+    public PeerWatchdog(Context context, ComponentName peer, String descriptor) {
+        app = context.getApplicationContext();
+        this.peer = peer;
+        this.descriptor = descriptor;
+        budget = app.getSharedPreferences("self_heal_budget", Context.MODE_PRIVATE);
+    }
+
+    /** Keep the read-only query reachable with bind flags=0 while the real service is live. */
+    public static ServiceConnection publish(Context context, Class<?> endpoint) {
+        ServiceConnection hold = new ServiceConnection() {
+            public void onServiceConnected(ComponentName name, IBinder service) {}
+            public void onServiceDisconnected(ComponentName name) {}
+        };
+        try {
+            if (context.bindService(new Intent(context, endpoint), hold, Context.BIND_AUTO_CREATE)) return hold;
+        } catch (SecurityException denied) {
+            Log.w("PeerWatchdog", "Local status endpoint denied");
+        }
+        unpublish(context, hold);
+        return null;
+    }
+
+    public static void unpublish(Context context, ServiceConnection hold) {
+        if (hold == null) return;
+        try {
+            context.unbindService(hold);
+        } catch (IllegalArgumentException unregistered) {
+            // A failed bind can either register its dispatcher or fail before registration.
+        }
+    }
+
+    public void start() {
+        if (running) return;
+        thread.start();
+        worker = new Handler(thread.getLooper());
+        running = true;
+        worker.post(this::checkNow);
+    }
+
+    public void stop() {
+        if (!running) return;
+        running = false;
+        worker.post(() -> {
+            if (active != null) active.close();
+            worker.removeCallbacksAndMessages(null);
+            thread.quitSafely();
+        });
+    }
+
+    private boolean enabled() {
+        String key = "self_heal_enabled";
+        RestrictionsManager manager = (RestrictionsManager) app.getSystemService(Context.RESTRICTIONS_SERVICE);
+        Bundle restrictions = manager == null ? null : manager.getApplicationRestrictions();
+        if (restrictions != null && restrictions.containsKey(key)) return restrictions.getBoolean(key);
+        return PreferenceManager.getDefaultSharedPreferences(app).getBoolean(key, true);
+    }
+
+    // Serialize reservations across overlapping service instances as well as Binder callbacks.
+    // A clock rollback conservatively retains future timestamps. Never overwrite corrupt history.
+    static List<Long> recent(String history, long now) {
+        List<Long> values = new ArrayList<>();
+        if (!history.isEmpty()) {
+            for (String stamp : history.split(",", -1)) {
+                long time = Long.parseLong(stamp);
+                if (time > now - HOUR) values.add(time);
+            }
+        }
+        return values;
+    }
+
+    public boolean isPaused() {
+        synchronized (PeerWatchdog.class) {
+            try { return recent(budget.getString("attempts", ""), System.currentTimeMillis()).size() >= MAX_WAKES; }
+            catch (RuntimeException invalid) { return true; }
+        }
+    }
+
+    private boolean reserve(String cause) {
+        if (!running || !enabled()) {
+            log("result", cause, "disabled");
+            return false;
+        }
+        synchronized (PeerWatchdog.class) {
+            long now = System.currentTimeMillis();
+            try {
+                List<Long> history = recent(budget.getString("attempts", ""), now);
+                if (history.size() >= MAX_WAKES) {
+                    log("result", cause, "rate_limited");
+                    return false;
+                }
+                history.add(now);
+                StringBuilder encoded = new StringBuilder();
+                for (long value : history) {
+                    if (encoded.length() > 0) encoded.append(',');
+                    encoded.append(value);
+                }
+                if (!budget.edit().putString("attempts", encoded.toString()).commit()) {
+                    log("result", cause, "budget_unavailable");
+                    return false;
+                }
+            } catch (RuntimeException invalid) {
+                log("result", cause, "budget_unavailable");
+                return false;
+            }
+        }
+        log("wake", cause, "reserved");
+        return true;
+    }
+
+    private static String wakePermission(String packageName) {
+        return packageName + ".permission." +
+                ("com.steaddesk.agent".equals(packageName) ? "WAKE_CONNECTION" : "WAKE_SERVICE");
+    }
+
+    void checkNow() {
+        if (!running) return;
+        worker.postDelayed(this::checkNow, PERIOD);
+        if (active != null) return;
+        try {
+            PackageManager packages = app.getPackageManager();
+            ServiceInfo info = packages.getServiceInfo(peer, 0);
+            String required = wakePermission(peer.getPackageName());
+            String reversePermission = wakePermission(app.getPackageName());
+            if (!info.exported || !required.equals(info.permission) ||
+                    app.checkSelfPermission(required) != PackageManager.PERMISSION_GRANTED ||
+                    packages.checkPermission(reversePermission, peer.getPackageName()) != PackageManager.PERMISSION_GRANTED) {
+                log("check", "peer_permission", "denied");
+                return;
+            }
+        } catch (PackageManager.NameNotFoundException | SecurityException unavailable) {
+            log("check", "peer_endpoint", "unavailable");
+            return;
+        }
+        new Probe(false).bind();
+    }
+
+    private final class Probe implements ServiceConnection {
+        final boolean charged;
+        boolean needsUnbind;
+        final Runnable timeout = () -> unavailable("timeout");
+        Probe(boolean charged) { this.charged = charged; }
+
+        void bind() {
+            active = this;
+            try {
+                needsUnbind = true;
+                boolean bound = app.bindService(new Intent().setComponent(peer), this,
+                        charged ? Context.BIND_AUTO_CREATE : 0);
+                if (!bound) { unavailable("not_bound"); return; }
+                worker.postDelayed(timeout, charged ? 10_000L : 2_000L);
+            } catch (SecurityException denied) {
+                close();
+                log("check", "bind", "denied");
+            } catch (RuntimeException failure) {
+                close();
+                log("check", "bind", "failed");
+            }
+        }
+
+        public void onServiceConnected(ComponentName name, IBinder binder) {
+            worker.post(() -> inspect(binder));
+        }
+        public void onServiceDisconnected(ComponentName name) { worker.post(() -> unavailable("disconnected")); }
+        public void onBindingDied(ComponentName name) { worker.post(() -> unavailable("binding_died")); }
+        public void onNullBinding(ComponentName name) { worker.post(() -> unavailable("null_binding")); }
+
+        void close() {
+            worker.removeCallbacks(timeout);
+            if (active == this) active = null;
+            if (needsUnbind) {
+                needsUnbind = false;
+                unpublish(app, this);
+            }
+        }
+        void unavailable(String reason) {
+            if (active != this) return;
+            close();
+            log(charged ? "result" : "check", reason, "unavailable");
+            // AUTO_CREATE can start the target process, so it consumes a slot before binding.
+            if (!charged && reserve(reason)) new Probe(true).bind();
+        }
+
+        void inspect(IBinder binder) {
+            if (!running || active != this) return;
+            worker.removeCallbacks(timeout);
+            try {
+                int state = transact(binder, STATUS);
+                if (state != 0) {
+                    log(charged ? "result" : "check", "peer_status",
+                            state == 2 ? "in_session" : state == 1 ? "healthy" : "unknown");
+                    return;
+                }
+                if (!charged && !reserve("service_stopped")) return;
+                if (!running || !enabled()) { log("result", "switch", "disabled"); return; }
+                // The peer independently rechecks its live sessions when it receives WAKE.
+                transact(binder, WAKE);
+                log("result", "wake_request", "acknowledged");
+            } catch (RemoteException | RuntimeException failure) {
+                log(charged ? "result" : "check", "transaction", "failed");
+            } finally { close(); }
+        }
+
+        int transact(IBinder binder, int code) throws RemoteException {
+            Parcel request = Parcel.obtain(), reply = Parcel.obtain();
+            try {
+                request.writeInterfaceToken(descriptor);
+                if (!binder.transact(code, request, reply, 0)) throw new RemoteException("unsupported");
+                reply.readException();
+                if (code == STATUS && reply.dataAvail() < 4) return 3;
+                return code == STATUS ? reply.readInt() : 0;
+            } finally { reply.recycle(); request.recycle(); }
+        }
+    }
+
+    static ArrayDeque<String> readHistory(BufferedReader input) throws IOException {
+        ArrayDeque<String> lines = new ArrayDeque<>();
+        String line;
+        while ((line = input.readLine()) != null) {
+            if (lines.size() == 499) lines.removeFirst();
+            lines.addLast(line);
+        }
+        return lines;
+    }
+
+    /** Atomic replacement leaves a complete 500-line JSONL file after process death. */
+    private void log(String action, String reason, String result) {
+        synchronized (PeerWatchdog.class) {
+            AtomicFile file = new AtomicFile(new File(app.getFilesDir(), "self-heal.jsonl"));
+            FileOutputStream output = null;
+            try {
+                ArrayDeque<String> lines;
+                try (BufferedReader input = new BufferedReader(new InputStreamReader(file.openRead(), StandardCharsets.UTF_8))) {
+                    lines = readHistory(input);
+                } catch (FileNotFoundException firstRun) {
+                    lines = new ArrayDeque<>();
+                }
+                SimpleDateFormat utc = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.ROOT);
+                utc.setTimeZone(TimeZone.getTimeZone("UTC"));
+                lines.add(new JSONObject().put("time", utc.format(new Date())).put("action", action)
+                        .put("reason", reason).put("result", result).toString());
+                output = file.startWrite();
+                for (String entry : lines) output.write((entry + "\n").getBytes(StandardCharsets.UTF_8));
+                file.finishWrite(output);
+            } catch (Exception failure) {
+                if (output != null) file.failWrite(output);
+                Log.w("PeerWatchdog", "Local recovery log unavailable");
+            }
+        }
+    }
+}
