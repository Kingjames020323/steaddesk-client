+  Future<bool> isAppendOnly(String account, String id) async => false;
+}
+
+final _clock = DateTime.utc(2026, 11, 19, 19, 10);
+
+Map<String, dynamic> _row(int age, int minutes, String category, String result,
+    String agent, String note) {
+  final ended = _clock.subtract(Duration(days: age));
+  return {
+    'id': 'demo-$age',
+    'device_id': 'demo-101',
+    'display_name': '示例商户 A 前台点单平板',
+    'started_at': ended.subtract(Duration(minutes: minutes)).toIso8601String(),
+    'ended_at': ended.toIso8601String(),
+    'category': category,
+    'result': result,
+    'agent': agent,
+    'note': note,
+  };
+}
+
+final _records = [
+  _row(
+      0, 14, 'printer', 'resolved', 'support-demo', '后厨打印机网线松了，商户重新插好，重打了两张单。'),
+  _row(1, 9, 'other', 'resolved', 'support-demo', '重新进入 Kiosk 模式后，打印服务恢复。'),
+  _row(5, 12, 'network', 'unresolved', 'amy', '路由器需要更换，已约周四上门。'),
+  _row(8, 3, 'pos_operation', 'resolved', 'amy', '前台已恢复接单。'),
+];
+
+void main() {
+  setUpAll(loadJ25Fonts);
+  for (final night in [false, true]) {
+    final mode = night ? 'night' : 'day';
+    testWidgets(
+        'Windows case surfaces, scoped history and session note ($mode)',
+        (t) async {
+      t.view.devicePixelRatio = 1;
+      t.view.physicalSize = const Size(1280, 800);
+      addTearDown(t.view.resetPhysicalSize);
+      addTearDown(t.view.resetDevicePixelRatio);
+      final frame = GlobalKey();
+      final base = ThemeData(
+        platform: TargetPlatform.windows,
+        brightness: night ? Brightness.dark : Brightness.light,
+        fontFamily: 'J25 UI',
+      );
+      var open = false;
+      var note = _records.first['note'] as String;
+      final data = <String, dynamic>{
+        'session': 'synthetic-session',
+        'note': note,
+        'summary': {'latest': _records.first, 'count_30d': _records.length},
+        'can_store': false,
+        'device': _records,
+        'device_note': '后厨打印机重启后要等一分钟才会重新连上，请先确认出纸。',
+      };
+      await t.pumpWidget(MaterialApp(
+        theme: night ? supportNightTheme(base) : base,
+        builder: (_, child) => RepaintBoundary(key: frame, child: child!),
+        home: StatefulBuilder(builder: (context, refresh) {
+          return Scaffold(
+            appBar: AppBar(
+              title: const Text('示例商户 A · 前台点单平板'),
+              actions: [
+                TextButton(
+                    onPressed: () => showCaseCloseDialog(context,
+                            store: _Store(),
+                            account: 'support-demo',
+                            record: {
+                              ..._records.first,
+                              'status': 'draft',
+                              'help_id': '1042',
+                              'note': note,
+                              'auto': {'files': 0}
+                            }),
+                    child: const Text('结案')),
+              ],
+            ),
+            body: SessionRail(
+              pinned: true,
+              collapsedWidth: 44,
+              expandedWidth: 240,
+              panel: (_) => Material(
+                color:
+                    context.shade(SteadDeskTheme.sessionSurface, Night.panel),
+                child: ListView(
+                    padding: const EdgeInsets.only(top: 16),
+                    children: [
+                      CaseHistorySidebar(
+                          data: data,
+                          clock: () => _clock,
+                          onOpen: () => refresh(() => open = true),
+                          onNoteChanged: (s) => note = s),
+                    ]),
+              ),
+              canvas: Stack(fit: StackFit.expand, children: [
+                ColoredBox(
+                    color:
+                        context.shade(const Color(0xfff2f5f7), Night.window)),
+                if (open)
+                  Align(
+                      alignment: Alignment.centerLeft,
+                      child: SizedBox(
+                          width: 420,
+                          child: CaseHistoryDrawer(
+                              data: data,
+                              clock: () => _clock,
+                              translate: (key) =>
+                                  key == 'Expand note' ? '展开' : '收起',
+                              onClose: () => refresh(() => open = false),
+                              onEditDevice: () {},
+                              onAppend: (_, __, ___) async {}))),
+              ]),
+            ),
+          );
+        }),
+      ));
+      await t.pumpAndSettle();
+      final noteField = t.widget<TextField>(find.byType(TextField));
+      expect(noteField.decoration!.fillColor,
+          night ? Night.panel : Colors.white.withOpacity(.72));
+      await t.tap(find.text('历史报告'));
+      await t.pumpAndSettle();
+      expect(find.textContaining('近 30 天 4 次 · 未解决 1'), findsOneWidget);
+      final drawerMaterial = t
+          .widgetList<Material>(find.descendant(
+              of: find.byType(CaseHistoryDrawer),
+              matching: find.byType(Material)))
+          .first;
+      expect(drawerMaterial.color, night ? Night.overlay : Colors.white);
+      expect(
+          t
+              .widget<TextButton>(find.widgetWithText(TextButton, '本门店'))
+              .onPressed,
+          isNull);
+      await writeJ25Capture(t, frame, 'history-$mode');
+      await t.tap(find.byTooltip('关闭历史报告'));
+      await t.pumpAndSettle();
+      await t.tap(find.text('结案'));
+      await t.pumpAndSettle();
+      expect(t.widget<Dialog>(find.byType(Dialog)).backgroundColor,
+          night ? Night.overlay : Colors.white);
+      final selected =
+          t.widget<OutlinedButton>(find.widgetWithText(OutlinedButton, '已解决'));
+      expect(selected.style!.backgroundColor!.resolve({}),
+          night ? Night.selection : SteadDeskTheme.brandSurface);
+      final save = t.widget<ElevatedButton>(
+          find.widgetWithText(ElevatedButton, '保存（Enter）'));
+      expect(save.style!.foregroundColor!.resolve({}),
+          night ? Night.window : Colors.white);
+      await writeJ25Capture(t, frame, 'case-$mode');
+      await t.tap(find.widgetWithText(OutlinedButton, '未解决'));
+      await t.pumpAndSettle();
+      expect(find.text('跟进人'), findsOneWidget);
+      expect(t.takeException(), isNull);
+    });
+  }
+}
