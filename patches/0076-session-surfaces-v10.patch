diff --git a/flutter/test/steaddesk/j25c_capture.dart b/flutter/test/steaddesk/j25c_capture.dart
new file mode 100644
index 0000000..fa6b8c5
--- /dev/null
+++ b/flutter/test/steaddesk/j25c_capture.dart
@@ -0,0 +1,65 @@
+import 'dart:io';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// Register actual system faces in the widget-test engine, which otherwise uses
+// the Ahem square-glyph font. These files are not bundled in the product.
+Future<void> loadJ25Fonts() async {
+  final cjk = [
+    if (Platform.environment['STEADDESK_J25_FONT'] case final String path) path,
+    if (Platform.isWindows) ...[
+      r'C:\Windows\Fonts\msyh.ttc',
+      r'C:\Windows\Fonts\simsun.ttc',
+      r'C:\Windows\Fonts\msjh.ttc',
+      r'C:\Windows\Fonts\meiryo.ttc',
+    ],
+    if (Platform.isMacOS) '/System/Library/Fonts/STHeiti Light.ttc',
+  ].map(File.new).where((f) => f.existsSync());
+  if (cjk.isEmpty && Platform.environment.containsKey('STEADDESK_J25_SHOTS')) {
+    throw StateError('A CJK font is required for the session screenshots.');
+  }
+  if (cjk.isNotEmpty) {
+    final data = ByteData.sublistView(cjk.first.readAsBytesSync());
+    for (final family in [
+      'J25 UI',
+      'Inter',
+      'Microsoft YaHei UI',
+      'Segoe UI'
+    ]) {
+      await (FontLoader(family)..addFont(Future.value(data))).load();
+    }
+  }
+  final mono = [
+    if (Platform.isWindows) r'C:\Windows\Fonts\consola.ttf',
+    if (Platform.isMacOS) '/System/Library/Fonts/Menlo.ttc',
+  ].map(File.new).where((f) => f.existsSync());
+  if (mono.isNotEmpty) {
+    final bytes = ByteData.sublistView(mono.first.readAsBytesSync());
+    await (FontLoader('Consolas')..addFont(Future.value(bytes))).load();
+  }
+  await (FontLoader('MaterialIcons')
+        ..addFont(rootBundle.load('fonts/MaterialIcons-Regular.otf')))
+      .load();
+}
+
+Future<void> writeJ25Capture(
+    WidgetTester tester, GlobalKey boundary, String name) async {
+  final dir = Platform.environment['STEADDESK_J25_SHOTS'];
+  if (dir == null || dir.isEmpty) return;
+  final render =
+      boundary.currentContext!.findRenderObject() as RenderRepaintBoundary;
+  await tester.runAsync(() async {
+    final image = await render.toImage(pixelRatio: 1);
+    try {
+      final bytes = await image.toByteData(format: ui.ImageByteFormat.png);
+      Directory(dir).createSync(recursive: true);
+      await File('$dir/$name.png').writeAsBytes(bytes!.buffer.asUint8List());
+    } finally {
+      image.dispose();
+    }
+  });
+}
