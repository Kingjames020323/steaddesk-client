+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  setUpAll(loadJ25Fonts);
+  testWidgets(
+      'Android locations preserve grant and availability hints and recheck at click',
+      (t) async {
+    RemoteFileScope? scope(bool allowed) =>
+        RemoteFileScope.fromPeerAdditions(jsonEncode({
+          'steaddesk_file_scope': {
+            'authorized': allowed,
+            'download': '/allowed/download',
+            'pictures': '/allowed/pictures',
+            'logs': '/allowed/logs'
