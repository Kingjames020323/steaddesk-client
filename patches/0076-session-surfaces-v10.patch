+      addTearDown(rightPath.dispose);
+      int? localSelected;
+      bool done = true, expanded = true;
+      final base = ThemeData(
+          brightness: night ? Brightness.dark : Brightness.light,
+          fontFamily: 'J25 UI');
+      await t.pumpWidget(MaterialApp(
+          theme: night ? supportNightTheme(base) : base,
+          home: RepaintBoundary(
+              key: capture,
+              child: StatefulBuilder(builder: (context, set) {
+                Widget pane(bool local) => TransferPaneFrame(
