+                          local: local,
+                          label: local ? '发送' : '接收',
+                          onPressed:
+                              local && localSelected != null ? () {} : null),
+                      toolsLabel: '更多',
+                      tools: const Text('刷新'),
+                      places: ListView(children: [
+                        for (final name in local
+                            ? ['桌面', '下载', '文档']
+                            : ['下载', '图片', '视频', 'DCIM', 'SteadDesk 日志'])
+                          TransferPlace(name,
+                              selected: name == (local ? '文档' : '下载'),
+                              onPressed: () {}),
+                        if (local) ...[
+                          TransferPlace('此电脑',
+                              leading: const Icon(Icons.expand_more, size: 15),
+                              onPressed: () {}),
+                          for (final (name, free) in [
+                            ('本地磁盘 (C:)', '120 GB 可用'),
+                            ('数据 (D:)', '412 GB 可用'),
+                            ('U 盘 (E:)', '14 GB 可用')
+                          ])
+                            TransferPlace(name,
+                                subtitle: free,
+                                indented: true,
+                                onPressed: () {}),
+                        ],
+                      ]),
+                      table: LayoutBuilder(builder: (context, box) {
+                        final cols = [
+                          for (final share in [.52, .10, .02, .36])
+                            52 + (box.maxWidth - 208) * share
+                        ];
+                        final files = local ? localFiles : remoteFiles;
+                        return Column(children: [
+                          TransferTableHeader(
+                              widths: cols,
+                              labels: const ['名称', '大小', '类型', '修改时间'],
+                              sortedColumn: 0,
+                              ascending: true,
+                              onSort: (_) {},
+                              divider: (_) => const SizedBox(width: 7)),
+                          Expanded(
+                              child: ListView.builder(
+                                  itemExtent: 28,
+                                  itemCount: files.length,
+                                  itemBuilder: (_, i) => TransferFileRow(
+                                      cells: files[i],
+                                      widths: cols,
+                                      selected: local && localSelected == i,
+                                      onTap: () {
+                                        if (local) set(() => localSelected = i);
+                                      }))),
+                        ]);
+                      }),
+                    );
+                return TransferBoard(
+                    local: pane(true),
+                    remote: pane(false),
+                    localWidth: (1280 - 7) / 2,
+                    separator: VerticalDivider(
+                        width: 7, thickness: 1, color: context.ftLine),
+                    queueSplitter:
+                        Divider(height: 7, thickness: 1, color: context.ftLine),
+                    queueHeader: TransferQueueHeader(
+                        title: '传输队列',
+                        summary: '1 进行中 · ${done ? "1" : "0"} 已完成',
+                        clearLabel: '清除已完成',
+                        collapsed: !expanded,
+                        onToggle: () => set(() => expanded = !expanded),
+                        onClear: done ? () => set(() => done = false) : null),
+                    queueHeight: expanded ? 100 : 0,
+                    queueBody: ListView(children: [
+                      TransferJobRow(
+                          name: localFiles[4][0],
+                          direction: '本地 → 远程 · 下载',
+                          status: '',
+                          trailing: '62%',
+                          progress: .62,
+                          actions: const Icon(Icons.close, size: 15)),
+                      if (done)
+                        TransferJobRow(
+                            name: localFiles[10][0],
+                            direction: '远程 → 本地 · 文档',
+                            status: '已完成',
+                            trailing: '21.7 KB',
+                            actions: const Icon(Icons.close, size: 15)),
+                    ]));
+              }))));
+      await t.pumpAndSettle();
+      final file = find.text(localFiles[4][0]).first;
+      expect(
+          t
+              .widget<TransferActionButton>(
+                  find.byKey(const ValueKey('test-send')))
+              .onPressed,
+          isNull);
+      await t.tap(file);
+      await t.pumpAndSettle();
+      expect(
+          t
+              .widget<TransferActionButton>(
+                  find.byKey(const ValueKey('test-send')))
+              .onPressed,
+          isNotNull);
+      expect(
+          t
+              .widget<LinearProgressIndicator>(
+                  find.byType(LinearProgressIndicator))
+              .value,
+          .62);
+      expect(
+          t
+              .widget<Material>(find
+                  .descendant(
+                      of: find.byType(TransferBoard),
+                      matching: find.byType(Material))
+                  .first)
+              .color,
