@@ -0,0 +1,46 @@
+import 'dart:convert';
+
+import '../models/platform_model.dart';
+
+// Upstream recent peers contain one entry per ID, without individual session
+// times. Record only live peer-info handshakes; never serialize the Peer.
+class DeviceSessions {
+  static const _key = 'steaddesk-recent-handshakes';
+
+  static List<({String session, DateTime time, String version})> read(
+      String id) {
+    final raw = bind.mainGetPeerOptionSync(id: id, key: _key);
+    if (raw.isEmpty) return [];
+    try {
+      final rows = jsonDecode(raw);
+      if (rows is! List) return [];
+      return [
+        for (final row in rows)
+          if (row
+              case {'session': String s, 'time': String t, 'version': String v})
+            if (DateTime.tryParse(t) case final time?)
+              (session: s, time: time.toLocal(), version: v),
+      ].take(3).toList();
+    } on FormatException {
+      return [];
+    }
+  }
+
+  static void established(String id, String session, String version) {
+    final rows = read(id);
+    if (rows.any((r) => r.session == session)) return;
+    final now = DateTime.now().toUtc().toIso8601String();
+    bind.mainSetPeerOptionSync(
+        id: id,
+        key: _key,
+        value: jsonEncode([
+          {'session': session, 'time': now, 'version': version},
+          for (final r in rows.take(2))
+            {
+              'session': r.session,
+              'time': r.time.toUtc().toIso8601String(),
+              'version': r.version
+            },
+        ]));
+  }
+}
