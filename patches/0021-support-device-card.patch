+class _DeviceCardState extends State<_DeviceCard> {
+  final focus = FocusNode();
+  late final String account = gFFI.userModel.userName.value;
+  late final DeviceNoteStore notes =
+      _EntryNotes(account, widget.row.device.id, widget.row.source.book);
+  late String saved = notes.read();
+  late final editor = TextEditingController(text: saved);
+  static Future<void> _writes = Future.value();
+  String? queued;
+  _DeviceTab tab = _DeviceTab.overview;
+  late Future<List<String>> groups;
+
+  @override
+  void initState() {
+    super.initState();
+    groups = _groups();
+    _PersonalGroups.changes.addListener(_reloadGroups);
+    focus.addListener(_blur);
+  }
+
+  @override
+  void didUpdateWidget(_DeviceCard oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (!focus.hasFocus && queued == null && editor.text == saved) {
+      final current = notes.read();
+      if (current != saved) editor.text = saved = current;
+    }
+  }
+
+  Future<List<String>> _groups() =>
+      _PersonalGroups.forDevice(account, widget.row.device.id);
+  void _reloadGroups() => setState(() => groups = _groups());
+  void _blur() {
+    if (!focus.hasFocus) _save();
+  }
+
+  void _save() {
+    final value = editor.text;
+    if (value == (queued ?? saved) || !notes.editable) return;
+    queued = value;
+    final store = notes;
+    _writes = _writes.then((_) async {
+      try {
+        if (!await store.save(value)) throw StateError('save');
+        saved = value;
+      } catch (_) {
+        showToast(translate('Could not save device note'));
+      } finally {
+        if (queued == value) queued = null;
+      }
+    });
+  }
+
+  @override
+  void dispose() {
+    _save();
+    focus.removeListener(_blur);
+    focus.dispose();
+    editor.dispose();
+    _PersonalGroups.changes.removeListener(_reloadGroups);
+    super.dispose();
+  }
+
+  bool get canRename => widget.row.source.book?.canWrite() ?? true;
