+part of 'support_home.dart';
+
+enum _DeviceTab {
+  overview('Overview', true),
+  peripherals('Peripherals and network',
+      bool.fromEnvironment('STEADDESK_DEVICE_PERIPHERALS')),
+  reports(
+      'Historical reports', bool.fromEnvironment('STEADDESK_DEVICE_REPORTS'));
+
+  final String label;
+  final bool enabled;
+  const _DeviceTab(this.label, this.enabled);
+}
+
+abstract interface class DeviceNoteStore {
+  String read();
+  bool get editable;
+  bool get local;
+  Future<bool> save(String value);
+}
+
+class _EntryNotes implements DeviceNoteStore {
+  final String account, id;
+  final BaseAb? book;
+  _EntryNotes(this.account, this.id, this.book);
+  String get localKey =>
+      'support-device-note/${Uri.encodeComponent(account)}/${Uri.encodeComponent(id)}';
+  @override
+  bool get local => book == null || book!.isLegacy();
+  bool get _valid =>
+      account == gFFI.userModel.userName.value &&
+      (book == null ||
+          identical(book, gFFI.abModel.addressbooks[book!.name()]));
+  @override
+  bool get editable => _valid && (local || book!.canWrite());
+
+  @override
+  String read() => local
+      ? bind.getLocalFlutterOption(k: localKey)
+      : (book!.peers.firstWhereOrNull((p) => p.id == id)?.note ?? '');
+
+  @override
+  Future<bool> save(String value) async {
+    if (!editable) return false;
+    if (local) {
+      await bind.setLocalFlutterOption(k: localKey, v: value);
+      return true;
+    }
+    final ok = await book!.changeNote(id: id, note: value);
+    if (ok && _valid) {
+      final peer = book!.peers.firstWhereOrNull((p) => p.id == id);
+      if (peer != null) peer.note = value;
+      book!.peers.refresh();
+    }
+    return ok;
+  }
+}
+
+class _DeviceCard extends StatefulWidget {
