+
+// Exact directory IDs retain their address-book connection context. A unique
+// alias or partial ID selects the visible row. Unknown numeric IDs can be dialled.
+String? supportSearchTarget(
+    String query, Iterable<String> knownIds, Iterable<String> visibleIds) {
+  final id = query.trim().replaceAll(' ', '');
+  if (id.isEmpty) return null;
+  if (knownIds.contains(id) || RegExp(r'^[0-9]{9,10}$').hasMatch(id)) return id;
+  final candidates = visibleIds.iterator;
+  if (candidates.moveNext()) {
+    final first = candidates.current;
+    return candidates.moveNext() ? null : first;
+  }
+  // Upstream can generate shorter numeric IDs or use a custom ID.
+  return RegExp(r'^[0-9]+$').hasMatch(id) ||
+          RegExp(r'^[a-zA-Z][a-zA-Z0-9_-]{5,15}$').hasMatch(query.trim())
+      ? id
+      : null;
+}
