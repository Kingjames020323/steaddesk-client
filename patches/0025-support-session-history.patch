index 0000000..2981c04
--- /dev/null
+++ b/flutter/lib/steaddesk/cases/case_session_sender.dart
@@ -0,0 +1,55 @@
+import 'case_session_ledger.dart';
+
+/// A remote engine's lifecycle and note messages share one FIFO per transport.
+/// While IPC is in flight, only the newest full text for a case needs sending.
+class CaseSessionSender {
+  final _sending = <String, Future<void>>{};
+  final _notes = <String, CaseData>{};
+  final _writing = <String, Future<bool>>{};
+
+  Future<T> ordered<T>(String connection, Future<T> Function() action) {
+    final previous = _sending[connection] ?? Future<void>.value();
+    final result = previous.then((_) => action());
+    final next = result.then<void>((_) {}, onError: (Object _) {});
+    _sending[connection] = next;
+    next.whenComplete(() {
+      if (identical(_sending[connection], next)) _sending.remove(connection);
+    });
+    return result;
+  }
+
+  Future<bool> note(CaseData edit, Future<bool?> Function(CaseData) send) {
+    final id = edit['case_id'] as String;
+    final connection = edit['connection'] as String;
+    _notes[id] = edit;
+    final sending = _writing[id];
+    if (sending != null) return sending;
+    final result = ordered(connection, () async {
+      try {
+        while (true) {
+          final latest = _notes[id]!;
+          final accepted = await send(latest);
+          if (identical(_notes[id], latest)) {
+            // null means an expired round/account; false is a transport
+            // failure. Keep only the latter for the terminal or shutdown flush.
+            if (accepted != false) _notes.remove(id);
+            return accepted == true;
+          }
+        }
+      } finally {
+        _writing.remove(id);
+      }
+    });
+    _writing[id] = result;
+    return result;
+  }
+
+  List<CaseData> pending(String? connection) => _notes.values
+      .where((e) => connection == null || e['connection'] == connection)
+      .toList();
+
+  void forget(String connection) {
+    _notes.removeWhere((id, edit) =>
+        edit['connection'] == connection && !_writing.containsKey(id));
+  }
+}
