+              TextButton(
+                  style: _linkStyle,
+                  onPressed: note.isEmpty
+                      ? null
+                      : () => Clipboard.setData(ClipboardData(text: note)),
+                  child: const Text('复制处理步骤')),
+              TextButton(
+                  style: _linkStyle,
+                  onPressed:
+                      writing ? null : () => setState(() => writing = true),
+                  child: const Text('追加说明')),
+            ]),
+            if (writing) ...[
+              TextField(
+                  controller: addition,
+                  enabled: !saving,
+                  autofocus: true,
+                  minLines: 2,
+                  maxLines: 5,
+                  decoration: InputDecoration(
