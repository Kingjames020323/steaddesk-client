+                    valueListenable: addition,
+                    builder: (_, value, __) => TextButton(
+                        style: _linkStyle,
+                        onPressed:
+                            saving || value.text.trim().isEmpty ? null : save,
+                        child: const Text('保存追加'))),
+              ]),
+            ]
+          ])),
+    ]);
+  }
+}
