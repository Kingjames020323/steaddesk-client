diff --git a/flutter/lib/steaddesk/cases/case_history.dart b/flutter/lib/steaddesk/cases/case_history.dart
new file mode 100644
index 0000000..badaf4a
--- /dev/null
+++ b/flutter/lib/steaddesk/cases/case_history.dart
@@ -0,0 +1,113 @@
+import 'case_store.dart';
+
+/// The main engine supplies the signed-in account and established session's
+/// device identity. Only the operation, view and append fields come from IPC.
+Future<Map<String, dynamic>> caseHistoryRequest({
+  required CaseStore store,
+  required String account,
+  required String deviceId,
+  String? merchantCode,
+  String? storeCode,
+  required Map<String, dynamic> request,
+  DateTime Function()? clock,
+}) async {
+  if (account.trim().isEmpty || deviceId.trim().isEmpty) {
+    throw StateError('Signed-in session required');
+  }
+  final scope = CaseHistoryScope(deviceId, merchantCode, storeCode);
+  final view = request['scope'];
+  final storeWide = view == 'store';
+  if ((view != null && view != 'device' && !storeWide) ||
+      (storeWide && !scope.canStore)) {
+    throw const FormatException('history scope');
+  }
+  final op = request['op'];
+  if (op == 'append') {
+    final id = request['id'];
+    final text = request['text'];
+    final at = DateTime.tryParse(request['at']?.toString() ?? '');
+    if (view == null ||
+        id is! String ||
+        text is! String ||
+        at == null ||
+        !at.isUtc) {
+      throw const FormatException('history append');
+    }
+    await store.append(account, id, text,
+        scope: scope, storeWide: storeWide, addedAt: at);
+    return {'ok': true};
+  }
+  if (op != 'summary' && op != 'history') {
+    throw const FormatException('history operation');
+  }
+  final includeStore = op == 'history' && scope.canStore && view != 'device';
+  final rows = await store.history(account, scope, includeStore: includeStore);
+  final device = rows.where((row) => scope.contains(row, storeWide: false));
+  final now = (clock ?? DateTime.now)().toUtc();
+  return {
+    'can_store': scope.canStore,
+    'summary': _summary(device, now),
+    if (op == 'history') ...{
+      'device': storeWide ? [] : device.map(_timelineRow).toList(),
+      'store': includeStore
+          ? rows
+              .where((row) => scope.contains(row, storeWide: true))
+              .map(_timelineRow)
+              .toList()
+          : [],
+    }
+  };
+}
+
+Map<String, dynamic> _timelineRow(CaseRecord row) => {
+      for (final key in [
+        'id',
+        'device_id',
+        'display_name',
+        'started_at',
+        'ended_at',
+        'agent',
+        'category',
+        'result',
+        'note',
+        'appends'
+      ])
+        key: row[key],
+    };
+
+Map<String, dynamic> _summary(Iterable<CaseRecord> device, DateTime now) {
+  final cutoff = now.subtract(const Duration(days: 30));
+  final categories = <String, int>{};
+  var total = 0;
+  for (final row in device) {
+    final ended = DateTime.parse(row['ended_at']);
+    if (ended.isBefore(cutoff)) break;
+    if (ended.isAfter(now)) continue;
+    total++;
+    final category = row['category'];
+    if (category is String) {
+      categories.update(category, (n) => n + 1, ifAbsent: () => 1);
+    }
+  }
+  // On equal frequencies the first category encountered (most recent) wins.
+  String? repeated;
+  var count = 0;
+  for (final entry in categories.entries) {
+    if (entry.value >= 3 && entry.value > count) {
+      repeated = entry.key;
+      count = entry.value;
+    }
+  }
+  final latest = device.firstOrNull;
+  return {
+    'latest': latest == null
+        ? null
+        : {
+            for (final key in ['ended_at', 'category', 'result'])
+              key: latest[key]
+          },
+    'count_30d': total,
+    'repeat_category': repeated,
+    'repeat_count': count,
+  };
+}
