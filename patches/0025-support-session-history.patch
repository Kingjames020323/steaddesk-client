+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:flutter_hbb/steaddesk/cases/history_host.dart';
+
+void main() {
+  testWidgets(
+      'live host binds to main, passes the exact case UUID and drops a revoked drawer',
+      (tester) async {
+    const channel = MethodChannel('mixin.one/flutter_multi_window_channel');
+    final messenger =
+        TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
+    String? active = 'case-a';
+    String note = '';
+    final seen = <String>[];
+    messenger.setMockMethodCallHandler(channel, (call) async {
+      final message = jsonDecode(call.arguments['arguments']);
+      expectSync(message['connection'], 'test-connection');
+      seen.add(message['action']);
+      if (active == null) return null;
+      if (message['action'] == 'bind')
+        return jsonEncode({'id': active, 'note': note});
+      expectSync(message['case_id'], active);
+      switch (message['action']) {
+        case 'note':
+          note = message['note'];
+          return true;
+        case 'summary':
+        case 'history':
+          return jsonEncode({
+            'summary': {'latest': null},
+            'device': [],
+            'store': [],
+            'device_note': 'test-device-note'
+          });
+      }
+      return null;
+    });
+    addTearDown(() => messenger.setMockMethodCallHandler(channel, null));
+    bool localInput = false;
+    await tester.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: CaseHistoryHost(
+      connection: 'test-connection',
+      onLocalInput: (v) => localInput = v,
+      builder: (sidebar, drawer) => Row(children: [
+        SizedBox(width: 250, child: sidebar),
+        Expanded(
+            child: Stack(children: [
+          const Text('remote-canvas', key: ValueKey('remote')),
+          if (drawer != null) SizedBox(width: 420, child: drawer),
+        ])),
+      ]),
+    ))));
+    await tester.pumpAndSettle();
+    final canvas = tester.element(find.byKey(const ValueKey('remote')));
+    await tester.enterText(find.byType(TextField), 'note from A');
+    await tester.pump();
+    expect(note, 'note from A');
+    expect(localInput, isTrue);
+    await tester.tap(find.text('历史报告'));
+    await tester.pumpAndSettle();
+    expect(find.text('test-device-note'), findsOneWidget);
+    expect(tester.element(find.byKey(const ValueKey('remote'))), same(canvas));
+    await tester.sendKeyEvent(LogicalKeyboardKey.escape);
+    await tester.pumpAndSettle();
+    expect(find.text('test-device-note'), findsNothing);
+    await tester.tap(find.text('历史报告'));
+    await tester.pumpAndSettle();
+    active = null;
+    await tester.pump(const Duration(seconds: 2));
+    await tester.pumpAndSettle();
+    expect(find.text('test-device-note'), findsNothing);
+    expect(find.byType(TextField), findsNothing);
+    expect(localInput, isFalse);
+    expect(seen, containsAllInOrder(['bind', 'summary', 'note', 'history']));
+    expect(tester.element(find.byKey(const ValueKey('remote'))), same(canvas));
+    await tester.pumpWidget(const SizedBox());
+  });
+}
