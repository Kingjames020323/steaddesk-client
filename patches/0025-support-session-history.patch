diff --git a/flutter/lib/steaddesk/cases/history_host.dart b/flutter/lib/steaddesk/cases/history_host.dart
new file mode 100644
index 0000000..899bb5d
--- /dev/null
+++ b/flutter/lib/steaddesk/cases/history_host.dart
@@ -0,0 +1,224 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:window_manager/window_manager.dart';
+
+import 'case_session.dart';
+import 'history_ui.dart';
+
+/// Keeps per-window view state. The main window owns identity, drafts and disk.
+class CaseHistoryHost extends StatefulWidget {
+  const CaseHistoryHost(
+      {super.key,
+      required this.connection,
+      required this.builder,
+      required this.onLocalInput});
+  final String connection;
+  final Widget Function(Widget? sidebar, Widget? drawer) builder;
+  final ValueChanged<bool> onLocalInput;
+
+  @override
+  State<CaseHistoryHost> createState() => _CaseHistoryHostState();
+}
+
+class _CaseHistoryHostState extends State<CaseHistoryHost> with WindowListener {
+  Map<String, dynamic> data = {};
+  String? id;
+  bool open = false, checking = false, sidebarFocus = false;
+  int request = 0, edit = 0;
+  String? pending;
+  // A write may succeed before its IPC acknowledgement arrives. Reuse its timestamp
+  // for a manual retry of the same operation during this session.
+  final appendRequests = <(String, String, String), String>{};
+  final drawerFocus = FocusScopeNode(debugLabel: 'Case history');
+  late final Timer timer;
+
+  @override
+  void initState() {
+    super.initState();
+    windowManager.addListener(this);
+    timer = Timer.periodic(const Duration(seconds: 2), (_) => _bind());
+    _bind();
+  }
+
+  @override
+  void didUpdateWidget(CaseHistoryHost old) {
+    super.didUpdateWidget(old);
+    if (old.connection != widget.connection) {
+      _reset();
+      _bind();
+    }
+  }
+
+  void _reset() {
+    request++;
+    appendRequests.clear();
+    edit++;
+    pending = id = null;
+    open = sidebarFocus = false;
+    widget.onLocalInput(false);
+    data = {};
+  }
+
+  Future<void> _bind() async {
+    final connection = widget.connection;
+    if (checking || connection.isEmpty) return;
+    checking = true;
+    final generation = edit;
+    try {
+      final info = await CaseSession.historyRequest(connection, 'bind');
+      if (!mounted || connection != widget.connection) return;
+      final next = info?['id'] as String?;
+      if (id != next) {
+        setState(() {
+          _reset();
+          id = next;
+          if (id != null) data = {...info!, 'session': id};
+        });
+      } else if (id != null &&
+          pending == null &&
+          edit == generation &&
+          info?['note'] != data['note']) {
+        setState(() => data = {...data, 'note': info?['note']});
+      }
+      if (next != null && !data.containsKey('summary')) await _load();
+    } finally {
+      checking = false;
+    }
+  }
+
+  void _error(String text) {
+    if (mounted) {
+      ScaffoldMessenger.maybeOf(context)
+          ?.showSnackBar(SnackBar(content: Text(text)));
+    }
+  }
+
+  Future<void> _load() async {
+    final round = id;
+    if (round == null) return;
+    final ticket = ++request;
+    final result = await CaseSession.historyRequest(
+        widget.connection, open ? 'history' : 'summary',
+        caseId: round);
+    if (!mounted || ticket != request || round != id) return;
+    if (result == null) {
+      if (open) {
+        _close();
+        _error('历史报告读取失败，请重试。');
+      }
+      return;
+    }
+    setState(() => data = {...data, ...result});
+  }
+
+  void _close() {
+    setState(() => open = false);
+    request++;
+    widget.onLocalInput(sidebarFocus);
+  }
+
+  void _show() {
+    setState(() => open = true);
+    widget.onLocalInput(true);
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (mounted && open) drawerFocus.requestFocus();
+    });
+    _load();
+  }
+
+  void _note(String text) async {
+    final round = id;
+    if (round == null) return;
+    final revision = ++edit;
+    pending = text;
+    data = {...data, 'note': text};
+    final ok = await CaseSession.updateNote(widget.connection, round, text);
+    if (!mounted || edit != revision || id != round) return;
+    if (ok) {
+      pending = null;
+    } else {
+      _error('随手记尚未同步，请保留文本并重试。');
+    }
+  }
+
+  Future<void> _append(String scope, String record, String text) async {
+    final round = id;
+    if (round == null) throw StateError('Session ended');
+    final key = (scope, record, text);
+    final token = appendRequests.putIfAbsent(
+        key, () => DateTime.now().toUtc().toIso8601String());
+    final result = await CaseSession.historyRequest(widget.connection, 'append',
+        caseId: round,
+        data: {'scope': scope, 'id': record, 'text': text, 'at': token});
+    if (result?['ok'] != true) throw StateError('Append failed');
+    if (id == round) appendRequests.remove(key);
+    if (mounted && id == round && open) await _load();
+  }
+
+  Future<void> _editDevice() async {
+    final round = id;
+    if (round == null) return;
+    final result = await CaseSession.historyRequest(
+        widget.connection, 'editDevice',
+        caseId: round);
+    if (mounted && id == round && result?['ok'] != true) _error('设备卡未打开，请重试。');
+  }
+
+  @override
+  void onWindowFocus() {
+    if (open) _load();
+    _bind();
+  }
+
+  @override
+  void dispose() {
+    timer.cancel();
+    drawerFocus.dispose();
+    windowManager.removeListener(this);
+    widget.onLocalInput(false);
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final body = widget.builder(
+      id == null
+          ? null
+          : Focus(
+              canRequestFocus: false,
+              onFocusChange: (focused) {
+                sidebarFocus = focused;
+                widget.onLocalInput(open || focused);
+              },
+              child: CaseHistorySidebar(
+                  key: ValueKey(id),
+                  data: data,
+                  onOpen: _show,
+                  onNoteChanged: _note)),
+      open
+          ? FocusScope(
+              node: drawerFocus,
+              child: CaseHistoryDrawer(
+                  key: ValueKey(id),
+                  data: data,
+                  onClose: _close,
+                  onEditDevice: _editDevice,
+                  onAppend: _append))
+          : null,
+    );
+    return Focus(
+        canRequestFocus: false,
+        onKeyEvent: (_, event) {
+          if (open &&
+              event is KeyDownEvent &&
+              event.logicalKey == LogicalKeyboardKey.escape) {
+            _close();
+            return KeyEventResult.handled;
+          }
+          return KeyEventResult.ignored;
+        },
+        child: body);
+  }
+}
