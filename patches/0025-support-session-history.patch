+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+import '../theme.dart';
+import 'case_dialog.dart' show caseCategoryLabels, caseResultLabels;
+
+const _caption = TextStyle(fontSize: 12, color: SteadDeskTheme.secondaryText);
+const _label = TextStyle(
+    fontSize: 13, fontWeight: FontWeight.w600, color: SteadDeskTheme.heading);
+const _text = TextStyle(fontSize: 13, color: SteadDeskTheme.body);
+
+String _daysAgo(String ended, DateTime now) {
+  final local = DateTime.parse(ended).toLocal();
+  final today = now.toLocal();
+  // Count local calendar dates, including days with daylight-saving changes.
+  final days = DateTime.utc(today.year, today.month, today.day)
+      .difference(DateTime.utc(local.year, local.month, local.day))
+      .inDays;
+  return days <= 0 ? '今天' : '$days 天前';
+}
+
+String _localTime(String utc) {
+  final t = DateTime.parse(utc).toLocal();
+  String pad(int n) => n.toString().padLeft(2, '0');
+  return '${t.year}-${pad(t.month)}-${pad(t.day)} ${pad(t.hour)}:${pad(t.minute)}';
+}
+
+class CaseHistorySidebar extends StatefulWidget {
+  const CaseHistorySidebar(
+      {super.key,
