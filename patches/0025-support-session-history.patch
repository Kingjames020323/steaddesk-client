+      _row(6, 'printer', 'unresolved'),
+      _row(10, repeat ? 'printer' : 'menu', 'resolved')
+    ]
+  ];
+  return {
+    'session': 'sample-session',
+    'can_store': store,
+    'note': '',
+    'device_note': '测试打印机在前台收银台下方。',
+    'summary': {
+      'latest': device.isEmpty ? null : device.first,
+      'count_30d': device.length,
+      'repeat_category': !empty && repeat ? 'printer' : null,
+      'repeat_count': !empty && repeat ? 3 : 0
+    },
