+
+/// Mount beside the session sidebar, above the existing remote canvas in its Stack.
+class CaseHistoryDrawer extends StatefulWidget {
+  const CaseHistoryDrawer(
+      {super.key,
+      required this.data,
+      required this.onClose,
+      required this.onEditDevice,
+      required this.onAppend,
+      this.clock});
+  final Map<String, dynamic> data;
+  final VoidCallback onClose, onEditDevice;
+  final Future<void> Function(String scope, String id, String text) onAppend;
+  final DateTime Function()? clock;
+
+  @override
+  State<CaseHistoryDrawer> createState() => _CaseHistoryDrawerState();
+}
+
+class _CaseHistoryDrawerState extends State<CaseHistoryDrawer> {
+  bool store = false, unresolved = false;
+  String? category;
+
+  @override
+  Widget build(BuildContext context) {
+    final canStore = widget.data['can_store'] == true;
+    final scope = canStore && store ? 'store' : 'device';
+    final rows = (widget.data[scope] as List? ?? const []).cast<Map>();
+    final visible = rows
+        .where((record) =>
+            (category == null || category == record['category']) &&
+            (!unresolved || record['result'] == 'unresolved'))
+        .toList();
+    final note = widget.data['device_note'] as String? ?? '';
+    final now = (widget.clock?.call() ?? DateTime.now()).toUtc();
+    final from = now.subtract(const Duration(days: 30));
+    final recent = rows.where((row) {
