+  Future<void> save() async {
+    final text = addition.text.trim();
+    if (saving || text.isEmpty) return;
+    setState(() {
+      saving = true;
+      error = null;
+    });
+    try {
+      await widget.onAppend(text);
+      if (!mounted) return;
