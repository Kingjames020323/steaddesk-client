diff --git a/flutter/lib/steaddesk/windows_volumes.dart b/flutter/lib/steaddesk/windows_volumes.dart
new file mode 100644
index 0000000..21be4e4
--- /dev/null
+++ b/flutter/lib/steaddesk/windows_volumes.dart
@@ -0,0 +1,51 @@
+import 'dart:ffi';
+import 'dart:isolate';
+import 'package:ffi/ffi.dart';
+import 'package:win32/win32.dart';
+
+typedef LocalVolume = ({String root, String label, int? freeBytes});
+
+Future<List<LocalVolume>> readWindowsVolumes() => Isolate.run(_enumerate);
+
+Iterable<String> windowsDriveRoots(int mask) sync* {
+  for (int i = 0; i < 26; i++) {
+    if ((mask & (1 << i)) != 0) yield '${String.fromCharCode(65 + i)}:\\';
+  }
+}
+
+bool isEmptyOpticalDrive(int type, int error) =>
+    type == DRIVE_CDROM &&
+    (error == WIN32_ERROR.ERROR_NOT_READY ||
+        error == WIN32_ERROR.ERROR_NO_MEDIA_IN_DRIVE);
+
+List<LocalVolume> _enumerate() => using((arena) {
+      final volumes = <LocalVolume>[];
+      final oldMode = arena<Uint32>();
+      final changed = SetThreadErrorMode(
+              THREAD_ERROR_MODE.SEM_FAILCRITICALERRORS, oldMode) !=
+          0;
+      try {
+        final mask = GetLogicalDrives();
+        final label = arena<Uint16>(261).cast<Utf16>();
+        final available = arena<Uint64>();
+        for (final root in windowsDriveRoots(mask)) {
+          final path = root.toNativeUtf16(allocator: arena);
+          final type = GetDriveType(path);
+          if (type == DRIVE_NO_ROOT_DIR || type == DRIVE_UNKNOWN) continue;
+          final named = GetVolumeInformation(
+                  path, label, 261, nullptr, nullptr, nullptr, nullptr, 0) !=
+              0;
+          if (!named && isEmptyOpticalDrive(type, GetLastError())) continue;
+          final free =
+              GetDiskFreeSpaceEx(path, available, nullptr, nullptr) != 0;
+          volumes.add((
+            root: root,
+            label: named ? label.toDartString() : '',
+            freeBytes: free ? available.value : null
+          ));
+        }
+      } finally {
+        if (changed) SetThreadErrorMode(oldMode.value, nullptr);
+      }
+      return volumes;
+    });
diff --git a/flutter/test/steaddesk/windows_volumes_test.dart b/flutter/test/steaddesk/windows_volumes_test.dart
new file mode 100644
index 0000000..9b77f28
--- /dev/null
+++ b/flutter/test/steaddesk/windows_volumes_test.dart
@@ -0,0 +1,34 @@
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/windows_volumes.dart';
+import 'package:win32/win32.dart';
+
+void main() {
+  test('reports logical drive letters even for noncontiguous drive masks', () {
+    expect(windowsDriveRoots((1 << 2) | (1 << 25)), ['C:\\', 'Z:\\']);
+    expect(windowsDriveRoots(0), isEmpty);
+  });
+  test(
+      'ignores an empty optical drive and preserves storage with unavailable details',
+      () {
+    expect(
+        isEmptyOpticalDrive(DRIVE_CDROM, WIN32_ERROR.ERROR_NOT_READY), isTrue);
+    expect(
+        isEmptyOpticalDrive(DRIVE_CDROM, WIN32_ERROR.ERROR_NO_MEDIA_IN_DRIVE),
+        isTrue);
+    expect(
+        isEmptyOpticalDrive(DRIVE_CDROM, WIN32_ERROR.ERROR_SUCCESS), isFalse);
+    expect(isEmptyOpticalDrive(DRIVE_FIXED, WIN32_ERROR.ERROR_ACCESS_DENIED),
+        isFalse);
+    expect(isEmptyOpticalDrive(DRIVE_REMOVABLE, WIN32_ERROR.ERROR_NOT_READY),
+        isFalse);
+  });
+  test('Windows lists the runner system volume and available bytes', () async {
+    final system = Platform.environment['SystemDrive']!.toUpperCase();
+    final drives = await readWindowsVolumes();
+    expect(drives.map((v) => v.root).toSet().length, drives.length);
+    final drive = drives.singleWhere((v) => v.root.substring(0, 2) == system);
+    expect(await Directory(drive.root).exists(), isTrue);
+    expect(drive.freeBytes, greaterThanOrEqualTo(0));
+  }, skip: !Platform.isWindows);
+}
