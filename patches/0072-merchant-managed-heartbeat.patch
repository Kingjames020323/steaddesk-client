@@ -0,0 +1,62 @@
+package com.carriez.flutter_hbb;
+
+import android.content.Context;
+import android.net.ConnectivityManager;
+import android.net.LinkAddress;
+import android.net.LinkProperties;
+import android.net.Network;
+import android.net.NetworkInfo;
+import android.net.RouteInfo;
+import android.os.Build;
+import java.net.Inet4Address;
+import java.net.InetAddress;
+
+final class ManagedLanAddress {
+    private ManagedLanAddress() {}
+
+    @SuppressWarnings("deprecation")
+    private static Network defaultNetwork(ConnectivityManager manager) {
+        if (Build.VERSION.SDK_INT >= 23) return manager.getActiveNetwork();
+
+        // On API 22 an explicitly process-bound Network is authoritative.
+        Network bound = ConnectivityManager.getProcessDefaultNetwork();
+        if (bound != null) return bound;
+        // The legacy active-info API only identifies a transport. A single
+        // visible, connected network with that transport is unambiguous.
+        NetworkInfo active = manager.getActiveNetworkInfo();
+        Network[] networks = manager.getAllNetworks();
+        if (active == null || !active.isConnected() || networks.length != 1) return null;
+        NetworkInfo only = manager.getNetworkInfo(networks[0]);
+        return only != null && only.isConnected() && only.getType() == active.getType()
+            ? networks[0] : null;
+    }
+
+    static String current(Context context) {
+        try {
+            ConnectivityManager manager =
+                (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
+            if (manager == null) return "";
+            Network active = defaultNetwork(manager);
+            if (active == null) return "";
+            LinkProperties link = manager.getLinkProperties(active);
+            if (link == null || link.getInterfaceName() == null) return "";
+            boolean defaultV4 = false;
+            for (RouteInfo route : link.getRoutes()) {
+                if (route.isDefaultRoute() && route.getDestination().getAddress() instanceof Inet4Address
+                        && link.getInterfaceName().equals(route.getInterface())) {
+                    defaultV4 = true;
+                    break;
+                }
+            }
+            if (!defaultV4) return "";
+            for (LinkAddress entry : link.getLinkAddresses()) {
+                InetAddress addr = entry.getAddress();
+                if (addr instanceof Inet4Address && addr.isSiteLocalAddress()
+                        && active.equals(defaultNetwork(manager))) return addr.getHostAddress();
+            }
+        } catch (RuntimeException unavailable) {
+            // A disappearing default network or missing access yields an empty report.
+        }
+        return "";
+    }
+}
