diff --git a/src/platform/managed_ipv4.cpp b/src/platform/managed_ipv4.cpp
new file mode 100644
index 0000000..f449b7e
--- /dev/null
+++ b/src/platform/managed_ipv4.cpp
@@ -0,0 +1,60 @@
+#ifndef _WIN32_WINNT
+#define _WIN32_WINNT 0x0600
+#endif
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <iphlpapi.h>
+#include <netioapi.h>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+// Rank only live IPv4 default routes. Equal-cost routes on different
+// interfaces have no unique winner. Never fall through to a secondary NIC.
+extern "C" bool sd_managed_ipv4(unsigned char* out) {
+    MIB_IPFORWARD_TABLE2* routes = nullptr;
+    if (GetIpForwardTable2(AF_INET, &routes) != NO_ERROR) return false;
+    auto cost = (std::numeric_limits<std::uint64_t>::max)();
+    NET_IFINDEX best = 0;
+    for (ULONG i = 0; i < routes->NumEntries; ++i) {
+        const auto& row = routes->Table[i];
+        if (row.DestinationPrefix.PrefixLength != 0 || row.ValidLifetime == 0) continue;
+        MIB_IPINTERFACE_ROW iface{};
+        InitializeIpInterfaceEntry(&iface);
+        iface.Family = AF_INET;
+        iface.InterfaceLuid = row.InterfaceLuid;
+        if (GetIpInterfaceEntry(&iface) != NO_ERROR) {
+            // Its cost is unknown. We cannot prove another interface won.
+            best = 0;
+            break;
+        }
+        if (!iface.Connected || iface.DisableDefaultRoutes) continue;
+        const auto candidate = static_cast<std::uint64_t>(row.Metric) + iface.Metric;
+        if (candidate < cost) {
+            cost = candidate;
+            best = row.InterfaceIndex;
+        } else if (candidate == cost && row.InterfaceIndex != best) {
+            best = 0;
+        }
+    }
+    FreeMibTable(routes);
+    if (best == 0) return false;
+
+    MIB_UNICASTIPADDRESS_TABLE* ips = nullptr;
+    if (GetUnicastIpAddressTable(AF_INET, &ips) != NO_ERROR) return false;
+    bool found = false;
+    for (ULONG i = 0; i < ips->NumEntries; ++i) {
+        const auto& row = ips->Table[i];
+        if (row.InterfaceIndex != best || row.SkipAsSource || row.DadState != IpDadStatePreferred)
+            continue;
+        const auto* b = reinterpret_cast<const unsigned char*>(&row.Address.Ipv4.sin_addr);
+        if (b[0] == 10 || (b[0] == 172 && b[1] >= 16 && b[1] <= 31)
+                || (b[0] == 192 && b[1] == 168)) {
+            std::memcpy(out, b, 4);
+            found = true;
+            break;
+        }
+    }
+    FreeMibTable(ips);
+    return found;
+}
