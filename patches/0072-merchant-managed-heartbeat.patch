@@ -0,0 +1,195 @@
+//! Private address observation for the registered merchant identity.
+use hbb_common::config::Config;
+use reqwest::{blocking::Client, redirect::Policy, Url};
+use serde_json::{json, Value};
+use std::{
+    collections::BTreeMap,
+    io::Read,
+    net::Ipv4Addr,
+    sync::mpsc::{sync_channel, SyncSender},
+    time::{Duration, Instant},
+};
+
+const IDENTITY: &str = "/ops/v1/device/update-identity";
+const REPORT: &str = "/ops/v1/device/managed-heartbeat";
+
+#[cfg(windows)]
+fn local_observation() -> (Option<Ipv4Addr>, Option<String>) {
+    use winreg::{enums::HKEY_LOCAL_MACHINE, RegKey};
+    extern "C" {
+        fn sd_managed_ipv4(out: *mut u8) -> bool;
+    }
+    let mut addr = [0u8; 4];
+    let ip = unsafe { sd_managed_ipv4(addr.as_mut_ptr()) }.then(|| Ipv4Addr::from(addr));
+    let model = RegKey::predef(HKEY_LOCAL_MACHINE)
+        .open_subkey(r"HARDWARE\DESCRIPTION\System\BIOS")
+        .and_then(|bios| bios.get_value("SystemProductName"))
+        .ok();
+    (ip, model)
+}
+
+#[cfg(target_os = "android")]
+fn local_observation() -> (Option<Ipv4Addr>, Option<String>) {
+    use scrap::android::call_main_service_get_by_name as get;
+    let ip = get("steaddesk_managed_ipv4")
+        .ok()
+        .and_then(|s| s.parse().ok());
+    (ip, get("steaddesk_managed_model").ok())
+}
+
+fn report_body(ip: Option<Ipv4Addr>, model: Option<String>) -> Value {
+    let Some(ip) = ip.filter(Ipv4Addr::is_private) else {
+        return json!({});
+    };
+    let mut body = json!({"lan_ipv4": ip.to_string()});
+    if let Some(model) = model.as_deref().map(str::trim).filter(|m| {
+        !m.is_empty()
+            && m.chars().count() <= 64
+            && m.chars()
+                .all(|c| c.is_alphanumeric() || c == ' ' || c.is_ascii_punctuation())
+    }) {
+        body["model"] = json!(model);
+    }
+    body
+}
+
+fn configured_origin() -> Option<Url> {
+    let url = Url::parse(&Config::get_option("api-server")).ok()?;
+    (url.scheme() == "https"
+        && url.host().is_some()
+        && url.username().is_empty()
+        && url.password().is_none()
+        && url.path() == "/"
+        && url.query().is_none()
+        && url.fragment().is_none())
+    .then_some(url)
+}
+
+fn signed_request(
+    client: &Client,
+    origin: &Url,
+    device: &str,
+    version: u64,
+    body: &Value,
+) -> Option<reqwest::blocking::Response> {
+    let (method, path) = if version == 0 {
+        ("GET", IDENTITY)
+    } else {
+        ("POST", REPORT)
+    };
+    let signed = crate::steaddesk_device_signature::sign(device, version, |id, stamp, nonce| {
+        let mut proof = b"SteadDesk-fleet-v1\0".to_vec();
+        proof.extend(serde_json::to_vec(&(method, path, body, id, version, stamp, nonce)).ok()?);
+        Some(proof)
+    })?;
+    let url = origin.join(path).ok()?;
+    let mut request = if version == 0 {
+        client.get(url)
+    } else {
+        client.post(url).json(body)
+    };
+    for (key, value) in serde_json::from_slice::<BTreeMap<String, String>>(&signed).ok()? {
+        request = request.header(key, value);
+    }
+    let response = request.send().ok()?;
+    (response.status().as_u16() == 200).then_some(response)
+}
+
+fn discover(client: &Client, origin: &Url, device: &str) -> Option<u64> {
+    let response = signed_request(client, origin, device, 0, &json!({}))?;
+    let mut data = Vec::new();
+    response.take(8193).read_to_end(&mut data).ok()?;
+    if data.len() > 8192 {
+        return None;
+    }
+    let value: Value = serde_json::from_slice(&data).ok()?;
+    value["key_version"].as_u64().filter(|v| *v > 0)
+}
+
+pub(super) fn start() -> SyncSender<()> {
+    // Zero capacity: a slow or absent ops service never queues observations
+    // or holds up the legacy RustDesk heartbeat. Only live ticks trigger work.
+    let (sender, ticks) = sync_channel(0);
+    let _ = std::thread::Builder::new()
+        .name("managed-heartbeat".into())
+        .spawn(move || {
+            let Ok(client) = Client::builder()
+                .redirect(Policy::none())
+                .no_proxy()
+                .connect_timeout(Duration::from_secs(3))
+                .timeout(Duration::from_secs(7))
+                .build()
+            else {
+                return;
+            };
+            let mut cached: Option<(Url, String, u64)> = None;
+            let mut next = Instant::now();
+            while ticks.recv().is_ok() {
+                if Instant::now() < next {
+                    continue;
+                }
+                let Some(origin) = configured_origin() else {
+                    continue;
+                };
+                let device = Config::get_id_or(String::new());
+                let version = cached
+                    .as_ref()
+                    .filter(|(url, id, _)| url == &origin && id == &device)
+                    .map(|(_, _, v)| *v)
+                    .or_else(|| discover(&client, &origin, &device));
+                let accepted = version.and_then(|v| {
+                    let (ip, model) = local_observation();
+                    signed_request(&client, &origin, &device, v, &report_body(ip, model))?;
+                    Some((origin, device, v))
+                });
+                // Retry old servers, rotated keys and transport failures at most once per 5 minutes.
+                let delay = if accepted.is_some() {
+                    super::TIME_HEARTBEAT
+                } else {
+                    Duration::from_secs(300)
+                };
+                next = Instant::now() + delay;
+                cached = accepted;
+            }
+        });
+    sender
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn report_contains_only_a_private_ipv4_and_an_optional_bounded_model() {
+        for ip in ["10.0.0.1", "172.16.0.1", "172.31.255.254", "192.168.1.1"] {
+            assert_eq!(
+                report_body(ip.parse().ok(), Some(" KDS 2 ".into())),
+                json!({"lan_ipv4":ip,"model":"KDS 2"})
+            );
+        }
+        for ip in [
+            "",
+            "::1",
+            "0.0.0.0",
+            "127.0.0.1",
+            "169.254.1.1",
+            "100.64.0.2",
+            "172.15.2.1",
+            "172.32.2.1",
+            "192.0.2.8",
+            "224.1.1.1",
+            "8.8.8.8",
+        ] {
+            assert_eq!(
+                report_body(ip.parse().ok(), Some("Tablet".into())),
+                json!({})
+            );
+        }
+        for model in ["".into(), "a".repeat(65), "a\nb".into()] {
+            assert_eq!(
+                report_body("10.0.1.2".parse().ok(), Some(model)),
+                json!({"lan_ipv4":"10.0.1.2"})
+            );
+        }
+    }
+}
