+class _TransferPane extends StatefulWidget {
+  const _TransferPane(
+      {required this.controller,
+      required this.ffi,
+      required this.select,
+      required this.createFolder,
+      required this.menu});
+  final FileController controller;
+  final FFI ffi;
+  final void Function(List<Entry>, Entry) select;
+  final VoidCallback createFolder;
+  final Widget menu;
+  @override
+  State<_TransferPane> createState() => _TransferPaneState();
+}
+
+class _TransferPaneState extends State<_TransferPane> {
+  FileController get c => widget.controller;
+  final path = TextEditingController();
+  final pathFocus = FocusNode();
+  final listFocus = FocusNode();
+  final scroll = ScrollController();
+  final tableScroll = ScrollController();
+  final buffer = TimeoutStringBuffer();
+  late final Worker directoryListener;
+  String filter = '';
+  bool searching = false;
+  bool ascending = true;
+  SortBy sort = SortBy.name;
+  String get colsKey =>
+      'file-transfer-columns-${c.isLocal ? "local" : "remote"}';
+  late List<double> shares;
+  static const columns = [
+    SortBy.name,
+    SortBy.size,
+    SortBy.type,
+    SortBy.modified
+  ];
+
+  @override
+  void initState() {
+    super.initState();
+    final parsed = bind
+        .mainGetLocalOption(key: colsKey)
+        .split(',')
+        .map(double.tryParse)
+        .toList();
+    shares = parsed.length == 4 &&
+            parsed.every((n) => n != null && n.isFinite && n >= 0) &&
+            (parsed.fold<double>(0, (sum, n) => sum + n!) - 1).abs() < .001
+        ? parsed.cast<double>()
+        : [.37, .16, .16, .31];
+    path.text = c.directory.value.path;
+    directoryListener = ever<FileDirectory>(c.directory, (dir) {
+      if (!pathFocus.hasFocus) path.text = dir.path;
+    });
+    pathFocus.addListener(_syncPath);
+  }
+
+  void _syncPath() {
+    if (!pathFocus.hasFocus) path.text = c.directory.value.path;
+  }
+
+  @override
+  void dispose() {
+    directoryListener.dispose();
+    pathFocus.removeListener(_syncPath);
+    pathFocus.dispose();
+    path.dispose();
+    listFocus.dispose();
+    scroll.dispose();
+    tableScroll.dispose();
+    super.dispose();
+  }
+
+  Future<void> _open(String target) async {
+    final ok = await c.openDirectory(target);
+    if (!mounted) return;
+    if (!ok) {
+      ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text('${translate("Failed")}: $target')));
+    }
+    path.text = c.directory.value.path;
+  }
+
+  bool _transfer(FileController source, List<Entry> entries) {
+    final selection = SelectedItems(isLocal: source.isLocal);
+    for (final e in entries) {
+      selection.add(e);
+    }
+    if (!SelectedItems.valid(selection.items)) return false;
+    final destination = source.getOtherSideDirectoryData();
+    if (destination.directory.path.isEmpty) return false;
+    source.sendFiles(selection, destination);
+    return true;
+  }
+
+  String get transferLabel {
+    final label = translate(c.isLocal ? 'Send' : 'Receive');
+    return !c.isLocal && label == '接受' ? '接收' : label;
+  }
+
+  void _transferSelection() {
+    if (_transfer(c, c.selectedItems.items.toList())) c.selectedItems.clear();
+  }
+
+  Future<void> _dropExternal(DropDoneDetails drop) async {
+    if (c.isLocal) return;
+    final entries = <Entry>[];
+    try {
+      for (final f in drop.files) {
+        final stat = await FileStat.stat(f.path);
+        if (stat.type != FileSystemEntityType.directory &&
+            stat.type != FileSystemEntityType.file) continue;
+        entries.add(Entry()
+          ..path = f.path
+          ..name = f.name
+          ..entryType = stat.type == FileSystemEntityType.directory ? 1 : 4
+          ..size = stat.size);
+      }
+      if (mounted) _transfer(widget.ffi.fileModel.localController, entries);
+    } on FileSystemException catch (e) {
+      if (mounted)
+        ScaffoldMessenger.of(context)
+            .showSnackBar(SnackBar(content: Text(e.message)));
+    }
+  }
+
+  String _extension(Entry e) {
+    final dot = e.name.lastIndexOf('.');
+    return dot > 0 && dot + 1 < e.name.length
+        ? e.name.substring(dot + 1).toUpperCase()
+        : '';
+  }
+
+  String _kind(Entry e) {
+    if (e.isDrive) return translate('This PC');
+    if (!e.isFile) return translate('Directory');
+    final ext = _extension(e);
+    return ext.isEmpty ? _ftLabel('File', '文件') : ext;
+  }
+
+  (List<Entry>, String, SortBy, bool)? _viewKey;
+  List<Entry> _viewRows = const [];
+
+  List<Entry> _visible() {
+    final entries = c.directory.value.entries;
+    final needle = filter.toLowerCase();
+    // The controller replaces the entry list on directory reads and refresh.
+    final key = (entries, needle, sort, ascending);
+    if (key == _viewKey) return _viewRows;
+    final rows =
+        entries.where((e) => e.name.toLowerCase().contains(needle)).toList();
+    rows.sort((a, b) {
+      if (a.isFile != b.isFile) return a.isFile ? 1 : -1;
+      int result;
+      switch (sort) {
+        case SortBy.name:
+          result = 0;
+          break;
+        case SortBy.size:
+          result = a.size.compareTo(b.size);
+          break;
+        case SortBy.type:
+          result = a.isFile
+              ? _extension(a).compareTo(_extension(b))
+              : a.entryType.compareTo(b.entryType);
+          break;
+        case SortBy.modified:
+          result = a.modifiedTime.compareTo(b.modifiedTime);
+          break;
+      }
+      if (result == 0)
+        result = a.name.toLowerCase().compareTo(b.name.toLowerCase());
+      return ascending ? result : -result;
+    });
+    _viewKey = key;
+    return _viewRows = rows;
+  }
+
+  Future<void> _windowsPlace(String name) async {
+    // SHGetKnownFolderPath honors redirected folders on the operator's PC.
+    const ids = {
+      'Desktop': '{B4BFCC3A-DB2C-424C-B029-7FE99A87C641}',
+      'Downloads': '{374DE290-123F-4565-9164-39C4925E467B}',
+      'Documents': '{FDD39AD0-238F-46AF-ADB4-6C85480369C7}',
+    };
+    final known = c.isLocal && isWindows
+        ? await PathProviderWindows().getPath(ids[name]!)
+        : null;
+    if (mounted) await _open(known ?? PathUtil.join(c.homePath, name, true));
+  }
+
+  Widget _places() => Obx(() {
+        final dir = c.directory.value;
+        final home = c.homePath;
+        final windows = c.options.value.isWindows;
+        final android = !c.isLocal && widget.ffi.ffiModel.isPeerAndroid;
+        final places = <(IconData, String, VoidCallback?)>[];
+        if (windows) {
+          for (final (name, label, icon) in [
+            ('Desktop', '桌面', Icons.desktop_windows_outlined),
+            ('Downloads', '下载', Icons.download_outlined),
+            ('Documents', '文档', Icons.description_outlined),
+          ]) {
+            places.add((
+              icon,
+              _ftLabel(name, label),
+              home.isEmpty ? null : () => _windowsPlace(name)
+            ));
+          }
+        } else if (android) {
+          final scoped = home.contains('/Android/data/');
+          final root = scoped
+              ? home.split('/Android/data/').first
+              : (RegExp(r'^/storage/(?:emulated/\d+|[0-9a-fA-F]{4}-[0-9a-fA-F]{4})(?:/|$)')
+                      .firstMatch(home)
+                      ?.group(0)
+                      ?.replaceFirst(RegExp(r'/$'), '') ??
+                  '/sdcard');
+          for (final (name, label, path, icon) in [
+            ('Internal storage', '内部存储', root, Icons.storage),
+            ('Downloads', '下载', '$root/Download', Icons.download_outlined),
+            ('Pictures', '图片', '$root/Pictures', Icons.image_outlined),
+          ]) {
+            places.add((
+              icon,
+              _ftLabel(name, label),
+              dir.path.isEmpty ? null : () => _open(path)
+            ));
+          }
+          if (scoped)
+            places.add((
+              Icons.folder_outlined,
+              _ftLabel('App files', '应用文件'),
+              () => _open(home)
+            ));
+        }
+        if (places.isEmpty)
+          places.add(
+              (Icons.home_outlined, translate('Home'), c.goToHomeDirectory));
+        return ListView(children: [
+          for (final (icon, label, action) in places)
+            Tooltip(
+                message: label,
+                child: TextButton(
+                  onPressed: action,
+                  style: TextButton.styleFrom(
+                      alignment: Alignment.centerLeft,
+                      foregroundColor: _ftBlue,
+                      padding: const EdgeInsets.symmetric(horizontal: 5)),
+                  child: Row(children: [
+                    Icon(icon, size: 15),
+                    const SizedBox(width: 4),
+                    Expanded(
+                        child: Text(label,
+                            overflow: TextOverflow.ellipsis,
+                            maxLines: 1,
+                            style: const TextStyle(fontSize: 12)))
+                  ]),
+                )),
+        ]);
+      });
+
+  void _find(List<Entry> rows, String query, {bool next = false}) {
+    if (rows.isEmpty) return;
+    final selected = c.selectedItems.items;
+    final start =
+        next && selected.isNotEmpty ? rows.indexOf(selected.first) + 1 : 0;
+    for (int n = 0; n < rows.length; n++) {
+      final index = (start + n) % rows.length;
+      if (rows[index].name.toLowerCase().startsWith(query.toLowerCase())) {
+        c.selectedItems
+          ..clear()
+          ..add(rows[index]);
+        if (scroll.hasClients)
+          scroll.jumpTo((index * _ftRowHeight)
+              .clamp(0.0, scroll.position.maxScrollExtent)
+              .toDouble());
+        return;
+      }
+    }
+  }
+
+  List<Entry> _dragEntries(Entry e) => c.selectedItems.items.contains(e)
+      ? c.selectedItems.items.where((item) => !item.isDrive).toList()
+      : [e];
+
+  Future<void> _contextMenu(Entry e, Offset point) async {
+    final overlay = Overlay.of(context).context.findRenderObject() as RenderBox;
+    final pos = overlay.globalToLocal(point);
+    final entries = _dragEntries(e);
+    final allowRename =
+        !e.isDrive && versionCmp(widget.ffi.ffiModel.pi.version, '1.3.0') >= 0;
+    final action = await showMenu<String>(
+        context: context,
+        position:
+            RelativeRect.fromRect(pos & Size.zero, Offset.zero & overlay.size),
+        items: [
+          if (!e.isFile)
+            PopupMenuItem(value: 'open', child: Text(translate('Open'))),
+          if (!e.isDrive)
+            PopupMenuItem(value: 'transfer', child: Text(transferLabel)),
+          if (allowRename)
+            PopupMenuItem(value: 'rename', child: Text(translate('Rename'))),
+          if (!e.isDrive)
+            PopupMenuItem(value: 'delete', child: Text(translate('Delete'))),
+        ]);
+    if (!mounted) return;
+    switch (action) {
+      case 'open':
+        await _open(e.path);
+        break;
+      case 'rename':
+        await c.renameAction(e, c.isLocal);
+        break;
+      case 'transfer':
+        _transfer(c, entries);
+        break;
+      case 'delete':
+        final items = SelectedItems(isLocal: c.isLocal);
+        for (final entry in entries) {
+          items.add(entry);
+        }
+        await c.removeAction(items);
+        break;
+    }
+  }
+
+  Widget _fileRow(Entry e, List<Entry> rows, List<double> widths) {
+    final cells = [
+      e.name,
+      e.isFile ? readableFileSize(e.size.toDouble()) : '',
+      _kind(e),
+      e.isDrive ? '' : e.lastModified().toString().split('.').first
+    ];
+    return Obx(() {
+      final selected = c.selectedItems.items.contains(e);
+      final row = Material(
+        color: selected ? _ftSelection : Colors.white,
+        child: InkWell(
+          hoverColor: _ftHover,
+          onTap: () {
+            listFocus.requestFocus();
+            widget.select(rows, e);
+          },
+          onDoubleTap: e.isFile ? null : () => _open(e.path),
+          onSecondaryTapDown: (event) => _contextMenu(e, event.globalPosition),
+          child: Container(
+              decoration: const BoxDecoration(
+                  border: Border(bottom: BorderSide(color: _ftRowLine))),
+              child: Row(
+                children: [
+                  for (int i = 0; i < cells.length; i++)
+                    SizedBox(
+                        width: widths[i],
+                        child: Padding(
+                          padding: const EdgeInsets.symmetric(horizontal: 4),
+                          child: Row(children: [
+                            if (i == 0) ...[
+                              Icon(
+                                  e.isDrive
+                                      ? Icons.storage
+                                      : e.isFile
+                                          ? Icons.insert_drive_file_outlined
+                                          : Icons.folder_outlined,
+                                  size: 15,
+                                  color: _ftBlue),
+                              const SizedBox(width: 4)
+                            ],
+                            Expanded(
+                                child: Tooltip(
+                                    message: cells[i],
+                                    child: Text(cells[i],
+                                        maxLines: 1,
+                                        overflow: TextOverflow.ellipsis,
+                                        style: const TextStyle(
+                                            fontSize: 13, color: _ftInk)))),
+                          ]),
+                        )),
+                ],
+              )),
+        ),
+      );
+      if (e.isDrive) return row;
+      return Draggable<_TransferDrag>(
+        data: _TransferDrag(c, _dragEntries(e)),
+        feedback: Material(
+            elevation: 2,
+            child:
+                Padding(padding: const EdgeInsets.all(6), child: Text(e.name))),
+        child: row,
+      );
+    });
+  }
+
+  Widget _table() => LayoutBuilder(builder: (context, box) {
+        // Keep even a narrow pane navigable; both header and body share one scroll offset.
+        final width = max(350.0, box.maxWidth);
+        const minWidth = 52.0;
+        final extra = width - 4 * minWidth;
+        final widths = [for (final share in shares) minWidth + extra * share];
+        return Scrollbar(
+          controller: tableScroll,
+          scrollbarOrientation: ScrollbarOrientation.bottom,
+          notificationPredicate: (n) => n.metrics.axis == Axis.horizontal,
+          child: SingleChildScrollView(
+            controller: tableScroll,
+            scrollDirection: Axis.horizontal,
+            child: SizedBox(
+                width: width,
+                height: box.maxHeight,
+                child: Obx(() {
+                  final rows = _visible();
+                  return ListSearchActionListener(
+                    node: listFocus,
+                    buffer: buffer,
+                    onNext: (s) => _find(rows, s, next: true),
+                    onSearch: (s) => _find(rows, s),
+                    child: Column(children: [
+                      SizedBox(
+                          height: 28,
+                          child: Row(children: [
+                            for (int i = 0; i < columns.length; i++)
+                              SizedBox(
+                                  width: widths[i],
+                                  child: Row(children: [
+                                    Expanded(
+                                        child: InkWell(
+                                            onTap: () => setState(() {
+                                                  ascending = sort == columns[i]
+                                                      ? !ascending
+                                                      : true;
+                                                  sort = columns[i];
+                                                }),
+                                            child: Row(children: [
+                                              const SizedBox(width: 4),
+                                              Flexible(
+                                                  child: Text(
+                                                      translate(columns[i]
+                                                          .toString()),
+                                                      maxLines: 1,
+                                                      overflow:
+                                                          TextOverflow.ellipsis,
+                                                      style: const TextStyle(
+                                                          fontSize: 13,
+                                                          color: _ftMuted))),
+                                              if (sort == columns[i])
+                                                Icon(
+                                                    ascending
+                                                        ? Icons.arrow_drop_up
+                                                        : Icons.arrow_drop_down,
+                                                    size: 13,
+                                                    color: _ftBlue),
+                                            ]))),
+                                    if (i < 3)
+                                      _splitter(
+                                          Axis.vertical,
+                                          (dx) => setState(() {
+                                                final delta = (dx / extra)
+                                                    .clamp(-shares[i],
+                                                        shares[i + 1])
+                                                    .toDouble();
+                                                shares[i] += delta;
+                                                shares[i + 1] -= delta;
+                                              }),
+                                          () => bind.mainSetLocalOption(
+                                              key: colsKey,
+                                              value: shares.join(','))),
+                                  ])),
+                          ])),
+                      const Divider(height: 1, color: _ftLine),
+                      Expanded(
+                          child: ListView.builder(
+                              controller: scroll,
+                              itemExtent: _ftRowHeight,
+                              itemCount: rows.length,
+                              itemBuilder: (_, i) =>
+                                  _fileRow(rows[i], rows, widths))),
+                    ]),
+                  );
+                })),
+          ),
+        );
+      });
+
+  @override
