+part of '../desktop/pages/file_manager_page.dart';
+
+// TODO(U-01): reference the shared SteadDesk theme after its PR lands.
+const _ftBlue = Color(0xFF0A6FA8);
+const _ftSelection = Color(0xFFDFF2FA);
+const _ftInk = Color(0xFF17324A);
+const _ftMuted = Color(0xFF4B5563);
+const _ftLine = Color(0xFFE5E7EB);
+const _ftRowLine = Color(0xFFEEF0F2);
+const _ftHover = Color(0xFFF3F4F6);
+const _ftRowHeight = 27.0;
+
+// Prefer the upstream translation. These page-only labels are absent from its
+// catalog; follow the same saved language / platform locale when falling back.
+String _ftLabel(String english, String chinese) {
+  final translated = translate(english);
+  if (translated != english) return translated;
+  final saved = bind.mainGetLocalOption(key: 'lang');
+  final lang = (saved.isEmpty ? localeName.toString() : saved).toLowerCase();
+  return lang.startsWith('zh') ? chinese : english;
+}
+
+double _fraction(String key, double fallback) {
+  final value = double.tryParse(bind.mainGetLocalOption(key: key));
+  return value != null && value.isFinite && value > 0 && value < 1
+      ? value
+      : fallback;
+}
+
+Widget _splitter(Axis axis, ValueChanged<double> move, VoidCallback save) {
+  final vertical = axis == Axis.vertical;
+  return MouseRegion(
+    cursor: vertical
+        ? SystemMouseCursors.resizeLeftRight
+        : SystemMouseCursors.resizeUpDown,
+    child: GestureDetector(
+      behavior: HitTestBehavior.opaque,
+      onHorizontalDragUpdate: vertical ? (e) => move(e.delta.dx) : null,
+      onHorizontalDragEnd: vertical ? (_) => save() : null,
+      onVerticalDragUpdate: vertical ? null : (e) => move(e.delta.dy),
+      onVerticalDragEnd: vertical ? null : (_) => save(),
+      child: SizedBox(
+        width: vertical ? 7 : null,
+        height: vertical ? null : 7,
+        child: Center(
+            child: Container(
+                width: vertical ? 1 : null,
+                height: vertical ? null : 1,
+                color: _ftLine)),
+      ),
+    ),
+  );
+}
+
+class _TransferWorkspace extends StatefulWidget {
+  const _TransferWorkspace(
+      {required this.local, required this.remote, required this.jobs});
+  final Widget local, remote;
+  final JobController jobs;
+  @override
+  State<_TransferWorkspace> createState() => _TransferWorkspaceState();
+}
+
+class _TransferWorkspaceState extends State<_TransferWorkspace> {
+  static const splitKey = 'file-transfer-pane-share';
+  static const queueKey = 'file-transfer-queue-share';
+  static const collapsedKey = 'file-transfer-queue-collapsed';
+  late double split = _fraction(splitKey, .5);
+  late double queue = _fraction(queueKey, .14);
+  late final String initialPreference =
+      bind.mainGetLocalOption(key: collapsedKey);
+  late bool collapsed = initialPreference == 'Y' ||
+      (initialPreference.isEmpty && widget.jobs.jobTable.isEmpty);
+  late bool automatic = initialPreference.isEmpty;
+  late final Worker queueListener;
+
+  @override
+  void initState() {
+    super.initState();
+    queueListener = ever(widget.jobs.jobTable, (_) {
+      if (automatic && collapsed && widget.jobs.jobTable.isNotEmpty) {
+        setState(() => collapsed = false);
+      }
+    });
+  }
+
+  @override
+  void dispose() {
+    queueListener.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => Material(
+        color: Colors.white,
+        child: LayoutBuilder(builder: (context, box) {
+          final width = max(1.0, box.maxWidth - 7);
+          final minShare = min(.5, 250 / width);
+          final share = split.clamp(minShare, 1 - minShare).toDouble();
+          const bar = 32.0;
+          final available = max(0.0, box.maxHeight - bar - 7);
+          final maxQueue = max(0.0, available - 122);
+          final queueHeight = collapsed
+              ? 0.0
+              : (box.maxHeight * queue)
+                  .clamp(min(36.0, maxQueue), maxQueue)
+                  .toDouble();
+          final jobs = widget.jobs;
+          return Column(children: [
+            Expanded(
+                child: Row(
+                    crossAxisAlignment: CrossAxisAlignment.stretch,
+                    children: [
+                  SizedBox(width: width * share, child: widget.local),
+                  _splitter(
+                      Axis.vertical,
+                      (dx) => setState(() {
+                            split = (share + dx / width)
+                                .clamp(minShare, 1 - minShare)
+                                .toDouble();
+                          }),
+                      () => bind.mainSetLocalOption(
+                          key: splitKey, value: split.toString())),
+                  Expanded(child: widget.remote),
+                ])),
+            _splitter(
+                Axis.horizontal,
+                (dy) => setState(() {
+                      if (maxQueue < 1 || box.maxHeight < 1) return;
+                      automatic = false;
+                      final start = collapsed && dy < 0
+                          ? min(36.0, maxQueue)
+                          : queueHeight;
+                      final h = (start - dy).clamp(0.0, maxQueue);
+                      collapsed = h < 10;
+                      if (!collapsed) queue = h / box.maxHeight;
+                    }), () {
+              bind.mainSetLocalOption(key: queueKey, value: queue.toString());
+              bind.mainSetLocalOption(
+                  key: collapsedKey, value: collapsed ? 'Y' : 'N');
+            }),
+            SizedBox(
+                height: bar,
+                child: Row(children: [
+                  Obx(() => TextButton.icon(
+                        onPressed: () {
+                          automatic = false;
+                          setState(() => collapsed = !collapsed);
+                          bind.mainSetLocalOption(
+                              key: collapsedKey, value: collapsed ? 'Y' : 'N');
+                        },
+                        icon: Icon(
+                            collapsed ? Icons.expand_less : Icons.expand_more,
+                            size: 17),
+                        label: Text(
+                            '${_ftLabel("Transfer queue", "传输队列")}  ${jobs.jobTable.length}'),
+                        style: TextButton.styleFrom(foregroundColor: _ftBlue),
+                      )),
+                  const Spacer(),
+                  Obx(() => TextButton(
+                        onPressed: jobs.jobTable
+                                .any((j) => j.state == JobState.done)
+                            ? () => jobs.jobTable
+                                .removeWhere((j) => j.state == JobState.done)
+                            : null,
+                        child: Text(_ftLabel('Clear completed', '清除已完成')),
+                      )),
+                ])),
+            if (queueHeight > 0)
+              SizedBox(
+                  height: queueHeight,
+                  child: Obx(() {
+                    final list = jobs.jobTable.toList();
+                    if (list.isEmpty)
+                      return Center(
+                          child: Text(translate('No transfers in progress')));
+                    return ListView.builder(
+                        itemExtent: 32,
+                        itemCount: list.length,
+                        itemBuilder: (context, i) {
+                          final j = list[i];
+                          return Row(children: [
+                            Icon(
+                                j.type != JobType.transfer
+                                    ? Icons.delete_outline
+                                    : j.isRemoteToLocal
+                                        ? Icons.arrow_back
+                                        : Icons.arrow_forward,
+                                size: 16,
+                                color: _ftBlue),
+                            const SizedBox(width: 8),
+                            Expanded(
+                                child: Tooltip(
+                                    message: j.jobName,
+                                    child: Text(j.jobName,
+                                        maxLines: 1,
+                                        overflow: TextOverflow.ellipsis))),
+                            Expanded(
+                                child: Tooltip(
+                                    message: j.getStatus(),
+                                    child: Text(j.getStatus(),
+                                        maxLines: 1,
+                                        overflow: TextOverflow.ellipsis))),
+                            if (j.type == JobType.transfer &&
+                                j.state == JobState.inProgress)
+                              SizedBox(
+                                  width: 96,
+                                  child: Column(
+                                      mainAxisAlignment:
+                                          MainAxisAlignment.center,
+                                      children: [
+                                        Text(
+                                            j.recvJobRes
+                                                ? '${j.percentText} · ${readableFileSize(j.speed)}/s'
+                                                : j.percentText,
+                                            maxLines: 1,
+                                            overflow: TextOverflow.ellipsis,
+                                            style:
+                                                const TextStyle(fontSize: 11)),
+                                        LinearProgressIndicator(
+                                            value: j.percent
+                                                .clamp(0.0, 1.0)
+                                                .toDouble(),
+                                            color: const Color(0xFF1FA7E0),
+                                            backgroundColor: _ftSelection),
+                                      ])),
+                            if (j.state == JobState.paused)
+                              _tool(Icons.play_arrow, translate('Resume'),
+                                  () => jobs.resumeJob(j.id)),
+                            _tool(Icons.close, translate('Delete'), () {
+                              jobs.jobTable.remove(j);
+                              jobs.cancelJob(j.id);
+                            }),
+                          ]);
+                        });
+                  })),
+          ]);
+        }),
+      );
+}
+
+Widget _tool(IconData icon, String label, VoidCallback? action) => IconButton(
+      tooltip: label,
+      onPressed: action,
+      iconSize: 17,
+      color: _ftBlue,
+      constraints: const BoxConstraints.tightFor(width: 29, height: 28),
+      padding: EdgeInsets.zero,
+      icon: Icon(icon),
+    );
+
+class _TransferDrag {
+  const _TransferDrag(this.source, this.entries);
+  final FileController source;
+  final List<Entry> entries;
+}
