+    return DragTarget<_TransferDrag>(
+      onWillAcceptWithDetails: (d) =>
+          !identical(d.data.source, c) &&
+          identical(d.data.source.jobController, c.jobController) &&
+          c.directory.value.path.isNotEmpty,
+      onAcceptWithDetails: (d) => _transfer(d.data.source, d.data.entries),
+      builder: (context, dragging, _) => DropTarget(
+        enable: !c.isLocal,
+        onDragDone: _dropExternal,
+        child: Container(
+            color: dragging.isEmpty ? Colors.white : _ftSelection,
+            padding: const EdgeInsets.symmetric(horizontal: 6),
+            child: Column(children: [
+              SizedBox(
+                  height: 32,
+                  child: Row(children: [
+                    Expanded(
+                        child: Text(
+                            translate(c.isLocal
+                                ? 'Local Computer'
+                                : 'Remote Computer'),
+                            maxLines: 1,
+                            overflow: TextOverflow.ellipsis,
+                            style: const TextStyle(
+                                fontWeight: FontWeight.w600, color: _ftInk))),
+                    Obx(() => TextButton.icon(
+                          onPressed:
+                              SelectedItems.valid(c.selectedItems.items) &&
+                                      c
+                                          .getOtherSideDirectoryData()
+                                          .directory
+                                          .path
+                                          .isNotEmpty
+                                  ? _transferSelection
+                                  : null,
+                          style: TextButton.styleFrom(foregroundColor: _ftBlue),
+                          icon: Icon(
+                              c.isLocal
+                                  ? Icons.arrow_forward
+                                  : Icons.arrow_back,
+                              size: 16),
+                          label: Text(transferLabel),
+                        )),
+                  ])),
+              Row(children: [
+                _tool(Icons.arrow_back, translate('Back'), c.goBack),
+                _tool(Icons.arrow_upward, translate('Parent directory'),
+                    c.goToParentDirectory),
+                Expanded(
+                    child: TextField(
+                        controller: path,
+                        focusNode: pathFocus,
+                        onEditingComplete: () {},
+                        onSubmitted: (value) {
+                          listFocus.requestFocus();
+                          _open(value);
+                        },
+                        maxLines: 1,
+                        style: const TextStyle(fontSize: 13),
+                        decoration: const InputDecoration(
+                            isDense: true,
+                            contentPadding: EdgeInsets.symmetric(
+                                horizontal: 5, vertical: 6),
+                            border: OutlineInputBorder()))),
+                _tool(Icons.refresh, translate('Refresh File'), c.refresh),
+                _tool(Icons.create_new_folder_outlined,
+                    translate('Create Folder'), widget.createFolder),
+                _tool(
+                    Icons.search,
+                    translate('Search'),
+                    () => setState(() {
+                          searching = !searching;
+                          filter = '';
+                        })),
+                widget.menu,
+              ]),
+              if (searching)
+                TextField(
+                    autofocus: true,
+                    onChanged: (s) => setState(() => filter = s),
+                    decoration: InputDecoration(
+                        isDense: true, hintText: translate('Search'))),
+              Expanded(
+                  child: Row(children: [
+                SizedBox(width: 78, child: _places()),
+                const VerticalDivider(width: 1, color: _ftLine),
+                Expanded(child: _table()),
+              ])),
+            ])),
+      ),
+    );
+  }
