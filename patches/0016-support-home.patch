+            }),
+      ]));
+}
+
+class _ServerStatus extends StatefulWidget {
+  const _ServerStatus();
+  @override
+  State<_ServerStatus> createState() => _ServerStatusState();
+}
+
+class _ServerStatusState extends State<_ServerStatus> {
+  bool? reachable;
+  Timer? nextCheck;
+
+  @override
+  void initState() {
+    super.initState();
+    _probe();
+  }
+
+  Future<void> _probe() async {
+    bool result;
+    try {
+      result = await bind.mainProbeRendezvousServer();
+    } catch (_) {
+      result = false;
+    }
+    if (!mounted) return;
+    if (reachable != result) setState(() => reachable = result);
+    nextCheck = Timer(const Duration(seconds: 30), _probe);
+  }
+
+  @override
+  void dispose() {
+    nextCheck?.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => Obx(() {
+        final user = gFFI.userModel;
+        final account = user.networkError.isNotEmpty
+            ? 'Account status unavailable'
+            : user.isLogin
+                ? 'Signed in'
+                : 'Signed out';
+        final server = reachable == null
+            ? 'Checking'
+            : reachable!
+                ? 'Reachable'
+                : 'Unreachable';
+        return Container(
+          decoration: const BoxDecoration(
+              border: Border(top: BorderSide(color: Color(0xffe5e7eb)))),
+          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 6),
+          child: Row(children: [
+            Icon(Icons.circle,
+                size: 8,
+                color: reachable == true
+                    ? const Color(0xff16a34a)
+                    : const Color(0xff9ca3af)),
+            const SizedBox(width: 8),
+            Expanded(
+                child: Text(
+                    '${translate("ID server")} · ${translate(server)}   |   ${translate(account)}',
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                    style: const TextStyle(
+                        color: Color(0xff4b5563), fontSize: 12))),
+          ]),
+        );
+      });
+}
