diff --git a/flutter/tool/check_support_directory.dart b/flutter/tool/check_support_directory.dart
new file mode 100644
index 0000000..0653b8b
--- /dev/null
+++ b/flutter/tool/check_support_directory.dart
@@ -0,0 +1,78 @@
+// Run with the standalone Dart SDK from a patched upstream checkout.
+import '../lib/steaddesk/support_device.dart';
+
+void main() {
+  SupportDevice device({
+    String alias = '',
+    List<String> names = const [],
+    String platform = '',
+    bool? online,
+  }) =>
+      SupportDevice(
+          id: '123456789',
+          alias: alias,
+          hostnames: names,
+          platform: platform,
+          groupName: 'Test group',
+          online: online);
+
+  final till = device(
+      alias: 'Test till',
+      names: ['m0099-s07-SUNMI1', 'SUNMI-T2'],
+      platform: 'Android',
+      online: true);
+  final windows = device(
+      alias: 'M0099-S02-POS',
+      names: ['workstation'],
+      platform: 'Windows',
+      online: false);
+  final unknown = device(names: ['M0099-bad-SUNMI1'], platform: 'Android');
+  final assetOnly = device(names: ['M0099-S01-SUNMI2'], platform: 'Android');
+  final checks = <String, bool>{
+    'complete IDs override partial matches':
+        supportSearchTarget('123 456 789', ['1234567890']) == '123456789' &&
+            supportSearchTarget('1 234 567 890', []) == '1234567890',
+    'unique name or partial ID': supportSearchTarget('till', ['10']) == '10' &&
+        supportSearchTarget('123', ['12345']) == '12345',
+    'incomplete IDs and arbitrary text do not dial': [
+      '1',
+      '12345678',
+      '12345678901',
+      'test-id',
+      '123-456-789'
+    ].every((s) => supportSearchTarget(s, []) == null),
+    'ambiguous or empty input stays in the directory':
+        supportSearchTarget('demo', ['1', '2']) == null &&
+            supportSearchTarget('demo', []) == null &&
+            supportSearchTarget('', ['1']) == null,
+    'merchant/store from hostname':
+        till.merchant == 'M0099' && till.store == 'S07',
+    'canonical alias fallback':
+        windows.store == 'S02' && windows.name == windows.alias,
+    'ungrouped malformed name':
+        unknown.merchant == null && unknown.store == null,
+    'reported Android model': till.model == 'T2',
+    'asset suffix is not a hardware model':
+        assetOnly.model.isEmpty && windows.model.isEmpty,
+    'SUNMI filter': assetOnly.matches(DeviceFilter.sunmi) &&
+        !unknown.matches(DeviceFilter.sunmi),
+    'Windows filter': windows.matches(DeviceFilter.windows) &&
+        !till.matches(DeviceFilter.windows),
+    'online/offline': till.matches(DeviceFilter.online) &&
+        windows.matches(DeviceFilter.offline),
+    'unanswered presence': !unknown.matches(DeviceFilter.online) &&
+        !unknown.matches(DeviceFilter.offline) &&
+        unknown.matches(DeviceFilter.all),
+    'merchant and store tokens':
+        till.contains('M0099 S07') && !windows.contains('M0099 S07'),
+    'group and alias':
+        till.contains('TEST GROUP') && till.contains('test till'),
+    'hostname and formatted ID':
+        windows.contains('workstation') && till.contains('123 456 789'),
+    'empty and missing search': till.contains('') && !till.contains('no match'),
+  };
+  for (final result in checks.entries) {
+    if (!result.value) throw StateError(result.key);
+  }
+  print('${checks.length} directory checks passed');
