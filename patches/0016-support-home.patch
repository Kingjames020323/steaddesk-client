+import 'dart:async';
+import 'dart:math' as math;
+import 'package:flutter/foundation.dart' show setEquals;
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:get/get.dart';
+import 'package:url_launcher/url_launcher.dart';
+
+import '../common.dart';
+import '../common/widgets/login.dart';
+import '../common/widgets/peer_card.dart' show connectInPeerTab;
+import '../models/peer_model.dart';
+import '../models/peer_tab_model.dart';
+import '../models/ab_model.dart';
+import 'support_device.dart';
+import 'incoming_switch.dart';
+import '../consts.dart';
+
+import '../models/platform_model.dart';
+
+part 'support_directory.dart';
+part 'support_home_bar.dart';
+
+enum SupportPage {
+  devices('Devices', Icons.devices_outlined),
+  recent('Recent connections', Icons.history),
+  favorites('Favorites', Icons.star_outline),
+  health('Device health', Icons.monitor_heart_outlined),
+  recordings('Session recordings', Icons.video_library_outlined);
+
+  final String label;
+  final IconData icon;
+  const SupportPage(this.label, this.icon);
+}
+
+enum _Rail { expanded, compact, hidden }
+
+// TODO(U-01): reference the shared light theme tokens after U-01 lands.
+const _blue = Color(0xff0a6fa8);
+const _ink = Color(0xff0b2e42);
+const _solid = Color(0xffe8f4fa);
+
+class SupportHome extends StatefulWidget {
+  const SupportHome({super.key});
+  @override
+  State<SupportHome> createState() => _SupportHomeState();
+}
+
+class _SupportHomeState extends State<SupportHome> {
+  static const _modeKey = 'support-home-navigation';
+  static const _autoKey = 'support-home-auto-collapse';
+  late _Rail mode;
+  late bool automatic;
+  bool expandWhileNarrow = false;
+  bool slowRaster = false;
+  bool glassVisible = false;
+  final rasterWindow = <bool>[];
+
+  void _measureGlass(List<ui.FrameTiming> frames) {
+    if (!mounted || !glassVisible || slowRaster) return;
+    for (final frame in frames) {
+      rasterWindow.add(frame.rasterDuration > const Duration(milliseconds: 32));
+      if (rasterWindow.length > 12) rasterWindow.removeAt(0);
+      if (rasterWindow.length == 12 &&
+          rasterWindow.where((slow) => slow).length >= 8) {
+        setState(() => slowRaster = true);
+        break;
+      }
+    }
+  }
+
+  var page = SupportPage.devices;
+  final search = TextEditingController();
+  final directoryKeys = {
+    for (final p in [
+      SupportPage.devices,
+      SupportPage.recent,
+      SupportPage.favorites
+    ])
+      p: GlobalKey<_DirectoryState>(),
+  };
+  final searchFocus = FocusNode();
+
+  void _search(String value) => setState(() {
+        if (value.isNotEmpty) page = SupportPage.devices;
+      });
+
+  void _navigate(SupportPage next) {
+    search.clear();
+    setState(() => page = next);
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeTimingsCallback(_measureGlass);
+    search.dispose();
+    searchFocus.dispose();
+    super.dispose();
+  }
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addTimingsCallback(_measureGlass);
+    final saved = bind.getLocalFlutterOption(k: _modeKey);
+    mode = _Rail.values
+        .firstWhere((m) => m.name == saved, orElse: () => _Rail.expanded);
+    automatic = bind.getLocalFlutterOption(k: _autoKey) != 'N';
+  }
+
+  void _setMode(_Rail next) {
+    setState(() => mode = next);
+    bind.setLocalFlutterOption(k: _modeKey, v: next.name);
+  }
+
+  void _toggleAuto() {
+    setState(() {
+      automatic = !automatic;
+      expandWhileNarrow = false;
+    });
+    bind.setLocalFlutterOption(k: _autoKey, v: automatic ? 'Y' : 'N');
+  }
+
+  void _toggle(_Rail visible, bool narrow) {
+    expandWhileNarrow = visible == _Rail.compact && narrow && automatic;
+    _setMode(visible == _Rail.expanded ? _Rail.compact : _Rail.expanded);
+  }
+
+  Future<void> _menu(Offset position, _Rail visible, bool narrow) async {
+    final box = Overlay.of(context).context.findRenderObject() as RenderBox;
+    final point = box.globalToLocal(position);
+    final action = await showMenu<String>(
+        context: context,
+        position: RelativeRect.fromRect(
+            Rect.fromLTWH(point.dx, point.dy, 0, 0), Offset.zero & box.size),
+        items: [
+          PopupMenuItem(
+              value: 'toggle',
+              child: Text(translate(visible == _Rail.expanded
+                  ? 'Collapse navigation'
+                  : 'Expand navigation'))),
+          PopupMenuItem(
+              value: 'hide', child: Text(translate('Hide navigation'))),
+          CheckedPopupMenuItem(
+              value: 'auto',
+              checked: automatic,
+              child: Text(translate('Auto-collapse below 1100 px'))),
+        ]);
+    if (!mounted) return;
+    if (action == 'toggle') _toggle(visible, narrow);
+    if (action == 'hide') _setMode(_Rail.hidden);
+    if (action == 'auto') _toggleAuto();
+  }
+
+  Future<void> _manage() async {
+    if (!gFFI.userModel.isLogin || !gFFI.userModel.isAdmin.value) return;
+    for (final url in [
+      'https://api.steaddesk.com/_admin/',
+      'https://console.steaddesk.com/'
+    ]) {
+      try {
+        if (await launchUrl(Uri.parse(url),
+            mode: LaunchMode.externalApplication)) continue;
+      } catch (_) {}
+      if (mounted)
+        ScaffoldMessenger.maybeOf(context)?.showSnackBar(
+            SnackBar(content: Text('${translate("Unable to open")} $url')));
+    }
+  }
+
+  Widget _body() {
+    switch (page) {
+      case SupportPage.devices:
+      case SupportPage.recent:
+      case SupportPage.favorites:
+        return _Directory(page, search.text, key: directoryKeys[page]);
+      default:
+        return Center(child: Text(translate('Coming soon')));
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final narrow = MediaQuery.sizeOf(context).width < 1100;
+    if (!narrow) expandWhileNarrow = false;
+    final visible =
+        automatic && narrow && !expandWhileNarrow && mode == _Rail.expanded
+            ? _Rail.compact
+            : mode;
+    final opaque = slowRaster ||
+        MediaQuery.of(context).disableAnimations ||
+        bind.mainGetOptionSync(key: kOptionAllowAlwaysSoftwareRender) == 'Y';
+    glassVisible = visible != _Rail.hidden && !opaque;
+    if (!glassVisible) rasterWindow.clear();
+    return Theme(
+        data: ThemeData(
+            brightness: Brightness.light,
+            fontFamily: isWindows ? 'Segoe UI' : null,
+            fontFamilyFallback: isWindows ? const ['Microsoft YaHei'] : null,
+            textButtonTheme: TextButtonThemeData(
+                style: TextButton.styleFrom(
+                    foregroundColor: _blue,
+                    shape: RoundedRectangleBorder(
+                        borderRadius: BorderRadius.circular(6))))),
+        child: CallbackShortcuts(
+            bindings: {
+              const SingleActivator(LogicalKeyboardKey.keyK, control: true):
+                  searchFocus.requestFocus,
+              const SingleActivator(LogicalKeyboardKey.keyB, control: true):
+                  () => _toggle(visible, narrow),
+            },
+            child: Focus(
+                autofocus: true,
+                child: Material(
+                    color: Colors.white,
+                    child: Row(children: [
+                      if (visible != _Rail.hidden)
+                        _rail(visible, narrow, opaque),
+                      Expanded(
+                          child: Column(
+                              crossAxisAlignment: CrossAxisAlignment.stretch,
+                              children: [
+                            _HomeHeader(
+                                restore: visible == _Rail.hidden
+                                    ? () => _setMode(_Rail.expanded)
+                                    : null,
+                                focus: searchFocus,
+                                search: search,
+                                onSearch: _search,
+                                onSubmit: (query) {
+                                  if (query.trim().isEmpty) return;
+                                  // Wait for onChanged's page/filter update to render.
+                                  WidgetsBinding.instance
+                                      .addPostFrameCallback((_) {
+                                    if (mounted && search.text == query) {
+                                      directoryKeys[page]
+                                          ?.currentState
+                                          ?.submit(query);
+                                    }
+                                  });
+                                  WidgetsBinding.instance.scheduleFrame();
+                                }),
+                            const Divider(height: 1, color: Color(0xffe5e7eb)),
+                            Expanded(child: _body()),
+                            const _ServerStatus(),
+                          ])),
+                    ])))));
+  }
+
+  Widget _rail(_Rail visible, bool narrow, bool opaque) {
+    final full = visible == _Rail.expanded;
+    final radius = BorderRadius.circular(20);
+    Widget item(String label, IconData icon, VoidCallback? tap,
+            {bool selected = false}) =>
+        Tooltip(
+            message: label,
+            child: Material(
+                color: selected ? _blue.withOpacity(.12) : Colors.transparent,
+                borderRadius: BorderRadius.circular(10),
+                child: InkWell(
+                    onTap: tap,
+                    borderRadius: BorderRadius.circular(10),
+                    child: SizedBox(
+                        height: 42,
+                        child: Row(
+                            mainAxisAlignment: full
+                                ? MainAxisAlignment.start
+                                : MainAxisAlignment.center,
+                            children: [
+                              if (full) const SizedBox(width: 10),
+                              Icon(icon,
+                                  size: 20, color: selected ? _blue : _ink),
+                              if (full) ...[
+                                const SizedBox(width: 10),
+                                Expanded(
+                                    child: Text(label,
+                                        overflow: TextOverflow.ellipsis,
+                                        style: TextStyle(
+                                            color: selected ? _blue : _ink)))
+                              ],
+                            ])))));
+    final content = Column(children: [
+      Row(mainAxisAlignment: MainAxisAlignment.center, children: [
+        if (full) ...[
+          Image.asset('assets/icon.png', width: 28, height: 28),
+          const SizedBox(width: 6),
+          const Expanded(
+              child: Text('SteadDesk',
+                  style: TextStyle(fontWeight: FontWeight.bold, color: _ink)))
+        ],
+        Builder(
+            builder: (buttonContext) => IconButton(
+                tooltip: translate('Navigation'),
+                onPressed: () {
+                  final box = buttonContext.findRenderObject() as RenderBox;
+                  _menu(box.localToGlobal(Offset(0, box.size.height)), visible,
+                      narrow);
+                },
+                icon: full
+                    ? const Icon(Icons.menu_open)
+                    : Image.asset('assets/icon.png', width: 28, height: 28))),
+      ]),
+      Expanded(
+          child: ListView(children: [
+        for (final p in SupportPage.values)
+          item(translate(p.label), p.icon, () => _navigate(p),
+              selected: page == p)
