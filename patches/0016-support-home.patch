diff --git a/flutter/lib/steaddesk/support_device.dart b/flutter/lib/steaddesk/support_device.dart
new file mode 100644
index 0000000..5463148
--- /dev/null
+++ b/flutter/lib/steaddesk/support_device.dart
@@ -0,0 +1,78 @@
+// Only display fields cross into the directory and its search index.
+enum DeviceFilter {
+  all('All'),
+  sunmi('SUNMI'),
+  windows('Windows'),
+  online('Online'),
+  offline('Offline');
+
+  final String label;
+  const DeviceFilter(this.label);
+}
+
+class SupportDevice {
+  final String id, alias, platform, name, model, groupName;
+  final String? merchant, store;
+  final bool sunmi;
+  final bool? online;
+  static final _asset = RegExp(r'^(M[0-9]+)-(S[0-9]+)-([A-Z0-9][A-Z0-9._-]*)$',
+      caseSensitive: false);
+  static final _sunmiModel = RegExp(r'^SUNMI-(.+)$', caseSensitive: false);
+
+  SupportDevice._(this.id, this.alias, this.platform, this.name, this.model,
+      this.groupName, this.merchant, this.store, this.sunmi, this.online);
+
+  factory SupportDevice(
+      {required String id,
+      required String alias,
+      required List<String> hostnames,
+      required String platform,
+      required String groupName,
+      required bool? online}) {
+    final names =
+        [...hostnames, alias].map((s) => s.trim()).where((s) => s.isNotEmpty);
+    RegExpMatch? asset;
+    for (final n in names) {
+      asset = _asset.firstMatch(n);
+      if (asset != null) break;
+    }
+    String model = '';
+    if (platform.toLowerCase() == 'android') {
+      for (final host in hostnames) {
+        final match = _sunmiModel.firstMatch(host.trim());
+        if (match != null) {
+          model = match[1]!.trim();
+          break;
+        }
+      }
+    }
+    final name = asset?[0] ??
+        hostnames.firstWhere((s) => s.isNotEmpty, orElse: () => '');
+    return SupportDevice._(
+        id,
+        alias,
+        platform,
+        name,
+        model,
+        groupName,
+        asset?[1]?.toUpperCase(),
+        asset?[2]?.toUpperCase(),
+        model.isNotEmpty || (asset?[3] ?? '').toUpperCase().startsWith('SUNMI'),
+        online);
+  }
+
+  bool matches(DeviceFilter filter) {
+    switch (filter) {
+      case DeviceFilter.all:
+        return true;
+      case DeviceFilter.sunmi:
+        return sunmi;
+      case DeviceFilter.windows:
+        return platform.toLowerCase() == 'windows';
+      case DeviceFilter.online:
+        return online == true;
+      case DeviceFilter.offline:
+        return online == false;
+    }
+  }
+}
diff --git a/flutter/lib/steaddesk/support_directory.dart b/flutter/lib/steaddesk/support_directory.dart
new file mode 100644
index 0000000..58bbf56
--- /dev/null
+++ b/flutter/lib/steaddesk/support_directory.dart
@@ -0,0 +1,380 @@
+part of 'support_home.dart';
+
+typedef _Source = ({Peer peer, BaseAb? book, PeerTabIndex tab});
+typedef _Entry = ({SupportDevice device, _Source source});
+
+class _Directory extends StatefulWidget {
+  final SupportPage page;
+  const _Directory(this.page, {super.key});
+  @override
+  State<_Directory> createState() => _DirectoryState();
+}
+
+class _DirectoryState extends State<_Directory> {
+  static const _event = 'callback_query_onlines';
+  static const _listener = 'SteadDeskSupportDirectory';
+  final presence = <String, bool>{};
+  final loadedBooks = <BaseAb>{};
+  final closed = <String>{};
+  Set<String> ids = {};
+  String scope = '';
+  var filter = DeviceFilter.all;
+  late final Timer timer;
+
+  @override
+  void initState() {
+    super.initState();
+    platformFFI.registerEventHandler(_event, _listener, (evt) async {
+      if (!mounted) return;
+      var changed = false;
+      for (final online in [true, false]) {
+        final raw = evt[online ? 'onlines' : 'offlines'];
+        if (raw is! String) continue;
+        for (final id in raw.split(',')) {
+          if (ids.contains(id) && presence[id] != online) {
+            presence[id] = online;
+            changed = true;
+          }
+        }
+      }
+      if (changed) setState(() {});
+    });
+    timer = Timer.periodic(const Duration(seconds: 30), (_) => _query());
+    if (widget.page == SupportPage.recent) bind.mainLoadRecentPeers();
+    if (widget.page == SupportPage.favorites) bind.mainLoadFavPeers();
+  }
+
+  Future<void> _query() async {
+    if (!mounted || ids.isEmpty) return;
+    try {
+      await bind.queryOnlines(ids: ids.toList());
+    } catch (_) {
+      if (mounted && presence.isNotEmpty) setState(presence.clear);
+    }
+  }
+
+  void _observe(Set<String> next) {
+    if (setEquals(ids, next)) return;
+    ids = next;
+    presence.removeWhere((k, _) => !ids.contains(k));
+    WidgetsBinding.instance.addPostFrameCallback((_) => _query());
+  }
+
+  void _loadBook(BaseAb book) {
+    if (book.initialized || !loadedBooks.add(book)) return;
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (mounted &&
+          gFFI.userModel.isLogin &&
+          gFFI.abModel.addressbooks[book.name()] == book &&
+          !book.initialized &&
+          !book.abPulling) book.pullAb(quiet: true);
+    });
+  }
+
+  @override
+  void dispose() {
+    timer.cancel();
+    platformFFI.unregisterEventHandler(_event, _listener);
+    super.dispose();
+  }
+
+  List<_Entry> _entries() {
+    final all = <String, List<_Source>>{};
+    void add(Peer peer, PeerTabIndex tab, [BaseAb? book]) {
+      if (peer.id.isNotEmpty)
+        (all[peer.id] ??= []).add((peer: peer, book: book, tab: tab));
+    }
+
+    final directory = widget.page == SupportPage.devices;
+    if (!directory) {
+      final recent = widget.page == SupportPage.recent;
+      final model = recent ? gFFI.recentPeersModel : gFFI.favoritePeersModel;
+      final tab = recent ? PeerTabIndex.recent : PeerTabIndex.fav;
+      for (final p in model.peers) {
+        add(p, tab);
+      }
+      for (final id in model.restPeerIds) {
+        if (!all.containsKey(id)) add(Peer.fromJson({'id': id}), tab);
+      }
+    }
+    if (gFFI.userModel.isLogin) {
+      final ab = gFFI.abModel;
+      // Prefer the active book when an ID is shared across multiple books.
+      for (final book in {ab.current, ...ab.addressbooks.values}) {
+        if (!ab.addressbooks.containsKey(book.name())) continue;
+        if (directory && !book.isPersonal() && book != ab.current)
+          _loadBook(book);
+        for (final p in book.peers) {
+          if (directory || all.containsKey(p.id)) add(p, PeerTabIndex.ab, book);
+        }
+      }
+      for (final p in gFFI.groupModel.peers) {
+        if (directory || all.containsKey(p.id)) add(p, PeerTabIndex.group);
+      }
+    }
+    _observe(all.keys.toSet());
+    return all.entries.map((entry) {
+      final peers = entry.value.map((s) => s.peer);
+      String first(String Function(Peer) read) =>
+          peers.map(read).firstWhere((s) => s.isNotEmpty, orElse: () => '');
+      return (
+        device: SupportDevice(
+            id: entry.key,
+            alias: first((p) => p.alias),
+            hostnames: peers.map((p) => p.hostname).toList(),
+            platform: first((p) => p.platform),
+            groupName: first((p) => p.device_group_name),
+            online: presence[entry.key]),
+        source: entry.value.first
+      );
+    }).toList();
+  }
+
+  void _connect(_Entry row) =>
+      connectInPeerTab(context, row.source.peer, row.source.tab,
+          addressBook: row.source.book);
+
+  void _details(_Entry row) {
+    final d = row.device;
+    showDialog<void>(
+        context: context,
+        builder: (ctx) => AlertDialog(
+                title: Text(d.alias.isEmpty ? d.id : d.alias),
+                content: SelectableText([
+                  if (d.name.isNotEmpty) d.name,
+                  'ID: ${d.id}',
+                  if (d.platform.isNotEmpty) d.platform,
+                  if (d.model.isNotEmpty) d.model,
+                  if (d.groupName.isNotEmpty) d.groupName
+                ].join('\n')),
+                actions: [
+                  TextButton(
+                      onPressed: () => Navigator.pop(ctx),
+                      child: Text(translate('Close'))),
+                  TextButton(
+                      onPressed: () {
+                        Navigator.pop(ctx);
+                        _connect(row);
+                      },
+                      child: Text(translate('Connect')))
+                ]));
+  }
+
+  @override
+  Widget build(BuildContext context) => AnimatedBuilder(
+      animation:
+          Listenable.merge([gFFI.recentPeersModel, gFFI.favoritePeersModel]),
+      builder: (_, __) => Obx(() {
+            final entries = _entries();
+            final devices = entries.map((e) => e.device);
+            final byScope = <String, (int, int)>{};
+            final stores = <String, Set<String>>{};
+            for (final d in devices) {
+              final m = d.merchant;
+              if (m != null) (stores[m] ??= {}).add(d.store!);
+              for (final key in [
+                '',
+                if (m == null) '?' else ...['*', m, '$m/${d.store}']
+              ]) {
+                final previous = byScope[key] ?? (0, 0);
+                byScope[key] =
+                    (previous.$1 + (d.online == true ? 1 : 0), previous.$2 + 1);
+              }
+            }
+            final selected = byScope.containsKey(scope) ? scope : '';
+            final rows = entries.where((row) {
+              final d = row.device;
+              return d.matches(filter) &&
+                  (selected.isEmpty ||
+                      (selected == '?' && d.merchant == null) ||
+                      (selected == '*' && d.merchant != null) ||
+                      selected == d.merchant ||
+                      selected == '${d.merchant}/${d.store}');
+            }).toList();
+            final grouped = widget.page == SupportPage.devices;
+            return LayoutBuilder(builder: (context, size) {
+              final treeWidth = size.maxWidth >= 850 ? 212.0 : 158.0;
+              // Keep columns usable at very small desktop window sizes.
+              final width =
+                  math.max(size.maxWidth, grouped ? treeWidth + 430 : 430.0);
+              return SingleChildScrollView(
+                  scrollDirection: Axis.horizontal,
+                  child: SizedBox(
+                      width: width,
+                      child: Row(children: [
+                        if (grouped) ...[
+                          SizedBox(
+                              width: treeWidth,
+                              child: _tree(byScope, stores, selected)),
+                          const VerticalDivider(width: 1)
+                        ],
+                        Expanded(
+                            child: Column(
+                                crossAxisAlignment: CrossAxisAlignment.stretch,
+                                children: [
+                              Padding(
+                                  padding:
+                                      const EdgeInsets.fromLTRB(16, 16, 16, 4),
+                                  child: Text(translate(widget.page.label),
+                                      style: const TextStyle(
+                                          fontSize: 20,
+                                          color: _ink,
+                                          fontWeight: FontWeight.w600))),
+                              SingleChildScrollView(
+                                  scrollDirection: Axis.horizontal,
+                                  child: Row(children: [
+                                    for (final f in DeviceFilter.values)
+                                      InkWell(
+                                          onTap: () =>
+                                              setState(() => filter = f),
+                                          hoverColor: const Color(0xfff3f4f6),
+                                          child: Container(
+                                              padding:
+                                                  const EdgeInsets.symmetric(
+                                                      vertical: 9,
+                                                      horizontal: 12),
+                                              decoration: BoxDecoration(
+                                                  border: Border(
+                                                      bottom: BorderSide(
+                                                          width: 2,
+                                                          color: filter == f
+                                                              ? _blue
+                                                              : Colors
+                                                                  .transparent))),
+                                              child: Text(translate(f.label),
+                                                  style: TextStyle(
+                                                      color: filter == f
+                                                          ? _blue
+                                                          : const Color(
+                                                              0xff4b5563)))))
+                                  ])),
+                              _columns(
+                                  Text(translate('Device')),
+                                  Text(translate('Status')),
+                                  Text(translate('Model')),
+                                  Text(translate('Action'))),
+                              const Divider(
+                                  height: 1, color: Color(0xffe5e7eb)),
+                              Expanded(
+                                  child: rows.isEmpty
+                                      ? Center(
+                                          child: Text(translate('No devices')))
+                                      : ListView.separated(
+                                          itemCount: rows.length,
+                                          separatorBuilder: (_, __) =>
+                                              const Divider(
+                                                  height: 1,
+                                                  color: Color(0xffeef0f2)),
+                                          itemBuilder: (_, i) =>
+                                              _row(rows[i]))),
+                            ]))
+                      ])));
+            });
+          }));
+
+  Widget _tree(Map<String, (int, int)> counts, Map<String, Set<String>> stores,
+      String selected) {
+    Widget node(String key, String label, int depth, {bool branch = false}) {
+      final count = counts[key] ?? (0, 0);
+      return Material(
+          color: selected == key ? const Color(0xffdff2fa) : Colors.transparent,
+          child: InkWell(
+              onTap: () => setState(() => scope = key),
+              child: Padding(
+                  padding: EdgeInsets.fromLTRB(6.0 + depth * 8, 3, 8, 3),
+                  child: Row(children: [
+                    if (branch)
+                      SizedBox(
+                          width: 24,
+                          height: 32,
+                          child: IconButton(
+                              padding: EdgeInsets.zero,
+                              iconSize: 16,
+                              tooltip: translate(
+                                  closed.contains(key) ? 'Expand' : 'Collapse'),
+                              onPressed: () => setState(() {
+                                    if (!closed.remove(key)) closed.add(key);
+                                  }),
+                              icon: Icon(closed.contains(key)
+                                  ? Icons.chevron_right
+                                  : Icons.expand_more))),
+                    Expanded(
+                        child: Tooltip(
+                            message: label,
+                            child: Text(label,
+                                maxLines: 1, overflow: TextOverflow.ellipsis))),
+                    Text('${count.$1}/${count.$2}',
+                        style: const TextStyle(
+                            fontSize: 12,
+                            color: Color(0xff4b5563),
+                            fontFeatures: [ui.FontFeature.tabularFigures()])),
+                  ]))));
+    }
+
+    return ListView(children: [
+      node('', translate('All devices'), 0),
+      node('*', translate('My merchants'), 0, branch: true),
+      if (!closed.contains('*'))
+        for (final m in stores.keys.toList()..sort()) ...[
+          node(m, m, 1, branch: true),
+          if (!closed.contains(m))
+            for (final s in stores[m]!.toList()..sort()) node('$m/$s', s, 2)
+        ],
+      if (counts.containsKey('?')) node('?', translate('Ungrouped'), 0)
+    ]);
+  }
+
+  Widget _columns(Widget device, Widget status, Widget model, Widget action) =>
+      Padding(
+          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+          child: Row(children: [
+            Expanded(flex: 5, child: device),
+            Expanded(flex: 2, child: status),
+            Expanded(flex: 2, child: model),
+            SizedBox(width: 64, child: action)
+          ]));
+
+  Widget _row(_Entry row) {
+    final d = row.device;
+    final status = d.online == null
+        ? 'Unknown'
+        : d.online!
+            ? 'Online'
+            : 'Offline';
+    return InkWell(
+        onDoubleTap: () => _connect(row),
+        onTap: () => _details(row),
+        hoverColor: const Color(0xfff3f4f6),
+        child: _columns(
+            Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+              Text(
+                  d.alias.isNotEmpty
+                      ? d.alias
+                      : d.name.isNotEmpty
+                          ? d.name
+                          : d.id,
+                  maxLines: 1,
+                  overflow: TextOverflow.ellipsis,
+                  style: const TextStyle(fontWeight: FontWeight.w600)),
+              Text([if (d.name.isNotEmpty) d.name, d.id].join(' · '),
+                  maxLines: 1,
+                  overflow: TextOverflow.ellipsis,
+                  style: const TextStyle(
+                      color: Color(0xff4b5563),
+                      fontSize: 12,
+                      fontFeatures: [ui.FontFeature.tabularFigures()]))
+            ]),
+            Text(translate(status),
+                style: TextStyle(
+                    color: d.online == true
+                        ? const Color(0xff16a34a)
+                        : const Color(0xff4b5563))),
+            Text(d.model.isEmpty ? '—' : d.model,
+                maxLines: 1, overflow: TextOverflow.ellipsis),
+            TextButton(
+                onPressed: () =>
+                    d.online == true ? _connect(row) : _details(row),
+                child: Text(translate(d.online == true ? 'Connect' : 'Details'),
+                    style: const TextStyle(color: _blue)))));
+  }
+}
