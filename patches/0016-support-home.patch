+        const SizedBox(width: 12),
+        ValueListenableBuilder<TextEditingValue>(
+            valueListenable: gFFI.serverModel.serverId,
+            builder: (_, value, __) {
+              final id = value.text.isEmpty ? '—' : value.text;
+              final label = '${translate("Local ID")} · $id';
+              return Tooltip(
+                  message:
+                      translate('Incoming connections require your approval'),
