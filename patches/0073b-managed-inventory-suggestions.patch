diff --git a/flutter/lib/steaddesk/quick/managed_inventory.dart b/flutter/lib/steaddesk/quick/managed_inventory.dart
new file mode 100644
index 0000000..f0d160f
--- /dev/null
+++ b/flutter/lib/steaddesk/quick/managed_inventory.dart
@@ -0,0 +1,57 @@
+import 'check.dart' show Json, privateV4, typeLabels;
+
+typedef InventoryDraft = ({String name, String ip, String? type});
+
+List<InventoryDraft> managedSuggestions(Object? raw, List<Json> entries) {
+  if (raw is! List) return [];
+  final seen = {for (final entry in entries) entry['ip']};
+  final suggestions = <InventoryDraft>[];
+  for (final row in raw) {
+    if (row case {'name': String name, 'ip': String ip, 'type': final type}) {
+      if (name.trim().isEmpty ||
+          name.runes.length > 64 ||
+          RegExp(r'[\x00-\x1f\x7f]').hasMatch(name) ||
+          !privateV4(ip) ||
+          !seen.add(ip)) continue;
+      suggestions.add((
+        name: name.trim(),
+        ip: ip,
+        type: type is String && typeLabels.containsKey(type) ? type : null
+      ));
+    }
+  }
+  return suggestions;
+}
+
+String inventoryLabel(String key, String language) {
+  final labels = switch (language.toLowerCase().split(RegExp('[-_]')).first) {
+    'zh' => const {...typeLabels, 'suggestions': '建议添加', 'add': '添加'},
+    'es' => const {
+        'printer': 'Impresora',
+        'host': 'Terminal principal',
+        'secondary': 'Terminal secundaria',
+        'payment': 'Terminal de pago',
+        'kiosk': 'Quiosco',
+        'order_display': 'Pantalla de pedidos',
+        'kds': 'KDS',
+        'tablet': 'Tableta',
+        'other': 'Otro',
+        'suggestions': 'Sugerencias para añadir',
+        'add': 'Añadir',
+      },
+    _ => const {
+        'printer': 'Printer',
+        'host': 'Primary terminal',
+        'secondary': 'Secondary terminal',
+        'payment': 'Payment terminal',
+        'kiosk': 'Kiosk',
+        'order_display': 'Order display',
+        'kds': 'KDS',
+        'tablet': 'Tablet',
+        'other': 'Other',
+        'suggestions': 'Suggested devices',
+        'add': 'Add',
+      },
+  };
+  return labels[key] ?? key;
+}
