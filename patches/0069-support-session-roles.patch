--- /dev/null
+++ b/flutter/test/steaddesk/role_event_relay_test.dart
@@ -0,0 +1,83 @@
+import 'dart:async';
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/ops_health.dart';
+import 'package:flutter_hbb/steaddesk/role_event_relay.dart';
+
+void main() {
+  test(
+      'two child windows share main SSE and removal of one cannot cancel the other',
+      () async {
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    final uri = Uri.parse('http://127.0.0.1:${server.port}');
+    final responses = <HttpResponse>[];
+    server.listen((req) async {
+      responses.add(req.response);
+      req.response.bufferOutput = false;
+      req.response.headers.contentType = ContentType('text', 'event-stream');
+      req.response.write(': stream\n\n');
+      await req.response.flush();
+    });
+    final first = Completer<void>(),
+        second = Completer<void>(),
+        changed = Completer<void>();
+    final host = RoleEventHost(
+        auth: (origin, identity) async =>
+            origin == uri.toString() && identity == 'digest',
+        open: (_, __) => OpsHealthHttp(uri, 'test'),
+        deliver: (window, subscription, event) async {
+          if (event == 'connected') {
+            final ack = window == 1 ? first : second;
+            if (!ack.isCompleted) ack.complete();
+          } else if (event == 'remote.session.changed' && window == 2) {
+            changed.complete();
+          }
+          return true;
+        });
+    final params = {
+      'subscription': 'subscription',
+      'origin': uri.toString(),
+      'identity': 'digest'
+    };
+    try {
+      expect(await host.handle(1, 'open', params), 'ok');
+      await first.future.timeout(const Duration(seconds: 3));
+      expect(await host.handle(2, 'open', params), 'ok');
+      await second.future.timeout(const Duration(seconds: 3));
+      expect(responses.length, 1);
+      expect(await host.handle(1, 'close', params), 'ok');
+      expect(await host.handle(1, 'renew', params), 'gone');
+      expect(await host.handle(2, 'renew', params), 'ok');
+      responses.single.write('event: remote.session.changed\ndata: {}\n\n');
+      await responses.single.flush();
+      await changed.future.timeout(const Duration(seconds: 3));
+      expect(await host.handle(3, 'open', {...params, 'identity': 'wrong'}),
+          'denied');
+    } finally {
+      host.dispose();
+      await server.close(force: true);
+    }
+  });
+  test('losing the main relay ends the child feed so GET fallback can run',
+      () async {
+    final opened = Completer<String>();
+    late RoleEventClient client;
+    client = RoleEventClient((message) async {
+      final id = message['subscription']!;
+      if (message['action'] == 'open') {
+        opened.complete(id);
+        return 'ok';
+      }
+      return 'gone';
+    }, renewEvery: const Duration(milliseconds: 15));
+    final events = <String>[], done = Completer<void>();
+    client
+        .listen('fixture', 'digest')
+        .listen(events.add, onDone: () => done.complete());
+    final id = await opened.future;
+    expect(client.receive(id, 'connected'), true);
+    await done.future.timeout(const Duration(seconds: 2));
+    expect(events, ['connected']);
+    expect(client.receive(id, 'remote.session.changed'), false);
+  });
+}
