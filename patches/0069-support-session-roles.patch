@@ -0,0 +1,79 @@
+import 'dart:async';
+import 'dart:io';
+import 'package:flutter_hbb/steaddesk/ops_health.dart';
+import 'package:flutter_hbb/steaddesk/remote_role.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/role_launch.dart';
+
+void main() {
+  for (final offline in [false, true]) {
+    test(
+        'real ${offline ? "unreachable" : "404"} ops opens original connection exactly once',
+        () async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      final api =
+          OpsHealthHttp(Uri.parse('http://127.0.0.1:${server.port}'), 'test');
+      addTearDown(api.close);
+      final calls = <String>[];
+      if (offline) {
+        await server.close(force: true);
+      } else {
+        addTearDown(() => server.close(force: true));
+        server.listen((request) async {
+          calls.add('${request.method} ${request.uri.path}');
+          request.response.statusCode = 404;
+          await request.response.close();
+        });
+      }
+      final dispatch = <Object?>[];
+      await RemoteLaunchGate().run('123456789',
+          activateExisting: () async => false,
+          prepare: () => RemoteRole.prepare(
+              api: api,
+              device: '123456789',
+              resolveStaffPeer: () async => fail('legacy branch read staff ID'),
+              confirm: (_) async =>
+                  fail('legacy branch prompted for view-only')),
+          open: (seed) async => dispatch.add(seed));
+      expect(dispatch, [null]);
+      expect(
+          calls,
+          offline
+              ? isEmpty
+              : ['GET /ops/v1/remote/devices/123456789/sessions']);
+    });
+  }
+  test('direct legacy launch has no seed; a duplicate cannot register twice',
+      () async {
+    final gate = RemoteLaunchGate();
+    final dispatch = <Object?>[];
+    final wait = Completer<void>();
+    var probes = 0;
+    Future<void> launch() => gate.run('123456789',
+        activateExisting: () async => false,
+        prepare: () async {
+          probes++;
+          await wait.future;
+          return null;
+        },
+        open: (seed) async {
+          dispatch.add(seed);
+        });
+    final first = launch();
+    final second = launch();
+    wait.complete();
+    await Future.wait([first, second]);
+    expect(probes, 1);
+    expect(dispatch, [null]);
+  });
+  test('reuse follows existing open path without creating a new lease',
+      () async {
+    final gate = RemoteLaunchGate();
+    final dispatched = <Object?>[];
+    await gate.run('123456789',
+        activateExisting: () async => true,
+        prepare: () async => fail('unexpected registry request'),
+        open: (seed) async => dispatched.add(seed));
+    expect(dispatched, isEmpty);
+  });
+}
