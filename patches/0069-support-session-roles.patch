+      return {
+        ...snapshot(me: me, vacancy: 'lease_expired'),
+        'predecessor_username': 'former',
+        'handover_receipts': [
+          for (final entry in [
+            [9, me],
+            [9, me],
+            [10, other]
+          ])
+            {
+              'audit_id': entry[0],
+              'from_session': 'prior',
+              'from_name': 'former',
+              'to_session': entry[1],
+              'to_name': 'next',
+              'at': '2026-11-18T10:32:00Z'
+            },
+        ],
+      };
+    });
+    final role = RemoteRole.fromSeed((await join(api))!,
+        api: api, releaseInput: () async {});
