+/// Serialize simultaneous entry points for one peer. Reopening an existing tab
+/// must retain its current registration and any manual view-only setting.
+class RemoteLaunchGate {
+  final _inFlight = <String, Future<void>>{};
+
+  Future<void> run(
+    String peer, {
+    required Future<bool> Function() activateExisting,
+    required Future<Map<String, dynamic>?> Function() prepare,
+    required Future<void> Function(Map<String, dynamic>?) open,
+  }) {
+    return _inFlight.putIfAbsent(peer, () async {
+      try {
+        if (await activateExisting()) return;
+        final seed = await prepare();
+        await open(seed);
+      } finally {
+        _inFlight.remove(peer);
+      }
+    });
+  }
+}
