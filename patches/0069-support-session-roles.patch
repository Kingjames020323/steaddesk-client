+/// Releases exactly the presses emitted by this connection. Release callbacks
+/// go straight to the transport; they must work after the local gate closes.
+class RolePressedInputs {
+  final _held = <String, Future<void> Function()>{};
+  bool releasing = false;
+
+  void track(String key, bool down, Future<void> Function() release) {
+    if (releasing) return;
+    if (down) {
+      _held[key] = release;
+    } else {
+      _held.remove(key);
+    }
+  }
+
+  Future<void> release() async {
+    releasing = true;
+    final pending = _held.values.toList();
+    _held.clear();
+    try {
+      await Future.wait(pending.map((sendUp) => Future.sync(sendUp)));
+    } finally {
+      releasing = false;
+    }
+  }
+}
+
+/// A promotion may arrive while a viewer is holding keys over the canvas.
+/// Reuse the current hover but only acquire after a physically neutral sample.
+class RoleInputPromotion {
+  bool waiting = false;
+  bool acquire({required bool wantsInput, required bool held}) {
+    if (!waiting || !wantsInput || held) return false;
+    waiting = false;
+    return true;
+  }
+}
