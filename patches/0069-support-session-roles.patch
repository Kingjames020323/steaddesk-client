+    expect(ends.single, endsWith('/${ids.first}/end'));
+    expect(heartbeats.single, endsWith('/${ids.last}/heartbeat'));
+    expect(role.viewOnly, true);
+    expect(role.everOperated, false);
+    await role.end();
+    expect(ends.last, endsWith('/${ids.last}/end'));
+  });
+  test('fresh registration survives a lost first connected heartbeat',
+      () async {
+    String? id;
+    int beats = 0;
+    final ended = <String>[];
+    final api = Api((m, path, body) async {
+      if (path.endsWith('/end')) {
+        ended.add(path);
+        return snapshot();
+      }
+      if (path.endsWith('/heartbeat') && ++beats == 1) {
+        throw const SocketException('lost initial heartbeat');
+      }
+      if (m == 'POST' && path.endsWith('/sessions')) id = body!['session_id'];
+      return snapshot(me: id, owner: id);
+    });
+    final role = RemoteRole.fromSeed((await join(api))!,
+        api: api, releaseInput: () async {});
+    final old = role.sessionId;
+    await role.suspend();
+    await role.reconnect();
+    expect(role.sessionId, isNot(old));
+    expect(role.viewOnly, false);
+    await role.connected();
+    expect(beats, 2);
+    await role.suspend();
+    expect(ended.last, endsWith('/${role.sessionId}/end'));
+    await role.end();
+  });
+  test('another disconnect retires a late registration without heartbeating it',
+      () async {
+    String? id;
+    final started = Completer<void>(), deliver = Completer<void>();
+    final ended = <String>[], beats = <String>[];
+    var registrations = 0;
+    final api = Api((m, path, body) async {
+      if (path.endsWith('/end')) {
+        ended.add(path);
+        return snapshot();
+      }
+      if (path.endsWith('/heartbeat')) beats.add(path);
+      if (m == 'POST' && path.endsWith('/sessions')) {
+        id = body!['session_id'];
+        if (++registrations == 2) {
+          started.complete();
+          await deliver.future;
+        }
+      }
+      return snapshot(me: id, owner: id);
+    });
+    final role = RemoteRole.fromSeed((await join(api))!,
+        api: api, releaseInput: () async {});
+    final old = role.sessionId;
+    await role.suspend();
+    final pending = role.reconnect();
+    await started.future;
+    await role.suspend();
+    final shouldCancel =
+        expectLater(pending, throwsA(isA<RemoteJoinCancelled>()));
+    deliver.complete();
+    await shouldCancel;
+    expect(role.sessionId, old);
+    expect(ended.last, endsWith('/$id/end'));
+    expect(beats, isEmpty);
+    expect(role.viewOnly, true);
+    await role.reconnect();
+    expect(role.sessionId, id);
+    expect(role.viewOnly, false);
+    expect(beats.single, endsWith('/$id/heartbeat'));
+    await role.end();
+  });
+}
diff --git a/flutter/test/steaddesk/role_event_relay_test.dart b/flutter/test/steaddesk/role_event_relay_test.dart
