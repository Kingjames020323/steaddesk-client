 pub fn main_set_peer_option_sync(id: String, key: String, value: String) -> SyncReturn<bool> {
+    // This BRIDGED synchronous command takes a live window UUID, not a peer ID.
+    // Consume the reserved key even for invalid input: never persist role state.
+    if key == "steaddesk-session-clipboard-viewer" {
