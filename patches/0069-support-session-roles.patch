+Map<String, dynamic> snapshot(
+        {String? me,
+        String? owner,
+        bool otherLive = false,
+        int version = 1,
+        String? vacancy}) =>
+    {
+      'device_id': peer,
+      'version': version,
+      'operator_session_id': owner,
+      'heartbeat_seconds': 5,
+      'predecessor_session_id': vacancy == null ? null : other,
+      'vacancy_reason': vacancy,
+      'predecessor_unconfirmed': vacancy == 'lease_expired',
+      'fixed_actions_available': !(otherLive && me != null),
+      'sessions': [
+        if (otherLive)
+          {'session_id': other, 'operator_username': 'A', 'state': 'connected'},
+        if (me != null)
+          {'session_id': me, 'operator_username': 'B', 'state': 'connected'},
+      ],
+    };
+typedef Json = Map<String, dynamic>;
+
+class Api implements HealthApi {
+  final Future<Json> Function(String, String, Json?) call;
+  final Stream<String>? events;
+  Api(this.call, {this.events});
+  @override
+  Future<Json> request(String m, String path, [Json? body]) =>
+      call(m, path, body);
+  @override
+  Stream<String> changes() => events ?? const Stream.empty();
+  @override
+  void close() {}
+}
+
+Future<Json?> join(HealthApi api, [Future<bool> Function(String)? confirm]) =>
+    RemoteRole.prepare(
+        api: api,
+        device: peer,
+        staffPeer: '987654322',
+        confirm: confirm ?? (_) => throw StateError('unexpected confirm'));
+
+class _NativeHttp extends HttpOverrides {}
+
+void loopbackTest(String name, Future<void> Function() run) {
+  test(name, () => HttpOverrides.runWithHttpOverrides(run, _NativeHttp()));
+}
