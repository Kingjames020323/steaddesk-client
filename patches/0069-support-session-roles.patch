@@ -0,0 +1,39 @@
+// Runtime state owned by one login. It is deliberately absent from PeerConfig.
+#[derive(Default)]
+pub(crate) struct ClipboardRole {
+    viewer: bool,
+}
+
+impl ClipboardRole {
+    pub(crate) fn set(&mut self, value: &str) -> bool {
+        match value {
+            "Y" => self.viewer = true,
+            "N" => self.viewer = false,
+            _ => return false,
+        }
+        true
+    }
+
+    pub(crate) fn allows_outgoing(&self) -> bool {
+        !self.viewer
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn viewer_cannot_send_until_promoted_and_other_logins_stay_independent() {
+        let mut first = ClipboardRole::default();
+        let second = ClipboardRole::default();
+        assert!(first.allows_outgoing());
+        assert!(first.set("Y"));
+        assert!(!first.allows_outgoing());
+        assert!(!first.set(""));
+        assert!(!first.allows_outgoing());
+        assert!(second.allows_outgoing());
+        assert!(first.set("N"));
+        assert!(first.allows_outgoing());
+    }
+}
