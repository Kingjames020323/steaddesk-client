+import 'package:flutter_hbb/steaddesk/toolbar/host.dart';
+import 'package:flutter_hbb/steaddesk/fixed/protocol.dart';
+import 'package:flutter_hbb/steaddesk/fixed_build.dart';
+
+class _Role extends ChangeNotifier implements RemoteRole {
+  bool viewOnly = true, busy = false, canClaim = false;
+  String? operatorName = 'A';
+  String claimLabel = '接管', claimPrompt = 'A 已离开，要接管吗？';
+  final watchers = <String, String>{};
+  int claims = 0;
+  String? transferredTo;
+  Future<void> claim() async {
+    claims++;
+  }
+
+  Future<void> handOver(String target) async {
+    transferredTo = target;
+  }
+
+  @override
+  dynamic noSuchMethod(Invocation call) => super.noSuchMethod(call);
+}
+
+class _Client extends Fake implements FFI {
+  final remoteRole = _Role();
+  final sessionId = SessionID('00000000-0000-4000-8000-000000000001');
+  final closed = false;
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  test(
+      'viewer input cannot reach uninitialized native transport before first frame',
+      () async {
+    final ffi = _Client();
+    final input = InputModel(WeakReference<FFI>(ffi));
+    expect(input.keyboardPerm, isFalse);
+    expect(input.osInputCurrent(input.osInputTicket), isFalse);
+    input.handleKeyEvent(const KeyDownEvent(
+        timeStamp: Duration.zero,
+        physicalKey: PhysicalKeyboardKey.keyA,
+        logicalKey: LogicalKeyboardKey.keyA));
+    input.newKeyboardMode('a', 4, true, false);
+    input.inputRawKey('a', 65, 30, true, false);
+    await input.sendMouse('down', MouseButtons.left);
+    input.handlePointerEvent('touch', 'pan_start', Offset.zero);
+    input.onPointerSignalImage(
+        const PointerScrollEvent(scrollDelta: Offset(0, 8)));
+    await input.scroll(1);
+    expect(input.setRelativeMouseMode(true), isFalse);
+    expect(input.handleMouse({}, Offset.zero), isNull);
+    input.enterOrLeave(true);
+  });
+
+  testWidgets(
+      'viewer sees operator, expired vacancy requires affirmative confirmation',
+      (t) async {
+    final role = _Role();
+    await t.pumpWidget(MaterialApp(home: Scaffold(body: RoleHeader(role))));
+    expect(find.text('只看模式 · A正在操作'), findsOneWidget);
+    role.operatorName = null;
+    role.canClaim = true;
+    role.claimLabel = '仍要接管';
+    role.claimPrompt = 'A 失去联系，可能仍在操作。确认要接管吗？';
+    role.notifyListeners();
+    await t.pump();
+    await t.tap(find.text('仍要接管'));
+    await t.pumpAndSettle();
+    expect(find.text(role.claimPrompt), findsOneWidget);
+    expect(role.claims, 0);
+    await t.tap(find.text('取消'));
+    await t.pumpAndSettle();
+    expect(role.claims, 0);
+    await t.tap(find.text('仍要接管'));
+    await t.pumpAndSettle();
+    await t.tap(find.descendant(
+        of: find.byType(AlertDialog), matching: find.text('仍要接管')));
+    await t.pumpAndSettle();
+    expect(role.claims, 1);
+    role.viewOnly = false;
+    role.watchers['second'] = 'B';
+    role.notifyListeners();
+    await t.pump();
+    await t.tap(find.text('转交操作权'));
+    expect(role.transferredTo, 'second');
+  });
+
+  test(
+      'watcher retains screenshot, multi-session fixed actions explain disablement',
+      () {
+    final items = toolbarMenuEntries(() => true, 'Android', [],
+            viewing: true, multiple: true)
+        .whereType<PopupMenuItem<Object>>();
+    if (readToolbarEnabled) {
+      expect(
+          items.singleWhere((i) => i.value == ToolbarAction.screenshot).enabled,
+          isTrue);
+      for (final a in [ToolbarAction.quick, ToolbarAction.logs]) {
+        final i = items.singleWhere((e) => e.value == a);
+        expect(i.enabled, isFalse);
+        expect((i.child as Text).data, contains('只看模式'));
+      }
+    }
+    if (fixedSupportEnabled) {
+      final fixed = items.where((i) => i.value is FixedAction);
+      expect(fixed.length, FixedAction.values.length);
+      for (final i in fixed) {
+        expect(i.enabled, isFalse);
+        expect((i.child as Text).data, contains('多人同时在线'));
+      }
+    }
+  });
+}
