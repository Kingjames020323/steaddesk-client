+class RoleHeader extends StatelessWidget {
+  final RemoteRole role;
+  const RoleHeader(this.role, {super.key});
+
+  Future<void> _submit(
+      BuildContext context, Future<void> Function() action) async {
+    try {
+      await action();
+    } catch (_) {
+      if (context.mounted) {
+        ScaffoldMessenger.maybeOf(context)?.showSnackBar(
+            const SnackBar(content: Text('操作权变更未确认，请核对最新会话状态。')));
+      }
+    }
+  }
+
+  Future<void> _confirmClaim(BuildContext context) async {
+    final prompt = role.claimPrompt;
+    final label = role.claimLabel;
+    final accepted = await showDialog<bool>(
+        context: context,
+        builder: (dialog) => AlertDialog(content: Text(prompt), actions: [
+              TextButton(
+                  onPressed: () => Navigator.pop(dialog, false),
+                  child: const Text('取消')),
+              TextButton(
+                  onPressed: () => Navigator.pop(dialog, true),
+                  child: Text(label)),
+            ]));
+    if (accepted == true &&
+        context.mounted &&
+        !role.busy &&
+        role.canClaim &&
+        role.claimPrompt == prompt) {
+      await _submit(context, role.claim);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => AnimatedBuilder(
+      animation: role,
+      builder: (context, _) {
+        final viewers = role.watchers;
+        Widget label(String text) => Tooltip(
+            message: text,
+            child: ConstrainedBox(
+                constraints: BoxConstraints(
+                    maxWidth: (MediaQuery.sizeOf(context).width * .2)
+                        .clamp(80.0, 240.0)
+                        .toDouble()),
+                child:
+                    Text(text, maxLines: 1, overflow: TextOverflow.ellipsis)));
+
+        if (role.viewOnly) {
+          final owner = role.operatorName;
+          return Row(mainAxisSize: MainAxisSize.min, children: [
+            label(owner == null ? '只看模式' : '只看模式 · ${owner}正在操作'),
+            if (role.canClaim)
+              TextButton(
+                  onPressed: role.busy ? null : () => _confirmClaim(context),
+                  child: Text(role.claimLabel)),
+          ]);
+        }
+        if (viewers.isEmpty) return const SizedBox.shrink();
+        return Row(mainAxisSize: MainAxisSize.min, children: [
+          label(viewers.length == 1
+              ? '${viewers.values.single} 正在观看'
+              : '${viewers.values.first} 等 ${viewers.length} 人正在观看'),
+          if (viewers.length == 1)
+            TextButton(
+                onPressed: role.busy
+                    ? null
+                    : () => _submit(
+                        context, () => role.handOver(viewers.keys.single)),
+                child: const Text('转交操作权'))
+          else
+            PopupMenuButton<String>(
+                enabled: !role.busy,
+                tooltip: '转交操作权',
+                child: const Padding(
+                    padding: EdgeInsets.all(8), child: Text('转交操作权 ▾')),
+                itemBuilder: (_) => [
+                      for (final viewer in viewers.entries)
+                        PopupMenuItem(
+                            value: viewer.key,
+                            child: Text(viewer.value,
+                                maxLines: 1, overflow: TextOverflow.ellipsis))
+                    ],
+                onSelected: (target) =>
+                    _submit(context, () => role.handOver(target))),
+        ]);
+      });
+}
