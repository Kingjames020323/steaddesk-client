+import 'dart:async';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/role_input.dart';
+
+void main() {
+  test(
+      'promotion reacquires existing hover only after physical input is neutral',
+      () {
+    final promotion = RoleInputPromotion()..waiting = true;
+    expect(promotion.acquire(wantsInput: true, held: true), isFalse);
+    expect(promotion.waiting, isTrue);
+    expect(promotion.acquire(wantsInput: false, held: false), isFalse);
+    expect(promotion.acquire(wantsInput: true, held: false), isTrue);
+    expect(promotion.waiting, isFalse);
+    expect(promotion.acquire(wantsInput: true, held: false), isFalse);
+  });
+  test('demotion blocks new input while releasing only outstanding presses',
+      () async {
+    final keys = RolePressedInputs();
+    final held = Completer<void>();
+    final events = <String>[];
+    keys.track('key:a', true, () async => events.add('a up'));
+    keys.track('key:a', false, () async {});
+    keys.track('key:b', true, () async {
+      await held.future;
+      events.add('b up');
+    });
+    keys.track('mouse:left', true, () async => events.add('left up'));
+    final releasing = keys.release();
+    expect(keys.releasing, isTrue);
+    held.complete();
+    await releasing;
+    expect(events, unorderedEquals(['b up', 'left up']));
+    await keys.release();
+    expect(events.length, 2);
+  });
+}
diff --git a/flutter/test/steaddesk/role_launch_test.dart b/flutter/test/steaddesk/role_launch_test.dart
