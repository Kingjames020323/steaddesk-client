+import 'dart:async';
+import 'dart:convert';
+
+import 'package:crypto/crypto.dart';
+import 'package:desktop_multi_window/desktop_multi_window.dart';
+import '../consts.dart' show kMainWindowId;
+import 'role_event_relay.dart';
+import 'package:flutter/material.dart';
+
+import '../models/platform_model.dart' show bind;
+import 'ops_groups.dart' show opsEndpoint;
+import 'ops_health.dart';
+import 'remote_role.dart';
+
+String _token() => bind.mainGetLocalOption(key: 'access_token');
+String _identity(String token) => sha256.convert(utf8.encode(token)).toString();
+
+/// Keep credentials local to each Flutter engine. Authenticate only against
+/// the configured ops origin and never put the bearer in a window message.
+class RoleBinding extends OpsHealthHttp {
+  final String token;
+  final Uri origin;
+  RoleBinding(this.origin, this.token) : super(origin, token);
+
+  bool get current => token.isNotEmpty && token == _token();
+
+  Future<void> _check() async {
+    if (!current ||
+        opsEndpoint(Uri.parse(await bind.mainGetApiServer())) != origin ||
+        !current) {
+      throw const HealthFailure(401);
+    }
+  }
+
+  @override
+  Future<Map<String, dynamic>> request(String method, String route,
+      [Map<String, dynamic>? body]) async {
+    await _check();
+    return super.request(method, route, body);
+  }
+
+  static final events = RoleEventClient((message) =>
+      DesktopMultiWindow.invokeMethod(kMainWindowId, roleFeedMethod, message));
+  static final host = RoleEventHost(
+    auth: (origin, identity) async {
+      final configured = opsEndpoint(Uri.parse(await bind.mainGetApiServer()));
+      final t = _token();
+      return configured.toString() == origin &&
+          t.isNotEmpty &&
+          _identity(t) == identity;
+    },
+    open: (origin, identity) {
+      final t = _token();
+      if (t.isEmpty || _identity(t) != identity) throw const HealthFailure(401);
+      return OpsHealthHttp(Uri.parse(origin), t);
+    },
+    deliver: (window, subscription, event) async =>
+        await DesktopMultiWindow.invokeMethod(window, roleFeedEvent,
+            {'subscription': subscription, 'event': event}) ==
+        true,
+  );
+
+  @override
+  Stream<String> changes() async* {
+    await _check();
+    yield* events.listen(origin.toString(), _identity(token));
+  }
+
+  static Future<Map<String, dynamic>?> prepare(
+      BuildContext? context, String device) async {
+    final token = _token();
+    if (token.isEmpty || !RegExp(r'^[0-9]{9,10}$').hasMatch(device))
+      return null;
+    final Uri origin;
+    try {
+      origin = opsEndpoint(Uri.parse(
+          await bind.mainGetApiServer().timeout(const Duration(seconds: 2))));
+    } on TimeoutException {
+      return null;
+    } on ArgumentError {
+      return null;
+    } on FormatException {
+      return null;
+    }
+    final api = RoleBinding(origin, token);
+    try {
+      final seed = await RemoteRole.prepare(
+          api: api,
+          device: device,
+          resolveStaffPeer: () => bind.mainGetMyId(),
+          confirm: (name) async {
+            if (context == null || !context.mounted || !api.current)
+              return false;
+            return await showDialog<bool>(
+                  context: context,
+                  builder: (dialog) => AlertDialog(
+                    content:
+                        Text('${name}正在远程这台设备。仍要连接将只能观看，${name}可以把操作权转交给你。'),
+                    actions: [
+                      TextButton(
+                          onPressed: () => Navigator.pop(dialog, false),
+                          child: const Text('取消')),
+                      TextButton(
+                          onPressed: () => Navigator.pop(dialog, true),
+                          child: const Text('仍要连接（只看）')),
+                    ],
+                  ),
+                ) ==
+                true;
+          });
+      if (seed == null) return null;
+      if (!api.current) throw const HealthFailure(401);
+      return {
+        ...seed,
+        'origin': origin.toString(),
+        'identity': _identity(token)
+      };
+    } finally {
+      api.close();
+    }
+  }
+
+  static RemoteRole attach(
+      Map<String, dynamic> seed, Future<void> Function() release) {
+    final token = _token();
+    final uri = opsEndpoint(Uri.parse(seed['origin'] as String));
+    final api = RoleBinding(uri, token);
+    final identity = seed['identity'];
+    if (token.isEmpty || identity != _identity(token)) {
+      api.close();
+      throw const HealthFailure(401);
+    }
+    return RemoteRole.fromSeed(seed,
+        api: api, releaseInput: release, isCurrent: () => api.current);
