+        json['fixed_actions_available'] is! bool ||
+        json['predecessor_unconfirmed'] is! bool) {
+      throw const FormatException('会话快照无效。');
+    }
+    for (final row in json['sessions'] as List) {
+      if (row is! Map ||
+          row['session_id'] is! String ||
+          !Uuid.isValidUUID(fromString: row['session_id']) ||
+          row['operator_username'] is! String ||
+          (row['operator_username'] as String).trim().isEmpty ||
+          !{'connected', 'connecting'}.contains(row['state']) ||
+          names.containsKey(row['session_id'])) {
+        throw const FormatException('会话成员无效。');
+      }
+      names[row['session_id']] = row['operator_username'];
+      if (row['state'] == 'connected') connected.add(row['session_id']);
+    }
+    if (json['operator_session_id'] != null &&
+        !names.containsKey(json['operator_session_id'])) {
+      throw const FormatException('快照中的操作者无效。');
+    }
+  }
+
+  final _Json json;
+  final names = <String, String>{};
+  final connected = <String>{};
+  int get version => json['version'];
+  int get heartbeat => json['heartbeat_seconds'];
+  String? get operatorId => json['operator_session_id'];
+}
+
+class RemoteRole extends ChangeNotifier {
+  RemoteRole.fromSeed(
+    Map<String, dynamic> seed, {
+    required HealthApi api,
+    required Future<void> Function() releaseInput,
+    bool Function()? isCurrent,
+  })  : _api = api,
+        _release = releaseInput,
+        _isCurrent = isCurrent ?? _always,
+        device = seed['device_id'],
+        _id = seed['session_id'],
+        _staffPeer = seed['staff_peer_id'],
+        _instance = seed['client_instance_id'],
+        _toolbarId = seed['toolbar_session_id'],
+        _snapshot = _Snapshot(
+            Map<String, dynamic>.from(seed['snapshot']), seed['device_id']) {
+    _knownNames.addAll(_snapshot.names);
+    _everOperated = _snapshot.operatorId == _id;
+  }
+
+  static bool _always() => true;
+  static const _uuid = Uuid();
+  static const _deadline = Duration(seconds: 3);
+  static final _peer = RegExp(r'^[0-9]{9,10}$');
+  static String _route(String device) => 'remote/devices/$device';
+  static Future<_Json> _call(HealthApi api, String method, String path,
+          [_Json? body]) =>
+      api.request(method, path, body).timeout(_deadline);
+
+  static bool _unavailable(Object e) =>
+      e is SocketException ||
+      e is TimeoutException ||
+      e is HandshakeException ||
+      e is HttpException ||
+      (e is HealthFailure &&
+          const {404, 408, 502, 503, 504}.contains(e.status));
+
+  // Once another operator is known, an unavailable API cannot grant control.
+  static Future<Map<String, dynamic>?> prepare({
+    required HealthApi api,
+    required String device,
+    String staffPeer = '',
+    Future<String> Function()? resolveStaffPeer,
+    required Future<bool> Function(String operatorName) confirm,
+  }) async {
+    if (!_peer.hasMatch(device)) return null;
+    late final _Json raw;
+    try {
+      raw = await _call(api, 'GET', '${_route(device)}/sessions');
+    } catch (e) {
+      if (_unavailable(e)) return null;
+      rethrow;
+    }
+    final before = _Snapshot(raw, device);
+    final owner = before.names[before.operatorId];
+    if (owner != null && !await confirm(owner)) {
+      throw const RemoteJoinCancelled();
+    }
+    final peer =
+        resolveStaffPeer == null ? staffPeer : await resolveStaffPeer();
+    return _register(api, device, peer, _uuid.v4(),
+        allowLegacy: owner == null &&
+            before.names.isEmpty &&
+            before.json['predecessor_unconfirmed'] == false);
+  }
+
+  static Future<_Json?> _register(
+      HealthApi api, String device, String peer, String instance,
+      {bool allowLegacy = false}) async {
+    if (!_peer.hasMatch(peer)) throw const FormatException('客服设备号无效。');
+    final id = _uuid.v4(), toolbar = _uuid.v4();
+    final body = <String, dynamic>{
+      'session_id': id,
+      'client_instance_id': instance,
+      'staff_peer_id': peer,
+      'toolbar_session_id': toolbar,
+      'protocol_version': 1,
+    };
+    final path = '${_route(device)}/sessions';
+    late _Json json;
+    try {
+      try {
+        json = await _call(api, 'POST', path, body);
+      } on HealthFailure catch (e) {
+        if (e.status != 400) rethrow;
+        // S1 rejects unknown fields. Keep the same session UUID on the S1 form.
+        json = await _call(
+            api, 'POST', path, {...body}..remove('toolbar_session_id'));
+      }
+    } catch (e) {
+      if (!_unavailable(e)) rethrow;
+      // A transport failure can lose the response after COMMIT. Recover only
+      // our own UUID, and never send a second POST to guess its outcome.
+      try {
+        json = await _call(api, 'GET', path);
+      } catch (probeError) {
+        if (allowLegacy && _unavailable(probeError)) return null;
+        rethrow;
+      }
+      final current = _Snapshot(json, device);
+      if (!current.names.containsKey(id)) {
+        if (allowLegacy &&
+            current.names.isEmpty &&
+            current.json['predecessor_unconfirmed'] == false) return null;
+        rethrow;
+      }
+    }
+    final snapshot = _Snapshot(json, device);
+    if (!snapshot.names.containsKey(id)) throw const FormatException('会话未登记。');
+    return {...body, 'device_id': device, 'snapshot': json};
+  }
+
+  final HealthApi _api;
+  final Future<void> Function() _release;
+  final bool Function() _isCurrent;
+  final String device, _staffPeer, _instance;
+  String _id, _toolbarId;
+  _Snapshot _snapshot;
+  final _knownNames = <String, String>{};
+  bool _started = false, _dead = false, _suspended = false, _acting = false;
+  bool _everOperated = false, _linked = false, _transferring = false;
+  int? _holdVersion;
+  int _generation = 0;
+  int _transportRound = 0, _renewingRound = 0;
+  bool _refreshing = false, _refreshAgain = false, _beating = false;
+  Timer? _heartbeat, _poll, _sseRetry;
+  StreamSubscription<String>? _events;
+  Future<void>? _ending, _retiring, _renewing;
+  _Json? _handoverNote;
+
+  String get sessionId => _id;
+  String get toolbarSessionId => _toolbarId;
+  bool get everOperated => _everOperated;
+  bool get viewOnly =>
+      _dead ||
+      _suspended ||
+      _holdVersion != null ||
+      _transferring ||
+      !_isCurrent() ||
+      _snapshot.operatorId != _id;
+  bool get busy => _dead || _acting || _suspended;
+  bool get multipleSessions =>
+      _snapshot.json['fixed_actions_available'] == false;
+  String? get operatorName => _snapshot.names[_snapshot.operatorId];
+  Map<String, String> get watchers =>
+      Map.unmodifiable(Map.of(_snapshot.names)..remove(_snapshot.operatorId));
+  bool get canClaim =>
+      !busy &&
+      _isCurrent() &&
+      _snapshot.operatorId == null &&
+      _snapshot.connected.contains(_id);
+  bool get _uncertain => _snapshot.json['predecessor_unconfirmed'] == true;
+  String get claimLabel => _uncertain ? '仍要接管' : '接管';
+  String get claimPrompt {
+    final name = _knownNames[_snapshot.json['predecessor_session_id']] ??
+        (_snapshot.json['predecessor_username'] as String?) ??
+        '上一位客服';
+    return _uncertain ? '$name失去联系，可能仍在操作。确认要接管吗？' : '$name已离开，要接管吗？';
+  }
+
+  // An authoritative receipt also recovers a lost handover response. Ignore
+  // receipts belonging only to another window of the same signed-in account.
+  List<Map<String, dynamic>> get handoverNotes {
+    final notes = <int, Map<String, dynamic>>{};
+    final immediate = _handoverNote;
+    if (immediate != null) notes[immediate['audit_id'] as int] = immediate;
+    final rows = _snapshot.json['handover_receipts'];
+    if (rows is List) {
+      for (final row in rows) {
+        if (row is! Map ||
+            (row['from_session'] != _id && row['to_session'] != _id)) continue;
+        final id = row['audit_id'],
+            from = row['from_name'],
+            to = row['to_name'];
+        final at = DateTime.tryParse(row['at']?.toString() ?? '')?.toLocal();
+        if (id is! int ||
+            id <= 0 ||
+            from is! String ||
+            to is! String ||
+            at == null) continue;
+        notes[id] = _receiptNote(id, at, from, to);
+      }
+    }
+    final ids = notes.keys.toList()..sort();
+    return [for (final id in ids) notes[id]!];
+  }
+
+  static _Json _receiptNote(int id, DateTime local, String from, String to) {
+    String two(int n) => n.toString().padLeft(2, '0');
+    return {
+      'audit_id': id,
+      'text': '[${two(local.hour)}:${two(local.minute)}] $from 将操作权转交给 $to'
+    };
+  }
+
+  String get _path => _route(device);
+  bool _valid(int gen) =>
+      !_dead && !_suspended && gen == _generation && _isCurrent();
+
+  void start() {
+    if (_started || _dead) return;
+    _started = true;
+    _schedule();
+    _listen();
+  }
+
+  void _schedule() {
+    _heartbeat?.cancel();
+    _heartbeat = Timer.periodic(Duration(seconds: _snapshot.heartbeat), (_) {
+      unawaited(_beat().catchError((Object _) {}));
+    });
+  }
+
+  void _fallbackPoll() {
+    _poll ??= Timer.periodic(const Duration(seconds: 3), (_) => _safeRefresh());
+  }
+
+  void _safeRefresh() => unawaited(refresh().catchError((Object _) {}));
+  void _listen() {
+    if (_dead || _suspended) return;
+    _fallbackPoll();
+    final gen = _generation;
+    final subscription = _api.changes().listen((event) {
+      if (!_valid(gen)) return;
+      if (event == 'connected') {
+        _poll?.cancel();
+        _poll = null;
+      }
+      if (event == 'remote.session.changed' || event == 'connected') {
+        _safeRefresh();
+      }
+    }, onError: (Object error) {
+      if (!_valid(gen)) return;
+      _fallbackPoll();
+      if (error is HealthFailure &&
+          (error.status == 401 || error.status == 403)) {
+        unawaited(_revoke());
+      }
+    }, onDone: () {
+      if (!_valid(gen)) return;
+      _fallbackPoll();
+      _sseRetry = Timer(const Duration(seconds: 5), _listen);
+    });
+    _events = subscription;
+  }
+
+  Future<void> _lock() async {
+    if (_dead ||
+        _suspended ||
+        _holdVersion != null ||
+        _snapshot.operatorId != _id) return;
+    // Invoke release synchronously while the old role can still send UP.
+    // Set the fence before awaiting its completion or sending any write.
+    late Future<void> pending;
+    try {
+      pending = _release();
+    } finally {
+      _holdVersion = _snapshot.version;
+      notifyListeners();
+    }
+    await pending;
+  }
+
+  Future<void> _revoke() async {
+    if (_dead || _suspended) return;
+    await _lock();
+    if (_dead) return;
+    _suspended = true;
+    _generation++;
+    _stop();
+    notifyListeners();
+  }
+
+  Future<void> _apply(_Json json, int gen) async {
+    if (!_valid(gen)) return;
+    final next = _Snapshot(json, device);
+    if (next.version < _snapshot.version) return;
+    if (!next.names.containsKey(_id)) {
+      await _revoke();
+      return;
+    }
+    if (!viewOnly && next.operatorId != _id) await _lock();
+    if (!_valid(gen) || next.version < _snapshot.version) return;
+    final cadence = next.heartbeat != _snapshot.heartbeat;
+    _snapshot = next;
+    _knownNames.addAll(next.names);
+    if (_holdVersion != null && next.version > _holdVersion!) {
+      _holdVersion = null;
+    }
+    if (!viewOnly) _everOperated = true;
+    if (_started && cadence) _schedule();
+    notifyListeners();
+  }
+
+  Future<void> _error(Object error, int gen) async {
+    if (!_valid(gen)) return;
+    if (error is HealthFailure &&
+        (error.status == 401 || error.status == 403)) {
+      await _revoke();
+    }
+  }
+
+  Future<void> refresh() async {
+    if (_refreshing) {
+      _refreshAgain = true;
+      return;
+    }
+    if (_dead || _suspended) return;
+    final gen = _generation;
+    if (!_isCurrent()) {
+      await _revoke();
+      return;
+    }
+    _refreshing = true;
+    try {
+      do {
+        _refreshAgain = false;
+        await _apply(await _call(_api, 'GET', '$_path/sessions'), gen);
+      } while (_refreshAgain && _valid(gen));
+    } catch (e) {
+      await _error(e, gen);
+      rethrow;
+    } finally {
+      _refreshing = false;
+    }
+  }
+
+  Future<void> connected() async {
+    _linked = true;
+    await _beat();
+  }
+
+  Future<void> _beat() async {
+    if (_beating || _dead || _suspended) return;
+    if (!_isCurrent()) {
+      await _revoke();
+      return;
+    }
+    final gen = _generation;
+    _beating = true;
+    try {
+      await _apply(
+          await _call(_api, 'POST', '$_path/sessions/$_id/heartbeat', {
+            if (_linked) 'state': 'connected',
+          }),
+          gen);
+    } on HealthFailure catch (e) {
+      if (e.status == 409 && _valid(gen)) {
+        await _lock();
+        await refresh();
+      } else {
+        await _error(e, gen);
+        rethrow;
+      }
+    } finally {
+      _beating = false;
+    }
+  }
+
+  Future<void> handOver(String target) async {
+    if (viewOnly ||
+        busy ||
+        !_snapshot.connected.contains(target) ||
+        target == _id) return;
+    final gen = _generation, version = _snapshot.version;
+    final from = _snapshot.names[_id]!, to = _snapshot.names[target]!;
+    _acting = true;
+    try {
+      final released = _lock();
+      _transferring = true;
+      await released;
+      if (!_valid(gen)) return;
+      final result = await _call(_api, 'POST', '$_path/handover', {
+        'from_session': _id,
+        'to_session': target,
+        'expected_version': version
+      });
+      if (!_valid(gen)) return;
+      final audit = result['audit_id'];
+      if (audit is int &&
+          audit > 0 &&
+          result['operator_session_id'] == target) {
+        _handoverNote = _receiptNote(audit, DateTime.now(), from, to);
+      }
+      await _apply(result, gen);
+    } catch (e) {
+      if (_valid(gen)) {
+        await _error(e, gen);
+        try {
+          await refresh();
+        } catch (_) {}
+      }
+      if (e is! HealthFailure || e.status != 409) rethrow;
+    } finally {
+      _transferring = false;
+      _acting = false;
+      if (!_dead) notifyListeners();
+    }
+  }
+
+  Future<void> claim() async {
+    if (!canClaim) return;
+    final gen = _generation;
+    _acting = true;
+    notifyListeners();
+    try {
+      await _apply(
+          await _call(_api, 'POST', '$_path/claim',
+              {'session_id': _id, 'expected_version': _snapshot.version}),
+          gen);
+    } on HealthFailure catch (e) {
+      if (e.status == 409 && _valid(gen)) {
+        await refresh();
+      } else {
+        await _error(e, gen);
+        rethrow;
+      }
+    } finally {
+      _acting = false;
+      if (!_dead) notifyListeners();
+    }
+  }
+
+  void _stop() {
+    _heartbeat?.cancel();
+    _poll?.cancel();
+    _sseRetry?.cancel();
+    _heartbeat = null;
+    _poll = null;
+    _sseRetry = null;
+    unawaited(_events?.cancel());
+    _events = null;
+  }
+
+  Future<void> _endId(String id) async {
+    if (!_isCurrent()) return;
+    try {
+      await _call(_api, 'POST', '$_path/sessions/$id/end', {});
+    } catch (_) {
+      // The server settles the lease even if the last request is lost.
+    }
+  }
+
+  Future<void> suspend() {
+    // This native disconnect also invalidates a registration already in flight
+    // after retirement of the previous UUID. Its late receipt must be ended.
+    _transportRound++;
+    return _retiring ??= _suspend();
+  }
+
+  Future<void> _suspend() async {
+    if (_dead || _suspended) return;
+    final release = _lock();
+    _generation++;
+    _suspended = true;
+    _stop();
+    notifyListeners();
+    try {
+      await release;
+    } finally {
+      await _endId(_id);
+    }
+  }
+
+  Future<void> reconnect() {
+    if (_dead) return Future.error(const RemoteJoinCancelled());
+    final round = _transportRound;
+    final pending = _renewing;
+    if (pending != null) {
+      if (_renewingRound == round) return pending;
+      // Only one registration in flight. The old round retires its own UUID
+      // before the newly authenticated transport requests another.
+      return pending.catchError((Object _) {}).then((_) {
+        if (_dead || round != _transportRound)
+          throw const RemoteJoinCancelled();
+        return reconnect();
+      });
+    }
+    _renewingRound = round;
+    return _renewing = _reconnect(round).whenComplete(() => _renewing = null);
+  }
+
+  Future<void> _reconnect(int round) async {
+    await (_retiring ??= _suspend());
+    if (_dead || round != _transportRound || !_isCurrent())
+      throw const RemoteJoinCancelled();
+    final gen = _generation;
+    final seed = (await _register(_api, device, _staffPeer, _instance))!;
+    if (_dead ||
+        gen != _generation ||
+        round != _transportRound ||
+        !_isCurrent()) {
+      await _endId(seed['session_id']);
+      throw const RemoteJoinCancelled();
+    }
+    _id = seed['session_id'];
+    _toolbarId = seed['toolbar_session_id'];
+    _snapshot = _Snapshot(seed['snapshot'], device);
+    _knownNames.addAll(_snapshot.names);
+    _suspended = false;
+    _holdVersion = null;
+    _retiring = null;
+    _linked = true;
+    _everOperated = !viewOnly;
+    _handoverNote = null;
+    _started = false;
+    start();
+    notifyListeners();
+    try {
+      await connected();
+    } catch (error) {
+      // Registration already returned the role. Keep its case round and
+      // periodically retry "connected" on a lost initial heartbeat.
+      if (!_unavailable(error)) rethrow;
+    }
+  }
+
+  Future<void> end() => _ending ??= _end();
+  Future<void> _end() async {
+    final alreadyRetiring = _retiring;
+    _dead = true;
+    _generation++;
+    _stop();
+    notifyListeners();
+    try {
+      if (alreadyRetiring != null) {
+        await alreadyRetiring;
+      } else {
+        await _endId(_id);
+      }
+      final registering = _renewing;
+      if (registering != null) {
+        try {
+          await registering;
+        } catch (_) {/* the round was closed */}
+      }
+    } finally {
+      _api.close();
+    }
+  }
+}
