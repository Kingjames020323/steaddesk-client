diff --git a/flutter/lib/steaddesk/role_event_relay.dart b/flutter/lib/steaddesk/role_event_relay.dart
new file mode 100644
index 0000000..d5024cb
--- /dev/null
+++ b/flutter/lib/steaddesk/role_event_relay.dart
@@ -0,0 +1,158 @@
+import 'dart:async';
+import 'package:uuid/uuid.dart';
+import 'ops_health.dart';
+
+const roleFeedMethod = 'steaddesk.role.feed';
+const roleFeedEvent = 'steaddesk.role.hint';
+
+/// The main engine attaches subscribers to its existing identity-scoped SSE
+/// pool. Window IDs come from the native IPC envelope, never from the payload.
+class RoleEventHost {
+  final Future<bool> Function(String, String) auth;
+  final HealthApi Function(String, String) open;
+  final Future<bool> Function(int, String, String) deliver;
+  final Duration lease;
+  final _subscriptions = <(int, String), _HostSubscription>{};
+  RoleEventHost(
+      {required this.auth,
+      required this.open,
+      required this.deliver,
+      this.lease = const Duration(seconds: 18)});
+
+  Future<String> handle(int window, String action, Map message) async {
+    final id = message['subscription'],
+        origin = message['origin'],
+        identity = message['identity'];
+    if (window <= 0 ||
+        id is! String ||
+        id.isEmpty ||
+        id.length > 64 ||
+        origin is! String ||
+        identity is! String) return 'denied';
+    final key = (window, id);
+    void drop(_HostSubscription entry) {
+      if (identical(_subscriptions[key], entry)) _subscriptions.remove(key);
+      entry.close();
+    }
+
+    final previous = _subscriptions[key];
+    if (action == 'close') {
+      if (previous != null) drop(previous);
+      return 'ok';
+    }
+    if (action != 'open' && action != 'renew') return 'denied';
+    if (previous != null &&
+        (previous.origin != origin || previous.identity != identity))
+      return 'denied';
+    if (!await auth(origin, identity)) {
+      if (previous != null) drop(previous);
+      return 'denied';
+    }
+    if (previous != null && identical(_subscriptions[key], previous)) {
+      previous.renew(lease, () => drop(previous));
+      return 'ok';
+    }
+    if (action == 'renew') return 'gone';
+
+    final entry = _HostSubscription(origin, identity, open(origin, identity));
+    _subscriptions[key] = entry;
+    entry.renew(lease, () => drop(entry));
+    Future<void> send(String event) async {
+      if (!identical(_subscriptions[key], entry)) return;
+      try {
+        if (!await auth(origin, identity)) event = 'denied';
+        if (!identical(_subscriptions[key], entry)) return;
+        final alive = await deliver(window, id, event)
+            .timeout(const Duration(seconds: 3));
+        if (!alive || event == 'gone' || event == 'denied') drop(entry);
+      } catch (_) {
+        drop(entry);
+      }
+    }
+
+    entry.stream = entry.api.changes().listen((event) {
+      if (event == 'connected' || event == 'remote.session.changed')
+        unawaited(send(event));
+    },
+        onError: (Object e) => unawaited(send(
+            e is HealthFailure && (e.status == 401 || e.status == 403)
+                ? 'denied'
+                : 'gone')),
+        onDone: () => unawaited(send('gone')));
+    return 'ok';
+  }
+
+  void dispose() {
+    for (final sub in _subscriptions.values) {
+      sub.close();
+    }
+    _subscriptions.clear();
+  }
+}
+
+class _HostSubscription {
+  final String origin, identity;
+  final HealthApi api;
+  Timer? expiry;
+  StreamSubscription<String>? stream;
+  _HostSubscription(this.origin, this.identity, this.api);
+  void renew(Duration lease, void Function() expired) {
+    expiry?.cancel();
+    expiry = Timer(lease, expired);
+  }
+
+  void close() {
+    expiry?.cancel();
+    unawaited(stream?.cancel());
+    stream = null;
+    api.close();
+  }
+}
+
+/// Each child sends only a fingerprint and subscription nonce. If the main
+/// engine vanishes, the control stream closes and 3-second GET polling resumes.
+class RoleEventClient {
+  final Future<dynamic> Function(Map<String, String>) call;
+  final Duration renewEvery;
+  final _sinks = <String, StreamController<String>>{};
+  RoleEventClient(this.call, {this.renewEvery = const Duration(seconds: 6)});
+
+  bool receive(String id, String event) {
+    final sink = _sinks[id];
+    if (sink == null || sink.isClosed) return false;
+    if (event == 'denied') sink.addError(const HealthFailure(401));
+    if (event == 'denied' || event == 'gone') {
+      unawaited(sink.close());
+    } else if (event == 'connected' || event == 'remote.session.changed') {
+      sink.add(event);
+    }
+    return true;
+  }
+
+  Stream<String> listen(String origin, String identity) {
+    final id = const Uuid().v4();
+    final args = {'subscription': id, 'origin': origin, 'identity': identity};
+    late StreamController<String> sink;
+    Timer? timer;
+    Future<void> exchange(String action) async {
+      try {
+        final reply = await call({...args, 'action': action})
+            .timeout(const Duration(seconds: 3));
+        if (reply != 'ok') receive(id, reply == 'denied' ? 'denied' : 'gone');
+      } catch (_) {
+        receive(id, 'gone');
+      }
+    }
+
+    sink = StreamController<String>(onListen: () {
+      _sinks[id] = sink;
+      unawaited(exchange('open'));
+      timer = Timer.periodic(renewEvery, (_) => unawaited(exchange('renew')));
+    }, onCancel: () {
+      timer?.cancel();
+      _sinks.remove(id);
+      unawaited(exchange('close'));
+    });
+    return sink.stream;
+  }
+}
