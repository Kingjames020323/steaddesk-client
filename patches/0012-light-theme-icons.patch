new file mode 100644
index 0000000..313c8dc
--- /dev/null
+++ b/flutter/lib/steaddesk/theme.dart
@@ -0,0 +1,68 @@
+import 'dart:ui' show FontFeature;
+import 'package:flutter/material.dart';
+
+/// Shared light palette and geometry for SteadDesk surfaces.
+class SteadDeskTheme {
+  SteadDeskTheme._();
+
+  static const sea = Color(0xFF1FA7E0);
+  static const action = Color(0xFF0A6FA8);
+  static const actionHover = Color(0xFF085A89);
+  static const selection = Color(0xFFDFF2FA);
+  static const brandSurface = Color(0xFFE6F5FB);
+  static const foam = Color(0xFF34C3A6);
+  static const badgeSurface = Color(0xFFE3F7F1);
+  static const badgeText = Color(0xFF0B7A5E);
+  static const page = Color(0xFFFFFFFF);
+  static const sessionSurface = Color(0xFFEAF4F9);
+  static const heading = Color(0xFF0E3A52);
+  static const glassText = Color(0xFF0B2E42);
+  static const body = Color(0xFF17324A);
+  static const bodyHighContrast = Color(0xFF111827);
+  static const secondaryText = Color(0xFF4B5563);
+  static const divider = Color(0xFFE5E7EB);
+  static const rowDivider = Color(0xFFEEF0F2);
+  static const hover = Color(0xFFF3F4F6);
+  static const online = Color(0xFF16A34A);
+  static const offline = Color(0xFF9CA3AF);
+  static const attention = Color(0xFFD97706);
+  static const attentionText = Color(0xFF92400E);
+  static const danger = Color(0xFFDC2626);
+  static const tabularDigits = [FontFeature.tabularFigures()];
+
+  static const glassRadius = 20.0;
+  static const glassInset = 10.0;
+  static const glassBlur = 28.0;
+  static const glassFill = LinearGradient(
+    begin: Alignment.topLeft,
+    end: Alignment.bottomRight,
+    colors: [Color(0x9EFFFFFF), Color(0x6BFFFFFF)],
+  );
+  static const glassBorder = BorderSide(color: Color(0xC7FFFFFF), width: 1);
+  static const glassShadow = BoxShadow(
+    color: Color(0x240B3C5A),
+    offset: Offset(0, 10),
+    blurRadius: 30,
+  );
+  static const glassGlowColors = [sea, foam, action];
+  static const glassOpaque = Color(0xFFE8F4FA);
+
+  static final button = ButtonStyle(
+    foregroundColor: MaterialStateProperty.resolveWith<Color>((states) {
+      if (states.contains(MaterialState.disabled)) return offline;
+      return states.contains(MaterialState.hovered) ? actionHover : action;
+    }),
+    backgroundColor: const MaterialStatePropertyAll(Colors.transparent),
+    overlayColor: MaterialStateProperty.resolveWith<Color?>((states) {
+      if (states.contains(MaterialState.pressed)) return selection;
+      if (states.contains(MaterialState.focused) ||
+          states.contains(MaterialState.hovered)) return hover;
+      return null;
+    }),
+    elevation: const MaterialStatePropertyAll(0.0),
+    side: const MaterialStatePropertyAll(BorderSide.none),
+    shape: const MaterialStatePropertyAll(RoundedRectangleBorder(
+      borderRadius: BorderRadius.all(Radius.circular(6)),
+    )),
+  );
+}
