@@ -0,0 +1,46 @@
+import 'package:flutter/material.dart';
+
+class OpsGroupTile extends StatelessWidget {
+  final String name;
+  final bool selected, childGroup, pending, admin, online;
+  final VoidCallback onSelect;
+  final ValueChanged<String> onAction;
+
+  const OpsGroupTile(
+      {super.key,
+      required this.name,
+      required this.selected,
+      required this.childGroup,
+      required this.pending,
+      required this.admin,
+      required this.online,
+      required this.onSelect,
+      required this.onAction});
+
+  @override
+  Widget build(BuildContext context) => ListTile(
+      dense: true,
+      contentPadding: EdgeInsets.only(left: childGroup ? 28 : 10, right: 2),
+      selected: selected,
+      title: Text(name, overflow: TextOverflow.ellipsis),
+      subtitle: pending ? const Text('同步中') : null,
+      onTap: onSelect,
+      trailing: PopupMenuButton<String>(
+          tooltip: '分组选项',
+          onSelected: onAction,
+          itemBuilder: (_) => [
+                const PopupMenuItem(value: 'details', child: Text('查看详情')),
+                if (admin)
+                  for (final entry in const {
+                    'edit': '修改分组',
+                    'viewers': '谁能看到',
+                    'devices': '增减设备',
+                    'move': '移动设备',
+                    'delete': '删除分组'
+                  }.entries)
+                    PopupMenuItem(
+                        enabled: online,
+                        value: entry.key,
+                        child: Text(entry.value)),
+              ]));
+}
diff --git a/flutter/lib/steaddesk/ops_groups.dart b/flutter/lib/steaddesk/ops_groups.dart
new file mode 100644
index 0000000..2256e14
--- /dev/null
+++ b/flutter/lib/steaddesk/ops_groups.dart
@@ -0,0 +1,548 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:uuid/uuid.dart';
+
+import 'personal_groups.dart';
+
+class OpsError implements Exception {
+  final int status;
+  final String message;
+  const OpsError(this.status, this.message);
+  @override
+  String toString() => message;
+}
+
+class OpsGroup {
+  final String id, name;
+  final Set<String> deviceIds;
+  final int version;
+  final String? parentId, owner, abGuid;
+  final List<String>? viewers;
+  final bool pending;
+  final DateTime updatedAt;
+
+  OpsGroup._(this.id, this.name, this.deviceIds, this.version, this.parentId,
+      this.owner, this.abGuid, this.viewers, this.pending, this.updatedAt);
+
+  factory OpsGroup.fromJson(Map<String, dynamic> row) => OpsGroup._(
+        row['id'] as String,
+        row['name'] as String,
+        Set.unmodifiable((row['device_ids'] as List).cast<String>()),
+        row['version'] as int,
+        row['parent_id'] as String?,
+        row['owner'] as String?,
+        row['ab_guid'] as String?,
+        row['viewers'] == null
+            ? null
+            : List.unmodifiable((row['viewers'] as List).cast<String>()),
+        row['projection'] == 'pending',
+        DateTime.parse(row['updated_at']).toUtc(),
+      );
+
+  // Only cache fields interpreted by this client; detail responses also contain audit.
+  Map<String, dynamic> toJson() => {
+        'id': id,
+        'name': name,
+        'device_ids': deviceIds.toList(),
+        'version': version,
+        'parent_id': parentId,
+        'owner': owner,
+        'ab_guid': abGuid,
+        'viewers': viewers,
+        'projection': pending ? 'pending' : 'ok',
+        'updated_at': updatedAt.toIso8601String(),
+      };
+}
+
+class OpsGroupStore extends ChangeNotifier {
+  final Uri _base;
+  final String _token;
+  final String account;
+  final File cache;
+  final PersonalGroups local;
+  final Future<void> Function() refreshBooks;
+  final HttpClient _http = HttpClient()
+    ..connectionTimeout = const Duration(seconds: 8)
+    ..findProxy = ((_) => 'DIRECT');
+  final Duration pollInterval, reconnectDelay;
+  OpsGroupStore(
+      {required Uri origin,
+      required String token,
+      required this.account,
+      required this.cache,
+      required this.local,
+      required this.refreshBooks,
+      this.pollInterval = const Duration(minutes: 5),
+      this.reconnectDelay = const Duration(seconds: 1)})
+      : _base = _endpoint(origin),
+        _token = token {
+    if (account.isEmpty || token.isEmpty) throw ArgumentError('Missing login');
+  }
+
+  static Uri _endpoint(Uri origin) {
+    final loopback = origin.host == 'localhost' ||
+        (InternetAddress.tryParse(origin.host)?.isLoopback ?? false);
+    if ((origin.scheme != 'https' && !(origin.scheme == 'http' && loopback)) ||
+        origin.host.isEmpty ||
+        origin.userInfo.isNotEmpty ||
+        origin.hasQuery ||
+        origin.hasFragment ||
+        !{'', '/', '/ops/v1', '/ops/v1/'}.contains(origin.path)) {
+      throw ArgumentError('Invalid ops origin');
+    }
+    return origin.replace(path: '/ops/v1/');
+  }
+
+  List<OpsGroup> _shared = const [], _mine = const [];
+  List<OpsGroup> get shared => _shared;
+  List<OpsGroup> get mine => _mine;
+  DateTime? _serverTime;
+  DateTime? get serverTime => _serverTime;
+  bool _online = false, _ended = false, _disposed = false;
+  bool get online => _online;
+  bool get signedOut => _ended;
+  String? problem;
+  bool get _active => !_ended && !_disposed;
+  static const _expired = OpsError(401, '登录已过期，请重新登录。');
+  static const _unavailable = OpsError(0, '无法连接分组服务，请检查网络后重试。');
+  Future<void>? _start, _refresh, _logout;
+  Future<void> _work = Future.value();
+  Timer? _poll, _retry;
+  int _retries = 0;
+  String? _cursor, _pendingCursor;
+  Timer? _eventTimer;
+  HttpClient? _feed;
+  Future<void>? _eventBatch;
+  bool _closingFeed = false;
+  int _connection = 0;
+  bool _migrated = false;
+
+  // Order replacement and removal across login instances sharing the same file.
+  static final Map<String, Future<void>> _fileWork = {};
+  Future<void> _file(Future<void> Function() action) {
+    final key = cache.absolute.path;
+    final next = (_fileWork[key] ?? Future<void>.value()).then((_) => action());
+    final tail = next.then<void>((_) {}, onError: (Object _) {});
+    _fileWork[key] = tail;
+    tail.then((_) {
+      if (identical(_fileWork[key], tail)) _fileWork.remove(key);
+    });
+    return next;
+  }
+
+  void _check() {
+    if (!_active) throw _expired;
+  }
+
+  Future<T> _queue<T>(Future<T> Function() action) {
+    final next = _work.then((_) {
+      _check();
+      return action();
+    });
+    _work = next.then<void>((_) {}, onError: (Object _) {});
+    return next;
+  }
+
+  static List<OpsGroup> _list(dynamic values) =>
+      List.unmodifiable((values as List)
+          .where((r) => r['deleted'] != true)
+          .map((r) => OpsGroup.fromJson(r as Map<String, dynamic>)));
+
+  Future<void> _load() => _file(() async {
+        if (!_active || !await cache.exists()) return;
+        try {
+          final row = jsonDecode(await cache.readAsString());
+          if (row['origin'] != _base.toString() || row['account'] != account) {
+            return;
+          }
+          final shared = _list(row['shared']), mine = _list(row['mine']);
+          final stamp = DateTime.parse(row['server_time']).toUtc();
+          _check();
+          _shared = shared;
+          _mine = mine;
+          _serverTime = stamp;
+          notifyListeners();
+        } on FormatException {
+          return;
+        } on TypeError {
+          return;
+        }
+      });
+
+  Future<void> _save() => _file(() async {
+        if (!_active) return;
+        final snapshot = jsonEncode({
+          'account': account,
+          'origin': _base.toString(),
+          'shared': _shared,
+          'mine': _mine,
+          'server_time': _serverTime!.toIso8601String()
+        });
+        await cache.parent.create(recursive: true);
+        final tmp = File('${cache.path}.${const Uuid().v4()}.tmp');
+        try {
+          await tmp.writeAsString(snapshot, flush: true);
+          if (_active) await tmp.rename(cache.path);
+        } finally {
+          if (await tmp.exists()) await tmp.delete();
+        }
+      });
+
+  Future<void> start() => _start ??= _begin();
+  Future<void> _begin() async {
+    try {
+      await _load();
+    } on FileSystemException {/* network still available */}
+    if (!_active) return;
+    try {
+      await refresh();
+    } on OpsError {/* cached/offline state is observable */}
+    if (!_active) return;
+    _poll = Timer.periodic(pollInterval, (_) => _backgroundRefresh());
+    unawaited(_events());
+  }
+
+  Future<HttpClientResponse> _open(String method, String route,
+      {Map<String, dynamic>? body,
+      int? version,
+      bool stream = false,
+      HttpClient? client}) async {
+    _check();
+    if (!RegExp(r'^[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)*$').hasMatch(route)) {
+      throw const OpsError(400, '无效的分组地址。');
+    }
+    final req = await (client ?? _http)
+        .openUrl(method, _base.resolve(route))
+        .timeout(const Duration(seconds: 10));
+    _check();
+    req.followRedirects = false;
+    req.headers.set(HttpHeaders.authorizationHeader, 'Bearer $_token');
+    req.headers.set(HttpHeaders.acceptHeader,
+        stream ? 'text/event-stream' : 'application/json');
+    if (stream && _cursor != null) req.headers.set('Last-Event-ID', _cursor!);
+    if (method != 'GET') {
+      req.headers.set('Idempotency-Key', const Uuid().v4());
+      if (version != null) req.headers.set('If-Match', '"$version"');
+      if (body != null) {
+        req.headers.contentType = ContentType.json;
+        final bytes = utf8.encode(jsonEncode(body));
+        req.contentLength = bytes.length;
+        req.add(bytes);
+      } else {
+        req.contentLength = 0;
+      }
+    }
+    final response = await req.close().timeout(const Duration(seconds: 15));
+    _check();
+    if (response.statusCode == 401) {
+      await logout();
+      throw _expired;
+    }
+    return response;
+  }
+
+  static OpsError _error(int status, String text) {
+    switch (status) {
+      case 403:
+        return OpsError(status, '只有管理员可以修改分组。');
+      case 404:
+        return OpsError(status, '这个分组已不存在，或你没有权限查看。');
+      case 409:
+        return OpsError(status, '这个分组刚被别人改过，请查看最新内容后再保存。');
+      case 412:
+        return OpsError(status, '缺少分组版本，请刷新后重试。');
+      case 422:
+        if (text.contains('unknown_device')) {
+          return OpsError(status, '找不到这台设备，请确认它已经完成出货登记。');
+        }
+        if (text.contains('同名') || text.contains('already')) {
+          return OpsError(status, '已有同名分组。');
+        }
+        return OpsError(status, '分组内容不符合要求，请核对名称和设备数量。');
+      case 429:
+        return OpsError(status, '操作太频繁，请稍后再试。');
+      default:
+        return OpsError(
+            status, status >= 500 ? _unavailable.message : '分组请求失败，请检查后重试。');
+    }
+  }
+
+  Future<Map<String, dynamic>> _json(String method, String route,
+      {Map<String, dynamic>? body, int? version}) async {
+    try {
+      final response = await _open(method, route, body: body, version: version);
+      final text = await utf8.decoder
+          .bind(response)
+          .join()
+          .timeout(const Duration(seconds: 15));
+      _check();
+      if (response.statusCode < 200 || response.statusCode >= 300) {
+        throw _error(response.statusCode, text);
+      }
+      return text.isEmpty ? {} : jsonDecode(text) as Map<String, dynamic>;
+    } on OpsError {
+      rethrow;
+    } on Exception {
+      throw _unavailable;
+    } on TypeError {
+      throw _unavailable;
+    }
+  }
+
+  Future<void> _import() async {
+    if (_migrated) return;
+    final groups = await local.list(account);
+    _check();
+    if (groups.isNotEmpty) {
+      final result = await _json('POST', 'me/groups/import', body: {
+        'format': 'steaddesk.my-groups',
+        'format_version': 1,
+        'groups': [
+          for (final group in groups)
+            {
+              'local_id': group.id,
+              'name': group.name,
+              'device_ids': group.devices.toList(),
+              'updated_at': group.updatedAt.toIso8601String(),
+            }
+        ]
+      });
+      final expected = groups.map((g) => g.id).toSet();
+      final mapping = result['mapping'];
+      if (mapping is! List ||
+          !mapping.every((r) =>
+              r is Map &&
+              r['id'] is String &&
+              (r['id'] as String).isNotEmpty &&
+              {'created', 'merged', 'already_imported'}.contains(r['result']) &&
+              expected.remove(r['local_id'])) ||
+          expected.isNotEmpty) {
+        throw const OpsError(0, '迁移回执不完整，已保留本地分组。');
+      }
+      _check();
+      await local.finishImport(account, groups, active: () => _active);
+    }
+    _check();
+    _migrated = (await local.list(account)).isEmpty;
+  }
+
+  Future<void> refresh() => _refresh ??= _queue(_snapshot).whenComplete(() {
+        _refresh = null;
+      });
+
+  Future<void> _snapshot() async {
+    String? issue;
+    try {
+      try {
+        await _import();
+      } on OpsError catch (error) {
+        if (error.status == 401) rethrow;
+        issue = '个人分组迁移未完成，已保留本地数据。';
+      } on FileSystemException {
+        issue = '个人分组迁移未完成，已保留本地数据。';
+      }
+      final groups = await _json('GET', 'groups');
+      final shared = _list(groups['groups']);
+      final stamp = DateTime.parse(groups['server_time']).toUtc();
+      final mine = _list((await _json('GET', 'me/groups'))['groups']);
+      _check();
+      await refreshBooks();
+      _check();
+      _shared = shared;
+      _mine = mine;
+      _serverTime = stamp;
+      _online = true;
+      try {
+        await _save();
+      } on FileSystemException {
+        issue ??= '分组缓存写入失败。';
+      }
+      _check();
+      problem = issue;
+      notifyListeners();
+    } catch (error) {
+      if (_active) {
+        _online = false;
+        problem = error is OpsError ? error.message : _unavailable.message;
+        notifyListeners();
+      }
+      if (error is OpsError) rethrow;
+      throw _unavailable;
+    }
+  }
+
+  Future<OpsGroup> detail(String id) => _queue(() async {
+        final row = await _json(
+            'GET', '${id.startsWith('m_') ? 'me/groups' : 'groups'}/$id');
+        return OpsGroup.fromJson(row);
+      });
+
+  Future<void> write(String method, String route,
+      {Map<String, dynamic>? body, int? version}) {
+    if (!_active) return Future.error(_expired);
+    if (!_online) return Future.error(const OpsError(0, '离线时无法编辑分组。'));
+    return _queue(() async {
+      if (!_online) throw const OpsError(0, '离线时无法编辑分组。');
+      try {
+        await _json(method, route, body: body, version: version);
+      } on OpsError catch (error) {
+        if (error.status == 409 || error.status == 404 || error.status == 403) {
+          try {
+            await _snapshot();
+          } on OpsError {/* return the original conflict */}
+        } else if (_active && (error.status == 0 || error.status >= 500)) {
+          _online = false;
+          problem = error.message;
+          notifyListeners();
+        }
+        rethrow;
+      }
+      await _snapshot();
+    });
+  }
+
+  void _backgroundRefresh() {
+    unawaited(refresh().catchError((Object _) {}));
+  }
+
+  // The retained feed can replay 1000 records at once. Keep one trailing
+  // cursor per connection, independent of the network read or a slow snapshot.
+  void _scheduleEvents(int connection) {
+    if (!_active ||
+        _connection != connection ||
+        _closingFeed ||
+        _eventTimer != null ||
+        _eventBatch != null ||
+        _pendingCursor == null) {
+      return;
+    }
+    _eventTimer = Timer(const Duration(seconds: 2), () {
+      _eventTimer = null;
+      unawaited(_commitEvents(connection));
+    });
+  }
+
+  Future<void> _commitEvents(int connection) async {
+    final cursor = _pendingCursor;
+    if (!_active || _connection != connection || cursor == null) return;
+    _pendingCursor = null;
+    final batch = _queue(_snapshot);
+    _eventBatch = batch.then<void>((_) {
+      if (_active && _connection == connection) _cursor = cursor;
+    }, onError: (Object _) {
+      if (_active && _connection == connection) _pendingCursor ??= cursor;
+    });
+    try {
+      await _eventBatch;
+    } finally {
+      _eventBatch = null;
+      _scheduleEvents(connection);
+    }
+  }
+
+  Future<void> _events() async {
+    final connection = ++_connection;
+    final feed = HttpClient()
+      ..connectionTimeout = const Duration(seconds: 8)
+      ..findProxy = ((_) => 'DIRECT');
+    _feed = feed;
+    try {
+      final res = await _open('GET', 'events', stream: true, client: feed);
+      if (res.statusCode != 200 ||
+          res.headers.contentType?.mimeType != 'text/event-stream') {
+        await res.drain<void>().timeout(const Duration(seconds: 10));
+        return;
+      }
+      // Subscribe first, then resnapshot. The server can silently discard old
+      // events and filters revocations from the former viewer's stream.
+      await _queue(_snapshot);
+      String? eventId;
+      await for (final line in res
+          .timeout(const Duration(seconds: 55))
+          .transform(utf8.decoder)
+          .transform(const LineSplitter())) {
+        _check();
+        if (line.startsWith(':')) {
+          _retries = 0;
+          continue;
+        }
+        if (line.startsWith('id:')) {
+          final id = line.substring(3).trim();
+          if (RegExp(r'^[0-9]{1,18}$').hasMatch(id)) eventId = id;
+        } else if (line.isEmpty && eventId != null) {
+          _pendingCursor = eventId;
+          _scheduleEvents(connection);
+          _retries = 0;
+          eventId = null;
+        }
+      }
+    } catch (_) {
+      // Periodic full reads also run while the stream is down.
+    } finally {
+      feed.close(force: true);
+      _feed = null;
+      _closingFeed = true;
+      _eventTimer?.cancel();
+      _eventTimer = null;
+      // A disconnect may race either the debounce or the snapshot's cache write.
+      // Acknowledge complete frames only after that snapshot has succeeded.
+      final batch = _eventBatch;
+      if (batch != null) await batch;
+      await _commitEvents(connection);
+      _pendingCursor = null;
+      _connection++;
+      _closingFeed = false;
+      if (_active) {
+        const delays = [1, 2, 5, 10, 30];
+        final delay = delays[_retries];
+        if (_retries < delays.length - 1) _retries++;
+        _retry = Timer(reconnectDelay * delay, () => unawaited(_events()));
+        _backgroundRefresh();
+      }
+    }
+  }
+
+  Future<void> logout() {
+    if (_logout != null) return _logout!;
+    _ended = true;
+    _stop();
+    _shared = const [];
+    _mine = const [];
+    _serverTime = null;
+    _online = false;
+    problem = _expired.message;
+    final clear = _file(() async {
+      if (await cache.exists()) await cache.delete();
+    });
+    _logout = clear;
+    if (!_disposed) notifyListeners();
+    return clear;
+  }
+
+  void _stop() {
+    _eventTimer?.cancel();
+    _retry?.cancel();
+    _poll?.cancel();
+    _feed?.close(force: true);
+    _http.close(force: true);
+  }
+
+  // Dispose synchronously for Flutter, then allow owners to wait for queued I/O
+  // before releasing a cache directory or moving it to a different account.
+  Future<void> get settledAfterDispose async {
+    assert(_disposed);
+    await _work;
+    final files = _fileWork[cache.absolute.path];
+    if (files != null) await files;
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    _stop();
+    super.dispose();
+  }
+}
