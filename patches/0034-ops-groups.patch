@@ -0,0 +1,42 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/ops_group_tile.dart';
+
+void main() {
+  for (final admin in [false, true]) {
+    for (final online in [false, true]) {
+      testWidgets('group menu admin=$admin online=$online', (tester) async {
+        final actions = <String>[];
+        await tester.pumpWidget(MaterialApp(
+            home: Scaffold(
+                body: OpsGroupTile(
+                    name: '测试门店',
+                    selected: false,
+                    childGroup: true,
+                    pending: true,
+                    admin: admin,
+                    online: online,
+                    onSelect: () {},
+                    onAction: actions.add))));
+        expect(find.text('同步中'), findsOneWidget);
+        await tester.tap(find.byTooltip('分组选项'));
+        await tester.pumpAndSettle();
+        expect(find.text('查看详情'), findsOneWidget);
+        for (final label in ['修改分组', '谁能看到', '增减设备', '移动设备', '删除分组']) {
+          final item = find.widgetWithText(PopupMenuItem<String>, label);
+          expect(item, admin ? findsOneWidget : findsNothing);
+          if (admin) {
+            expect(tester.widget<PopupMenuItem<String>>(item).enabled, online);
+          }
+        }
+        if (admin && !online) {
+          await tester.tap(find.text('修改分组'), warnIfMissed: false);
+          expect(actions, isEmpty);
+        }
+        await tester.tap(find.text(admin && online ? '修改分组' : '查看详情'));
+        await tester.pumpAndSettle();
+        expect(actions, [admin && online ? 'edit' : 'details']);
+      });
+    }
+  }
+}
diff --git a/flutter/test/steaddesk/ops_groups_test.dart b/flutter/test/steaddesk/ops_groups_test.dart
new file mode 100644
index 0000000..7f99996
--- /dev/null
+++ b/flutter/test/steaddesk/ops_groups_test.dart
@@ -0,0 +1,328 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:flutter_hbb/steaddesk/ops_groups.dart';
+import 'package:flutter_hbb/steaddesk/personal_groups.dart';
+
+class Fixture {
+  late final HttpServer server;
+  late final Directory dir;
+  late final PersonalGroups local;
+  late OpsGroupStore store;
+  late final File cache;
+  Uri get origin => Uri.parse('http://127.0.0.1:${server.port}');
+  int status = 200, importStatus = 200, version = 1;
+  bool badMapping = false, visible = true, failGroupReads = false;
+  String name = '共享组';
+  HttpResponse? events;
+  final cursors = <String?>[], imports = <List>[];
+  final writes = <(String?, String?, dynamic)>[];
+  int books = 0, reads = 0;
+  Completer<void>? holdGroups;
+  Completer<void>? holdBooks, enteredBooks;
+  Map<String, dynamic> group(String id) => {
+        'id': id,
+        'name': name,
+        'device_ids': ['123456789'],
+        'owner': 'fixture',
+        'viewers': null,
+        'updated_at': '2026-01-01T12:34:00Z',
+        'version': version,
+        'projection': 'pending',
+        'extra': 'never-cache-unexpected-fields',
+      };
+  Future<void> setup() async {
+    dir = await Directory.systemTemp.createTemp('ops-store-test-');
+    cache = File('${dir.path}/groups.json');
+    local = PersonalGroups(() async => File('${dir.path}/personal.json'),
+        onReset: () {}, onChanged: () {});
+    server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    server.listen((req) async {
+      try {
+        expect(req.headers.value('authorization'), 'Bearer test-access');
+        final route = req.uri.path.replaceFirst('/ops/v1/', '');
+        final response = req.response;
+        if (req.method != 'GET') {
+          expect(req.contentLength, greaterThanOrEqualTo(0));
+          expect(req.headers.value('transfer-encoding'), isNull);
+        }
+        dynamic data;
+        if (status != 200) {
+          response.statusCode = status;
+          data = {};
+        } else if (route == 'events') {
+          events = response;
+          cursors.add(req.headers.value('Last-Event-ID'));
+          response.headers.contentType = ContentType('text', 'event-stream');
+          response.bufferOutput = false;
+          response.write(': connected\n\n');
+          await response.flush();
+          return;
+        } else if (route == 'groups') {
+          reads++;
+          if (failGroupReads) response.statusCode = 503;
+          if (holdGroups != null) await holdGroups!.future;
+          data = {
+            'groups': [if (visible) group('g_fixture')],
+            'server_time': '2026-01-01T12:34:00Z'
+          };
+        } else if (route == 'groups/g_fixture' && req.method == 'GET') {
+          data = group('g_fixture');
+        } else if (route == 'me/groups') {
+          data = {
+            'groups': [group('m_fixture')]
+          };
+        } else if (route == 'me/groups/import') {
+          final payload = jsonDecode(await utf8.decoder.bind(req).join());
+          imports.add(payload['groups']);
+          response.statusCode = importStatus;
+          data = {
+            'mapping': [
+              if (!badMapping)
+                for (final row in payload['groups'])
+                  {
+                    'local_id': row['local_id'],
+                    'id': 'm_fixture',
+                    'result': 'already_imported'
+                  }
+            ]
+          };
+        } else if (route == 'me/groups/m_fixture' && req.method == 'PATCH') {
+          final body = jsonDecode(await utf8.decoder.bind(req).join());
+          writes.add((
+            req.headers.value('If-Match'),
+            req.headers.value('Idempotency-Key'),
+            body
+          ));
+          if (req.headers.value('If-Match') != '"$version"') {
+            response.statusCode = 409;
+          } else {
+            version++;
+            name = body['name'];
+          }
+          data = group('m_fixture');
+        } else {
+          response.statusCode = 404;
+          data = {};
+        }
+        response.headers.contentType = ContentType.json;
+        response.write(jsonEncode(data));
+        await response.close();
+      } on SocketException {
+        /* disposing store closes in-flight connections */
+      } on HttpException {/* disposing store closes in-flight connections */}
+    });
+    store = create();
+  }
+
+  OpsGroupStore create({String account = 'fixture', Duration? poll}) =>
+      OpsGroupStore(
+        origin: origin,
+        token: 'test-access',
+        account: account,
+        cache: cache,
+        local: local,
+        pollInterval: poll ?? const Duration(minutes: 5),
+        reconnectDelay: const Duration(milliseconds: 35),
+        refreshBooks: () async {
+          books++;
+          final entered = enteredBooks;
+          if (entered != null && !entered.isCompleted) entered.complete();
+          if (holdBooks != null) await holdBooks!.future;
+        },
+      );
+  Future<void> wait(bool Function() check) async {
+    final end = DateTime.now().add(const Duration(seconds: 4));
+    while (!check() && DateTime.now().isBefore(end)) {
+      await Future<void>.delayed(const Duration(milliseconds: 10));
+    }
+    expect(check(), isTrue);
+  }
+
+  Future<void> settled() => wait(() => cursors.isNotEmpty && books >= 2);
+  Future<void> close() async {
+    store.dispose();
+    if (holdGroups != null && !holdGroups!.isCompleted) holdGroups!.complete();
+    if (holdBooks != null && !holdBooks!.isCompleted) holdBooks!.complete();
+    await server.close(force: true);
+    await store.settledAfterDispose;
+    await dir.delete(recursive: true);
+  }
+}
+
+void main() {
+  late Fixture f;
+  setUp(() async {
+    f = Fixture();
+    await f.setup();
+  });
+  tearDown(() => f.close());
+
+  test(
+      'migration archives only acknowledged account after complete receipt; retries same local ID',
+      () async {
+    await f.local.create('fixture', '我的分组', ['123456789']);
+    await f.local.create('another', '其他账号', ['100000000']);
+    final original = (await f.local.list('fixture')).single.id;
+    f.importStatus = 422;
+    await f.store.start();
+    await f.settled();
+    expect(f.store.problem, contains('已保留'));
+    expect((await f.local.list('fixture')).single.id, original);
+    f.importStatus = 200;
+    f.badMapping = true;
+    await f.store.refresh();
+    expect((await f.local.list('fixture')).single.id, original);
+    f.badMapping = false;
+    await f.store.refresh();
+    expect(await f.local.list('fixture'), isEmpty);
+    expect((await f.local.list('another')).single.name, '其他账号');
+    final backup = f.dir
+        .listSync()
+        .whereType<File>()
+        .singleWhere((item) => item.path.contains('my-groups.imported-'));
+    final accounts = jsonDecode(await backup.readAsString())['accounts'];
+    expect(accounts.keys, ['fixture']);
+    expect(accounts['fixture'][0]['id'], original);
+    expect(
+        f.imports.every((rows) => rows.single['local_id'] == original), isTrue);
+  });
+
+  test(
+      '409 reloads server version; keeps single attempted write and no automatic replay',
+      () async {
+    await f.store.start();
+    await f.settled();
+    expect(f.store.shared.single.pending, isTrue);
+    expect((await f.store.detail('g_fixture')).deviceIds, {'123456789'});
+    f.version = 2;
+    f.name = '另一人改过';
+    await expectLater(
+        f.store.write('PATCH', 'me/groups/m_fixture',
+            version: 1, body: {'name': '我的输入'}),
+        throwsA(isA<OpsError>().having((e) => e.status, 'status', 409)));
+    expect(f.writes.length, 1);
+    expect(f.writes.single.$1, '"1"');
+    expect(f.writes.single.$2, isNotEmpty);
+    expect(f.writes.single.$3['name'], '我的输入');
+    expect(f.store.mine.single.name, '另一人改过');
+    expect(f.store.mine.single.version, 2);
+    await f.store.write('PATCH', 'me/groups/m_fixture',
+        version: 2, body: {'name': '确认后保存'});
+    expect(f.store.mine.single.name, '确认后保存');
+    expect(f.writes.first.$2, isNot(f.writes.last.$2));
+  });
+
+  test(
+      'on reconnect sends previous ID and revocations disappear without an event',
+      () async {
+    await f.store.start();
+    await f.settled();
+    final before = f.books;
+    f.enteredBooks = Completer<void>();
+    f.holdBooks = Completer<void>();
+    final replay = StringBuffer();
+    for (int id = 7; id <= 1006; id++) {
+      replay.write('id: $id\nevent: group.changed\ndata: {}\n\n');
+    }
+    f.events!.write(replay);
+    await f.events!.flush();
+    await f.enteredBooks!.future.timeout(const Duration(seconds: 8));
+    expect(f.books - before, 1);
+    f.visible = false;
+    await f.events!.close();
+    f.holdBooks!.complete();
+    await f.wait(() => f.cursors.length >= 2 && f.store.shared.isEmpty);
+    expect(f.cursors[1], '1006');
+    expect(f.store.online, isTrue);
+    expect(jsonDecode(await f.cache.readAsString())['shared'], isEmpty);
+  });
+
+  test('EOF drains the last received batch before reopening the stream',
+      () async {
+    await f.store.start();
+    await f.settled();
+    final stream = f.events!;
+    stream.write('id: 19\nevent: group.changed\ndata: {}\n\n');
+    await stream.close();
+    await f.wait(() => f.cursors.length >= 2);
+    expect(f.cursors[1], '19');
+  });
+
+  test('failed disconnect snapshot leaves the cursor unacknowledged', () async {
+    await f.store.start();
+    await f.settled();
+    f.failGroupReads = true;
+    final stream = f.events!;
+    stream.write('id: 20\nevent: group.changed\ndata: {}\n\n');
+    await stream.close();
+    await f.wait(() => f.cursors.length >= 2);
+    expect(f.cursors[1], isNull);
+    expect(f.store.online, isFalse);
+  });
+
+  test(
+      'polling catches a revoked group while the same stream remains connected',
+      () async {
+    f.store.dispose();
+    await f.store.settledAfterDispose;
+    f.store = f.create(poll: const Duration(milliseconds: 120));
+    await f.store.start();
+    await f.settled();
+    f.visible = false;
+    await f.wait(() => f.store.shared.isEmpty);
+    expect(f.cursors.length, 1);
+  });
+
+  test('cache is account-bound; restart offline is read-only; 401 erases cache',
+      () async {
+    await f.store.start();
+    await f.settled();
+    expect(await f.cache.readAsString(), isNot(contains('test-access')));
+    expect(await f.cache.readAsString(),
+        isNot(contains('never-cache-unexpected-fields')));
+    f.store.dispose();
+    await f.store.settledAfterDispose;
+    f.status = 503;
+    f.store = f.create();
+    await f.store.start();
+    expect(f.store.online, isFalse);
+    expect(f.store.shared.single.id, 'g_fixture');
+    expect(f.store.serverTime, DateTime.utc(2026, 1, 1, 12, 34));
+    await expectLater(f.store.write('DELETE', 'groups/g_fixture', version: 1),
+        throwsA(isA<OpsError>()));
+    f.store.dispose();
+    await f.store.settledAfterDispose;
+    f.store = f.create(account: 'another');
+    await f.store.start();
+    expect(f.store.shared, isEmpty);
+    expect(f.store.mine, isEmpty);
+    f.store.dispose();
+    await f.store.settledAfterDispose;
+    f.status = 401;
+    f.store = f.create();
+    await f.store.start();
+    expect(f.store.signedOut, isTrue);
+    expect(f.store.shared, isEmpty);
+    expect(await f.cache.exists(), isFalse);
+  });
+
+  test('in-flight snapshot cannot restore data or cache after logout',
+      () async {
+    await f.store.start();
+    await f.settled();
+    final initial = f.reads;
+    f.holdGroups = Completer<void>();
+    final read = expectLater(f.store.refresh(), throwsA(isA<OpsError>()));
+    await f.wait(() => f.reads > initial);
+    await f.store.logout();
+    f.holdGroups!.complete();
+    await read;
+    expect(f.store.shared, isEmpty);
+    expect(f.store.online, isFalse);
+    expect(await f.cache.exists(), isFalse);
+  });
+}
