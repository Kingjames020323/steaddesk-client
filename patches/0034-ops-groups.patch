diff --git a/flutter/lib/steaddesk/ops_group_controls.dart b/flutter/lib/steaddesk/ops_group_controls.dart
new file mode 100644
index 0000000..a0972c4
--- /dev/null
+++ b/flutter/lib/steaddesk/ops_group_controls.dart
@@ -0,0 +1,369 @@
+part of 'support_home.dart';
+
+const _useOps = opsGroupsEnabled && !merchantEdition;
+
+extension _OpsControls on _DirectoryState {
+  bool get opsAdmin => ops != null && gFFI.userModel.isAdmin.value;
+  bool get canWrite => ops?.online == true;
+  bool get canManage => canWrite && opsAdmin;
+  OpsGroup? serverGroup(String id) =>
+      [...?ops?.mine, ...?ops?.shared].firstWhereOrNull((g) => g.id == id);
+
+  Widget _unavailable(String id, PersonalGroup group) => ListTile(
+      leading: const Icon(Icons.lock_outline),
+      title: Text(id),
+      subtitle: const Text('无权限或已移除'),
+      trailing: IconButton(
+        tooltip: '从我的分组移除',
+        icon: const Icon(Icons.remove_circle_outline),
+        onPressed:
+            !canWrite ? null : () => privateMembers(group, [id], remove: true),
+      ));
+
+  Widget _opsTree(Widget all) {
+    final store = ops;
+    final shared = store?.shared ?? <OpsGroup>[];
+    final viewed = store?.serverTime?.toLocal();
+    final time = viewed == null
+        ? ''
+        : '${viewed.hour.toString().padLeft(2, '0')}:${viewed.minute.toString().padLeft(2, '0')}';
+    Widget node(OpsGroup group, bool child) => OpsGroupTile(
+        name: group.name,
+        childGroup: child,
+        selected: scope == 'shared/${group.id}',
+        pending: group.pending,
+        admin: opsAdmin,
+        online: canWrite,
+        onSelect: () => selectScope('shared/${group.id}'),
+        onAction: (action) => _sharedAction(action, group));
+    final parentIds = shared.map((g) => g.id).toSet();
+    return ListView(children: [
+      all,
+      ListTile(
+          dense: true,
+          title: const Text('共享分组'),
+          trailing: opsAdmin
+              ? IconButton(
+                  tooltip: '新建共享分组',
+                  icon: const Icon(Icons.add),
+                  onPressed:
+                      canManage ? () => _sharedAction('create', null) : null)
+              : null),
+      if (!canWrite)
+        Padding(
+            padding: const EdgeInsets.symmetric(horizontal: 12),
+            child: Text(widget.store?.signedOut == true
+                ? '登录已过期，请重新登录。'
+                : time.isEmpty
+                    ? '离线，暂无已同步的分组'
+                    : '离线，显示的是 $time 的数据')),
+      if (store?.problem != null && store?.signedOut != true)
+        Padding(
+            padding: const EdgeInsets.symmetric(horizontal: 12),
+            child: Text(store!.problem!)),
+      for (final parent
+          in shared.where((g) => !parentIds.contains(g.parentId))) ...[
+        node(parent, false),
+        for (final child in shared.where((g) => g.parentId == parent.id))
+          node(child, true),
+      ],
+      ListTile(
+          dense: true,
+          selected: scope == '?',
+          title: const Text('未分组'),
+          onTap: () => selectScope('?')),
+      const Divider(height: 1),
+      ListTile(
+          dense: true,
+          title: const Text('我的分组'),
+          trailing: IconButton(
+              tooltip: '新建我的分组',
+              icon: const Icon(Icons.add),
+              onPressed: canWrite ? () => createGroup(account) : null)),
+      for (final group in groups) personalNode(group, account),
+    ]);
+  }
+
+  Future<void> privateMembers(PersonalGroup group, Iterable<String> ids,
+      {bool remove = false}) async {
+    if (!canWrite) return;
+    await _opsEdit(
+        title: remove ? '从我的分组移除' : '加入我的分组',
+        personal: true,
+        group: serverGroup(group.id),
+        version: group.version,
+        method: 'PATCH',
+        route: 'me/groups/${group.id}',
+        fields: {remove ? 'remove' : 'add': ids.join(', ')});
+  }
+
+  Future<void> _sharedAction(String action, OpsGroup? group) async {
+    final store = ops;
+    if (store == null ||
+        (group != null && !store.shared.any((g) => g.id == group.id))) return;
+    if (action == 'details' && group != null) {
+      try {
+        if (!await currentOpsIdentity(store)) return;
+        final g = store.online ? await store.detail(group.id) : group;
+        if (!mounted || !identical(store, ops)) return;
+        await _detailsGroup(g.name, [
+          if (g.owner != null) '负责人 · ${g.owner}',
+          if (g.viewers != null) '可见名单 · ${g.viewers!.join(', ')}',
+          if (g.pending) '同步中',
+          ...g.deviceIds,
+        ]);
+      } on OpsError catch (e) {
+        if (mounted && identical(store, ops)) showToast(e.toString());
+      }
+      return;
+    }
+    if (!canManage) return;
+    if (action == 'move' && group != null) {
+      final options = store.shared.where((g) => g.id != group.id).toList();
+      final to = await showDialog<OpsGroup>(
+          context: context,
+          builder: (ctx) => SimpleDialog(title: const Text('移动到分组'), children: [
+                if (options.isEmpty) const ListTile(title: Text('没有其他分组')),
+                for (final g in options)
+                  SimpleDialogOption(
+                      onPressed: () => Navigator.pop(ctx, g),
+                      child: Text(g.name)),
+              ]));
+      if (to == null || !mounted || !identical(ops, store)) return;
+      await _opsEdit(
+          title: '${group.name} → ${to.name}',
+          group: group,
+          destination: to,
+          method: 'POST',
+          route: 'devices/move',
+          fields: {'device': ''});
+      return;
+    }
+    final create = action == 'create';
+    final fields = switch (action) {
+      'create' || 'edit' => {
+          'name': group?.name ?? '',
+          'owner': group?.owner ?? '',
+          'parent_id': group?.parentId ?? ''
+        },
+      'viewers' => {'viewers': group?.viewers?.join(', ') ?? ''},
+      'devices' => {'add': '', 'remove': ''},
+      _ => <String, String>{},
+    };
+    final route = create ? 'groups' : 'groups/${group!.id}';
+    await _opsEdit(
+        title: switch (action) {
+          'create' => '新建共享分组',
+          'edit' => '修改分组',
+          'delete' => '删除分组',
+          'devices' => '增减设备',
+          _ => '谁能看到',
+        },
+        group: group,
+        method: switch (action) {
+          'delete' => 'DELETE',
+          'edit' => 'PATCH',
+          'viewers' => 'PUT',
+          _ => 'POST',
+        },
+        route: action == 'devices' || action == 'viewers'
+            ? '$route/$action'
+            : route,
+        fields: fields);
+  }
+
+  Future<void> _opsEdit(
+      {required String title,
+      required String method,
+      required String route,
+      required Map<String, String> fields,
+      OpsGroup? group,
+      OpsGroup? destination,
+      bool personal = false,
+      int? version}) async {
+    final store = ops;
+    if (store == null || !canWrite || (!personal && !canManage)) return;
+    var expected = version ?? group?.version;
+    var toVersion = destination?.version;
+    var busy = false;
+    var error = '';
+    var latest = '';
+    final draft = Map<String, String>.from(fields);
+    const labels = {
+      'name': '分组名',
+      'owner': '负责人账号',
+      'parent_id': '上级分组',
+      'viewers': '可见账号（逗号分隔）',
+      'add': '加入设备 ID（逗号分隔）',
+      'remove': '移除设备 ID（逗号分隔）',
+      'device': '要移动的设备 ID',
+      'device_ids': '设备 ID（逗号分隔）',
+    };
+    List<String> items(String value) => value
+        .split(RegExp(r'[,，\s]+'))
+        .where((id) => id.isNotEmpty)
+        .toSet()
+        .toList();
+    await showDialog<void>(
+        context: context,
+        builder: (ctx) => StatefulBuilder(
+            builder: (ctx, paint) => AnimatedBuilder(
+                animation: store,
+                builder: (_, __) {
+                  final valid = mounted &&
+                      identical(store, ops) &&
+                      (personal || opsAdmin);
+                  if (!valid)
+                    return AlertDialog(title: const Text('账号或权限已更改'), actions: [
+                      TextButton(
+                          onPressed: () => Navigator.pop(ctx),
+                          child: const Text('关闭'))
+                    ]);
+                  return AlertDialog(
+                      title: Text(title),
+                      content: SizedBox(
+                          width: 360,
+                          child: SingleChildScrollView(
+                              child: Column(
+                                  mainAxisSize: MainAxisSize.min,
+                                  crossAxisAlignment: CrossAxisAlignment.start,
+                                  children: [
+                                if (group != null) Text(group.name),
+                                if (method == 'DELETE')
+                                  const Text('确认删除这个分组？设备将保留。'),
+                                for (final key in fields.keys)
+                                  if (key == 'parent_id')
+                                    DropdownButtonFormField<String>(
+                                        value: store.shared
+                                                .any((g) => g.id == draft[key])
+                                            ? draft[key]
+                                            : '',
+                                        decoration: InputDecoration(
+                                            labelText: labels[key]),
+                                        items: [
+                                          const DropdownMenuItem(
+                                              value: '', child: Text('无')),
+                                          for (final g in store.shared.where(
+                                              (g) =>
+                                                  g.parentId == null &&
+                                                  g.id != group?.id))
+                                            DropdownMenuItem(
+                                                value: g.id,
+                                                child: Text(g.name)),
+                                        ],
+                                        onChanged: busy || !store.online
+                                            ? null
+                                            : (v) => draft[key] = v ?? '')
+                                  else
+                                    TextFormField(
+                                        initialValue: draft[key],
+                                        enabled: !busy && store.online,
+                                        decoration: InputDecoration(
+                                            labelText: labels[key]),
+                                        onChanged: (value) =>
+                                            draft[key] = value),
+                                if (error.isNotEmpty)
+                                  Text(error,
+                                      style:
+                                          const TextStyle(color: Colors.red)),
+                                if (latest.isNotEmpty) SelectableText(latest),
+                              ]))),
+                      actions: [
+                        TextButton(
+                            onPressed: busy ? null : () => Navigator.pop(ctx),
+                            child: const Text('取消')),
+                        TextButton(
+                            onPressed: !store.online || busy
+                                ? null
+                                : () async {
+                                    if (!mounted ||
+                                        !identical(store, ops) ||
+                                        (!personal && !canManage)) return;
+                                    paint(() {
+                                      busy = true;
+                                      error = '';
+                                    });
+                                    try {
+                                      final data = <String, dynamic>{
+                                        for (final e in draft.entries)
+                                          e.key: [
+                                            'viewers',
+                                            'add',
+                                            'remove',
+                                            'device_ids'
+                                          ].contains(e.key)
+                                              ? items(e.value)
+                                              : e.key == 'parent_id' &&
+                                                      e.value.isEmpty
+                                                  ? null
+                                                  : e.value.trim()
+                                      };
+                                      var path = route;
+                                      if (destination != null) {
+                                        final id = directSupportId(
+                                            draft['device'] ?? '');
+                                        if (id == null)
+                                          throw const FormatException();
+                                        path = 'devices/$id/move';
+                                        data.clear();
+                                        data['from'] = {
+                                          'id': group!.id,
+                                          'version': expected
+                                        };
+                                        data['to'] = {
+                                          'id': destination.id,
+                                          'version': toVersion
+                                        };
+                                      }
+                                      if (!await currentOpsIdentity(store) ||
+                                          (!personal && !canManage)) {
+                                        throw const OpsError(
+                                            403, '账号或权限已更改，请重新打开分组。');
+                                      }
+                                      await store.write(method, path,
+                                          version: destination == null
+                                              ? expected
+                                              : null,
+                                          body:
+                                              method == 'DELETE' ? null : data);
+                                      if (ctx.mounted) Navigator.pop(ctx);
+                                    } on OpsError catch (e) {
+                                      if (!ctx.mounted ||
+                                          !mounted ||
+                                          !identical(store, ops)) return;
+                                      paint(() {
+                                        error = e.toString();
+                                        if (e.status == 409 && group != null) {
+                                          final current = serverGroup(group.id);
+                                          final to = destination == null
+                                              ? null
+                                              : serverGroup(destination.id);
+                                          final snapshots = [
+                                            if (current != null) current,
+                                            if (to != null) to
+                                          ];
+                                          latest = snapshots
+                                              .map((g) =>
+                                                  '服务器版本 ${g.version} · ${g.name}\n负责人：${g.owner ?? '—'}\n可见账号：${g.viewers?.join(', ') ?? '—'}\n设备：${g.deviceIds.join(', ')}')
+                                              .join('\n');
+                                          expected =
+                                              current?.version ?? expected;
+                                          toVersion = to?.version ?? toVersion;
+                                        }
+                                      });
+                                    } on FormatException {
+                                      if (ctx.mounted)
+                                        paint(() => error = '请输入有效的设备 ID。');
+                                    } catch (_) {
+                                      if (ctx.mounted)
+                                        paint(() => error = '保存失败，请检查网络后重试。');
+                                    } finally {
+                                      if (ctx.mounted)
+                                        paint(() => busy = false);
+                                    }
+                                  },
+                            child: Text(latest.isEmpty ? '保存' : '确认后保存')),
+                      ]);
+                })));
+  }
+}
