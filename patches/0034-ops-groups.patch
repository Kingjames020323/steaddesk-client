+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/shared_profiles.dart';
+
+void main() {
+  test('v2.7 total=0 can still contain books with duplicate display names', () {
+    final pages = SharedProfilePages();
+    expect(
+        pages.add({
+          'total': 0,
+          'data': [
+            {'guid': '1-2-1', 'name': 'One'},
+            {'guid': '1-2-2', 'name': 'One'},
+            {'guid': '1-2-3', 'name': 'My address book'}
+          ]
+        }),
+        isTrue);
+    expect(pages.named('My address book').map((r) => r['name']),
+        ['One', 'One [1-2-2]', 'My address book [1-2-3]']);
+    expect(SharedProfilePages().add({'total': 0, 'data': null}), isTrue);
+  });
+
+  test('missing pages, changing totals and repeats cannot confirm removal', () {
+    final page = {'guid': '1-2-1', 'name': 'One'};
+    final pages = SharedProfilePages();
+    expect(
+        pages.add({
+          'total': 2,
+          'data': [page]
+        }),
+        isFalse);
+    for (final partial in [
+      {'total': 2, 'data': []},
+      {
+        'total': 0,
+        'data': [page]
+      },
+      {
+        'total': 2,
+        'data': [page]
+      },
+      {'total': 0}
+    ]) {
+      expect(() => pages.add(partial), throwsFormatException);
+    }
+  });
+
+  test(
+      'revoked and replaced book are cleared while the authorized book survives',
+      () {
+    final old = {'guid': 'old', 'cached': 'synthetic'},
+        revoked = {'guid': 'revoked', 'cached': 'synthetic'};
+    final kept = {'guid': 'kept', 'cached': 'synthetic'};
+    final cache = {'same-name': old, 'removed': revoked, 'other': kept};
+    expect(
+        pruneSharedBooks(cache, {'same-name': 'new', 'other': 'kept'},
+            (r) => r['guid'], (r) => r.clear()),
+        isTrue);
+    expect(cache, {'other': kept});
+    expect(old, isEmpty);
+    expect(revoked, isEmpty);
+    expect(kept.containsKey('cached'), isTrue);
+  });
+}
diff --git a/flutter/tool/ops_groups_drill.dart b/flutter/tool/ops_groups_drill.dart
new file mode 100644
index 0000000..7172cae
--- /dev/null
+++ b/flutter/tool/ops_groups_drill.dart
@@ -0,0 +1,262 @@
+// Run with flutter test --no-pub --no-test-assets tool/ops_groups_drill.dart.
+// OPS_GROUPS_DRILL points to an owner-only JSON file from a disposable local
+// OPS stack (origin, tokens by synthetic username, and temporary directory).
+// Its fixture controller acknowledges expire.request by writing expire.done
+// after advancing the server's actual 1000-event retention window.
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/ops_groups.dart';
+import 'package:flutter_hbb/steaddesk/personal_groups.dart';
+
+Future<void> until(bool Function() condition, String reason) async {
+  final end = DateTime.now().add(const Duration(seconds: 50));
+  while (!condition()) {
+    if (DateTime.now().isAfter(end)) throw StateError(reason);
+    await Future<void>.delayed(const Duration(milliseconds: 100));
+  }
+}
+
+// Only the connection into the second client is interrupted. All HTTP/SSE
+// data and status codes come from the real disposable server.
+class Link {
+  final Uri upstream;
+  final HttpServer server;
+  final connections = <Socket>{};
+  final upstreamClients = <HttpClient>{};
+  final cursors = <String?>[];
+  int writes = 0, fullLists = 0, privateLists = 0;
+  bool available = true;
+  Link(this.upstream, this.server);
+  Uri get origin => Uri.parse('http://127.0.0.1:${server.port}');
+  static Future<Link> open(Uri upstream) async {
+    final link =
+        Link(upstream, await HttpServer.bind(InternetAddress.loopbackIPv4, 0));
+    link.server.listen(link.forward);
+    return link;
+  }
+
+  Future<void> forward(HttpRequest request) async {
+    HttpClient? client;
+    Socket? socket;
+    try {
+      if (request.method != 'GET') writes++;
+      if (!available) {
+        request.response.statusCode = 503;
+        await request.response.close();
+        return;
+      }
+      final path = request.uri.path;
+      if (path.endsWith('/events')) {
+        cursors.add(request.headers.value('last-event-id'));
+      }
+      if (path == '/ops/v1/groups' &&
+          !request.uri.queryParameters.containsKey('since')) fullLists++;
+      if (path == '/ops/v1/me/groups') privateLists++;
+      client = HttpClient()..findProxy = (_) => 'DIRECT';
+      upstreamClients.add(client);
+      final target = await client.openUrl(
+          request.method, upstream.resolveUri(request.uri));
+      for (final name in [
+        'authorization',
+        'content-type',
+        'idempotency-key',
+        'if-match',
+        'last-event-id'
+      ]) {
+        final value = request.headers.value(name);
+        if (value != null) target.headers.set(name, value);
+      }
+      if (request.contentLength >= 0) {
+        target.contentLength = request.contentLength;
+      }
+      await target.addStream(request);
+      final response = await target.close();
+      request.response.statusCode = response.statusCode;
+      final type = response.headers.value('content-type');
+      if (type != null) request.response.headers.set('content-type', type);
+      if (path.endsWith('/events') && response.statusCode == 200) {
+        // Frame SSE as a close-delimited HTTP body. The cut must close the
+        // downstream connection even if the upstream is waiting for a heartbeat.
+        request.response.persistentConnection = false;
+        request.response.headers.chunkedTransferEncoding = false;
+        socket = await request.response.detachSocket(writeHeaders: true);
+        connections.add(socket);
+        await for (final bytes in response) {
+          socket.add(bytes);
+          await socket.flush();
+        }
+      } else {
+        await request.response.addStream(response);
+        await request.response.close();
+      }
+    } catch (_) {
+      try {
+        await request.response.close();
+      } catch (_) {}
+    } finally {
+      socket?.destroy();
+      connections.remove(socket);
+      client?.close(force: true);
+      upstreamClients.remove(client);
+    }
+  }
+
+  void cut() {
+    available = false;
+    for (final socket in connections.toList()) {
+      socket.destroy();
+    }
+    for (final client in upstreamClients.toList()) {
+      client.close(force: true);
+    }
+  }
+
+  Future<void> close() async {
+    cut();
+    await server.close(force: true);
+  }
+}
+
+void main() {
+  test('local issued sessions, versions, migration, SSE and offline cache',
+      () async {
+    final input = File(Platform.environment['OPS_GROUPS_DRILL']!);
+    expect((await input.stat()).mode & 0x3f, 0,
+        reason: 'Private session file required');
+    final cfg = jsonDecode(await input.readAsString());
+    final origin = Uri.parse(cfg['origin']);
+    expect(origin.scheme, 'http');
+    expect(origin.host, '127.0.0.1');
+    final temp = Directory(cfg['temp']);
+    final link = await Link.open(origin);
+    addTearDown(link.close);
+    PersonalGroups local(String name) =>
+        PersonalGroups(() async => File('${temp.path}/$name.local.json'),
+            onReset: () {}, onChanged: () {});
+    OpsGroupStore session(String user, String slot,
+        {Uri? via, PersonalGroups? groups}) {
+      final store = OpsGroupStore(
+          origin: via ?? origin,
+          token: cfg['tokens'][user],
+          account: user,
+          cache: File('${temp.path}/$slot.cache.json'),
+          local: groups ?? local(slot),
+          refreshBooks: () async {});
+      addTearDown(store.dispose);
+      return store;
+    }
+
+    final a = session('t-admin', 'a'),
+        b = session('t-admin2', 'b', via: link.origin);
+    final migrated = local('support');
+    await migrated.create('t-support', 'Migrated local', ['791013223']);
+    final support = session('t-support', 'support', groups: migrated);
+    await a.start();
+    await b.start();
+    await support.start();
+    expect(support.online, isTrue, reason: support.problem);
+    expect(support.problem, isNull);
+    expect(
+        support.mine.where((e) => e.name == 'Migrated local').single.deviceIds,
+        {'791013223'});
+    expect(await migrated.list('t-support'), isEmpty);
+    await a.write('POST', 'groups',
+        body: {'name': 'Visible fixture', 'owner': 't-support'});
+    await a.write('POST', 'groups',
+        body: {'name': 'Hidden fixture', 'owner': 't-support2'});
+    await a.refresh();
+    await support.refresh();
+    await b.refresh();
+    final group = a.shared.singleWhere((e) => e.name == 'Visible fixture');
+    final hidden = a.shared.singleWhere((e) => e.name == 'Hidden fixture');
+    expect(support.shared.map((e) => e.id), contains(group.id));
+    expect(support.shared.map((e) => e.id), isNot(contains(hidden.id)));
+    expect((await support.detail(group.id)).viewers, isNull);
+    await expectLater(support.detail(hidden.id),
+        throwsA(isA<OpsError>().having((e) => e.status, 'status', 404)));
+    await expectLater(
+        support.write('POST', 'groups',
+            body: {'name': 'Denied', 'owner': 't-support'}),
+        throwsA(isA<OpsError>().having((e) => e.status, 'status', 403)));
+    final first = await a.detail(group.id), stale = await b.detail(group.id);
+    expect(first.version, stale.version);
+    await a.write('PATCH', 'groups/${group.id}',
+        version: first.version, body: {'name': 'First writer'});
+    await expectLater(
+        b.write('PATCH', 'groups/${group.id}',
+            version: stale.version, body: {'name': 'Stale writer'}),
+        throwsA(isA<OpsError>().having((e) => e.status, 'status', 409)));
+    expect(b.shared.singleWhere((e) => e.id == group.id).name, 'First writer');
+    expect((await a.detail(group.id)).name, 'First writer');
+    print(
+        'PASS real role visibility, support HTTP 403/404, two-session 409, local migration committed');
+
+    final invalid = local('failed');
+    await invalid.create('t-support2', 'A valid', ['791013223']);
+    await invalid.create('t-support2', 'B oversized',
+        List.generate(501, (i) => (790000000 + i).toString()));
+    final failed = session('t-support2', 'failed', groups: invalid);
+    try {
+      await failed.start();
+    } on OpsError catch (_) {}
+    expect(failed.problem, isNotNull);
+    expect((await invalid.list('t-support2')).length, 2);
+    final checkClient = HttpClient()..findProxy = (_) => 'DIRECT';
+    addTearDown(() => checkClient.close(force: true));
+    final req = await checkClient.getUrl(origin.resolve('/ops/v1/me/groups'));
+    req.headers.set('authorization', 'Bearer ${cfg['tokens']['t-support2']}');
+    final response = await req.close();
+    expect(response.statusCode, 200);
+    expect(jsonDecode(await utf8.decoder.bind(response).join())['groups'],
+        isEmpty);
+    print(
+        'PASS failed import retained both local groups; independent server read confirmed rollback');
+
+    await until(() => link.connections.isNotEmpty, 'no initial SSE channel');
+    final current = await a.detail(group.id);
+    await a.write('PATCH', 'groups/${group.id}',
+        version: current.version, body: {'name': 'SSE observed'});
+    await until(() => b.shared.any((e) => e.name == 'SSE observed'),
+        'SSE did not refresh second client');
+    final full = link.fullLists, private = link.privateLists;
+    link.cut();
+    try {
+      await b.refresh();
+    } catch (_) {}
+    await until(() => !b.online, 'second client did not enter offline state');
+    expect(b.serverTime, isNotNull);
+    expect(b.shared.any((e) => e.name == 'SSE observed'), isTrue);
+    final writes = link.writes;
+    await expectLater(
+        b.write('POST', 'groups',
+            body: {'name': 'Offline write', 'owner': 't-support'}),
+        throwsA(isA<OpsError>()));
+    expect(link.writes, writes);
+    final reopened = session('t-admin2', 'b', via: link.origin);
+    await reopened.start();
+    expect(reopened.online, isFalse);
+    expect(reopened.serverTime, isNotNull);
+    expect(reopened.shared.any((e) => e.name == 'SSE observed'), isTrue);
+    print('PASS offline cached snapshot survives client reopen; edit rejected');
+    await a.write('PATCH', 'groups/${group.id}',
+        version: (await a.detail(group.id)).version,
+        body: {'name': 'Missed change'});
+    await File('${temp.path}/expire.request')
+        .writeAsString(support.mine.single.id);
+    await until(() => File('${temp.path}/expire.done').existsSync(),
+        'fixture did not expire event retention window');
+    link.available = true;
+    await until(
+        () => link.cursors.any((cursor) => cursor != null && cursor.isNotEmpty),
+        'reconnect did not supply Last-Event-ID');
+    await until(
+        () => b.online && b.shared.any((e) => e.name == 'Missed change'),
+        'reconnect missed a server-side change');
+    expect(link.fullLists, greaterThan(full));
+    expect(link.privateLists, greaterThan(private));
+    print(
+        'PASS live SSE refresh, resumed Last-Event-ID and full-list recovery across expired window');
+  }, timeout: const Timeout(Duration(minutes: 4)));
+}
