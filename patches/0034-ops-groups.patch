+++ b/flutter/lib/steaddesk/shared_profiles.dart
@@ -0,0 +1,62 @@
+// rustdesk-api v2.7 returns the entire list with total=0, including data=null
+// when there are no shared profiles. Other compatible issuers may paginate.
+class SharedProfilePages {
+  final profiles = <String, Map<String, dynamic>>{};
+  int? expected;
+
+  bool add(Map<String, dynamic> page) {
+    final total = page['total'];
+    final rows = page['data'];
+    if (total is! int ||
+        total < 0 ||
+        !page.containsKey('data') ||
+        (expected != null && expected != total) ||
+        !(rows is List || (rows == null && total == 0))) {
+      throw const FormatException('Invalid shared profile listing');
+    }
+    expected = total;
+    for (final row in (rows as List? ?? const [])) {
+      if (row is! Map<String, dynamic> ||
+          row['guid'] is! String ||
+          (row['guid'] as String).isEmpty ||
+          row['name'] is! String ||
+          (row['name'] as String).isEmpty ||
+          profiles.containsKey(row['guid'])) {
+        throw const FormatException('Invalid or repeated shared profile');
+      }
+      profiles[row['guid']] = Map.of(row);
+    }
+    if (total > 0 && (profiles.length > total || (rows as List).isEmpty)) {
+      throw const FormatException('Incomplete shared profile listing');
+    }
+    return total == 0 || profiles.length == total;
+  }
+
+  // Upstream addresses its in-memory books by name. Give equal display names
+  // separate slots, including when a shared book has the reserved personal name.
+  Iterable<Map<String, dynamic>> named(String personalName) sync* {
+    final used = {personalName};
+    for (final id in profiles.keys.toList()..sort()) {
+      final profile = profiles[id]!;
+      var name = profile['name'] as String;
+      while (!used.add(name)) {
+        name = '$name [$id]';
+      }
+      yield {...profile, 'name': name};
+    }
+  }
+}
+
+// Remove an entire cached book (including its in-memory peer credentials) when
+// the confirmed GUID changes, even if its display name was immediately reused.
+bool pruneSharedBooks<T>(Map<String, T> books, Map<String, String> allowed,
+    String? Function(T) guid, void Function(T) discard) {
+  var changed = false;
+  books.removeWhere((name, book) {
+    if (allowed.containsKey(name) && allowed[name] == guid(book)) return false;
+    discard(book);
+    changed = true;
+    return true;
+  });
+  return changed;
+}
