diff --git a/flutter/lib/steaddesk/fixed/merchant.dart b/flutter/lib/steaddesk/fixed/merchant.dart
new file mode 100644
index 0000000..da1e620
--- /dev/null
+++ b/flutter/lib/steaddesk/fixed/merchant.dart
@@ -0,0 +1,127 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:ffi';
+import 'dart:io';
+import 'dart:isolate';
+import 'package:ffi/ffi.dart';
+import 'package:flutter/material.dart';
+import '../../common.dart' show translate;
+import 'protocol.dart';
+
+typedef _Native = UintPtr Function(
+    Pointer<Uint8>, UintPtr, Pointer<Uint8>, UintPtr);
+typedef _Invoke = int Function(Pointer<Uint8>, int, Pointer<Uint8>, int);
+
+FixedJson? _native(String input) {
+  final lib = DynamicLibrary.open(
+      Platform.isWindows ? 'librustdesk.dll' : 'librustdesk.so');
+  final invoke = lib.lookupFunction<_Native, _Invoke>('steaddesk_fixed_notice');
+  final data = utf8.encode(input);
+  return using((arena) {
+    final src = arena<Uint8>(data.length)
+      ..asTypedList(data.length).setAll(0, data);
+    final dst = arena<Uint8>(2048);
+    final n = invoke(src, data.length, dst, 2048);
+    return n > 0 && n <= 2048
+        ? jsonDecode(utf8.decode(dst.asTypedList(n))) as FixedJson
+        : null;
+  });
+}
+
+Future<FixedJson?> _call(String input) => Isolate.run(() => _native(input));
+
+const fixedMerchantEnabled = true;
+typedef FixedNoticeCall = Future<FixedJson?> Function(String);
+Future<void> _release(FixedNoticeCall call) async {
+  try {
+    await call('release');
+  } catch (_) {}
+}
+
+Widget fixedMerchantNotice() => const FixedMerchantNotice();
+
+class FixedMerchantNotice extends StatefulWidget {
+  final FixedNoticeCall call;
+  final String Function(String)? label;
+  const FixedMerchantNotice({super.key, this.call = _call, this.label});
+  @override
+  State<FixedMerchantNotice> createState() => _NoticeState();
+}
+
+class _NoticeState extends State<FixedMerchantNotice>
+    with WidgetsBindingObserver {
+  FixedOffer? offer;
+  Timer? timer;
+  bool busy = false;
+  int revision = 0;
+  bool get visible =>
+      mounted &&
+      WidgetsBinding.instance.lifecycleState == AppLifecycleState.resumed &&
+      ModalRoute.of(context)?.isCurrent == true;
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    timer = Timer.periodic(const Duration(seconds: 3), (_) => tick());
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state != AppLifecycleState.resumed) {
+      revision++;
+      unawaited(_release(widget.call));
+      if (offer != null && mounted) setState(() => offer = null);
+    }
+  }
+
+  @override
+  void dispose() {
+    revision++;
+    unawaited(_release(widget.call));
+    timer?.cancel();
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  Future<void> tick() async {
+    if (busy || !visible) return;
+    busy = true;
+    final generation = revision;
+    bool active() => visible && revision == generation;
+    try {
+      final row = await widget.call('poll');
+      if (!active() ||
+          row == null ||
+          !fixedFields(row, {'id', 'action', 'target_label', 'link'})) return;
+      final link = row.remove('link');
+      final found = FixedOffer.parse(row);
+      if (found == null || link is! String) return;
+      setState(() => offer = found);
+      await WidgetsBinding.instance.endOfFrame;
+      await Future<void>.delayed(const Duration(seconds: 2));
+      if (!active() || offer != found) return;
+      await widget.call(jsonEncode({'id': found.id, 'link': link}));
+    } catch (_) {
+      // A later poll may discover a new offer. Never repeat the permit or action.
+    } finally {
+      busy = false;
+      if (mounted && offer != null) setState(() => offer = null);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final item = offer;
+    if (item == null) return const SizedBox.shrink();
+    return Semantics(
+        liveRegion: true,
+        child: Material(
+            color: const Color(0xffffe6a7),
+            child: Padding(
+                padding: const EdgeInsets.all(14),
+                child: Text(
+                    '${(widget.label ?? (key) => translate(key))(item.action.notice)}\n${item.label}',
+                    style: const TextStyle(
+                        color: Colors.black, fontWeight: FontWeight.bold)))));
+  }
+}
