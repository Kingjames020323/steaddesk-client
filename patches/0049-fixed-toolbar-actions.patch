+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/fixed_build.dart';
+import 'package:flutter_hbb/steaddesk/fixed/protocol.dart';
+import 'package:flutter_hbb/steaddesk/toolbar/actions.dart';
+import 'package:flutter_hbb/steaddesk/toolbar/host.dart';
+
+void main() {
+  test('read-only toolbar and fixed actions expose only the opted-in entries',
+      () {
+    final entries = toolbarMenuEntries(() => true, 'Windows', [])
+        .whereType<PopupMenuItem<Object>>();
+    expect(entries.map((e) => e.value).whereType<ToolbarAction>().toList(),
+        readToolbarEnabled ? ToolbarAction.values : []);
+    expect(entries.map((e) => e.value).whereType<FixedAction>().toList(),
+        fixedSupportEnabled ? FixedAction.values : []);
+    for (final e in entries.where((e) => e.value is FixedAction)) {
+      expect(e.enabled, isFalse);
+      expect((e.child as Text).data, contains('此设备不支持'));
+    }
+    if (!readToolbarEnabled) {
+      expect(toolbarEnabled, isFalse);
+      expect(
+          toolbarCaseAttachments(
+              account: 'fixture', peer: '123456789', caseId: 'fixture'),
+          isA<SizedBox>());
+    }
+    expect(sessionToolbarEnabled, readToolbarEnabled || fixedSupportEnabled);
+  });
+}
