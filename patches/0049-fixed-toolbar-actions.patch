diff --git a/flutter/lib/steaddesk/fixed/protocol.dart b/flutter/lib/steaddesk/fixed/protocol.dart
new file mode 100644
index 0000000..ef759a2
--- /dev/null
+++ b/flutter/lib/steaddesk/fixed/protocol.dart
@@ -0,0 +1,114 @@
+typedef FixedJson = Map<String, dynamic>;
+
+enum FixedAction {
+  restartPos('restart_pos', '重启 POS 应用', 'Support is restarting the POS app.'),
+  reconnect('reconnect_printer', '重新建立 SteadDesk 打印连接',
+      'Support is reconnecting SteadDesk to the printer.'),
+  printTest('print_test', '打印测试页', 'Support is printing a test page.'),
+  settings('open_settings', '打开网络设置', 'Support is opening network settings.'),
+  reboot('reboot', '重启设备', 'Support is restarting this device.');
+
+  const FixedAction(this.wire, this.label, this.notice);
+  final String wire, label, notice;
+  static FixedAction? parse(Object? value) {
+    for (final entry in values) {
+      if (entry.wire == value) return entry;
+    }
+    return null;
+  }
+
+  bool get printer => this == reconnect || this == printTest;
+}
+
+final _record = RegExp(r'^[0-9A-HJKMNP-TV-Z]{26}$');
+bool fixedId(Object? value, String prefix) =>
+    value is String &&
+    value.startsWith(prefix) &&
+    _record.hasMatch(value.substring(prefix.length));
+bool fixedPeer(Object? value) =>
+    value is String && RegExp(r'^[0-9]{9,10}$').hasMatch(value);
+bool _label(Object? value) =>
+    value is String &&
+    value.trim().isNotEmpty &&
+    value.length <= 200 &&
+    !RegExp(r'[\x00-\x1f\x7f]').hasMatch(value);
+bool fixedFields(Object? value, Set<String> keys) =>
+    value is Map &&
+    value.length == keys.length &&
+    keys.every(value.containsKey);
+
+class FixedOption {
+  final FixedAction action;
+  final String target, label;
+  const FixedOption(this.action, this.target, this.label);
+  static List<FixedOption>? options(FixedJson reply) {
+    if (!fixedFields(reply, {'available', 'options'}) ||
+        reply['available'] != true) return null;
+    final rows = reply['options'];
+    if (rows is! List || rows.length > 512) return null;
+    final found = <FixedOption>[];
+    for (final row in rows) {
+      if (!fixedFields(row, {'action', 'target', 'label'}) ||
+          !fixedId(row['target'], 'i_') ||
+          !_label(row['label'])) return null;
+      final a = FixedAction.parse(row['action']);
+      if (a == null) return null;
+      found.add(FixedOption(a, row['target'], row['label']));
+    }
+    return found;
+  }
+}
+
+typedef FixedRequest = Future<FixedJson> Function(String, String, [FixedJson?]);
+Future<void> submitFixed(
+    FixedRequest request,
+    String route,
+    String peer,
+    FixedOption option,
+    Future<bool> Function(int) confirm,
+    Future<bool> Function() current,
+    {String? ticket}) async {
+  if (!fixedPeer(peer) ||
+      !fixedId(option.target, 'i_') ||
+      !await current() ||
+      !await confirm(1) ||
+      !await current()) return;
+  final created = await request('POST', '$route/fixed-actions', {
+    'peer_id': peer,
+    'action': option.action.wire,
+    'target': option.target,
+    if (ticket != null) 'ticket_id': ticket
+  });
+  if (!fixedId(created['id'], 't_')) throw const FormatException('无效的操作编号。');
+  if (option.action != FixedAction.reboot) {
+    if (created['state'] != 'queued') throw const FormatException('操作状态未确认。');
+    return;
+  }
+  if (created['state'] != 'confirm_again') {
+    throw const FormatException('缺少重启设备的第二次确认。');
+  }
+  if (await current() && await confirm(2) && await current()) {
+    final result = await request(
+        'POST', "$route/fixed-actions/${created['id']}/confirm", {});
+    if (result['state'] != 'queued' || result['id'] != created['id']) {
+      throw const FormatException('重启请求状态未确认。');
+    }
+  }
+}
+
+class FixedOffer {
+  final String id, label;
+  final FixedAction action;
+  const FixedOffer(this.id, this.label, this.action);
+  static FixedOffer? parse(Object? row) {
+    if (!fixedFields(row, {'id', 'action', 'target_label'})) return null;
+    final map = row as Map;
+    final a = FixedAction.parse(map['action']);
+    if (!fixedId(map['id'], 't_') ||
+        !_label(map['target_label']) ||
+        a == null) {
+      return null;
+    }
+    return FixedOffer(map['id'], map['target_label'], a);
+  }
+}
