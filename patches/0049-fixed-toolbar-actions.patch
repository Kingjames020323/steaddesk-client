@@ -0,0 +1,146 @@
+// Windows interactive merchant process. Only the signed inventory AUMID reaches this adapter.
+#define WIN32_LEAN_AND_MEAN
+#ifndef _WIN32_WINNT
+#define _WIN32_WINNT 0x0A00
+#endif
+#include <windows.h>
+#include <appmodel.h>
+#include <restartmanager.h>
+#include <shellapi.h>
+#include <tlhelp32.h>
+#include <cwctype>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace {
+struct Handle {
+    HANDLE value;
+    explicit Handle(HANDLE h) : value(h) {}
+    ~Handle() { if (value && value != INVALID_HANDLE_VALUE) CloseHandle(value); }
+    Handle(const Handle&) = delete;
+    Handle& operator=(const Handle&) = delete;
+};
+
+bool foreground() {
+    HWND hwnd = GetForegroundWindow();
+    DWORD pid = 0;
+    return hwnd && IsWindowVisible(hwnd) && !IsIconic(hwnd) &&
+        GetWindowThreadProcessId(hwnd, &pid) && pid == GetCurrentProcessId();
+}
+bool privilege() {
+    HANDLE raw;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &raw)) return false;
+    Handle token(raw);
+    PRIVILEGE_SET wanted{};
+    wanted.PrivilegeCount = 1;
+    wanted.Control = PRIVILEGE_SET_ALL_NECESSARY;
+    if (!LookupPrivilegeValueW(nullptr, SE_SHUTDOWN_NAME, &wanted.Privilege[0].Luid)) return false;
+    wanted.Privilege[0].Attributes = SE_PRIVILEGE_ENABLED;
+    BOOL enabled = FALSE;
+    return PrivilegeCheck(token.value, &wanted, &enabled) && enabled;
+}
+bool sameUser(HANDLE process) {
+    auto identity = [](HANDLE proc, std::vector<BYTE>& storage) {
+        HANDLE raw;
+        if (!OpenProcessToken(proc, TOKEN_QUERY, &raw)) return false;
+        Handle token(raw);
+        DWORD size = 0;
+        GetTokenInformation(raw, TokenUser, nullptr, 0, &size);
+        if (!size || size > 65536) return false;
+        storage.resize(size);
+        return GetTokenInformation(raw, TokenUser, storage.data(), size, &size) != FALSE;
+    };
+    std::vector<BYTE> caller, owner;
+    return identity(GetCurrentProcess(), caller) && identity(process, owner) &&
+        EqualSid(reinterpret_cast<TOKEN_USER*>(caller.data())->User.Sid,
+                 reinterpret_cast<TOKEN_USER*>(owner.data())->User.Sid);
+}
+
+bool eligible(HANDLE process, const wchar_t* registered) {
+    wchar_t aumid[256]{};
+    UINT32 len = static_cast<UINT32>(sizeof(aumid)/sizeof(*aumid));
+    if (GetApplicationUserModelId(process,&len,aumid) != ERROR_SUCCESS || wcscmp(aumid,registered)!=0) return false;
+    wchar_t full[256]{};
+    len = static_cast<UINT32>(sizeof(full)/sizeof(*full));
+    if (GetPackageFullName(process,&len,full) != ERROR_SUCCESS) return false;
+    using OriginFn = LONG(WINAPI*)(PCWSTR, PackageOrigin*);
+    const FARPROC entry=GetProcAddress(GetModuleHandleW(L"kernelbase.dll"),"GetStagedPackageOrigin");
+    OriginFn originFn=nullptr;
+    static_assert(sizeof(entry)==sizeof(originFn),"Windows procedure pointer size");
+    std::memcpy(&originFn,&entry,sizeof(originFn));
+    PackageOrigin origin=PackageOrigin_Unknown;
+    if (!originFn || originFn(full,&origin)!=ERROR_SUCCESS ||
+        (origin!=PackageOrigin_Store && origin!=PackageOrigin_DeveloperSigned && origin!=PackageOrigin_LineOfBusiness)) return false;
+    std::wstring normalized(aumid);
+    for (auto& ch:normalized) ch=static_cast<wchar_t>(towlower(ch));
+    if (normalized.rfind(L"microsoft.",0)==0 || normalized.rfind(L"windows.",0)==0 ||
+        normalized.find(L"_cw5n1h2txyewy!")!=std::wstring::npos ||
+        normalized.find(L"_8wekyb3d8bbwe!")!=std::wstring::npos ||
+        normalized.find(L"_49e5m5gk8mf0t!")!=std::wstring::npos) return false;
+    // Restart Manager checks registration via bRestartable and RmShutdownOnlyRegistered.
+    // No caller-provided or application-registered command line is read here.
+    return sameUser(process);
+}
+typedef int (*Guard)(const void*);
+bool matchProcess(const wchar_t* aumid, RM_UNIQUE_PROCESS& target) {
+    DWORD session=0;
+    if (!ProcessIdToSessionId(GetCurrentProcessId(), &session) || !session) return false;
+    Handle snapshot(CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS,0));
+    if (snapshot.value==INVALID_HANDLE_VALUE) return false;
+    PROCESSENTRY32W row{};row.dwSize=sizeof(row);
+    if (!Process32FirstW(snapshot.value,&row)) return false;
+    bool found=false;
+    do {
+        DWORD other=0;
+        if(row.th32ProcessID==GetCurrentProcessId() || !ProcessIdToSessionId(row.th32ProcessID,&other) || other!=session) continue;
+        Handle proc(OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION,FALSE,row.th32ProcessID));
+        if(!proc.value || !eligible(proc.value,aumid)) continue;
+        FILETIME exited{},kernel{},user{};
+        if(found || !GetProcessTimes(proc.value,&target.ProcessStartTime,&exited,&kernel,&user)) return false;
+        target.dwProcessId=row.th32ProcessID;
+        found=true;
+    } while(Process32NextW(snapshot.value,&row));
+    return found && GetLastError()==ERROR_NO_MORE_FILES;
+}
+int registeredPos(const wchar_t* id,Guard guard,const void* scope,bool inspect) {
+    RM_UNIQUE_PROCESS target{};
+    if (!id || !*id || !matchProcess(id,target)) return 2;
+    DWORD handle=0;
+    wchar_t key[CCH_RM_SESSION_KEY+1]{};
+    if(RmStartSession(&handle,0,key)!=ERROR_SUCCESS) return 2;
+    struct Session {DWORD id; ~Session(){RmEndSession(id);}} session{handle};
+    if(RmRegisterResources(handle,0,nullptr,1,&target,0,nullptr)!=ERROR_SUCCESS) return 2;
+    UINT needed=0,count=1;
+    DWORD reasons=0;
+    RM_PROCESS_INFO process{};
+    if(RmGetList(handle,&needed,&count,&process,&reasons)!=ERROR_SUCCESS || count!=1 || reasons ||
+       process.Process.dwProcessId!=target.dwProcessId || CompareFileTime(&process.Process.ProcessStartTime,&target.ProcessStartTime)!=0 ||
+       !process.bRestartable || process.ApplicationType!=RmMainWindow) return 2;
+    if(inspect) return foreground()?1:2;
+    if(!guard(scope) || !foreground()) return 3;
+    if(RmShutdown(handle,RmShutdownOnlyRegistered,nullptr)!=ERROR_SUCCESS) return 0;
+    // Restart is the recovery half of the same cooperative operation.
+    return RmRestart(handle,0,nullptr)==ERROR_SUCCESS ? 1 : 0;
+}
+}
+extern "C" int sd_fixed_foreground(){return foreground()?1:0;}
+extern "C" int sd_fixed_pos_supported(const wchar_t* package){
+    return foreground() && registeredPos(package,nullptr,nullptr,true)==1 ? 1 : 0;
+}
+extern "C" int sd_fixed_capability(int action){
+    if(!foreground() || action<0 || action>4) return 0;
+    if(action==4) return privilege()?1:0;
+    return 1;
+}
+extern "C" int sd_fixed_windows(int action,const wchar_t* package, Guard guard,const void* scope) {
+    if (!guard || !scope || !guard(scope) || !foreground()) return 3;
+    switch(action){
+        case 0:return registeredPos(package,guard,scope,false);
+        case 3:return reinterpret_cast<INT_PTR>(ShellExecuteW(nullptr,L"open",L"ms-settings:network-status",nullptr,nullptr,SW_SHOWNORMAL))>32?1:0;
+        case 4:
+            if(!privilege()) return 2;
+            return ExitWindowsEx(EWX_REBOOT,SHTDN_REASON_MAJOR_APPLICATION|SHTDN_REASON_MINOR_MAINTENANCE|SHTDN_REASON_FLAG_PLANNED)?1:0;
+        default:return 2;
+    }
+}
