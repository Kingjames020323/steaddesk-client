+//! Scoped merchant control plane. The UI can only poll and acknowledge its visible offer.
+use hbb_common::config::Config;
+use reqwest::{blocking::Client, redirect::Policy, Url};
+use serde_derive::Deserialize;
+use serde_json::{json, Value};
+use std::{
+    collections::{BTreeMap, HashSet},
+    io::{Read, Write},
+    net::{Ipv4Addr, SocketAddr, TcpStream},
+    panic::catch_unwind,
+    slice,
+    sync::{Mutex, OnceLock},
+    time::Duration,
+};
+
+const IDENTITY: &str = "/ops/v1/device/update-identity";
+const POLL: &str = "/ops/v1/device/fixed-poll";
+const PERMIT: &str = "/ops/v1/device/fixed-permit";
+const RESULT: &str = "/ops/v1/device/fixed-result";
+const ACTIONS: [&str; 5] = [
+    "restart_pos",
+    "reconnect_printer",
+    "print_test",
+    "open_settings",
+    "reboot",
+];
+const PAGE: &[u8] = b"SteadDesk printer test\n\n\n";
+#[cfg(target_os = "android")]
+const PLATFORM: &str = "android";
+#[cfg(windows)]
+const PLATFORM: &str = "windows";
+
+#[derive(Clone, PartialEq)]
+struct Scope {
+    origin: Url,
+    device: String,
+    peer: String,
+    link: String,
+    restart: bool,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Offer {
+    id: String,
+    action: String,
+    target_label: String,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PollReply {
+    job: Option<Offer>,
+    pos_package: Option<String>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Permit {
+    id: String,
+    action: String,
+    target: Target,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Target {
+    id: String,
+    #[serde(rename = "type")]
+    kind: String,
+    ip: Ipv4Addr,
+    package: Option<String>,
+}
+struct Pending {
+    scope: Scope,
+    offer: Offer,
+    version: u64,
+}
+#[derive(Default)]
+struct Ledger {
+    link: String,
+    spent: HashSet<String>,
+    pending: Option<Pending>,
+    profile: Option<(Scope, String)>,
+}
+impl Ledger {
+    fn offer(&mut self, pending: Pending) -> bool {
+        if self.link != pending.scope.link {
+            self.link = pending.scope.link.clone();
+            self.spent.clear();
+            self.pending = None;
+        }
+        if self.spent.len() >= 512 || self.spent.contains(&pending.offer.id) {
+            return false;
+        }
+        self.pending = Some(pending);
+        true
+    }
+    fn consume(&mut self, id: &str, link: &str) -> Option<Pending> {
+        if self.link != link || !self.pending.as_ref().is_some_and(|p| p.offer.id == id) {
+            return None;
+        }
+        let p = self.pending.take()?;
+        self.spent.insert(p.offer.id.clone());
+        Some(p)
+    }
+}
+fn ledger() -> &'static Mutex<Ledger> {
+    static STATE: OnceLock<Mutex<Ledger>> = OnceLock::new();
+    STATE.get_or_init(|| Mutex::new(Ledger::default()))
+}
+
+fn valid_id(s: &str, prefix: &str) -> bool {
+    s.strip_prefix(prefix).is_some_and(|id| {
+        id.len() == 26
+            && id
+                .bytes()
+                .all(|c| b"0123456789ABCDEFGHJKMNPQRSTVWXYZ".contains(&c))
+    })
+}
+fn peer(s: &str) -> bool {
+    (9..=10).contains(&s.len()) && s.bytes().all(|b| b.is_ascii_digit())
+}
+
+#[cfg(windows)]
+fn unpaused() -> bool {
+    use crate::ipc::{connect, Data};
+    use hbb_common::tokio;
+    // Query the live service. The ordinary option getter falls back to cached settings.
+    #[tokio::main(flavor = "current_thread")]
+    async fn read() -> Option<bool> {
+        let mut ipc = connect(700, "").await.ok()?;
+        ipc.send(&Data::Options(None)).await.ok()?;
+        match ipc.next_timeout(700).await.ok()? {
+            Some(Data::Options(Some(options))) => Some(
+                options
+                    .get("stop-service")
+                    .map_or(true, |v| v.is_empty() || v == "N"),
+            ),
+            _ => None,
+        }
+    }
+    read() == Some(true)
+}
+#[cfg(target_os = "android")]
+fn unpaused() -> bool {
+    ["steaddesk_remote_paused", "steaddesk_fixed_peer_stopped"]
+        .iter()
+        .all(|key| {
+            scrap::android::call_main_service_get_by_name(key)
+                .ok()
+                .as_deref()
+                == Some("false")
+        })
+}
+
+#[cfg(windows)]
+extern "C" {
+    fn sd_fixed_foreground() -> i32;
+    fn sd_fixed_capability(action: i32) -> i32;
+    fn sd_fixed_pos_supported(package: *const u16) -> i32;
+    fn sd_fixed_windows(
+        action: i32,
+        package: *const u16,
+        guard: extern "C" fn(*const std::ffi::c_void) -> i32,
+        scope: *const std::ffi::c_void,
+    ) -> i32;
+}
+#[cfg(target_os = "android")]
+fn android(name: &str) -> bool {
+    scrap::android::call_main_service_get_by_name(name)
+        .ok()
+        .as_deref()
+        == Some("true")
+}
+fn foreground() -> bool {
+    #[cfg(windows)]
+    {
+        unsafe { sd_fixed_foreground() == 1 }
+    }
+    #[cfg(target_os = "android")]
+    {
+        android("steaddesk_fixed_visible")
+    }
+}
+fn scope(visible: bool) -> Option<Scope> {
+    if (visible && !foreground()) || !unpaused() {
+        return None;
+    }
+    let (support, link, restart) = crate::ui_cm_interface::fixed_desktop_connection()?;
+    let origin = Url::parse(&Config::get_option("api-server")).ok()?;
+    let device = Config::get_id_or(String::new());
+    if !peer(&device)
+        || !peer(&support)
+        || origin.scheme() != "https"
+        || origin.host().is_none()
+        || !origin.username().is_empty()
+        || origin.password().is_some()
+        || origin.query().is_some()
+        || origin.fragment().is_some()
+        || origin.path() != "/"
+    {
+        return None;
+    }
+    Some(Scope {
+        origin,
+        device,
+        peer: support,
+        link,
+        restart,
+    })
+}
+fn current(s: &Scope) -> bool {
+    scope(true).as_ref() == Some(s)
+}
+fn supports(s: &Scope, a: &str) -> bool {
+    if !ACTIONS.contains(&a) || a == "reboot" && !s.restart {
+        return false;
+    }
+    #[cfg(windows)]
+    {
+        ACTIONS
+            .iter()
+            .position(|x| *x == a)
+            .is_some_and(|n| unsafe { sd_fixed_capability(n as i32) == 1 })
+    }
+    #[cfg(target_os = "android")]
+    {
+        matches!(a, "reconnect_printer" | "print_test")
+            || a == "open_settings" && android("steaddesk_fixed_settings_supported")
+    }
+}
+fn valid_package(p: &str) -> bool {
+    let Some((family, app)) = p.split_once('!') else {
+        return false;
+    };
+    let Some((name, publisher)) = family.rsplit_once('_') else {
+        return false;
+    };
+    p.len() <= 128
+        && !name.is_empty()
+        && !app.is_empty()
+        && publisher.len() == 13
+        && publisher.bytes().all(|b| b.is_ascii_alphanumeric())
+        && [name, app].iter().all(|s| {
+            s.bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b".-".contains(&b))
+        })
+}
+#[cfg(windows)]
+fn pos_supported(package: &str) -> bool {
+    if !valid_package(package) {
+        return false;
+    }
+    let wide: Vec<_> = package.encode_utf16().chain(Some(0)).collect();
+    unsafe { sd_fixed_pos_supported(wide.as_ptr()) == 1 }
+}
+#[cfg(target_os = "android")]
+fn pos_supported(_: &str) -> bool {
+    false
+}
+fn client() -> Option<Client> {
+    Client::builder()
+        .redirect(Policy::none())
+        .no_proxy()
+        .connect_timeout(Duration::from_secs(3))
+        .timeout(Duration::from_secs(7))
+        .build()
+        .ok()
+}
+fn request(c: &Client, s: &Scope, path: &'static str, body: Value, version: u64) -> Option<Value> {
+    let method = match path {
+        IDENTITY if version == 0 && body == json!({}) => "GET",
+        POLL | PERMIT | RESULT
+            if version > 0 && body["peer_id"] == s.peer && body["link"] == s.link =>
+        {
+            "POST"
+        }
+        _ => return None,
+    };
+    if scope(path != RESULT).as_ref() != Some(s) {
+        return None;
+    }
+    let canonical: BTreeMap<_, _> = body.as_object()?.iter().collect();
+    let signed =
+        super::steaddesk_device_signature::sign(&s.device, version, |id, stamp, nonce| {
+            let mut bytes = b"SteadDesk-fleet-v1\0".to_vec();
+            bytes.extend(
+                serde_json::to_vec(&(method, path, &canonical, id, version, stamp, nonce)).ok()?,
+            );
+            Some(bytes)
+        })?;
+    let url = s.origin.join(path).ok()?;
+    let mut req = if method == "GET" {
+        c.get(url)
+    } else {
+        c.post(url).json(&body)
+    };
+    for (k, v) in serde_json::from_slice::<BTreeMap<String, String>>(&signed).ok()? {
+        req = req.header(k, v)
+    }
+    let r = req.send().ok()?;
+    if !r.status().is_success() {
+        return None;
+    }
+    let mut data = Vec::new();
+    r.take(8193).read_to_end(&mut data).ok()?;
+    if data.len() > 8192 {
+        return None;
+    }
+    serde_json::from_slice(&data).ok()
+}
+
+fn poll() -> Option<Value> {
+    let Some(s) = scope(true) else {
+        release_printer();
+        return None;
+    };
+    if let Ok(mut held) = PRINTER.lock() {
+        if held.as_ref().is_some_and(|p| p.binding.scope != s) {
+            held.take();
+        }
+    }
+    let c = client()?;
+    let v = request(&c, &s, IDENTITY, json!({}), 0)?["key_version"].as_u64()?;
+    let previous = ledger().lock().ok()?.profile.clone();
+    let checked = previous.and_then(|(owner, p)| (owner == s && pos_supported(&p)).then_some(p));
+    let mut caps: Vec<_> = ACTIONS
+        .iter()
+        .filter(|x| **x != "restart_pos" && supports(&s, x))
+        .copied()
+        .collect();
+    let mut body = json!({"peer_id":s.peer,"link":s.link,"platform":PLATFORM,"capabilities":caps});
+    if let Some(candidate) = checked.as_ref() {
+        caps.push("restart_pos");
+        body["capabilities"] = json!(caps);
+        body["pos_package"] = json!(candidate);
+    }
+    let reply = request(&c, &s, POLL, body, v)?;
+    let offered: PollReply = serde_json::from_value(reply).ok()?;
+    let package = offered
+        .pos_package
+        .filter(|p| PLATFORM == "windows" && valid_package(p));
+    ledger().lock().ok()?.profile = package.clone().map(|p| (s.clone(), p));
+    let job = offered.job?;
+    if !valid_id(&job.id, "t_")
+        || (job.action == "restart_pos" && (checked.is_none() || checked != package))
+        || !supports(&s, &job.action)
+        || job.target_label.trim().is_empty()
+        || job.target_label.len() > 600
+        || job.target_label.chars().any(char::is_control)
+        || !current(&s)
+    {
+        return None;
+    }
+    let out =
+        json!({"id":job.id,"action":job.action,"target_label":job.target_label,"link":s.link});
+    if ledger().lock().ok()?.offer(Pending {
+        scope: s,
+        offer: job,
+        version: v,
+    }) {
+        Some(out)
+    } else {
+        None
+    }
+}
+
+fn validate(t: &Target, a: &str) -> bool {
+    if !valid_id(&t.id, "i_") || !t.ip.is_private() {
+        return false;
+    }
+    if matches!(a, "reconnect_printer" | "print_test") {
+        return t.kind == "printer" && t.package.is_none();
+    }
+    if t.kind != "host" {
+        return false;
+    }
+    match (a, t.package.as_deref()) {
+        ("restart_pos", Some(p)) => valid_package(p),
+        ("open_settings" | "reboot", None) => true,
+        _ => false,
+    }
+}
+
+#[derive(PartialEq, Clone)]
+struct PrinterBinding {
+    scope: Scope,
+    target: String,
+    addr: SocketAddr,
+}
+struct OwnedPrinter {
+    binding: PrinterBinding,
+    stream: TcpStream,
+    opened: std::time::Instant,
+}
+static PRINTER: Mutex<Option<OwnedPrinter>> = Mutex::new(None);
+const PRINTER_TTL: Duration = Duration::from_secs(600);
+
+pub(crate) fn release_printer() {
+    if let Ok(mut session) = PRINTER.lock() {
+        session.take();
+    }
+}
+
+fn printer(s: &Scope, t: &Target, print: bool) -> &'static str {
+    let binding = PrinterBinding {
+        scope: s.clone(),
+        target: t.id.clone(),
+        addr: SocketAddr::from((t.ip, 9100)),
+    };
+    let mut slot = match PRINTER.lock() {
+        Ok(slot) => slot,
+        Err(_) => return "failed",
+    };
+    let result = transfer_printer(
+        &mut slot,
+        &binding,
+        || TcpStream::connect_timeout(&binding.addr, Duration::from_secs(2)),
+        || current(s),
+        print,
+    );
+    if !print && result == "completed" {
+        let Some(opened) = slot.as_ref().map(|p| p.opened) else {
+            return "failed";
+        };
+        if std::thread::Builder::new()
+            .name("fixed-printer-expiry".into())
+            .spawn(move || {
+                std::thread::sleep(PRINTER_TTL);
+                if let Ok(mut held) = PRINTER.lock() {
+                    if held.as_ref().is_some_and(|p| p.opened == opened) {
+                        held.take();
+                    }
+                }
+            })
+            .is_err()
+        {
+            slot.take();
+            return "failed";
+        }
+    }
+    result
+}
+
+fn transfer_printer(
+    slot: &mut Option<OwnedPrinter>,
+    binding: &PrinterBinding,
+    dial: impl FnOnce() -> std::io::Result<TcpStream>,
+    allowed: impl Fn() -> bool,
+    print: bool,
+) -> &'static str {
+    // Taking ownership before every attempt means an uncertain write can never fall back to a second connection.
+    let previous = slot
+        .take()
+        .filter(|p| p.binding == *binding && p.opened.elapsed() < PRINTER_TTL);
+    if !allowed() {
+        return "cancelled";
+    }
+    if !print {
+        drop(previous);
+        let Ok(stream) = dial() else { return "failed" };
+        if !allowed() {
+            return "cancelled";
+        }
+        *slot = Some(OwnedPrinter {
+            binding: binding.clone(),
+            stream,
+            opened: std::time::Instant::now(),
+        });
+        return "completed";
+    }
+    let mut stream = match previous {
+        Some(p) => p.stream,
+        None => match dial() {
+            Ok(stream) => stream,
+            Err(_) => return "failed",
+        },
+    };
+    if !allowed() {
+        return "cancelled";
+    }
+    if stream
+        .set_write_timeout(Some(Duration::from_secs(2)))
+        .is_err()
+        || stream.write_all(PAGE).is_err()
+    {
+        return "failed";
+    }
+    "completed"
+}
+
+#[cfg(windows)]
+extern "C" fn valid_guard(ptr: *const std::ffi::c_void) -> i32 {
+    (!ptr.is_null() && catch_unwind(|| current(unsafe { &*ptr.cast::<Scope>() })).unwrap_or(false))
+        as i32
+}
+#[cfg(target_os = "android")]
+static WIFI_PERMIT: Mutex<Option<(String, String)>> = Mutex::new(None);
+
+#[cfg(target_os = "android")]
+#[no_mangle]
+pub extern "system" fn Java_com_carriez_flutter_1hbb_FixedWifiSettings_consumePermit(
+    _: jni::JNIEnv,
+    _: jni::objects::JClass,
+) -> jni::sys::jboolean {
+    catch_unwind(|| {
+        let Some((peer, link)) = WIFI_PERMIT.lock().ok().and_then(|mut g| g.take()) else {
+            return false;
+        };
+        crate::ui_cm_interface::fixed_desktop_connection()
+            .is_some_and(|(p, l, _)| p == peer && l == link)
+    })
+    .unwrap_or(false) as jni::sys::jboolean
+}
+fn execute(s: &Scope, p: &Permit) -> &'static str {
+    if p.action == "restart_pos"
+        && !ledger().lock().ok().is_some_and(|state| {
+            state.profile.as_ref().is_some_and(|(owner, registered)| {
+                owner == s
+                    && p.target.package.as_ref() == Some(registered)
+                    && pos_supported(registered)
+            })
+        })
+    {
+        return "unsupported";
+    }
+    if !validate(&p.target, &p.action) || !supports(s, &p.action) {
+        return "unsupported";
+    }
+    if !current(s) {
+        return "cancelled";
+    }
+    if matches!(p.action.as_str(), "reconnect_printer" | "print_test") {
+        return printer(s, &p.target, p.action == "print_test");
+    }
+    #[cfg(target_os = "android")]
+    {
+        if p.action != "open_settings" {
+            return "unsupported";
+        }
+        let Ok(mut permit) = WIFI_PERMIT.lock() else {
+            return "failed";
+        };
+        *permit = Some((s.peer.clone(), s.link.clone()));
+        drop(permit);
+        let ok = android("steaddesk_fixed_settings");
+        if let Ok(mut slot) = WIFI_PERMIT.lock() {
+            *slot = None;
+        }
+        if ok {
+            "completed"
+        } else {
+            "failed"
+        }
+    }
+    #[cfg(windows)]
+    {
+        let Some(n) = ACTIONS.iter().position(|x| *x == p.action) else {
+            return "unsupported";
+        };
+        let pkg: Vec<u16> = p
+            .target
+            .package
+            .as_deref()
+            .unwrap_or("")
+            .encode_utf16()
+            .chain(Some(0))
+            .collect();
+        match unsafe {
+            sd_fixed_windows(
+                n as i32,
+                pkg.as_ptr(),
+                valid_guard,
+                (s as *const Scope).cast(),
+            )
+        } {
+            1 if p.action == "reboot" => "initiated",
+            1 => "completed",
+            2 => "unsupported",
+            3 => "cancelled",
+            _ => "failed",
+        }
+    }
+}
+
+fn acknowledged(id: &str, link: &str) -> Option<Value> {
+    let pending = ledger().lock().ok()?.consume(id, link)?;
+    let s = pending.scope;
+    if !current(&s) || !supports(&s, &pending.offer.action) {
+        return None;
+    }
+    if pending.offer.action == "restart_pos"
+        && !ledger()
+            .lock()
+            .ok()?
+            .profile
+            .as_ref()
+            .is_some_and(|(owner, p)| *owner == s && pos_supported(p))
+    {
+        return None;
+    }
+    let c = client()?;
+    let binding = json!({"id":id,"peer_id":s.peer,"link":s.link});
+    let permit = request(&c, &s, PERMIT, binding.clone(), pending.version);
+    let outcome = match permit {
+        None => return None,
+        Some(value) => {
+            let fields = value["target"].as_object();
+            let exact = fields.is_some_and(|m| {
+                m.len() == 4
+                    && ["id", "type", "ip", "package"]
+                        .iter()
+                        .all(|k| m.contains_key(*k))
+            });
+            match serde_json::from_value::<Permit>(value) {
+                Ok(p) if exact && p.id == id && p.action == pending.offer.action => execute(&s, &p),
+                _ => "unsupported",
+            }
+        }
+    };
+    let mut body = binding;
+    body["result"] = json!(outcome);
+    request(&c, &s, RESULT, body, pending.version)?;
+    Some(json!({"result":outcome}))
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Displayed {
+    id: String,
+    link: String,
+}
+#[no_mangle]
+pub unsafe extern "C" fn steaddesk_fixed_notice(
+    src: *const u8,
+    size: usize,
+    dst: *mut u8,
+    capacity: usize,
+) -> usize {
+    if src.is_null() || dst.is_null() || size == 0 || size > 256 || capacity != 2048 {
+        return 0;
+    }
+    catch_unwind(|| {
+        let raw = slice::from_raw_parts(src, size);
+        let val = if raw == b"release" {
+            release_printer();
+            None
+        } else if raw == b"poll" {
+            poll()
+        } else {
+            serde_json::from_slice::<Displayed>(raw)
+                .ok()
+                .and_then(|d| acknowledged(&d.id, &d.link))
+        };
+        let Some(bytes) = val.and_then(|v| serde_json::to_vec(&v).ok()) else {
+            return 0;
+        };
+        if bytes.len() > capacity {
+            return 0;
+        }
+        std::ptr::copy_nonoverlapping(bytes.as_ptr(), dst, bytes.len());
+        bytes.len()
+    })
+    .unwrap_or(0)
+}
