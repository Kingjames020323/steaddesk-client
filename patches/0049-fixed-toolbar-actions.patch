@@ -0,0 +1,50 @@
+package com.carriez.flutter_hbb
+
+import android.app.KeyguardManager
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ApplicationInfo
+import android.os.Looper
+import android.os.PowerManager
+import android.provider.Settings
+import androidx.annotation.Keep
+import java.lang.ref.WeakReference
+import java.util.concurrent.FutureTask
+import java.util.concurrent.TimeUnit
+
+internal object FixedWifiSettings {
+    @Volatile private var resumed = WeakReference<MainActivity>(null)
+    @Keep @JvmStatic private external fun consumePermit(): Boolean
+
+    fun resumed(activity: MainActivity) { resumed = WeakReference(activity) }
+    fun paused(activity: MainActivity) {
+        if (resumed.get() === activity) resumed.clear()
+    }
+
+    fun query(name: String): Boolean {
+        if (!FixedActionBuild.ENABLED || Looper.myLooper() == Looper.getMainLooper()) return false
+        val activity = resumed.get() ?: return false
+        val check = FutureTask<Boolean> {
+            val screen = activity.getSystemService(Context.POWER_SERVICE) as PowerManager
+            val lock = activity.getSystemService(Context.KEYGUARD_SERVICE) as KeyguardManager
+            if (resumed.get() !== activity || activity.isFinishing || activity.isDestroyed ||
+                !screen.isInteractive || lock.isKeyguardLocked || !activity.hasWindowFocus() ||
+                !activity.window.decorView.isShown || (MerchantRecovery.userPaused(activity) || MerchantRecovery.freshPeerUserStopped() != "false")) return@FutureTask false
+            if (name == "steaddesk_fixed_visible") return@FutureTask true
+            val intent = Intent(Settings.ACTION_WIFI_SETTINGS)
+            val info = activity.packageManager.resolveActivity(intent, android.content.pm.PackageManager.MATCH_DEFAULT_ONLY)?.activityInfo
+                ?: return@FutureTask false
+            if (!info.exported || info.applicationInfo.flags and ApplicationInfo.FLAG_SYSTEM == 0) return@FutureTask false
+            if (name == "steaddesk_fixed_settings_supported") return@FutureTask true
+            if (name != "steaddesk_fixed_settings" || !consumePermit() || (MerchantRecovery.userPaused(activity) || MerchantRecovery.freshPeerUserStopped() != "false")) return@FutureTask false
+            intent.setClassName(info.packageName, info.name)
+            activity.startActivity(intent)
+            true
+        }
+        activity.runOnUiThread(check)
+        return try { check.get(1500, TimeUnit.MILLISECONDS) } catch (_: Exception) {
+            check.cancel(false)
+            false
+        }
+    }
+}
