+Widget fixedConfirmDialog(BuildContext ctx, FixedOption choice, int step) {
+  final action = choice.action;
+  return AlertDialog(
+      title: Text(step == 2 ? '再次确认重启设备' : action.label),
+      content: Text(step == 2
