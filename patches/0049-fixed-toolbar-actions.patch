+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/fixed/merchant.dart'
+    show FixedMerchantNotice;
+import 'package:flutter_hbb/steaddesk/fixed/support_dialogs.dart';
+import 'package:flutter_hbb/steaddesk/fixed/protocol.dart';
+
+void main() {
+  const id = 't_00000000000000000000000000';
+  const target = 'i_00000000000000000000000000';
+  const peer = '123456789';
+  for (final action in FixedAction.values) {
+    test('${action.wire} requires its own visible confirmations', () async {
+      final steps = <int>[], requests = <String>[];
+      final option = FixedOption(action, target, 'Demo terminal');
+      await submitFixed(
+          (method, path, [body]) async {
+            requests.add(path);
+            expect(method, 'POST');
+            if (path.endsWith('/confirm')) {
+              expect(body, isEmpty);
+              expect(steps, [1, 2]);
+              return {'id': id, 'state': 'queued'};
+            }
+            expect(steps, [1]);
+            expect(body,
+                {'action': action.wire, 'target': target, 'peer_id': peer});
+            return {
+              'id': id,
+              'state': action == FixedAction.reboot ? 'confirm_again' : 'queued'
+            };
+          },
+          'toolbar/device/session',
+          peer,
+          option,
+          (step) async {
+            steps.add(step);
+            return true;
+          },
+          () async => true);
+      expect(requests.length, action == FixedAction.reboot ? 2 : 1);
+    });
+  }
+  test('second-confirm cancel or stale session does not queue reboot',
+      () async {
+    for (final stale in [true, false]) {
+      int requests = 0;
+      bool current = true;
+      await submitFixed(
+          (_, __, [___]) async {
+            requests++;
+            return {'id': id, 'state': 'confirm_again'};
+          },
+          'toolbar/device/session',
+          peer,
+          const FixedOption(FixedAction.reboot, target, 'Demo terminal'),
+          (step) async {
+            if (step == 2) {
+              current = !stale;
+              return stale;
+            }
+            return true;
+          },
+          () async => current);
+      expect(requests, 1);
+    }
+  });
+  test('empty inventory, unavailable safety and unexpected fields fail closed',
+      () {
+    final valid = {
+      'action': 'print_test',
+      'target': target,
+      'label': 'Demo receipt'
+    };
+    expect(
+        FixedOption.options({
+          'available': true,
+          'options': [valid]
+        })!
+            .single
+            .target,
+        target);
+    expect(FixedOption.options({'available': true, 'options': []}), isEmpty);
+    expect(
+        FixedOption.options({
+          'available': false,
+          'options': [valid]
+        }),
+        isNull);
+    for (final bad in [
+      {...valid, 'ip': '192.0.2.1'},
+      {...valid, 'target': 'unalisted'},
+      {...valid, 'action': 'free_command'}
+    ]) {
+      expect(
+          FixedOption.options({
+            'available': true,
+            'options': [bad]
+          }),
+          isNull);
+    }
+    expect(
+        FixedOffer.parse({
+          'id': id,
+          'action': 'open_settings',
+          'target_label': 'Demo terminal'
+        }),
+        isNotNull);
+    expect(
+        FixedOffer.parse({
+          'id': id,
+          'action': 'open_settings',
+          'target_label': 'Demo terminal',
+          'extra': true
+        }),
+        isNull);
+  });
+  testWidgets(
+      'the staff chooses a registered target then presses two distinct reboot confirmations',
+      (tester) async {
+    const targets = [
+      FixedOption(FixedAction.reboot, target, 'Demo till A'),
+      FixedOption(
+          FixedAction.reboot, 'i_10000000000000000000000000', 'Demo till B')
+    ];
+    final requests = <String>[];
+    await tester.pumpWidget(MaterialApp(
+        home: Builder(
+            builder: (ctx) => Scaffold(
+                body: TextButton(
+                    onPressed: () async {
+                      final selected = await showDialog<FixedOption>(
+                          context: ctx,
+                          builder: (d) => fixedTargetDialog(
+                              d, FixedAction.reboot, targets));
+                      if (selected == null) return;
+                      await submitFixed((method, path, [body]) async {
+                        requests.add(path);
+                        if (path.endsWith('confirm')) {
+                          return {'id': id, 'state': 'queued'};
+                        }
+                        expect(body?['target'], targets.last.target);
+                        return {'id': id, 'state': 'confirm_again'};
+                      },
+                          'fixture',
+                          peer,
+                          selected,
+                          (step) async =>
+                              await showDialog<bool>(
+                                  context: ctx,
+                                  builder: (d) =>
+                                      fixedConfirmDialog(d, selected, step)) ==
+                              true,
+                          () async => true);
+                    },
+                    child: const Text('open'))))));
+    await tester.tap(find.text('open'));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Demo till B'));
+    await tester.pumpAndSettle();
+    expect(find.textContaining('目标：Demo till B'), findsOneWidget);
+    expect(requests, isEmpty);
+    await tester.tap(find.text('确认'));
+    await tester.pumpAndSettle();
+    expect(requests, ['fixture/fixed-actions']);
+    expect(find.text('再次确认重启设备'), findsOneWidget);
+    await tester.tap(find.text('确认重启'));
+    await tester.pumpAndSettle();
+    expect(requests.last, 'fixture/fixed-actions/$id/confirm');
+  });
+
+  testWidgets(
+      'merchant offer is visibly rendered before acknowledgement and revoked by pause',
+      (tester) async {
+    final calls = <String>[];
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+    await tester.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: FixedMerchantNotice(
+                label: (s) => s,
+                call: (input) async {
+                  calls.add(input);
+                  return input == 'poll'
+                      ? {
+                          'id': id,
+                          'action': 'print_test',
+                          'target_label': 'Demo printer',
+                          'link': 'fixture-link'
+                        }
+                      : null;
+                }))));
+    await tester.pump(const Duration(seconds: 3));
+    await tester.pump();
+    expect(find.textContaining('Support is printing a test page.'),
+        findsOneWidget);
+    expect(calls, ['poll']);
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.paused);
+    await tester.pump(const Duration(seconds: 2));
+    await tester.pump();
+    expect(calls, ['poll', 'release']);
+    tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+    await tester.pump(const Duration(seconds: 3));
+    await tester.pump();
+    expect(find.textContaining('Demo printer'), findsOneWidget);
+    await tester.pump(const Duration(seconds: 2));
+    await tester.pump();
+    expect(calls.last, contains('"id":"$id"'));
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+}
