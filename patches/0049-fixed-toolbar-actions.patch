+    fn offered() -> Pending {
+        Pending {
+            scope: sample(),
+            offer: Offer {
+                id: format!("t_{}", "0".repeat(26)),
+                action: "reboot".into(),
+                target_label: "Lab".into(),
+            },
+            version: 1,
+        }
+    }
+    #[test]
+    fn actual_owned_socket_reconnect_and_fixed_page() {
+        use std::net::TcpListener;
+        let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let addr = listener.local_addr().unwrap();
+        let binding = PrinterBinding {
+            scope: sample(),
+            target: "fixture".into(),
+            addr,
+        };
+        let mut held = None;
+        let dial = || TcpStream::connect(addr);
+        assert_eq!(
+            transfer_printer(&mut held, &binding, dial, || true, false),
+            "completed"
+        );
+        let (mut connected, _) = listener.accept().unwrap();
+        assert_eq!(
+            transfer_printer(
+                &mut held,
+                &binding,
+                || panic!("must use restored socket"),
+                || true,
+                true
+            ),
+            "completed"
+        );
+        let mut received = Vec::new();
+        connected.read_to_end(&mut received).unwrap();
+        assert_eq!(received, PAGE);
+        assert!(held.is_none());
+        assert_eq!(
+            transfer_printer(
+                &mut held,
+                &binding,
+                || panic!("blocked before dial"),
+                || false,
+                true
+            ),
+            "cancelled"
+        );
+        assert_eq!(
+            transfer_printer(&mut held, &binding, dial, || true, false),
+            "completed"
+        );
+        let (mut old, _) = listener.accept().unwrap();
+        let other = PrinterBinding {
+            target: "another".into(),
+            ..binding.clone()
+        };
+        assert_eq!(
+            transfer_printer(&mut held, &other, dial, || true, true),
+            "completed"
+        );
+        let mut bytes = Vec::new();
+        old.read_to_end(&mut bytes).unwrap();
+        assert!(bytes.is_empty());
+        let (mut new, _) = listener.accept().unwrap();
+        new.read_to_end(&mut bytes).unwrap();
+        assert_eq!(bytes, PAGE);
+    }
+    #[test]
+    fn losing_a_permit_or_repolling_the_same_link_never_reexecutes() {
+        let mut ledger = Ledger::default();
+        let id = offered().offer.id;
+        let link = sample().link;
+        assert!(ledger.offer(offered()));
+        assert!(ledger.consume(&id, "another-link").is_none());
+        assert!(ledger.consume(&id, &link).is_some());
+        assert!(ledger.consume(&id, &link).is_none());
+        assert!(!ledger.offer(offered()));
+    }
+    #[test]
+    fn only_registered_fixed_printers_or_hosts_can_execute() {
+        let mut t = Target {
+            id: format!("i_{}", "1".repeat(26)),
+            kind: "printer".into(),
+            ip: "10.1.2.3".parse().unwrap(),
+            package: None,
+        };
+        assert!(validate(&t, "reconnect_printer") && validate(&t, "print_test"));
+        assert_eq!(PAGE, b"SteadDesk printer test\n\n\n");
+        for bad in ["payment", "unknown", "host"] {
+            t.kind = bad.into();
+            assert!(!validate(&t, "print_test"));
+        }
+        t.kind = "host".into();
+        assert!(validate(&t, "open_settings") && validate(&t, "reboot"));
+        t.package = Some("Vendor.Pos_abcd123456789!Till".into());
+        assert!(validate(&t, "restart_pos"));
+        for bad in [
+            "C:\\Windows\\cmd.exe",
+            "helper.exe --arguments",
+            "x://bad",
+            "",
+        ] {
+            t.package = Some(bad.into());
+            assert!(!validate(&t, "restart_pos"));
+        }
+        t.kind = "printer".into();
+        t.package = None;
+        for outside in ["192.0.2.1", "127.0.0.1", "169.254.1.2", "224.0.0.1"] {
+            t.ip = outside.parse().unwrap();
+            assert!(!validate(&t, "print_test"));
+        }
+        assert!(serde_json::from_value::<Target>(
+            json!({"id":t.id,"type":"printer","ip":"10.0.0.1","package":null,"port":22})
+        )
+        .is_err());
+    }
+}
