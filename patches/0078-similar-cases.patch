+
+Map<String, dynamic> entry(int i, String owner, String suffix,
+        {String help = ticket, String host = origin}) =>
+    {
+      'id': '00000000-0000-4000-8000-${i.toString().padLeft(12, '0')}',
+      'device_id': '12345$suffix',
+      'help_id': help,
+      'help_origin': host,
+      'started_at': '2026-11-02T02:04:00.000Z',
+      'ended_at': '2026-11-02T02:07:00.000Z',
+      'agent': owner,
+      'note': 'local note $i',
+      'category': 'printer',
+      'result': 'resolved',
+      'appends': [],
+    };
+
+SimilarCase historical(String match) => SimilarCase.fromJson({
+      'id': ticket,
+      'match': match,
+      'device_suffix': '6789',
+      'ended_at': 1793585400,
+      'category': 'printer',
+      'close_issue_type': 'printer',
+      'close_result': 'resolved',
+      'handler': 'fixture-handler',
+      'duration_seconds': 303,
+      'card': {'id': 'fixture-card', 'version': 3, 'title': 'Paper check'},
+      if (match == 'other_store') 'store_name': 'Sample west',
+    });
+
+Future<void> mountSection(WidgetTester tester, String match,
+    ReadLinkedHelpHistory read, bool Function() current,
+    {Brightness brightness = Brightness.light}) async {
+  await tester.pumpWidget(MaterialApp(
+      theme: ThemeData(brightness: brightness),
+      home: Scaffold(
+          body: SimilarCasesSection(
+              scope: match,
+              current: current,
+              load: () async => [historical(match)],
+              openReport: (context, row, canRead) => openSimilarCaseReport(
+                  context, row, canRead,
+                  account: account, origin: origin, read: read)))));
+  await tester.pump();
+  expect(find.text('以前类似的单子'), findsOneWidget);
+  await tester.tap(find
+      .descendant(
+          of: find.byType(SimilarCasesSection), matching: find.byType(InkWell))
+      .first);
+  await tester.pumpAndSettle();
+}
+
+void main() {
+  test(
+      'local history reopens only same account, origin, ticket, suffix, and saved state',
+      () async {
+    final dir = await Directory.systemTemp.createTemp('similar-history-test');
+    addTearDown(() => dir.delete(recursive: true));
+    LocalCaseStore store() => LocalCaseStore(
+        file: () async => File('${dir.path}/$caseStoreFileName'),
+        writeHelp: (_, __, ___) async {});
+    final db = store();
+    for (var i = 0; i < 7; i++) {
+      final owner = i == 2 ? 'different-account' : account;
+      final row = entry(i, owner, i == 3 ? '0000' : '6789',
+          help: i == 4 ? 'different-ticket' : ticket,
+          host: i == 5 ? 'https://another.invalid/ops/v1/' : origin);
+      await db.addDraft(owner, row);
+      if (i != 6)
+        await db.save(owner, row['id'],
+            category: 'printer', result: 'resolved', note: row['note']);
+    }
+    final rows =
+        await store().savedHelpSessions(account, origin, ticket, '6789');
+    expect(rows.map((r) => r['note']),
+        unorderedEquals(['local note 0', 'local note 1']));
+    expect(
+        rows.every((r) => r['id'] != ticket && r['help_id'] == ticket), isTrue);
+  });
+
+  testWidgets(
+      'selected same-store ticket displays exact local session in 0025, read-only',
+      (t) async {
+    int reads = 0;
+    await mountSection(t, 'store', (a, o, id, suffix) async {
+      reads++;
+      expect([a, o, id, suffix], [account, origin, ticket, '6789']);
+      return [entry(1, account, '6789')];
+    }, () => true, brightness: Brightness.dark);
+    expect(reads, 1);
+    expect(find.byType(CaseHistoryDrawer), findsOneWidget);
+    expect(find.text('历史报告'), findsOneWidget);
+    expect(find.text('求助单 $ticket'), findsOneWidget);
+    expect(find.text('3 分钟'), findsOneWidget);
+    expect(find.textContaining('local note 1', findRichText: true),
+        findsOneWidget);
+    expect(find.textContaining('用时 5 分'), findsWidgets);
+    expect(find.text('追加说明'), findsNothing);
+    expect(find.text('编辑'), findsNothing);
+    expect(find.text('其他门店 · 仅显示结案摘要'), findsNothing);
+    await t.tap(find.byTooltip('关闭历史报告'));
+    await t.pumpAndSettle();
+    expect(find.byType(CaseHistoryDrawer), findsNothing);
+    await t.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('missing local session still opens ticket and discloses source',
+      (t) async {
+    await mountSection(t, 'device', (_, __, ___, ____) async => [], () => true);
+    expect(find.text('本机没有关联的已保存会话'), findsOneWidget);
+    expect(find.text('求助单 $ticket'), findsOneWidget);
+    expect(find.text('暂无记录'), findsNothing);
+    await t.pumpWidget(const SizedBox());
+  });
+
+  testWidgets(
+      'other-store opens projected report without reading local notes; revoked scope closes it',
+      (t) async {
+    bool allowed = true;
+    int reads = 0;
+    await mountSection(t, 'other_store', (a, o, id, suffix) async {
+      reads++;
+      return [entry(9, account, '6789')];
+    }, () => allowed);
+    expect(reads, 0);
+    expect(find.byType(CaseHistoryDrawer), findsOneWidget);
+    expect(find.text('求助单 $ticket'), findsOneWidget);
+    expect(find.text('门店 · Sample west'), findsOneWidget);
+    expect(find.text('其他门店 · 仅显示结案摘要'), findsOneWidget);
+    expect(
+        find.textContaining('local note 9', findRichText: true), findsNothing);
+    expect(find.textContaining('Paper check'), findsWidgets);
+    allowed = false;
+    await t.pump(const Duration(seconds: 1));
+    await t.pumpAndSettle();
+    expect(find.byType(CaseHistoryDrawer), findsNothing);
+    expect(find.text('以前类似的单子'), findsNothing);
+    await t.pumpWidget(const SizedBox());
+  });
+}
