diff --git a/flutter/lib/steaddesk/similar_case.dart b/flutter/lib/steaddesk/similar_case.dart
new file mode 100644
index 0000000..4b075a7
--- /dev/null
+++ b/flutter/lib/steaddesk/similar_case.dart
@@ -0,0 +1,127 @@
+typedef SimilarCard = ({String id, int version, String? title});
+
+final _historicalTicket = RegExp(r'^h_[a-f0-9]{32}$');
+
+class SimilarCase {
+  final String id, match, deviceSuffix, category;
+  final String? closeIssueType, closeResult, handler, storeName;
+  final DateTime endedAt;
+  final int? durationSeconds;
+  final SimilarCard? card;
+
+  const SimilarCase({
+    required this.id,
+    required this.match,
+    required this.deviceSuffix,
+    required this.category,
+    required this.closeIssueType,
+    required this.closeResult,
+    required this.handler,
+    required this.storeName,
+    required this.endedAt,
+    required this.durationSeconds,
+    required this.card,
+  });
+
+  // A reopened case, changed store or changed projection cannot authorize an older report.
+  bool sameReport(SimilarCase other) =>
+      (
+        id,
+        match,
+        deviceSuffix,
+        category,
+        closeIssueType,
+        closeResult,
+        handler,
+        storeName,
+        endedAt,
+        durationSeconds,
+        card
+      ) ==
+      (
+        other.id,
+        other.match,
+        other.deviceSuffix,
+        other.category,
+        other.closeIssueType,
+        other.closeResult,
+        other.handler,
+        other.storeName,
+        other.endedAt,
+        other.durationSeconds,
+        other.card
+      );
+
+  static String? _text(Object? value, {int max = 256}) {
+    if (value == null) return null;
+    if (value is! String ||
+        value.runes.length > max ||
+        RegExp(r'[\x00-\x1f\x7f]').hasMatch(value)) {
+      throw const FormatException('相似案例字段无效');
+    }
+    return value.isEmpty ? null : value;
+  }
+
+  factory SimilarCase.fromJson(Map<String, dynamic> row) {
+    final id = row['id'],
+        match = row['match'],
+        suffix = row['device_suffix'],
+        ended = row['ended_at'],
+        duration = row['duration_seconds'],
+        category = row['category'];
+    if (id is! String ||
+        !_historicalTicket.hasMatch(id) ||
+        !const {'device', 'store', 'other_store'}.contains(match) ||
+        suffix is! String ||
+        !RegExp(r'^\d{4}$').hasMatch(suffix) ||
+        ended is! int ||
+        ended < 0 ||
+        ended > 253402300799 ||
+        duration != null && (duration is! int || duration < 0) ||
+        category is! String ||
+        _text(category, max: 64) == null) {
+      throw const FormatException('相似案例格式无效');
+    }
+    final raw = row['card'];
+    SimilarCard? card;
+    if (raw != null) {
+      if (raw is! Map<String, dynamic> ||
+          _text(raw['id'], max: 128) == null ||
+          raw['version'] is! int ||
+          raw['version'] < 1) {
+        throw const FormatException('步骤卡格式无效');
+      }
+      card = (
+        id: raw['id'] as String,
+        version: raw['version'] as int,
+        title: _text(raw['title'])
+      );
+    }
+    return SimilarCase(
+        id: id,
+        match: match as String,
+        deviceSuffix: suffix,
+        endedAt: DateTime.fromMillisecondsSinceEpoch(ended * 1000, isUtc: true),
+        durationSeconds: duration as int?,
+        category: category,
+        closeIssueType: _text(row['close_issue_type'], max: 64),
+        closeResult: _text(row['close_result'], max: 64),
+        handler: _text(row['handler']),
+        storeName: match == 'other_store' ? _text(row['store_name']) : null,
+        card: card);
+  }
+
+  static List<SimilarCase> fromResponse(Map<String, dynamic> data,
+      {String? exclude}) {
+    final raw = data['items'];
+    if (raw is! List) throw const FormatException('相似案例列表无效');
+    final seen = <String>{if (exclude != null) exclude};
+    final items = <SimilarCase>[];
+    for (final row in raw.take(5)) {
+      if (row is! Map<String, dynamic>) throw const FormatException('相似案例格式无效');
+      final item = SimilarCase.fromJson(row);
+      if (seen.add(item.id)) items.add(item);
+    }
+    return List.unmodifiable(items);
+  }
+}
diff --git a/flutter/lib/steaddesk/similar_cases.dart b/flutter/lib/steaddesk/similar_cases.dart
new file mode 100644
index 0000000..c874416
--- /dev/null
+++ b/flutter/lib/steaddesk/similar_cases.dart
@@ -0,0 +1,206 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'cases/case_dialog.dart' show caseCategoryLabels, caseResultLabels;
+import 'similar_case.dart';
+import 'support_appearance.dart';
+import 'support_help.dart' show helpReasons;
+export 'similar_case.dart';
+
+class SimilarCasesSection extends StatefulWidget {
+  final Object scope;
+  final bool Function() current;
+  final Future<List<SimilarCase>> Function() load;
+  final Future<void> Function(BuildContext, SimilarCase, bool Function())
+      openReport;
+
+  const SimilarCasesSection(
+      {super.key,
+      required this.scope,
+      required this.current,
+      required this.load,
+      required this.openReport});
+
+  @override
+  State<SimilarCasesSection> createState() => _SimilarCasesSectionState();
+}
+
+class _SimilarCasesSectionState extends State<SimilarCasesSection> {
+  List<SimilarCase> _rows = const [];
+  Timer? _guard, _poll;
+  int _generation = 0, _scopeEpoch = 0;
+  bool _permitted = false, _opening = false;
+  DateTime? _expires;
+  bool get _active => mounted && widget.current();
+  bool get _fresh => _expires?.isAfter(DateTime.now()) ?? false;
+
+  @override
+  void initState() {
+    super.initState();
+    _permitted = _active;
+    if (_permitted) unawaited(_read());
+    _guard = Timer.periodic(const Duration(seconds: 1), (_) {
+      if (_permitted != _active) {
+        _permitted = _active;
+        _invalidate();
+        if (_permitted) unawaited(_read());
+      } else if (_rows.isNotEmpty && !_fresh) {
+        setState(() => _rows = const []);
+      }
+    });
+    _poll = Timer.periodic(const Duration(seconds: 15), (_) {
+      if (_active && !_opening) unawaited(_read());
+    });
+  }
+
+  void _invalidate() {
+    _generation++;
+    _scopeEpoch++;
+    _opening = false;
+    _expires = null;
+    if (_rows.isNotEmpty) setState(() => _rows = const []);
+  }
+
+  @override
+  void didUpdateWidget(SimilarCasesSection old) {
+    super.didUpdateWidget(old);
+    if (old.scope != widget.scope || _permitted != _active) {
+      _invalidate();
+      _permitted = _active;
+      if (_permitted) unawaited(_read());
+    }
+  }
+
+  Future<List<SimilarCase>> _read() async {
+    final generation = ++_generation;
+    try {
+      final rows = await widget.load();
+      if (!_active || generation != _generation) return const [];
+      setState(() {
+        _rows = rows.take(5).toList(growable: false);
+        _expires = DateTime.now().add(const Duration(seconds: 30));
+      });
+      return _rows;
+    } catch (_) {
+      if (mounted && generation == _generation) {
+        _expires = null;
+        setState(() => _rows = const []);
+      }
+      return const [];
+    }
+  }
+
+  Future<void> _open(SimilarCase row) async {
+    if (_opening || !_active || !_fresh) return;
+    final epoch = _scopeEpoch;
+    _opening = true;
+    try {
+      final latest = await _read();
+      if (!_active || epoch != _scopeEpoch) return;
+      for (final item in latest) {
+        if (item.id != row.id) continue;
+        bool current() =>
+            _active &&
+            epoch == _scopeEpoch &&
+            _fresh &&
+            _rows.any(item.sameReport);
+        if (current()) {
+          // The report stays subject to the same periodic permission checks as its list.
+          _opening = false;
+          await widget.openReport(context, item, current);
+        }
+        return;
+      }
+    } finally {
+      if (mounted && epoch == _scopeEpoch) _opening = false;
+    }
+  }
+
+  @override
+  void dispose() {
+    _generation++;
+    _guard?.cancel();
+    _poll?.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!_active || !_fresh || _rows.isEmpty) return const SizedBox.shrink();
+    return Padding(
+        padding: const EdgeInsets.only(top: 10, bottom: 4),
+        child:
+            Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+          Text('以前类似的单子',
+              style: Theme.of(context).textTheme.titleSmall?.copyWith(
+                  fontWeight: FontWeight.w600, color: context.supportInk)),
+          const SizedBox(height: 4),
+          for (final row in _rows)
+            InkWell(
+                onTap: () => _open(row),
+                child: Container(
+                    padding: const EdgeInsets.symmetric(vertical: 7),
+                    decoration: BoxDecoration(
+                        border: Border(
+                            top: BorderSide(color: context.supportLine))),
+                    child: Row(children: [
+                      Expanded(
+                          child: Column(
+                              crossAxisAlignment: CrossAxisAlignment.start,
+                              children: [
+                            Text(
+                                '${row.dayLabel} · ${row.categoryLabel} · ${row.issueLabel}',
+                                style: Theme.of(context)
+                                    .textTheme
+                                    .bodyMedium
+                                    ?.copyWith(color: context.supportInk)),
+                            Text(
+                                [
+                                  if (row.storeName != null) row.storeName!,
+                                  row.resultLabel,
+                                  row.handlerLabel,
+                                  row.durationLabel,
+                                ].join(' · '),
+                                style: Theme.of(context)
+                                    .textTheme
+                                    .bodySmall
+                                    ?.copyWith(color: context.supportMuted)),
+                            if (row.card case final card?)
+                              Text(
+                                  '步骤卡 · ${card.title ?? '${card.id} · v${card.version}'}',
+                                  style: Theme.of(context)
+                                      .textTheme
+                                      .bodySmall
+                                      ?.copyWith(color: context.supportAccent)),
+                          ])),
+                      Icon(Icons.chevron_right,
+                          size: 16, color: context.supportMuted),
+                    ]))),
+        ]));
+  }
+}
+
+String _date(DateTime date) {
+  final d = date.toLocal();
+  String pad(int n) => n.toString().padLeft(2, '0');
+  return '${d.year}-${pad(d.month)}-${pad(d.day)}';
+}
+
+String _duration(int sec) {
+  if (sec < 60) return '用时 $sec 秒';
+  if (sec < 3600) return '用时 ${sec ~/ 60} 分';
+  return '用时 ${sec ~/ 3600} 小时 ${sec % 3600 ~/ 60} 分';
+}
+
+extension SimilarCaseLabels on SimilarCase {
+  String get dayLabel => _date(endedAt);
+  String get categoryLabel => helpReasons[category] ?? '其他';
+  String get issueLabel => caseCategoryLabels[closeIssueType] ?? '未记录问题类型';
+  String get resultLabel => closeResult == 'self_resolved'
+      ? '商户自助解决'
+      : caseResultLabels[closeResult] ?? '未记录结果';
+  String get handlerLabel =>
+      handler ?? (closeResult == 'self_resolved' ? '商户' : '未记录处理人');
+  String get durationLabel =>
+      durationSeconds == null ? '用时未记录' : _duration(durationSeconds!);
+}
