+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/similar_cases.dart';
+import 'package:flutter_hbb/steaddesk/cases/similar_report.dart';
+import 'package:flutter_hbb/steaddesk/support_help.dart';
+import 'package:flutter_hbb/steaddesk/support_help_queue.dart';
+
+String ticketId(int n) => 'h_${n.toRadixString(16).padLeft(32, '0')}';
+
+Map<String, dynamic> projection(int num,
+        {String match = 'device', bool self = false}) =>
+    {
+      'id': ticketId(num),
+      'match': match,
+      'device_suffix': '7890',
+      'category': 'printer',
+      'close_issue_type': 'network',
+      'close_result': self ? 'self_resolved' : 'resolved',
+      'handler': self ? null : '林敏',
+      'ended_at': 1795000000 - num * 86400,
+      'duration_seconds': self ? null : 540,
+      'store_name': match == 'other_store' ? '河畔门店' : '不得展示内部名',
+      'card': self
+          ? {'id': 'receipt-paper', 'version': 3, 'title': '检查收据纸卷方向'}
+          : null,
+      'message': '私密留言',
+      'screenshot': '私密截图',
+      'device_id': '123457890',
+    };
+
+class SimilarFixtureApi extends Fake implements SupportHelpApi {
+  @override
+  String get account => 'fixture';
+  @override
+  Uri get base => Uri.parse('https://example.invalid/ops/v1/');
+  final rows = <String, HelpRow>{};
+  @override
+  Future<HelpRow> detail(String id) async => rows[id]!;
+  @override
+  Future<String?> storeName(String? id) async => '枫林门店';
+  final cases = <SimilarCase>[];
+  bool allowed = true;
+  @override
+  bool Function() get current => () => allowed;
+  @override
+  Future<List<SimilarCase>> similarForTicket(String id) async => cases;
+}
+
+class Source {
+  Object scope = 'first';
+  bool granted = true;
+  bool Function()? guard;
+  Future<void> Function(BuildContext, SimilarCase, bool Function())? open;
+  Future<List<SimilarCase>> Function() fetch = () async => [];
+  Widget page() => MaterialApp(
+          home: Scaffold(
+              body: SimilarCasesSection(
+        scope: scope,
+        current: () => granted,
+        load: () => fetch(),
+        openReport: (context, item, current) async {
+          guard = current;
+          await open?.call(context, item, current);
+        },
+      )));
+}
+
+void main() {
+  test(
+      'projection excludes source, duplicates and private fields and caps at five',
+      () {
+    final docs = [for (var i = 1; i <= 8; i++) projection(i)];
+    final seen = SimilarCase.fromResponse({'items': docs});
+    expect(seen.map((r) => r.id), [for (var i = 1; i <= 5; i++) ticketId(i)]);
+    expect(seen.first.storeName, isNull);
+    expect(
+        SimilarCase.fromResponse({
+          'items': [docs.first, docs.first, docs[1]]
+        }, exclude: ticketId(2)),
+        hasLength(1));
+    for (final map in [
+      {'device_suffix': '123456789'},
+      {'match': 'private'},
+      {'id': '../../help'},
+      {'duration_seconds': -1}
+    ]) {
+      expect(() => SimilarCase.fromJson({...docs.first, ...map}),
+          throwsFormatException);
+    }
+    final api = SupportHelpApi(
+        Uri.parse('http://127.0.0.1'), 'fixture', 'test', () => true);
+    addTearDown(api.dispose);
+    expect(() => api.similarForTicket('h_../../credentials'),
+        throwsA(isA<HelpStaffError>()));
+    expect(() => api.similarForDevice('123456789/..'),
+        throwsA(isA<HelpStaffError>()));
+    return expectLater(api.similarForTicket(ticketId(1)),
+        throwsA(isA<HelpStaffError>().having((e) => e.status, 'status', 403)));
+  });
+
+  testWidgets(
+      'verified intake renders authorized fields, self-help card and never shows private extras',
+      (t) async {
+    final api = SimilarFixtureApi()
+      ..cases.addAll([
+        SimilarCase.fromJson(projection(1)),
+        SimilarCase.fromJson(projection(2, match: 'store')),
+        SimilarCase.fromJson(projection(3, match: 'other_store', self: true)),
+      ]);
+    final id = ticketId(10);
+    api.rows[id] = {
+      'id': id,
+      'version': 1,
+      'lane': 'verified',
+      'state': 'queued',
+      'group_id': 'g_fixture',
+      'device_id': '123457890',
+      'created_at': 1795000000,
+      'category': 'printer',
+      'history': []
+    };
+    await t.binding.setSurfaceSize(const Size(1100, 800));
+    addTearDown(() => t.binding.setSurfaceSize(null));
+    await t.pumpWidget(MaterialApp(
+        home: SupportHelpQueue(
+            api: api,
+            rows: api.rows.values.toList(),
+            error: null,
+            onRefresh: () async {},
+            openSimilarReport: (ctx, r, current) => openSimilarCaseReport(
+                ctx, r, current,
+                account: api.account,
+                origin: api.base.toString(),
+                read: (_, __, ___, ____) async =>
+                    fail('Cross-store local read')),
+            onConnect: (_) async {})));
+    await t.pumpAndSettle();
+    expect(find.text('以前类似的单子'), findsOneWidget);
+    expect(find.textContaining('打印机 · 网络'), findsNWidgets(3));
+    expect(find.textContaining('已解决 · 林敏 · 用时 9 分'), findsNWidgets(2));
+    expect(find.textContaining('河畔门店 · 商户自助解决'), findsOneWidget);
+    expect(find.text('步骤卡 · 检查收据纸卷方向'), findsOneWidget);
+    for (final forbidden in ['不得展示内部名', '私密留言', '私密截图', '123457890']) {
+      expect(find.textContaining(forbidden), findsNothing);
+    }
+    await t.tap(find.text('步骤卡 · 检查收据纸卷方向'));
+    await t.pumpAndSettle();
+    expect(find.text('历史报告'), findsOneWidget);
+    expect(find.text('其他门店 · 仅显示结案摘要'), findsOneWidget);
+    api.allowed = false;
+    await t.pump(const Duration(seconds: 2));
+    await t.pumpAndSettle();
+    expect(find.text('历史报告'), findsNothing);
+    expect(find.text('以前类似的单子'), findsNothing);
+    await t.pumpWidget(const SizedBox());
+  });
+
+  testWidgets(
+      'empty and revoked sections disappear; a delayed old ticket cannot cross accounts',
+      (t) async {
+    final stale = Completer<List<SimilarCase>>();
+    final source = Source()..fetch = (() => stale.future);
+    await t.pumpWidget(source.page());
+    expect(find.text('以前类似的单子'), findsNothing);
+    source.scope = 'second';
+    source.fetch = () async => [];
+    await t.pumpWidget(source.page());
+    stale.complete([SimilarCase.fromJson(projection(1))]);
+    await t.pumpAndSettle();
+    expect(find.text('以前类似的单子'), findsNothing);
+    source.scope = 'third';
+    source.fetch = () async =>
+        [SimilarCase.fromJson(projection(3, match: 'other_store', self: true))];
+    await t.pumpWidget(source.page());
+    await t.pumpAndSettle();
+    expect(find.textContaining('河畔门店'), findsOneWidget);
+    source.granted = false;
+    await t.pump(const Duration(seconds: 1));
+    expect(find.text('以前类似的单子'), findsNothing);
+    await t.pumpWidget(const SizedBox());
+  });
+
+  testWidgets(
+      'tap rechecks visibility and an open report loses authority when the same case changes tier',
+      (t) async {
+    final source = Source();
+    var row = SimilarCase.fromJson(projection(3));
+    source.fetch = () async => [row];
+    await t.pumpWidget(source.page());
+    await t.pumpAndSettle();
+    final anchor = find.textContaining('林敏');
+    await t.tap(anchor);
+    await t.pumpAndSettle();
+    expect(source.guard!(), isTrue);
+    row = SimilarCase.fromJson(projection(3, match: 'other_store', self: true));
+    await t.pump(const Duration(seconds: 15));
+    await t.pumpAndSettle();
+    expect(source.guard!(), isFalse);
+    source.guard = null;
+    source.fetch = () async => throw const HelpStaffError(404);
+    await t.tap(find.textContaining('河畔门店'));
+    await t.pumpAndSettle();
+    expect(source.guard, isNull);
+    expect(find.text('以前类似的单子'), findsNothing);
+    await t.pumpWidget(const SizedBox());
+  });
+}
