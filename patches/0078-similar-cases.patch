diff --git a/flutter/lib/steaddesk/cases/similar_report.dart b/flutter/lib/steaddesk/cases/similar_report.dart
new file mode 100644
index 0000000..339e264
--- /dev/null
+++ b/flutter/lib/steaddesk/cases/similar_report.dart
@@ -0,0 +1,120 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import '../similar_cases.dart';
+import '../support_appearance.dart';
+import 'case_inbox.dart' show readLinkedHelpHistory;
+import 'history_ui.dart';
+
+typedef ReadLinkedHelpHistory = Future<List<Map<String, dynamic>>> Function(
+    String account, String origin, String ticket, String suffix);
+
+Future<void> openSimilarCaseReport(
+    BuildContext context, SimilarCase row, bool Function() current,
+    {required String account,
+    required String origin,
+    ReadLinkedHelpHistory read = readLinkedHelpHistory}) async {
+  if (!context.mounted || !current() || account.isEmpty) return;
+  await showDialog<void>(
+      context: context,
+      builder: (dialog) => _SimilarReport(
+          row: row,
+          current: current,
+          read: read,
+          account: account,
+          origin: origin));
+}
+
+class _SimilarReport extends StatefulWidget {
+  final SimilarCase row;
+  final bool Function() current;
+  final String account, origin;
+  final ReadLinkedHelpHistory read;
+  const _SimilarReport(
+      {required this.row,
+      required this.current,
+      required this.account,
+      required this.origin,
+      required this.read});
+
+  @override
+  State<_SimilarReport> createState() => _SimilarReportState();
+}
+
+class _SimilarReportState extends State<_SimilarReport> {
+  List<Map<String, dynamic>> sessions = const [];
+  bool loading = true, readFailed = false;
+  Timer? guard;
+
+  @override
+  void initState() {
+    super.initState();
+    guard = Timer.periodic(const Duration(seconds: 1), (_) {
+      if (!widget.current()) dismiss();
+    });
+    if (widget.current() && widget.row.match != 'other_store') load();
+  }
+
+  void dismiss() {
+    final route = ModalRoute.of(context);
+    if (route != null && route.isActive) route.navigator?.removeRoute(route);
+  }
+
+  Future<void> load() async {
+    try {
+      final rows = await widget.read(widget.account, widget.origin,
+          widget.row.id, widget.row.deviceSuffix);
+      if (!mounted || !widget.current()) return;
+      sessions = rows;
+    } catch (_) {
+      readFailed = true;
+    } finally {
+      if (mounted && widget.current()) setState(() => loading = false);
+    }
+  }
+
+  @override
+  void dispose() {
+    guard?.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!widget.current()) return const SizedBox.shrink();
+    final row = widget.row, other = row.match == 'other_store';
+    final local = other
+        ? '其他门店 · 仅显示结案摘要'
+        : loading
+            ? '正在读取本机报告…'
+            : readFailed
+                ? '本机会话记录读取失败'
+                : sessions.isEmpty
+                    ? '本机没有关联的已保存会话'
+                    : '关联的本机会话（${sessions.length}）';
+    final summary =
+        Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      SelectableText('求助单 ${row.id}',
+          style: TextStyle(
+              color: context.supportInk, fontWeight: FontWeight.w600)),
+      const SizedBox(height: 8),
+      Text('${row.dayLabel} · 设备尾号 ${row.deviceSuffix}'),
+      if (other && row.storeName != null) Text('门店 · ${row.storeName}'),
+      Text('${row.categoryLabel} · ${row.issueLabel} · ${row.resultLabel}'),
+      Text('${row.handlerLabel} · ${row.durationLabel}'),
+      if (row.card != null)
+        Text('步骤卡 · ${row.card!.title ?? row.card!.id}（v${row.card!.version}）'),
+      const SizedBox(height: 12),
+      Text(local, style: TextStyle(color: context.supportMuted)),
+      const SizedBox(height: 8),
+    ]);
+    return Dialog(
+        child: SizedBox(
+            width: 520,
+            height: 550,
+            child: CaseHistoryDrawer.ticket(
+                summary: summary,
+                sessions: sessions,
+                onClose: () => Navigator.pop(context))));
+  }
+}
