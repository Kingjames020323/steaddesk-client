+package com.carriez.flutter_hbb;
+
+import android.content.Context;
+import android.content.RestrictionsManager;
+import android.os.Parcel;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/** Optional observation read over an existing, authorized peer connection (no start or wake). */
+final class MerchantToday {
+    static void append(Context context, Parcel reply) {
+        try {
+            RestrictionsManager manager = (RestrictionsManager)context.getSystemService(Context.RESTRICTIONS_SERVICE);
+            if (manager == null || !manager.getApplicationRestrictions().getBoolean("STEADDESK_TODAY", false)) return;
+            File journal = new File(context.getFilesDir(), "self-heal.jsonl");
+            if (!journal.isFile() || journal.length() > 1024 * 1024) return;
+            try (BufferedReader input = new BufferedReader(new InputStreamReader(new FileInputStream(journal), StandardCharsets.UTF_8))) {
+                JSONObject window = project(input, System.currentTimeMillis() / 1000);
+                if (window != null) reply.writeString(window.toString());
+            }
+        } catch (Exception unavailable) { /* Old status result stays valid; no fabricated zero. */ }
+    }
+
+    static JSONObject project(BufferedReader input, long now) throws Exception {
+        SimpleDateFormat utc = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.ROOT);
+        utc.setTimeZone(TimeZone.getTimeZone("UTC"));
+        utc.setLenient(false);
+        JSONArray attempts = new JSONArray();
+        long first = -1, last = -1;
+        int lines = 0;
+        for (String line; (line = input.readLine()) != null;) {
+            if (++lines > 500 || line.length() > 4096) return null;
+            JSONObject entry = new JSONObject(line);
+            String stamp = entry.getString("time");
+            if (stamp.length() != 24) return null;
+            long time = utc.parse(stamp).getTime() / 1000;
+            if (time < last || time > now) return null;
+            if (first < 0) first = time;
+            last = time;
+            if ("wake".equals(entry.getString("action")) && "reserved".equals(entry.getString("result")) &&
+                    time >= now - 172800) {
+                if (attempts.length() == 256) return null;
+                attempts.put(time);
+            }
+        }
+        if (first < 0) return null;
+        long since = Math.max(first, now - 172800);
+        // A full rotating journal may have dropped earlier events in its first second.
+        if (lines == 500 && first >= since) {
+            since = first + 1;
+            if (since > now) return null;
+            while (attempts.length() > 0 && attempts.getLong(0) < since) attempts.remove(0);
+        }
+        return new JSONObject().put("since", since).put("as_of", now).put("times", attempts);
+    }
+}
