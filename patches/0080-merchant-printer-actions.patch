@@ -19,6 +19,22 @@ class MerchantHelpSigner {
   final DynamicLibrary _core;
   MerchantHelpSigner(this._core);
 
+  Map<String,String> signSelfFix(int version, Map<String,dynamic> body) =>
+      _quickCheckCall('self_fix', version, body);
+
+  bool rememberSelfFix(Map<String,dynamic> consent) {
+    final bytes = utf8.encode(jsonEncode(consent));
+    final memory = calloc<Uint8>(bytes.length);
+    try {
+      memory.asTypedList(bytes.length).setAll(0, bytes);
+      final remember = _core.lookupFunction<Int32 Function(Pointer<Uint8>, UintPtr),
+          int Function(Pointer<Uint8>, int)>('steaddesk_remember_self_fix');
+      return remember(memory, bytes.length) == 1;
+    } finally {
+      calloc.free(memory);
+    }
+  }
+
   String quickCheckBinding() =>
       _quickCheckCall('binding', 0, const {})['fingerprint']!;
 
