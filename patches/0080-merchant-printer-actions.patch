+#[cfg(test)]
+mod tests {
+    use super::*;
+    const JOB: &str = "sf_00000000000000000000000001";
+    const TARGET: &str = "i_00000000000000000000000003";
+    fn who() -> Identity {
+        ("https://lab.invalid".into(), "fixture-device".into())
+    }
+    fn consent() -> Approval {
+        let proof = format!(
+            "{:x}",
+            Sha256::digest(format!("{JOB}|print_test|{TARGET}|10.0.0.1").as_bytes())
+        );
+        Approval {
+            id: JOB.into(),
+            action: "print_test".into(),
+            target_id: TARGET.into(),
+            target_proof: proof,
+        }
+    }
+    #[test]
+    fn only_the_confirmed_action_and_address_can_consume_consent_once() {
+        let now = Instant::now();
+        let mut list = vec![];
+        assert!(remember(&mut list, consent(), who(), 0, now));
+        let run = |list: &mut Vec<Entry>, action: &str, ip: &str| {
+            approved(
+                list,
+                &who(),
+                JOB,
+                action,
+                TARGET,
+                Some(ip.parse().unwrap()),
+                now,
+            )
+        };
+        assert!(!run(&mut list, "reconnect_printer", "10.0.0.1"));
+        assert!(!run(&mut list, "print_test", "10.0.0.2"));
+        assert!(approved(
+            &mut list,
+            &who(),
+            JOB,
+            "print_test",
+            TARGET,
+            None,
+            now
+        ));
+        assert!(run(&mut list, "print_test", "10.0.0.1"));
+        assert!(remember(&mut list, consent(), who(), 100, now));
+        assert!(!run(&mut list, "print_test", "10.0.0.1"));
+    }
+    #[test]
+    fn expires_by_monotonic_time_and_does_not_follow_an_account_or_device_change() {
+        let now = Instant::now();
+        let mut list = vec![];
+        assert!(!remember(&mut list, consent(), who(), 91_000, now));
+        assert!(remember(&mut list, consent(), who(), 0, now));
+        assert!(!approved(
+            &mut list,
+            &("".into(), "other".into()),
+            JOB,
+            "print_test",
+            TARGET,
+            None,
+            now
+        ));
+        assert!(!approved(
+            &mut list,
+            &who(),
+            JOB,
+            "print_test",
+            TARGET,
+            None,
+            now + TTL
+        ));
+    }
+}
