@@ -0,0 +1,148 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/cases/history_ui.dart';
+import 'package:flutter_hbb/steaddesk/cases/self_fix_history.dart';
+import 'package:flutter_hbb/steaddesk/support_help.dart';
+
+Map<String, Object> receipt(String action, String state, int at) => {
+      'id': 'sf_fixture',
+      'action': action,
+      'state': state,
+      'at': at,
+      'card_id': 'reviewed_example',
+      'card_version': 2,
+      'actor': '商户设备 …4321',
+      'target_name': 'Kitchen printer',
+      'ticket_id': 'h_fixture',
+    };
+
+void main() {
+  test('strict projection and authorization before HTTP', () async {
+    final valid = receipt('print_test', 'success', 300);
+    expect(
+        SelfFixEvent.parse([
+          valid,
+          {...valid, 'action': 'reboot'},
+          {...valid, 'actor': 'merchant:123454321'},
+          {...valid, 'state': 'ok'},
+          {...valid, 'card_version': null},
+          {...valid, 'at': -1},
+        ]).length,
+        1);
+    expect(() => SelfFixEvent.parse(List.filled(101, valid)),
+        throwsFormatException);
+    for (final (origin, peer, current) in [
+      ('http://127.0.0.1', '123454321', true),
+      ('https://127.0.0.1', '12345/../9', true),
+      ('https://127.0.0.1', '123454321', false),
+    ]) {
+      final api = SupportHelpApi(
+          Uri.parse(origin), 'example', 'fixture', () => current);
+      await expectLater(
+          api.selfFixHistory(peer), throwsA(isA<HelpStaffError>()));
+      api.dispose();
+    }
+  });
+
+  testWidgets(
+      '0025 merges actual events in time order, scoped to device and live authorization',
+      (t) async {
+    t.view.devicePixelRatio = 1;
+    t.view.physicalSize = const Size(900, 920);
+    addTearDown(t.view.resetDevicePixelRatio);
+    addTearDown(t.view.resetPhysicalSize);
+    final result = SelfFixEvent.parse([
+      receipt('print_test', 'success', 300),
+      receipt('reconnect_printer', 'failed', 100),
+    ]);
+    final data = {
+      'can_store': true,
+      'device': [
+        {
+          'id': 'session',
+          'category': 'printer',
+          'result': 'resolved',
+          'agent': 'Support A',
+          'note': 'Physical inspection',
+          'started_at': DateTime.fromMillisecondsSinceEpoch(175000, isUtc: true)
+              .toIso8601String(),
+          'ended_at': DateTime.fromMillisecondsSinceEpoch(200000, isUtc: true)
+              .toIso8601String()
+        }
+      ],
+      'store': [],
+    };
+    var allowed = true;
+    await t.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: SelfFixHistory(
+      scope: 'device A',
+      current: () => allowed,
+      load: () async => result,
+      child: CaseHistoryDrawer(
+          data: data,
+          onClose: () {},
+          onEditDevice: () {},
+          onAppend: (_, __, ___) async {}),
+    ))));
+    await t.pumpAndSettle();
+    final ok = find.text('商户自助：打印测试页（成功）');
+    final failed = find.text('商户自助：重新连接打印机（失败）');
+    final middle = find.textContaining('Support A');
+    expect(t.getTopLeft(ok).dy, lessThan(t.getTopLeft(middle).dy));
+    expect(t.getTopLeft(middle).dy, lessThan(t.getTopLeft(failed).dy));
+    expect(find.textContaining('步骤卡 reviewed_example · v2'), findsNWidgets(2));
+    await t.tap(find.text('本门店'));
+    await t.pumpAndSettle();
+    expect(ok, findsNothing);
+    await t.tap(find.text('本设备'));
+    await t.pumpAndSettle();
+    expect(ok, findsOneWidget);
+    allowed = false;
+    await t.pump(const Duration(seconds: 1));
+    await t.pump();
+    expect(ok, findsNothing);
+    expect(middle, findsOneWidget);
+    await t.pumpWidget(const SizedBox());
+  });
+
+  testWidgets(
+      'device history drops late data when changing scope and clears on forbidden refresh',
+      (t) async {
+    final first = Completer<List<SelfFixEvent>>();
+    final second = Completer<List<SelfFixEvent>>();
+    var denied = false;
+    Future<void> show(String scope, Completer<List<SelfFixEvent>> result) =>
+        t.pumpWidget(MaterialApp(
+            home: Scaffold(
+                body: SelfFixHistory(
+          scope: scope,
+          current: () => true,
+          load: () =>
+              denied ? Future.error(const HelpStaffError(403)) : result.future,
+        ))));
+    await show('old account', first);
+    await show('current account', second);
+    first.complete(SelfFixEvent.parse([receipt('print_test', 'failed', 100)]));
+    second.complete(SelfFixEvent.parse([
+      receipt('reconnect_printer', 'unsupported', 300),
+      receipt('reconnect_printer', 'running', 200),
+      receipt('reconnect_printer', 'queued', 100),
+    ]));
+    await t.pumpAndSettle();
+    expect(find.textContaining('打印测试页'), findsNothing);
+    expect(find.textContaining('（不支持）'), findsOneWidget);
+    await t.tap(find.text('查看全部（3）'));
+    await t.pump();
+    expect(find.textContaining('（已排队）'), findsOneWidget);
+    denied = true;
+    for (int i = 0; i < 10; i++) {
+      await t.pump(const Duration(seconds: 1));
+    }
+    await t.pump();
+    expect(find.text('商户自助记录'), findsNothing);
+    await t.pumpWidget(const SizedBox());
+  });
+}
