+//! One local approval per acknowledged merchant job. The Mesh message cannot choose a different printer.
+use crate::steaddesk_printer::{OwnedPrinter, PrinterBinding};
+use hbb_common::{
+    config::Config,
+    sha2::{Digest, Sha256},
+};
+use jni::{
+    objects::{JObject, JString},
+    sys::{jboolean, jint},
+    JNIEnv,
+};
+use serde_derive::Deserialize;
+use std::{
+    net::{Ipv4Addr, SocketAddr},
+    panic::{catch_unwind, AssertUnwindSafe},
+    sync::{Mutex, OnceLock},
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+
+const ALPHABET: &[u8] = b"0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+const TTL: Duration = Duration::from_secs(90);
+type Identity = (String, String);
+static PRINTER: Mutex<Option<OwnedPrinter<Identity>>> = Mutex::new(None);
+
+#[derive(Clone, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+struct Approval {
+    id: String,
+    action: String,
+    target_id: String,
+    target_proof: String,
+}
+
+struct Entry {
+    approval: Approval,
+    identity: Identity,
+    created: Instant,
+    used: bool,
+}
+
+fn ulid(value: &str, prefix: &str) -> Option<u64> {
+    let s = value.strip_prefix(prefix)?.as_bytes();
+    if s.len() != 26 || s[0] > b'7' || !s.iter().all(|b| ALPHABET.contains(b)) {
+        return None;
+    }
+    s[..10].iter().try_fold(0u64, |v, b| {
+        Some(v * 32 + ALPHABET.iter().position(|c| c == b)? as u64)
+    })
+}
+fn identity() -> Identity {
+    (Config::get_option("api-server"), Config::get_id())
+}
+fn entries() -> &'static Mutex<Vec<Entry>> {
+    static APPROVALS: OnceLock<Mutex<Vec<Entry>>> = OnceLock::new();
+    APPROVALS.get_or_init(|| Mutex::new(Vec::new()))
+}
+fn remember(
+    list: &mut Vec<Entry>,
+    approval: Approval,
+    who: Identity,
+    wall_ms: u64,
+    now: Instant,
+) -> bool {
+    let Some(issued) = ulid(&approval.id, "sf_") else {
+        return false;
+    };
+    if issued > wall_ms + 15_000
+        || wall_ms.saturating_sub(issued) > TTL.as_millis() as u64
+        || ulid(&approval.target_id, "i_").is_none()
+        || !matches!(approval.action.as_str(), "print_test" | "reconnect_printer")
+        || approval.target_proof.len() != 64
+        || !approval
+            .target_proof
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    {
+        return false;
+    }
+    list.retain(|e| now.duration_since(e.created) < TTL + Duration::from_secs(20));
+    if let Some(old) = list.iter().find(|e| e.approval.id == approval.id) {
+        return old.approval == approval && old.identity == who;
+    }
+    if list.len() >= 32 {
+        return false;
+    }
+    list.push(Entry {
+        approval,
+        identity: who,
+        created: now,
+        used: false,
+    });
+    true
+}
+
+/// Called by the merchant UI after its explicit confirmation and authenticated POST acknowledgement.
+#[no_mangle]
+pub unsafe extern "C" fn steaddesk_remember_self_fix(data: *const u8, len: usize) -> jint {
+    if data.is_null() || len == 0 || len > 512 {
+        return 0;
+    }
+    catch_unwind(|| {
+        let body = std::slice::from_raw_parts(data, len);
+        let Ok(approval) = serde_json::from_slice(body) else {
+            return 0;
+        };
+        let Ok(at) = SystemTime::now().duration_since(UNIX_EPOCH) else {
+            return 0;
+        };
+        let Ok(mut list) = entries().lock() else {
+            return 0;
+        };
+        remember(
+            &mut list,
+            approval,
+            identity(),
+            at.as_millis() as u64,
+            Instant::now(),
+        ) as jint
+    })
+    .unwrap_or(0)
+}
+fn approved(
+    list: &mut [Entry],
+    who: &Identity,
+    id: &str,
+    action: &str,
+    target: &str,
+    ip: Option<Ipv4Addr>,
+    now: Instant,
+) -> bool {
+    let Some(entry) = list.iter_mut().find(|e| {
+        !e.used
+            && e.identity == *who
+            && e.approval.id == id
+            && e.approval.target_id == target
+            && e.approval.action == action
+            && now.duration_since(e.created) < TTL
+    }) else {
+        return false;
+    };
+    if let Some(addr) = ip {
+        let proof = format!(
+            "{:x}",
+            Sha256::digest(format!("{id}|{action}|{target}|{addr}").as_bytes())
+        );
+        if !addr.is_private() || proof != entry.approval.target_proof {
+            return false;
+        }
+        entry.used = true;
+    }
+    true
+}
+#[no_mangle]
+pub extern "system" fn Java_com_carriez_flutter_1hbb_AgentWakeService_selfFixPrinter(
+    mut env: JNIEnv,
+    this: JObject,
+    execute: jboolean,
+    id: JString,
+    action: JString,
+    target: JString,
+    ip: JString,
+) -> jint {
+    catch_unwind(AssertUnwindSafe(|| -> Option<jint> {
+        let id: String = env.get_string(&id).ok()?.into();
+        let action: String = env.get_string(&action).ok()?.into();
+        let target: String = env.get_string(&target).ok()?.into();
+        let ip: String = env.get_string(&ip).ok()?.into();
+        let addr = if execute != 0 {
+            let parsed: Ipv4Addr = ip.parse().ok()?;
+            if !parsed.is_private() || parsed.to_string() != ip {
+                return None;
+            }
+            Some(parsed)
+        } else {
+            if !ip.is_empty() {
+                return None;
+            }
+            None
+        };
+        let who = identity();
+        let mut idle = || {
+            identity() == who
+                && env
+                    .call_method(&this, "selfFixIdle", "()Z", &[])
+                    .and_then(|v| v.z())
+                    .unwrap_or(false)
+        };
+        if !idle() {
+            return None;
+        }
+        if !approved(
+            &mut entries().lock().ok()?[..],
+            &who,
+            &id,
+            &action,
+            &target,
+            addr,
+            Instant::now(),
+        ) {
+            return None;
+        }
+        let Some(addr) = addr else {
+            return Some(1);
+        };
+        let binding = PrinterBinding {
+            scope: who.clone(),
+            target,
+            addr: SocketAddr::from((addr, 9100)),
+        };
+        let result = crate::steaddesk_printer::run(&PRINTER, binding, idle, action == "print_test");
+        Some((result == "completed") as jint)
+    }))
+    .ok()
+    .flatten()
+    .unwrap_or(0)
+}
