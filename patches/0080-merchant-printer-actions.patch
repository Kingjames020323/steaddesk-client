@@ -0,0 +1,281 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+import '../kb/card_tile.dart' show cardLanguage;
+import 'self_fix.dart';
+import 'merchant_help_client.dart' show HelpFailure;
+
+String selfFixCopy(String language, String zh, String en, String es) =>
+    switch (cardLanguage(language)) { 'zh' => zh, 'es' => es, _ => en };
+
+class SelfFixCardAction extends StatefulWidget {
+  final SelfFixOffer offer;
+  final String language;
+  final bool online;
+  final Future<SelfFixOptions> Function() options;
+  final Future<SelfFixJob> Function(String target) submit;
+  final String? Function() retryTarget;
+  final VoidCallback contact;
+  const SelfFixCardAction(
+      {super.key,
+      required this.offer,
+      required this.language,
+      required this.online,
+      required this.options,
+      required this.submit,
+      required this.retryTarget,
+      required this.contact});
+  @override
+  State<SelfFixCardAction> createState() => _SelfFixCardActionState();
+}
+
+class _SelfFixCardActionState extends State<SelfFixCardAction>
+    with WidgetsBindingObserver {
+  SelfFixOptions? options;
+  String? issue;
+  Timer? poll;
+  int revision = 0;
+  bool loading = false, working = false, foreground = true;
+  String t(String zh, String en, String es) =>
+      selfFixCopy(widget.language, zh, en, es);
+  bool get testPage => widget.offer.action == 'print_test';
+  String get title => testPage
+      ? t('打印测试页', 'Print test page', 'Imprimir página de prueba')
+      : t('重新连接打印机', 'Reconnect printer', 'Reconectar la impresora');
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    refresh();
+  }
+
+  @override
+  void didUpdateWidget(SelfFixCardAction old) {
+    super.didUpdateWidget(old);
+    if (old.offer != widget.offer || old.online != widget.online) {
+      revision++;
+      options = null;
+      issue = null;
+      loading = false;
+      refresh();
+    }
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    foreground = state == AppLifecycleState.resumed;
+    if (foreground) {
+      refresh();
+    } else {
+      poll?.cancel();
+      revision++;
+      loading = false;
+    }
+  }
+
+  Future<void> refresh() async {
+    poll?.cancel();
+    if (!widget.online || !foreground || loading) return;
+    loading = true;
+    final run = ++revision;
+    try {
+      final next = await widget.options();
+      if (mounted && run == revision) {
+        setState(() => options = next);
+      }
+    } catch (_) {
+      if (mounted && run == revision) {
+        setState(() => options = null);
+      }
+    } finally {
+      if (mounted && run == revision) {
+        loading = false;
+        if (foreground && widget.online) {
+          poll = Timer(Duration(seconds: options?.job?.active == true ? 3 : 10),
+              refresh);
+        }
+      }
+    }
+  }
+
+  String blocked(String code) => switch (code) {
+        'staff_active' => t(
+            '客服正在处理，请稍候',
+            'Support is working on this device. Please wait.',
+            'Soporte está atendiendo el dispositivo. Espere.'),
+        'paused' => t('远程支持已暂停', 'Remote support is paused',
+            'El soporte remoto está en pausa'),
+        'agent_unavailable' => t('打印服务暂不可用', 'Printer service unavailable',
+            'Servicio de impresión no disponible'),
+        'rate_limited' => t(
+            '本小时次数已用完，请稍后再试',
+            'Hourly limit reached. Try again later.',
+            'Límite por hora alcanzado. Inténtelo más tarde.'),
+        'local_consent' => t(
+            '设备未确认本次执行，请联系客服。',
+            'The device could not authorize this action. Contact support.',
+            'El dispositivo no pudo autorizar la acción. Contacte con soporte.'),
+        _ => t(
+            '未能确认操作，请查看当前求助单。',
+            'Could not confirm the action. Check your support request.',
+            'No se pudo confirmar la acción. Consulte su solicitud.'),
+      };
+
+  Future<void> confirm() async {
+    final current = options;
+    if (working ||
+        current == null ||
+        current.blocked != null ||
+        current.printers.isEmpty) return;
+    setState(() {
+      working = true;
+      issue = null;
+    });
+    try {
+      final retry = widget.retryTarget();
+      final choices = current.job?.active == true
+          ? current.printers.where((p) => p.id == retry).toList()
+          : current.printers;
+      if (choices.isEmpty) return;
+      SelfFixPrinter? selection = choices.length == 1 ? choices.single : null;
+      final target = await showDialog<String>(
+          context: context,
+          useRootNavigator: false,
+          builder: (ctx) => StatefulBuilder(
+              builder: (_, change) => AlertDialog(
+                      title: Text(title),
+                      content: SingleChildScrollView(
+                          child: Column(
+                              mainAxisSize: MainAxisSize.min,
+                              crossAxisAlignment: CrossAxisAlignment.stretch,
+                              children: [
+                            if (choices.length > 1)
+                              DropdownButtonFormField<String>(
+                                  value: selection?.id,
+                                  isExpanded: true,
+                                  decoration: InputDecoration(
+                                      labelText: t(
+                                          '选择已登记打印机',
+                                          'Select a registered printer',
+                                          'Seleccione una impresora registrada')),
+                                  items: [
+                                    for (final p in choices)
+                                      DropdownMenuItem(
+                                          value: p.id,
+                                          child: Text(choices
+                                                      .where((entry) =>
+                                                          entry.name == p.name)
+                                                      .length >
+                                                  1
+                                              ? '${p.name} · ${p.id.substring(p.id.length - 6)}'
+                                              : p.name))
+                                  ],
+                                  onChanged: (id) => change(() => selection =
+                                      choices.firstWhere((p) => p.id == id))),
+                            if (selection != null)
+                              Padding(
+                                  padding: const EdgeInsets.only(top: 8),
+                                  child: Text(testPage
+                                      ? t(
+                                          '将向${selection!.name}发送一张测试页。',
+                                          'A test page will be sent to ${selection!.name}.',
+                                          'Se enviará una página de prueba a ${selection!.name}.')
+                                      : t(
+                                          '将重新连接${selection!.name}。',
+                                          'This will reconnect ${selection!.name}.',
+                                          'Se volverá a conectar ${selection!.name}.'))),
+                          ])),
+                      actions: [
+                        TextButton(
+                            onPressed: () => Navigator.pop(ctx),
+                            child: Text(t('取消', 'Cancel', 'Cancelar'))),
+                        FilledButton(
+                            onPressed: selection == null
+                                ? null
+                                : () => Navigator.pop(ctx, selection!.id),
+                            child: Text(t('确认', 'Confirm', 'Confirmar')))
+                      ])));
+      if (!mounted || target == null || !widget.online || !foreground) return;
+      final job = await widget.submit(target);
+      if (mounted)
+        setState(() => options = SelfFixOptions(current.printers, null, job));
+    } on HelpFailure catch (e) {
+      if (mounted) {
+        setState(() => issue = e.status == 429 ? 'rate_limited' : e.code);
+      }
+    } catch (_) {
+      if (mounted) setState(() => issue = 'unknown');
+    } finally {
+      if (mounted) {
+        setState(() => working = false);
+        await refresh();
+      }
+    }
+  }
+
+  @override
+  void dispose() {
+    revision++;
+    poll?.cancel();
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final opt = options;
+    if (!widget.online || opt == null || opt.printers.isEmpty) {
+      return const SizedBox.shrink();
+    }
+    final job = opt.job;
+    final targetName =
+        opt.printers.where((p) => p.id == job?.target).firstOrNull?.name;
+    final canPress = opt.blocked == null &&
+        !working &&
+        (job?.active != true || widget.retryTarget() != null);
+    final detail = switch (job?.state) {
+      'queued' => t('已排队，等待打印服务', 'Queued for the printer service',
+          'En cola para el servicio de impresión'),
+      'running' => t('正在执行…', 'In progress…', 'En curso…'),
+      'success' => t('操作成功，请检查打印机。', 'Action completed. Check the printer.',
+          'Acción completada. Compruebe la impresora.'),
+      'failed' => t(
+          '操作失败。请检查纸张、电源和连接。',
+          'Action failed. Check paper, power and connections.',
+          'La acción falló. Revise el papel, la alimentación y la conexión.'),
+      'unsupported' => t(
+          '这台打印机不支持该操作。',
+          'This printer does not support the action.',
+          'Esta impresora no admite la acción.'),
+      _ => null
+    };
+    return Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      FilledButton.icon(
+          onPressed: canPress ? confirm : null,
+          icon: Icon(testPage ? Icons.print_outlined : Icons.refresh),
+          label: Text(title)),
+      if (targetName != null && detail != null)
+        Text(targetName, style: Theme.of(context).textTheme.labelMedium),
+      if (opt.blocked != null || detail != null || issue != null)
+        Padding(
+            padding: const EdgeInsets.symmetric(vertical: 6),
+            child: Semantics(
+                liveRegion: true,
+                child: Text(opt.blocked != null
+                    ? blocked(opt.blocked!)
+                    : issue != null
+                        ? blocked(issue!)
+                        : detail!))),
+      if (issue != null ||
+          job?.state == 'failed' ||
+          job?.state == 'unsupported')
+        Align(
+            alignment: Alignment.centerLeft,
+            child: TextButton.icon(
+                onPressed: widget.contact,
+                icon: const Icon(Icons.headset_mic_outlined),
+                label: Text(
+                    t('联系客服', 'Contact support', 'Contactar con soporte')))),
+    ]);
+  }
+}
