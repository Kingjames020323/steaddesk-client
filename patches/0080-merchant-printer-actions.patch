diff --git a/flutter/lib/steaddesk/self_fix_event.dart b/flutter/lib/steaddesk/self_fix_event.dart
new file mode 100644
index 0000000..b1d49cd
--- /dev/null
+++ b/flutter/lib/steaddesk/self_fix_event.dart
@@ -0,0 +1,54 @@
+const printerActionLabels = {
+  'print_test': '打印测试页',
+  'reconnect_printer': '重新连接打印机',
+};
+const selfFixStateLabels = {
+  'queued': '已排队',
+  'running': '执行中',
+  'success': '成功',
+  'failed': '失败',
+  'unsupported': '不支持',
+};
+
+class SelfFixEvent {
+  final String action, state, actor, card, target;
+  final int version;
+  final DateTime at;
+  SelfFixEvent._(this.action, this.state, this.actor, this.card, this.target,
+      this.version, this.at);
+
+  static List<SelfFixEvent> parse(Object? raw) {
+    if (raw is! List || raw.length > 100) {
+      throw const FormatException('Invalid self-fix history');
+    }
+    final result = <SelfFixEvent>[];
+    for (final item in raw) {
+      if (item is! Map) continue;
+      final action = item['action'], state = item['state'];
+      final actor = item['actor'], card = item['card_id'];
+      final version = item['card_version'], at = item['at'];
+      final target = item['target_name'];
+      if (!printerActionLabels.containsKey(action) ||
+          !selfFixStateLabels.containsKey(state) ||
+          actor is! String ||
+          !RegExp(r'^商户设备 …[0-9]{4}$').hasMatch(actor) ||
+          card is! String ||
+          !RegExp(r'^[A-Za-z0-9_-]{1,100}$').hasMatch(card) ||
+          target is! String ||
+          target.isEmpty ||
+          target.runes.length > 128 ||
+          RegExp(r'[\x00-\x1f\x7f]').hasMatch(target) ||
+          version is! int ||
+          version < 1 ||
+          at is! int ||
+          at < 0 ||
+          at > 253402300799) {
+        continue;
+      }
+      result.add(SelfFixEvent._(action, state, actor, card, target, version,
+          DateTime.fromMillisecondsSinceEpoch(at * 1000, isUtc: true)));
+    }
+    // The server supplies newest first, including event order within a second.
+    return result;
+  }
+}
