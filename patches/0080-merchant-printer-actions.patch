@@ -0,0 +1,107 @@
+//! Fixed raw-printer transport shared by support and merchant approvals.
+use std::{
+    io::Write,
+    net::{SocketAddr, TcpStream},
+    sync::Mutex,
+    time::Duration,
+};
+pub(crate) const PAGE: &[u8] = b"SteadDesk printer test\n\n\n";
+const PRINTER_TTL: Duration = Duration::from_secs(600);
+
+#[derive(PartialEq, Clone)]
+pub(crate) struct PrinterBinding<S> {
+    pub(crate) scope: S,
+    pub(crate) target: String,
+    pub(crate) addr: SocketAddr,
+}
+pub(crate) struct OwnedPrinter<S> {
+    pub(crate) binding: PrinterBinding<S>,
+    stream: TcpStream,
+    opened: std::time::Instant,
+}
+pub(crate) fn run<S: Clone + PartialEq + Send + 'static>(
+    slot_ref: &'static Mutex<Option<OwnedPrinter<S>>>,
+    binding: PrinterBinding<S>,
+    allowed: impl FnMut() -> bool,
+    print: bool,
+) -> &'static str {
+    let mut slot = match slot_ref.lock() {
+        Ok(slot) => slot,
+        Err(_) => return "failed",
+    };
+    let result = transfer_printer(
+        &mut slot,
+        &binding,
+        || TcpStream::connect_timeout(&binding.addr, Duration::from_secs(2)),
+        allowed,
+        print,
+    );
+    if !print && result == "completed" {
+        let Some(opened) = slot.as_ref().map(|p| p.opened) else {
+            return "failed";
+        };
+        if std::thread::Builder::new()
+            .name("fixed-printer-expiry".into())
+            .spawn(move || {
+                std::thread::sleep(PRINTER_TTL);
+                if let Ok(mut held) = slot_ref.lock() {
+                    if held.as_ref().is_some_and(|p| p.opened == opened) {
+                        held.take();
+                    }
+                }
+            })
+            .is_err()
+        {
+            slot.take();
+            return "failed";
+        }
+    }
+    result
+}
+
+pub(crate) fn transfer_printer<S: Clone + PartialEq>(
+    slot: &mut Option<OwnedPrinter<S>>,
+    binding: &PrinterBinding<S>,
+    dial: impl FnOnce() -> std::io::Result<TcpStream>,
+    mut allowed: impl FnMut() -> bool,
+    print: bool,
+) -> &'static str {
+    // Taking ownership before every attempt means an uncertain write can never fall back to a second connection.
+    let previous = slot
+        .take()
+        .filter(|p| p.binding == *binding && p.opened.elapsed() < PRINTER_TTL);
+    if !allowed() {
+        return "cancelled";
+    }
+    if !print {
+        drop(previous);
+        let Ok(stream) = dial() else { return "failed" };
+        if !allowed() {
+            return "cancelled";
+        }
+        *slot = Some(OwnedPrinter {
+            binding: binding.clone(),
+            stream,
+            opened: std::time::Instant::now(),
+        });
+        return "completed";
+    }
+    let mut stream = match previous {
+        Some(p) => p.stream,
+        None => match dial() {
+            Ok(stream) => stream,
+            Err(_) => return "failed",
+        },
+    };
+    if !allowed() {
+        return "cancelled";
+    }
+    if stream
+        .set_write_timeout(Some(Duration::from_secs(2)))
+        .is_err()
+        || stream.write_all(PAGE).is_err()
+    {
+        return "failed";
+    }
+    "completed"
+}
