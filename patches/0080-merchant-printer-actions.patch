+import 'package:flutter_hbb/steaddesk/help/self_fix.dart';
+import 'package:flutter_hbb/steaddesk/store_feature_policy.dart';
+
+const ticket = 'h_0123456789abcdef0123456789abcdef';
+const kitchen = 'i_00000000000000000000000001',
+    counter = 'i_00000000000000000000000002';
+const jobId = 'sf_00000000000000000000000001';
+const title = '打印机没出纸：先打一张测试页';
+final card = <String, dynamic>{
+  'card_id': 'kb_self_fix_print_test',
+  'card_version': 1,
+  'offer_id': 'a' * 64,
+  'action': 'print_test',
+  'locales': {
+    'zh': {
+      'title': title,
+      'steps': [
+        '检查纸卷是否装好，并确认出纸口没有卡纸。',
+        '选择要检查的打印机，确认后打印测试页。',
+        '查看是否打印出测试页；若仍未出纸，请联系客服。'
+      ]
+    }
+  }
+};
+const translations = {
+  'View help request': '查看求助单',
+  'Contact support': '联系客服',
+  'Collapse help': '收起求助',
+  'Suggested steps': '建议步骤',
+  'This solved my problem': '这个解决了我的问题',
+  'Cancel help request': '取消求助',
+  'Waiting for %s min': '已等待 %s 分钟',
+  '%s ahead of you': '前面还有 %s 位',
+  'Request closed': '求助已结束',
+  'Start another request': '发起新的求助'
+};
+String label(String key) => translations[key] ?? key;
+
+class Fixture {
+  final owner = (
+    origin: Uri.parse('https://fixture.invalid'),
+    device: '123456789',
+    account: ''
+  );
+  bool enabled = true,
+      paused = false,
+      bound = true,
+      recordLocal = true,
+      loseReply = false;
+  String? blocked, state, postTarget;
+  String ticketState = 'queued', fakeAction = 'print_test';
+  final posts = <String>[], consents = <HelpJson>[];
+  final targets = [
+    {'id': kitchen, 'name': '厨房打印机'},
+    {'id': counter, 'name': '收银打印机'}
+  ];
+  HelpJson get view => {
+        'id': ticket,
+        'lane': 'verified',
+        'version': ticketState == 'queued' ? 1 : 2,
+        'state': ticketState,
+        'queued_at': 900,
+        'created_at': 900,
+        'queue_updated_at': 1200,
+        'ahead': 2,
+        if (ticketState == 'closed') 'ended_at': 1200
+      };
+  HelpJson get job => {
+        'id': jobId,
+        'state': state,
+        'action': 'print_test',
+        'target_id': postTarget ?? kitchen,
+        'created_at': 1200
+      };
+  Future<HelpJson> send(Uri origin, String method, String path, String? secret,
+      HelpJson? body, String? key, int? version) async {
+    expect(origin, owner.origin);
+    if (path == 'capabilities') return {'kb': true};
+    expect(secret, 'demo-receipt');
+    if (path.startsWith('me/self-fix?')) {
+      expect(method, 'GET');
+      expect(Uri.parse(path).queryParameters, {
+        'card_id': card['card_id'],
+        'card_version': '1',
+        'offer_id': card['offer_id']
+      });
+      if (!bound) throw HelpFailure(404);
+      return {
+        'action': 'print_test',
+        'blocked': blocked,
+        'targets': targets,
+        'job': state == null ? null : job
+      };
+    }
+    if (path == 'me') return view;
+    if (path == 'me/kb-cards')
+      return {
+        'cards': [card]
+      };
+    if (path == 'me/kb-shown' || path == 'me/kb-used')
+      return {'accepted': true};
+    if (path == 'me/self-resolve') {
+      ticketState = 'closed';
+      return view;
+    }
+    throw StateError('Unexpected $method $path');
+  }
+
+  Future<HelpJson> submit(HelpScope scope, String receipt, HelpJson body,
+      String key, Future<bool> Function() current) async {
+    expect(await current(), isTrue);
+    expect(scope, owner);
+    expect(receipt, 'demo-receipt');
+    expect(
+        body.keys,
+        unorderedEquals(
+            ['card_id', 'card_version', 'offer_id', 'target_id', 'action']));
+    posts.add(key);
+    postTarget = body['target_id'];
+    state = 'queued';
+    if (loseReply) throw HelpFailure(0);
+    return {...job, 'action': fakeAction, 'target_proof': 'c' * 64};
+  }
+
+  Future<bool> remember(HelpJson consent) async {
+    consents.add(consent);
+    return recordLocal;
+  }
+
+  MerchantHelpClient client(File file) => MerchantHelpClient(
+      file,
+      () async => owner,
+      (_, __, ___, ____) => throw StateError('Existing receipt only'),
+      'fixture',
+      send: send,
+      sendSelfFix: submit,
+      rememberSelfFix: remember,
+      selfFixPaused: () async => paused,
+      clock: () => 1200,
+      useKb: true,
+      canUseStoreFeature: (name) async => name != 'self_fix' || enabled);
+  void seed(MerchantHelpClient c) {
+    c.view = view;
+    c.cards = [card];
+    c.record = {
+      'owner': c.fingerprint(owner),
+      'view': view,
+      'secret': 'demo-receipt'
+    };
+  }
+}
+
+// Widget fixtures replace disk scheduling only. Receipt policy, option parsing,
+// confirmation, polling and the separate merchant resolution use real clients.
+class WidgetClient extends MerchantHelpClient {
+  final Fixture fixture;
+  WidgetClient(this.fixture)
+      : super(
+            File('unused-fixture'),
+            () async => fixture.owner,
+            (_, __, ___, ____) => throw StateError('Fixture receipt only'),
+            'fixture',
+            useKb: true,
+            clock: () => 1200,
+            send: fixture.send,
+            sendSelfFix: fixture.submit,
+            rememberSelfFix: fixture.remember,
+            selfFixPaused: () async => fixture.paused,
+            canUseStoreFeature: (s) async =>
+                s != 'self_fix' || fixture.enabled);
+  @override
+  Future<void> save() async {}
+  @override
+  Future<void> initialize() async {
+    fixture.seed(this);
+  }
+}
+
+Widget fixtureEntry(Fixture f) => MerchantHelpEntry(
+    open: () async => WidgetClient(f),
+    label: label,
+    callbacksEnabled: false,
