diff --git a/flutter/lib/steaddesk/help/self_fix.dart b/flutter/lib/steaddesk/help/self_fix.dart
new file mode 100644
index 0000000..42cc90a
--- /dev/null
+++ b/flutter/lib/steaddesk/help/self_fix.dart
@@ -0,0 +1,80 @@
+const selfFixActions = {'print_test', 'reconnect_printer'};
+final _identifier = RegExp(r'^[A-Za-z0-9_-]{1,80}$');
+final _offer = RegExp(r'^[a-f0-9]{64}$');
+final _printer = RegExp(r'^i_[0-7][0-9A-HJKMNP-TV-Z]{25}$');
+final _job = RegExp(r'^sf_[0-7][0-9A-HJKMNP-TV-Z]{25}$');
+
+typedef SelfFixPrinter = ({String id, String name});
+typedef SelfFixOffer = ({
+  String card,
+  int version,
+  String offer,
+  String action
+});
+
+SelfFixOffer? selfFixOffer(Map card) {
+  final id = card['card_id'], version = card['card_version'];
+  final offer = card['offer_id'], action = card['action'];
+  if (id is! String ||
+      !_identifier.hasMatch(id) ||
+      version is! int ||
+      version < 1 ||
+      version > 9007199254740991 ||
+      offer is! String ||
+      !_offer.hasMatch(offer) ||
+      action is! String ||
+      !selfFixActions.contains(action)) return null;
+  return (card: id, version: version, offer: offer, action: action);
+}
+
+class SelfFixJob {
+  final String id, action, target, state;
+  const SelfFixJob(this.id, this.action, this.target, this.state);
+  bool get active => state == 'queued' || state == 'running';
+
+  factory SelfFixJob.parse(dynamic raw, SelfFixOffer offer) {
+    if (raw is! Map ||
+        raw['id'] is! String ||
+        !_job.hasMatch(raw['id']) ||
+        raw['action'] != offer.action ||
+        raw['target_id'] is! String ||
+        !_printer.hasMatch(raw['target_id']) ||
+        !const {'queued', 'running', 'success', 'failed', 'unsupported'}
+            .contains(raw['state'])) {
+      throw const FormatException('Invalid self-fix job');
+    }
+    return SelfFixJob(raw['id'], raw['action'], raw['target_id'], raw['state']);
+  }
+}
+
+class SelfFixOptions {
+  final List<SelfFixPrinter> printers;
+  final String? blocked;
+  final SelfFixJob? job;
+  const SelfFixOptions(this.printers, this.blocked, this.job);
+
+  factory SelfFixOptions.parse(Map raw, SelfFixOffer offer) {
+    if (raw['action'] != offer.action ||
+        !raw.containsKey('blocked') ||
+        !const {null, 'staff_active', 'paused', 'agent_unavailable'}
+            .contains(raw['blocked']) ||
+        raw['targets'] is! List ||
+        !raw.containsKey('job')) {
+      throw const FormatException('Invalid self-fix options');
+    }
+    final printers = <SelfFixPrinter>[], ids = <String>{};
+    for (final p in raw['targets']) {
+      if (p is! Map ||
+          p['id'] is! String ||
+          !_printer.hasMatch(p['id']) ||
+          !ids.add(p['id']) ||
+          p['name'] is! String ||
+          (p['name'] as String).trim().isEmpty) {
+        throw const FormatException('Invalid self-fix printer');
+      }
+      printers.add((id: p['id'] as String, name: p['name'] as String));
+    }
+    return SelfFixOptions(printers, raw['blocked'] as String?,
+        raw['job'] == null ? null : SelfFixJob.parse(raw['job'], offer));
+  }
+}
diff --git a/flutter/lib/steaddesk/help/self_fix_card.dart b/flutter/lib/steaddesk/help/self_fix_card.dart
