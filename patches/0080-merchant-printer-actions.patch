@@ -0,0 +1,51 @@
+import 'dart:io';
+
+import '../../models/native_model.dart' show PlatformFFI;
+import '../../models/platform_model.dart' show bind;
+import '../quick/http.dart';
+import 'merchant_help_client.dart';
+
+Future<bool> merchantSelfFixPaused() async {
+  if (!Platform.isAndroid) return !Platform.isWindows;
+  try {
+    return await PlatformFFI.instance
+            .invokeMethodWithResult<bool>('merchant_remote_paused') !=
+        false;
+  } catch (_) {
+    return true;
+  }
+}
+
+Future<HelpJson> sendMerchantSelfFix(HelpScope owner, String receipt,
+    HelpJson body, String key, Future<bool> Function() current) async {
+  final signer = PlatformFFI.instance.helpSigner;
+  if (signer == null ||
+      await bind.mainGetMyId() != owner.device ||
+      !await current()) {
+    throw HelpFailure(403);
+  }
+  final scope = (
+    origin: owner.origin,
+    device: owner.device,
+    binding: signer.quickCheckBinding()
+  );
+  final identity =
+      await signedQuickCall(scope, 'identity', 0, {}, signer.signQuickCheck);
+  final version = identity['key_version'];
+  if (version is! int || version < 1 || !await current())
+    throw HelpFailure(403);
+  final proof = signer.signSelfFix(version, body);
+  if (proof['X-Fleet-Device'] != owner.device || !await current())
+    throw HelpFailure(403);
+  return sendHelp(owner.origin, 'POST', 'me/self-fix', receipt, body, key, null,
+      deviceProof: proof);
+}
+
+Future<bool> rememberMerchantSelfFix(Map<String, dynamic> consent) async {
+  if (!Platform.isAndroid || await merchantSelfFixPaused()) return false;
+  try {
+    return PlatformFFI.instance.helpSigner?.rememberSelfFix(consent) ?? false;
+  } catch (_) {
+    return false;
+  }
+}
