diff --git a/flutter/lib/steaddesk/cases/self_fix_history.dart b/flutter/lib/steaddesk/cases/self_fix_history.dart
new file mode 100644
index 0000000..86df339
--- /dev/null
+++ b/flutter/lib/steaddesk/cases/self_fix_history.dart
@@ -0,0 +1,169 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import '../self_fix_event.dart';
+export '../self_fix_event.dart' show SelfFixEvent;
+
+/// Only the bound remote-session report supplies this device-scoped timeline.
+class SessionSelfFixHistory extends InheritedWidget {
+  final List<SelfFixEvent> events;
+  const SessionSelfFixHistory(
+      {super.key, required this.events, required super.child});
+  static List<SelfFixEvent> eventsOf(BuildContext context) =>
+      context
+          .dependOnInheritedWidgetOfExactType<SessionSelfFixHistory>()
+          ?.events ??
+      const [];
+  @override
+  bool updateShouldNotify(SessionSelfFixHistory oldWidget) =>
+      events != oldWidget.events;
+}
+
+class SelfFixHistory extends StatefulWidget {
+  const SelfFixHistory(
+      {super.key,
+      required this.scope,
+      required this.load,
+      required this.current,
+      this.child});
+  final Widget? child;
+  final Object scope;
+  final Future<List<SelfFixEvent>> Function() load;
+  final bool Function() current;
+
+  @override
+  State<SelfFixHistory> createState() => _SelfFixHistoryState();
+}
+
+class _SelfFixHistoryState extends State<SelfFixHistory> {
+  List<SelfFixEvent> events = const [];
+  bool expanded = false, pending = false;
+  int epoch = 0;
+  Timer? timer;
+  @override
+  void initState() {
+    super.initState();
+    _start();
+  }
+
+  void _start() {
+    _refresh();
+    var ticks = 0;
+    timer = Timer.periodic(const Duration(seconds: 1), (_) {
+      if (!widget.current()) {
+        _clear();
+      } else if (++ticks % 10 == 0) {
+        _refresh();
+      }
+    });
+  }
+
+  void _clear() {
+    epoch++;
+    pending = false;
+    if (events.isNotEmpty || expanded) {
+      setState(() {
+        events = const [];
+        expanded = false;
+      });
+    }
+  }
+
+  @override
+  void didUpdateWidget(SelfFixHistory old) {
+    super.didUpdateWidget(old);
+    if (old.scope != widget.scope) {
+      _clear();
+      _refresh();
+    }
+  }
+
+  Future<void> _refresh() async {
+    if (pending || !widget.current()) return;
+    pending = true;
+    final generation = ++epoch;
+    List<SelfFixEvent> next;
+    try {
+      next = await widget.load();
+    } catch (_) {
+      next = const [];
+    }
+    if (!mounted || generation != epoch) return;
+    pending = false;
+    if (!widget.current()) {
+      _clear();
+      return;
+    }
+    setState(() {
+      events = next;
+      if (events.isEmpty) expanded = false;
+    });
+  }
+
+  @override
+  void dispose() {
+    timer?.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (widget.child != null) {
+      return SessionSelfFixHistory(
+          events: widget.current() ? events : const [], child: widget.child!);
+    }
+    if (!widget.current() || events.isEmpty) return const SizedBox.shrink();
+    final entries = expanded ? events : events.take(2);
+    return Padding(
+      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
+      child: Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+        Text('商户自助记录', style: Theme.of(context).textTheme.titleSmall),
+        for (final e in entries) SelfFixEventRow(e),
+        if (events.length > 2)
+          Align(
+              alignment: Alignment.centerLeft,
+              child: TextButton(
+                  onPressed: () => setState(() => expanded = !expanded),
+                  child: Text(expanded ? '收起' : '查看全部（${events.length}）'))),
+      ]),
+    );
+  }
+}
+
+class SelfFixEventRow extends StatelessWidget {
+  const SelfFixEventRow(this.event,
+      {super.key, this.titleStyle, this.detailStyle});
+  final TextStyle? titleStyle, detailStyle;
+  final SelfFixEvent event;
+  @override
+  Widget build(BuildContext context) {
+    final e = event;
+    return Padding(
+        padding: const EdgeInsets.symmetric(vertical: 6),
+        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+          Text(
+              '商户自助：${printerActionLabels[e.action]}（${selfFixStateLabels[e.state]}）',
+              style: titleStyle),
+          Text(
+              '${e.at.toLocal().toString().split(".").first} · ${e.actor} · ${e.target}\n步骤卡 ${e.card} · v${e.version}',
+              style: detailStyle ?? Theme.of(context).textTheme.bodySmall),
+        ]));
+  }
+}
+
+/// Both server events and saved reports are ordered newest first. Preserve the
+/// server's order for job transitions that share the same epoch second.
+List<Object> mergeSelfFixTimeline(
+    List<Map> reports, List<SelfFixEvent> events) {
+  final items = <Object>[];
+  var i = 0;
+  for (final report in reports) {
+    final end = DateTime.parse(report['ended_at']);
+    while (i < events.length && !events[i].at.isBefore(end)) {
+      items.add(events[i++]);
+    }
+    items.add(report);
+  }
+  return items..addAll(events.skip(i));
+}
