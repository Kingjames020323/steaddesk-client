+                          submitted = fields;
+                          if (calls.length == 1)
+                            throw const SocketException('offline');
+                        }))))));
+    expect(find.textContaining('Two calls were missed'), findsOneWidget);
+    await t.tap(find.text('Reschedule callback'));
+    await t.pumpAndSettle();
+    expect(find.text(contact['phone']!), findsOneWidget);
+    await t.enterText(find.byType(TextField).at(0), 'Edited contact');
+    await t.ensureVisible(find.byType(DropdownButtonFormField<String>));
+    await t.tap(find.byType(DropdownButtonFormField<String>));
+    await t.pumpAndSettle();
+    for (final label in [
+      'In 30 minutes',
+      'After the store closes',
+      'Choose a store time'
+    ]) {
+      expect(find.text(label).last, findsOneWidget);
+    }
+    await t.tap(find.text('Choose a store time').last);
+    await t.pumpAndSettle();
+    await t.enterText(find.byType(TextField).last, '2026-11-15T14:00');
+    await t.pumpAndSettle();
+    await t.ensureVisible(find.text('Confirm callback'));
+    await t.tap(find.text('Confirm callback'));
+    await t.pumpAndSettle();
+    expect(find.textContaining('Check your connection'), findsOneWidget);
+    await t.ensureVisible(find.text('Confirm callback'));
+    await t.tap(find.text('Confirm callback'));
+    await t.pumpAndSettle();
+    expect(calls.length, 2);
+    expect(calls.first, calls.last);
+    expect(submitted, {
+      ...contact,
+      'name': 'Edited contact',
+      'slot': 'custom',
+      'local_time': '2026-11-15T14:00'
+    });
+  });
+}
