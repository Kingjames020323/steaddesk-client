@@ -0,0 +1,207 @@
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:uuid/uuid.dart';
+
+import 'merchant_help_client.dart';
+
+class MerchantCallback extends StatefulWidget {
+  final String Function(String) label;
+  final bool busy, reschedule;
+  final Future<HelpJson> Function() prepare;
+  final Future<void> Function(int version, HelpJson fields, String key) book;
+  const MerchantCallback({
+    super.key,
+    required this.label,
+    required this.busy,
+    required this.reschedule,
+    required this.prepare,
+    required this.book,
+  });
+  @override
+  State<MerchantCallback> createState() => _MerchantCallbackState();
+}
+
+class _MerchantCallbackState extends State<MerchantCallback> {
+  final name = TextEditingController();
+  final phone = TextEditingController();
+  final language = TextEditingController();
+  final reason = TextEditingController();
+  final custom = TextEditingController();
+  final manualZone = TextEditingController();
+  HelpJson? options;
+  String slot = 'asap';
+  String? error, retryPayload, retryKey;
+  bool working = false;
+
+  @override
+  void dispose() {
+    for (final c in [name, phone, language, reason, custom, manualZone]) {
+      c.dispose();
+    }
+    super.dispose();
+  }
+
+  Future<void> prepare() async {
+    setState(() {
+      working = true;
+      error = null;
+    });
+    try {
+      final data = await widget.prepare();
+      if (!mounted) return;
+      if (data['version'] is! int ||
+          data['after_close'] is! bool ||
+          data['manual_zone_required'] is! bool) throw const FormatException();
+      name.text = data['name'] as String? ?? '';
+      phone.text = data['phone'] as String? ?? '';
+      language.text = data['language'] as String? ?? '';
+      reason.text = data['reason'] as String? ?? '';
+      options = data;
+    } catch (e) {
+      error = errorLabel(e);
+    } finally {
+      if (mounted) setState(() => working = false);
+    }
+  }
+
+  String errorLabel(Object e) {
+    if (e is HelpFailure) {
+      if (e.status == 400 || e.status == 422)
+        return 'Check the callback details and store time.';
+      if (e.status == 409 || e.status == 412)
+        return 'The request changed. Review the latest callback options.';
+      if ([401, 403, 404].contains(e.status) || e.code == 'owner') {
+        return 'Callback booking is unavailable for this request.';
+      }
+    }
+    return 'Cannot reach callback service. Check your connection and retry.';
+  }
+
+  bool get valid {
+    final number = phone.text.trim();
+    final digits = number.replaceAll(RegExp('[^0-9]'), '');
+    return name.text.trim().isNotEmpty &&
+        language.text.trim().isNotEmpty &&
+        reason.text.trim().isNotEmpty &&
+        RegExp(r'^\+?[0-9() .-]+$').hasMatch(number) &&
+        digits.length >= 7 &&
+        digits.length <= 15 &&
+        (options?['manual_zone_required'] != true ||
+            manualZone.text.trim().isNotEmpty) &&
+        (slot != 'custom' ||
+            RegExp(r'^\d{4}-\d\d-\d\dT\d\d:\d\d$')
+                .hasMatch(custom.text.trim()));
+  }
+
+  Future<void> submit() async {
+    if (!valid || working) return;
+    final fields = <String, dynamic>{
+      'name': name.text.trim(),
+      'phone': phone.text.trim(),
+      'language': language.text.trim(),
+      'reason': reason.text.trim(),
+      'slot': slot,
+      if (slot == 'custom') 'local_time': custom.text.trim(),
+      if (options!['manual_zone_required'] == true)
+        'manual_zone': manualZone.text.trim(),
+    };
+    final payload = jsonEncode(fields);
+    if (payload != retryPayload) {
+      retryKey = const Uuid().v4();
+      retryPayload = payload;
+    }
+    setState(() {
+      working = true;
+      error = null;
+    });
+    try {
+      await widget.book(options!['version'], fields, retryKey!);
+      if (mounted) clear();
+    } catch (e) {
+      if (mounted) {
+        if (e is HelpFailure && [409, 412].contains(e.status)) clear();
+        error = errorLabel(e);
+      }
+    } finally {
+      if (mounted) setState(() => working = false);
+    }
+  }
+
+  void clear() {
+    for (final c in [name, phone, language, reason, custom, manualZone]) {
+      c.clear();
+    }
+    options = null;
+    retryPayload = retryKey = error = null;
+    slot = 'asap';
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final t = widget.label;
+    final ready = !working && !widget.busy;
+    Widget field(String label, TextEditingController c, int max,
+            {TextInputType? keyboard, String? hint}) =>
+        TextField(
+            controller: c,
+            enabled: ready,
+            maxLength: max,
+            keyboardType: keyboard,
+            autocorrect: false,
+            enableSuggestions: false,
+            enableIMEPersonalizedLearning: false,
+            decoration: InputDecoration(
+                labelText: t(label), hintText: hint, counterText: ''),
+            onChanged: (_) => setState(() {}));
+    return Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      if (widget.reschedule)
+        Text(t('Two calls were missed. Please schedule a new callback.')),
+      if (options == null)
+        OutlinedButton(
+            onPressed: ready ? prepare : null,
+            child: Text(t(widget.reschedule
+                ? 'Reschedule callback'
+                : 'Request a callback')))
+      else ...[
+        field('Contact name', name, 100),
+        field('Callback phone number', phone, 48,
+            keyboard: TextInputType.phone),
+        field('Preferred language', language, 48),
+        field('Reason for callback', reason, 500),
+        if (options!['manual_zone_required'] == true)
+          field('Store time zone (IANA)', manualZone, 64,
+              hint: 'America/Los_Angeles')
+        else if (options!['zone'] is String)
+          Text(t('Store time zone: %s').replaceFirst('%s', options!['zone'])),
+        DropdownButtonFormField<String>(
+          value: slot,
+          decoration: InputDecoration(labelText: t('Callback time')),
+          items: [
+            for (final e in {
+              'asap': 'As soon as possible',
+              'in_30m': 'In 30 minutes',
+              if (options!['after_close'] == true)
+                'after_close': 'After the store closes',
+              'custom': 'Choose a store time',
+            }.entries)
+              DropdownMenuItem(value: e.key, child: Text(t(e.value))),
+          ],
+          onChanged: ready ? (v) => setState(() => slot = v!) : null,
+        ),
+        if (slot == 'custom')
+          field('Store date and time (YYYY-MM-DDTHH:mm)', custom, 16,
+              keyboard: TextInputType.datetime),
+        FilledButton(
+            onPressed: ready && valid ? submit : null,
+            child: Text(t('Confirm callback'))),
+        TextButton(
+            onPressed: ready ? () => setState(clear) : null,
+            child: Text(t('Cancel'))),
+      ],
+      if (error != null)
+        Text(t(error!),
+            style: TextStyle(color: Theme.of(context).colorScheme.error)),
+    ]);
+  }
+}
