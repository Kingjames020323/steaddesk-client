diff --git a/flutter/lib/steaddesk/store_feature_policy.dart b/flutter/lib/steaddesk/store_feature_policy.dart
new file mode 100644
index 0000000..cd0c4d9
--- /dev/null
+++ b/flutter/lib/steaddesk/store_feature_policy.dart
@@ -0,0 +1,80 @@
+import 'dart:convert';
+
+const storeFeatureNames = {
+  'health',
+  'help',
+  'quick_check',
+  'toolbar',
+  'toolbar_actions',
+  'callback',
+  'step_cards'
+};
+const offlineStoreFeatures = {'health', 'quick_check', 'toolbar', 'step_cards'};
+
+class StoreFeatureSnapshot {
+  final String store;
+  final Map<String, bool> flags;
+  final DateTime observed;
+  final bool online;
+
+  StoreFeatureSnapshot(this.store, this.flags, this.observed,
+      {required this.online});
+
+  factory StoreFeatureSnapshot.parse(
+      Map<String, dynamic> row, DateTime observed,
+      {required bool online}) {
+    final store = row['store_id'], flags = row['flags'];
+    if (store is! String ||
+        store.isEmpty ||
+        flags is! Map ||
+        flags.length != storeFeatureNames.length ||
+        !storeFeatureNames.every((key) => flags[key] is bool)) {
+      throw const FormatException('Invalid store feature response');
+    }
+    return StoreFeatureSnapshot(store, Map<String, bool>.from(flags), observed,
+        online: online);
+  }
+
+  bool allows(String name, bool compiled, DateTime now) {
+    final age = now.difference(observed);
+    return compiled &&
+        flags[name] == true &&
+        !age.isNegative &&
+        age < const Duration(hours: 24) &&
+        (online || offlineStoreFeatures.contains(name));
+  }
+}
+
+Future<StoreFeatureSnapshot?> resolveStoreFeatures({
+  required Future<Map<String, dynamic>> Function() fetch,
+  required int Function(Object) statusOf,
+  required String Function() load,
+  required Future<void> Function(String) save,
+}) async {
+  late final StoreFeatureSnapshot snapshot;
+  try {
+    final body = await fetch();
+    snapshot =
+        StoreFeatureSnapshot.parse(body, DateTime.now().toUtc(), online: true);
+  } catch (e) {
+    final status = statusOf(e);
+    if (e is FormatException ||
+        e is TypeError ||
+        status >= 400 && status < 500) {
+      await save('');
+      return null;
+    }
+    final cached = load();
+    if (cached.isEmpty) return null;
+    final data = jsonDecode(cached) as Map<String, dynamic>;
+    return StoreFeatureSnapshot.parse(data,
+        DateTime.fromMillisecondsSinceEpoch(data['at'] as int, isUtc: true),
+        online: false);
+  }
+  await save(jsonEncode({
+    'store_id': snapshot.store,
+    'flags': snapshot.flags,
+    'at': snapshot.observed.millisecondsSinceEpoch,
+  }));
+  return snapshot;
+}
diff --git a/flutter/lib/steaddesk/store_feature_rows.dart b/flutter/lib/steaddesk/store_feature_rows.dart
new file mode 100644
index 0000000..c62bb87
--- /dev/null
+++ b/flutter/lib/steaddesk/store_feature_rows.dart
@@ -0,0 +1,14 @@
+import 'store_features.dart';
+
+Future<Map<String, StoreFeatureSnapshot>> storeFeaturesForPeers(
+    Iterable<String> peers) async {
+  final unique = peers.toSet().toList();
+  final result = <String, StoreFeatureSnapshot>{};
+  for (var i = 0; i < unique.length; i += 8) {
+    await Future.wait(unique.skip(i).take(8).map((peer) async {
+      final snapshot = await readStoreFeatures(peer);
+      if (snapshot != null) result[peer] = snapshot;
+    }));
+  }
+  return result;
+}
diff --git a/flutter/lib/steaddesk/store_features.dart b/flutter/lib/steaddesk/store_features.dart
new file mode 100644
index 0000000..9068e79
--- /dev/null
+++ b/flutter/lib/steaddesk/store_features.dart
@@ -0,0 +1,178 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:crypto/crypto.dart';
+import 'package:flutter/material.dart';
+
+import '../models/native_model.dart' show PlatformFFI;
+import '../models/platform_model.dart' show bind;
+import 'help/merchant_help_client.dart' show configuredHelpOrigin;
+import 'ops_health.dart';
+import 'quick/check.dart' show CheckFailure, validId;
+import 'quick/http.dart' show signedQuickCall;
+import 'store_feature_policy.dart';
+export 'store_feature_policy.dart';
+
+String operatorContext() {
+  try {
+    final token = bind.mainGetLocalOption(key: 'access_token');
+    return token.isEmpty ? '' : sha256.convert(utf8.encode(token)).toString();
+  } catch (_) {
+    // The native bridge may not be ready when a dialog first mounts.
+    return '';
+  }
+}
+
+typedef _Scope = ({Uri origin, String device, String identity, bool merchant});
+
+Future<_Scope?> _scope(String? peer) async {
+  if (peer != null) {
+    if (!validId(peer)) return null;
+    final origin = Uri.parse(await bind.mainGetApiServer());
+    final token = bind.mainGetLocalOption(key: 'access_token');
+    if (token.isEmpty) return null;
+    return (origin: origin, device: peer, identity: token, merchant: false);
+  }
+  final origin =
+      configuredHelpOrigin(await bind.mainGetOption(key: 'api-server'));
+  final device = await bind.mainGetMyId();
+  final signer = PlatformFFI.instance.helpSigner;
+  if (signer == null || !validId(device)) return null;
+  return (
+    origin: origin,
+    device: device,
+    identity: signer.quickCheckBinding(),
+    merchant: true
+  );
+}
+
+String _cacheKey(_Scope scope) =>
+    'sd-store-features-${sha256.convert(utf8.encode(jsonEncode([
+          scope.origin.toString(),
+          scope.device,
+          scope.identity,
+          scope.merchant
+        ])))}';
+
+Future<Map<String, dynamic>> _request(_Scope scope,
+    [Map<String, dynamic>? update]) async {
+  if (!scope.merchant) {
+    final http = OpsHealthHttp(scope.origin, scope.identity);
+    try {
+      return await http.request(update == null ? 'GET' : 'PUT',
+          'devices/${scope.device}/store-features', update);
+    } finally {
+      http.close();
+    }
+  }
+  if (update != null) throw StateError('Device store features are read-only');
+  final signer = PlatformFFI.instance.helpSigner!;
+  final target =
+      (origin: scope.origin, device: scope.device, binding: scope.identity);
+  final identity =
+      await signedQuickCall(target, 'identity', 0, {}, signer.signQuickCheck);
+  final version = identity['key_version'];
+  if (version is! int || version < 1) {
+    throw const FormatException('Invalid device identity');
+  }
+  return signedQuickCall(
+      target, 'features', version, {}, signer.signQuickCheck);
+}
+
+Future<StoreFeatureSnapshot?> _fetch(_Scope scope) async {
+  final key = _cacheKey(scope);
+  return resolveStoreFeatures(
+    fetch: () => _request(scope),
+    statusOf: (e) => e is HealthFailure
+        ? e.status
+        : e is CheckFailure
+            ? e.status
+            : 0,
+    load: () => bind.getLocalFlutterOption(k: key),
+    save: (v) => bind.setLocalFlutterOption(k: key, v: v),
+  );
+}
+
+final _pending = <_Scope, Future<StoreFeatureSnapshot?>>{};
+Future<StoreFeatureSnapshot?> readStoreFeatures(String? peer) async {
+  try {
+    final scope = await _scope(peer);
+    if (scope == null) return null;
+    final result = await _pending.putIfAbsent(
+        scope,
+        () => _fetch(scope).whenComplete(() {
+              _pending.remove(scope);
+            }));
+    return scope == await _scope(peer) ? result : null;
+  } catch (_) {
+    return null;
+  }
+}
+
+class StoreFeaturesView extends StatefulWidget {
+  final String? peer;
+  final Widget Function(StoreFeatureSnapshot?) builder;
+  const StoreFeaturesView({super.key, this.peer, required this.builder});
+  @override
+  State<StoreFeaturesView> createState() => _StoreFeaturesViewState();
+}
+
+class _StoreFeaturesViewState extends State<StoreFeaturesView> {
+  StoreFeatureSnapshot? value;
+  Timer? timer;
+  int generation = 0;
+  String? operator;
+  @override
+  void initState() {
+    super.initState();
+    refresh();
+    timer = Timer.periodic(const Duration(seconds: 30), (_) => refresh());
+  }
+
+  @override
+  void didUpdateWidget(StoreFeaturesView old) {
+    super.didUpdateWidget(old);
+    if (old.peer != widget.peer) {
+      value = null;
+      refresh();
+    }
+  }
+
+  Future<void> refresh() async {
+    final current = ++generation;
+    final id = widget.peer == null ? null : operatorContext();
+    if (operator != id && mounted) {
+      setState(() {
+        value = null;
+        operator = id;
+      });
+    }
+    final next = await readStoreFeatures(widget.peer);
+    if (mounted && current == generation) setState(() => value = next);
+  }
+
+  @override
+  void dispose() {
+    timer?.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => widget.builder(
+      widget.peer == null || operator == operatorContext() ? value : null);
+}
+
+Widget storeGate(String name, String? peer, Widget child) => StoreFeaturesView(
+    peer: peer,
+    builder: (s) => s?.allows(name, true, DateTime.now()) == true
+        ? child
+        : const SizedBox.shrink());
+
+Future<Map<String, dynamic>> manageStoreFeatures(String peer,
+    [Map<String, dynamic>? body]) async {
+  final owner = await _scope(peer);
+  if (owner == null) throw const HealthFailure(401);
+  final result = await _request(owner, body);
+  if (owner != await _scope(peer)) throw const HealthFailure(401);
+  return result;
+}
