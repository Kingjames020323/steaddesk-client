new file mode 100644
index 0000000..92e945d
--- /dev/null
+++ b/flutter/test/steaddesk/store_feature_cache_test.dart
@@ -0,0 +1,30 @@
+import 'dart:async';
+import 'package:flutter_test/flutter_test.dart';
+import '../../lib/steaddesk/store_feature_policy.dart';
+
+void main() {
+  test(
+      'real resolver reuses read-only settings offline and evicts denied scope',
+      () async {
+    String cache = '';
+    Future<StoreFeatureSnapshot?> read(
+            Future<Map<String, dynamic>> Function() fetch) =>
+        resolveStoreFeatures(
+            fetch: fetch,
+            statusOf: (e) => e is StateError ? 403 : 0,
+            load: () => cache,
+            save: (v) async {
+              cache = v;
+            });
+    await read(() async => {
+          'store_id': 'fixture',
+          'flags': {for (final k in storeFeatureNames) k: true}
+        });
+    final offline = await read(() async => throw TimeoutException('fixture'));
+    expect(offline!.allows('quick_check', true, DateTime.now()), true);
+    expect(offline.allows('toolbar_actions', true, DateTime.now()), false);
+    expect(await read(() async => throw StateError('denied')), isNull);
+    expect(cache, isEmpty);
+    expect(await read(() async => throw TimeoutException('fixture')), isNull);
+  });
+}
diff --git a/flutter/test/steaddesk/store_feature_policy_test.dart b/flutter/test/steaddesk/store_feature_policy_test.dart
new file mode 100644
index 0000000..d681c4c
--- /dev/null
+++ b/flutter/test/steaddesk/store_feature_policy_test.dart
@@ -0,0 +1,40 @@
+import 'package:flutter_test/flutter_test.dart';
+import '../../lib/steaddesk/store_feature_policy.dart';
+
+void main() {
+  final t = DateTime.utc(2026, 11, 15);
+  StoreFeatureSnapshot snap(bool enabled, bool online) =>
+      StoreFeatureSnapshot.parse({
+        'store_id': 'fixture',
+        'flags': {for (final name in storeFeatureNames) name: enabled}
+      }, t, online: online);
+  test('both the build and the currently scoped store must enable the feature',
+      () {
+    for (final name in storeFeatureNames) {
+      for (final compiled in [false, true]) {
+        for (final enabled in [false, true]) {
+          expect(snap(enabled, true).allows(name, compiled, t),
+              enabled && compiled);
+        }
+      }
+    }
+  });
+  test('only explicitly read-only operations can reuse a recent offline result',
+      () {
+    for (final name in storeFeatureNames) {
+      final value = snap(true, false);
+      expect(value.allows(name, true, t.add(const Duration(hours: 23))),
+          offlineStoreFeatures.contains(name));
+      expect(value.allows(name, true, t.add(const Duration(hours: 24))), false);
+      expect(value.allows(name, true, t.subtract(const Duration(seconds: 1))),
+          false);
+    }
+  });
+  test('empty or incomplete store responses cannot authorize operations', () {
+    expect(
+        () => StoreFeatureSnapshot.parse(
+            {'store_id': 'fixture', 'flags': {}}, t,
+            online: true),
+        throwsFormatException);
+  });
+}
