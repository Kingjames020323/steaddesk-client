+    try {
+      final result = await manageStoreFeatures(widget.device);
+      StoreFeatureSnapshot.parse(result, DateTime.now(), online: true);
+      if (mounted && guard == generation && auth == operatorContext()) {
+        setState(() {
+          snapshot = result;
+          owner = auth;
+        });
+      }
+    } catch (_) {
+      if (mounted && guard == generation) {
+        setState(() {
+          snapshot = null;
+          error = '无法读取门店功能，请检查登录状态和门店权限。';
+        });
+      }
+    } finally {
+      if (mounted && guard == generation) setState(() => busy = false);
+    }
+  }
+
+  Future<void> edit(String name, bool enabled) async {
+    final row = snapshot;
+    if (busy ||
+        row == null ||
+        owner != operatorContext() ||
+        row['can_edit'] != true) return;
+    final device = widget.device, guard = generation;
+    String reason = '';
+    final why = await showDialog<String>(
+        context: context,
+        builder: (ctx) => StatefulBuilder(
+            builder: (ctx, change) => AlertDialog(
+                  title: Text('${enabled ? '启用' : '停用'}${_labels[name]}'),
+                  content: TextField(
+                      autofocus: true,
+                      maxLength: 160,
+                      decoration: const InputDecoration(labelText: '修改原因'),
+                      onChanged: (v) => change(() => reason = v.trim())),
+                  actions: [
+                    TextButton(
+                        onPressed: () => Navigator.pop(ctx),
+                        child: const Text('取消')),
+                    TextButton(
+                        onPressed: reason.isEmpty
+                            ? null
+                            : () => Navigator.pop(ctx, reason),
+                        child: const Text('确认'))
+                  ],
+                )));
+    if (why == null ||
+        !mounted ||
+        guard != generation ||
+        busy ||
+        owner != operatorContext()) return;
+    setState(() {
+      busy = true;
+      error = null;
+    });
+    try {
+      await manageStoreFeatures(device, {
+        'store_id': row['store_id'],
+        'flags': {name: enabled},
+        'reason': why
+      });
+      if (mounted && guard == generation) await refresh();
+    } catch (_) {
+      if (mounted && guard == generation) {
+        await refresh();
+        if (mounted && widget.device == device) {
+          setState(() => error = '修改未确认，请核对回读结果。');
+        }
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final row = owner == operatorContext() ? snapshot : null;
+    return ListView(padding: const EdgeInsets.all(16), children: [
+      Row(children: [
+        const Expanded(child: Text('门店功能')),
+        IconButton(
+            tooltip: '刷新',
+            onPressed: busy ? null : refresh,
+            icon: const Icon(Icons.refresh))
+      ]),
+      if (busy) const LinearProgressIndicator(),
+      if (error != null) Text(error!),
+      if (row != null) ...[
+        Text('门店 ${row['store_id']}'),
+        for (final name in storeFeatureNames)
+          SwitchListTile(
+              title: Text(_labels[name]!),
+              value: row['flags'][name] == true,
+              onChanged: !busy && row['can_edit'] == true
+                  ? (v) => edit(name, v)
+                  : null),
+        const Divider(),
+        const Text('最近 10 条修改'),
+        for (final item
+            in (row['history'] as List? ?? const []).whereType<Map>().take(10))
+          ListTile(
+              title: Text(
+                  '${_labels[item['feature']] ?? item['feature']} · ${item['enabled'] == true ? '开' : '关'}'),
+              subtitle:
+                  Text('${item['at']} · ${item['actor']}\n${item['reason']}'))
+      ]
+    ]);
+  }
+}
