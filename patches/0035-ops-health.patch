diff --git a/flutter/test/steaddesk/ops_health_test.dart b/flutter/test/steaddesk/ops_health_test.dart
new file mode 100644
index 0000000..86f722d
--- /dev/null
+++ b/flutter/test/steaddesk/ops_health_test.dart
@@ -0,0 +1,198 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/ops_health.dart';
+import 'package:flutter_hbb/steaddesk/ops_health_widgets.dart';
+
+class FakeApi implements HealthApi {
+  String status = 'normal';
+  String reason = 'merchant_stopped';
+  String jobState = 'completed';
+  int checks = 0;
+  int claims = 0;
+  String? closed;
+  int? failure;
+  final events = StreamController<String>.broadcast();
+  DateTime at = DateTime.utc(2026, 11, 14);
+  @override
+  Future<Map<String, dynamic>> request(String method, String path,
+      [Map<String, dynamic>? body]) async {
+    if (failure != null) throw HealthFailure(failure!);
+    if (path == 'health') {
+      return {
+        'devices': [
+          {
+            'device_id': '123456789',
+            'status': status,
+            'reasons': status == 'normal' ? <String>[] : [reason],
+            'updated_at': at.toIso8601String()
+          }
+        ]
+      };
+    }
+    if (path == 'alerts') {
+      return {
+        'alerts': closed != null
+            ? []
+            : [
+                {
+                  'id': 'a_demo',
+                  'device_id': '123456789',
+                  'rule': reason,
+                  'state': claims > 0 ? 'claimed' : 'open'
+                }
+              ]
+      };
+    }
+    if (path.endsWith('/claim')) claims++;
+    if (path.endsWith('/close')) closed = body!['reason'];
+    if (path.endsWith('/checks')) {
+      checks++;
+      return {'id': 'c_demo', 'state': 'queued', 'results': []};
+    }
+    if (path.endsWith('/checks/c_demo')) {
+      return {
+        'id': 'c_demo',
+        'state': jobState,
+        'results': [
+          {
+            'name': '测试打印机',
+            'ip': '192.168.50.1',
+            'outcome': jobState == 'timeout' ? 'timeout' : 'reachable',
+            'latency_ms': jobState == 'timeout' ? null : 12
+          }
+        ]
+      };
+    }
+    return {};
+  }
+
+  @override
+  Stream<String> changes() => events.stream;
+  @override
+  void close() {}
+}
+
+void main() {
+  test('health status, reasons and three minute freshness boundary', () async {
+    final api = FakeApi();
+    final store = HealthStore(api, isCurrent: () => true, now: () => api.at);
+    for (final status in ['normal', 'attention', 'alert']) {
+      api.status = status;
+      await store.refresh();
+      final row = store.devices['123456789']!;
+      expect(row.level(api.at.add(const Duration(minutes: 3))), status);
+      expect(row.level(api.at.add(const Duration(seconds: 181))), 'unknown');
+    }
+    store.dispose();
+  });
+
+  test('expired identity discards responses and cannot write', () async {
+    final api = FakeApi();
+    bool current = true;
+    final store = HealthStore(api, isCurrent: () => current);
+    final pending = store.refresh();
+    current = false;
+    await pending;
+    expect(store.devices, isEmpty);
+    await expectLater(
+        store.updateAlert('a_demo', null), throwsA(isA<HealthFailure>()));
+    expect(api.claims, 0);
+    store.dispose();
+  });
+
+  testWidgets(
+      'a current SSE update refreshes active surfaces and revoked sessions clear immediately',
+      (tester) async {
+    final api = FakeApi();
+    final live = HealthStore(api, isCurrent: () => true, now: () => api.at);
+    live.start();
+    await tester.pump();
+    expect(live.devices['123456789']!.status, 'normal');
+    api.status = 'alert';
+    api.reason = 'capture_permission_lost';
+    api.events.add('health.changed');
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 220));
+    expect(live.devices['123456789']!.reasons, ['capture_permission_lost']);
+    api.status = 'attention';
+    await tester.pump(const Duration(minutes: 1));
+    expect(live.devices['123456789']!.status, 'attention');
+    api.failure = 401;
+    await live.refresh();
+    expect(live.alerts, isEmpty);
+    expect(live.devices, isEmpty);
+    expect(live.active, isFalse);
+    live.dispose();
+  });
+
+  testWidgets('a stationary sidebar turns grey just after the third minute',
+      (tester) async {
+    final api = FakeApi();
+    var instant = api.at;
+    final store = HealthStore(api, now: () => instant, isCurrent: () => true);
+    await store.refresh();
+    await tester.pumpWidget(MaterialApp(
+        home: Scaffold(body: HealthDeviceView(store: store, id: '123456789'))));
+    expect(find.text('设备健康 · 正常'), findsOneWidget);
+    instant = instant.add(const Duration(minutes: 3, milliseconds: 1));
+    await tester.pump(const Duration(minutes: 3, milliseconds: 1));
+    final unknown = tester.widget<Text>(find.text('设备健康 · 未知'));
+    expect(unknown.style?.color, const Color(0xff687782));
+    expect(find.text('ping 全部'), findsNothing);
+    store.dispose();
+  });
+
+  testWidgets('panel shows reasons, check rows, timeout and rate limit',
+      (tester) async {
+    final api = FakeApi()..status = 'attention';
+    final store = HealthStore(api,
+        now: () => api.at, isCurrent: () => true, checkInterval: Duration.zero);
+    await store.refresh();
+    await tester.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: HealthDeviceView(
+                store: store, id: '123456789', checks: true))));
+    expect(find.textContaining('商户手动停止'), findsOneWidget);
+    expect(find.textContaining('2026'), findsOneWidget);
+    for (final state in ['completed', 'timeout']) {
+      api.jobState = state;
+      await tester.tap(find.text('ping 全部'));
+      await tester.pumpAndSettle();
+      expect(find.textContaining('192.168.50.1'), findsOneWidget);
+      expect(find.textContaining(state == 'timeout' ? '超时' : '12 ms'),
+          findsWidgets);
+    }
+    api.failure = 429;
+    await tester.tap(find.text('ping 全部'));
+    await tester.pumpAndSettle();
+    expect(find.textContaining('每分钟'), findsOneWidget);
+    store.dispose();
+  });
+
+  testWidgets('alert claim and manual close require a nonblank reason',
+      (tester) async {
+    final api = FakeApi();
+    final store = HealthStore(api, isCurrent: () => true);
+    await store.refresh();
+    await tester.pumpWidget(
+        MaterialApp(home: Scaffold(body: HealthAlertList(store: store))));
+    await tester.tap(find.text('认领'));
+    await tester.pumpAndSettle();
+    expect(api.claims, 1);
+    await tester.tap(find.text('关闭预警'));
+    await tester.pumpAndSettle();
+    expect(
+        tester
+            .widget<TextButton>(find.widgetWithText(TextButton, '确认关闭'))
+            .onPressed,
+        isNull);
+    await tester.enterText(find.byType(TextField), '已经核对');
+    await tester.pump();
+    await tester.tap(find.text('确认关闭'));
+    await tester.pumpAndSettle();
+    expect(api.closed, '已经核对');
+    expect(find.text('暂无预警'), findsOneWidget);
+    store.dispose();
+  });
+}
diff --git a/flutter/tool/ops_health_drill.dart b/flutter/tool/ops_health_drill.dart
