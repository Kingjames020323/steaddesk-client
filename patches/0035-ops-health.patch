diff --git a/flutter/lib/steaddesk/ops_health.dart b/flutter/lib/steaddesk/ops_health.dart
new file mode 100644
index 0000000..98e9a8d
--- /dev/null
+++ b/flutter/lib/steaddesk/ops_health.dart
@@ -0,0 +1,323 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:uuid/uuid.dart';
+
+import 'ops_groups.dart' show opsEndpoint;
+
+class HealthFailure implements Exception {
+  final int status;
+  const HealthFailure(this.status);
+  @override
+  String toString() => switch (status) {
+        401 => '请重新登录后查看。',
+        403 || 404 => '已无权查看此记录，或记录已移除。',
+        409 => '预警状态已变化，请刷新后再试。',
+        422 => '请先核对店内设备清单或填写有效原因。',
+        429 => '操作受限。每台设备每分钟最多检查一次。',
+        408 => '等待检查结果超时。',
+        _ => '暂时无法读取设备健康，请稍后重试。',
+      };
+}
+
+abstract interface class HealthApi {
+  Future<Map<String, dynamic>> request(String method, String route,
+      [Map<String, dynamic>? body]);
+  Stream<String> changes();
+  void close();
+}
+
+class OpsHealthHttp implements HealthApi {
+  final Uri _base;
+  final String _token;
+  final HttpClient _http = HttpClient()
+    ..connectionTimeout = const Duration(seconds: 8)
+    ..findProxy = (_) => 'DIRECT';
+  OpsHealthHttp(Uri origin, this._token) : _base = opsEndpoint(origin);
+
+  Future<HttpClientResponse> _open(String method, String route,
+      {Map<String, dynamic>? body, bool events = false}) async {
+    if (!RegExp(r'^[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)*$').hasMatch(route)) {
+      throw const HealthFailure(400);
+    }
+    final req = await _http
+        .openUrl(method, _base.resolve(route))
+        .timeout(const Duration(seconds: 10));
+    req.followRedirects = false;
+    req.headers.set(HttpHeaders.authorizationHeader, 'Bearer $_token');
+    req.headers.set(HttpHeaders.acceptHeader,
+        events ? 'text/event-stream' : 'application/json');
+    if (body != null) {
+      req.headers.set('Idempotency-Key', const Uuid().v4());
+      req.headers.contentType = ContentType.json;
+      final encoded = utf8.encode(jsonEncode(body));
+      req.contentLength = encoded.length;
+      req.add(encoded);
+    }
+    final res = await req.close().timeout(const Duration(seconds: 15));
+    if (res.statusCode < 200 || res.statusCode >= 300) {
+      await res.listen((_) {}).cancel();
+      throw HealthFailure(res.statusCode);
+    }
+    return res;
+  }
+
+  @override
+  Future<Map<String, dynamic>> request(String method, String route,
+      [Map<String, dynamic>? body]) async {
+    final res = await _open(method, route, body: body);
+    final bytes = <int>[];
+    await for (final chunk in res.timeout(const Duration(seconds: 12))) {
+      if (bytes.length + chunk.length > 4 * 1024 * 1024) {
+        throw const HealthFailure(0);
+      }
+      bytes.addAll(chunk);
+    }
+    return jsonDecode(utf8.decode(bytes)) as Map<String, dynamic>;
+  }
+
+  @override
+  Stream<String> changes() async* {
+    final response = await _open('GET', 'events', events: true);
+    if (response.headers.contentType?.mimeType != 'text/event-stream') {
+      await response.listen((_) {}).cancel();
+      throw const HealthFailure(0);
+    }
+    yield 'connected';
+    await for (final line in response
+        .timeout(const Duration(seconds: 45))
+        .transform(utf8.decoder)
+        .transform(const LineSplitter())) {
+      if (line.startsWith('event:')) yield line.substring(6).trim();
+    }
+  }
+
+  @override
+  void close() => _http.close(force: true);
+}
+
+class DeviceHealth {
+  final String id, status;
+  final List<String> reasons;
+  final DateTime? updated;
+  DeviceHealth.from(Map<String, dynamic> row)
+      : id = row['device_id'] as String,
+        status = row['status'] as String,
+        reasons = List<String>.from(row['reasons'] as List),
+        updated =
+            DateTime.tryParse(row['updated_at'] as String? ?? '')?.toUtc();
+
+  String level(DateTime now) {
+    final age = updated == null ? null : now.difference(updated!);
+    return age == null ||
+            age.isNegative ||
+            age > const Duration(minutes: 3) ||
+            !{'normal', 'attention', 'alert'}.contains(status)
+        ? 'unknown'
+        : status;
+  }
+}
+
+class HealthStore extends ChangeNotifier {
+  final HealthApi api;
+  final bool Function() isCurrent;
+  final DateTime Function() now;
+  final Duration checkInterval;
+  HealthStore(this.api,
+      {required this.isCurrent,
+      DateTime Function()? now,
+      this.checkInterval = const Duration(seconds: 2)})
+      : now = now ?? DateTime.now;
+  bool _closed = false, _expired = false;
+  bool get active => !_closed && !_expired && isCurrent();
+  bool available = false;
+  String? error;
+  Map<String, DeviceHealth> devices = {};
+  List<Map<String, dynamic>> alerts = [];
+  Timer? _poll, _retry, _coalesce, _stale;
+  StreamSubscription<String>? _events;
+  Future<void>? _pending;
+  int scopeRevision = 0;
+  void start() {
+    refresh();
+    _poll = Timer.periodic(const Duration(minutes: 1), (_) => refresh());
+    _listen();
+  }
+
+  void _listen() {
+    if (!active) return;
+    _events = api.changes().listen((kind) {
+      if (!active ||
+          !{
+            'connected',
+            'health.changed',
+            'alert.changed',
+            'check.changed',
+            'group.changed'
+          }.contains(kind)) return;
+      if (kind == 'group.changed' || kind == 'connected') {
+        // Existing result rows may describe a store this account can no longer see.
+        scopeRevision++;
+        notifyListeners();
+      }
+      _coalesce ??= Timer(const Duration(milliseconds: 180), () {
+        _coalesce = null;
+        refreshAfterPending();
+      });
+    }, onError: (Object e) {
+      if (e is HealthFailure && e.status == 401) _expire();
+    }, onDone: () {
+      if (active) _retry = Timer(const Duration(seconds: 10), _listen);
+    });
+  }
+
+  void _ensure() {
+    if (!active) throw const HealthFailure(401);
+  }
+
+  void _expire() {
+    if (!active) return;
+    _expired = true;
+    available = false;
+    devices = {};
+    alerts = [];
+    error = const HealthFailure(401).toString();
+    _poll?.cancel();
+    _retry?.cancel();
+    _stale?.cancel();
+    _coalesce?.cancel();
+    _events?.cancel();
+    api.close();
+    notifyListeners();
+  }
+
+  Future<Map<String, dynamic>> _fetch(String method, String path,
+      [Map<String, dynamic>? body]) async {
+    _ensure();
+    try {
+      final result = await api.request(method, path, body);
+      _ensure();
+      return result;
+    } on HealthFailure catch (e) {
+      if (e.status == 401) _expire();
+      rethrow;
+    } catch (_) {
+      throw const HealthFailure(0);
+    }
+  }
+
+  Future<void> refresh() =>
+      _pending ??= _refresh().whenComplete(() => _pending = null);
+  Future<void> refreshAfterPending() async {
+    if (_pending != null) await _pending;
+    if (active) await refresh();
+  }
+
+  Future<void> _refresh() async {
+    if (!active) return;
+    try {
+      final both =
+          await Future.wait([_fetch('GET', 'health'), _fetch('GET', 'alerts')]);
+      final rows = (both[0]['devices'] as List)
+          .cast<Map<String, dynamic>>()
+          .map(DeviceHealth.from);
+      final snapshot = {for (final row in rows) row.id: row};
+      final notices = (both[1]['alerts'] as List).cast<Map<String, dynamic>>();
+      if (!active) return;
+      devices = snapshot;
+      alerts = notices;
+      available = true;
+      error = null;
+      _scheduleStaleness();
+    } catch (e) {
+      if (!active) return;
+      error = (e is HealthFailure ? e : const HealthFailure(0)).toString();
+      available = false;
+      if (e is HealthFailure && (e.status == 403 || e.status == 404)) {
+        devices = {};
+        alerts = [];
+      }
+    }
+    if (active) notifyListeners();
+  }
+
+  void _scheduleStaleness() {
+    _stale?.cancel();
+    final instant = now();
+    final deadlines = devices.values
+        .map((row) =>
+            row.updated?.add(const Duration(minutes: 3, milliseconds: 1)))
+        .whereType<DateTime>()
+        .where((t) => t.isAfter(instant))
+        .toList()
+      ..sort();
+    if (deadlines.isNotEmpty) {
+      _stale = Timer(deadlines.first.difference(instant), () {
+        if (!active) return;
+        notifyListeners();
+        _scheduleStaleness();
+      });
+    }
+  }
+
+  Future<void> updateAlert(String id, String? reason) async {
+    _ensure();
+    if (reason != null &&
+        (reason.trim().isEmpty || reason.runes.length > 256)) {
+      throw const HealthFailure(422);
+    }
+    try {
+      await _fetch('POST', 'alerts/$id/${reason == null ? 'claim' : 'close'}',
+          reason == null ? {} : {'reason': reason.trim()});
+    } finally {
+      if (active) {
+        // An in-flight read can have a pre-mutation snapshot.
+        await refreshAfterPending();
+      }
+    }
+  }
+
+  Future<Map<String, dynamic>> check(String device,
+      {required bool Function() visible}) async {
+    if (!visible()) throw const HealthFailure(401);
+    final queued = await _fetch('POST', 'devices/$device/checks', {});
+    final id = queued['id'] as String;
+    final elapsed = Stopwatch()..start();
+    while (elapsed.elapsed < const Duration(minutes: 3, seconds: 15)) {
+      if (!visible()) throw const HealthFailure(401);
+      final result = await _fetch('GET', 'devices/$device/checks/$id');
+      if (!visible()) throw const HealthFailure(401);
+      if ({'timeout', 'completed', 'cancelled'}.contains(result['state'])) {
+        return result;
+      }
+      if (!{'queued', 'running'}.contains(result['state'])) {
+        throw const HealthFailure(0);
+      }
+      await Future<void>.delayed(checkInterval);
+    }
+    throw const HealthFailure(408);
+  }
+
+  void retire({bool notify = true}) {
+    if (_closed) return;
+    _closed = true;
+    devices = {};
+    alerts = [];
+    available = false;
+    if (notify) notifyListeners();
+  }
+
+  @override
+  void dispose() {
+    _closed = true;
+    _poll?.cancel();
+    _retry?.cancel();
+    _stale?.cancel();
+    _coalesce?.cancel();
+    _events?.cancel();
+    api.close();
+    super.dispose();
+  }
+}
diff --git a/flutter/lib/steaddesk/ops_health_host.dart b/flutter/lib/steaddesk/ops_health_host.dart
new file mode 100644
index 0000000..9039ca8
--- /dev/null
+++ b/flutter/lib/steaddesk/ops_health_host.dart
@@ -0,0 +1,173 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import '../common.dart' show gFFI;
+import '../models/platform_model.dart' show bind;
+import 'ops_health.dart';
+import 'ops_health_widgets.dart';
+
+typedef _Login = ({String name, String token});
+_Login? _login() {
+  try {
+    final token = bind.mainGetLocalOption(key: 'access_token');
+    if (token.isEmpty) return null;
+    final data = jsonDecode(bind.mainGetLocalOption(key: 'user_info'));
+    final name = data['name'];
+    if (name is String && name.isNotEmpty) return (name: name, token: token);
+  } catch (_) {}
+  return null;
+}
+
+// Each Flutter engine (including a detached session window) owns its HTTP credentials.
+// One feed is shared by all mounted health surfaces in that engine.
+class _EngineHealth extends ChangeNotifier {
+  int users = 0, generation = 0;
+  Timer? timer;
+  _Login? login;
+  Uri? origin;
+  HealthStore? store;
+  bool resolving = false;
+  void acquire() {
+    if (users++ > 0) return;
+    timer = Timer.periodic(const Duration(seconds: 1), (_) => sync());
+    scheduleMicrotask(sync);
+  }
+
+  void release() {
+    if (--users != 0) return;
+    timer?.cancel();
+    timer = null;
+    login = null;
+    origin = null;
+    generation++;
+    retire(notify: false);
+  }
+
+  void retire({bool notify = true}) {
+    final old = store;
+    store = null;
+    if (old != null) {
+      old.retire(notify: notify);
+      // Modal routes may still have a listener until the next frame.
+      scheduleMicrotask(old.dispose);
+    }
+    if (notify) notifyListeners();
+  }
+
+  Future<void> sync() async {
+    final current = _login();
+    if (login != current) {
+      login = current;
+      origin = null;
+      generation++;
+      retire();
+    }
+    if (current == null || resolving) return;
+    final guard = generation;
+    resolving = true;
+    try {
+      final target = Uri.parse(await bind.mainGetApiServer());
+      if (users == 0 || guard != generation || current != _login()) return;
+      if (origin == target && store != null) return;
+      origin = target;
+      retire();
+      final next = HealthStore(OpsHealthHttp(target, current.token),
+          isCurrent: () =>
+              users > 0 &&
+              generation == guard &&
+              origin == target &&
+              _login() == current);
+      store = next;
+      notifyListeners();
+      next.start();
+    } catch (_) {
+      if (guard == generation && store != null) {
+        origin = null;
+        retire();
+      }
+    } finally {
+      resolving = false;
+    }
+  }
+}
+
+final _engine = _EngineHealth();
+
+enum HealthSurface { header, card, sidebar, overview }
+
+class OpsHealthHost extends StatefulWidget {
+  final HealthSurface surface;
+  final String? device;
+  const OpsHealthHost(this.surface, {super.key, this.device});
+  @override
+  State<OpsHealthHost> createState() => _OpsHealthHostState();
+}
+
+class _OpsHealthHostState extends State<OpsHealthHost> {
+  late final StreamSubscription<String> loginSubscription;
+  @override
+  void initState() {
+    super.initState();
+    _engine.acquire();
+    loginSubscription = gFFI.userModel.userName.listen((_) => _engine.sync());
+  }
+
+  @override
+  void dispose() {
+    loginSubscription.cancel();
+    _engine.release();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => AnimatedBuilder(
+      animation: _engine,
+      builder: (_, __) {
+        final store = _engine.store;
+        if (store == null || !store.active) {
+          return widget.surface == HealthSurface.header
+              ? const SizedBox.shrink()
+              : const Text('设备健康 · 未知', style: TextStyle(color: Colors.grey));
+        }
+        return AnimatedBuilder(
+            animation: store,
+            builder: (_, __) {
+              switch (widget.surface) {
+                case HealthSurface.header:
+                  return TextButton(
+                      onPressed: () => showDialog<void>(
+                          context: context,
+                          builder: (ctx) => AlertDialog(
+                                  title: const Text('预警列表'),
+                                  content: SizedBox(
+                                      width: 520,
+                                      height: 360,
+                                      child: HealthAlertList(store: store)),
+                                  actions: [
+                                    TextButton(
+                                        onPressed: () => Navigator.pop(ctx),
+                                        child: const Text('返回'))
+                                  ])),
+                      child: Text(
+                          '告警 ${store.available ? store.alerts.length : '—'}'));
+                case HealthSurface.overview:
+                  return ListView(padding: const EdgeInsets.all(16), children: [
+                    if (store.error != null) Text(store.error!),
+                    if (store.available && store.devices.isEmpty)
+                      const Text('暂无可见设备'),
+                    for (final id in store.devices.keys)
+                      ListTile(
+                          title: Text(id),
+                          subtitle: HealthDeviceView(store: store, id: id)),
+                  ]);
+                default:
+                  return HealthDeviceView(
+                      key: ValueKey((store, widget.device)),
+                      store: store,
+                      id: widget.device!,
+                      checks: widget.surface == HealthSurface.card);
+              }
+            });
+      });
+}
