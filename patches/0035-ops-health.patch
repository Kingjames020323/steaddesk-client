+++ b/flutter/tool/ops_health_drill.dart
@@ -0,0 +1,54 @@
+// Run with OPS_HEALTH_DRILL pointing at an owner-only config from the local
+// exercise. Expected keys: origin (loopback only), token, normal, attention,
+// alert, stale and timeoutDevice. A test worker completes normal's queue row
+// and expires timeoutDevice's row via the same server transitions as ops-watch.
+import 'dart:convert';
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/ops_health.dart';
+
+void main() {
+  test('authenticated OPS health, claims, checks and limits over loopback',
+      () async {
+    final config = jsonDecode(
+        await File(Platform.environment['OPS_HEALTH_DRILL']!).readAsString());
+    final uri = Uri.parse(config['origin']);
+    expect(InternetAddress.tryParse(uri.host)?.isLoopback, isTrue);
+    expect(uri.scheme, 'http');
+    final api = OpsHealthHttp(uri, config['token']);
+    final store = HealthStore(api,
+        isCurrent: () => true,
+        checkInterval: const Duration(milliseconds: 100));
+    try {
+      await store.refresh();
+      expect(store.available, isTrue);
+      for (final key in ['normal', 'attention', 'alert', 'stale']) {
+        expect(store.devices[config[key]]?.level(store.now()),
+            key == 'stale' ? 'unknown' : key);
+      }
+      final notice = store.alerts
+          .singleWhere((r) => r['device_id'] == config['attention']);
+      expect(notice['rule'], 'remote_paused');
+      await store.updateAlert(notice['id'], null);
+      expect(store.alerts.singleWhere((r) => r['id'] == notice['id'])['state'],
+          'claimed');
+      await store.updateAlert(notice['id'], '演练完成');
+      expect(store.alerts.where((r) => r['id'] == notice['id']), isEmpty);
+      final done = await store.check(config['normal'], visible: () => true);
+      expect(done['state'], 'completed');
+      final row = done['results'].single;
+      expect(row['name'], 'Fixture printer');
+      expect(row['outcome'], 'reachable');
+      expect(row['latency_ms'], 12);
+      expect(row['ip'], '192.168.50.12');
+      await expectLater(store.check(config['normal'], visible: () => true),
+          throwsA(isA<HealthFailure>().having((e) => e.status, 'status', 429)));
+      final timeout =
+          await store.check(config['timeoutDevice'], visible: () => true);
+      expect(timeout['state'], 'timeout');
+      expect(timeout['results'].single['outcome'], 'timeout');
+    } finally {
+      store.dispose();
+    }
+  }, timeout: const Timeout(Duration(minutes: 2)));
+}
