index 0000000..2a05077
--- /dev/null
+++ b/flutter/lib/steaddesk/ops_health_widgets.dart
@@ -0,0 +1,203 @@
+import 'package:flutter/material.dart';
+import 'ops_health.dart';
+
+String reasonText(String rule) =>
+    const {
+      'merchant_stopped': '商户手动停止',
+      'remote_paused': '商户已暂停远程',
+      'capture_permission_lost': '授权掉失',
+      'device_offline': '设备失联',
+      'steaddesk_offline': 'SteadDesk 掉线',
+    }[rule] ??
+    '设备状态变化';
+
+class HealthDeviceView extends StatefulWidget {
+  final HealthStore store;
+  final String id;
+  final bool checks;
+  const HealthDeviceView(
+      {super.key, required this.store, required this.id, this.checks = false});
+  @override
+  State<HealthDeviceView> createState() => _HealthDeviceViewState();
+}
+
+class _HealthDeviceViewState extends State<HealthDeviceView> {
+  Map<String, dynamic>? result;
+  String? error;
+  bool busy = false;
+  int epoch = 0;
+  int? resultScope;
+  @override
+  void didUpdateWidget(HealthDeviceView old) {
+    super.didUpdateWidget(old);
+    if (old.store != widget.store || old.id != widget.id) {
+      epoch++;
+      result = null;
+      error = null;
+      busy = false;
+    }
+  }
+
+  Future<void> run() async {
+    if (busy) return;
+    final run = ++epoch, store = widget.store, id = widget.id;
+    final scope = store.scopeRevision;
+    bool visible() =>
+        mounted &&
+        epoch == run &&
+        scope == store.scopeRevision &&
+        store.active &&
+        store.devices.containsKey(id);
+    setState(() {
+      busy = true;
+      error = null;
+      result = null;
+      resultScope = scope;
+    });
+    try {
+      final done = await store.check(id, visible: visible);
+      if (visible()) setState(() => result = done);
+    } catch (e) {
+      if (visible()) {
+        setState(() => error =
+            (e is HealthFailure ? e : const HealthFailure(0)).toString());
+      }
+    } finally {
+      if (mounted && epoch == run) setState(() => busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => AnimatedBuilder(
+      animation: widget.store,
+      builder: (_, __) {
+        final store = widget.store;
+        final row = store.active ? store.devices[widget.id] : null;
+        final level = row?.level(store.now()) ?? 'unknown';
+        final label = const {
+          'normal': '正常',
+          'attention': '关注',
+          'alert': '告警',
+          'unknown': '未知'
+        }[level]!;
+        final color = const {
+          'normal': Color(0xff176747),
+          'attention': Color(0xff946000),
+          'alert': Color(0xffb91c1c),
+          'unknown': Color(0xff687782)
+        }[level];
+        final updated =
+            row?.updated?.toLocal().toString().split('.').first ?? '—';
+        final reasons =
+            level == 'unknown' ? '' : row!.reasons.map(reasonText).join('、');
+        return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+          Text('设备健康 · $label${reasons.isEmpty ? '' : ' · $reasons'}',
+              style: TextStyle(color: color, fontWeight: FontWeight.w600)),
+          Text('最后更新 $updated', style: Theme.of(context).textTheme.bodySmall),
+          if (widget.checks)
+            TextButton(
+                onPressed: !busy && row != null && store.available ? run : null,
+                child: Text(busy ? '检查中…' : 'ping 全部')),
+          if (row != null &&
+              widget.checks &&
+              resultScope == store.scopeRevision) ...[
+            if (error != null) Text(error!),
+            if (result?['state'] == 'cancelled') const Text('检查已取消。'),
+            if (result?['state'] == 'timeout') const Text('检查超时。'),
+            for (final item in (result?['results'] as List? ?? [])
+                .cast<Map<String, dynamic>>())
+              Text('${item['name']} · ${item['ip']} · ${const {
+                    'reachable': '通',
+                    'unreachable': '不通',
+                    'timeout': '超时'
+                  }[item['outcome']] ?? '未知'} · ${item['latency_ms'] == null ? '—' : '${item['latency_ms']} ms'}'),
+          ]
+        ]);
+      });
+}
+
+class HealthAlertList extends StatefulWidget {
+  final HealthStore store;
+  const HealthAlertList({super.key, required this.store});
+  @override
+  State<HealthAlertList> createState() => _HealthAlertListState();
+}
+
+class _HealthAlertListState extends State<HealthAlertList> {
+  String? busy, error;
+  Future<void> update(String id, bool close) async {
+    if (busy != null) return;
+    final store = widget.store;
+    setState(() {
+      busy = id;
+      error = null;
+    });
+    try {
+      String? reason;
+      if (close) {
+        var draft = '';
+        reason = await showDialog<String>(
+            context: context,
+            builder: (ctx) => StatefulBuilder(
+                builder: (context, redraw) => AlertDialog(
+                        title: const Text('关闭预警'),
+                        content: TextField(
+                            autofocus: true,
+                            maxLength: 256,
+                            decoration:
+                                const InputDecoration(labelText: '关闭原因'),
+                            onChanged: (s) => redraw(() => draft = s.trim())),
+                        actions: [
+                          TextButton(
+                              onPressed: () => Navigator.pop(ctx),
+                              child: const Text('取消')),
+                          TextButton(
+                              onPressed: draft.isEmpty
+                                  ? null
+                                  : () => Navigator.pop(ctx, draft),
+                              child: const Text('确认关闭'))
+                        ])));
+        if (reason == null) return;
+      }
+      if (!mounted || store != widget.store || !store.active) return;
+      await store.updateAlert(id, reason);
+    } catch (e) {
+      if (mounted && store == widget.store) {
+        setState(() => error =
+            (e is HealthFailure ? e : const HealthFailure(0)).toString());
+      }
+    } finally {
+      if (mounted && store == widget.store) setState(() => busy = null);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => AnimatedBuilder(
+      animation: widget.store,
+      builder: (_, __) {
+        final store = widget.store;
+        if (!store.active) return const Text('请重新登录后查看。');
+        return ListView(children: [
+          if (error ?? store.error case final String message) Text(message),
+          if (store.alerts.isEmpty) Text(store.available ? '暂无预警' : '正在读取预警…'),
+          for (final row in store.alerts)
+            ListTile(
+                title: Text(reasonText(row['rule'])),
+                subtitle: Text(
+                    '${row['device_id']}${row['claimed_by'] == null ? '' : ' · ${row['claimed_by']} 已认领'}'),
+                trailing: Wrap(children: [
+                  if (row['state'] == 'open')
+                    TextButton(
+                        onPressed: busy != null || !store.available
+                            ? null
+                            : () => update(row['id'], false),
+                        child: const Text('认领')),
+                  TextButton(
+                      onPressed: busy != null || !store.available
+                          ? null
+                          : () => update(row['id'], true),
+                      child: const Text('关闭预警'))
+                ]))
+        ]);
+      });
+}
