+// The predefined About dialog supplies its own English caption on Windows.
+#[cfg(windows)]
+fn show_merchant_about() {
+    use winapi::um::winuser::{MessageBoxW, MB_ICONINFORMATION, MB_OK};
+    let wide = |s: String| s.encode_utf16().chain(std::iter::once(0)).collect::<Vec<_>>();
