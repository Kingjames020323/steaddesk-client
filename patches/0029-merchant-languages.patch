+// The merchant panel offers the same three languages on Windows and Android.
+fn merchant_language(saved: &str, system: &str) -> &'static str {
+    let locale = if saved.is_empty() { system } else { saved };
+    let primary = locale.split(|c| c == '-' || c == '_').next().unwrap_or("");
+    if primary.eq_ignore_ascii_case("zh") {
+        "zh-cn"
+    } else if primary.eq_ignore_ascii_case("es") {
+        "es"
+    } else {
+        "en"
+    }
+}
+
+// The main window, CM and tray run in separate Windows processes. A single
+// HKCU value changes atomically without rewriting their cached LocalConfig.
+#[cfg(windows)]
+const MERCHANT_LANG_KEY: &str = r"Software\SteadDesk\Merchant";
+
+#[cfg(windows)]
+pub(crate) fn refresh_merchant_language() -> String {
+    use winreg::{enums::HKEY_CURRENT_USER, RegKey};
+
+    RegKey::predef(HKEY_CURRENT_USER)
+        .open_subkey(MERCHANT_LANG_KEY)
+        .and_then(|key| key.get_value::<String, _>("Language"))
+        .unwrap_or_else(|_| hbb_common::config::LocalConfig::get_option("lang"))
+}
+
+#[cfg(windows)]
+pub(crate) fn set_merchant_language(value: &str) -> bool {
+    use winreg::{enums::HKEY_CURRENT_USER, RegKey};
+
+    matches!(value, "" | "en" | "zh-cn" | "es")
+        && RegKey::predef(HKEY_CURRENT_USER)
+            .create_subkey(MERCHANT_LANG_KEY)
+            .and_then(|(key, _)| key.set_value("Language", &value))
+            .is_ok()
+}
