+++ b/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/MerchantLanguage.java
@@ -0,0 +1,45 @@
+package com.carriez.flutter_hbb;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.res.Configuration;
+import android.os.Build;
+
+import java.util.Locale;
+
+/** Boot receivers and services can run before Flutter or its Rust configuration is available. */
+public final class MerchantLanguage {
+    static final String OPTION = "language";
+
+    static SharedPreferences preferences(Context context) {
+        return context.getSharedPreferences("steaddesk_language", Context.MODE_PRIVATE);
+    }
+
+    static boolean save(Context context, String option) {
+        if (!BuildConfig.MERCHANT_EDITION || option == null) return false;
+        if (!option.isEmpty() && !option.equals("en") && !option.equals("zh-cn") && !option.equals("es"))
+            return false;
+        return preferences(context).edit().putString(OPTION, option).commit();
+    }
+
+    static String language(Context context) {
+        String option = preferences(context).getString(OPTION, "");
+        if (!option.isEmpty()) return option;
+        Configuration config = context.getResources().getConfiguration();
+        Locale system = Build.VERSION.SDK_INT >= 24 ? config.getLocales().get(0) : config.locale;
+        switch (system.getLanguage()) {
+            case "zh": return "zh-cn";
+            case "es": return "es";
+            default: return "en";
+        }
+    }
+
+    public static String text(Context context, int resource) {
+        if (!BuildConfig.MERCHANT_EDITION) return context.getString(resource);
+        Configuration config = new Configuration(context.getResources().getConfiguration());
+        config.setLocale(Locale.forLanguageTag(language(context)));
+        return context.createConfigurationContext(config).getString(resource);
+    }
+
+    private MerchantLanguage() {}
+}
