+    let text = wide(format!(
+        "{}\n{} {}",
+        crate::get_app_name(),
+        translate("Version".into()),
+        include_str!("../RELEASE_VERSION").trim()
+    ));
+    unsafe { MessageBoxW(std::ptr::null_mut(), text.as_ptr(), title.as_ptr(), MB_OK | MB_ICONINFORMATION) };
