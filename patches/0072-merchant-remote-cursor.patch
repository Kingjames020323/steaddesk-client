--- /dev/null
+++ b/flutter/android/app/src/main/java/com/carriez/flutter_hbb/RemoteCursorState.java
@@ -0,0 +1,33 @@
+package com.carriez.flutter_hbb;
+
+/** The capture and overlay both use the display's current orientation and physical pixels. */
+final class RemoteCursorState {
+    static final long IDLE_MS = 5000;
+    static final long FADE_MS = 240;
+    static final long CLICK_MS = 320;
+    int x, y;
+    long moved = -1, clicked = -1;
+
+    static int physicalCoordinate(int capturePixel, int captureExtent, int scale) {
+        // MainService builds its virtual display from oriented width/height, then halves both
+        // dimensions if requested. Rotating these already oriented coordinates again is wrong.
+        int clamped = Math.max(0, Math.min(capturePixel, Math.max(0, captureExtent - 1)));
+        return clamped * Math.max(1, scale);
+    }
+
+    void move(int x, int y, boolean click, long now) {
+        this.x = x;
+        this.y = y;
+        moved = now;
+        if (click) clicked = now;
+    }
+
+    float opacity(long now) {
+        if (moved < 0) return 0;
+        return 1f - Math.min(1f, Math.max(0, now - moved - IDLE_MS) / (float) FADE_MS);
+    }
+
+    float clickProgress(long now) {
+        return clicked < 0 ? 1f : Math.min(1f, Math.max(0, now - clicked) / (float) CLICK_MS);
+    }
+}
