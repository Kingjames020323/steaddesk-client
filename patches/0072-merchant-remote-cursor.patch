@@ -0,0 +1,86 @@
+package com.carriez.flutter_hbb;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.os.SystemClock;
+import android.view.View;
+
+final class RemoteCursorView extends View {
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path arrow = new Path();
+    private final RemoteCursorState state = new RemoteCursorState();
+    private final float density;
+    private final Runnable startFade = this::invalidate;
+
+    RemoteCursorView(Context context) {
+        super(context);
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+        density = getResources().getDisplayMetrics().density;
+        arrow.moveTo(0, 0);
+        arrow.lineTo(2, 21);
+        arrow.lineTo(7, 16);
+        arrow.lineTo(11, 24);
+        arrow.lineTo(15, 22);
+        arrow.lineTo(11, 14);
+        arrow.lineTo(18, 13);
+        arrow.close();
+        paint.setStrokeJoin(Paint.Join.ROUND);
+    }
+
+    void move(int x, int y, boolean click) {
+        state.move(x, y, click, SystemClock.uptimeMillis());
+        removeCallbacks(startFade);
+        postDelayed(startFade, RemoteCursorState.IDLE_MS);
+        postInvalidateOnAnimation();
+    }
+
+    @Override protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        long now = SystemClock.uptimeMillis();
+        float opacity = state.opacity(now);
+        if (opacity <= 0) return;
+        canvas.save();
+        canvas.translate(state.x, state.y);
+        canvas.scale(density, density);
+        float progress = state.clickProgress(now);
+        if (progress < 1) {
+            float radius = 7 + 17 * progress;
+            stroke(0xff10243a, opacity * (1 - progress), 4);
+            canvas.drawCircle(0, 0, radius, paint);
+            stroke(0xff5eddbb, opacity * (1 - progress), 2);
+            canvas.drawCircle(0, 0, radius, paint);
+        }
+        // Keep the pointer body visible at the right and bottom edges; the tip stays put.
+        canvas.scale(state.x + 20 * density > getWidth() ? -1 : 1,
+                     state.y + 26 * density > getHeight() ? -1 : 1);
+        stroke(0xff10243a, opacity, 4);
+        canvas.drawPath(arrow, paint);
+        stroke(0xffffffff, opacity, 2.5f);
+        canvas.drawPath(arrow, paint);
+        paint.setStyle(Paint.Style.FILL);
+        color(0xff1f5fd6, opacity);
+        canvas.drawPath(arrow, paint);
+        canvas.restore();
+        if (progress < 1 || now - state.moved >= RemoteCursorState.IDLE_MS) {
+            postInvalidateOnAnimation();
+        }
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        removeCallbacks(startFade);
+        super.onDetachedFromWindow();
+    }
+
+    private void stroke(int rgb, float opacity, float width) {
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(width);
+        color(rgb, opacity);
+    }
+
+    private void color(int rgb, float opacity) {
+        paint.setColor(rgb);
+        paint.setAlpha(Math.round(255 * opacity));
+    }
+}
