+    reads.add(device);
+    if (!granted || fail != null) throw const OnsiteFailure(403);
+    return (items: [OnsiteRecord.fromJson(visit)], total: 1);
+  }
+
+  @override
+  Future<OnsiteRecord> getRecord(OnsiteRecord row) async {
+    if (fail != null) throw fail!;
+    return OnsiteRecord.fromJson(visit);
+  }
+
+  @override
+  Future<OnsiteRecord> patch(
+      OnsiteRecord row, String key, OnsiteJson values) async {
+    writes.add((body: values, key: key, version: row.version));
+    if (fail != null) throw fail!;
+    if (visit['version'] != row.version) {
+      throw OnsiteFailure(409, OnsiteRecord.fromJson(visit));
+    }
+    visit = {...visit, ...values, 'version': row.version + 1};
+    return OnsiteRecord.fromJson(visit);
+  }
+
+  bool get due => {'open', 'scheduled'}.contains(visit['status']);
+  @override
+  Future<TodayJson> snapshot() async => {
