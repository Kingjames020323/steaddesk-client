+    expect(find.text('工单门店尚未核验'), findsOneWidget);
+    expect(find.text(onsiteConfirmedText), findsNothing);
+    expect(api.attempts, [reason]);
+    await t.pump(const Duration(seconds: 3));
+    expect(api.attempts, [reason]);
+  });
+}
