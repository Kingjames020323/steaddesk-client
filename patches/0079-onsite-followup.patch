+                    {
+                      'kind': 'help.claimed',
+                      'state': 'claimed',
+                      'version': 5,
+                      'handler': 'another-handler'
+                    }
+                  ],
+                  'case_records': [
+                    {
+                      'version': 3,
+                      'closed_by': account,
+                      'category': 'printer',
+                      'result': 'onsite',
+                      if (includeReceipt) 'onsite_followup': receipt
+                    }
+                  ]
+                }
+              : {
+                  'state': 'claimed',
+                  'version': 2,
+                  'handler': account,
+                  'history': [claim],
+                  'case_records': []
+                }));
+        }
+        await res.close();
+      });
+      LocalCaseStore open() => LocalCaseStore(
+          file: () async => File('${path.path}/$caseStoreFileName'),
+          writeHelp: api.closeCase);
+      final db = open();
+      await db.addDraft(account, draft(api.base.toString()));
+      Future<bool> submit(LocalCaseStore store, String why) =>
+          store.save(account, id,
+              category: 'printer',
+              result: 'onsite',
+              note: '待核对电源',
+              onsiteReason: why);
+      await expectLater(submit(db, ''), throwsFormatException);
+      await expectLater(submit(db, reason), throwsA(isA<OnsiteCloseError>()));
+      expect(posts, 1);
+      expect(bodies.single, {
+        'close_issue_type': 'printer',
+        'close_result': 'onsite',
+        'onsite_reason': reason
+      });
+      final restarted = open();
+      final savedDraft = (await restarted.pending(account)).single;
+      expect(savedDraft['status'], 'draft');
