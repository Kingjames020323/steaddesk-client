+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'data.dart';
+import 'widgets.dart';
+
+class DeviceOnsiteHistory extends StatefulWidget {
+  final String device;
+  final OnsiteAccess Function() open;
+  final Widget additional;
+  const DeviceOnsiteHistory(
+      {super.key,
+      required this.device,
+      required this.open,
+      required this.additional});
+  @override
+  State<DeviceOnsiteHistory> createState() => _DeviceOnsiteHistoryState();
+}
+
+class _DeviceOnsiteHistoryState extends State<DeviceOnsiteHistory> {
+  late final api = widget.open();
+  Timer? poll, guard;
+  OnsitePage? page;
+  int offset = 0, generation = 0;
+  bool loading = false;
+  @override
+  void initState() {
+    super.initState();
+    read();
+    poll = Timer.periodic(const Duration(seconds: 15), (_) {
+      if (!loading && api.current) read();
+    });
+    guard = Timer.periodic(const Duration(seconds: 1), (_) {
+      if (!api.current && page != null) setState(() => page = null);
+    });
+  }
+
+  Future<void> read({int? start}) async {
+    final generation = ++this.generation;
+    if (!api.current) return;
+    final target = start ?? offset;
+    setState(() {
+      loading = true;
+      if (target != offset) page = null;
+    });
+    try {
+      final fresh = await api.deviceHistory(widget.device, target);
+      if (!mounted || !api.current || generation != this.generation) return;
+      if (target > 0 && fresh.items.isEmpty && fresh.total <= target) {
+        await read(start: fresh.total == 0 ? 0 : (fresh.total - 1) ~/ 10 * 10);
+        return;
+      }
+      setState(() {
+        page = fresh;
+        offset = target;
+      });
+    } catch (_) {
+      if (mounted && generation == this.generation) setState(() => page = null);
+    } finally {
+      if (mounted && generation == this.generation) {
+        setState(() => loading = false);
+      }
+    }
+  }
+
+  @override
+  void dispose() {
+    generation++;
+    guard?.cancel();
+    poll?.cancel();
+    api.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final data = page;
+    if (!api.current || data == null) return widget.additional;
+    return NestedScrollView(
+        headerSliverBuilder: (_, __) => [
+              SliverToBoxAdapter(
+                  child: Padding(
+                      padding: const EdgeInsets.fromLTRB(16, 12, 16, 0),
+                      child: Column(
+                          crossAxisAlignment: CrossAxisAlignment.stretch,
+                          children: [
+                            Row(children: [
+                              Expanded(
+                                  child: Text('上门记录',
+                                      style: Theme.of(context)
+                                          .textTheme
+                                          .titleMedium)),
+                              IconButton(
+                                  tooltip: '刷新上门记录',
+                                  onPressed: loading ? null : read,
+                                  icon: const Icon(Icons.refresh, size: 16))
+                            ]),
+                            if (data.items.isEmpty) const Text('暂无上门记录。'),
+                            for (final r in data.items)
+                              OnsiteTile(r,
+                                  api: api,
+                                  current: () => mounted && api.current,
+                                  refresh: read),
+                            if (offset > 0 ||
+                                offset + data.items.length < data.total)
+                              Wrap(alignment: WrapAlignment.end, children: [
+                                TextButton(
+                                    onPressed: !loading && offset > 0
+                                        ? () => read(start: offset - 10)
+                                        : null,
+                                    child: const Text('上一页')),
+                                TextButton(
+                                    onPressed: !loading &&
+                                            offset + data.items.length <
+                                                data.total
+                                        ? () => read(start: offset + 10)
+                                        : null,
+                                    child: const Text('下一页')),
+                              ]),
+                          ]))),
+            ],
+        body: widget.additional);
+  }
+}
