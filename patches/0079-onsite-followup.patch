+    for (final value in [
+      '',
+      ' ',
+      'line\nline',
+      'line\u2028break',
+      'a' * 201,
+      'a\u200db'
+    ]) {
+      expect(validOnsiteReason(value), isFalse);
+    }
+    expect(validOnsiteReason('🧰' * 200), isTrue);
+    expect(validOnsiteReason(reason), isTrue);
+  });
+
+  test(
+      'real store survives lost confirmation; retry verifies the same close round and never repeats POST',
+      () async {
+    final path = await Directory.systemTemp.createTemp('onsite-close-');
+    addTearDown(() => path.delete(recursive: true));
+    await HttpOverrides.runWithHttpOverrides(() async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      final origin = Uri.parse('http://127.0.0.1:${server.port}');
+      final api = SupportHelpApi(origin, account, 'fixture-token', () => true);
+      addTearDown(() => server.close(force: true));
+      addTearDown(api.dispose);
+      bool closed = false;
+      int posts = 0;
+      bool includeReceipt = false;
+      final bodies = <Map>[];
+      server.listen((req) async {
+        expect(req.headers.value('Authorization'), 'Bearer fixture-token');
+        final res = req.response..headers.contentType = ContentType.json;
+        if (req.method == 'POST') {
+          expect(req.uri.path, '/ops/v1/help/requests/$ticket/close');
+          expect(req.headers.value('If-Match'), '"2"');
+          expect(req.headers.value('Idempotency-Key'), isNotEmpty);
+          bodies.add(jsonDecode(await utf8.decoder.bind(req).join()) as Map);
+          posts++;
+          closed = true;
+          res.write(jsonEncode({'state': 'closed', 'version': 3}));
+        } else {
+          expect(req.method, 'GET');
+          expect(req.uri.path, '/ops/v1/help/requests/$ticket');
+          res.write(jsonEncode(closed
+              ? {
+                  'state': 'claimed',
+                  'version': 5,
+                  'handler': 'another-handler',
+                  'onsite_followup': {
+                    ...receipt,
