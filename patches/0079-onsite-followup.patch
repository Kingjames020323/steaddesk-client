+
+const ticket = 'h_0123456789abcdef0123456789abcdef';
+const id = '00000000-0000-4000-8000-000000000007';
+const account = 'fixture';
+const reason = '更换收据打印机电源';
+final claim = {
+  'kind': 'help.claimed',
+  'version': 2,
+  'state': 'claimed',
+  'handler': account
+};
+final receipt = {
+  'ticket_id': ticket,
+  'close_version': 3,
+  'issue_type': 'printer',
+  'reason': reason
+};
+
+HelpRow draft(String origin, {bool linked = true}) => {
+      'id': id,
+      'agent': account,
+      'device_id': '123456789',
+      'display_name': 'Fixture POS',
+      'started_at': '2026-11-02T02:04:00.000Z',
+      'ended_at': '2026-11-02T02:07:00.000Z',
+      'note': '待核对电源',
+      'status': 'draft',
+      if (linked) ...{
+        'help_id': ticket,
+        'help_version': 2,
+        'help_origin': origin,
+        'category': 'printer'
+      }
+    };
+
+// dart:io loopback transport; the test server owns its ephemeral port.
+class _Loopback extends HttpOverrides {}
+
+class _Manual extends SupportHelpApi {
+  final row = {
+    'id': 'u_0123456789abcdef0123456789abcdef',
+    'version': 2,
+    'state': 'claimed',
+    'lane': 'unverified',
+    'handler': account,
+    'created_at': 0,
+    'category': 'printer',
+    'history': [claim]
+  };
+  final attempts = <String>[];
+  _Manual()
+      : super(Uri.parse('https://fixture.invalid'), account, 'fixture-token',
+            () => true);
+  @override
+  Future<HelpRow> detail(String id) async => Map.of(row);
+  @override
+  Future<void> closeCase(HelpRow r, String issue, String result) async {
+    attempts.add(r['onsite_reason'] as String);
+    throw const OnsiteCloseError('工单门店尚未核验');
+  }
+}
+
+class _DialogStore extends Fake implements CaseStore {
+  bool ack = false;
+  String? submitted;
+  @override
+  Future<bool> isAppendOnly(String account, String id) async => false;
+  @override
+  Future<bool> save(String account, String id,
+      {String? onsiteReason,
+      String? category,
+      String? result,
+      Map<String, dynamic>? followUp,
+      String? transferredTo,
+      required String note,
+      bool? expectedAppendOnly}) async {
+    submitted = onsiteReason;
+    if (!ack) throw const OnsiteCloseError('服务端尚未确认');
+    return true;
+  }
+}
+
+void main() {
