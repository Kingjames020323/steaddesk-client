diff --git a/flutter/lib/steaddesk/onsite/data.dart b/flutter/lib/steaddesk/onsite/data.dart
new file mode 100644
index 0000000..fffbef8
--- /dev/null
+++ b/flutter/lib/steaddesk/onsite/data.dart
@@ -0,0 +1,246 @@
+import 'dart:convert';
+import 'dart:io';
+
+import '../ops_groups.dart' show opsEndpoint;
+
+typedef OnsiteJson = Map<String, dynamic>;
+const onsiteStates = {
+  'open': '待安排',
+  'scheduled': '已预约',
+  'done': '已完成',
+  'cancelled': '已取消',
+};
+final _ticket = RegExp(r'^[hu]_[0-9a-f]{32}$');
+final _device = RegExp(r'^[0-9]{9,10}$');
+
+class OnsiteFailure implements Exception {
+  final int code;
+  final OnsiteRecord? latest;
+  const OnsiteFailure(this.code, [this.latest]);
+}
+
+class OnsiteRecord {
+  final String ticket,
+      store,
+      storeName,
+      device,
+      deviceName,
+      issueType,
+      reason,
+      status,
+      owner;
+  final int closeVersion, version;
+  final DateTime? scheduled;
+  final bool canEdit;
+  const OnsiteRecord(
+      {required this.ticket,
+      required this.closeVersion,
+      required this.version,
+      required this.store,
+      required this.storeName,
+      required this.device,
+      required this.deviceName,
+      required this.issueType,
+      required this.reason,
+      required this.status,
+      required this.owner,
+      required this.scheduled,
+      required this.canEdit});
+  factory OnsiteRecord.fromJson(OnsiteJson item) {
+    String field(String key) {
+      final value = item[key];
+      if (value is! String || value.isEmpty || value.runes.length > 512) {
+        throw const FormatException('上门记录字段无效');
+      }
+      return value;
+    }
+
+    final ticket = field('ticket_id'),
+        device = field('device_id'),
+        status = field('status'),
+        version = item['version'],
+        closeVersion = item['close_version'],
+        when = item['scheduled_at'];
+    if (!_ticket.hasMatch(ticket) ||
+        !_device.hasMatch(device) ||
+        !onsiteStates.containsKey(status) ||
+        version is! int ||
+        version < 1 ||
+        closeVersion is! int ||
+        closeVersion < 1 ||
+        item['can_edit'] is! bool ||
+        when != null && (when is! int || when < 0 || when > 253402300799)) {
+      throw const FormatException('上门记录格式无效');
+    }
+    return OnsiteRecord(
+        ticket: ticket,
+        closeVersion: closeVersion,
+        version: version,
+        store: field('store_id'),
+        storeName: field('store_name'),
+        device: device,
+        deviceName: field('device_name'),
+        issueType: field('issue_type'),
+        reason: field('reason'),
+        status: status,
+        owner: field('owner'),
+        scheduled: when == null
+            ? null
+            : DateTime.fromMillisecondsSinceEpoch((when as int) * 1000,
+                isUtc: true),
+        canEdit: item['can_edit']);
+  }
+  bool sameRecord(OnsiteRecord other) =>
+      ticket == other.ticket &&
+      closeVersion == other.closeVersion &&
+      store == other.store &&
+      device == other.device;
+}
+
+typedef OnsitePage = ({List<OnsiteRecord> items, int total});
+
+abstract interface class OnsiteAccess {
+  void dispose();
+  bool get current;
+  Future<OnsitePage> deviceHistory(String device, int offset);
+  Future<OnsiteRecord> getRecord(OnsiteRecord row);
+  Future<OnsiteRecord> patch(OnsiteRecord row, String key, OnsiteJson values);
+}
+
+class OnsiteHttp implements OnsiteAccess {
+  final Uri _base;
+  final String _token;
+  final bool Function() _current;
+  final HttpClient client;
+  OnsiteHttp(Uri origin, this._token, this._current, this.client)
+      : _base = opsEndpoint(origin) {
+    if (origin.scheme != 'https' || _token.isEmpty) {
+      throw const OnsiteFailure(401);
+    }
+  }
+  static bool validOrigin(Uri url) {
+    if (url.scheme != 'https') return false;
+    try {
+      opsEndpoint(url);
+      return true;
+    } on ArgumentError {
+      return false;
+    }
+  }
+
+  factory OnsiteHttp.owned(Uri origin, String token, bool Function() current) =>
+      OnsiteHttp(
+          origin,
+          token,
+          current,
+          HttpClient()
+            ..connectionTimeout = const Duration(seconds: 6)
+            ..findProxy = (_) => 'DIRECT');
+  @override
+  void dispose() => client.close(force: true);
+  @override
+  bool get current => _current();
+  Future<OnsiteJson> _request(String method, Uri uri,
+      {String? key, int? version, OnsiteJson? body}) async {
+    if (!current) throw const OnsiteFailure(401);
+    final req =
+        await client.openUrl(method, uri).timeout(const Duration(seconds: 6));
+    if (!current) {
+      req.abort();
+      throw const OnsiteFailure(401);
+    }
+    req.followRedirects = false;
+    req.headers.set(HttpHeaders.authorizationHeader, 'Bearer $_token');
+    req.headers.set(HttpHeaders.acceptHeader, 'application/json');
+    if (key != null) req.headers.set('Idempotency-Key', key);
+    if (version != null) req.headers.set('If-Match', '"$version"');
+    if (body != null) {
+      req.headers.contentType = ContentType.json;
+      final encoded = utf8.encode(jsonEncode(body));
+      req.contentLength = encoded.length;
+      req.add(encoded);
+    }
+    final res = await req.close().timeout(const Duration(seconds: 8));
+    if (res.statusCode != 200 && res.statusCode != 409) {
+      await res.listen((_) {}).cancel();
+      throw OnsiteFailure(res.statusCode);
+    }
+    final bytes = <int>[];
+    await for (final chunk in res.timeout(const Duration(seconds: 8))) {
+      if (bytes.length + chunk.length > 256 * 1024) {
+        throw const FormatException('上门记录过大');
+      }
+      bytes.addAll(chunk);
+    }
+    if (!current) throw const OnsiteFailure(401);
+    final data = jsonDecode(utf8.decode(bytes)) as OnsiteJson;
+    if (res.statusCode == 409) {
+      final latest = data['latest'];
+      throw OnsiteFailure(
+          409, latest is OnsiteJson ? OnsiteRecord.fromJson(latest) : null);
+    }
+    return data;
+  }
+
+  Uri _item(OnsiteRecord row) {
+    if (!_ticket.hasMatch(row.ticket) || row.closeVersion < 1) {
+      throw const OnsiteFailure(400);
+    }
+    return _base.resolve('onsite-followups/${row.ticket}/${row.closeVersion}');
+  }
+
+  OnsiteRecord _same(OnsiteRecord row, OnsiteJson data) {
+    final result = OnsiteRecord.fromJson(data);
+    if (!result.sameRecord(row)) throw const OnsiteFailure(403);
+    return result;
+  }
+
+  @override
+  Future<OnsiteRecord> getRecord(OnsiteRecord row) async =>
+      _same(row, await _request('GET', _item(row)));
+  @override
+  Future<OnsiteRecord> patch(
+      OnsiteRecord row, String key, OnsiteJson values) async {
+    if (!row.canEdit) throw const OnsiteFailure(403);
+    if (values.isEmpty ||
+        values.keys
+            .any((k) => !{'owner', 'scheduled_at', 'status'}.contains(k))) {
+      throw const OnsiteFailure(400);
+    }
+    try {
+      return _same(
+          row,
+          await _request('PATCH', _item(row),
+              key: key, version: row.version, body: values));
+    } on OnsiteFailure catch (e) {
+      if (e.latest != null && !e.latest!.sameRecord(row)) {
+        throw const OnsiteFailure(403);
+      }
+      rethrow;
+    }
+  }
+
+  @override
+  Future<OnsitePage> deviceHistory(String device, int offset) async {
+    if (!_device.hasMatch(device) || offset < 0) throw const OnsiteFailure(400);
+    final data = await _request(
+        'GET',
+        _base.resolve('onsite-followups').replace(queryParameters: {
+          'device_id': device,
+          'limit': '10',
+          'offset': '$offset',
+        }));
+    final items = (data['items'] as List)
+        .cast<OnsiteJson>()
+        .map(OnsiteRecord.fromJson)
+        .toList();
+    final total = data['total'];
+    if (total is! int ||
+        total < 0 ||
+        items.length > 10 ||
+        items.any((r) => r.device != device)) {
+      throw const FormatException('上门记录范围无效');
+    }
+    return (items: items, total: total);
+  }
+}
