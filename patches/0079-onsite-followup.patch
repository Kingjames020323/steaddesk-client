+final _nonPrintable = RegExp(r'[\p{C}\p{Z}]', unicode: true);
+
+bool validOnsiteReason(String reason) =>
+    reason.trim().isNotEmpty &&
+    reason.runes.length <= 200 &&
+    !_nonPrintable.hasMatch(reason.replaceAll(' ', ''));
+
+const onsiteReasonHint = '请填写 1–200 字的单行上门说明';
+const onsiteConfirmedText = '已建上门跟进';
+
+class OnsiteCloseError implements Exception {
+  final String message;
+  const OnsiteCloseError(this.message);
+  @override
+  String toString() => message;
+}
