+      await expectLater(
+          submit(restarted, reason), throwsA(isA<OnsiteCloseError>()));
+      includeReceipt = true;
+      await expectLater(
+          submit(restarted, '其他原因'), throwsA(isA<OnsiteCloseError>()));
