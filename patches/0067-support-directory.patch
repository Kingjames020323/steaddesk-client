+
+class DirectoryColumns extends StatelessWidget {
+  const DirectoryColumns(this.device, this.status, this.model, {super.key});
+  final Widget device, status, model;
+
+  @override
+  Widget build(BuildContext context) => Padding(
+      padding: const EdgeInsets.symmetric(horizontal: 12),
+      child: LayoutBuilder(builder: (context, size) {
+        final showModel =
+            MediaQuery.sizeOf(context).width >= 1180 && size.maxWidth >= 700;
+        return DefaultTextStyle.merge(
+            maxLines: 1,
+            softWrap: false,
+            overflow: TextOverflow.ellipsis,
+            child: Row(children: [
+              Expanded(flex: 6, child: device),
+              const SizedBox(width: 12),
+              Expanded(flex: 2, child: status),
+              if (showModel) ...[
+                const SizedBox(width: 12),
+                Expanded(flex: 2, child: model)
+              ],
+            ]));
+      }));
+}
+
+class DirectoryRow extends StatefulWidget {
+  const DirectoryRow(
+      {super.key,
+      required this.device,
+      required this.translate,
+      required this.onConnect,
+      required this.onDetails,
+      required this.onTransfer,
+      required this.more});
+  final SupportDevice device;
+  final String Function(String) translate;
+  final VoidCallback onConnect, onDetails, onTransfer;
+  final Widget more;
+  @override
+  State<DirectoryRow> createState() => _DirectoryRowState();
+}
+
+class _DirectoryFocusNode extends FocusNode {}
+
+class _DirectoryRowState extends State<DirectoryRow> {
+  final node = _DirectoryFocusNode();
+
+  @override
+  void dispose() {
+    node.dispose();
+    super.dispose();
+  }
+
+  bool hovered = false, focused = false;
+
+  KeyEventResult _key(FocusNode node, KeyEvent event) {
+    if (!node.hasPrimaryFocus ||
+        event is! KeyDownEvent && event is! KeyRepeatEvent) {
+      return KeyEventResult.ignored;
+    }
+    final key = event.logicalKey;
+    if (key == LogicalKeyboardKey.arrowDown ||
+        key == LogicalKeyboardKey.arrowUp) {
+      final list = Scrollable.maybeOf(context);
+      final rows = node.enclosingScope!.traversalDescendants
+          .where((candidate) =>
+              candidate is _DirectoryFocusNode &&
+              candidate.context != null &&
+              Scrollable.maybeOf(candidate.context!) == list)
+          .toList()
+        ..sort((a, b) => a.rect.top.compareTo(b.rect.top));
+      final current = rows.indexOf(node);
+      final next = current + (key == LogicalKeyboardKey.arrowDown ? 1 : -1);
+      if (current >= 0 && next >= 0 && next < rows.length) {
+        rows[next].requestFocus();
+        Scrollable.ensureVisible(rows[next].context!);
+      }
+    } else if (key == LogicalKeyboardKey.enter ||
+        key == LogicalKeyboardKey.numpadEnter) {
+      if (event is KeyDownEvent && widget.device.online == true) {
+        widget.onConnect();
+      }
+    } else if (key == LogicalKeyboardKey.space) {
+      if (event is KeyDownEvent) widget.onDetails();
+    } else {
+      return KeyEventResult.ignored;
+    }
+    return KeyEventResult.handled;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final d = widget.device;
+    final tr = widget.translate;
+    final online = d.online == true;
+    final active = hovered || focused;
+    const blue = Color(0xff0a6fa8);
+    final label = FittedBox(
+        fit: BoxFit.scaleDown,
+        child: Text(tr(online ? 'Connect' : 'Details'), maxLines: 1));
+    const actionShape = RoundedRectangleBorder(
+        borderRadius: BorderRadius.all(Radius.circular(6)));
+    final primary = online
+        ? FilledButton(
+            onPressed: widget.onConnect,
+            style: FilledButton.styleFrom(
+                shape: actionShape,
+                padding: const EdgeInsets.symmetric(horizontal: 10),
+                backgroundColor: blue,
+                foregroundColor: Colors.white),
+            child: label)
+        : OutlinedButton(
+            onPressed: widget.onDetails,
+            style: OutlinedButton.styleFrom(
+                shape: actionShape,
+                padding: const EdgeInsets.symmetric(horizontal: 10),
+                foregroundColor: blue),
+            child: label);
+    // J26 will supply confirmed operator presence. Online state alone cannot
+    // establish that another operator is controlling this device.
+    return Focus(
+        focusNode: node,
+        onFocusChange: (v) => setState(() => focused = v),
+        onKeyEvent: _key,
+        child: MouseRegion(
+            onEnter: (_) => setState(() => hovered = true),
+            onExit: (_) => setState(() => hovered = false),
+            child: GestureDetector(
+                behavior: HitTestBehavior.opaque,
+                onDoubleTap: widget.onConnect,
+                onTap: widget.onDetails,
+                child: Container(
+                  height: 56,
+                  color: active ? const Color(0xfff3f4f6) : Colors.transparent,
+                  child: DirectoryColumns(
+                      Row(children: [
+                        Expanded(
+                            child: DirectoryDeviceIdentity(
+                                id: d.id,
+                                alias: d.alias,
+                                name: d.name,
+                                hovered: active,
+                                translate: tr)),
+                        const SizedBox(width: 4),
+                        Visibility(
+                            visible: active,
+                            maintainSize: true,
+                            maintainAnimation: true,
+                            maintainState: true,
+                            child: ExcludeFocus(
+                                excluding: !active,
+                                child: Row(
+                                    mainAxisSize: MainAxisSize.min,
+                                    children: [
+                                      ConstrainedBox(
+                                          constraints: const BoxConstraints(
+                                              maxWidth: 100),
+                                          child: primary),
+                                      IconButton(
+                                          tooltip: tr('Transfer file'),
+                                          onPressed: widget.onTransfer,
+                                          icon: const Icon(
+                                              Icons.folder_open_outlined,
+                                              size: 18)),
+                                      widget.more,
+                                    ]))),
+                      ]),
+                      Text(
+                          tr(d.online == null
+                              ? 'Unknown'
+                              : online
+                                  ? 'Online'
+                                  : 'Offline'),
+                          style: TextStyle(
+                              color: online
+                                  ? const Color(0xff16803d)
+                                  : const Color(0xff4b5563))),
+                      Text(d.model.isEmpty ? '—' : d.model)),
+                ))));
+  }
+}
