+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/ops_health.dart' show HealthFailure;
+import 'package:flutter_hbb/steaddesk/today/data.dart';
+import 'package:flutter_hbb/steaddesk/today/panel.dart';
+
+final observation =
+    DateTime(2026, 10, 10, 13, 24).millisecondsSinceEpoch ~/ 1000;
+TodayJson snapshotFor(Map<String, List<String>> grant) => {
+      'as_of': observation + 700,
+      'sections': {
+        for (final slot in grant.entries)
+          slot.key: {
+            'as_of': observation,
+            'freshness': slot.key == 'self_heal' ? 'partial' : 'live',
+            'counts': {
+              for (final filter in slot.value)
+                filter: filter == 'offline' ? null : 1
+            },
+            if (slot.key == 'updates') ...{
+              'stages': {'open': 1},
+              'attempt_states': {'observing': 2},
+              'stopped': true
+            },
+            if (slot.key == 'queue')
+              'oldest': {'id': 'example-ticket', 'wait_seconds': 743},
+            if (slot.key == 'self_heal') ...{
+              'covered_devices': 1,
+              'total_devices': 3
+            },
+          },
+      }
+    };
+
+class Fixture implements TodayApi {
+  final feed = StreamController<String>.broadcast(sync: true);
+  TodayJson data = snapshotFor(sections);
+  Object? error;
+  Completer<TodayJson>? pendingList, pendingSnapshot;
+  final calls = <(String, int)>[];
+  int requests = 0;
+  bool closed = false;
+  @override
+  Future<TodayJson> snapshot() async {
+    requests++;
+    if (error != null) throw error!;
+    return pendingSnapshot?.future ?? Future.value(data);
+  }
+
+  @override
+  Future<TodayJson> list(String filter, int offset) async {
+    calls.add((filter, offset));
+    return pendingList?.future ?? Future.value(page(filter, offset));
+  }
+
+  TodayJson page(String filter, int offset) => {
+        'filter': filter,
+        'as_of': observation,
+        'freshness': 'live',
+        'rows': [
+          {
+            'id': 'example-$filter-$offset',
+            'state': 'queued',
+            'at': observation,
+            'phone': 'private-field',
+            'reason': 'private-reason'
+          }
+        ],
+        'next_offset': offset == 0 ? 25 : null,
+      };
+  @override
+  Stream<String> events() => feed.stream;
+  @override
+  void close() {
+    closed = true;
+    feed.close();
+  }
+}
+
+class Harness {
+  final fixture = Fixture();
+  late final store = TodayStore(fixture, () => true);
+  Future<void> mount(WidgetTester tester) async {
+    tester.view.physicalSize = const Size(1024, 640);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.resetPhysicalSize);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    store.start();
+    await tester.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: Center(
+                child: SizedBox(
+                    width: 806,
+                    height: 498,
+                    child: TodayPanel(store: store))))));
+    await tester.pump();
+  }
+
+  Future<void> close(WidgetTester tester) async {
+    await tester.pumpWidget(const SizedBox.shrink());
+    store.dispose();
+  }
+}
+
+Finder byKey(String name) => find.byKey(ValueKey(name));
+
+void main() {
+  testWidgets(
+      'seven scoped sections fit without scrolling and all filters drill into matching pages',
+      (tester) async {
+    final h = Harness();
+    final elapsed = Stopwatch()..start();
+    await h.mount(tester);
+    expect(h.fixture.requests, 1);
+    for (final key in sections.keys) {
+      expect(byKey('today-section-$key').hitTestable(), findsOneWidget);
+    }
+    expect(elapsed.elapsed, lessThan(const Duration(seconds: 2)));
+    expect(find.text('最早单号 example-ticket'), findsOneWidget);
+    expect(find.text('12 分'), findsOneWidget);
+    expect(find.text('批次 · 已开放 1'), findsOneWidget);
+    expect(find.text('执行 · 观察中 2'), findsOneWidget);
+    expect(find.text('已触发'), findsOneWidget);
+    expect(find.text('观测覆盖 1/3 台'), findsOneWidget);
+    expect(find.text('部分来源 · 数据截至 13:24'), findsOneWidget);
+    expect(
+        find.descendant(
+            of: byKey('today-filter-offline'), matching: find.text('未知')),
+        findsOneWidget);
+    for (final filter in sections.values.expand((fields) => fields)) {
+      final button = byKey('today-filter-$filter');
+      expect(button.hitTestable(), findsOneWidget);
+      await tester.tap(button);
+      await tester.pumpAndSettle();
+      expect(h.fixture.calls.last, (filter, 0));
+      expect(find.text('example-$filter-0'), findsOneWidget);
+      expect(find.textContaining('private-'), findsNothing);
+      await tester.tap(byKey('today-next'));
+      await tester.pumpAndSettle();
+      expect(find.text('example-$filter-25'), findsOneWidget);
+      expect(find.text('example-$filter-0'), findsNothing);
+      await tester.tap(byKey('today-prev'));
+      await tester.pumpAndSettle();
+      expect(h.fixture.calls.last, (filter, 0));
+      await tester.tap(byKey('today-back'));
+      await tester.pumpAndSettle();
+    }
+    await h.close(tester);
+  });
+
+  testWidgets(
+      'only granted submetrics render; SSE failure shows source cutoff then polling clears forbidden data',
+      (tester) async {
+    final h = Harness();
+    h.fixture.data = snapshotFor({
+      'manual': ['stopped']
+    });
+    await h.mount(tester);
+    expect(byKey('today-filter-stopped'), findsOneWidget);
+    expect(byKey('today-filter-paused'), findsNothing);
+    expect(byKey('today-section-alerts'), findsNothing);
+    h.fixture.feed.addError(StateError('disconnected'));
+    await tester.pump();
+    expect(find.text('数据截至 13:24'), findsOneWidget);
+    h.fixture.error = const HealthFailure(403);
+    await tester.pump(const Duration(seconds: 10));
+    await tester.pump();
+    expect(byKey('today-filter-stopped'), findsNothing);
+    expect(find.text('无权查看今天的数据。'), findsOneWidget);
+    await h.close(tester);
+  });
+
+  testWidgets(
+      'permission resync revokes immediately, including pending reads and late detail completions',
+      (tester) async {
+    final h = Harness();
+    await h.mount(tester);
+    h.fixture.pendingList = Completer<TodayJson>();
+    h.fixture.pendingSnapshot = Completer<TodayJson>();
+    unawaited(h.store.refresh());
+    await tester.tap(byKey('today-filter-red'));
+    await tester.pump();
+    expect(h.store.filter, 'red');
+    h.fixture.feed.add('resync');
+    expect(h.store.filter, isNull);
+    expect(h.store.visible, isEmpty);
+    await tester.pump();
+    h.fixture.pendingList!.complete(h.fixture.page('red', 0));
+    h.fixture.pendingSnapshot!.complete(snapshotFor(sections));
+    h.fixture.pendingSnapshot = null;
+    h.fixture.data = snapshotFor({
+      'queue': ['unverified']
+    });
+    await tester.pump(const Duration(milliseconds: 100));
+    await tester.pump();
+    expect(find.text('example-red-0'), findsNothing);
+    expect(byKey('today-filter-red'), findsNothing);
+    expect(byKey('today-filter-oldest'), findsNothing);
+    expect(byKey('today-filter-unverified'), findsOneWidget);
+    expect(find.textContaining('example-ticket'), findsNothing);
+    await h.close(tester);
+  });
+
+  testWidgets(
+      'scope recheck refetches current page and discards old rows while fresh proof is pending',
+      (tester) async {
+    final h = Harness();
+    await h.mount(tester);
+    await tester.tap(byKey('today-filter-red'));
+    await tester.pumpAndSettle();
+    await tester.tap(byKey('today-next'));
+    await tester.pumpAndSettle();
+    h.fixture.pendingList = Completer<TodayJson>();
+    h.fixture.feed.add('alert.changed');
+    await tester.pump(const Duration(milliseconds: 100));
+    await tester.pump();
+    expect(h.fixture.calls.last, ('red', 25));
+    expect(find.text('example-red-25'), findsNothing);
+    h.fixture.pendingList!.completeError(const HealthFailure(404));
+    h.fixture.data = snapshotFor({
+      'queue': ['verified']
+    });
+    await tester.pumpAndSettle();
+    expect(byKey('today-filter-red'), findsNothing);
+    expect(byKey('today-filter-verified'), findsOneWidget);
+    await h.close(tester);
+  });
+}
