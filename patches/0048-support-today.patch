@@ -0,0 +1,81 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+import '../../common.dart' show gFFI;
+import '../../models/platform_model.dart' show bind;
+import '../ops_groups.dart' show opsEndpoint;
+import 'data.dart';
+import 'panel.dart';
+
+const todayEnabled = true;
+typedef _Identity = ({String account, String token, Uri origin, bool admin});
+_Identity? _identity() {
+  final account = gFFI.userModel.userName.value,
+      token = bind.mainGetLocalOption(key: 'access_token');
+  final origin = Uri.tryParse(bind.mainGetOptionSync(key: 'api-server'));
+  if (account.isEmpty ||
+      token.isEmpty ||
+      origin == null ||
+      origin.scheme != 'https') return null;
+  try {
+    opsEndpoint(origin);
+  } on ArgumentError {
+    return null;
+  }
+  return (
+    account: account,
+    token: token,
+    origin: origin,
+    admin: gFFI.userModel.isAdmin.value
+  );
+}
+
+class TodayHost extends StatefulWidget {
+  const TodayHost({super.key});
+  @override
+  State<TodayHost> createState() => _TodayHostState();
+}
+
+class _TodayHostState extends State<TodayHost> {
+  TodayStore? store;
+  _Identity? who;
+  Timer? tick;
+  late StreamSubscription<String> account;
+  late StreamSubscription<bool> role;
+  @override
+  void initState() {
+    super.initState();
+    account = gFFI.userModel.userName.listen((_) => sync());
+    role = gFFI.userModel.isAdmin.listen((_) => sync());
+    tick = Timer.periodic(const Duration(seconds: 1), (_) => sync());
+    sync();
+  }
+
+  void sync() {
+    if (!mounted) return;
+    final next = _identity();
+    if (who == next) return;
+    store?.dispose();
+    store = null;
+    who = next;
+    if (next != null) {
+      bool current() => mounted && who == next && _identity() == next;
+      store = TodayStore(TodayHttp(next.origin, next.token, current), current)
+        ..start();
+    }
+    setState(() {});
+  }
+
+  @override
+  void dispose() {
+    account.cancel();
+    role.cancel();
+    tick?.cancel();
+    store?.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => store == null
+      ? const Center(child: Text('请登录客服账号后查看今天的数据。'))
+      : TodayPanel(store: store!);
+}
