+String _clock(int seconds) {
+  final t = DateTime.fromMillisecondsSinceEpoch(seconds * 1000).toLocal();
+  return '${t.hour.toString().padLeft(2, '0')}:${t.minute.toString().padLeft(2, '0')}';
+}
+
+String _cutoff(int? stamp) =>
+    stamp == null ? '尚无观测时间' : '数据截至 ${_clock(stamp)}';
+String _quality(String value, int? asOf, bool disconnected) {
+  if (value == 'unknown') {
+    return asOf == null ? '来源未知' : '来源未知 · ${_cutoff(asOf)}';
+  }
+  if (value == 'partial') return '部分来源 · ${_cutoff(asOf)}';
+  if (value == 'stale' || disconnected) return _cutoff(asOf);
+  return '';
+}
+
+String _wait(dynamic seconds) => seconds is int ? '${seconds ~/ 60} 分' : '未知';
+
+class TodayPanel extends StatelessWidget {
+  final TodayStore store;
+  const TodayPanel({super.key, required this.store});
+  @override
+  Widget build(BuildContext context) => AnimatedBuilder(
+      animation: store,
+      builder: (context, _) {
+        if (!store.active) return const SizedBox.shrink();
+        final selected = store.filter;
+        if (selected != null && store.permits(selected)) {
+          return _Details(store: store, filter: selected);
+        }
+        final date = DateTime.now();
+        return Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              Padding(
+                  padding: const EdgeInsets.fromLTRB(16, 6, 8, 4),
+                  child: Row(children: [
+                    Text('今天', style: Theme.of(context).textTheme.titleLarge),
+                    const SizedBox(width: 12),
+                    Expanded(
+                        child: Text('${date.month}月${date.day}日',
+                            style: Theme.of(context).textTheme.bodyMedium)),
+                    if (store.offline || store.streamDown)
+                      Flexible(
+                          child: Text(_cutoff(store.asOf),
+                              textAlign: TextAlign.end)),
+                    IconButton(
+                        tooltip: '刷新',
+                        onPressed: store.refresh,
+                        icon: const Icon(Icons.refresh)),
+                  ])),
+              if (store.visible.isEmpty)
+                Expanded(
+                    child: Center(
+                        child: store.loading
+                            ? const CircularProgressIndicator()
+                            : Text(store.denied
+                                ? '无权查看今天的数据。'
+                                : store.offline
+                                    ? '暂时无法读取今天的数据。'
+                                    : '暂无可查看的项目。')))
+              else
+                Expanded(child: LayoutBuilder(builder: (ctx, box) {
+                  final columns = box.maxWidth >= 650
+                      ? 3
+                      : box.maxWidth >= 410
+                          ? 2
+                          : 1;
+                  const gap = 8.0;
+                  final width = math.max(
+                      0.0, (box.maxWidth - 24 - gap * (columns - 1)) / columns);
+                  return SingleChildScrollView(
+                      padding: const EdgeInsets.fromLTRB(12, 2, 12, 12),
+                      child: Wrap(spacing: gap, runSpacing: gap, children: [
+                        for (final section in store.visible.entries)
+                          SizedBox(
+                              width: width,
+                              child: _Section(
+                                  name: section.key,
+                                  data: section.value,
+                                  store: store))
+                      ]));
+                })),
+            ]);
+      });
+}
+
+class _Section extends StatelessWidget {
+  final String name;
+  final TodaySection data;
+  final TodayStore store;
+  const _Section({required this.name, required this.data, required this.store});
+  @override
+  Widget build(BuildContext context) {
+    final raw = data.data;
+    final stamp =
+        _quality(data.freshness, data.asOf, store.offline || store.streamDown);
+    final oldest = raw['oldest'];
+    String states(String permission, String field) {
+      if (!data.counts.containsKey(permission) || raw[field] is! Map) return '';
+      return (raw[field] as Map)
+          .entries
+          .where((entry) => entry.value is int && entry.value > 0)
+          .map((entry) => '${_states[entry.key] ?? entry.key} ${entry.value}')
+          .join(' · ');
+    }
+
+    final batchStates = states('batches', 'stages');
+    final attemptStates = states('attempts', 'attempt_states');
+    final covered = raw['covered_devices'], total = raw['total_devices'];
+    final info = <String>[
+      if (name == 'queue' &&
+          data.counts.containsKey('oldest') &&
+          oldest is Map &&
+          oldest['id'] is String)
+        '最早单号 ${oldest['id']}',
+      if (name == 'callbacks') '按门店当地日期',
+      if (attemptStates.isNotEmpty) '执行 · $attemptStates',
+      if (batchStates.isNotEmpty) '批次 · $batchStates',
+      if (covered is int && total is int) '观测覆盖 $covered/$total 台',
+    ];
+    return Card(
+        key: ValueKey('today-section-$name'),
+        margin: EdgeInsets.zero,
+        elevation: 0,
+        shape: RoundedRectangleBorder(
+            borderRadius: BorderRadius.circular(8),
+            side: const BorderSide(color: Color(0xffd4e1e8))),
+        child: Padding(
+            padding: const EdgeInsets.fromLTRB(10, 8, 10, 8),
+            child:
+                Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+              Row(children: [
+                Icon(_icons[name], size: 17, color: const Color(0xff245a76)),
+                const SizedBox(width: 6),
+                Expanded(
+                    child: Text(_titles[name]!,
+                        style: const TextStyle(
+                            fontWeight: FontWeight.w600, fontSize: 14)))
+              ]),
+              const SizedBox(height: 5),
+              Row(children: [
+                for (final entry in data.counts.entries)
+                  Expanded(
+                      child: InkWell(
+                          key: ValueKey('today-filter-${entry.key}'),
+                          onTap: () => store.open(entry.key),
+                          borderRadius: BorderRadius.circular(4),
+                          child: Padding(
+                              padding: const EdgeInsets.symmetric(
+                                  horizontal: 2, vertical: 4),
+                              child: Column(
+                                  crossAxisAlignment: CrossAxisAlignment.start,
+                                  children: [
+                                    Text(_filters[entry.key]!,
+                                        style: TextStyle(
+                                            fontSize: 12,
+                                            color: entry.key == 'red'
+                                                ? const Color(0xffa02a29)
+                                                : entry.key == 'amber'
+                                                    ? const Color(0xff815410)
+                                                    : const Color(0xff335b70))),
+                                    Text(
+                                        entry.value == null
+                                            ? '未知'
+                                            : entry.key == 'oldest' &&
+                                                    entry.value != 0
+                                                ? _wait(oldest is Map
+                                                    ? oldest['wait_seconds']
+                                                    : null)
+                                                : entry.key == 'safety'
+                                                    ? (raw['stopped'] == true
+                                                        ? '已触发'
+                                                        : raw['stopped'] ==
+                                                                false
+                                                            ? '未触发'
+                                                            : '未知')
+                                                    : '${entry.value}',
+                                        style: const TextStyle(
+                                            fontSize: 18,
+                                            fontWeight: FontWeight.w600)),
+                                  ])))),
+              ]),
+              for (final line in info)
+                Tooltip(
+                    message: line,
+                    child: Text(line,
+                        maxLines: 1,
+                        overflow: TextOverflow.ellipsis,
+                        style: const TextStyle(fontSize: 12))),
+              if (stamp.isNotEmpty)
+                Text(stamp,
+                    style: const TextStyle(
+                        fontSize: 12, color: Color(0xff795215))),
+            ])));
+  }
+}
+
+class _Details extends StatelessWidget {
+  final TodayStore store;
+  final String filter;
+  const _Details({required this.store, required this.filter});
+  @override
+  Widget build(BuildContext context) {
+    final group = sections.entries
+        .firstWhere((entry) => entry.value.contains(filter))
+        .key;
+    final title = '${_titles[group]} · ${_filters[filter]}';
+    final quality = _quality(store.detailQuality, store.detailAsOf,
+        store.streamDown || store.offline || store.detailFailed);
+    return Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      Row(children: [
+        IconButton(
+            key: const ValueKey('today-back'),
+            tooltip: '返回今天',
+            onPressed: store.back,
+            icon: const Icon(Icons.arrow_back)),
+        Expanded(
+            child: Text(title, style: Theme.of(context).textTheme.titleMedium)),
+        IconButton(
+            tooltip: '刷新明细',
+            onPressed: () => store.open(filter, offset: store.detailOffset),
+            icon: const Icon(Icons.refresh)),
+      ]),
+      if (quality.isNotEmpty && !store.detailLoading)
+        Padding(
+            padding: const EdgeInsets.symmetric(horizontal: 16),
+            child: Text(quality)),
+      if (store.detailLoading) const LinearProgressIndicator(),
+      if (store.detailFailed)
+        const Padding(padding: EdgeInsets.all(12), child: Text('无法读取明细，请刷新。')),
+      Expanded(
+          child: store.rows.isEmpty
+              ? Center(
+                  child: Text(store.detailLoading
+                      ? '正在读取…'
+                      : store.detailFailed
+                          ? '明细暂不可用'
+                          : store.detailQuality == 'unknown'
+                              ? '暂无观测'
+                              : '暂无符合条件的记录'))
+              : ListView.builder(
+                  key: ValueKey((filter, store.detailOffset)),
+                  itemCount: store.rows.length,
+                  itemBuilder: (_, i) {
+                    final row = store.rows[i], id = row['id'] as String;
+                    final state = row['state'];
+                    final parts = <String>[
+                      if (state is String) _states[state] ?? state,
+                      if (row['device_id'] is String && row['device_id'] != id)
+                        '设备 ${row['device_id']}',
+                      if (row['lane'] is String)
+                        _states[row['lane']] ?? row['lane'],
+                      if (row['wait_seconds'] is int)
+                        '等待 ${_wait(row['wait_seconds'])}',
+                      if (filter == 'self_heal')
+                        '已观测动作 ${row['count'] ?? '未知'}',
+                      if (row['ring'] != null) '环 ${row['ring']}',
+                      if (row['batch'] != null) '批次 ${row['batch']}',
+                      if (row['at'] is int)
+                        '${filter == 'callbacks' ? '客服本地时间 ' : ''}${_clock(row['at'])}',
+                      if (filter == 'callbacks' && row['zone'] is String)
+                        '门店时区 ${row['zone']}',
+                    ];
+                    return ListTile(
+                        dense: true,
+                        title: Text(id),
+                        subtitle: Text(parts.join(' · ')));
+                  })),
+      if (store.detailOffset != 0 || store.nextOffset != null)
+        Wrap(
+            alignment: WrapAlignment.end,
+            crossAxisAlignment: WrapCrossAlignment.center,
+            children: [
+              Text('第 ${1 + store.detailOffset ~/ 25} 页'),
+              TextButton(
+                  key: const ValueKey('today-prev'),
+                  onPressed: store.detailOffset > 0 && !store.detailLoading
+                      ? () => store.open(filter,
+                          offset: math.max(0, store.detailOffset - 25))
+                      : null,
+                  child: const Text('上一页')),
+              TextButton(
+                  key: const ValueKey('today-next'),
+                  onPressed: store.nextOffset != null && !store.detailLoading
+                      ? () => store.open(filter, offset: store.nextOffset!)
+                      : null,
+                  child: const Text('下一页')),
+            ]),
+    ]);
+  }
+}
