diff --git a/flutter/lib/steaddesk/today/data.dart b/flutter/lib/steaddesk/today/data.dart
new file mode 100644
index 0000000..b349327
--- /dev/null
+++ b/flutter/lib/steaddesk/today/data.dart
@@ -0,0 +1,325 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:flutter/foundation.dart';
+import '../ops_health.dart' show HealthFailure, OpsHealthHttp;
+import '../ops_groups.dart' show opsEndpoint;
+
+typedef TodayJson = Map<String, dynamic>;
+const sections = {
+  'alerts': ['red', 'amber'],
+  'queue': ['verified', 'unverified', 'oldest'],
+  'callbacks': ['callbacks'],
+  'offline': ['offline'],
+  'manual': ['stopped', 'paused'],
+  'updates': ['attempts', 'batches', 'safety'],
+  'self_heal': ['self_heal'],
+};
+
+abstract interface class TodayApi {
+  Future<TodayJson> snapshot();
+  Future<TodayJson> list(String filter, int offset);
+  Stream<String> events();
+  void close();
+}
+
+class TodayHttp implements TodayApi {
+  final Uri base;
+  final String token;
+  final bool Function() current;
+  final OpsHealthHttp stream;
+  final HttpClient http = HttpClient()
+    ..connectionTimeout = const Duration(seconds: 5)
+    ..findProxy = (_) => 'DIRECT';
+  TodayHttp(Uri origin, this.token, this.current)
+      : base = opsEndpoint(origin),
+        stream = OpsHealthHttp(origin, token, todayEvents: true) {
+    if (origin.scheme != 'https') throw const HealthFailure(400);
+  }
+
+  @override
+  Future<TodayJson> snapshot() => get(base.resolve('today'));
+  @override
+  Future<TodayJson> list(String filter, int offset) {
+    if (!sections.values.any((filters) => filters.contains(filter)) ||
+        offset < 0) throw const HealthFailure(400);
+    return get(base
+        .resolve('today/$filter')
+        .replace(queryParameters: {'limit': '25', 'offset': '$offset'}));
+  }
+
+  Future<TodayJson> get(Uri uri) async {
+    if (!current()) throw const HealthFailure(401);
+    final request = await http.getUrl(uri).timeout(const Duration(seconds: 6));
+    if (!current()) {
+      request.abort();
+      throw const HealthFailure(401);
+    }
+    request.followRedirects = false;
+    request.headers.set(HttpHeaders.authorizationHeader, 'Bearer $token');
+    request.headers.set(HttpHeaders.acceptHeader, 'application/json');
+    final response = await request.close().timeout(const Duration(seconds: 8));
+    if (response.statusCode != 200) {
+      await response.listen((_) {}).cancel();
+      throw HealthFailure(response.statusCode);
+    }
+    final bytes = BytesBuilder(copy: false);
+    await for (final chunk in response.timeout(const Duration(seconds: 8))) {
+      if (bytes.length + chunk.length > 256 * 1024) {
+        throw const FormatException('Invalid dashboard response');
+      }
+      bytes.add(chunk);
+    }
+    if (!current()) throw const HealthFailure(401);
+    return jsonDecode(utf8.decode(bytes.takeBytes())) as TodayJson;
+  }
+
+  @override
+  Stream<String> events() => stream.changes();
+  @override
+  void close() {
+    http.close(force: true);
+    stream.close();
+  }
+}
+
+class TodaySection {
+  final TodayJson data;
+  final Map<String, int?> counts;
+  TodaySection(String key, this.data)
+      : counts = {
+          for (final filter in sections[key]!)
+            if ((data['counts'] as Map).containsKey(filter))
+              filter: data['counts'][filter] as int?
+        } {
+    if (!const {'live', 'partial', 'stale', 'unknown'}
+            .contains(data['freshness']) ||
+        counts.values.any((n) => n != null && n < 0)) {
+      throw const FormatException('Invalid dashboard metrics');
+    }
+  }
+  int? get asOf => data['as_of'] as int?;
+  String get freshness => data['freshness'] as String;
+}
+
+class TodayStore extends ChangeNotifier {
+  final TodayApi api;
+  final bool Function() current;
+  TodayStore(this.api, this.current);
+  Map<String, TodaySection> visible = {};
+  bool loading = true, streamDown = false, offline = false, denied = false;
+  int? asOf;
+  String? filter;
+  List<TodayJson> rows = [];
+  int? nextOffset, detailAsOf;
+  int detailOffset = 0;
+  String detailQuality = 'unknown';
+  bool detailLoading = false, detailFailed = false;
+  bool _retired = false, _reading = false, _again = false;
+  int _scope = 0, _drill = 0;
+  Timer? _poll, _retry, _coalesce;
+  StreamSubscription<String>? _feed;
+  bool get active => !_retired && current();
+  bool permits(String field) =>
+      visible.values.any((section) => section.counts.containsKey(field));
+  bool _unauthorized(Object e) =>
+      e is HealthFailure && {401, 403, 404}.contains(e.status);
+
+  void start() {
+    unawaited(refresh());
+    _listen();
+    _poll = Timer.periodic(const Duration(seconds: 10), (_) => refresh());
+  }
+
+  void _clear() {
+    _scope++;
+    visible = {};
+    asOf = null;
+    _resetDetail();
+  }
+
+  void _resetDetail() {
+    _drill++;
+    filter = null;
+    rows = [];
+    nextOffset = null;
+    detailAsOf = null;
+    detailOffset = 0;
+    detailQuality = 'unknown';
+    detailLoading = false;
+    detailFailed = false;
+  }
+
+  void back() {
+    _resetDetail();
+    notifyListeners();
+  }
+
+  void _listen() {
+    if (!active) return;
+    _feed = api.events().listen((kind) {
+      if (!active) return;
+      if (kind == 'connected') {
+        final reconnect = streamDown;
+        streamDown = false;
+        if (reconnect) unawaited(refresh());
+        notifyListeners();
+        return;
+      }
+      final permissionChange = kind == 'resync' ||
+          kind == 'reset' ||
+          kind.startsWith('group.') ||
+          kind.startsWith('role.') ||
+          kind.startsWith('permission.') ||
+          kind.startsWith('auth.');
+      if (permissionChange) {
+        _clear();
+        loading = true;
+        notifyListeners();
+      } else if (![
+        'health.',
+        'alert.',
+        'help.',
+        'fleet.',
+        'device.',
+        'self_heal.'
+      ].any(kind.startsWith)) {
+        return;
+      }
+      _coalesce?.cancel();
+      _coalesce = Timer(const Duration(milliseconds: 80), refresh);
+    },
+        onError: (Object e) => _disconnect(e),
+        onDone: () => _disconnect(null),
+        cancelOnError: true);
+  }
+
+  void _disconnect(Object? error) {
+    if (!active) return;
+    streamDown = true;
+    if (error != null && _unauthorized(error)) {
+      _clear();
+      denied = true;
+      loading = false;
+    }
+    notifyListeners();
+    _retry?.cancel();
+    _retry = Timer(const Duration(seconds: 2), _listen);
+  }
+
+  Future<void> refresh() async {
+    if (!active) return;
+    if (_reading) {
+      _again = true;
+      return;
+    }
+    _reading = true;
+    final scope = _scope;
+    try {
+      final result = await api.snapshot();
+      if (!active || scope != _scope) return;
+      final source = result['sections'] as Map;
+      final fresh = <String, TodaySection>{};
+      for (final key in sections.keys) {
+        if (source[key] is TodayJson) {
+          final section = TodaySection(key, source[key]);
+          if (section.counts.isNotEmpty) fresh[key] = section;
+        }
+      }
+      final stamp = result['as_of'] as int;
+      visible = fresh;
+      asOf = stamp;
+      offline = false;
+      denied = false;
+      final selected = filter;
+      if (selected != null) {
+        if (!permits(selected)) {
+          _resetDetail();
+        } else {
+          unawaited(open(selected, offset: detailOffset));
+        }
+      }
+    } catch (e) {
+      if (!active || scope != _scope) return;
+      if (_unauthorized(e)) {
+        _clear();
+        denied = true;
+      } else {
+        offline = true;
+      }
+    } finally {
+      _reading = false;
+      if (active) {
+        if (scope == _scope || denied) loading = false;
+        notifyListeners();
+        if (_again) {
+          _again = false;
+          scheduleMicrotask(refresh);
+        }
+      }
+    }
+  }
+
+  Future<void> open(String name, {int offset = 0}) async {
+    if (!active || !permits(name) || offset < 0) return;
+    final request = ++_drill, scope = _scope;
+    filter = name;
+    detailOffset = offset;
+    detailLoading = true;
+    detailFailed = false;
+    rows = [];
+    nextOffset = null;
+    detailAsOf = null;
+    detailQuality = 'unknown';
+    notifyListeners();
+    bool same() =>
+        active && request == _drill && scope == _scope && permits(name);
+    try {
+      final result = await api.list(name, offset);
+      if (!same()) return;
+      final page = List<TodayJson>.from(result['rows']);
+      final next = result['next_offset'] as int?;
+      if (result['filter'] != name ||
+          page.length > 25 ||
+          (next != null && next <= offset) ||
+          !const {'live', 'partial', 'stale', 'unknown'}
+              .contains(result['freshness'])) {
+        throw const FormatException('Invalid dashboard page');
+      }
+      rows = page;
+      nextOffset = next;
+      detailAsOf = result['as_of'] as int?;
+      detailQuality = result['freshness'];
+    } catch (e) {
+      if (!same()) return;
+      if (_unauthorized(e)) {
+        _clear();
+        loading = true;
+        unawaited(refresh());
+      } else {
+        detailFailed = true;
+      }
+    } finally {
+      if (active && request == _drill) {
+        detailLoading = false;
+        notifyListeners();
+      } else if (active) {
+        notifyListeners();
+      }
+    }
+  }
+
+  @override
+  void dispose() {
+    _retired = true;
+    _clear();
+    _feed?.cancel();
+    _retry?.cancel();
+    _poll?.cancel();
+    _coalesce?.cancel();
+    api.close();
+    super.dispose();
+  }
+}
