--- /dev/null
+++ b/src/steaddesk_merchant_logs.rs
@@ -0,0 +1,198 @@
+//! Fixed merchant diagnostics operations, linked only into the Android merchant.
+use hbb_common::config::Config;
+use jni::{
+    objects::{JClass, JString},
+    sys::{jint, jlong, jstring},
+    JNIEnv,
+};
+use serde_derive::Deserialize;
+use serde_json::{json, Value};
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+const IDENTITY: &str = "/ops/v1/device/update-identity";
+const JOB: &str = "/ops/v1/device/merchant-log-job";
+const RESULT: &str = "/ops/v1/device/merchant-log-result";
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Page {
+    job_id: String,
+    credential: String,
+    entries: Vec<Entry>,
+    index: u32,
+    total: u32,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Entry {
+    source: String,
+    event: String,
+}
+
+fn operation(op: i32, version: u64, body: &Value) -> Option<(&'static str, &'static str)> {
+    match op {
+        0 if version == 0 && body == &json!({}) => Some(("GET", IDENTITY)),
+        1 if version > 0 && body == &json!({}) => Some(("GET", JOB)),
+        2 if version > 0 => {
+            let p: Page = serde_json::from_value(body.clone()).ok()?;
+            if p.job_id.len() != 28
+                || !p.job_id.starts_with("t_")
+                || !p.job_id.as_bytes()[2..]
+                    .iter()
+                    .all(|b| b"0123456789ABCDEFGHJKMNPQRSTVWXYZ".contains(b))
+                || p.credential.len() != 64
+                || !p
+                    .credential
+                    .bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+                || p.total == 0
+                || p.total > 128
+                || p.index >= p.total
+                || p.entries.is_empty()
+                || serde_json::to_vec(body.get("entries")?).ok()?.len() > 32768
+            {
+                return None;
+            }
+            for row in p.entries {
+                if !matches!(
+                    row.source.as_str(),
+                    "merchant_self_heal" | "merchant_upgrade" | "merchant_boot"
+                ) || !matches!(
+                    row.event.as_str(),
+                    "healthy"
+                        | "in_session"
+                        | "reserved"
+                        | "acknowledged"
+                        | "failed"
+                        | "unavailable"
+                        | "skipped"
+                        | "denied"
+                        | "rate_limited"
+                        | "disabled"
+                        | "unknown"
+                        | "info"
+                        | "warn"
+                        | "truncated"
+                ) {
+                    return None;
+                }
+            }
+            Some(("POST", RESULT))
+        }
+        _ => None,
+    }
+}
+
+fn scope() -> Option<String> {
+    let id = Config::get_id_or(String::new());
+    if !(9..=10).contains(&id.len()) || !id.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    let origin = reqwest::Url::parse(&Config::get_option("api-server")).ok()?;
+    if origin.scheme() != "https"
+        || origin.host().is_none()
+        || !origin.username().is_empty()
+        || origin.password().is_some()
+        || origin.path() != "/"
+        || origin.query().is_some()
+        || origin.fragment().is_some()
+    {
+        return None;
+    }
+    let conns = crate::server::AUTHED_CONNS.lock().ok()?;
+    let conn = conns
+        .iter()
+        .find(|c| c.conn_type == crate::server::AuthConnType::Remote)?;
+    serde_json::to_string(&json!({"origin":origin.origin().ascii_serialization(),"device":id,"connection":conn.conn_id})).ok()
+}
