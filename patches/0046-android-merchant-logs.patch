+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn signs_only_two_empty_queries_and_bounded_finite_pages() {
+        let mut p = json!({"job_id":format!("t_{}", "0".repeat(26)), "credential":"a".repeat(64),
+            "index":0,"total":1, "entries":[{"source":"merchant_boot","event":"skipped"}]});
+        assert_eq!(operation(0, 0, &json!({})), Some(("GET", IDENTITY)));
+        assert_eq!(operation(1, 1, &json!({})), Some(("GET", JOB)));
+        assert_eq!(operation(2, 1, &p), Some(("POST", RESULT)));
+        for (key, value) in [
+            ("extra", json!(0)),
+            ("credential", json!("secret")),
+            ("total", json!(129)),
+            ("index", json!(1)),
+            ("entries", json!([])),
+        ] {
+            let mut bad = p.clone();
+            bad[key] = value;
+            assert!(operation(2, 1, &bad).is_none());
+        }
+        p["entries"][0]["password"] = json!("fixture-secret");
+        assert!(operation(2, 1, &p).is_none());
+        assert!(operation(1, 0, &json!({})).is_none());
+        assert!(operation(0, 0, &p).is_none());
+    }
+}
