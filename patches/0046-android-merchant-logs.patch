+++ b/flutter/android/app/src/steaddeskMerchant/java/com/carriez/flutter_hbb/MerchantLogs.java
@@ -0,0 +1,127 @@
+package com.carriez.flutter_hbb;
+
+import android.content.Context;
+import android.content.RestrictionsManager;
+import android.os.Bundle;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.Proxy;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Iterator;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+import javax.net.ssl.HttpsURLConnection;
+
+/** One active request. The device never receives an origin, token, filename or job from Binder. */
+final class MerchantLogs {
+    private static final AtomicBoolean busy = new AtomicBoolean();
+    private static native String snapshot();
+    private static native String proof(String scope, int operation, long version, String body);
+    private static final String[] PATH = {"/ops/v1/device/update-identity", "/ops/v1/device/merchant-log-job",
+            "/ops/v1/device/merchant-log-result"};
+
+    static boolean enabled(Context context) {
+        try {
+            RestrictionsManager manager = (RestrictionsManager)context.getSystemService(Context.RESTRICTIONS_SERVICE);
+            Bundle policy = manager == null ? null : manager.getApplicationRestrictions();
+            return policy != null && policy.getBoolean("STEADDESK_MERCHANT_LOGS", false);
+        } catch (RuntimeException unknown) { return false; }
+    }
+
+    static int collect(Context context) {
+        Context app = context.getApplicationContext();
+        if (!enabled(app) || MerchantRecovery.status(app) != 2) return 0;
+        String scope = snapshot();
+        if (scope == null || !busy.compareAndSet(false, true)) return 0;
+        try {
+            new Thread(() -> {
+                try { upload(app, scope); }
+                catch (Exception failure) { /* Ops finalizes the Agent-only result on timeout. */ }
+                finally { busy.set(false); }
+            }, "Merchant diagnostics").start();
+        } catch (RuntimeException failure) {
+            busy.set(false);
+            return 0;
+        }
+        return 1;
+    }
+
+    private static void requireCurrent(Context app, String scope) throws IOException {
+        if (!enabled(app) || MerchantRecovery.status(app) != 2 || !scope.equals(snapshot()))
+            throw new IOException("diagnostic session ended");
+    }
+
+    private static JSONObject request(Context app, String scope, int op, long version, JSONObject body) throws Exception {
+        requireCurrent(app, scope);
+        String raw = body.toString();
+        String signed = proof(scope, op, version, raw);
+        if (signed == null) throw new IOException("device identity unavailable");
+        JSONObject headers = new JSONObject(signed);
+        URL url = new URL(new JSONObject(scope).getString("origin") + PATH[op]);
+        HttpsURLConnection http = (HttpsURLConnection)url.openConnection(Proxy.NO_PROXY);
+        try {
+            http.setInstanceFollowRedirects(false);
+            http.setUseCaches(false);
+            http.setConnectTimeout(5000);
+            http.setReadTimeout(5000);
+            http.setRequestMethod(op == 2 ? "POST" : "GET");
+            for (Iterator<String> names = headers.keys(); names.hasNext();) {
+                String name = names.next();
+                http.setRequestProperty(name, headers.getString(name));
+            }
+            if (op == 2) {
+                byte[] payload = raw.getBytes(StandardCharsets.UTF_8);
+                http.setDoOutput(true);
+                http.setFixedLengthStreamingMode(payload.length);
+                http.setRequestProperty("Content-Type", "application/json");
+                try (OutputStream out = http.getOutputStream()) {
+                    requireCurrent(app, scope);
+                    out.write(payload);
+                }
+            }
+            if (http.getResponseCode() != 200) throw new IOException("request rejected");
+            try (InputStream in = http.getInputStream()) {
+                ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+                byte[] buffer = new byte[1024];
+                int count;
+                while ((count = in.read(buffer)) != -1) {
+                    if (bytes.size() + count > 4096) throw new IOException("invalid response");
+                    bytes.write(buffer, 0, count);
+                }
+                return new JSONObject(bytes.toString("UTF-8"));
+            }
+        } finally { http.disconnect(); }
+    }
+
+    private static void upload(Context app, String scope) throws Exception {
+        long version = request(app, scope, 0, 0, new JSONObject()).getLong("key_version");
+        if (version <= 0) return;
+        JSONObject job = null;
+        for (int i = 0; i < 12; i++) {
+            job = request(app, scope, 1, version, new JSONObject());
+            if (!job.isNull("job_id")) break;
+            // Agent confirmation reaches ops independently of this HTTPS connection.
+            if (i < 11) Thread.sleep(500);
+        }
+        if (job == null || job.isNull("job_id")) return;
+        String id = job.getString("job_id"), credential = job.getString("credential");
+        long expires = job.getLong("expires_at");
+        if (!id.matches("t_[0-9A-HJKMNP-TV-Z]{26}") || !credential.matches("[0-9a-f]{64}") ||
+            System.currentTimeMillis() / 1000 >= expires) return;
+        requireCurrent(app, scope);
+        List<JSONArray> pages = MerchantLogRecords.collect(app);
+        for (int i = 0; i < pages.size(); i++) {
+            if (System.currentTimeMillis() / 1000 >= expires) return;
+            JSONObject page = new JSONObject().put("credential", credential).put("entries", pages.get(i))
+                    .put("index", i).put("job_id", id).put("total", pages.size());
+            JSONObject ack = request(app, scope, 2, version, page);
+            if (!Boolean.TRUE.equals(ack.opt("accepted")) ||
+                    !Boolean.valueOf(i + 1 == pages.size()).equals(ack.opt("complete"))) return;
+        }
+    }
+}
