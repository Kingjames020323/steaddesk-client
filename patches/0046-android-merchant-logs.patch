index 0000000..cba95db
--- /dev/null
+++ b/flutter/android/app/src/steaddeskMerchant/java/com/carriez/flutter_hbb/MerchantLogRecords.java
@@ -0,0 +1,151 @@
+package com.carriez.flutter_hbb;
+
+import android.content.Context;
+import android.util.AtomicFile;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Project fixed private journals into finite event codes before constructing any network request. */
+final class MerchantLogRecords {
+    private static final int INPUT_PER_SOURCE = 512 * 1024;
+    // Three 320 KiB sources and the Agent's at most 16,384 short ASCII records fit in 2 MiB.
+    private static final int OUTPUT_PER_SOURCE = 320 * 1024;
+    private static final String HEAL = "merchant_self_heal", UPDATE = "merchant_upgrade", BOOT = "merchant_boot";
+
+    private static File bootFile(Context app) {
+        return new File(app.getNoBackupFilesDir(), "boot-recovery.jsonl");
+    }
+
+    static synchronized void recordBoot(Context app, String event) {
+        if (!MerchantLogs.enabled(app)) return;
+        AtomicFile journal = new AtomicFile(bootFile(app));
+        FileOutputStream out = null;
+        try {
+            byte[] prior = new byte[0];
+            if (journal.getBaseFile().length() <= 8192) {
+                try { prior = journal.readFully(); } catch (java.io.FileNotFoundException firstBoot) { }
+            }
+            String[] lines = new String(prior, StandardCharsets.UTF_8).split("\n");
+            out = journal.startWrite();
+            for (int i = Math.max(0, lines.length - 127); i < lines.length; i++) {
+                String old = project(BOOT, lines[i]);
+                if (old != null) out.write(bootLine(old));
+            }
+            out.write(bootLine(event));
+            journal.finishWrite(out);
+        } catch (IOException | JSONException | RuntimeException failure) {
+            if (out != null) journal.failWrite(out);
+        }
+    }
+
+    private static byte[] bootLine(String event) throws JSONException {
+        return (new JSONObject().put("event", event).toString() + "\n").getBytes(StandardCharsets.UTF_8);
+    }
+
+    static String project(String source, String line) {
+        if (line.length() > 2048 || !line.startsWith("{") || !line.endsWith("}")) return null;
+        try {
+            JSONObject row = new JSONObject(line);
+            if (HEAL.equals(source)) {
+                String result = row.optString("result");
+                switch (result) {
+                    case "healthy": case "in_session": case "reserved": case "acknowledged":
+                    case "failed": case "unavailable": case "skipped": case "denied":
+                    case "rate_limited": case "disabled": case "unknown": return result;
+                    case "budget_unavailable": return "unavailable";
+                    case "recorded": return "info";
+                    default: return null;
+                }
+            }
+            String event = row.optString("event");
+            if (BOOT.equals(source)) {
+                switch (event) {
+                    case "acknowledged": case "skipped": case "failed": case "disabled": case "denied": return event;
+                    default: return null;
+                }
+            }
+            if (!UPDATE.equals(source)) return null;
+            String reason = row.optString("reason");
+            switch (event) {
+                case "manifest": case "artifact": return "verified".equals(reason) ? "healthy" : null;
+                case "committing": return "reserved".equals(reason) ? "reserved" : null;
+                case "assignment": return "none".equals(reason) ? "skipped" : null;
+                case "submitted": return "os_pending".equals(reason) ? "info" : null;
+                case "stopped": return "failed";
+                case "offer": case "installer": case "report": case "health": case "recovery":
+                    switch (reason) {
+                        case "os_success": case "accepted": case "installed": return "acknowledged";
+                        case "server_observation_complete": case "healthy": return "healthy";
+                        case "manual_required": case "pending_user_action": case "frozen": return "warn";
+                        case "failed": case "service_unverified": return "failed";
+                        case "duplicate_or_stale": return "skipped";
+                        case "declined": return "denied";
+                        case "session_absent": case "session_present": case "observing": return "info";
+                        default: return null;
+                    }
+                default: return null;
+            }
+        } catch (JSONException invalid) { return null; }
+    }
+
+    private final List<JSONArray> pages = new ArrayList<>();
+    private int pageBytes = 2;
+
+    private int add(String source, String event) throws JSONException {
+        JSONObject row = new JSONObject().put("source", source).put("event", event);
+        int bytes = row.toString().length() + 1;
+        if (pages.isEmpty() || pageBytes + bytes > 32768) {
+            pages.add(new JSONArray());
+            pageBytes = 2;
+        }
+        pages.get(pages.size() - 1).put(row);
+        pageBytes += bytes;
+        return bytes;
+    }
+
+    private void read(File file, String source) throws JSONException {
+        int written = 0;
+        boolean cut = false;
+        try (RandomAccessFile input = new RandomAccessFile(file, "r")) {
+            long length = input.length(), offset = Math.max(0, length - INPUT_PER_SOURCE);
+            byte[] bytes = new byte[(int)(length - offset)];
+            input.seek(offset);
+            input.readFully(bytes);
+            int start = 0;
+            if (offset != 0) {
+                cut = true;
+                while (start < bytes.length && bytes[start++] != '\n') { }
+            }
+            for (int end = start; end < bytes.length; end++) {
+                if (bytes[end] != '\n') continue;
+                if (end - start <= 2048) {
+                    String event = project(source, new String(bytes, start, end - start, StandardCharsets.UTF_8));
+                    if (event != null) written += add(source, event);
+                } else {
+                    cut = true;
+                }
+                start = end + 1;
+                if (written >= OUTPUT_PER_SOURCE - 128) break;
+            }
+            cut |= start < bytes.length;
+        } catch (IOException | SecurityException inaccessible) { }
+        if (written == 0) add(source, "unavailable");
+        if (cut) add(source, "truncated");
+    }
+
+    static List<JSONArray> collect(Context app) throws JSONException {
+        MerchantLogRecords records = new MerchantLogRecords();
+        records.read(new File(app.getFilesDir(), "self-heal.jsonl"), HEAL);
+        records.read(new File(app.getNoBackupFilesDir(), "fleet-update/events.jsonl"), UPDATE);
+        records.read(bootFile(app), BOOT);
+        return records.pages;
+    }
+}
