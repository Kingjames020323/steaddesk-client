diff --git a/flutter/android/app/src/steaddeskMerchant/java/com/carriez/flutter_hbb/MerchantLogRecords.java b/flutter/android/app/src/steaddeskMerchant/java/com/carriez/flutter_hbb/MerchantLogRecords.java
