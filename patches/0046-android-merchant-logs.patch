+#[no_mangle]
+pub extern "system" fn Java_com_carriez_flutter_1hbb_MerchantLogs_proof(
+    mut env: JNIEnv,
+    _: JClass,
+    expected: JString,
+    op: jint,
+    version: jlong,
+    raw: JString,
+) -> jstring {
+    catch_unwind(AssertUnwindSafe(|| {
+        if version < 0
+            || env.call_method(&raw, "length", "()I", &[]).ok()?.i().ok()? > 34000
+            || env
+                .call_method(&expected, "length", "()I", &[])
+                .ok()?
+                .i()
+                .ok()?
+                > 2048
+        {
+            return None;
+        }
+        let expected: String = env.get_string(&expected).ok()?.into();
+        if scope()? != expected {
+            return None;
+        }
+        let context: Value = serde_json::from_str(&expected).ok()?;
+        let device = context.get("device")?.as_str()?;
+        let raw: String = env.get_string(&raw).ok()?.into();
+        let body: Value = serde_json::from_str(&raw).ok()?;
+        let (method, path) = operation(op, version as u64, &body)?;
+        let proof =
+            super::steaddesk_device_signature::sign(device, version as u64, |id, ts, nonce| {
+                let mut bytes = b"SteadDesk-fleet-v1\0".to_vec();
+                bytes.extend(
+                    serde_json::to_vec(&(method, path, body, id, version, ts, nonce)).ok()?,
+                );
+                Some(bytes)
+            })?;
+        Some(
+            env.new_string(std::str::from_utf8(&proof).ok()?)
+                .ok()?
+                .into_raw(),
+        )
+    }))
+    .ok()
+    .flatten()
+    .unwrap_or(std::ptr::null_mut())
+}
