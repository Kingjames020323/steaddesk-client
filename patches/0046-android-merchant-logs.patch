+#[no_mangle]
+pub extern "system" fn Java_com_carriez_flutter_1hbb_MerchantLogs_snapshot(
+    env: JNIEnv,
+    _: JClass,
+) -> jstring {
+    catch_unwind(AssertUnwindSafe(|| {
+        Some(env.new_string(scope()?).ok()?.into_raw())
+    }))
+    .ok()
+    .flatten()
+    .unwrap_or(std::ptr::null_mut())
+}
