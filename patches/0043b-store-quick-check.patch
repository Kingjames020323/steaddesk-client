+
+const supportQuickEnabled = true;
+Widget storeInventory(HealthStore store, String device) =>
+    _StoreView(store, device,
+        key: ValueKey((store, device, store.scopeRevision)));
+Widget merchantReport(HealthStore store, String device) =>
+    _LatestReport(store, device,
+        key: ValueKey((store, device, store.scopeRevision)));
+
+class _StoreView extends StatefulWidget {
+  final HealthStore store;
+  final String device;
+  const _StoreView(this.store, this.device, {super.key});
+  @override
+  State<_StoreView> createState() => _StoreViewState();
+}
+
+class _StoreViewState extends State<_StoreView> {
+  List<Json> entries = [];
+  Json policy = {};
+  bool busy = true;
+  String? error;
+  String get path => 'devices/${widget.device}';
+  bool get current =>
+      mounted &&
+      widget.store.active &&
+      widget.store.devices.containsKey(widget.device);
+  bool get editable => current && policy['can_edit'] == true && !busy;
+  @override
+  void initState() {
+    super.initState();
+    load();
+  }
+
+  Future<void> load() async {
+    if (!mounted) return;
+    setState(() {
+      busy = true;
+      error = null;
+      policy = {};
+      entries = [];
+    });
+    try {
+      final data = await Future.wait([
+        widget.store.resource('GET', '$path/check-policy'),
+        widget.store.resource('GET', '$path/inventory')
+      ]);
+      if (current) {
+        setState(() {
+          entries = inventoryEntries(data[1]['entries']);
+          policy = data[0];
+        });
+      }
+    } catch (e) {
+      if (mounted) {
+        setState(
+            () => error = e is FormatException ? '设备清单格式不正确。' : e.toString());
+      }
+    } finally {
+      if (mounted) setState(() => busy = false);
+    }
+  }
+
+  Future<void> write(String method, String route, Json body) async {
+    if (!editable) return;
+    setState(() {
+      busy = true;
+      error = null;
+    });
+    try {
+      await widget.store.resource(method, route, body);
+    } catch (e) {
+      if (mounted) {
+        await load();
+        if (mounted) setState(() => error = e.toString());
+      }
+      return;
+    }
+    if (current) await load();
+  }
+
+  Future<void> edit([Json? row]) async {
+    if (!editable) return;
+    final value = await showDialog<Json>(
+        context: context, builder: (_) => _Editor(row, entries));
+    if (value != null && editable) {
+      await write(
+          row == null ? 'POST' : 'PATCH',
+          row == null ? '$path/inventory' : '$path/inventory/${row['id']}',
+          value);
+    }
+  }
+
+  Future<void> remove(Json row) async {
+    if (!editable) return;
+    final yes = await showDialog<bool>(
+        context: context,
+        builder: (ctx) => AlertDialog(
+                title: const Text('删除设备'),
+                content: Text('从本店移除「${row['name']}」？'),
+                actions: [
+                  TextButton(
+                      onPressed: () => Navigator.pop(ctx),
+                      child: const Text('取消')),
+                  TextButton(
+                      onPressed: () => Navigator.pop(ctx, true),
+                      child: const Text('删除'))
+                ]));
