diff --git a/flutter/lib/steaddesk/quick/check.dart b/flutter/lib/steaddesk/quick/check.dart
new file mode 100644
index 0000000..f3c9101
--- /dev/null
+++ b/flutter/lib/steaddesk/quick/check.dart
@@ -0,0 +1,328 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+typedef Json = Map<String, dynamic>;
+typedef CheckScope = ({Uri origin, String device, String binding});
+typedef CheckOutcome = ({String outcome, int? latency});
+typedef CheckCall = Future<Json> Function(CheckScope, String, int, Json);
+const typeLabels = {
+  'printer': '打印机',
+  'host': '主机',
+  'secondary': '副机',
+  'payment': '支付设备',
+  'other': '其他'
+};
+const outcomeLabels = {
+  'reachable': 'Reachable',
+  'unreachable': 'Unreachable',
+  'timeout': 'Check timed out',
+  'unknown': 'Check unavailable'
+};
+
+bool privateV4(String address) {
+  final parts = address.split('.');
+  if (parts.length != 4) return false;
+  final bytes = <int>[];
+  for (final part in parts) {
+    final n = int.tryParse(part);
+    if (n == null || n < 0 || n > 255 || n.toString() != part) return false;
+    bytes.add(n);
+  }
+  return bytes[0] == 10 ||
+      bytes[0] == 172 && bytes[1] >= 16 && bytes[1] <= 31 ||
+      bytes[0] == 192 && bytes[1] == 168;
+}
+
+bool validId(Object? value) =>
+    value is String &&
+    value.isNotEmpty &&
+    value.length <= 128 &&
+    !RegExp(r'[^A-Za-z0-9_-]').hasMatch(value);
+
+List<Json> inventoryEntries(dynamic raw) {
+  if (raw is! List || raw.length > 32) throw const FormatException('设备表无效');
+  final ips = <String>{}, ids = <String>{};
+  return raw.map((row) {
+    if (row is! Json ||
+        !validId(row['id']) ||
+        !ids.add(row['id']) ||
+        row['ip'] is! String ||
+        !privateV4(row['ip']) ||
+        !ips.add(row['ip'])) {
+      throw const FormatException('设备地址或编号无效、重复');
+    }
+    for (final field in ['name', 'type', 'model']) {
+      final value = row[field];
+      if (value is! String ||
+          value.runes.length > 64 ||
+          (field != 'model' && value.trim().isEmpty) ||
+          RegExp(r'[\x00-\x1f\x7f]').hasMatch(value)) {
+        throw const FormatException('设备字段无效');
+      }
+    }
+    return {
+      for (final k in ['id', 'name', 'type', 'ip', 'model']) k: row[k]
+    };
+  }).toList();
+}
+
+class CheckFailure implements Exception {
+  final String message;
+  final int status;
+  const CheckFailure(this.message, [this.status = 0]);
+  @override
+  String toString() => message;
+}
+
+// Only the main merchant panel owns this journal. Persist the rate reservation
+// before the first probe, and persist the exact unsigned report before POST.
+class MerchantChecks {
+  final File journal;
+  final Future<CheckScope> Function() scope;
+  final CheckCall call;
+  final Future<CheckOutcome> Function(Json) probe;
+  final int Function() clock;
+  final int Function() rateClock;
+  MerchantChecks(this.journal, this.scope, this.call, this.probe,
+      {int Function()? clock})
+      : clock = clock ?? (() => DateTime.now().millisecondsSinceEpoch ~/ 1000),
+        rateClock = clock == null
+            ? (() => DateTime.now().millisecondsSinceEpoch)
+            : (() => clock() * 1000);
+
+  bool usedCache = false;
+  String delivery = 'Check report pending upload.';
+  static final _busy = <String>{};
+  Future<T> _withState<T>(
+      Future<T> Function(CheckScope, Json) operation) async {
+    final path = journal.absolute.path;
+    if (!_busy.add(path)) {
+      throw const CheckFailure(
+          'A quick check is in progress. Try again shortly.');
+    }
+    RandomAccessFile? lock;
+    try {
+      await journal.parent.create(recursive: true);
+      lock = await File('$path.lock').open(mode: FileMode.append);
+      await lock.lock(FileLock.exclusive);
+      final owner = await scope();
+      Json state = {};
+      if (await journal.exists()) {
+        if (await journal.length() > 512 * 1024) {
+          throw const CheckFailure('Check cache is invalid.');
+        }
+        state = jsonDecode(await journal.readAsString()) as Json;
+      }
+      if (state['origin'] != owner.origin.origin ||
+          state['device'] != owner.device ||
+          state['binding'] != owner.binding) {
+        final last = state['origin'] == owner.origin.origin &&
+                state['device'] == owner.device
+            ? state['last']
+            : null;
+        state = {
+          if (last is int) 'last': last,
+          'origin': owner.origin.origin,
+          'device': owner.device,
+          'binding': owner.binding,
+          'pending': []
+        };
+        await _save(state);
+      }
+      return await operation(owner, state);
+    } finally {
+      try {
+        await lock?.close();
+      } finally {
+        _busy.remove(path);
+      }
+    }
+  }
+
+  Future<void> _save(Json state) async {
+    final temp = File('${journal.path}.next');
+    await temp.writeAsString(jsonEncode(state), flush: true);
+    await temp.rename(journal.path);
+  }
+
+  Future<void> _same(CheckScope owner) async {
+    if (owner != await scope()) {
+      throw const CheckFailure(
+          'The device identity changed. Start a new check.');
+    }
+  }
+
+  Future<Json> _call(CheckScope owner, String op, int v, Json body) async {
+    await _same(owner);
+    final answer = await call(owner, op, v, body);
+    await _same(owner);
+    return answer;
+  }
+
+  Json _snapshot(dynamic data, CheckScope owner, {bool fresh = false}) {
+    final now = clock();
+    if (data is! Json ||
+        data['device_id'] != owner.device ||
+        !validId(data['store_id']) ||
+        data['allowed'] != true ||
+        data['expires_at'] is! int ||
+        data['expires_at'] <= now ||
+        data['expires_at'] > now + (fresh ? 930 : 900) ||
+        data['revision'] is! String ||
+        (data['revision'] as String).length != 64 ||
+        RegExp(r'[^a-f0-9]').hasMatch(data['revision'])) {
+      throw const CheckFailure(
+          'Store approval is missing or the offline inventory expired.');
+    }
+    return {
+      ...data,
+      'expires_at': (data['expires_at'] as int).clamp(now + 1, now + 900),
+      'entries': inventoryEntries(data['entries'])
+    };
+  }
+
+  Future<bool> _refresh(CheckScope owner, Json state) async {
+    try {
+      final identity = await _call(owner, 'identity', 0, {});
+      final version = identity['key_version'];
+      if (version is! int || version <= 0) {
+        throw const FormatException('设备身份无效');
+      }
+      if (state['version'] != null && state['version'] != version) {
+        state.remove('inventory');
+        state['pending'] = [];
+        await _save(state);
+      }
+      final data = await _call(owner, 'inventory', version, {});
+      if (data['allowed'] == false && data['device_id'] == owner.device) {
+        state.remove('inventory');
+        state['pending'] = [];
+      } else {
+        final inventory = _snapshot(data, owner, fresh: true);
+        if (state['version'] != version ||
+            state['store'] != inventory['store_id']) {
+          state['pending'] = [];
+        }
+        state['store'] = inventory['store_id'];
+        state['version'] = version;
+        state['inventory'] = inventory;
+      }
+      await _save(state);
+      return true;
+    } on SocketException {
+      return false;
+    } on TimeoutException {
+      return false;
+    } catch (e) {
+      state.remove('inventory');
+      if (e is CheckFailure && [401, 403, 404].contains(e.status)) {
+        state['pending'] = [];
+      }
+      await _save(state);
+      rethrow;
+    }
+  }
+
+  Future<void> _flush(CheckScope owner, Json state, [Json? current]) async {
+    final pending = state['pending'] as List;
+    while (pending.isNotEmpty) {
+      final body = pending.first as Json;
+      if (clock() - (body['observed_at'] as int) <= 86400) {
+        try {
+          final response =
+              await _call(owner, 'report', state['version'] as int, body);
+          if (response['state'] != 'completed' || !validId(response['id'])) {
+            throw const CheckFailure('Check receipt is invalid.');
+          }
+          if (identical(body, current)) delivery = 'Check report uploaded.';
+        } on SocketException {
+          return;
+        } on TimeoutException {
+          return;
+        } on CheckFailure catch (e) {
+          if (e.status == 400) {
+            delivery = 'The server declined the check report.';
+            return;
+          } else if ([409, 422].contains(e.status)) {
+            if (identical(body, current)) {
+              delivery = 'The server declined the check report.';
+            }
+          } else if (e.status == 429 || e.status >= 500) {
+            return;
+          } else {
+            if ([401, 403, 404].contains(e.status)) {
+              state.remove('inventory');
+              state['pending'] = [];
+              await _save(state);
+            }
+            rethrow;
+          }
+        }
+      }
+      pending.removeAt(0);
+      await _save(state);
+    }
+  }
+
+  Future<void> sync() => _withState((owner, state) async {
+        if (await _refresh(owner, state) && state['inventory'] != null) {
+          await _flush(owner, state);
+        }
+      });
+
+  Future<List<Json>> run() => _withState((owner, state) async {
+        final last = state['last'] as int?;
+        if (last != null && rateClock() - last < 60000) {
+          throw const CheckFailure('Wait one minute between quick checks.');
+        }
+        final online = await _refresh(owner, state);
+        usedCache = !online;
+        delivery = 'Check report pending upload.';
+        final inventory = _snapshot(state['inventory'], owner);
+        if ((inventory['entries'] as List).isEmpty) {
+          throw const CheckFailure('No registered devices at this store.');
+        }
+        if (online) await _flush(owner, state);
+        final pending = state['pending'] as List;
+        if (pending.length >= 32) {
+          throw const CheckFailure(
+              'Pending reports are full. Reconnect before checking again.');
+        }
+        final started = clock();
+        state['last'] = rateClock();
+        await _save(state);
+        final rows = <Json>[], results = <Json>[];
+        for (final entry in inventory['entries'] as List<Json>) {
+          await _same(owner);
+          if (clock() >= inventory['expires_at']) {
+            throw const CheckFailure(
+                'Check approval expired. Reconnect to refresh it.');
+          }
+          final r = await probe(entry);
+          results.add({
+            'id': entry['id'],
+            'outcome': r.outcome,
+            'latency_ms': r.latency
+          });
+          rows.add({...entry, 'outcome': r.outcome, 'latency_ms': r.latency});
+        }
+        await _same(owner);
+        final report = {
+          'revision': inventory['revision'],
+          'observed_at': started,
+          'results': results
+        };
+        pending.add(report);
+        await _save(state);
+        if (online) {
+          try {
+            await _flush(owner, state, report);
+          } on CheckFailure {
+            delivery = 'The server declined the check report.';
+          }
+        }
+        await _same(owner);
+        return rows;
+      });
+}
diff --git a/flutter/lib/steaddesk/quick/http.dart b/flutter/lib/steaddesk/quick/http.dart
new file mode 100644
index 0000000..00e5b9a
--- /dev/null
+++ b/flutter/lib/steaddesk/quick/http.dart
@@ -0,0 +1,57 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'check.dart';
+
+Future<Json> signedQuickCall(CheckScope scope, String op, int version,
+    Json body, Map<String, String> Function(String, int, Json) sign) async {
+  if (scope.origin.scheme != 'https' ||
+      scope.origin.host.isEmpty ||
+      scope.origin.userInfo.isNotEmpty ||
+      scope.origin.hasQuery ||
+      scope.origin.hasFragment ||
+      !{'', '/'}.contains(scope.origin.path)) {
+    throw const CheckFailure('Invalid check origin.');
+  }
+  final route = switch (op) {
+    'identity' => 'update-identity',
+    'inventory' => 'check-inventory',
+    'report' => 'check-reports',
+    _ => throw StateError('Unknown check operation')
+  };
+  final headers = sign(op, version, body);
+  final client = HttpClient()
+    ..connectionTimeout = const Duration(seconds: 4)
+    ..findProxy = (_) => 'DIRECT';
+  Future<Json> send() async {
+    final req = await client.openUrl(op == 'report' ? 'POST' : 'GET',
+        scope.origin.resolve('/ops/v1/device/$route'));
+    req.followRedirects = false;
+    headers.forEach((k, v) => req.headers.set(k, v));
+    if (op == 'report') {
+      req.headers.contentType = ContentType.json;
+      final bytes = utf8.encode(jsonEncode(body));
+      req.contentLength = bytes.length;
+      req.add(bytes);
+    }
+    final res = await req.close();
+    if (res.statusCode != 200) {
+      throw CheckFailure(
+          'The server declined the check request.', res.statusCode);
+    }
+    final bytes = <int>[];
+    await for (final chunk in res) {
+      if (bytes.length + chunk.length > 65536) {
+        throw const FormatException('响应过大');
+      }
+      bytes.addAll(chunk);
+    }
+    return jsonDecode(utf8.decode(bytes)) as Json;
+  }
+
+  try {
+    return await send().timeout(const Duration(seconds: 8));
+  } finally {
+    client.close(force: true);
+  }
+}
diff --git a/flutter/lib/steaddesk/quick/merchant.dart b/flutter/lib/steaddesk/quick/merchant.dart
new file mode 100644
index 0000000..f08b081
--- /dev/null
+++ b/flutter/lib/steaddesk/quick/merchant.dart
@@ -0,0 +1,157 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:flutter/material.dart';
+import 'package:path_provider/path_provider.dart';
+import '../../models/native_model.dart' show PlatformFFI;
+import '../../models/platform_model.dart' show bind;
+import '../help/merchant_help_client.dart' show configuredHelpOrigin;
+import 'check.dart';
+import 'probe.dart';
+import 'http.dart';
+import '../../common.dart' show translate;
+
+const merchantQuickEnabled = true;
+Widget merchantQuickEntry() => const _MerchantQuick();
+
+Future<CheckScope> _scope() async {
+  final origin =
+      configuredHelpOrigin(await bind.mainGetOption(key: 'api-server'));
+  final device = await bind.mainGetMyId();
+  if (!validId(device)) {
+    throw const CheckFailure('The device identity is not configured.');
+  }
+  final signer = PlatformFFI.instance.helpSigner;
+  if (signer == null) {
+    throw const CheckFailure('Device signing is unavailable.');
+  }
+  return (origin: origin, device: device, binding: signer.quickCheckBinding());
+}
+
+Future<Json> _signedCall(CheckScope scope, String op, int version, Json body) {
+  final signer = PlatformFFI.instance.helpSigner;
+  if (signer == null) {
+    throw const CheckFailure('Device signing is unavailable.');
+  }
+  return signedQuickCall(scope, op, version, body, signer.signQuickCheck);
+}
+
+class _MerchantQuick extends StatefulWidget {
+  const _MerchantQuick();
+  @override
+  State<_MerchantQuick> createState() => _MerchantQuickState();
+}
+
+class _MerchantQuickState extends State<_MerchantQuick>
+    with WidgetsBindingObserver {
+  MerchantChecks? client;
+  Timer? retry;
+  String? notice;
+  bool busy = false;
+  Future<void>? refreshing;
+  List<Json> rows = [];
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    initialize();
+  }
+
+  Future<void> initialize() async {
+    try {
+      final dir = await getApplicationSupportDirectory();
+      if (!mounted) return;
+      setState(() => client = MerchantChecks(
+          File('${dir.path}/quick-check.json'),
+          _scope,
+          _signedCall,
+          checkRegisteredDevice));
+      await sync();
+      if (mounted) {
+        retry = Timer.periodic(const Duration(minutes: 1), (_) => sync());
+      }
+    } catch (_) {
+      if (mounted) setState(() => notice = 'Device storage is unavailable.');
+    }
+  }
+
+  Future<void> sync() async {
+    if (busy || client == null || refreshing != null) return;
+    try {
+      refreshing = client!.sync();
+      await refreshing;
+    } catch (_) {/* A click shows the current failure. */} finally {
+      refreshing = null;
+    }
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) sync();
+  }
+
+  @override
+  void dispose() {
+    retry?.cancel();
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  Future<void> run() async {
+    if (busy || client == null) return;
+    setState(() {
+      busy = true;
+      notice = null;
+      rows = [];
+    });
+    try {
+      try {
+        await refreshing;
+      } catch (_) {}
+      if (!mounted) return;
+      final found = await client!.run();
+      if (mounted) {
+        setState(() {
+          rows = found;
+          notice = client!.delivery;
+        });
+      }
+    } catch (e) {
+      if (mounted) {
+        setState(() => notice = e is CheckFailure
+            ? e.message
+            : 'Cannot check now. Verify the device configuration and try again.');
+      }
+    } finally {
+      if (mounted) setState(() => busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) =>
+      Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+        TextButton.icon(
+            onPressed: busy || client == null ? null : run,
+            icon: const Icon(Icons.network_check),
+            label: Text(translate(
+                busy ? 'Checking registered devices…' : 'Quick check'))),
+        if (rows.isNotEmpty && client?.usedCache == true)
+          Text(translate('Using the offline store inventory.')),
+        if (notice != null) Text(translate(notice!)),
+        if (rows.any((r) => r['type'] == 'payment'))
+          Text(translate('Payment devices use ping only.')),
+        for (final row in rows)
+          Text(
+              "${row['name']} · ${translate(outcomeLabels[row['outcome']] ?? 'Check unavailable')} · ${row['latency_ms'] == null ? '—' : "${row['latency_ms']} ms"}"),
+        if (rows.any(
+            (r) => r['outcome'] == 'unreachable' || r['outcome'] == 'timeout'))
+          Text(translate(rows.any((r) =>
+                  r['type'] == 'printer' &&
+                  ['unreachable', 'timeout'].contains(r['outcome']))
+              ? 'Printer unreachable. Check its power and network cable.'
+              : 'Device unreachable. Check its power and network connection.')),
+        if (rows.any((r) => r['outcome'] == 'unknown'))
+          Text(translate(
+              'Some checks were unavailable. Check network permissions.')),
+      ]);
+}
