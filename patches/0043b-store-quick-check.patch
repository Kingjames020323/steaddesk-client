+                            tooltip: '删除设备',
+                            onPressed: () => remove(row),
+                            icon: const Icon(Icons.delete_outline))
+                      ])),
+        ],
+        Align(
+            alignment: Alignment.centerLeft,
+            child: TextButton(
+                onPressed: busy ? null : load, child: const Text('刷新设备表'))),
+      ]);
+}
+
+class _Editor extends StatefulWidget {
+  final Json? row;
+  final List<Json> entries;
+  const _Editor(this.row, this.entries);
+  @override
+  State<_Editor> createState() => _EditorState();
+}
+
+class _EditorState extends State<_Editor> {
+  final form = GlobalKey<FormState>();
+  late final values = {
+    for (final k in ['name', 'ip', 'model']) k: widget.row?[k] as String? ?? ''
+  };
+  late String type = typeLabels.containsKey(widget.row?['type'])
+      ? widget.row!['type'] as String
+      : 'other';
+  @override
+  Widget build(BuildContext context) => AlertDialog(
+          title: Text(widget.row == null ? '新增设备' : '编辑设备'),
+          content: SingleChildScrollView(
+              child: Form(
+                  key: form,
+                  child: Column(mainAxisSize: MainAxisSize.min, children: [
+                    for (final field in ['name', 'ip', 'model'])
+                      TextFormField(
+                          initialValue: values[field],
+                          maxLength: field == 'ip' ? 15 : 64,
+                          decoration: InputDecoration(
+                              labelText: const {
+                            'name': '名称',
+                            'ip': '私有 IPv4 地址',
+                            'model': '型号'
+                          }[field]),
+                          onChanged: (v) => values[field] = v.trim(),
+                          validator: (text) {
+                            final s = (text ?? '').trim();
+                            if (field == 'name' && s.isEmpty) return '请输入设备名称';
+                            if (field != 'ip') {
+                              return RegExp(r'[\x00-\x1f\x7f]').hasMatch(s)
+                                  ? '请输入可显示字符'
+                                  : null;
+                            }
+                            if (!privateV4(s)) return '请输入规范的私有 IPv4 地址';
+                            if (widget.entries.any((e) =>
+                                e['ip'] == s && e['id'] != widget.row?['id'])) {
+                              return '本店已登记此 IP';
+                            }
+                            return null;
+                          }),
+                    DropdownButtonFormField<String>(
+                        value: type,
+                        decoration: const InputDecoration(labelText: '类型'),
+                        items: [
+                          for (final entry in typeLabels.entries)
+                            DropdownMenuItem(
+                                value: entry.key, child: Text(entry.value))
+                        ],
+                        onChanged: (v) {
+                          if (v != null) setState(() => type = v);
+                        }),
+                  ]))),
+          actions: [
+            TextButton(
+                onPressed: () => Navigator.pop(context),
+                child: const Text('取消')),
+            TextButton(
+                onPressed: () {
+                  if (form.currentState!.validate()) {
+                    Navigator.pop(context, {...values, 'type': type});
+                  }
+                },
+                child: const Text('保存')),
+          ]);
+}
+
+class _LatestReport extends StatefulWidget {
+  final HealthStore store;
+  final String device;
+  const _LatestReport(this.store, this.device, {super.key});
+  @override
+  State<_LatestReport> createState() => _LatestReportState();
+}
+
+class _LatestReportState extends State<_LatestReport> {
+  bool busy = false, loaded = false;
+  Json? latest;
+  String? error;
+  Future<void> read() async {
+    if (busy) return;
+    setState(() {
+      busy = true;
+      error = null;
+      latest = null;
+    });
+    try {
+      final data =
+          await widget.store.resource('GET', 'devices/${widget.device}/health');
+      final reports = data['merchant_checks'] as List;
+      if (mounted && widget.store.active) {
+        setState(() {
+          latest = reports.isEmpty ? null : reports.first as Json;
+          loaded = true;
+        });
+      }
+    } catch (e) {
+      if (mounted) setState(() => error = e.toString());
+    } finally {
+      if (mounted) setState(() => busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) =>
+      Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+        TextButton(
+            onPressed: busy ? null : read,
+            child: Text(busy ? '读取中…' : '最近商户快速检查')),
+        if (error != null) Text(error!),
+        if (loaded && !busy && latest == null && error == null)
+          const Text('暂无商户上报'),
+        if (latest != null) ...[
+          Text(DateTime.fromMillisecondsSinceEpoch(
+                  (latest!['observed_at'] as int) * 1000)
+              .toLocal()
+              .toString()
+              .split('.')
+              .first),
+          for (final row in latest!['results'] as List)
+            Text("${row['name']} · ${row['ip']} · ${const {
+                  'reachable': '通',
+                  'unreachable': '不通',
+                  'timeout': '超时',
+                  'unknown': '未知'
+                }[row['outcome']] ?? '未知'} · ${row['latency_ms'] == null ? '—' : "${row['latency_ms']} ms"}"),
+        ],
+      ]);
+}
