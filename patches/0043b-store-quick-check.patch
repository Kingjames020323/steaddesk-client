+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/quick/check.dart';
+import 'package:flutter_hbb/steaddesk/quick/probe.dart';
+
+void main() {
+  final printer = {
+    'id': 'i_a',
+    'name': 'Demo printer',
+    'type': 'printer',
+    'model': 'Sample',
+    'ip': '192.168.20.10'
+  };
+  final payment = {
+    'id': 'i_b',
+    'name': 'Demo terminal',
+    'type': 'payment',
+    'model': 'Sample',
+    'ip': '10.3.2.1'
+  };
+  test('only canonical RFC1918 unicast literals and unique inventory addresses',
+      () {
+    for (final ip in [
+      '10.0.0.1',
+      '172.16.0.1',
+      '172.31.255.2',
+      '192.168.0.1'
+    ]) {
+      expect(privateV4(ip), isTrue);
+    }
+    for (final ip in [
+      '127.0.0.1',
+      '8.8.8.8',
+      '172.32.0.1',
+      '10.01.2.3',
+      '10.0.1.4/24',
+      '10.0.1.4:631',
+      '10.0.1.4\n',
+      '10.0.1.256',
+      '192.168.a.1',
+      'demo.invalid'
+    ]) {
+      expect(privateV4(ip), isFalse, reason: ip);
+    }
+    expect(
+        () => inventoryEntries([
+              printer,
+              {...payment, 'ip': printer['ip']}
+            ]),
+        throwsFormatException);
+  });
+  test(
+      'Windows echo needs the target TTL; system and permission failures remain unknown',
+      () {
+    const ip = '10.0.0.1';
+    expect(
+        pingOutcome(
+            ip, 0, 'Reply from 10.0.0.2: Destination host unreachable.', '',
+            windows: true),
+        'unreachable');
+    expect(
+        pingOutcome(ip, 0, 'Reply from 10.0.0.10: bytes=32 TTL=64', '',
+            windows: true),
+        'unknown');
+    expect(
+        pingOutcome(ip, 0, '来自 10.0.0.1 的回复: 字节=32 TTL=64', '', windows: true),
+        'reachable');
+    expect(
+        pingOutcome(ip, 1, 'Reply from 10.0.0.1: General failure.', '',
+            windows: true),
+        'unknown');
+    expect(pingOutcome(ip, 1, '', 'Operation not permitted', windows: false),
+        'unknown');
+  });
+  test(
+      'registered printer fallback uses only fixed ports, payment and unknown kinds never connect',
+      () async {
+    final ports = <int>[];
+    Future<String> connect(String ip, int port) async {
+      ports.add(port);
+      return 'unreachable';
+    }
+
+    Future<String> ping(String ip) async => 'unreachable';
+    await checkRegisteredDevice(printer, ping: ping, connect: connect);
+    expect(ports, [9100, 515, 631]);
+    ports.clear();
+    for (final kind in [
+      'payment',
+      'unclassified',
+      'host',
+      'other',
+      'secondary'
+    ]) {
+      await checkRegisteredDevice({...payment, 'type': kind},
+          ping: ping, connect: connect);
+    }
+    expect(ports, isEmpty);
+  });
+  test(
+      'cached approved inventory works offline, limits across restarts, flushes when online, and revocation clears it',
+      () async {
+    final dir = await Directory.systemTemp.createTemp('quick-check-');
+    addTearDown(() => dir.delete(recursive: true));
+    var binding = 'demo-key-one';
+    CheckScope scope() => (
+          origin: Uri.parse('https://example.invalid'),
+          device: '123456789',
+          binding: binding
+        );
+    int now = 1800000000, probes = 0;
+    bool online = true, allowed = true;
+    final reports = <Json>[];
+    MerchantChecks open() =>
+        MerchantChecks(File('${dir.path}/journal'), () async => scope(),
+            (s, op, version, body) async {
+          if (!online) throw const SocketException('offline fixture');
+          if (op == 'identity') return {'key_version': 2};
+          if (op == 'inventory')
+            return {
+              'device_id': s.device,
+              'store_id': 'g_demo',
+              'allowed': allowed,
+              'expires_at': now + 902,
+              'revision': 'a' * 64,
+              'entries': allowed ? [printer, payment] : []
+            };
+          reports.add(body);
+          return {'id': 'r_demo', 'state': 'completed'};
+        }, (row) async {
+          probes++;
+          return (outcome: 'reachable', latency: 2);
+        }, clock: () => now);
+    await open().sync();
+    expect(probes, 0);
+    online = false;
+    final result = await open().run();
+    expect(result.map((r) => r['name']), ['Demo printer', 'Demo terminal']);
+    expect(probes, 2);
+    await expectLater(open().run(), throwsA(isA<CheckFailure>()));
+    expect(probes, 2);
+    online = true;
+    await open().sync();
+    expect(reports.single['results'], [
+      {'id': 'i_a', 'outcome': 'reachable', 'latency_ms': 2},
+      {'id': 'i_b', 'outcome': 'reachable', 'latency_ms': 2}
+    ]);
+    now += 60;
+    allowed = false;
+    await open().sync();
+    online = false;
+    await expectLater(open().run(), throwsA(isA<CheckFailure>()));
+    expect(probes, 2);
+    allowed = true;
+    online = true;
+    await open().sync();
+    online = false;
+    binding = 'demo-key-two';
+    await expectLater(open().run(), throwsA(isA<CheckFailure>()));
+    expect(probes, 2);
+  });
+}
diff --git a/flutter/test/steaddesk/quick_support_test.dart b/flutter/test/steaddesk/quick_support_test.dart
new file mode 100644
index 0000000..fbf8c6d
--- /dev/null
+++ b/flutter/test/steaddesk/quick_support_test.dart
@@ -0,0 +1,112 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/ops_health.dart';
+import 'package:flutter_hbb/steaddesk/quick/support.dart';
+import 'package:flutter_hbb/steaddesk/quick/check.dart';
+
+class _Fixture implements HealthApi {
+  bool admin = false, enabled = false;
+  List<Json> rows = [
+    {
+      'id': 'i_1',
+      'name': 'Demo printer',
+      'type': 'printer',
+      'ip': '192.168.2.5',
+      'model': 'Demo'
+    }
+  ];
+  final writes = <String>[];
+  @override
+  Future<Json> request(String method, String route, [Json? body]) async {
+    if (method != 'GET') writes.add(method);
+    if (route.endsWith('/check-policy')) {
+      if (method == 'PUT') enabled = body!['enabled'];
+      return {
+        'enabled': enabled,
+        'deployment_allowed': true,
+        'allowed': enabled,
+        'can_edit': admin,
+        'store_id': 'demo'
+      };
+    }
+    if (route.endsWith('/health'))
+      return {
+        'merchant_checks': [
+          {
+            'observed_at': 1800000000,
+            'results': [
+              {
+                'name': 'Demo printer',
+                'ip': '192.168.2.5',
+                'outcome': 'reachable',
+                'latency_ms': 8
+              }
+            ]
+          }
+        ]
+      };
+    if (method == 'POST') rows.add({'id': 'i_2', ...body!});
+    if (method == 'PATCH') rows[1].addAll(body!);
+    if (method == 'DELETE') rows.removeLast();
+    return {'entries': rows};
+  }
+
+  @override
+  Stream<String> changes() => const Stream.empty();
+  @override
+  void close() {}
+}
+
+void main() {
+  testWidgets(
+      'server viewer can read inventory and last report; only admin can edit policy and inventory',
+      (t) async {
+    final api = _Fixture();
+    final store = HealthStore(api, isCurrent: () => true);
+    store.devices = {
+      '123': DeviceHealth.from(
+          {'device_id': '123', 'status': 'normal', 'reasons': []})
+    };
+    Future<void> show(Widget child) async {
+      await t.pumpWidget(MaterialApp(home: Scaffold(body: child)));
+      await t.pumpAndSettle();
+    }
+
+    await show(storeInventory(store, '123'));
+    expect(find.text('Demo printer'), findsOneWidget);
+    expect(find.text('新增设备'), findsNothing);
+    expect(t.widget<SwitchListTile>(find.byType(SwitchListTile)).onChanged,
+        isNull);
+    await show(merchantReport(store, '123'));
+    await t.tap(find.text('最近商户快速检查'));
+    await t.pumpAndSettle();
+    expect(find.textContaining('8 ms'), findsOneWidget);
+    api.admin = true;
+    await show(storeInventory(store, '123'));
+    await t.tap(find.byType(SwitchListTile));
+    await t.pumpAndSettle();
+    await t.tap(find.text('新增设备'));
+    await t.pumpAndSettle();
+    await t.enterText(find.byType(TextFormField).at(0), 'Demo host');
+    await t.enterText(find.byType(TextFormField).at(1), '192.168.2.5');
+    await t.tap(find.text('保存'));
+    await t.pumpAndSettle();
+    expect(find.text('本店已登记此 IP'), findsOneWidget);
+    await t.enterText(find.byType(TextFormField).at(1), '192.168.2.6');
+    await t.tap(find.text('保存'));
+    await t.pumpAndSettle();
+    expect(find.text('Demo host'), findsOneWidget);
+    await t.tap(find.byTooltip('编辑设备').last);
+    await t.pumpAndSettle();
+    await t.enterText(find.byType(TextFormField).at(0), 'Demo edited');
+    await t.tap(find.text('保存'));
+    await t.pumpAndSettle();
+    expect(find.text('Demo edited'), findsOneWidget);
+    await t.tap(find.byTooltip('删除设备').last);
+    await t.pumpAndSettle();
+    await t.tap(find.widgetWithText(TextButton, '删除'));
+    await t.pumpAndSettle();
+    expect(find.text('Demo edited'), findsNothing);
+    expect(api.writes, ['PUT', 'POST', 'PATCH', 'DELETE']);
+  });
+}
