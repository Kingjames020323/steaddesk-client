diff --git a/flutter/lib/steaddesk/quick/probe.dart b/flutter/lib/steaddesk/quick/probe.dart
new file mode 100644
index 0000000..c59d86b
--- /dev/null
+++ b/flutter/lib/steaddesk/quick/probe.dart
@@ -0,0 +1,108 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'check.dart';
+
+Future<String> _ping(String ip) async {
+  late String binary;
+  late List<String> args;
+  if (Platform.isAndroid) {
+    binary = '/system/bin/ping';
+    args = ['-n', '-c', '1', '-W', '1', ip];
+  } else if (Platform.isWindows) {
+    final root = Platform.environment['SystemRoot'];
+    if (root == null || !RegExp(r'^[A-Za-z]:\\').hasMatch(root)) {
+      return 'unknown';
+    }
+    binary = '$root\\System32\\PING.EXE';
+    args = ['-4', '-n', '1', '-w', '1000', ip];
+  } else {
+    return 'unknown';
+  }
+  Process? process;
+  try {
+    process = await Process.start(binary, args, runInShell: false);
+    final stdout = process.stdout.expand((b) => b).toList();
+    final stderr = process.stderr.expand((b) => b).toList();
+    final status = await process.exitCode.timeout(const Duration(seconds: 3));
+    final out = systemEncoding.decode(await stdout);
+    final err = systemEncoding.decode(await stderr);
+    return pingOutcome(ip, status, out, err, windows: Platform.isWindows);
+  } on TimeoutException {
+    return 'timeout';
+  } on IOException {
+    return 'unknown';
+  } finally {
+    process?.kill();
+  }
+}
+
+String pingOutcome(String ip, int status, String stdout, String stderr,
+    {required bool windows}) {
+  final out = stdout.toLowerCase();
+  if (stderr.trim().isNotEmpty ||
+      out.contains('permission denied') ||
+      out.contains('operation not permitted')) return 'unknown';
+  if (!windows) {
+    return switch (status) {
+      0 => 'reachable',
+      1 => 'unreachable',
+      _ => 'unknown'
+    };
+  }
+  // A Windows router ICMP error may yield exit code zero. Require the original
+  // target address and an echo TTL on the same reply line.
+  final peer = RegExp('(?:^|[^0-9.])${RegExp.escape(ip)}(?:[^0-9.]|\$)');
+  if (status == 0 &&
+      out.split('\n').any((line) =>
+          peer.hasMatch(line) && RegExp(r'\bttl\s*=').hasMatch(line))) {
+    return 'reachable';
+  }
+  if (RegExp(r'destination (host|net|network) unreachable|inaccesible|无法访问目标')
+      .hasMatch(out)) return 'unreachable';
+  if (RegExp(r'request timed out|tiempo de espera agotado|请求超时')
+      .hasMatch(out)) {
+    return 'timeout';
+  }
+  return 'unknown';
+}
+
+Future<String> _connect(String ip, int port) async {
+  try {
+    final socket = await Socket.connect(InternetAddress(ip), port,
+        timeout: const Duration(seconds: 1));
+    socket.destroy();
+    return 'reachable';
+  } on SocketException catch (e) {
+    final n = e.osError?.errorCode;
+    if ([13, 1, 10013].contains(n)) return 'unknown';
+    if ([110, 10060].contains(n)) return 'timeout';
+    if ([101, 111, 113, 10051, 10061, 10065].contains(n)) return 'unreachable';
+    return 'unknown';
+  }
+}
+
+Future<CheckOutcome> checkRegisteredDevice(Json row,
+    {Future<String> Function(String) ping = _ping,
+    Future<String> Function(String, int) connect = _connect}) async {
+  final ip = row['ip'];
+  if (ip is! String || !privateV4(ip)) throw const FormatException('无效地址');
+  final elapsed = Stopwatch()..start();
+  var outcome = await ping(ip);
+  if (row['type'] == 'printer' && outcome != 'reachable') {
+    final observed = {outcome};
+    for (final port in const [9100, 515, 631]) {
+      final result = await connect(ip, port);
+      observed.add(result);
+      if (result == 'reachable') break;
+    }
+    outcome = ['reachable', 'unknown', 'timeout', 'unreachable']
+        .firstWhere(observed.contains);
+  }
+  return (
+    outcome: outcome,
+    latency: outcome == 'unknown'
+        ? null
+        : elapsed.elapsedMilliseconds.clamp(0, 60000).toInt()
+  );
+}
