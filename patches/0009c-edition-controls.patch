diff --git a/flutter/lib/steaddesk/incoming_switch.dart b/flutter/lib/steaddesk/incoming_switch.dart
new file mode 100644
--- /dev/null
+++ b/flutter/lib/steaddesk/incoming_switch.dart
@@ -0,0 +1,41 @@
+import 'package:flutter/material.dart';
+import '../common.dart';
+import '../models/platform_model.dart';
+
+class SupportIncomingSwitch extends StatefulWidget {
+  const SupportIncomingSwitch({super.key});
+  @override
+  State<SupportIncomingSwitch> createState() => _SupportIncomingSwitchState();
+}
+
+class _SupportIncomingSwitchState extends State<SupportIncomingSwitch> {
+  static const keyName = 'allow-support-incoming';
+  bool? allowed;
+
+  @override
+  void initState() {
+    super.initState();
+    _read();
+  }
+
+  Future<void> _read() async {
+    final value = await bind.mainGetOption(key: keyName);
+    if (mounted) setState(() => allowed = value == 'Y');
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return SwitchListTile(
+      title: Text(translate('Allow incoming connections')),
+      value: allowed ?? false,
+      onChanged: allowed == null ? null : (value) async {
+        setState(() => allowed = null);
+        try {
+          await bind.mainSetOption(key: keyName, value: value ? 'Y' : '');
+        } finally {
+          await _read();
+        }
+      },
+    );
+  }
+}
