+def fleet_payload_digest(table, exe):
+    # Hash the bytes already selected for data.bin, even if the input file changes later.
+    if normalize(exe) != "steaddesk.exe":
+        raise ValueError("Fleet package must contain the merchant service executable")
+    matches = [packed for name, (packed, _) in table.items() if normalize(name) == normalize(exe)]
+    if len(matches) != 1:
+        raise ValueError("Missing or ambiguous fleet service executable")
+    return sha256(brotli.decompress(matches[0])).hexdigest()
+
