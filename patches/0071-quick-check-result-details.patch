+      : super(
+            File('unused-test-journal'),
+            () => throw UnimplementedError(),
+            (_, __, ___, ____) => throw UnimplementedError(),
+            (_) => throw UnimplementedError());
+
+  Future<DateTime?> Function() fetch;
+  int reads = 0;
+
+  @override
+  Future<void> sync() async {
+    reads++;
+    approvedUntil = await fetch();
+  }
+
+  @override
+  Future<List<Json>> run() async {
+    await sync();
+    if (approvedUntil == null) throw const CheckFailure('unavailable');
+    return [];
+  }
+}
+
+void main() {
+  Future<void> mount(WidgetTester t, _Checks checks) async {
+    t.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+    await t.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: MerchantQuickEntry(
+      open: () async => checks,
+      label: (s) => s,
+    ))));
+    await t.pump();
+  }
+
+  for (final mode in ['denied', 'offline', 'unreadable']) {
+    testWidgets('$mode hides the entry and never schedules a one-minute retry',
+        (t) async {
+      final checks = _Checks(() async {
+        if (mode == 'offline') throw const SocketException('fixture');
+        if (mode == 'unreadable') throw const FormatException('fixture');
+        return null;
+      });
+      await mount(t, checks);
+      expect(find.text('Quick check'), findsNothing);
+      for (var i = 0; i < 3; i++) {
+        await t.pump(const Duration(minutes: 1));
+      }
+      expect(checks.reads, 1);
+      await t.pumpWidget(const SizedBox.shrink());
+    });
+  }
+
+  testWidgets(
+      'only the latest foreground approval shows the entry; losing inventory on click hides it',
+      (t) async {
+    final first = Completer<DateTime?>();
+    final checks = _Checks(() => first.future);
+    await mount(t, checks);
+    expect(find.text('Quick check'), findsNothing);
+    t.binding.handleAppLifecycleStateChanged(AppLifecycleState.paused);
+    first.complete(DateTime.now().add(const Duration(minutes: 15)));
+    await t.pump();
+    expect(find.text('Quick check'), findsNothing);
+    final second = Completer<DateTime?>();
+    checks.fetch = () => second.future;
+    t.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);
+    await t.pump();
+    expect(find.text('Quick check'), findsNothing);
+    second.complete(DateTime.now().add(const Duration(minutes: 15)));
+    await t.pumpAndSettle();
+    expect(find.text('Quick check'), findsOneWidget);
+    checks.fetch = () async => null;
+    await t.tap(find.text('Quick check'));
+    await t.pumpAndSettle();
+    expect(find.text('Quick check'), findsNothing);
+    await t.pump(const Duration(minutes: 16));
+    expect(checks.reads, 3);
+    await t.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets(
+      'an approved lease renews once at expiry and a denied renewal stays idle',
+      (t) async {
+    final checks =
+        _Checks(() async => DateTime.now().add(const Duration(minutes: 5)));
+    await mount(t, checks);
+    expect(find.text('Quick check'), findsOneWidget);
+    await t.pump(const Duration(minutes: 1));
+    expect(checks.reads, 1);
+    checks.fetch = () async => null;
+    await t.pump(const Duration(minutes: 5));
+    await t.pump();
+    expect(find.text('Quick check'), findsNothing);
+    await t.pump(const Duration(minutes: 10));
+    expect(checks.reads, 2);
+    await t.pumpWidget(const SizedBox.shrink());
+  });
+}
