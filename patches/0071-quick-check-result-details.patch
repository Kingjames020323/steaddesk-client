diff --git a/flutter/lib/steaddesk/quick/support_detail.dart b/flutter/lib/steaddesk/quick/support_detail.dart
new file mode 100644
index 0000000..43aaf69
--- /dev/null
+++ b/flutter/lib/steaddesk/quick/support_detail.dart
@@ -0,0 +1,275 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import '../ops_health.dart';
+import 'check.dart' show Json, printerPorts, typeLabels;
+import 'result_line.dart';
+
+enum SupportCheckSource { merchant, agent, session }
+
+extension on SupportCheckSource {
+  String get label =>
+      this == SupportCheckSource.merchant ? '商户（经商户端）' : '客服（经 Agent）';
+}
+
+Iterable<Json> _rows(Object? value) =>
+    value is List ? value.whereType<Json>() : const <Json>[];
+
+bool _sameTarget(Json a, Json b) =>
+    a['ip'] is String &&
+    a['ip'] == b['ip'] &&
+    a['name'] is String &&
+    a['name'] == b['name'] &&
+    (a['id'] == null || b['id'] == null || a['id'] == b['id']) &&
+    (a['inventory_id'] == null ||
+        b['inventory_id'] == null ||
+        a['inventory_id'] == b['inventory_id']);
+
+String _time(Object? value) => value is int
+    ? DateTime.fromMillisecondsSinceEpoch(value * 1000)
+        .toLocal()
+        .toString()
+        .split('.')
+        .first
+    : '未上报';
+
+typedef _HistoryItem = ({int at, String source, String status});
+
+class _CheckDetail {
+  final Json row, report;
+  final Json? inventory;
+  final List<_HistoryItem> history;
+  const _CheckDetail(this.row, this.report, this.inventory, this.history);
+}
+
+Future<_CheckDetail> _load({
+  required String device,
+  required SupportCheckSource source,
+  required Json selected,
+  required String reportId,
+  required Future<Json> Function(String) read,
+  String? sessionPath,
+}) async {
+  final base = 'devices/$device';
+  final data = await Future.wait([
+    read('$base/inventory'),
+    read('$base/health'),
+    if (source == SupportCheckSource.agent) read('$base/checks/$reportId'),
+    if (source == SupportCheckSource.session) read(sessionPath!),
+  ]);
+  final merchants = _rows(data[1]['merchant_checks']);
+  final session = source == SupportCheckSource.session
+      ? _rows(data[2]['actions']).where((r) => r['action'] == 'quick_check')
+      : const <Json>[];
+  final reports = switch (source) {
+    SupportCheckSource.agent => [data[2]],
+    SupportCheckSource.session => session,
+    SupportCheckSource.merchant => merchants,
+  };
+  final report = reports.where((r) => r['id'] == reportId).firstOrNull;
+  final row = _rows(report?['results'])
+      .where((r) => _sameTarget(r, selected))
+      .firstOrNull;
+  if (report == null || row == null) throw const HealthFailure(404);
+  final indexed = data[0]['check_history'];
+  final entry = _rows(data[0]['entries']).where((e) {
+    if (row['inventory_id'] != null) return e['id'] == row['inventory_id'];
+    if (indexed is! Map) return _sameTarget(e, row);
+    // Old public Agent rows can be tied to the dispatched registration by
+    // their indexed report and target, even after the entry is renamed.
+    return _rows(indexed[e['id']]).any((h) =>
+        h['id'] == reportId &&
+        h['source'] == source.name &&
+        h['ip'] == row['ip'] &&
+        h['name'] == row['name']);
+  }).firstOrNull;
+
+  final history = <_HistoryItem>[];
+  final seen = <(SupportCheckSource, String)>{};
+  void collect(Iterable<Json> reports, SupportCheckSource origin) {
+    for (final previous in reports) {
+      final id = previous['id'];
+      if (id is! String ||
+          (source == origin && id == reportId) ||
+          !seen.add((origin, id))) continue;
+      final at = previous[
+          origin == SupportCheckSource.merchant ? 'observed_at' : 'created_at'];
+      final target = _rows(previous['results'])
+          .where((r) => _sameTarget(r, row))
+          .firstOrNull;
+      if (at is int && target != null) {
+        history.add((
+          at: at,
+          source: origin.label,
+          status: supportCheckLabels[target['outcome']] ?? '未知'
+        ));
+      }
+    }
+  }
+
+  if (indexed is Map) {
+    for (final item in _rows(indexed[entry?['id']])) {
+      final origin = switch (item['source']) {
+        'merchant' => SupportCheckSource.merchant,
+        'agent' => SupportCheckSource.agent,
+        _ => null,
+      };
+      final id = item['id'], at = item['observed_at'];
+      if (origin == null ||
+          id is! String ||
+          at is! int ||
+          !seen.add((origin, id))) continue;
+      history.add((
+        at: at,
+        source: origin.label,
+        status: supportCheckLabels[item['outcome']] ?? '未知'
+      ));
+    }
+  } else {
+    collect(merchants, SupportCheckSource.merchant);
+    collect(session, SupportCheckSource.session);
+  }
+  history.sort((a, b) => b.at.compareTo(a.at));
+  return _CheckDetail(row, report, entry, history.take(10).toList());
+}
+
+void showStoreCheckDetails(
+    BuildContext context,
+    HealthStore store,
+    String device,
+    SupportCheckSource source,
+    Json row,
+    Json report,
+    bool Function() visible) {
+  final revision = store.scopeRevision;
+  showSupportCheckDetails(context,
+      device: device,
+      source: source,
+      selected: row,
+      reportId: report['id'],
+      read: (path) => store.resource('GET', path),
+      scopeChanges: store,
+      current: () =>
+          visible() &&
+          store.active &&
+          store.scopeRevision == revision &&
+          store.devices.containsKey(device) &&
+          (store.storeFeatures == null ||
+              (source == SupportCheckSource.merchant
+                      ? store.quickPeers
+                      : store.healthPeers)
+                  .contains(device)));
+}
+
+Future<void> showSupportCheckDetails(
+  BuildContext context, {
+  required String device,
+  required SupportCheckSource source,
+  required Json selected,
+  required Object? reportId,
+  required bool Function() current,
+  required Future<Json> Function(String) read,
+  Listenable? scopeChanges,
+  String? sessionPath,
+}) async {
+  if (!current() || reportId is! String) return;
+  late final DialogRoute<void> dialog;
+  void guard() {
+    final route = dialog;
+    if (!current() && route.isActive) {
+      scheduleMicrotask(() {
+        if (route.isActive) route.navigator?.removeRoute(route);
+      });
+    }
+  }
+
+  scopeChanges?.addListener(guard);
+  final timer =
+      Timer.periodic(const Duration(milliseconds: 500), (_) => guard());
+  try {
+    Future<_CheckDetail>? load;
+    dialog = DialogRoute<void>(
+        context: context,
+        builder: (ctx) {
+          return FutureBuilder<_CheckDetail>(
+              future: load ??= _load(
+                  device: device,
+                  source: source,
+                  selected: selected,
+                  reportId: reportId,
+                  read: read,
+                  sessionPath: sessionPath),
+              builder: (_, snapshot) {
+                if (!current()) {
+                  guard();
+                  return const SizedBox.shrink();
+                }
+                final detail = snapshot.data;
+                return AlertDialog(
+                    title: const Text('快速检查详情'),
+                    content: detail != null
+                        ? _Content(detail, source)
+                        : snapshot.hasError
+                            ? const Text('无法读取本次检查详情。')
+                            : const LinearProgressIndicator(),
+                    actions: [
+                      TextButton(
+                          onPressed: () => Navigator.pop(ctx),
+                          child: const Text('关闭'))
+                    ]);
+              });
+        });
+    Navigator.of(context, rootNavigator: true).push(dialog);
+    await dialog.completed;
+  } finally {
+    timer.cancel();
+    scopeChanges?.removeListener(guard);
+  }
+}
+
+class _Content extends StatelessWidget {
+  final _CheckDetail detail;
+  final SupportCheckSource source;
+  const _Content(this.detail, this.source);
+
+  @override
+  Widget build(BuildContext context) {
+    final row = detail.row, entry = detail.inventory;
+    final ports = row['ports'];
+    String probeLabel(Object? value) =>
+        value == 'not_attempted' ? '未尝试' : supportCheckLabels[value] ?? '未上报';
+    final type = entry?['type'];
+    final noPing = entry == null
+        ? '未知'
+        : entry['no_ping'] == true
+            ? '是'
+            : '否';
+    return SingleChildScrollView(
+        child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+          Text("${row['name']} · ${row['ip']}"),
+          Text("当前登记类型：${typeLabels[type] ?? type ?? '未知'}"),
+          Text('当前登记不回应 ping：$noPing'),
+          Text("本次结果：${supportCheckLabels[row['outcome']] ?? '未知'}"),
+          Text(
+              "检查总耗时：${row['latency_ms'] == null ? '未上报' : "${row['latency_ms']} ms"}"),
+          Text("Ping 结果：${probeLabel(row['ping_outcome'])}"),
+          Text(
+              "Ping 耗时：${row['ping_ms'] is int ? "${row['ping_ms']} ms" : '未上报'}"),
+          for (final port in printerPorts)
+            Text('$port：${probeLabel(ports is Map ? ports['$port'] : null)}'),
+          Text(
+              "检查时间：${_time(row['observed_at'] ?? detail.report['observed_at'])}"),
+          if (source == SupportCheckSource.session)
+            Text("发起时间：${_time(detail.report['created_at'])}"),
+          Text('发起方：${source.label}'),
+          if (detail.history.isNotEmpty) ...[
+            const Text('最近 10 次检查'),
+            for (final item in detail.history)
+              Text('${_time(item.at)} · ${item.source} · ${item.status}'),
+          ],
+        ]));
+  }
+}
