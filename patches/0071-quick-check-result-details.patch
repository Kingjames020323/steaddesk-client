+
+String _localized(_Copy copy, String locale) {
+  return switch (locale.toLowerCase().split(RegExp('[-_]')).first) {
+    'zh' => copy.zh,
+    'es' => copy.es,
+    _ => copy.en,
+  };
+}
+
+String merchantCheckAdvice(String type, String outcome, String locale) {
+  final copy = switch (outcome) {
+    'reachable' || 'undetectable' => _meaning[outcome]!,
+    'timeout' || 'unreachable' => _meaning[type] ?? _meaning['other']!,
+    _ => _meaning['unknown']!,
+  };
+  return _localized(copy, locale);
+}
+
+Future<void> showMerchantCheckDetail(BuildContext context, Map row,
