+import 'dart:io';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/help/merchant_help_widget.dart';
+import 'package:flutter_hbb/steaddesk/help/merchant_help_client.dart';
+import 'package:flutter_hbb/steaddesk/quick/step_link.dart';
+import 'package:flutter_hbb/steaddesk/quick/merchant_detail.dart';
+import 'package:flutter_hbb/steaddesk/quick/result_line.dart';
+
+class _HelpClient extends MerchantHelpClient {
+  _HelpClient()
+      : super(
+            File('unused-fixture'),
+            () async => scopeValue,
+            (category, message, digest, secret) => throw UnimplementedError(),
+            'fixture');
+  static final scopeValue =
+      (origin: Uri.https('fixture.invalid'), device: 'fixture', account: '');
+  @override
+  Future<void> initialize() async {
+    record = {
+      'owner': fingerprint(scopeValue),
+      'quick_check_category': 'printer'
+    };
+    view = {
+      'id': 'fixture-help',
+      'state': 'queued',
+      'version': 1,
+      'queued_at': 1
+    };
+    cards = [
+      {
+        'card_id': 'p',
+        'card_version': 1,
+        'steps': ['Reseat the printer cable.']
+      }
+    ];
+  }
+
+  @override
+  Future<void> refresh() async {}
+
+  @override
+  Future<HelpScope> owner() async => scopeValue;
+}
+
+void main() {
+  testWidgets('opens the matching live help offer and ignores stale links',
+      (t) async {
+    final key = GlobalKey(), client = _HelpClient();
+    await t.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: SingleChildScrollView(
+      child: MerchantHelpEntry(
+          key: key,
+          open: () async => client,
+          label: (s) => s,
+          pick: () async => null),
+    ))));
+    await t.pumpAndSettle();
+    final guide = key.currentState as QuickCheckSteps;
+    expect(guide.stepsFor('payment'), isNull);
+    final stale = guide.stepsFor('printer')!;
+    client.view!['id'] = 'new-help';
+    stale();
+    await t.pumpAndSettle();
+    expect(find.text('Reseat the printer cable.'), findsNothing);
+    final open = guide.stepsFor('printer')!;
+    open();
+    await t.pumpAndSettle();
+    expect(find.text('Reseat the printer cable.'), findsOneWidget);
+    client.cards.clear();
+    expect(guide.stepsFor('printer'), isNull);
+    await t.pumpWidget(const SizedBox());
+  });
+
+  const row = {
+    'name': 'Kitchen',
+    'ip': '192.168.2.2',
+    'type': 'printer',
+    'outcome': 'undetectable',
+    'latency_ms': null,
+    'ping_ms': 732,
+    'ping_outcome': 'timeout',
+    'ports': {'9100': 'unreachable', '515': 'timeout', '631': 'unknown'},
+  };
+  testWidgets('merchant details stay plain and only link to offered steps',
+      (t) async {
+    var opened = 0;
+    for (final (locale, label, steps, close) in [
+      ('zh-CN', '无法检测', '查看步骤', '关闭'),
+      ('en-US', 'Cannot detect', 'View steps', 'Close'),
+      ('es-MX', 'No se puede detectar', 'Ver los pasos', 'Cerrar'),
+    ]) {
+      for (final offered in [false, true]) {
+        await t.pumpWidget(MaterialApp(
+            home: Scaffold(
+                body: Builder(
+                    builder: (c) => QuickCheckResultLine(row, label,
+                        onDetails: () => showMerchantCheckDetail(
+                            c,
+                            row,
+                            label,
+                            locale,
+                            offered
+                                ? () {
+                                    opened++;
+                                  }
+                                : null))))));
+        final line = t.widget<Text>(find.textContaining(label));
+        final span = (line.textSpan as TextSpan)
+            .children!
+            .whereType<TextSpan>()
+            .singleWhere((s) => s.text == label);
+        expect(span.style!.decoration, TextDecoration.underline);
+        expect(span.style!.color, Colors.grey);
+        await t.tap(find.textContaining(label));
+        await t.pumpAndSettle();
+        final dialog = find.byType(AlertDialog);
+        expect(find.descendant(of: dialog, matching: find.text('Kitchen')),
+            findsOneWidget);
+        expect(
+            find.text(merchantCheckAdvice('printer', 'undetectable', locale)),
+            findsOneWidget);
+        for (final field in [
+          '192.168.2.2',
+          '9100',
+          '515',
+          '631',
+          '732',
+          'ping',
+          'ms'
+        ]) {
+          expect(
+              find.descendant(of: dialog, matching: find.textContaining(field)),
+              findsNothing);
+        }
+        expect(find.text(steps), offered ? findsOneWidget : findsNothing);
+        await t.tap(find.text(offered ? steps : close));
+        await t.pumpAndSettle();
+      }
+    }
+    expect(opened, 3);
+  });
+
+  test(
+      'each outcome has advice in three languages; failed devices get type-specific steps',
+      () {
+    for (final outcome in [
+      'reachable',
+      'unreachable',
+      'timeout',
+      'unknown',
+      'undetectable'
+    ]) {
+      for (final type in ['printer', 'payment', 'host', 'secondary', 'other']) {
+        expect({
+          for (final lang in ['zh', 'en', 'es'])
+            merchantCheckAdvice(type, outcome, lang)
+        }, hasLength(3));
+      }
+    }
+    expect(merchantCheckAdvice('printer', 'unreachable', 'zh'), contains('网线'));
+    expect(merchantCheckAdvice('payment', 'unreachable', 'zh'), contains('支付'));
+  });
+}
