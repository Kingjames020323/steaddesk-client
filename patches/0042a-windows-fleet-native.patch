+#[derive(Clone, Copy, Debug)]
+pub enum Operation {
+    Identity,
+    Assignment,
+    Safety,
+    Attempts,
+    Reports,
+}
+impl Operation {
+    pub fn path(self) -> &'static str {
+        match self {
+            Self::Identity => "/ops/v1/device/update-identity",
+            Self::Assignment => "/ops/v1/device/update-assignment",
+            Self::Safety => "/ops/v1/device/update-safety",
+            Self::Attempts => "/ops/v1/device/update-attempts",
+            Self::Reports => "/ops/v1/device/update-reports",
+        }
+    }
+    pub fn get(self) -> bool {
+        matches!(self, Self::Identity | Self::Assignment)
+    }
+}
