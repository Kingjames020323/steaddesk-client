+pub fn business_day(w: &Value, now: u64) -> Result<String> {
+    let zone: Tz = text(w, "zone")?
+        .parse()
+        .map_err(|_| Error("window_unknown"))?;
+    let (start, end) = (number(w, "start_min")?, number(w, "end_min")?);
+    check(start < 1440 && end < 1440 && start != end, "window_unknown")?;
+    let instant =
+        DateTime::<Utc>::from_timestamp(i64::try_from(now).map_err(|_| Error("clock_unknown"))?, 0)
+            .ok_or(Error("clock_unknown"))?;
+    let local = instant.with_timezone(&zone);
+    let mut day = local.date_naive();
+    use chrono::Timelike;
+    if end < start && u64::from(local.hour() * 60 + local.minute()) < end {
+        day -= ChronoDuration::days(1);
+    }
+    let base = day.and_hms_opt(0, 0, 0).ok_or(Error("window_unknown"))?;
+    let a = base + ChronoDuration::minutes(start as i64);
+    let b =
+        base + ChronoDuration::days(i64::from(end < start)) + ChronoDuration::minutes(end as i64);
+    let (LocalResult::Single(left), LocalResult::Single(right)) =
+        (zone.from_local_datetime(&a), zone.from_local_datetime(&b))
+    else {
+        return Err(Error("outside_window"));
+    };
+    let offset = left.offset().fix();
+    let mut cursor = a;
+    while cursor <= b {
+        match zone.from_local_datetime(&cursor) {
+            LocalResult::Single(t) if t.offset().fix() == offset => {}
+            _ => return Err(Error("outside_window")),
+        }
+        cursor += ChronoDuration::minutes(1);
+    }
+    check(
+        instant >= left.with_timezone(&Utc) && instant < right.with_timezone(&Utc),
+        "outside_window",
+    )?;
+    let result = day.to_string();
+    check(text(w, "business_day")? == result, "window_unknown")?;
+    Ok(result)
+}
