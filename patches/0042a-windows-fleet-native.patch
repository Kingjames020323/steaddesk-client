+pub fn recover<H: Host>(h: &mut H, s: &mut State) -> Result<()> {
+    let mut t = s.transaction.clone().ok_or(Error("no_safety"))?;
+    // Native service/process identity is inspected before asking the server; never relaunch.
+    let healthy = h.readback(&t)?;
+    let lookup = request(h, s, Operation::Assignment, json!({}))?;
+    let previous = lookup
+        .get("reconcile_only")
+        .filter(|v| v.get("assignment").and_then(Value::as_str) == Some(t.assignment.as_str()));
+    if let Some(p) = previous {
+        let attempt = text(p, "attempt")?;
+        check(
+            t.attempt.as_deref().map_or(true, |known| known == attempt),
+            "no_safety",
+        )?;
+        t.attempt = Some(attempt.to_owned());
+        s.report_seq = s.report_seq.max(number(p, "seq")?);
+        s.transaction = Some(t.clone());
+        h.persist(s)?;
+        match p.get("state").and_then(Value::as_str) {
+            Some("healthy") if healthy => {
+                let aid = t.attempt.as_deref().ok_or(Error("no_safety"))?;
+                s.reports
+                    .retain(|r| r.get("id").and_then(Value::as_str) != Some(aid));
+                s.highest_sequence = s.highest_sequence.max(t.manifest.sequence);
+                s.managed_payload = Some(t.payload_sha256.clone());
+                s.transaction = None;
+                h.persist(s)?;
+                return h.log("health", "server_observation_complete");
+            }
+            Some("failed") => {
+                t.stage = "failed".into();
+                s.transaction = Some(t);
+                h.persist(s)?;
+                return h.log("health", "frozen");
+            }
+            _ => {}
+        }
+    }
+    let outcome = match (
+        t.installer_code,
+        previous
+            .and_then(|p| p.get("state"))
+            .and_then(Value::as_str),
+    ) {
+        (Some(0), Some("committing")) => Some(("observing", None)),
+        (Some(3010), Some("committing")) => Some(("pending_reboot", None)),
+        (Some(code), Some("committing" | "pending_reboot" | "observing"))
+            if code != 0 && code != 3010 =>
+        {
+            Some(("failed", Some("install_failed")))
+        }
+        _ => None,
+    };
+    let queued = outcome.map_or(false, |(status, _)| {
+        s.reports.iter().any(|r| {
+            r.get("id").and_then(Value::as_str) == t.attempt.as_deref()
+                && r.get("state").and_then(Value::as_str) == Some(status)
+        })
+    });
+    flush(h, s)?;
+    let Some(aid) = t.attempt.as_deref() else {
+        return h.log("recovery", "manual_required");
+    };
+    // A known OS result may have been persisted just before the clock/network
+    // failed, without reaching the outbox. Replay that result before health;
+    // an already queued receipt keeps its original sequence and is only flushed.
+    if let Some((status, reason)) = outcome.filter(|_| !queued) {
+        let mut receipt = t.clone();
+        if status == "observing" {
+            receipt.stage = "submitted".into();
+        }
+        report(h, s, aid, status, reason, Some(&receipt))?;
+    }
+    if t.stage == "failed" {
+        return h.log("recovery", "frozen");
+    }
+    if !healthy {
+        return h.log("recovery", "service_unverified");
+    }
+    if t.installer_code.is_none() {
+        return h.log("recovery", "installer_result_unknown");
+    }
+    if t.installer_code == Some(3010) && h.boot_id()? == t.prior_boot_id {
+        return h.log("recovery", "pending_reboot");
+    }
+    if let Err(error) = h.local_gates() {
+        if error.0 == "merchant_pause" {
+            return report(h, s, aid, "paused", Some("merchant_pause"), Some(&t));
+        }
+        return h.log("recovery", error.0);
+    }
+    // 3010 remains pending until native readback proves a replacement service process
+    // with the exact signed payload digest. Exit 0 alone is never health evidence.
+    t.stage = "observing".into();
+    s.highest_sequence = s.highest_sequence.max(t.manifest.sequence);
+    s.transaction = Some(t.clone());
+    h.persist(s)?;
+    report(h, s, aid, "observing", None, Some(&t))
+}
+
+fn proof_bytes(
+    op: Operation,
+    body: &Value,
+    device: &str,
+    version: u64,
+    stamp: u64,
+    nonce: &str,
+) -> Result<Vec<u8>> {
+    check(
+        body.is_object()
+            && (!op.get() || body == &json!({}))
+            && ((matches!(op, Operation::Identity) && version == 0)
+                || (!matches!(op, Operation::Identity) && version > 0)),
+        "no_safety",
+    )?;
+    let mut bytes = b"SteadDesk-fleet-v1\0".to_vec();
+    bytes.extend(
+        serde_json::to_vec(&json!([
+            if op.get() { "GET" } else { "POST" },
+            op.path(),
+            body,
+            device,
+            version,
+            stamp,
+            nonce
+        ]))
+        .map_err(|_| Error("no_safety"))?,
+    );
+    Ok(bytes)
+}
+fn device_headers(op: Operation, body: &Value, version: u64) -> Result<Value> {
+    sodiumoxide::init().map_err(|_| Error("no_safety"))?;
+    let id = IdentityConfig::get_id_or(String::new());
+    check(
+        (9..=10).contains(&id.len()) && id.bytes().all(|b| b.is_ascii_digit()),
+        "no_safety",
+    )?;
+    let (mut secret, public) = IdentityConfig::get_existing_key_pair().ok_or(Error("no_safety"))?;
+    let key = sign::SecretKey::from_slice(&secret);
+    memzero(&mut secret);
+    let key = key.ok_or(Error("no_safety"))?;
+    let public = sign::PublicKey::from_slice(&public).ok_or(Error("no_safety"))?;
+    let stamp = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| Error("clock_unknown"))?
+        .as_secs();
+    let nonce = random_nonce()?;
+    let bytes = proof_bytes(op, body, &id, version, stamp, &nonce)?;
+    let sig = sign::sign_detached(&bytes, &key);
+    check(sign::verify_detached(&sig, &bytes, &public), "no_safety")?;
+    Ok(
+        json!({"X-Fleet-Device":id,"X-Fleet-Key-Version":version.to_string(),"X-Fleet-Time":stamp.to_string(),"X-Fleet-Nonce":nonce,"X-Fleet-Signature":STANDARD.encode(sig.to_bytes())}),
+    )
+}
