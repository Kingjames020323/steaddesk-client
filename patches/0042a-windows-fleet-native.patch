+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Manifest {
+    pub schema: u64,
+    pub release_id: String,
+    pub sequence: u64,
+    pub key_id: String,
+    pub issued_at: u64,
+    pub expires_at: u64,
+    pub ring: u64,
+    pub batch: u64,
+    pub bucket_end: u64,
+    pub platform: String,
+    pub package: String,
+    pub channel: String,
+    pub architecture: String,
+    #[serde(rename = "versionCode")]
+    pub version: u64,
+    pub display_version: String,
+    pub min_os: u64,
+    pub size_bytes: u64,
+    pub artifact_path: String,
+    pub sha256: String,
+    pub signer_cert_sha256: String,
+    pub previous_release_id: Option<String>,
+    pub health_policy_id: String,
+}
+pub fn verified_manifest(assignment: &Value, cfg: &BuildConfig, now: u64) -> Result<Manifest> {
+    let key_id = text(assignment, "key_id")?;
+    let root = trust::select(cfg.roots, key_id, now).ok_or(Error("manifest_signature"))?;
+    let raw = STANDARD
+        .decode(text(assignment, "manifest")?)
+        .map_err(|_| Error("manifest_signature"))?;
+    let sig = STANDARD
+        .decode(text(assignment, "signature")?)
+        .map_err(|_| Error("manifest_signature"))?;
+    check(!raw.is_empty() && raw.len() <= 32768, "manifest_signature")?;
+    let pk = STANDARD
+        .decode(root.public_key)
+        .map_err(|_| Error("manifest_signature"))?;
+    let pk = sign::PublicKey::from_slice(&pk).ok_or(Error("manifest_signature"))?;
+    let sig = sign::Signature::from_bytes(&sig).map_err(|_| Error("manifest_signature"))?;
+    sodiumoxide::init().map_err(|_| Error("manifest_signature"))?;
+    check(sign::verify_detached(&sig, &raw, &pk), "manifest_signature")?;
+    let value = strict_json(&raw).map_err(|_| Error("manifest_signature"))?;
+    check(
+        value.as_object().map(|o| o.len()) == Some(22)
+            && value.get("previous_release_id").is_some(),
+        "manifest_signature",
+    )?;
+    let m: Manifest = serde_json::from_value(value).map_err(|_| Error("manifest_signature"))?;
+    check(
+        m.schema == 1
+            && m.sequence > 0
+            && m.version > 0
+            && m.version <= 65535
+            && m.key_id == root.id
+            && token(&m.release_id)
+            && token(&m.display_version),
+        "manifest_signature",
+    )?;
+    check(
+        m.issued_at >= root.valid_from
+            && m.issued_at <= now
+            && now < m.expires_at
+            && m.expires_at <= root.valid_until,
+        "manifest_signature",
+    )?;
+    check(
+        m.platform == "windows"
+            && m.package == "SteadDesk"
+            && m.channel == "merchant"
+            && m.architecture == "x64"
+            && m.health_policy_id == "c4-v1",
+        "platform_mismatch",
+    )?;
+    check(
+        m.previous_release_id
+            .as_deref()
+            .map_or(true, |v| token(v) && v != m.release_id)
+            && m.min_os > 0,
+        "manifest_signature",
+    )?;
+    check(
+        m.ring <= 2
+            && m.bucket_end > 0
+            && m.bucket_end <= 100
+            && (if m.ring == 2 {
+                m.batch > 0
+            } else {
+                m.batch == 0 && m.bucket_end == 100
+            }),
+        "manifest_signature",
+    )?;
+    check(
+        number(assignment, "ring")? == m.ring && m.size_bytes > 0 && m.size_bytes <= 536870912,
+        "manifest_signature",
+    )?;
+    hash_hex(&m.sha256)?;
+    hash_hex(&m.signer_cert_sha256)?;
+    check(
+        m.artifact_path.len() <= 512 && m.artifact_path.ends_with(".exe"),
+        "platform_mismatch",
+    )?;
+    for part in m.artifact_path.split('/') {
+        let stem = part.split('.').next().unwrap_or("").to_ascii_uppercase();
+        check(
+            !part.is_empty()
+                && part.len() <= 128
+                && !part.ends_with('.')
+                && part
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"_.-".contains(&b))
+                && part.bytes().next().map_or(false, |b| {
+                    b.is_ascii_alphanumeric() || b == b'_' || b == b'-'
+                })
+                && !matches!(
+                    stem.as_str(),
+                    "CON"
+                        | "PRN"
+                        | "AUX"
+                        | "NUL"
+                        | "COM1"
+                        | "COM2"
+                        | "COM3"
+                        | "COM4"
+                        | "COM5"
+                        | "COM6"
+                        | "COM7"
+                        | "COM8"
+                        | "COM9"
+                        | "LPT1"
+                        | "LPT2"
+                        | "LPT3"
+                        | "LPT4"
+                        | "LPT5"
+                        | "LPT6"
+                        | "LPT7"
+                        | "LPT8"
+                        | "LPT9"
+                ),
+            "manifest_signature",
+        )?;
+    }
+    Ok(m)
+}
