+        pid: u32,
+        created: u64,
+        out: *mut Service,
+    ) -> u32;
+    fn sd_fleet_os_version(out: *mut u32) -> u32;
+    fn sd_fleet_boot_id(out: *mut u64) -> u32;
+}
+fn native(status: u32) -> Result<()> {
+    check(status == 0, "no_safety")
+}
+struct Prepared {
+    lease: *mut std::ffi::c_void,
+    retain: bool,
+}
+impl Drop for Prepared {
+    fn drop(&mut self) {
+        if !self.retain {
+            unsafe { sd_fleet_release(self.lease) }
+        }
+    }
+}
+fn expected(m: &Manifest, payload: [u8; 32], leaf: &[u16]) -> Result<Expected> {
+    Ok(Expected {
+        leaf: leaf.as_ptr(),
+        size: m.size_bytes,
+        version: m.version,
+        artifact: hash_hex(&m.sha256)?,
+        signer: hash_hex(&m.signer_cert_sha256)?,
+        payload,
+        architecture: 1,
+    })
+}
+fn wide(path: &Path) -> Vec<u16> {
+    use std::os::windows::ffi::OsStrExt;
+    path.as_os_str().encode_wide().chain(Some(0)).collect()
+}
+fn origin(value: &str) -> Result<Url> {
+    let url = Url::parse(value).map_err(|_| Error("no_safety"))?;
+    check(
+        url.scheme() == "https"
+            && url.host_str().is_some()
+            && url.username().is_empty()
+            && url.password().is_none()
+            && url.path() == "/"
+            && url.query().is_none()
+            && url.fragment().is_none(),
+        "no_safety",
+    )?;
+    Ok(url)
+}
+struct WindowsHost {
+    directory: PathBuf,
+    client: Client,
+    clock: Option<(u64, Instant)>,
+    _lock: File,
+}
+impl WindowsHost {
+    fn open() -> Result<Self> {
+        origin(build::OPS_ORIGIN)?;
+        origin(build::ARTIFACT_ORIGIN)?;
+        let mut out = vec![0u16; 32768];
+        unsafe {
+            native(sd_fleet_private_directory(out.as_mut_ptr(), out.len()))?;
+        }
+        let length = out.iter().position(|x| *x == 0).ok_or(Error("no_safety"))?;
+        let directory =
+            PathBuf::from(String::from_utf16(&out[..length]).map_err(|_| Error("no_safety"))?);
+        let lock = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .share_mode(0)
+            .open(directory.join("controller.lock"))
+            .map_err(|_| Error("no_safety"))?;
+        let client = Client::builder()
+            .no_proxy()
+            .redirect(Policy::none())
+            .connect_timeout(Duration::from_secs(3))
+            .timeout(Duration::from_secs(15))
+            .min_tls_version(reqwest::tls::Version::TLS_1_2)
+            .build()
+            .map_err(|_| Error("no_safety"))?;
+        Ok(Self {
+            directory,
+            client,
+            clock: None,
+            _lock: lock,
+        })
+    }
+    fn load(&self) -> Result<State> {
+        let path = self.directory.join("state.json");
+        if !path.exists() {
+            return Ok(State::default());
+        }
+        let meta = std::fs::symlink_metadata(&path).map_err(|_| Error("no_safety"))?;
+        check(
+            meta.is_file() && !meta.file_type().is_symlink() && meta.len() <= 1048576,
+            "no_safety",
+        )?;
+        let bytes = std::fs::read(&path).map_err(|_| Error("no_safety"))?;
+        serde_json::from_value(strict_json(&bytes)?).map_err(|_| Error("no_safety"))
+    }
+}
+impl Host for WindowsHost {
+    type Installer = Prepared;
+    fn now(&mut self) -> Result<u64> {
+        if self
+            .clock
+            .as_ref()
+            .map_or(true, |(_, at)| at.elapsed() > Duration::from_secs(60))
+        {
+            let began = Instant::now();
+            let response = self
+                .client
+                .get(build::OPS_ORIGIN)
+                .header("Cache-Control", "no-cache")
+                .send()
+                .map_err(|_| Error("clock_unknown"))?;
+            check(
+                began.elapsed() < Duration::from_secs(5)
+                    && response.headers().get_all("Date").iter().count() == 1,
+                "clock_unknown",
+            )?;
+            let date = response
+                .headers()
+                .get("Date")
+                .and_then(|s| s.to_str().ok())
+                .ok_or(Error("clock_unknown"))?;
+            let time = DateTime::parse_from_rfc2822(date)
+                .map_err(|_| Error("clock_unknown"))?
+                .timestamp();
+            let time = u64::try_from(time).map_err(|_| Error("clock_unknown"))?;
+            self.clock = Some((time, Instant::now()));
+        }
+        let (anchor, elapsed) = self.clock.as_ref().ok_or(Error("clock_unknown"))?;
+        let network = anchor
+            .checked_add(elapsed.elapsed().as_secs())
+            .ok_or(Error("clock_unknown"))?;
+        let local = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_err(|_| Error("clock_unknown"))?
+            .as_secs();
+        check(local.abs_diff(network) <= 30, "clock_unknown")?;
+        Ok(network)
+    }
+    fn boot_id(&mut self) -> Result<u64> {
+        let mut value = 0;
+        unsafe {
+            native(sd_fleet_boot_id(&mut value))?;
+        }
+        check(value != 0, "no_safety")?;
+        Ok(value)
+    }
+    fn local_gates(&mut self) -> Result<()> {
+        check(
+            IdentityConfig::get_option("stop-service") != "Y",
+            "merchant_pause",
+        )?;
+        check(
+            crate::server::AUTHED_CONNS
+                .lock()
+                .map_err(|_| Error("session_unknown"))?
+                .is_empty(),
+            "session_unknown",
+        )?;
+        unsafe { native(sd_fleet_local_gates()) }
+    }
+    fn installed(&mut self) -> Result<Installed> {
+        let mut current = Service::default();
+        let mut os = 0;
+        unsafe {
+            native(sd_fleet_current_service(&mut current))?;
+            native(sd_fleet_os_version(&mut os))?;
+        }
+        check(
+            current.running == 1 && current.pid != 0 && current.created != 0,
+            "no_safety",
+        )?;
+        Ok(Installed {
+            build: current.version,
+            os: u64::from(os),
+            pid: current.pid,
+            created: current.created,
+            binary_sha256: current.sha,
+        })
+    }
+    fn request(&mut self, op: Operation, body: &Value, key_version: u64) -> Result<Value> {
+        self.now()?;
+        let url = origin(build::OPS_ORIGIN)?
+            .join(op.path())
+            .map_err(|_| Error("no_safety"))?;
+        let headers = device_headers(op, body, key_version)?;
+        let mut request = self
+            .client
+            .request(
+                if op.get() {
+                    reqwest::Method::GET
+                } else {
+                    reqwest::Method::POST
+                },
+                url,
+            )
+            .header("Cache-Control", "no-cache");
+        for (key, value) in headers.as_object().ok_or(Error("no_safety"))? {
+            request = request.header(key, text(&headers, key)?);
+            let _ = value;
+        }
+        if !op.get() {
+            request = request
+                .header("Content-Type", "application/json")
+                .body(serde_json::to_vec(body).map_err(|_| Error("no_safety"))?);
+        }
+        let response = request.send().map_err(|_| Error("no_safety"))?;
+        if response.status() == reqwest::StatusCode::FORBIDDEN {
+            return Err(Error("identity_refresh"));
+        }
+        check(response.status() == reqwest::StatusCode::OK, "no_safety")?;
+        let mut bytes = Vec::new();
+        response
+            .take(131073)
+            .read_to_end(&mut bytes)
+            .map_err(|_| Error("no_safety"))?;
+        check(bytes.len() <= 131072, "no_safety")?;
+        strict_json(&bytes).map_err(|_| Error("no_safety"))
+    }
+    fn prepare(&mut self, m: &Manifest) -> Result<(Prepared, [u8; 32])> {
+        let url = origin(build::ARTIFACT_ORIGIN)?
+            .join(&m.artifact_path)
+            .map_err(|_| Error("artifact_hash"))?;
+        let response = self
+            .client
+            .get(url)
+            .header("Cache-Control", "no-cache")
+            .timeout(Duration::from_secs(180))
+            .send()
+            .map_err(|_| Error("artifact_hash"))?;
+        check(
+            response.status() == reqwest::StatusCode::OK,
+            "artifact_hash",
+        )?;
+        let path = self.directory.join("candidate.exe");
+        if path.exists() {
+            let info = std::fs::symlink_metadata(&path).map_err(|_| Error("no_safety"))?;
+            check(
+                info.is_file() && !info.file_type().is_symlink(),
+                "no_safety",
+            )?;
+            std::fs::remove_file(&path).map_err(|_| Error("no_safety"))?;
+        }
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .share_mode(0)
+            .open(&path)
+            .map_err(|_| Error("no_safety"))?;
+        let mut source = response.take(m.size_bytes + 1);
+        let mut size = 0u64;
+        let mut hash = Sha256::new();
+        let mut bytes = [0u8; 65536];
+        loop {
+            let count = source
+                .read(&mut bytes)
+                .map_err(|_| Error("artifact_hash"))?;
+            if count == 0 {
+                break;
+            }
+            size += count as u64;
+            check(size <= m.size_bytes, "artifact_size")?;
+            hash.update(&bytes[..count]);
+            file.write_all(&bytes[..count])
+                .map_err(|_| Error("no_safety"))?;
+        }
+        file.sync_all().map_err(|_| Error("no_safety"))?;
+        drop(file);
+        check(size == m.size_bytes, "artifact_size")?;
+        check(hex(&hash.finalize()) == m.sha256, "artifact_hash")?;
+        let leaf: Vec<u16> = "candidate.exe\0".encode_utf16().collect();
+        let expected = expected(m, [0; 32], &leaf)?;
+        let mut lease = ptr::null_mut();
+        let prepared_status = unsafe { sd_fleet_prepare(&expected, &mut lease) };
+        match prepared_status {
+            4 | 13 => return Err(Error("artifact_signature")),
+            5 => return Err(Error("artifact_hash")),
+            6 => return Err(Error("package_mismatch")),
+            7 | 11 => return Err(Error("platform_mismatch")),
+            other => native(other)?,
+        }
+        check(!lease.is_null(), "no_safety")?;
+        let prepared = Prepared {
+            lease,
+            retain: false,
+        };
+        let mut payload = [0; 32];
+        unsafe {
+            native(sd_fleet_payload_digest(
+                prepared.lease,
+                payload.as_mut_ptr(),
+            ))?;
+        }
+        Ok((prepared, payload))
+    }
+    fn launch(&mut self, prepared: &mut Prepared) -> Result<u32> {
+        let mut result = Launch::default();
+        unsafe {
+            let status = sd_fleet_launch(prepared.lease, &mut result);
+            if status == 10 {
+                prepared.retain = true;
+            }
+            native(status)?;
+        }
+        self.log("installer_process", &format!("pid_{}", result.pid))?;
+        Ok(result.code)
+    }
+    fn readback(&mut self, t: &Transaction) -> Result<bool> {
+        let leaf: Vec<u16> = "candidate.exe\0".encode_utf16().collect();
+        let expected = expected(&t.manifest, hash_hex(&t.payload_sha256)?, &leaf)?;
+        let mut result = Service::default();
+        Ok(unsafe { sd_fleet_readback(&expected, t.prior_pid, t.prior_created, &mut result) } == 0)
+    }
+    fn persist(&mut self, state: &State) -> Result<()> {
+        let bytes = serde_json::to_vec(state).map_err(|_| Error("no_safety"))?;
+        check(bytes.len() <= 1048576, "no_safety")?;
+        let temporary = self
+            .directory
+            .join(format!("state-{}.tmp", random_nonce()?));
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .share_mode(0)
+            .open(&temporary)
+            .map_err(|_| Error("no_safety"))?;
+        file.write_all(&bytes).map_err(|_| Error("no_safety"))?;
+        file.sync_all().map_err(|_| Error("no_safety"))?;
+        drop(file);
+        let from = wide(&temporary);
+        let to = wide(&self.directory.join("state.json"));
+        check(
+            unsafe {
+                MoveFileExW(
+                    from.as_ptr(),
+                    to.as_ptr(),
+                    MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH,
+                )
+            } != 0,
+            "no_safety",
+        )
+    }
+    fn log(&mut self, event: &str, reason: &str) -> Result<()> {
+        let line=serde_json::to_vec(&json!({"time":SystemTime::now().duration_since(UNIX_EPOCH).map_err(|_|Error("clock_unknown"))?.as_secs(),"event":event,"reason":reason})).map_err(|_|Error("no_safety"))?;
+        let mut file = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .share_mode(0)
+            .open(self.directory.join("events.jsonl"))
+            .map_err(|_| Error("no_safety"))?;
+        file.write_all(&line)
+            .and_then(|_| file.write_all(b"\n"))
+            .and_then(|_| file.sync_all())
+            .map_err(|_| Error("no_safety"))
+    }
+}
+pub fn start() {
+    if !crate::is_server() || !crate::platform::windows::is_installed() {
+        return;
+    }
+    static ONCE: Once = Once::new();
+    ONCE.call_once(|| {
+        let result = std::thread::Builder::new()
+            .name("merchant-update".into())
+            .spawn(|| {
+                let mut host = match WindowsHost::open() {
+                    Ok(host) => host,
+                    Err(_) => {
+                        hbb_common::log::warn!("Fleet update host unavailable");
+                        return;
+                    }
+                };
+                loop {
+                    let mut state = match host.load() {
+                        Ok(state) => state,
+                        Err(_) => {
+                            let _ = host.log("stopped", "state_unknown");
+                            return;
+                        }
+                    };
+                    let cfg = BuildConfig {
+                        roots: trust::BUILD_ROOTS,
+                        current_build: build::CURRENT_BUILD,
+                        silent_profile: build::SILENT_PROFILE,
+                    };
+                    if let Err(error) = tick(&mut host, &mut state, &cfg) {
+                        let _ = host.log("stopped", error.0);
+                    }
+                    std::thread::park_timeout(Duration::from_secs(
+                        if state.transaction.is_some() {
+                            60
+                        } else {
+                            21600
+                        },
+                    ));
+                }
+            });
+        if result.is_err() {
+            hbb_common::log::warn!("Fleet update worker unavailable");
+        }
+    });
+}
