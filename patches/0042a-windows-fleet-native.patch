+}
+pub trait Host {
+    type Installer;
+    fn now(&mut self) -> Result<u64>;
+    fn boot_id(&mut self) -> Result<u64>;
+    fn local_gates(&mut self) -> Result<()>;
+    fn installed(&mut self) -> Result<Installed>;
+    fn request(&mut self, op: Operation, body: &Value, key_version: u64) -> Result<Value>;
+    fn prepare(&mut self, manifest: &Manifest) -> Result<(Self::Installer, [u8; 32])>;
+    fn launch(&mut self, installer: &mut Self::Installer) -> Result<u32>;
+    fn readback(&mut self, transaction: &Transaction) -> Result<bool>;
+    fn persist(&mut self, state: &State) -> Result<()>;
+    fn log(&mut self, event: &str, reason: &str) -> Result<()>;
+}
+fn request<H: Host>(h: &mut H, s: &mut State, op: Operation, body: Value) -> Result<Value> {
+    if s.key_version == 0 {
+        let reply = h.request(Operation::Identity, &json!({}), 0)?;
+        s.key_version = number(&reply, "key_version")?;
+        check(s.key_version > 0, "no_safety")?;
+        h.persist(s)?;
+    }
+    match h.request(op, &body, s.key_version) {
+        Err(Error("identity_refresh")) => {
+            s.key_version = 0;
+            h.persist(s)?;
+            Err(Error("no_safety"))
+        }
+        result => result,
+    }
+}
+fn flush<H: Host>(h: &mut H, s: &mut State) -> Result<()> {
+    while let Some(first) = s.reports.first().cloned() {
+        request(h, s, Operation::Reports, first)?;
+        s.reports.remove(0);
+        h.persist(s)?;
+    }
+    Ok(())
+}
+fn report<H: Host>(
+    h: &mut H,
+    s: &mut State,
+    subject: &str,
+    status: &str,
+    reason: Option<&str>,
+    t: Option<&Transaction>,
+) -> Result<()> {
+    check(s.reports.len() < 256, "no_safety")?;
+    s.report_seq = s.report_seq.checked_add(1).ok_or(Error("no_safety"))?;
+    let at = h.now()?;
+    let mut value = json!({"id":subject,"seq":s.report_seq,"state":status,"observed_at":at});
+    if let Some(reason) = reason {
+        value["reason"] = json!(reason);
+    }
+    if let Some(t) = t {
+        value["os_session"] = json!(t.os_session);
+        if let Some(code) = t.installer_code {
+            if code == 0 || status == "pending_reboot" || status == "failed" {
+                value["installer_code"] = json!(code);
+            }
+        }
+        if status == "observing" && t.stage == "observing" {
+            value["heartbeat_at"] = json!(at);
+            value["build"] = json!(t.manifest.version);
+            value["artifact_sha256"] = json!(t.manifest.sha256);
+            value["service_verified"] = json!(true);
+            value["identity_verified"] = json!(true);
+        }
+    }
+    s.reports.push(value);
+    h.persist(s)?;
+    h.log("report", status)?;
+    flush(h, s)
+}
+fn local_checks<H: Host>(
+    h: &mut H,
+    s: &State,
+    w: &Value,
+    m: &Manifest,
+    cfg: &BuildConfig,
+) -> Result<(u64, String, Installed)> {
+    let at = h.now()?;
+    let day = business_day(w, at)?;
+    h.local_gates()?;
+    let current = h.installed()?;
+    check(
+        s.managed_payload
+            .as_deref()
+            .map_or(true, |known| known == hex(&current.binary_sha256)),
+        "brand_mismatch",
+    )?;
+    check(
+        current.build == cfg.current_build && m.version > current.build,
+        "same_version",
+    )?;
+    check(current.os >= m.min_os, "platform_mismatch")?;
+    check(
+        day != s.last_day
+            && (s.last_started == 0 || at >= s.last_started && at - s.last_started >= 86400),
+        "outside_window",
+    )?;
+    Ok((at, day, current))
+}
+
+pub fn tick<H: Host>(h: &mut H, s: &mut State, cfg: &BuildConfig) -> Result<()> {
+    if s.transaction.is_some() {
+        return recover(h, s);
+    }
+    // The existing service-owned server and its companion must be known live
+    // before this worker polls or stages anything; a late peer start can retry.
+    h.local_gates()?;
+    flush(h, s)?;
+    let a = request(h, s, Operation::Assignment, json!({}))?;
+    if a.get("assignment").map_or(true, Value::is_null) {
+        return h.log("assignment", "none");
+    }
+    let aid = text(&a, "assignment")?.to_owned();
+    check(token(&aid), "no_safety")?;
+    let work = (|| {
+        let at = h.now()?;
+        check(at < number(&a, "expires_at")?, "no_safety")?;
+        let m = verified_manifest(&a, cfg, at)?;
+        check(m.sequence > s.highest_sequence, "low_sequence")?;
+        check(
+            !cfg.silent_profile.is_empty() && text(&a, "silent_profile")? == cfg.silent_profile,
+            "no_safety",
+        )?;
+        let w = a.get("window").ok_or(Error("window_unknown"))?;
+        local_checks(h, s, w, &m, cfg)?;
+        h.log("manifest", "verified")?;
+        let (mut installer, payload) = h.prepare(&m)?;
+        h.log("artifact", "verified")?;
+        let (at, day, prior) = local_checks(h, s, w, &m, cfg)?;
+        let nonce = random_nonce()?;
+        let safety = request(
+            h,
+            s,
+            Operation::Safety,
+            json!({"nonce":nonce,"purpose":"install","assignment":aid,"min_generation":s.generation}),
+        )?;
+        let (generation, issued, expires) = (
+            number(&safety, "generation")?,
+            number(&safety, "issued_at")?,
+            number(&safety, "expires_at")?,
+        );
+        check(generation >= s.generation, "no_safety")?;
+        s.generation = generation;
+        h.persist(s)?;
+        let fresh = h.now()?;
+        check(
+            safety.get("enabled") == Some(&Value::Bool(true))
+                && text(&safety, "nonce")? == nonce
+                && text(&safety, "purpose")? == "install"
+                && issued <= fresh
+                && fresh < expires
+                && expires.checked_sub(issued).map_or(false, |n| n <= 15),
+            "no_safety",
+        )?;
+        let (_, final_day, current) = local_checks(h, s, w, &m, cfg)?;
+        check(final_day == day, "outside_window")?;
+        check(current == prior, "brand_mismatch")?;
+        let facts = json!({"installed":current.build,"platform":"windows","package":"SteadDesk","architecture":"x64","os":current.os,"artifact_sha256":m.sha256,"signer_cert_sha256":m.signer_cert_sha256,"size_bytes":m.size_bytes,"signature_verified":true,"local_window":true,"remote_session":false,"merchant_paused":false,"force_stopped":false,"highest_sequence":s.highest_sequence,"interactive":false,"accepted":false,"profile":cfg.silent_profile});
+        let t = Transaction {
+            assignment: aid.clone(),
+            attempt: None,
+            manifest: m,
+            os_session: format!("win_{}", random_nonce()?),
+            stage: "committing".into(),
+            installer_code: None,
+            payload_sha256: hex(&payload),
+            prior_pid: prior.pid,
+            prior_created: prior.created,
+            prior_boot_id: h.boot_id()?,
+            prior_build: prior.build,
+            prior_sha256: hex(&prior.binary_sha256),
+        };
+        s.last_day = day;
+        s.last_started = at;
+        s.transaction = Some(t);
+        h.persist(s)?;
+        h.log("committing", "reserved")?;
+        let granted = request(
+            h,
+            s,
+            Operation::Attempts,
+            json!({"assignment":aid,"permit":text(&safety,"permit")?,"nonce":nonce,"generation":generation,"facts":facts}),
+        )?;
+        check(
+            granted.get("install_authorized") == Some(&Value::Bool(true))
+                && number(&granted, "generation")? == generation,
+            "no_safety",
+        )?;
+        let mut t = s.transaction.clone().ok_or(Error("no_safety"))?;
+        t.attempt = Some(text(&granted, "attempt")?.to_owned());
+        t.stage = "authorized".into();
+        s.transaction = Some(t.clone());
+        h.persist(s)?;
+        let final_time = h.now()?;
+        check(
+            final_time < expires && final_time < number(&a, "expires_at")?,
+            "no_safety",
+        )?;
+        h.local_gates()?;
+        business_day(w, final_time)?;
+        check(h.installed()? == current, "brand_mismatch")?;
+        t.stage = "submitted".into();
+        s.transaction = Some(t.clone());
+        h.persist(s)?;
+        // A slow durable write cannot turn an expired permit into a live one.
+        h.local_gates()?;
+        check(h.installed()? == current, "brand_mismatch")?;
+        let boundary = h.now()?;
+        check(
+            boundary < expires && boundary < number(&a, "expires_at")?,
+            "no_safety",
+        )?;
+        check(business_day(w, boundary)? == s.last_day, "outside_window")?;
+        // Persisted before the OS call. A lost result is never permission to call it twice.
+        let code = h.launch(&mut installer)?;
+        t.installer_code = Some(code);
+        let status = match code {
+            0 => "submitted",
+            3010 => "pending_reboot",
+            _ => "failed",
+        };
+        t.stage = status.into();
+        s.transaction = Some(t.clone());
+        h.persist(s)?;
+        h.log(
+            "installer",
+            if code == 0 {
+                "launch_accepted"
+            } else if code == 3010 {
+                "pending_reboot"
+            } else {
+                "failed"
+            },
+        )?;
+        if code == 3010 || code != 0 {
+            return report(
+                h,
+                s,
+                t.attempt.as_deref().ok_or(Error("no_safety"))?,
+                status,
+                if code == 3010 {
+                    None
+                } else {
+                    Some("install_failed")
+                },
+                Some(&t),
+            );
+        }
+        report(
+            h,
+            s,
+            t.attempt.as_deref().ok_or(Error("no_safety"))?,
+            "observing",
+            None,
+            Some(&t),
+        )?;
+        recover(h, s)
+    })();
+    if let Err(error) = work {
+        h.log("stopped", error.0)?;
+        if s.transaction.is_none() {
+            let status = if matches!(
+                error.0,
+                "artifact_hash"
+                    | "artifact_size"
+                    | "artifact_signature"
+                    | "signer_mismatch"
+                    | "manifest_signature"
+                    | "platform_mismatch"
+                    | "package_mismatch"
+            ) {
+                "rejected"
+            } else {
+                "deferred"
+            };
+            let reason = if matches!(
+                error.0,
+                "artifact_hash"
+                    | "artifact_size"
+                    | "artifact_signature"
+                    | "signer_mismatch"
+                    | "manifest_signature"
+                    | "platform_mismatch"
+                    | "package_mismatch"
+                    | "merchant_pause"
+                    | "j23"
+                    | "outside_window"
+                    | "session_unknown"
+                    | "same_version"
+                    | "low_sequence"
+                    | "clock_unknown"
+                    | "window_unknown"
+            ) {
+                error.0
+            } else {
+                "no_safety"
+            };
+            report(h, s, &aid, status, Some(reason), None)?;
+        }
+        return Err(error);
+    }
+    Ok(())
+}
