+import 'package:flutter/material.dart';
+import '../ops_health.dart' show HealthFailure;
+import 'check.dart' show Json, privateV4;
+
+class InventoryCandidate {
+  final String ip, hostname;
+  final bool ping, router, registered;
+  final List<int> ports;
+
+  InventoryCandidate._(this.ip, this.hostname, this.ping, this.router,
+      this.registered, this.ports);
+
+  factory InventoryCandidate.from(Object? raw) {
+    if (raw
+        case {
+          'ip': String ip,
+          'hostname': String hostname,
+          'ping': bool ping,
+          'router': bool router,
+          'registered': bool registered,
+          'ports': List ports,
+        } when privateV4(ip) && ports.every(const {515, 631, 9100}.contains)) {
+      return InventoryCandidate._(
+          ip, hostname, ping, router, registered, List<int>.from(ports));
+    }
+    throw const FormatException();
+  }
+}
+
+// Read a previously recorded snapshot for the selected device.
+class InventoryObservationReview extends StatefulWidget {
+  final Future<Json> Function() read;
+  final bool Function() canView;
+  final List<Json> entries;
+  final ValueChanged<InventoryCandidate> onAdd;
+  const InventoryObservationReview(
+      {super.key,
+      required this.read,
+      required this.canView,
+      required this.entries,
+      required this.onAdd});
+
+  @override
+  State<InventoryObservationReview> createState() => _ReviewState();
+}
+
+class _ReviewState extends State<InventoryObservationReview> {
+  bool loading = true, partial = false;
+  String? error;
+  DateTime? observed;
+  List<InventoryCandidate> rows = [];
+
+  @override
+  void initState() {
+    super.initState();
+    read();
+  }
+
+  Future<void> read() async {
+    if (!widget.canView()) return;
+    setState(() {
+      loading = true;
+      observed = null;
+      rows = [];
+      partial = false;
+      error = null;
+    });
+    try {
+      final data = await widget.read();
+      if (!mounted || !widget.canView()) return;
+      switch (data) {
+        case {'observation': null}:
+          break;
+        case {
+            'observation': {
+              'observed_at': int at,
+              'partial': bool incomplete,
+              'rows': List items
+            }
+          }:
+          final timestamp = DateTime.fromMillisecondsSinceEpoch(at * 1000);
+          final candidates = items.map(InventoryCandidate.from).toList();
+          observed = timestamp;
+          partial = incomplete;
+          rows = candidates;
+        default:
+          throw const FormatException();
+      }
+    } catch (e) {
+      if (!mounted || !widget.canView()) return;
+      error = switch (e) {
+        HealthFailure(status: 404) => '此设备的观测记录不可用。',
+        HealthFailure(status: 403 || 401) => '已无权查看设备观测。',
+        _ => '无法读取设备观测，请重试。',
+      };
+    } finally {
+      if (mounted) setState(() => loading = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!widget.canView()) return const SizedBox.shrink();
+    final registered = {for (final entry in widget.entries) entry['ip']};
+    return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+      Text('最近设备观测', style: Theme.of(context).textTheme.titleMedium),
+      if (loading)
+        const LinearProgressIndicator()
+      else ...[
+        if (error != null)
+          Text(error!)
+        else if (observed == null)
+          const Text('暂无设备观测记录')
+        else ...[
+          Text('观测时间 ${observed.toString().split('.').first}'),
+          if (partial) const Text('未扫完，仅显示已获得的结果。'),
+          if (rows.isEmpty) const Text('本次观测没有设备'),
+          for (final row in rows)
+            ListTile(
+                contentPadding: EdgeInsets.zero,
+                title: Text(row.router ? '${row.ip} · 路由器' : row.ip),
+                subtitle: Text([
+                  if (row.hostname.isNotEmpty) row.hostname,
+                  row.ping ? '回应 ping' : '未回应 ping',
+                  '打印端口 ${row.ports.isEmpty ? '无' : row.ports.join('、')}',
+                ].join(' · ')),
+                trailing: row.registered || registered.contains(row.ip)
+                    ? const Text('已登记')
+                    : TextButton(
+                        onPressed: widget.entries.length < 32
+                            ? () => widget.onAdd(row)
+                            : null,
+                        child: const Text('添加'))),
+          const Text('打印机建议在门店路由器上固定 IP，否则换 IP 后检查会失败。'),
+        ],
+        TextButton(onPressed: read, child: const Text('刷新观测记录')),
+      ],
+    ]);
+  }
+}
