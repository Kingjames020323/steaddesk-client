diff --git a/flutter/lib/steaddesk/support_help_queue.dart b/flutter/lib/steaddesk/support_help_queue.dart
new file mode 100644
index 0000000..45a6b32
--- /dev/null
+++ b/flutter/lib/steaddesk/support_help_queue.dart
@@ -0,0 +1,237 @@
+import 'package:flutter/material.dart';
+import 'package:uuid/uuid.dart';
+import 'cases/case_dialog.dart' show caseCategoryLabels, caseResultLabels;
+import 'support_help.dart';
+
+class SupportHelpQueue extends StatefulWidget {
+  final SupportHelpApi api;
+  final List<HelpRow>? rows;
+  final String? error;
+  final Future<void> Function() onRefresh;
+  final Future<void> Function(HelpRow) onConnect;
+  const SupportHelpQueue(
+      {super.key,
+      required this.api,
+      required this.rows,
+      required this.error,
+      required this.onRefresh,
+      required this.onConnect});
+  @override
+  State<SupportHelpQueue> createState() => _SupportHelpQueueState();
+}
+
+class _SupportHelpQueueState extends State<SupportHelpQueue> {
+  String? busy, issue;
+  final details = <(String, int), Future<HelpRow>>{};
+  final stores = <String, Future<String?>>{};
+  @override
+  void didUpdateWidget(SupportHelpQueue old) {
+    super.didUpdateWidget(old);
+    if (!identical(widget.rows, old.rows)) {
+      final activeKeys = (widget.rows ?? const <HelpRow>[])
+          .map((r) => (r['id'] as String, r['version'] as int))
+          .toSet();
+      details.removeWhere((key, _) => !activeKeys.contains(key));
+      if (activeKeys.isEmpty) stores.clear();
+    }
+  }
+
+  Future<HelpRow> _detail(HelpRow row) async {
+    final data = await widget.api.detail(row['id']);
+    if (data['state'] != row['state'] || data['version'] != row['version'])
+      throw const HelpStaffError(409);
+    final group = data['group_id'];
+    if (group is String && data['lane'] == 'verified') {
+      try {
+        data['store_name'] =
+            await stores.putIfAbsent(group, () => widget.api.storeName(group));
+      } on HelpStaffError catch (e) {
+        stores.remove(group);
+        if (e.status != 404 && e.status != 403) rethrow;
+      }
+    }
+    final history = (data['history'] as List).cast<HelpRow>();
+    if (history.any((e) => e['kind'] == 'help.diagnostic_updated') &&
+        data['lane'] == 'unverified') {
+      data['client_health'] = await widget.api.clientHealth(row['id']);
+    }
+    return data;
+  }
+
+  Future<void> _manualClose(HelpRow row) async {
+    String category = helpCategories[row['category']] ?? 'other';
+    String? result;
+    final confirmed = await showDialog<bool>(
+        context: context,
+        useRootNavigator: false,
+        builder: (ctx) => StatefulBuilder(
+            builder: (_, change) => AlertDialog(
+                    title: const Text('人工跟进结案'),
+                    content: Column(mainAxisSize: MainAxisSize.min, children: [
+                      Text('求助 #${row['id']}'),
+                      DropdownButtonFormField<String>(
+                          value: category,
+                          decoration: const InputDecoration(labelText: '问题类型'),
+                          items: [
+                            for (final e in caseCategoryLabels.entries)
+                              DropdownMenuItem(
+                                  value: e.key, child: Text(e.value))
+                          ],
+                          onChanged: (v) => change(() => category = v!)),
+                      DropdownButtonFormField<String>(
+                          value: result,
+                          decoration: const InputDecoration(labelText: '处理结果'),
+                          items: [
+                            for (final e in caseResultLabels.entries)
+                              DropdownMenuItem(
+                                  value: e.key, child: Text(e.value))
+                          ],
+                          onChanged: (v) => change(() => result = v)),
+                    ]),
+                    actions: [
+                      TextButton(
+                          onPressed: () => Navigator.pop(ctx, false),
+                          child: const Text('返回')),
+                      TextButton(
+                          onPressed: result == null
+                              ? null
+                              : () => Navigator.pop(ctx, true),
+                          child: const Text('保存结案')),
+                    ])));
+    if (!mounted || confirmed != true) return;
+    await widget.api.closeCase({
+      'id': const Uuid().v4(),
+      'agent': widget.api.account,
+      ...helpCaseFields(widget.api, row)
+    }, category, result!);
+  }
+
+  Future<void> _act(HelpRow row) async {
+    setState(() {
+      busy = row['id'];
+      issue = null;
+    });
+    try {
+      final ticket = row['state'] == 'claimed'
+          ? await widget.api.detail(row['id'])
+          : await widget.api.claim(row);
+      if (!mounted) return;
+      if (ticket['state'] != 'claimed' ||
+          ticket['handler'] != widget.api.account) {
+        throw const HelpStaffError(409);
+      }
+      if (verifiedHelpDevice(ticket) != null) {
+        await widget.onConnect(ticket);
+      } else if (row['state'] == 'claimed') {
+        await _manualClose(ticket);
+      } else {
+        setState(() => issue = '已认领，等待人工核验。');
+      }
+    } catch (e) {
+      if (mounted)
+        setState(() => issue = e is HelpStaffError
+            ? e.toString()
+            : const HelpStaffError(0).toString());
+    } finally {
+      if (mounted) {
+        setState(() => busy = null);
+        await widget.onRefresh();
+      }
+    }
+  }
+
+  Widget _entry(HelpRow row) => FutureBuilder<HelpRow>(
+      key: ValueKey((row['id'], row['version'])),
+      future:
+          details.putIfAbsent((row['id'], row['version']), () => _detail(row)),
+      builder: (_, snap) {
+        final detail = snap.data;
+        final verified = row['lane'] == 'verified';
+        final claimed = row['state'] == 'claimed';
+        final stamp = DateTime.fromMillisecondsSinceEpoch(
+            ((detail?['queued_at'] ?? row['created_at']) as int) * 1000);
+        final minutes =
+            DateTime.now().difference(stamp).inMinutes.clamp(0, 9999999);
+        final callback = detail?['callback_requested_at'];
+        final store =
+            verified ? (detail?['store_name'] ?? '门店资料暂不可用') : '门店待核验';
+        final caption = [
+          '已等 $minutes 分钟',
+          if (detail != null)
+            helpDiagnostic(detail)
+          else if (snap.hasError)
+            '诊断暂不可用'
+          else
+            '正在读取诊断…',
+          if (row['state'] == 'callback_requested') ...[
+            '申请回电：${callback is int ? DateTime.fromMillisecondsSinceEpoch(callback * 1000).toLocal().toString().split('.').first : '时间暂不可用'}',
+            '电话：${detail?['callback_phone'] ?? '未提供'}',
+          ]
+        ];
+        return ListTile(
+            title: Text('$store · ${helpReasons[row['category']] ?? '其他'}'),
+            subtitle: Text(caption.join(' · ')),
+            trailing: TextButton(
+                onPressed:
+                    busy == null && detail != null ? () => _act(row) : null,
+                child: Text(claimed ? (verified ? '连接' : '人工结案') : '认领')));
+      });
+
+  @override
+  Widget build(BuildContext context) {
+    final rows = widget.rows ?? const <HelpRow>[];
+    final entries = <Object>[];
+    void section(String label, bool Function(HelpRow) accept) {
+      entries.add(label);
+      final matches = rows.where(accept).toList();
+      if (matches.isEmpty) {
+        entries.add(const Text('暂无求助单'));
+      } else {
+        entries.addAll(matches);
+      }
+    }
+
+    if (widget.rows != null) {
+      section('已验证', (r) => r['state'] == 'queued' && r['lane'] == 'verified');
+      section('未验证 · 人工核验',
+          (r) => r['state'] == 'queued' && r['lane'] == 'unverified');
+      section('预约回电', (r) => r['state'] == 'callback_requested');
+      section('我已认领', (r) => r['state'] == 'claimed');
+    }
+    return AlertDialog(
+        title: const Text('求助队列'),
+        content: SizedBox(
+            width: 640,
+            height: 430,
+            child:
+                Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+              if (issue != null || widget.error != null)
+                Text(issue ?? widget.error!),
+              Expanded(
+                  child: ListView.builder(
+                      itemCount: entries.length,
+                      itemBuilder: (_, i) {
+                        final item = entries[i];
+                        if (item is HelpRow) return _entry(item);
+                        if (item is Widget) return item;
+                        return Padding(
+                            padding: const EdgeInsets.symmetric(vertical: 8),
+                            child: Text('$item',
+                                style: const TextStyle(
+                                    fontWeight: FontWeight.bold)));
+                      })),
+            ])),
+        actions: [
+          TextButton(
+              onPressed: () async {
+                details.clear();
+                stores.clear();
+                await widget.onRefresh();
+              },
+              child: const Text('刷新')),
+          TextButton(
+              onPressed: () => Navigator.of(context, rootNavigator: true).pop(),
+              child: const Text('返回')),
+        ]);
+  }
+}
