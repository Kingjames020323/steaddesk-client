+// Run against an isolated loopback fixture. Credentials are read from a private
+// temporary file, never included in the public test or printed.
+import 'dart:convert';
+import 'dart:io';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:uuid/uuid.dart';
+import '../lib/steaddesk/support_help.dart';
+import '../lib/steaddesk/cases/case_store.dart';
+
+void main() {
+  test('two operators, self-service disappearance and H-1 round-trip',
+      () async {
+    final config = jsonDecode(
+        await File(Platform.environment['HELP_QUEUE_DRILL']!).readAsString());
+    final base = Uri.parse(config['origin']);
+    expect(base.host, '127.0.0.1');
+    final api = [
+      for (final account in (config['accounts'] as Map).entries)
+        SupportHelpApi(base, account.key, account.value, () => true)
+    ];
+    final client = HttpClient()..findProxy = (_) => 'DIRECT';
+    addTearDown(() {
+      for (final a in api) {
+        a.dispose();
+      }
+      client.close(force: true);
+    });
+    Future<HelpRow> merchant(String receipt, String method, String route,
+        [HelpRow? body, int? version]) async {
+      final req =
+          await client.openUrl(method, base.resolve('/ops/v1/help/me/$route'));
+      req.followRedirects = false;
+      req.headers.set('Authorization', receipt);
+      req.headers.set('Idempotency-Key', const Uuid().v4());
+      if (version != null) req.headers.set('If-Match', '"$version"');
+      if (body != null) {
+        final payload = utf8.encode(jsonEncode(body));
+        req.headers.contentType = ContentType.json;
+        req.contentLength = payload.length;
+        req.add(payload);
+      }
+      final response = await req.close();
+      final json = jsonDecode(await utf8.decoder.bind(response).join());
+      expect(response.statusCode, 200, reason: json['code'] as String?);
+      return json as HelpRow;
+    }
+
+    final rows = await api.first.queue();
+    final primary = rows.singleWhere((r) => r['id'] == config['primary']);
+    final self = rows.singleWhere((r) => r['id'] == config['self']);
+    final callback = rows.singleWhere((r) => r['id'] == config['callback']);
+    final cb = await api.first.detail(callback['id']);
+    expect(cb['callback_requested_at'], isA<int>());
+    expect(cb['callback_phone'], isNull);
+    expect(verifiedHelpDevice(cb), isNull);
+    final followed = await api.first.claim(callback);
+    expect(verifiedHelpDevice(followed), isNull);
+    expect(followed['handler'], api.first.account);
+    await api.first.closeCase({
+      'id': const Uuid().v4(),
+      'agent': api.first.account,
+      ...helpCaseFields(api.first, followed)
+    }, 'pos_operation', 'not_needed');
+    final manualClosed = await api.first.detail(callback['id']);
+    expect(manualClosed['case_records'].single['result'], 'not_needed');
+    final results = await Future.wait(api.map((a) async {
+      try {
+        return await a.claim(primary);
+      } on HelpStaffError catch (e) {
+        return {'status': e.status};
+      }
+    }));
+    expect(results.where((r) => r['status'] == 409), hasLength(1));
+    final index = results.indexWhere((r) => r['state'] == 'claimed');
+    expect(index, isNonNegative);
+    final winner = api[index], claimed = results[index];
+    expect(verifiedHelpDevice(claimed), config['device']);
+    expect(await winner.storeName(claimed['group_id']), 'Fixture store');
+    final cards = await merchant(config['selfReceipt'], 'GET', 'step-cards');
+    final card = cards['cards'].first;
+    await merchant(
+        config['selfReceipt'],
+        'POST',
+        'self-resolve',
+        {'card_id': card['card_id'], 'card_version': card['card_version']},
+        self['version']);
+    expect((await winner.queue()).where((r) => r['id'] == self['id']), isEmpty);
+    final dir = await Directory.systemTemp.createTemp('help-close-fixture');
+    addTearDown(() => dir.delete(recursive: true));
+    final store = LocalCaseStore(
+        file: () async => File('${dir.path}/cases.json'),
+        writeHelp: winner.closeCase);
+    final id = const Uuid().v4(), now = DateTime.now().toUtc();
+    final record = {
+      'id': id,
+      'agent': winner.account,
+      'device_id': config['device'],
+      'started_at': now.subtract(const Duration(minutes: 1)).toIso8601String(),
+      'ended_at': now.toIso8601String(),
+      ...helpCaseFields(winner, claimed)
+    };
+    await store.addDraft(winner.account, record);
+    final draft = (await store.pending(winner.account)).single;
+    expect(draft['help_id'], primary['id']);
+    expect(draft['category'], 'pos_operation');
+    await merchant(config['primaryReceipt'], 'PUT', 'diagnostic', {
+      'v': 1,
+      'sampled_at': now.millisecondsSinceEpoch ~/ 1000,
+      'health': 'unknown',
+      'self_heal': []
+    });
+    final changed = await winner.detail(primary['id']);
+    expect(changed['version'], greaterThan(draft['help_version']));
+    await store.save(winner.account, id,
+        category: 'pos_operation', result: 'resolved', note: '');
+    await winner.closeCase(
+        draft, 'pos_operation', 'resolved'); // post-commit response loss
+    expect(await store.pending(winner.account), isEmpty);
+    final closed = await winner.detail(primary['id']);
+    expect(closed['state'], 'closed');
+    expect(closed['close_result'], 'resolved');
+    expect(closed['case_records'], hasLength(1));
+    expect(closed['case_records'][0]['category'], 'pos_operation');
+    expect(closed['case_records'][0]['closed_by'], winner.account);
+    print('PASS loopback claims=200/409 self_resolved_absent callback_manual '
+        'diagnostic_version_advanced H1_saved server_case_records=1 retry_no_duplicate');
+  });
