+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import '../../lib/steaddesk/support_help.dart';
+import '../../lib/steaddesk/support_help_queue.dart';
+import '../../lib/steaddesk/cases/case_session_ledger.dart';
+
+class FixtureApi extends Fake implements SupportHelpApi {
+  @override
+  String get account => 'fixture';
+  @override
+  Uri get base => Uri.parse('https://example.invalid/ops/v1/');
+  final closed = <String>[];
+  @override
+  Future<void> closeCase(HelpRow record, String issue, String result) async {
+    closed.add('${record['help_id']}:$issue:$result');
+  }
+
+  final rows = <String, HelpRow>{};
+  @override
+  Future<HelpRow> detail(String id) async => rows[id]!;
+  @override
+  Future<String?> storeName(String? id) async => 'Fixture Store';
+  @override
+  Future<HelpRow> claim(HelpRow row) async => {
+        ...rows[row['id']]!,
+        'state': 'claimed',
+        'handler': account,
+        'version': 2
+      };
+}
+
+void main() {
+  test(
+      'only an authenticated matching round accepts a claim, including a short session',
+      () async {
+    final saved = <HelpRow>[];
+    final ledger = CaseSessionLedger((event) =>
+        {'id': 'round', 'agent': 'agent', 'device_id': event['device_id']});
+    final fields = {'help_id': 'fixture', 'category': 'crash'};
+    expect(ledger.linkActive('790001001', 'agent', fields), isFalse);
+    await ledger.receive({
+      'kind': 'established',
+      'event_id': '1',
+      'connection': 'conn',
+      'at': '2026-01-01T00:00:00Z',
+      'device_id': '790001001'
+    }, (_) async => true);
+    expect(ledger.linkActive('790001002', 'agent', fields), isFalse);
+    expect(ledger.linkActive('790001001', 'other', fields), isFalse);
+    expect(ledger.linkActive('790001001', 'agent', fields), isTrue);
+    await ledger.receive({
+      'kind': 'closed',
+      'event_id': '2',
+      'connection': 'conn',
+      'at': '2026-01-01T00:00:05Z'
+    }, (r) async {
+      saved.add(r);
+      return true;
+    });
+    expect(saved.single['help_id'], 'fixture');
+    expect(saved.single['category'], 'crash');
+    expect(ledger.linkActive('790001001', 'agent', fields), isFalse);
+  });
+
