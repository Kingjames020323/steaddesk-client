diff --git a/flutter/lib/steaddesk/support_help.dart b/flutter/lib/steaddesk/support_help.dart
new file mode 100644
index 0000000..9a50302
--- /dev/null
+++ b/flutter/lib/steaddesk/support_help.dart
@@ -0,0 +1,250 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:uuid/uuid.dart';
+import 'ops_groups.dart' show opsEndpoint;
+
+typedef HelpRow = Map<String, dynamic>;
+const helpCategories = {
+  'printer': 'printer',
+  'menu': 'menu',
+  'checkout': 'pos_operation',
+  'network': 'network',
+  'frozen': 'crash',
+  'other': 'other',
+};
+const helpReasons = {
+  'printer': '打印机',
+  'menu': '菜单',
+  'checkout': '收银操作',
+  'network': '网络',
+  'frozen': '设备卡住',
+  'other': '其他',
+};
+
+class HelpStaffError implements Exception {
+  final int status;
+  const HelpStaffError(this.status);
+  @override
+  String toString() => switch (status) {
+        401 || 403 => '登录已过期或无权处理，请重新登录。',
+        404 => '求助单已不可见，请刷新队列。',
+        409 || 412 => '这张单已发生变化，请刷新后重试。',
+        429 => '请求太频繁，请稍后刷新。',
+        _ => '无法连接求助服务，请稍后重试。',
+      };
+}
+
+class SupportHelpApi {
+  final Uri base;
+  final String account;
+  final String _token;
+  final bool Function() current;
+  final _http = HttpClient()
+    ..connectionTimeout = const Duration(seconds: 6)
+    ..findProxy = (_) => 'DIRECT';
+  SupportHelpApi(Uri origin, this.account, this._token, this.current)
+      : base = opsEndpoint(origin);
+
+  void check() {
+    if (!current()) throw const HelpStaffError(401);
+  }
+
+  void dispose() => _http.close(force: true);
+
+  Future<HelpRow> _request(String path,
+      {Map<String, String>? query,
+      HelpRow? body,
+      int? version,
+      String? key}) async {
+    check();
+    final url = base.resolve(path).replace(queryParameters: query);
+    final req = await _http
+        .openUrl(body == null ? 'GET' : 'POST', url)
+        .timeout(const Duration(seconds: 8));
+    check();
+    req.followRedirects = false;
+    req.headers.set(HttpHeaders.authorizationHeader, 'Bearer $_token');
+    if (body != null) {
+      req.headers.contentType = ContentType.json;
+      req.headers.set('Idempotency-Key', key ?? const Uuid().v4());
+      req.headers.set('If-Match', '"$version"');
+      final payload = utf8.encode(jsonEncode(body));
+      req.contentLength = payload.length;
+      req.add(payload);
+    }
+    final response = await req.close().timeout(const Duration(seconds: 12));
+    if (response.statusCode != 200) {
+      await response.listen((_) {}).cancel();
+      throw HelpStaffError(response.statusCode);
+    }
+    final bytes = <int>[];
+    await for (final part in response.timeout(const Duration(seconds: 8))) {
+      if (bytes.length + part.length > 4 * 1024 * 1024)
+        throw const HelpStaffError(500);
+      bytes.addAll(part);
+    }
+    check();
+    return jsonDecode(utf8.decode(bytes)) as HelpRow;
+  }
+
+  Future<List<HelpRow>> queue() async {
+    final visible = <String, HelpRow>{};
+    for (final state in ['queued', 'callback_requested', 'claimed']) {
+      var offset = 0;
+      while (true) {
+        final page = await _request('help/queue', query: {
+          'state': state,
+          'limit': '100',
+          'offset': '$offset',
+        });
+        for (final row in (page['tickets'] as List).cast<HelpRow>()) {
+          if (state == 'claimed' && row['handler'] != account) continue;
+          final id = row['id'] as String;
+          if (visible[id] == null ||
+              row['version'] >= visible[id]!['version']) {
+            visible[id] = row;
+          }
+        }
+        final next = page['next_offset'];
+        if (next == null) break;
+        if (next is! int || next <= offset) throw const HelpStaffError(500);
+        offset = next;
+      }
+    }
+    return visible.values.toList();
+  }
+
+  String _ticket(String id) {
+    if (!RegExp(r'^[hu]_[a-f0-9]{32}$').hasMatch(id))
+      throw const HelpStaffError(404);
+    return 'help/requests/$id';
+  }
+
+  Future<HelpRow> detail(String id) => _request(_ticket(id));
+
+  Future<String?> clientHealth(String id) async {
+    try {
+      final value = await _request('${_ticket(id)}/attachments/diagnostic');
+      if (value['source'] != 'client_self_report') return null;
+      return value['data']?['health'] as String?;
+    } on HelpStaffError catch (e) {
+      if (e.status == 404) return null;
+      rethrow;
+    }
+  }
+
+  Future<String?> storeName(String? group) async {
+    if (group == null || !RegExp(r'^[a-zA-Z0-9_-]+$').hasMatch(group))
+      return null;
+    final row = await _request('groups/$group');
+    return row['name'] as String?;
+  }
+
+  Future<HelpRow> claim(HelpRow row) async {
+    final id = row['id'] as String;
+    final response = await _request('${_ticket(id)}/claim',
+        body: {}, version: row['version'] as int);
+    final detail = await this.detail(id);
+    if (response['state'] != 'claimed' ||
+        detail['state'] != 'claimed' ||
+        _claimVersion(detail) != _claimVersion(response, fallback: true) ||
+        detail['handler'] != account) {
+      throw const HelpStaffError(409);
+    }
+    return detail;
+  }
+
+  static int? _claimVersion(HelpRow row, {bool fallback = false}) {
+    final history = row['history'] as List?;
+    if (history == null) return fallback ? row['version'] as int? : null;
+    for (final event in history.reversed.cast<HelpRow>()) {
+      if (event['kind'] == 'help.claimed') return event['version'] as int;
+    }
+    return null;
+  }
+
+  Future<void> closeCase(HelpRow record, String issue, String result) async {
+    if (record['agent'] != account ||
+        record['help_origin'] != base.toString()) {
+      throw const HelpStaffError(403);
+    }
+    final id = record['help_id'] as String;
+    final version = record['help_version'] as int;
+    final before = await detail(id);
+    // A lost response (or a failed local file write) can be retried after restart,
+    // even after the merchant reopened the ticket and the next round began.
+    final history = (before['history'] as List).cast<HelpRow>();
+    final claim = history.where((e) =>
+        e['version'] == version &&
+        e['kind'] == 'help.claimed' &&
+        e['handler'] == account);
+    if (claim.isEmpty) throw const HelpStaffError(409);
+    final later = history.where((e) => e['version'] > version);
+    for (final e in later) {
+      if (e['kind'] == 'help.closed') {
+        final same = (before['case_records'] as List).cast<HelpRow>().any((r) =>
+            r['version'] == e['version'] &&
+            r['closed_by'] == account &&
+            r['category'] == issue &&
+            r['result'] == result);
+        if (same) return;
+        throw const HelpStaffError(409);
+      }
+      if (e['state'] != 'claimed' ||
+          e['handler'] != account ||
+          e['kind'] == 'help.claimed') {
+        throw const HelpStaffError(409);
+      }
+    }
+    if (before['state'] != 'claimed' || before['handler'] != account)
+      throw const HelpStaffError(409);
+    final expected = before['version'] as int;
+    await _request('${_ticket(id)}/close',
+        version: expected,
+        key:
+            const Uuid().v5(record['id'] as String, '$expected:$issue:$result'),
+        body: {'close_issue_type': issue, 'close_result': result});
+  }
+}
+
+String? verifiedHelpDevice(HelpRow row) {
+  final id = row['device_id'];
+  return row['lane'] == 'verified' &&
+          id is String &&
+          RegExp(r'^[0-9]{9,10}$').hasMatch(id)
+      ? id
+      : null;
+}
+
+HelpRow helpCaseFields(SupportHelpApi api, HelpRow ticket) => {
+      'help_id': ticket['id'],
+      'help_version': SupportHelpApi._claimVersion(ticket),
+      'help_origin': api.base.toString(),
+      'category': helpCategories[ticket['category']],
+    };
+
+String helpDiagnostic(HelpRow row) {
+  final diag = row['server_diagnostic'];
+  if (diag is! Map && row['client_health'] is String) {
+    final label = const {
+      'unknown': '未知',
+      'attention': '关注',
+      'normal': '正常',
+      'alert': '告警'
+    }[row['client_health']];
+    return '客户端自述 · 设备健康：${label ?? '未知'}';
+  }
+  if (diag is! Map)
+    return row['lane'] == 'unverified' ? '未验证 · 无服务端诊断' : '暂无诊断';
+  final status = diag['health']?['status'];
+  final health = const {
+        'normal': '正常',
+        'alert': '告警',
+        'attention': '关注',
+        'unknown': '未知'
+      }[status] ??
+      '未知';
+  final check = diag['check']?['state'];
+  return '设备健康：$health' + (check == null ? '' : ' · 快速检查 $check');
+}
diff --git a/flutter/lib/steaddesk/support_help_host.dart b/flutter/lib/steaddesk/support_help_host.dart
new file mode 100644
index 0000000..c35b728
--- /dev/null
+++ b/flutter/lib/steaddesk/support_help_host.dart
@@ -0,0 +1,190 @@
+import 'dart:async';
+import 'dart:convert';
+import 'package:flutter/material.dart';
+import 'package:uuid/uuid.dart';
+
+import '../common.dart' show connect, gFFI;
+import '../models/platform_model.dart' show bind;
+import 'case_session_api.dart' show CaseSession;
+import 'support_help.dart';
+import 'support_help_queue.dart';
+
+typedef _Login = ({String account, String token});
+_Login? _login() {
+  try {
+    final account =
+        jsonDecode(bind.mainGetLocalOption(key: 'user_info'))['name'];
+    final token = bind.mainGetLocalOption(key: 'access_token');
+    if (account is String && account.isNotEmpty && token.isNotEmpty) {
+      return (account: account, token: token);
+    }
+  } catch (_) {}
+  return null;
+}
+
+Uri? _configuredOrigin() =>
+    Uri.tryParse(bind.mainGetOptionSync(key: 'api-server'));
+
+Future<void> writeHelpCase(HelpRow row, String issue, String result) async {
+  final login = _login();
+  if (login == null || login.account != row['agent'])
+    throw const HelpStaffError(401);
+  final origin = _configuredOrigin();
+  if (origin == null) throw const HelpStaffError(503);
+  final api = SupportHelpApi(origin, login.account, login.token,
+      () => login == _login() && origin == _configuredOrigin());
+  try {
+    await api.closeCase(row, issue, result);
+  } finally {
+    api.dispose();
+  }
+}
+
+class SupportHelpHeader extends StatefulWidget {
+  const SupportHelpHeader({super.key});
+  @override
+  State<SupportHelpHeader> createState() => _SupportHelpHeaderState();
+}
+
+class _SupportHelpHeaderState extends State<SupportHelpHeader> {
+  _Login? login;
+  Uri? origin;
+  SupportHelpApi? api;
+  List<HelpRow>? tickets;
+  int version = 0;
+  String? error;
+  Timer? timer;
+  late final StreamSubscription<String> accountEvents;
+  final queueChanges = ValueNotifier(0);
+  Route<void>? opened;
+  bool refreshing = false;
+  @override
+  void initState() {
+    super.initState();
+    accountEvents = gFFI.userModel.userName.listen((_) => _refresh());
+    timer = Timer.periodic(const Duration(seconds: 12), (_) => _refresh());
+    scheduleMicrotask(_refresh);
+  }
+
+  void _retire() {
+    version++;
+    api?.dispose();
+    api = null;
+    tickets = null;
+    error = null;
+    final route = opened;
+    if (route != null && route.isActive) route.navigator?.removeRoute(route);
+  }
+
+  Future<void> _refresh() async {
+    if (!mounted) return;
+    final now = _login();
+    if (now != login) {
+      _retire();
+      setState(() => login = now);
+    }
+    if (now == null || refreshing) return;
+    refreshing = true;
+    final guard = version;
+    try {
+      final target = _configuredOrigin();
+      if (target == null) throw const HelpStaffError(503);
+      if (!mounted || version != guard || _login() != now) return;
+      if (origin != target) {
+        _retire();
+        origin = target;
+      }
+      api ??= SupportHelpApi(
+          target,
+          now.account,
+          now.token,
+          () =>
+              mounted &&
+              now == _login() &&
+              target == _configuredOrigin() &&
+              target == origin);
+      final active = api!;
+      final rows = await active.queue();
+      if (!mounted || active != api || _login() != now) return;
+      setState(() {
+        tickets = rows;
+        error = null;
+      });
+      queueChanges.value++;
+    } catch (e) {
+      if (mounted && now == _login()) {
+        setState(() {
+          tickets = null;
+          error = e is HelpStaffError
+              ? e.toString()
+              : const HelpStaffError(0).toString();
+        });
+        queueChanges.value++;
+      }
+    } finally {
+      refreshing = false;
+      if (mounted && now != _login()) scheduleMicrotask(_refresh);
+    }
+  }
+
+  Future<void> _open() async {
+    if (api == null) {
+      await _refresh();
+      if (!mounted) return;
+      if (api == null) {
+        ScaffoldMessenger.maybeOf(context)
+            ?.showSnackBar(SnackBar(content: Text(error ?? '请配置求助服务地址。')));
+        return;
+      }
+    }
+    final active = api!;
+    final nav = Navigator.of(context, rootNavigator: true);
+    final route = DialogRoute<void>(
+        context: context,
+        builder: (ctx) => Navigator(
+            onGenerateRoute: (_) => PageRouteBuilder<void>(
+                opaque: false,
+                pageBuilder: (inner, __, ___) => ValueListenableBuilder<int>(
+                    valueListenable: queueChanges,
+                    builder: (_, revision, __) => SupportHelpQueue(
+                        api: active,
+                        rows: tickets,
+                        error: error,
+                        onRefresh: _refresh,
+                        onConnect: (row) async {
+                          active.check();
+                          final id = verifiedHelpDevice(row);
+                          if (id == null ||
+                              row['state'] != 'claimed' ||
+                              row['handler'] != active.account) {
+                            throw const HelpStaffError(403);
+                          }
+                          // The nonce only correlates a local launch with its authenticated peer_info event.
+                          final attempt = const Uuid().v4();
+                          CaseSession.linkHelp(attempt, id, active.account,
+                              helpCaseFields(active, row));
+                          Navigator.of(ctx).pop();
+                          await connect(context, id, helpAttempt: attempt);
+                        })))));
+    opened = route;
+    nav.push(route);
+    await route.completed;
+    if (identical(opened, route)) opened = null;
+    if (mounted) await _refresh();
+  }
+
+  @override
+  void dispose() {
+    timer?.cancel();
+    accountEvents.cancel();
+    _retire();
+    queueChanges.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => TextButton(
+      onPressed: login == null ? null : _open,
+      child: Text(
+          '求助 ${tickets?.where((r) => r['state'] != 'claimed').length ?? '—'}'));
+}
