diff --git a/flutter/lib/steaddesk/toolbar/actions.dart b/flutter/lib/steaddesk/toolbar/actions.dart
new file mode 100644
index 0000000..99206d3
--- /dev/null
+++ b/flutter/lib/steaddesk/toolbar/actions.dart
@@ -0,0 +1,69 @@
+import 'dart:convert';
+import 'dart:math' as math;
+import 'dart:typed_data';
+import 'package:crypto/crypto.dart';
+import 'package:uuid/uuid.dart';
+
+typedef ToolbarJson = Map<String, dynamic>;
+typedef ToolbarRequest = Future<ToolbarJson>
+    Function(String method, String path, [ToolbarJson? body]);
+
+enum ToolbarAction {
+  quick('quick_check', '快速检查'),
+  logs('collect_logs', '收集日志'),
+  screenshot('screenshot', '截图附单');
+
+  const ToolbarAction(this.wire, this.label);
+  final String wire, label;
+}
+
+String toolbarSessionRoute(
+    {required String peer,
+    required String session,
+    required String connection,
+    required bool cases,
+    required String? caseId}) {
+  if (!RegExp(r'^[0-9]{9,10}$').hasMatch(peer)) {
+    throw const FormatException('设备编号无效。');
+  }
+  if (cases && caseId == null) throw const FormatException('正在等待当前结案记录。');
+  final id = caseId ??
+      const Uuid().v5(
+          Uuid.NAMESPACE_URL, 'steaddesk/session/$peer/$session/$connection');
+  if (!Uuid.isValidUUID(fromString: id)) throw const FormatException('会话编号无效。');
+  return 'toolbar/$peer/$id';
+}
+
+const chunkSize = 32768;
+Future<void> submitToolbarAction(ToolbarRequest request, String route,
+    ToolbarAction action, bool Function() current,
+    {String? ticket, Uint8List? png}) async {
+  void check() {
+    if (!current()) throw const FormatException('会话或登录状态已变化。');
+  }
+
+  check();
+  final body = <String, dynamic>{
+    'action': action.wire,
+    if (ticket != null) 'ticket_id': ticket,
+  };
+  if (action == ToolbarAction.screenshot) {
+    if (png == null || png.isEmpty || png.length > 512 * 1024) {
+      throw const FormatException('截图超过大小限制或画面不可用。');
+    }
+    body['size'] = png.length;
+    body['sha256'] = sha256.convert(png).toString();
+  }
+  final row = await request('POST', route, body);
+  if (action != ToolbarAction.screenshot) return;
+  final id = row['id'];
+  if (id is! String || !RegExp(r'^[a-zA-Z0-9_-]{1,100}$').hasMatch(id)) {
+    throw const FormatException('无效的附件编号。');
+  }
+  for (int start = 0; start < png!.length; start += chunkSize) {
+    check();
+    final end = math.min(start + chunkSize, png.length);
+    await request('PUT', '$route/$id/chunks/${start ~/ chunkSize}',
+        {'data': base64Encode(Uint8List.sublistView(png, start, end))});
+  }
+}
diff --git a/flutter/lib/steaddesk/toolbar/archive.dart b/flutter/lib/steaddesk/toolbar/archive.dart
new file mode 100644
index 0000000..ac84404
--- /dev/null
+++ b/flutter/lib/steaddesk/toolbar/archive.dart
@@ -0,0 +1,163 @@
+part of 'host.dart';
+
+bool _validActionId(dynamic id) =>
+    id is String && RegExp(r'^t_[0-9A-HJKMNP-TV-Z]{26}$').hasMatch(id);
+
+String _localTime(dynamic stamp) => stamp is int
+    ? DateTime.fromMillisecondsSinceEpoch(stamp * 1000)
+        .toLocal()
+        .toString()
+        .split('.')
+        .first
+    : '';
+
+Future<T?> _guardedDialog<T>(BuildContext context, bool Function() current,
+    Widget Function(BuildContext) builder) async {
+  if (!current()) return null;
+  Route<dynamic>? route;
+  final timer = Timer.periodic(const Duration(milliseconds: 500), (_) {
+    final shown = route;
+    if (!current() && shown != null && shown.isActive) {
+      shown.navigator?.removeRoute(shown);
+    }
+  });
+  try {
+    return await showDialog<T>(
+        context: context,
+        builder: (ctx) {
+          route = ModalRoute.of(ctx);
+          return current() ? builder(ctx) : const SizedBox.shrink();
+        });
+  } finally {
+    timer.cancel();
+  }
+}
+
+Future<void> _previewAttachment(
+    BuildContext context, ToolbarJson result, bool Function() current) async {
+  Widget content;
+  MemoryImage? image;
+  if (result['action'] == 'screenshot') {
+    final bytes = base64Decode(result['data'] as String);
+    if (bytes.length > toolbarPngLimit) {
+      throw const FormatException('附件超过大小限制。');
+    }
+    image = MemoryImage(bytes);
+    content = Image(image: image, fit: BoxFit.contain);
+  } else if (result['action'] == 'collect_logs') {
+    final rows = List<ToolbarJson>.from(result['data'] as List);
+    content = ListView.builder(
+        itemCount: rows.length,
+        itemBuilder: (_, i) =>
+            Text("${rows[i]['source']} · ${rows[i]['event']}"));
+  } else {
+    throw const FormatException('无效的附件类型。');
+  }
+  try {
+    await _guardedDialog<void>(
+        context,
+        current,
+        (ctx) => AlertDialog(
+                title: const Text('工单附件'),
+                content: SizedBox(width: 640, height: 420, child: content),
+                actions: [
+                  TextButton(
+                      onPressed: () => Navigator.pop(ctx),
+                      child: const Text('关闭'))
+                ]));
+  } finally {
+    await image?.evict();
+  }
+}
+
+Widget toolbarCaseAttachments(
+        {required String account,
+        required String peer,
+        required String caseId,
+        String? ticket,
+        String? origin}) =>
+    Builder(
+        builder: (ctx) => TextButton.icon(
+            icon: const Icon(Icons.attachment, size: 16),
+            label: const Text('会话附件'),
+            onPressed: () =>
+                _readCase(ctx, account, peer, caseId, ticket, origin)));
+
+Future<void> _readCase(BuildContext ctx, String account, String peer,
+    String caseId, String? ticket, String? origin) async {
+  final owner = _login();
+  bool current() =>
+      ctx.mounted &&
+      owner != null &&
+      owner.name == account &&
+      owner == _login();
+  if (!current()) return;
+  OpsHealthHttp? http;
+  try {
+    final base = opsEndpoint(Uri.parse(await bind.mainGetApiServer()));
+    if (!current() ||
+        origin != null && opsEndpoint(Uri.parse(origin)) != base) {
+      return;
+    }
+    String listPath, attachmentPath;
+    if (ticket != null) {
+      if (!RegExp(r'^[hu]_[a-f0-9]{32}$').hasMatch(ticket)) return;
+      listPath = 'help/requests/$ticket';
+      attachmentPath = '$listPath/toolbar';
+    } else {
+      if (!RegExp(r'^[0-9]{9,10}$').hasMatch(peer) ||
+          !Uuid.isValidUUID(fromString: caseId)) return;
+      listPath = 'toolbar/$peer/$caseId';
+      attachmentPath = listPath;
+    }
+    http = OpsHealthHttp(base, owner!.token);
+    final detail = await http.request('GET', listPath);
+    if (!current()) return;
+    final rows = List<ToolbarJson>.from(
+        detail[ticket == null ? 'actions' : 'toolbar_actions'] as List? ?? []);
+    final attachments = rows
+        .where((r) =>
+            r['state'] == 'completed' &&
+            {'screenshot', 'collect_logs'}.contains(r['action']) &&
+            _validActionId(r['id']))
+        .toList();
+    final selected = await _guardedDialog<ToolbarJson>(
+        ctx,
+        current,
+        (dialog) => AlertDialog(
+                title: const Text('会话附件'),
+                content: SizedBox(
+                    width: 480,
+                    height: 280,
+                    child: attachments.isEmpty
+                        ? const Text('暂无可查看的附件。')
+                        : ListView(children: [
+                            for (final r in attachments)
+                              ListTile(
+                                  title: Text(_actionLabel(r['action'])),
+                                  subtitle: Text(_localTime(r['created_at'])),
+                                  onTap: () => Navigator.pop(dialog, r))
+                          ])),
+                actions: [
+                  TextButton(
+                      onPressed: () => Navigator.pop(dialog),
+                      child: const Text('关闭'))
+                ]));
+    if (selected == null ||
+        !current() ||
+        opsEndpoint(Uri.parse(await bind.mainGetApiServer())) != base ||
+        !current()) return;
+    final result = await http.request(
+        'GET', "$attachmentPath/${selected['id']}/attachment");
+    if (current() && result['action'] == selected['action']) {
+      await _previewAttachment(ctx, result, current);
+    }
+  } catch (e) {
+    if (current()) {
+      ScaffoldMessenger.maybeOf(ctx)?.showSnackBar(SnackBar(
+          content: Text(e is HealthFailure ? e.toString() : '暂时无法读取附件。')));
+    }
+  } finally {
+    http?.close();
+  }
+}
diff --git a/flutter/lib/steaddesk/toolbar/frame.dart b/flutter/lib/steaddesk/toolbar/frame.dart
new file mode 100644
index 0000000..b5bbf9a
--- /dev/null
+++ b/flutter/lib/steaddesk/toolbar/frame.dart
@@ -0,0 +1,125 @@
+import 'dart:math' as math;
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:flutter/rendering.dart';
+import 'package:flutter/widgets.dart';
+
+const toolbarPngLimit = 512 * 1024;
+
+class _PixelLayer extends RenderRepaintBoundary {
+  Future<ui.Image?> snapshot(Rect bounds, double scale) async {
+    final raster = layer;
+    return raster is OffsetLayer
+        ? raster.toImage(bounds, pixelRatio: scale)
+        : null;
+  }
+}
+
+class _Pixels extends SingleChildRenderObjectWidget {
+  const _Pixels({required super.key, required super.child});
+  @override
+  RenderRepaintBoundary createRenderObject(BuildContext context) =>
+      _PixelLayer();
+}
+
+class ToolbarFrame {
+  final viewport = GlobalKey();
+  final pixels = GlobalKey();
+
+  // The boundary contains only the remote image painter or its texture layers.
+  // Crop against the visible viewport when scrollbars expose only part of it.
+  Widget view(Widget child) => SizedBox(key: viewport, child: child);
+  Widget paint(Widget child) => _Pixels(key: pixels, child: child);
+
+  Future<ui.Image?> readVisible() async {
+    final view = viewport.currentContext?.findRenderObject();
+    final paint = pixels.currentContext?.findRenderObject();
+    if (view is! RenderBox ||
+        paint is! _PixelLayer ||
+        !view.attached ||
+        !paint.attached ||
+        !view.hasSize ||
+        !paint.hasSize) {
+      return null;
+    }
+    final bounds = (Offset.zero & paint.size).intersect(Rect.fromPoints(
+        paint.globalToLocal(view.localToGlobal(Offset.zero)),
+        paint.globalToLocal(
+            view.localToGlobal(view.size.bottomRight(Offset.zero)))));
+    if (bounds.isEmpty || !bounds.isFinite) return null;
+    final scale = math.min(
+        1.0,
+        math.min(1599 / bounds.longestSide,
+            math.sqrt(1597000 / (bounds.width * bounds.height))));
+    return paint.snapshot(bounds, scale);
+  }
+
+  Future<Uint8List> capture(bool Function() current) async {
+    final deadline = Stopwatch()..start();
+    while (current() && deadline.elapsed < const Duration(seconds: 3)) {
+      await WidgetsBinding.instance.endOfFrame
+          .timeout(const Duration(seconds: 2));
+      if (!current()) break;
+      final image = await readVisible();
+      if (image != null) {
+        try {
+          final png = await toolbarPng(image);
+          if (png != null && current()) return png;
+        } finally {
+          image.dispose();
+        }
+      }
+      await Future<void>.delayed(const Duration(milliseconds: 80));
+    }
+    throw const FormatException('当前远程画面尚不可用。');
+  }
+}
+
+Future<Uint8List?> toolbarPng(ui.Image source) async {
+  final rgba = await source.toByteData(format: ui.ImageByteFormat.rawRgba);
+  if (rgba == null) return null;
+  // Missing external textures can rasterize transparent or solid black.
+  int? first;
+  bool hasDetail = false;
+  for (int i = 0; i < rgba.lengthInBytes; i += 4) {
+    if (rgba.getUint8(i + 3) != 255) continue;
+    final pixel = rgba.getUint32(i);
+    first ??= pixel;
+    if (pixel != first) {
+      hasDetail = true;
+      break;
+    }
+  }
+  if (!hasDetail) return null;
+  ui.Image image = source;
+  try {
+    while (true) {
+      final bytes = await image.toByteData(format: ui.ImageByteFormat.png);
+      if (bytes == null) return null;
+      if (bytes.lengthInBytes <= toolbarPngLimit) {
+        return bytes.buffer
+            .asUint8List(bytes.offsetInBytes, bytes.lengthInBytes);
+      }
+      final w = (image.width * .7).floor().clamp(1, image.width);
+      final h = (image.height * .7).floor().clamp(1, image.height);
+      final recorder = ui.PictureRecorder();
+      final canvas = ui.Canvas(recorder);
+      canvas.drawImageRect(
+          source,
+          Offset.zero & Size(source.width.toDouble(), source.height.toDouble()),
+          Offset.zero & Size(w.toDouble(), h.toDouble()),
+          ui.Paint()..filterQuality = ui.FilterQuality.medium);
+      final picture = recorder.endRecording();
+      try {
+        final resized = await picture.toImage(w, h);
+        if (!identical(image, source)) image.dispose();
+        image = resized;
+      } finally {
+        picture.dispose();
+      }
+    }
+  } finally {
+    if (!identical(image, source)) image.dispose();
+  }
+}
