+import 'dart:async';
+import 'dart:convert';
+import 'dart:math';
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+import 'package:crypto/crypto.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/toolbar/actions.dart';
+import 'package:flutter_hbb/steaddesk/toolbar/frame.dart';
+
+void main() {
+  test('a delayed H-1 binding never gets replaced by a standalone case', () {
+    String route(bool cases, String connection, [String? id]) =>
+        toolbarSessionRoute(
+            peer: '123456789',
+            session: 'e6295b7a-c04d-436b-9cfa-0c607896fd81',
+            connection: connection,
+            cases: cases,
+            caseId: id);
+    expect(() => route(true, '1'), throwsFormatException);
+    const id = 'adfc9434-2ae5-4fe7-aa66-5f29ad781285';
+    expect(route(true, '1', id), 'toolbar/123456789/$id');
+    expect(route(false, '1'), route(false, '1'));
+    expect(route(false, '1'), isNot(route(false, '2')));
+  });
+
+  testWidgets('high entropy PNG is reduced to the attachment budget',
+      (tester) async {
+    await tester.runAsync(() async {
+      const size = 640;
+      final pixels = Uint8List(size * size * 4);
+      final rng = Random(17);
+      for (int i = 0; i < pixels.length; i += 4) {
+        pixels[i] = rng.nextInt(256);
+        pixels[i + 1] = rng.nextInt(256);
+        pixels[i + 2] = rng.nextInt(256);
+        pixels[i + 3] = 255;
+      }
+      final decoded = Completer<ui.Image>();
+      ui.decodeImageFromPixels(
+          pixels, size, size, ui.PixelFormat.rgba8888, decoded.complete);
+      final image = await decoded.future;
+      try {
+        final png = (await toolbarPng(image))!;
+        expect(png.length, lessThanOrEqualTo(toolbarPngLimit));
+        final header = ByteData.sublistView(png);
+        expect(header.getUint32(16), lessThan(size));
+        expect(header.getUint32(20), header.getUint32(16));
+      } finally {
+        image.dispose();
+      }
+    });
+  });
+  test('a stale session cannot upload any further screenshot chunks', () async {
+    final png = Uint8List(chunkSize + 1);
+    final calls = <String>[];
+    var active = true;
+    Future<ToolbarJson> send(String method, String path,
+        [ToolbarJson? body]) async {
+      calls.add('$method $path');
+      if (method == 'POST') {
+        expect(body, {
+          'action': 'screenshot',
+          'ticket_id': 'help-1',
+          'size': png.length,
+          'sha256': sha256.convert(png).toString()
+        });
+        return {'id': 't_1'};
+      }
+      expect(base64Decode(body!['data']).length, chunkSize);
+      active = false;
+      return {};
+    }
+
+    await expectLater(
+        submitToolbarAction(send, 'toolbar/device/session',
+            ToolbarAction.screenshot, () => active,
+            ticket: 'help-1', png: png),
+        throwsFormatException);
+    expect(calls, [
+      'POST toolbar/device/session',
+      'PUT toolbar/device/session/t_1/chunks/0'
+    ]);
+  });
+
+  test('only fixed quick check and own-log requests may omit an attachment',
+      () async {
+    final bodies = <ToolbarJson>[];
+    Future<ToolbarJson> send(String method, String path,
+        [ToolbarJson? body]) async {
+      expect(method, 'POST');
+      bodies.add(body!);
+      return {};
+    }
+
+    for (final action in [ToolbarAction.quick, ToolbarAction.logs]) {
+      await submitToolbarAction(
+          send, 'toolbar/device/session', action, () => true);
+    }
+    await expectLater(
+        submitToolbarAction(send, 'toolbar/device/session',
+            ToolbarAction.screenshot, () => true,
+            png: Uint8List(toolbarPngLimit + 1)),
+        throwsFormatException);
+    expect(bodies, [
+      {'action': 'quick_check'},
+      {'action': 'collect_logs'}
+    ]);
+  });
+
+  testWidgets(
+      'capture reads the scoped image beneath a separate operator overlay',
+      (tester) async {
+    final frame = ToolbarFrame();
+    const red = Color(0xffff0000),
+        blue = Color(0xff0000ff),
+        green = Color(0xff00ff00);
+    await tester.pumpWidget(Directionality(
+        textDirection: TextDirection.ltr,
+        child: Center(
+            child: SizedBox(
+                width: 80,
+                height: 40,
+                child: frame.view(Stack(fit: StackFit.expand, children: [
+                  frame.paint(const Row(children: [
+                    Expanded(child: ColoredBox(color: red)),
+                    Expanded(child: ColoredBox(color: blue))
+                  ], crossAxisAlignment: CrossAxisAlignment.stretch)),
+                  const ColoredBox(color: green),
+                ]))))));
+    await tester.runAsync(() async {
+      final image = (await frame.readVisible())!;
+      try {
+        final raw =
+            (await image.toByteData(format: ui.ImageByteFormat.rawRgba))!;
+        expect(image.width, 80);
+        expect(raw.getUint32(0), 0xff0000ff);
+        expect(raw.getUint32(79 * 4), 0x0000ffff);
+        final png = (await toolbarPng(image))!;
+        expect(png.take(8), [137, 80, 78, 71, 13, 10, 26, 10]);
+        expect(png.length, lessThanOrEqualTo(toolbarPngLimit));
+      } finally {
+        image.dispose();
+      }
+    });
+  });
+
+  testWidgets('unregistered external texture cannot produce an attachment',
+      (tester) async {
+    final frame = ToolbarFrame();
+    await tester.pumpWidget(Center(
+        child: SizedBox(
+            width: 48,
+            height: 24,
+            child: frame.view(frame.paint(const Texture(textureId: 456789))))));
+    await tester.runAsync(() async {
+      final image = (await frame.readVisible())!;
+      try {
+        expect(await toolbarPng(image), isNull);
+      } finally {
+        image.dispose();
+      }
+    });
+  });
+}
