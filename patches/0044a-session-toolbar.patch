+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:uuid/uuid.dart';
+import '../../models/platform_model.dart' show bind;
+import '../case_session_api.dart';
+import '../ops_groups.dart' show opsEndpoint;
+import '../ops_health.dart' show HealthFailure, OpsHealthHttp;
+import 'actions.dart';
+import 'frame.dart';
+export 'frame.dart' show ToolbarFrame;
+part 'archive.dart';
+
+const toolbarEnabled = true;
+typedef _Login = ({String name, String token});
+_Login? _login() {
+  try {
+    final token = bind.mainGetLocalOption(key: 'access_token');
+    final name = jsonDecode(bind.mainGetLocalOption(key: 'user_info'))['name'];
+    if (name is String && name.isNotEmpty && token.isNotEmpty) {
+      return (name: name, token: token);
+    }
+  } catch (_) {}
+  return null;
+}
+
+Widget sessionToolbar(
+        {required Key key,
+        required String peer,
+        required String session,
+        required String connection,
+        required bool cases,
+        required String platform,
+        required bool Function() active,
+        required bool Function() screenshotAllowed,
+        required ToolbarFrame frame,
+        required Widget Function(Widget?, Widget?) builder}) =>
+    _Toolbar(
+        key: key,
+        peer: peer,
+        session: session,
+        connection: connection,
+        cases: cases,
+        platform: platform,
+        active: active,
+        screenshotAllowed: screenshotAllowed,
+        frame: frame,
+        builder: builder);
+
+class _Toolbar extends StatefulWidget {
+  const _Toolbar(
+      {required super.key,
+      required this.peer,
+      required this.session,
+      required this.connection,
+      required this.cases,
+      required this.platform,
+      required this.active,
+      required this.screenshotAllowed,
+      required this.frame,
+      required this.builder});
+  final String peer, session, connection, platform;
+  final bool cases;
+  final bool Function() active, screenshotAllowed;
+  final ToolbarFrame frame;
+  final Widget Function(Widget?, Widget?) builder;
+  @override
+  State<_Toolbar> createState() => _ToolbarState();
+}
+
+class _ToolbarState extends State<_Toolbar> {
+  late final _Login? owner;
+  Uri? origin;
+  OpsHealthHttp? http;
+  String? route, ticket, error;
+  bool authorized = false, reading = false, busy = false;
+  List<ToolbarJson> history = [];
+  late final Timer timer;
+  bool get current =>
+      mounted && owner != null && owner == _login() && widget.active();
+  @override
+  void initState() {
+    super.initState();
+    owner = _login();
+    scheduleMicrotask(refresh);
+    timer = Timer.periodic(const Duration(seconds: 3), (_) => refresh());
+  }
+
+  @override
+  void dispose() {
+    timer.cancel();
+    http?.close();
+    super.dispose();
+  }
+
+  Future<void> open({bool rebind = false}) async {
+    final target = opsEndpoint(Uri.parse(await bind.mainGetApiServer()));
+    if (!current || origin != null && origin != target) {
+      throw const FormatException('会话或服务地址已变化。');
+    }
+    origin = target;
+    if (route != null && !rebind) return;
+    final record = widget.cases
+        ? await CaseSession.historyRequest(widget.connection, 'bind')
+        : null;
+    if (!current) throw const FormatException('会话已变化。');
+    if (record != null &&
+        (record['device_id'] != widget.peer ||
+            record['agent'] != owner!.name ||
+            record['help_origin'] != null &&
+                opsEndpoint(Uri.parse(record['help_origin'])) != target)) {
+      throw const FormatException('工单与当前会话不匹配。');
+    }
+    final path = toolbarSessionRoute(
+        peer: widget.peer,
+        session: widget.session,
+        connection: widget.connection,
+        cases: widget.cases,
+        caseId: record?['id'] as String?);
+    if (route != null && route != path) throw const FormatException('会话编号已变化。');
+    ticket = record?['help_id'] as String?;
+    route = path;
+    http ??= OpsHealthHttp(target, owner!.token);
+  }
+
+  Future<ToolbarJson> request(String method, String path,
+      [ToolbarJson? body]) async {
+    final target = opsEndpoint(Uri.parse(await bind.mainGetApiServer()));
+    if (!current || target != origin) {
+      throw const FormatException('会话或登录状态已变化。');
+    }
+    return http!.request(method, path, body);
+  }
+
+  String message(Object e) => e is FormatException
+      ? e.message
+      : e is HealthFailure
+          ? e.toString()
+          : '操作未确认。请刷新会话历史。';
+
+  Future<void> refresh() async {
+    if (!mounted || reading || busy) return;
+    if (!current) {
+      if (authorized || history.isNotEmpty) {
+        setState(() {
+          authorized = false;
+          history = [];
+          error = null;
+        });
+      }
+      return;
+    }
+    reading = true;
+    try {
+      await open();
+      final result = await request('GET', route!);
+      if (current && !busy) {
+        final actions = List<ToolbarJson>.from(result['actions'] as List);
+        setState(() {
+          if (!authorized) error = null;
+          authorized = true;
+          history = actions;
+        });
+      }
+    } catch (e) {
+      if (mounted && !busy) {
+        setState(() {
+          authorized = false;
+          history = [];
+          error = message(e);
+        });
+      }
+    } finally {
+      reading = false;
+    }
+  }
+
+  Future<void> run(ToolbarAction action) async {
+    if (!authorized || !current || busy) return;
+    final allowed = widget.screenshotAllowed;
+    bool valid() =>
+        current && (action != ToolbarAction.screenshot || allowed());
+    if (!valid()) return;
+    setState(() {
+      busy = true;
+      error = null;
+    });
+    try {
+      await open(rebind: widget.cases);
+      if (!valid()) return;
+      final png = action == ToolbarAction.screenshot
+          ? await widget.frame.capture(valid)
+          : null;
+      await submitToolbarAction(request, route!, action, valid,
+          ticket: ticket, png: png);
+    } catch (e) {
+      if (mounted) setState(() => error = message(e));
+    } finally {
+      if (mounted) {
+        setState(() => busy = false);
+        await refresh();
+      }
+    }
+  }
+
+  Future<void> preview(ToolbarJson row) async {
+    if (!current || !authorized || busy || row['state'] != 'completed') return;
+    final id = row['id'];
+    if (!_validActionId(id)) return;
+    setState(() {
+      busy = true;
+      error = null;
+    });
+    try {
+      final result = await request('GET', '$route/$id/attachment');
+      if (!current || result['action'] != row['action']) return;
+      await _previewAttachment(context, result, () => current);
+    } catch (e) {
+      if (mounted) setState(() => error = message(e));
+    } finally {
+      if (mounted) setState(() => busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final ready = authorized && current && !busy;
+    final menu = PopupMenuButton<ToolbarAction>(
+        enabled: ready,
+        tooltip: '会话快捷操作',
+        onSelected: run,
+        itemBuilder: (_) => [
+              for (final a in ToolbarAction.values)
+                PopupMenuItem(
+                    value: a,
+                    enabled: (a != ToolbarAction.screenshot ||
+                            widget.screenshotAllowed()) &&
+                        (a != ToolbarAction.logs ||
+                            {'Windows', 'Android'}.contains(widget.platform)),
+                    child: Text(a.label))
+            ],
+        child:
+            const Padding(padding: EdgeInsets.all(8), child: Text('快捷操作 ▾')));
+    final sidebar = Padding(
+        padding: const EdgeInsets.symmetric(horizontal: 10),
+        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+          Row(children: [
+            const Expanded(child: Text('会话操作历史')),
+            IconButton(
+                onPressed: !busy && current ? refresh : null,
+                tooltip: '刷新',
+                icon: const Icon(Icons.refresh, size: 16))
+          ]),
+          if (busy) const LinearProgressIndicator(),
+          if (error != null && owner == _login()) Text(error!),
+          if (!current)
+            const Text('请在已登录的当前会话中查看。')
+          else if (authorized && history.isEmpty)
+            const Text('暂无操作'),
+          if (current)
+            for (final row in history) ...[
+              Text(
+                  '${_actionLabel(row['action'])} · ${_states[row['state']] ?? row['state']}'),
+              Text(
+                  "${row['case_kind'] == 'pending' ? '待补结案' : '关联工单'} · ${row['case_id']}"),
+              Text(_localTime(row['created_at'])),
+              for (final r
+                  in (row['results'] as List? ?? const []).whereType<Map>())
+                Text(
+                    "${r['name']} · ${r['outcome']}${r['latency_ms'] == null ? '' : ' · ${r['latency_ms']} ms'}"),
+              if (row['state'] == 'completed' &&
+                  {'screenshot', 'collect_logs'}.contains(row['action']))
+                TextButton(
+                    onPressed: ready ? () => preview(row) : null,
+                    child: const Text('查看附件')),
+              const Divider(),
+            ],
+        ]));
+    return widget.builder(menu, sidebar);
+  }
+}
+
+String _actionLabel(dynamic value) {
+  for (final a in ToolbarAction.values) {
+    if (a.wire == value) return a.label;
+  }
+  return '操作';
+}
+
+const _states = {
+  'queued': '已排队',
+  'running': '进行中',
+  'uploading': '上传中',
+  'completed': '已完成',
+  'failed': '失败',
+  'timeout': '超时',
+  'cancelled': '已取消'
+};
