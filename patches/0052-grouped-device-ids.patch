+class DeviceIdText extends StatelessWidget {
+  const DeviceIdText(this.id,
+      {super.key,
+      required this.translate,
+      this.style,
+      this.prefix = '',
+      this.maxLines,
+      this.overflow});
+
+  final String id, prefix;
+  final String Function(String) translate;
+  final TextStyle? style;
+  final int? maxLines;
+  final TextOverflow? overflow;
+
+  @override
+  Widget build(BuildContext context) => Text('$prefix${groupedDeviceId(id)}',
+      semanticsLabel: '$prefix${spokenDeviceId(id, translate)}',
+      style: style,
+      maxLines: maxLines,
+      overflow: overflow);
+}
+
+// Flutter asks this delegate for selected text on keyboard, toolbar and
+// accessibility copy. Its only child is one paragraph containing one ID.
+class _IdSelection extends MultiSelectableSelectionContainerDelegate {
+  @override
+  void ensureChildUpdated(Selectable selectable) {}
+
+  @override
+  SelectedContent? getSelectedContent() {
+    final selected = super.getSelectedContent();
+    return selected == null
+        ? null
+        : SelectedContent(plainText: selected.plainText.replaceAll(' ', ''));
+  }
+}
+
+class SelectableDeviceId extends StatefulWidget {
+  const SelectableDeviceId(this.id,
+      {super.key, required this.translate, this.style});
+  final String id;
+  final String Function(String) translate;
+  final TextStyle? style;
+
+  @override
+  State<SelectableDeviceId> createState() => _SelectableDeviceIdState();
+}
+
+class _SelectableDeviceIdState extends State<SelectableDeviceId> {
+  final selection = _IdSelection();
+
+  @override
+  Widget build(BuildContext context) {
+    if (groupedDeviceId(widget.id) == widget.id) {
+      return SelectableText(widget.id, style: widget.style);
+    }
+    return SelectionArea(
+        child: SelectionContainer(
+            delegate: selection,
+            child: DeviceIdText(widget.id,
+                translate: widget.translate, style: widget.style)));
+  }
+
+  @override
+  void dispose() {
+    selection.dispose();
+    super.dispose();
+  }
+}
+
