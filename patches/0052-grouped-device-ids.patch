diff --git a/flutter/lib/steaddesk/device_id.dart b/flutter/lib/steaddesk/device_id.dart
new file mode 100644
index 0000000000000000000000000000000000000000..a6e4834b149f448b4f208eaf39ee853c4595edd5
--- /dev/null
+++ b/flutter/lib/steaddesk/device_id.dart
@@ -0,0 +1,36 @@
+// Presentation only. Keep the original ID for connection routing and clipboard.
+final _deviceId = RegExp(r'^[0-9]{9,10}$');
+const deviceDigitNames = 'zero one two three four five six seven eight nine';
+
+String groupedDeviceId(String id) {
+  if (!_deviceId.hasMatch(id)) return id;
+  final first = id.length == 10 ? 1 : 3;
+  return [
+    id.substring(0, first),
+    for (int i = first; i < id.length; i += 3) id.substring(i, i + 3),
+  ].join(' ');
+}
+
+String spokenDeviceId(String id, String Function(String) translate) {
+  if (!_deviceId.hasMatch(id)) return id;
+  // Localized digit names also work with accessibility bridges that ignore
+  // attributed spell-out hints. Visual grouping never reaches the speech label.
+  final localized = translate(deviceDigitNames).split(' ');
+  final digits =
+      localized.length == 10 ? localized : deviceDigitNames.split(' ');
+  return id.codeUnits.map((digit) => digits[digit - 48]).join(' ');
+}
+
+String deviceTabLabel(String peerId, String alias, String hostname,
+    {String Function(String)? speak}) {
+  final base = alias.isEmpty ? peerId : alias;
+  final label = alias.isNotEmpty
+      ? alias
+      : speak == null
+          ? groupedDeviceId(peerId)
+          : spokenDeviceId(peerId, speak);
+  if (hostname.isEmpty || base.toLowerCase().contains(hostname.toLowerCase())) {
+    return label;
+  }
+  return '$label@$hostname';
+}
