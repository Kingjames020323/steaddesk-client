diff --git a/flutter/test/steaddesk/device_id_test.dart b/flutter/test/steaddesk/device_id_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..57b8f99f497ac6384f88b423de1a90b600931ee5
--- /dev/null
+++ b/flutter/test/steaddesk/device_id_test.dart
@@ -0,0 +1,167 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:flutter_hbb/common/formatter/id_formatter.dart';
+import 'package:flutter_hbb/steaddesk/device_id.dart';
+import 'package:flutter_hbb/steaddesk/device_id_widgets.dart';
+import 'package:flutter_hbb/steaddesk/support_device.dart';
+
+void main() {
+  const ten = '0123456789', nine = '987654321';
+  const dictionaries = {
+    'en': deviceDigitNames,
+    'zh-cn': '零 一 二 三 四 五 六 七 八 九',
+    'es': 'cero uno dos tres cuatro cinco seis siete ocho nueve',
+  };
+
+  test('only nine and ten digit IDs are grouped, raw IDs preserve zeros', () {
+    expect(groupedDeviceId(ten), '0 123 456 789');
+    expect(groupedDeviceId(nine), '987 654 321');
+    for (final value in [
+      '',
+      '12345678',
+      '12345678901',
+      'desk-123456789',
+      '12345678x',
+      'https://lab.invalid/123456789',
+      'desk 123'
+    ]) {
+      expect(groupedDeviceId(value), value);
+      expect(spokenDeviceId(value, (s) => s), value);
+    }
+  });
+
+  test('window title uses the ID fallback, aliases and hostnames verbatim', () {
+    expect(deviceTabLabel(nine, '', 'host'), '987 654 321@host');
+    expect(deviceTabLabel(ten, '', ''), '0 123 456 789');
+    expect(deviceTabLabel(nine, '1234567890', 'host'), '1234567890@host');
+    expect(deviceTabLabel(nine, 'Office host', 'HOST'), 'Office host');
+    expect(deviceTabLabel(nine, '', '654'), '987 654 321');
+    expect(deviceTabLabel(ten, '', 'host', speak: (_) => dictionaries['es']!),
+        'cero uno dos tres cuatro cinco seis siete ocho nueve@host');
+  });
+
+  test('directory dispatches raw IDs, free text and relay suffix remain intact',
+      () {
+    for (final input in [ten, '0 123 456 789', nine, '987 654 321']) {
+      expect(supportSearchTarget(input, const []), input.replaceAll(' ', ''));
+    }
+    expect(supportSearchTarget('shop 12', [nine]), nine);
+    for (final input in ['12345678', '12345678901', 'store abc', 'store 123']) {
+      expect(directSupportId(input), isNull);
+    }
+    for (final value in [
+      'desk 12',
+      'https://host.invalid/a b?q=1 2',
+      'key=demo 456',
+      '0x12abcd',
+      'peer@server.invalid?key=a b'
+    ]) {
+      expect(trimID(value), value);
+      expect(formatID(value), value);
+    }
+    expect(trimID('987 654 321/r@lab.invalid?key=fixture key'),
+        '987654321/r@lab.invalid?key=fixture key');
+  });
+
+  for (final entry in dictionaries.entries) {
+    testWidgets(
+        '${entry.key}: merchant, directory and session accessibility labels',
+        (t) async {
+      final semantics = t.ensureSemantics();
+
+      String translate(String s) => s == deviceDigitNames ? entry.value : s;
+      await t.pumpWidget(MaterialApp(
+          home: Scaffold(
+              body: Column(children: [
+        MerchantDeviceIdentity(
+            id: ten, device: '', android: true, translate: translate),
+        DirectoryDeviceIdentity(
+            id: nine,
+            alias: '1234567890',
+            name: 'Fixture',
+            translate: translate),
+        SessionDeviceTitle(
+            id: ten, alias: '', subtitle: 'Fixture', translate: translate),
+      ]))));
+      expect(find.text('0 123 456 789'), findsNWidgets(2));
+      expect(find.text('Fixture · 987 654 321'), findsOneWidget);
+      expect(find.text('1234567890'), findsOneWidget);
+      final spoken = entry.value;
+      expect(find.bySemanticsLabel(spoken), findsNWidgets(2));
+      final descending = entry.value.split(' ').reversed.take(9).join(' ');
+      expect(find.bySemanticsLabel('Fixture · $descending'), findsOneWidget);
+      expect(find.bySemanticsLabel('0 123 456 789'), findsNothing);
+      semantics.dispose();
+    });
+  }
+
+  testWidgets(
+      'copy button and keyboard selection put raw digits on the clipboard',
+      (t) async {
+    final system =
+        TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
+    String? clipboard;
+    system.setMockMethodCallHandler(SystemChannels.platform, (call) async {
+      if (call.method == 'Clipboard.setData')
+        clipboard = call.arguments['text'] as String;
+      if (call.method == 'Clipboard.getData') return {'text': clipboard};
+      return null;
+    });
+    addTearDown(
+        () => system.setMockMethodCallHandler(SystemChannels.platform, null));
+    await t.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: MerchantDeviceIdentity(
+                id: ten, device: '', android: true, translate: (s) => s))));
+    await t.tap(find.byIcon(Icons.copy_outlined));
+    await t.pump();
+    expect(clipboard, ten);
+    clipboard = null;
+    await t.tap(find.text('0 123 456 789'));
+    await t.pump();
+    await t.sendKeyDownEvent(LogicalKeyboardKey.controlLeft);
+    await t.sendKeyEvent(LogicalKeyboardKey.keyA);
+    await t.sendKeyEvent(LogicalKeyboardKey.keyC);
+    await t.sendKeyUpEvent(LogicalKeyboardKey.controlLeft);
+    await t.pump();
+    expect(clipboard, ten);
+  }, variant: TargetPlatformVariant.only(TargetPlatform.windows));
+
+  testWidgets('ID input accepts typed and pasted IDs with and without grouping',
+      (t) async {
+    final controller = IDTextEditingController();
+    addTearDown(controller.dispose);
+    String? submitted, clipboard;
+    final system =
+        TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
+    system.setMockMethodCallHandler(
+        SystemChannels.platform,
+        (call) async =>
+            call.method == 'Clipboard.getData' ? {'text': clipboard} : null);
+    addTearDown(
+        () => system.setMockMethodCallHandler(SystemChannels.platform, null));
+    await t.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: TextField(
+                controller: controller,
+                inputFormatters: [IDTextInputFormatter()],
+                onSubmitted: (_) => submitted = controller.id))));
+    for (final input in [nine, '987 654 321', ten, '0 123 456 789']) {
+      await t.enterText(find.byType(TextField), input);
+      await t.testTextInput.receiveAction(TextInputAction.done);
+      expect(submitted, input.replaceAll(' ', ''));
+      submitted = null;
+      controller.clear();
+      await t.tap(find.byType(TextField));
+      clipboard = input;
+      await t.sendKeyDownEvent(LogicalKeyboardKey.controlLeft);
+      await t.sendKeyEvent(LogicalKeyboardKey.keyV);
+      await t.sendKeyUpEvent(LogicalKeyboardKey.controlLeft);
+      await t.pump();
+      await t.testTextInput.receiveAction(TextInputAction.done);
+      expect(submitted, input.replaceAll(' ', ''));
+    }
+  }, variant: TargetPlatformVariant.only(TargetPlatform.windows));
+}
