diff --git a/libs/portable/build.rs b/libs/portable/build.rs
index 74e7cc7..2125567 100644
--- a/libs/portable/build.rs
+++ b/libs/portable/build.rs
@@ -1,20 +1,25 @@
-fn main() {
+fn main() -> Result<(), Box<dyn std::error::Error>> {
     #[cfg(windows)]
     {
-        use std::io::Write;
+        use winres::VersionInfo;
+
+        let release = include_str!("../../RELEASE_VERSION").trim();
+        let mut numeric = 0u64;
+        for component in release.replace("-sd.", ".").split('.') {
+            numeric = (numeric << 16) | u64::from(component.parse::<u16>()?);
+        }
         let mut res = winres::WindowsResource::new();
-        res.set_icon("../../res/icon.ico")
+        res.set("FileVersion", release)
+            .set("ProductVersion", release)
+            .set_version_info(VersionInfo::FILEVERSION, numeric)
+            .set_version_info(VersionInfo::PRODUCTVERSION, numeric)
+            .set_icon("../../res/icon.ico")
             .set_language(winapi::um::winnt::MAKELANGID(
                 winapi::um::winnt::LANG_ENGLISH,
                 winapi::um::winnt::SUBLANG_ENGLISH_US,
             ))
             .set_manifest_file("../../res/manifest.xml");
-        match res.compile() {
-            Err(e) => {
-                write!(std::io::stderr(), "{}", e).unwrap();
-                std::process::exit(1);
-            }
-            Ok(_) => {}
-        }
+        res.compile()?;
     }
+    Ok(())
 }
