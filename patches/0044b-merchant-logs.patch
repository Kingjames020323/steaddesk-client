@@ -0,0 +1,346 @@
+//! Windows merchant Connection Manager. Only an authenticated, registered device can retrieve
+//! its pending human-requested job. Signing and collection have no external callable interface.
+use hbb_common::config::Config;
+use reqwest::{blocking::Client, redirect::Policy, Url};
+use serde_derive::Serialize;
+use serde_json::{json, Value};
+use std::{
+    collections::BTreeMap,
+    fs::{self, File, OpenOptions},
+    io::Read,
+    path::Path,
+    sync::Once,
+    time::Duration,
+};
+
+const BYTE_LIMIT: usize = 2 * 1024 * 1024;
+const IDENTITY: &str = "/ops/v1/device/update-identity";
+const JOB: &str = "/ops/v1/device/toolbar-log-job";
+const RESULT: &str = "/ops/v1/device/toolbar-log-result";
+
+#[derive(Clone, Copy, Serialize)]
+struct Entry {
+    event: &'static str,
+    source: &'static str,
+}
+
+fn project(line: &[u8]) -> Option<&'static str> {
+    // flexi_logger opt_format: [timestamp] LEVEL [source:line] message
+    if line.len() > 4096 || !line.starts_with(b"[") {
+        return None;
+    }
+    let line = std::str::from_utf8(line).ok()?.trim_end_matches('\r');
+    let (_, record) = line.split_once("] ")?;
+    let (level, detail) = record.split_once(" [")?;
+    let (site, message) = detail.split_once("] ")?;
+    if site.contains("ui_cm_interface.rs:") {
+        if message == "Got new connection" {
+            return Some("connected");
+        }
+        if message.starts_with("cm ipc connection closed")
+            || message == "cm ipc connection disconnect"
+        {
+            return Some("disconnected");
+        }
+        if message == "Clipboard message from client peer, but not authorized" {
+            return Some("denied");
+        }
+        if message.starts_with("Failed to start cm ipc server:")
+            || message.starts_with("error encountered in IPC task, quitting:")
+        {
+            return Some("failed");
+        }
+    }
+    match level {
+        "DEBUG" => Some("debug"),
+        "INFO" => Some("info"),
+        "WARN" => Some("warn"),
+        "ERROR" => Some("error"),
+        _ => None,
+    }
+}
+
+fn read_log(file: impl Read, entries: &mut Vec<Entry>) -> std::io::Result<()> {
+    let mut data = Vec::new();
+    file.take((BYTE_LIMIT + 1) as u64).read_to_end(&mut data)?;
+    let mut cut = data.len() > BYTE_LIMIT;
+    data.truncate(BYTE_LIMIT);
+    // Never parse the incomplete final record of an actively written or capped file.
+    for line in data.split_inclusive(|b| *b == b'\n') {
+        if entries.len() >= 32000 || !line.ends_with(b"\n") {
+            cut = true;
+            break;
+        }
+        if line.len() > 4096 {
+            cut = true;
+            continue;
+        }
+        if let Some(event) = project(&line[..line.len() - 1]) {
+            entries.push(Entry {
+                source: "steaddesk",
+                event,
+            });
+        }
+    }
+    if cut {
+        entries.push(Entry {
+            source: "steaddesk",
+            event: "truncated",
+        });
+    }
+    Ok(())
+}
+
+fn open_log(path: &Path) -> Option<File> {
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::{MetadataExt, OpenOptionsExt};
+        const REPARSE: u32 = 0x400;
+        if path
+            .ancestors()
+            .any(|p| fs::symlink_metadata(p).map_or(true, |m| m.file_attributes() & REPARSE != 0))
+        {
+            return None;
+        }
+        options.custom_flags(0x00200000); // FILE_FLAG_OPEN_REPARSE_POINT
+        let file = options.open(path).ok()?;
+        let metadata = file.metadata().ok()?;
+        if !metadata.is_file() || metadata.file_attributes() & REPARSE != 0 {
+            return None;
+        }
+        return Some(file);
+    }
+    #[cfg(not(windows))]
+    {
+        if !fs::symlink_metadata(path).ok()?.is_file() {
+            return None;
+        }
+        options.open(path).ok()
+    }
+}
+
+fn collect() -> Vec<Vec<Entry>> {
+    let root = Config::log_path();
+    let mut entries = vec![
+        Entry {
+            source: "agent",
+            event: "unavailable",
+        },
+        Entry {
+            source: "self_heal",
+            event: "unavailable",
+        },
+    ];
+    if root.is_absolute() {
+        for relative in ["cm/SteadDesk_rCURRENT.log", "SteadDesk_rCURRENT.log"] {
+            if let Some(file) = open_log(&root.join(relative)) {
+                let _ = read_log(file, &mut entries);
+            }
+        }
+    }
+    if entries.len() == 2 {
+        entries.push(Entry {
+            source: "steaddesk",
+            event: "unavailable",
+        });
+    }
+    // A fixed-vocabulary serialized entry is at most 47 ASCII bytes. These bounds keep every
+    // chunk below 32 KiB, the combined document below 2 MiB, and the chunk count below 128.
+    entries.chunks(600).map(|chunk| chunk.to_vec()).collect()
+}
+
+fn request(
+    client: &Client,
+    origin: &Url,
+    path: &'static str,
+    body: Value,
+    version: u64,
+    device: &str,
+) -> Option<Value> {
+    let method = match path {
+        IDENTITY if version == 0 && body == json!({}) => "GET",
+        JOB if version > 0 && body == json!({}) => "GET",
+        RESULT if version > 0 => "POST",
+        _ => return None,
+    };
+    let headers = super::steaddesk_device_signature::sign(device, version, |id, stamp, nonce| {
+        let mut bytes = b"SteadDesk-fleet-v1\0".to_vec();
+        bytes.extend(serde_json::to_vec(&(method, path, &body, id, version, stamp, nonce)).ok()?);
+        Some(bytes)
+    })?;
+    let url = origin.join(path).ok()?;
+    let mut request = if method == "GET" {
+        client.get(url)
+    } else {
+        client.post(url).json(&body)
+    };
+    for (name, value) in serde_json::from_slice::<BTreeMap<String, String>>(&headers).ok()? {
+        request = request.header(name, value);
+    }
+    let response = request.send().ok()?;
+    if response.status().as_u16() != 200 {
+        return None;
+    }
+    let mut bytes = Vec::new();
+    response.take(16385).read_to_end(&mut bytes).ok()?;
+    if bytes.len() > 16384 {
+        return None;
+    }
+    serde_json::from_slice(&bytes).ok()
+}
+
+fn valid_job(job: &str) -> bool {
+    job.len() == 28
+        && job.starts_with("t_")
+        && job.as_bytes()[2..]
+            .iter()
+            .all(|b| b"0123456789ABCDEFGHJKMNPQRSTVWXYZ".contains(b))
+}
+
+struct Pending {
+    job: String,
+    origin: Url,
+    device: String,
+    sessions: Vec<i32>,
+    chunks: Vec<Vec<Entry>>,
+    next: usize,
+}
+
+fn poll(client: &Client, pending: &mut Option<Pending>) -> Option<()> {
+    let sessions = super::ui_cm_interface::toolbar_desktop_connections();
+    let still_open = |ids: &[i32]| {
+        super::ui_cm_interface::toolbar_desktop_connections()
+            .iter()
+            .any(|id| ids.contains(id))
+    };
+    if sessions.is_empty() {
+        *pending = None;
+        return None;
+    }
+    let origin = Url::parse(&Config::get_option("api-server")).ok()?;
+    if origin.scheme() != "https"
+        || origin.host().is_none()
+        || !origin.username().is_empty()
+        || origin.password().is_some()
+        || origin.query().is_some()
+        || origin.fragment().is_some()
+        || origin.path() != "/"
+    {
+        return None;
+    }
+    let device = Config::get_id_or(String::new());
+    let version =
+        request(client, &origin, IDENTITY, json!({}), 0, &device)?["key_version"].as_u64()?;
+    let reply = request(client, &origin, JOB, json!({}), version, &device)?;
+    if reply.as_object()?.len() != 1 {
+        return None;
+    }
+    let Some(job) = reply["job_id"].as_str() else {
+        *pending = None;
+        return None;
+    };
+    if !valid_job(job) || !still_open(&sessions) {
+        return None;
+    }
+    if let Some(snapshot) = pending.as_ref() {
+        if snapshot.job == job
+            && (snapshot.origin != origin
+                || snapshot.device != device
+                || !still_open(&snapshot.sessions))
+        {
+            return None;
+        }
+    }
+    if pending.as_ref().map_or(true, |s| s.job != job) {
+        *pending = Some(Pending {
+            job: job.into(),
+            origin: origin.clone(),
+            device: device.clone(),
+            sessions,
+            chunks: collect(),
+            next: 0,
+        });
+    }
+    let snapshot = pending.as_mut()?;
+    while snapshot.next < snapshot.chunks.len() {
+        let index = snapshot.next;
+        let entries = &snapshot.chunks[index];
+        if !still_open(&snapshot.sessions)
+            || Config::get_id_or(String::new()) != device
+            || Url::parse(&Config::get_option("api-server")).ok().as_ref() != Some(&origin)
+        {
+            return None;
+        }
+        let total = snapshot.chunks.len();
+        let body = json!({"entries":entries,"index":index,"job_id":job,"total":total});
+        let reply = request(client, &origin, RESULT, body, version, &device)?;
+        if reply["accepted"] != true || (index + 1 == total && reply["complete"] != true) {
+            return None;
+        }
+        snapshot.next += 1;
+    }
+    *pending = None;
+    Some(())
+}
+
+pub(crate) fn start() {
+    static START: Once = Once::new();
+    START.call_once(|| {
+        std::thread::spawn(|| {
+            let Ok(client) = Client::builder()
+                .no_proxy()
+                .redirect(Policy::none())
+                .connect_timeout(Duration::from_secs(3))
+                .timeout(Duration::from_secs(8))
+                .build()
+            else {
+                return;
+            };
+            let mut pending = None;
+            loop {
+                poll(&client, &mut pending);
+                std::thread::sleep(Duration::from_secs(12));
+            }
+        });
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn projects_events_and_drops_secrets_and_personal_fields() {
+        let raw = b"[2026-01-02 03:04:05.000000 +00:00] INFO [src/ui_cm_interface.rs:552] cm ipc connection closed: password=fixture token=secret Alice 555-0100 a@example.invalid\n[2026-01-02 03:04:05.000000 +00:00] WARN [src/common.rs:1] fixture\n{malformed}\n";
+        let mut entries = Vec::new();
+        read_log(&raw[..], &mut entries).unwrap();
+        assert_eq!(
+            serde_json::to_value(entries).unwrap(),
+            json!([
+                {"source":"steaddesk","event":"disconnected"},{"source":"steaddesk","event":"warn"}
+            ])
+        );
+    }
+    #[test]
+    fn caps_oversized_lines_input_output_and_chunks() {
+        let mut entries = Vec::new();
+        read_log(&vec![b'a'; BYTE_LIMIT + 5][..], &mut entries).unwrap();
+        assert_eq!(entries[0].event, "truncated");
+        let lines = "[x] INFO [source:1] name=fixture\n".repeat(75000);
+        read_log(lines.as_bytes(), &mut entries).unwrap();
+        let chunks = entries.chunks(600).collect::<Vec<_>>();
+        assert!(chunks.len() <= 128 && chunks.len() > 1);
+        assert!(serde_json::to_vec(&entries).unwrap().len() <= BYTE_LIMIT);
+        assert!(chunks
+            .iter()
+            .all(|chunk| serde_json::to_vec(chunk).unwrap().len() <= 32768));
+        assert_eq!(entries.last().unwrap().event, "truncated");
+    }
+    #[test]
+    fn rejects_job_with_extra_arguments_or_nonregistered_shape() {
+        assert!(valid_job("t_0123456789ABCDEFGHJKMNPQRS"));
+        assert!(!valid_job("t_0123456789ABCDEFGHJKMNPQR/"));
+        assert!(!valid_job("t_0123456789ABCDEFGHJKMNPQRS C:/Logs"));
+    }
+}
