@@ -0,0 +1,34 @@
+use hbb_common::{
+    base64::{engine::general_purpose::STANDARD, Engine},
+    config::Config,
+    sodiumoxide::{self, crypto::sign, randombytes::randombytes_into, utils::memzero},
+};
+use serde_json::json;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+pub(super) fn sign(
+    device: &str,
+    version: u64,
+    proof: impl FnOnce(&str, u64, &str) -> Option<Vec<u8>>,
+) -> Option<Vec<u8>> {
+    sodiumoxide::init().ok()?;
+    if !(9..=10).contains(&device.len()) || !device.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    let ts = SystemTime::now().duration_since(UNIX_EPOCH).ok()?.as_secs();
+    let mut salt = [0u8; 16];
+    randombytes_into(&mut salt);
+    let nonce: String = salt.iter().map(|b| format!("{b:02x}")).collect();
+    let message = proof(device, ts, &nonce)?;
+    let (mut secret, public) = Config::get_existing_key_pair()?;
+    let key = sign::SecretKey::from_slice(&secret);
+    memzero(&mut secret);
+    let key = key?;
+    let public = sign::PublicKey::from_slice(&public)?;
+    let signature = sign::sign_detached(&message, &key);
+    if !sign::verify_detached(&signature, &message, &public) {
+        return None;
+    }
+    serde_json::to_vec(&json!({"X-Fleet-Device":device,"X-Fleet-Key-Version":version.to_string(),
+        "X-Fleet-Time":ts.to_string(),"X-Fleet-Nonce":nonce,"X-Fleet-Signature":STANDARD.encode(signature.to_bytes())})).ok()
+}
