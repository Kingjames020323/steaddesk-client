--- /dev/null
+++ b/flutter/lib/steaddesk/fleet/fleet_admin_client.dart
@@ -0,0 +1,258 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+class FleetAdminFailure implements Exception {
+  final int status;
+  const FleetAdminFailure(this.status);
+  @override
+  String toString() => switch (status) {
+        401 => '登录状态已变化，请重新登录。',
+        403 => '当前账号没有此操作权限。',
+        409 => '发布或急停状态已变化，请刷新后重试。',
+        422 => '请填写 1–120 字的原因，不要包含控制字符。',
+        _ => '无法连接升级服务，请稍后重试。',
+      };
+}
+
+class FleetAdminIdentity {
+  final Uri origin;
+  final String account, token;
+  const FleetAdminIdentity(
+      {required this.origin, required this.account, required this.token});
+  bool same(FleetAdminIdentity? other) =>
+      other != null &&
+      account == other.account &&
+      token == other.token &&
+      origin == other.origin;
+}
+
+class FleetBatch {
+  final String id, stage, reason, gateReason;
+  final int ring, batch, failed, healthy, observing, deferred;
+  final bool canActivate, canPause, canResume;
+  FleetBatch.from(Map<String, dynamic> row)
+      : id = row['id'] as String,
+        stage = row['stage'] as String,
+        reason = row['reason'] as String? ?? '',
+        gateReason = row['gate_reason'] as String? ?? 'unknown',
+        ring = row['ring'] as int,
+        batch = row['batch'] as int,
+        failed = row['failed'] as int,
+        healthy = row['healthy'] as int,
+        observing = row['pending'] as int,
+        deferred = row['deferred_devices'] as int,
+        canActivate = row['can_activate'] == true,
+        canPause = row['can_pause'] == true,
+        canResume = row['can_resume'] == true;
+}
+
+class FleetDashboard {
+  final bool publish, stop, resume, enabled;
+  final int generation;
+  final String operator;
+  final Object? changedAt;
+  final List<FleetBatch> batches;
+  final List<Map<String, dynamic>> audit;
+  const FleetDashboard._(
+      {required this.publish,
+      required this.stop,
+      required this.resume,
+      required this.enabled,
+      required this.generation,
+      required this.operator,
+      required this.changedAt,
+      required this.batches,
+      required this.audit});
+  factory FleetDashboard.from(Map<String, dynamic> json) {
+    final caps = json['capabilities'];
+    if (caps is! Map ||
+        caps['publish'] is! bool ||
+        caps['stop'] is! bool ||
+        caps['resume'] is! bool) throw const FleetAdminFailure(0);
+    if (caps['publish'] != true) {
+      return const FleetDashboard._(
+          publish: false,
+          stop: false,
+          resume: false,
+          enabled: false,
+          generation: 0,
+          operator: '—',
+          changedAt: null,
+          batches: [],
+          audit: []);
+    }
+    final safety = json['safety'];
+    if (safety is! Map ||
+        safety['enabled'] is! bool ||
+        safety['generation'] is! int ||
+        (safety['generation'] as int) < 0 ||
+        json['batches'] is! List ||
+        json['audit'] is! List) throw const FleetAdminFailure(0);
+    final changed = safety['changed_at'];
+    if (changed != null &&
+        changed is! int &&
+        !(changed is String && DateTime.tryParse(changed) != null)) {
+      throw const FleetAdminFailure(0);
+    }
+    return FleetDashboard._(
+        publish: true,
+        stop: caps['stop'] as bool,
+        resume: caps['resume'] as bool,
+        enabled: safety['enabled'] as bool,
+        generation: safety['generation'] as int,
+        operator: safety['operator'] as String? ?? '—',
+        changedAt: changed,
+        batches: (json['batches'] as List)
+            .map((row) => FleetBatch.from(Map<String, dynamic>.from(row)))
+            .toList(growable: false),
+        audit: (json['audit'] as List)
+            .take(20)
+            .map((row) => Map<String, dynamic>.from(row))
+            .toList(growable: false));
+  }
+}
+
+abstract interface class FleetAdminApi {
+  Future<FleetDashboard> fetch();
+  Future<FleetDashboard> act(String action,
+      {int? generation, String? release, required String reason});
+  void close();
+}
+
+bool validFleetReason(String reason) =>
+    reason.trim().isNotEmpty &&
+    reason.runes.length <= 120 &&
+    !RegExp(r'[\x00-\x1f\x7f-\x9f]').hasMatch(reason);
+
+/// Credentials are sampled and rechecked across each complete operation, never cached to disk.
+class FleetAdminHttp implements FleetAdminApi {
+  final Future<FleetAdminIdentity?> Function() identity;
+  final FleetAdminIdentity? boundIdentity;
+  final HttpClient _http;
+  bool _closed = false;
+  FleetAdminHttp(
+      {required this.identity, this.boundIdentity, SecurityContext? context})
+      : _http = HttpClient(context: context)
+          ..connectionTimeout = const Duration(seconds: 6)
+          ..findProxy = ((_) => 'DIRECT');
+
+  static Uri endpoint(Uri origin) {
+    if (origin.scheme != 'https' ||
+        origin.host.isEmpty ||
+        origin.userInfo.isNotEmpty ||
+        origin.hasQuery ||
+        origin.hasFragment ||
+        !{'', '/', '/ops/v1', '/ops/v1/'}.contains(origin.path)) {
+      throw const FleetAdminFailure(0);
+    }
+    return origin.replace(path: '/ops/v1/fleet-updates');
+  }
+
+  Future<FleetAdminIdentity> _current() async {
+    final who = await identity();
+    if (_closed || who == null || who.token.isEmpty || who.account.isEmpty) {
+      throw const FleetAdminFailure(401);
+    }
+    if (boundIdentity != null && !boundIdentity!.same(who)) {
+      throw const FleetAdminFailure(401);
+    }
+    endpoint(who.origin);
+    return who;
+  }
+
+  Future<void> _check(FleetAdminIdentity who) async {
+    if (_closed || !who.same(await identity())) {
+      throw const FleetAdminFailure(401);
+    }
+  }
+
+  Future<Map<String, dynamic>> _request(FleetAdminIdentity who, String method,
+      [String? action, Map<String, dynamic>? body]) async {
+    await _check(who);
+    final base = endpoint(who.origin);
+    final url =
+        action == null ? base : base.replace(path: '${base.path}/$action');
+    final request =
+        await _http.openUrl(method, url).timeout(const Duration(seconds: 8));
+    try {
+      await _check(who);
+      request.followRedirects = false;
+      request.headers
+          .set(HttpHeaders.authorizationHeader, 'Bearer ${who.token}');
+      request.headers.set(HttpHeaders.acceptHeader, 'application/json');
+      request.headers.set(HttpHeaders.cacheControlHeader, 'no-store');
+      if (body != null) {
+        request.headers.contentType = ContentType.json;
+        final bytes = utf8.encode(jsonEncode(body));
+        request.contentLength = bytes.length;
+        request.add(bytes);
+      }
+      final response =
+          await request.close().timeout(const Duration(seconds: 10));
+      await _check(who);
+      if (response.statusCode != 200) {
+        await response.listen((_) {}).cancel();
+        throw FleetAdminFailure(response.statusCode);
+      }
+      final bytes = <int>[];
+      await for (final chunk in response.timeout(const Duration(seconds: 8))) {
+        if (bytes.length + chunk.length > 1024 * 1024) {
+          throw const FleetAdminFailure(0);
+        }
+        bytes.addAll(chunk);
+      }
+      await _check(who);
+      return jsonDecode(utf8.decode(bytes)) as Map<String, dynamic>;
+    } catch (_) {
+      request.abort();
+      rethrow;
+    }
+  }
+
+  @override
+  Future<FleetDashboard> fetch() async {
+    final who = await _current();
+    return FleetDashboard.from(await _request(who, 'GET'));
+  }
+
+  @override
+  Future<FleetDashboard> act(String action,
+      {int? generation, String? release, required String reason}) async {
+    if (!{'stop', 'resume', 'pause-release', 'resume-release', 'activate'}
+        .contains(action)) {
+      throw const FleetAdminFailure(403);
+    }
+    if (!validFleetReason(reason)) throw const FleetAdminFailure(422);
+    final who = await _current();
+    final fresh = FleetDashboard.from(await _request(who, 'GET'));
+    if (!fresh.publish) throw const FleetAdminFailure(403);
+    final body = <String, dynamic>{'reason': reason.trim()};
+    if (action == 'stop' || action == 'resume') {
+      if (!(action == 'stop' ? fresh.stop : fresh.resume)) {
+        throw const FleetAdminFailure(403);
+      }
+      if (generation != fresh.generation) throw const FleetAdminFailure(409);
+      body['generation'] = generation;
+    } else {
+      final rows = fresh.batches.where((row) => row.id == release);
+      if (rows.length != 1) throw const FleetAdminFailure(403);
+      final row = rows.single;
+      final allowed = switch (action) {
+        'activate' => row.canActivate,
+        'pause-release' => row.canPause,
+        _ => row.canResume,
+      };
+      if (!allowed) throw const FleetAdminFailure(409);
+      body['release'] = release;
+    }
+    await _request(who, 'POST', action, body);
+    return FleetDashboard.from(await _request(who, 'GET'));
+  }
+
+  @override
+  void close() {
+    _closed = true;
+    _http.close(force: true);
+  }
+}
