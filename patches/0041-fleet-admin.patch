+++ b/flutter/lib/steaddesk/fleet/fleet_admin_host.dart
@@ -0,0 +1,98 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+import '../../common.dart' show gFFI;
+import '../../models/platform_model.dart' show bind;
+import 'fleet_admin_client.dart';
+import 'fleet_admin_widgets.dart';
+
+Future<FleetAdminIdentity?> _identity() async {
+  final account = gFFI.userModel.userName.value;
+  final token = bind.mainGetLocalOption(key: 'access_token');
+  if (account.isEmpty || token.isEmpty) return null;
+  final origin = Uri.tryParse(await bind.mainGetApiServer());
+  if (origin == null ||
+      account != gFFI.userModel.userName.value ||
+      token != bind.mainGetLocalOption(key: 'access_token')) return null;
+  return FleetAdminIdentity(origin: origin, account: account, token: token);
+}
+
+class FleetAdminHost extends StatefulWidget {
+  const FleetAdminHost({super.key});
+  @override
+  State<FleetAdminHost> createState() => _FleetAdminHostState();
+}
+
+class _FleetAdminHostState extends State<FleetAdminHost> {
+  FleetAdminController? controller;
+  FleetAdminIdentity? who;
+  Timer? timer;
+  StreamSubscription<String>? login;
+  bool resolving = false;
+  int generation = 0;
+  @override
+  void initState() {
+    super.initState();
+    timer = Timer.periodic(const Duration(seconds: 1), (_) => sync());
+    login = gFFI.userModel.userName.listen((_) {
+      retire();
+      sync();
+    });
+    scheduleMicrotask(sync);
+  }
+
+  void retire() {
+    generation++;
+    final old = controller;
+    controller = null;
+    who = null;
+    if (old != null) {
+      old.retire();
+      scheduleMicrotask(old.dispose);
+    }
+    if (mounted) setState(() {});
+  }
+
+  Future<void> sync() async {
+    if (resolving || !mounted) return;
+    resolving = true;
+    final guard = generation;
+    try {
+      final next = await _identity();
+      if (!mounted || guard != generation) return;
+      if ((who == null && next == null) || (who != null && who!.same(next))) {
+        return;
+      }
+      retire();
+      if (next == null) return;
+      final epoch = generation;
+      who = next;
+      controller = FleetAdminController(
+          FleetAdminHttp(identity: _identity, boundIdentity: next),
+          isCurrent: () =>
+              mounted &&
+              generation == epoch &&
+              gFFI.userModel.userName.value == next.account &&
+              bind.mainGetLocalOption(key: 'access_token') == next.token);
+      setState(() {});
+      controller!.start();
+    } catch (_) {
+      if (mounted) retire();
+    } finally {
+      resolving = false;
+    }
+  }
+
+  @override
+  void dispose() {
+    timer?.cancel();
+    login?.cancel();
+    controller?.retire();
+    controller?.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => controller == null
+      ? const SizedBox.shrink()
+      : FleetAdminHeader(controller: controller!);
+}
