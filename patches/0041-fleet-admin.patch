+++ b/flutter/lib/steaddesk/fleet/fleet_admin_widgets.dart
@@ -0,0 +1,384 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'fleet_admin_client.dart';
+
+class FleetAdminController extends ChangeNotifier {
+  final FleetAdminApi api;
+  final bool Function() isCurrent;
+  FleetAdminController(this.api, {required this.isCurrent});
+  FleetDashboard? dashboard;
+  bool busy = false, _closed = false, _refreshing = false;
+  int _revision = 0;
+  String? error;
+  Timer? _poll;
+  bool get active => !_closed && isCurrent();
+  void start() {
+    refresh();
+    _poll = Timer.periodic(const Duration(seconds: 20), (_) => refresh());
+  }
+
+  Future<void> refresh() async {
+    if (!active || busy || _refreshing) return;
+    _refreshing = true;
+    final revision = _revision;
+    try {
+      final value = await api.fetch();
+      if (!active || revision != _revision) return;
+      dashboard = value;
+      error = null;
+    } catch (failure) {
+      if (!active || revision != _revision) return;
+      dashboard = null;
+      error = failure is FleetAdminFailure
+          ? failure.toString()
+          : const FleetAdminFailure(0).toString();
+    } finally {
+      _refreshing = false;
+    }
+    if (active && revision == _revision) notifyListeners();
+  }
+
+  Future<void> act(String action,
+      {int? generation, String? release, required String reason}) async {
+    if (!active || busy) throw const FleetAdminFailure(401);
+    _revision++;
+    busy = true;
+    error = null;
+    notifyListeners();
+    try {
+      final next = await api.act(action,
+          generation: generation, release: release, reason: reason);
+      if (!active) throw const FleetAdminFailure(401);
+      dashboard = next;
+    } catch (failure) {
+      if (active) {
+        dashboard = null;
+        error = failure is FleetAdminFailure
+            ? failure.toString()
+            : const FleetAdminFailure(0).toString();
+      }
+      rethrow;
+    } finally {
+      busy = false;
+      if (active) notifyListeners();
+    }
+  }
+
+  void retire() {
+    if (_closed) return;
+    _closed = true;
+    _revision++;
+    dashboard = null;
+    _poll?.cancel();
+    api.close();
+    notifyListeners();
+  }
+
+  @override
+  void dispose() {
+    retire();
+    super.dispose();
+  }
+}
+
+String fleetTime(Object? value) {
+  final at = value is int && value > 0
+      ? DateTime.fromMillisecondsSinceEpoch(value * 1000, isUtc: true)
+      : value is String
+          ? DateTime.tryParse(value)?.toUtc()
+          : null;
+  return at == null
+      ? '未记录'
+      : '${at.toIso8601String().replaceFirst('.000Z', '')} UTC';
+}
+
+String fleetGate(String reason) => switch (reason) {
+      'small_sample' || 'sample_too_small' => '健康样本不足，不能自动推进',
+      'observing' || 'observation_pending' => '观察期尚未结束',
+      'integrity' || 'integrity_frozen' => '完整性冻结，需负责人核查',
+      'global_stop' => '全局急停中',
+      'failure_rate' || 'ring0_failure' => '失败门禁未通过',
+      'eligible' || 'ready' => '服务端允许推进',
+      _ => '服务端门禁：$reason',
+    };
+
+Future<bool> _confirm(BuildContext context, String title, String text) async =>
+    await showDialog<bool>(
+        context: context,
+        builder: (ctx) =>
+            AlertDialog(title: Text(title), content: Text(text), actions: [
+              TextButton(
+                  onPressed: () => Navigator.pop(ctx, false),
+                  child: const Text('取消')),
+              FilledButton(
+                  onPressed: () => Navigator.pop(ctx, true),
+                  child: const Text('确认'))
+            ])) ??
+    false;
+
+Future<String?> _reason(BuildContext context, String title) =>
+    showDialog<String>(context: context, builder: (_) => _FleetReason(title));
+
+class _FleetReason extends StatefulWidget {
+  final String title;
+  const _FleetReason(this.title);
+  @override
+  State<_FleetReason> createState() => _FleetReasonState();
+}
+
+class _FleetReasonState extends State<_FleetReason> {
+  final input = TextEditingController();
+  @override
+  void dispose() {
+    input.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => AlertDialog(
+          title: Text(widget.title),
+          content: SizedBox(
+              width: 420,
+              child: TextField(
+                  key: const ValueKey('fleet-reason'),
+                  controller: input,
+                  maxLength: 120,
+                  maxLines: 3,
+                  onChanged: (_) => setState(() {}),
+                  decoration: const InputDecoration(
+                      labelText: '操作原因', helperText: '请勿填写密码、令牌或商户隐私'))),
+          actions: [
+            TextButton(
+                onPressed: () => Navigator.pop(context),
+                child: const Text('取消')),
+            FilledButton(
+                onPressed: validFleetReason(input.text)
+                    ? () => Navigator.pop(context, input.text.trim())
+                    : null,
+                child: const Text('确认'))
+          ]);
+}
+
+Future<void> fleetAction(
+    BuildContext context, FleetAdminController controller, String action,
+    {String? release}) async {
+  final snapshot = controller.dashboard;
+  if (!controller.active || controller.busy || snapshot == null) return;
+  String? reason;
+  if (action == 'stop') {
+    if (!snapshot.stop ||
+        !await _confirm(
+            context, '停止所有升级？', '将立即关闭全局升级许可，并通知设备关闭自愈。已提交的安装继续跟踪。')) return;
+    reason = 'console_emergency_stop';
+  } else if (action == 'resume') {
+    if (!snapshot.resume ||
+        !await _confirm(context, '准备解除全局急停？', '请先核查故障、在途事务及发布状态。')) return;
+    if (!context.mounted) return;
+    reason = await _reason(context, '填写解除原因');
+    if (reason == null || !context.mounted) return;
+    if (!await _confirm(
+        context, '再次确认解除急停', '原因：$reason\n只恢复升级许可，自愈不会自动重新开启。')) {
+      return;
+    }
+  } else {
+    reason = await _reason(
+        context,
+        switch (action) {
+          'pause-release' => '暂停发布',
+          'resume-release' => '恢复发布',
+          _ => '推进下一环 / 批次'
+        });
+    if (reason == null) return;
+  }
+  if (!context.mounted || !controller.active) return;
+  try {
+    await controller.act(action,
+        generation: snapshot.generation, release: release, reason: reason);
+  } catch (_) {
+    if (context.mounted) {
+      ScaffoldMessenger.maybeOf(context)?.showSnackBar(SnackBar(
+          content: Text(
+              controller.error ?? const FleetAdminFailure(401).toString())));
+    }
+  }
+}
+
+class FleetAdminHeader extends StatelessWidget {
+  final FleetAdminController controller;
+  const FleetAdminHeader({super.key, required this.controller});
+  @override
+  Widget build(BuildContext context) => AnimatedBuilder(
+      animation: controller,
+      builder: (_, __) {
+        final d = controller.dashboard;
+        if (!controller.active || d == null || !d.publish) {
+          return const SizedBox.shrink();
+        }
+        return Container(
+            width: double.infinity,
+            key: const ValueKey('fleet-header'),
+            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
+            decoration: const BoxDecoration(
+                color: Color(0xfffff5f3),
+                border: Border(bottom: BorderSide(color: Color(0xfff0c9c3)))),
+            child: Wrap(
+                spacing: 16,
+                runSpacing: 8,
+                crossAxisAlignment: WrapCrossAlignment.center,
+                children: [
+                  if (d.enabled && d.stop)
+                    FilledButton.icon(
+                        key: const ValueKey('fleet-stop'),
+                        style: FilledButton.styleFrom(
+                            backgroundColor: const Color(0xffb42318),
+                            foregroundColor: Colors.white),
+                        onPressed: controller.busy
+                            ? null
+                            : () => fleetAction(context, controller, 'stop'),
+                        icon: const Icon(Icons.stop_circle_outlined),
+                        label: const Text('全局急停')),
+                  if (!d.enabled)
+                    const Text('全局升级已停止',
+                        style: TextStyle(
+                            color: Color(0xffb42318),
+                            fontWeight: FontWeight.bold)),
+                  if (!d.enabled && d.resume)
+                    OutlinedButton(
+                        key: const ValueKey('fleet-resume'),
+                        onPressed: controller.busy
+                            ? null
+                            : () => fleetAction(context, controller, 'resume'),
+                        child: const Text('解除急停')),
+                  Text(
+                      'generation ${d.generation} · ${d.operator} · ${fleetTime(d.changedAt)}',
+                      style: const TextStyle(fontSize: 12)),
+                  TextButton.icon(
+                      key: const ValueKey('fleet-open'),
+                      onPressed: () => showDialog<void>(
+                          context: context,
+                          builder: (ctx) => Dialog(
+                              child: SizedBox(
+                                  width: 1000,
+                                  height: 700,
+                                  child: FleetAdminPanel(
+                                      controller: controller)))),
+                      icon: const Icon(Icons.system_update_alt),
+                      label: const Text('批量升级')),
+                ]));
+      });
+}
+
+class FleetAdminPanel extends StatelessWidget {
+  final FleetAdminController controller;
+  const FleetAdminPanel({super.key, required this.controller});
+  @override
+  Widget build(BuildContext context) => AnimatedBuilder(
+      animation: controller,
+      builder: (_, __) {
+        final d = controller.dashboard;
+        if (!controller.active || d == null || !d.publish) {
+          return Center(child: Text(controller.error ?? '当前账号没有发布权限。'));
+        }
+        return Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              Padding(
+                  padding: const EdgeInsets.fromLTRB(24, 16, 12, 8),
+                  child: Row(children: [
+                    const Expanded(
+                        child: Text('批量升级',
+                            style: TextStyle(
+                                fontSize: 22, fontWeight: FontWeight.bold))),
+                    IconButton(
+                        tooltip: '刷新',
+                        onPressed: controller.busy ? null : controller.refresh,
+                        icon: const Icon(Icons.refresh)),
+                    IconButton(
+                        tooltip: '关闭',
+                        onPressed: () => Navigator.maybePop(context),
+                        icon: const Icon(Icons.close))
+                  ])),
+              Padding(
+                  padding: const EdgeInsets.symmetric(horizontal: 24),
+                  child: Text(
+                      '全局${d.enabled ? '运行' : '已停止'} · generation ${d.generation} · ${d.operator} · ${fleetTime(d.changedAt)}')),
+              if (controller.busy) const LinearProgressIndicator(),
+              Expanded(
+                  child: ListView(padding: const EdgeInsets.all(24), children: [
+                if (d.batches.isEmpty)
+                  const Padding(
+                      padding: EdgeInsets.symmetric(vertical: 24),
+                      child: Text('暂无发布')),
+                for (final row in d.batches)
+                  Card(
+                      margin: const EdgeInsets.only(bottom: 12),
+                      child: Padding(
+                          padding: const EdgeInsets.all(16),
+                          child: Column(
+                              crossAxisAlignment: CrossAxisAlignment.start,
+                              children: [
+                                Text(
+                                    '${row.id} · 环 ${row.ring} / 批次 ${row.batch}',
+                                    style: const TextStyle(
+                                        fontSize: 16,
+                                        fontWeight: FontWeight.w600)),
+                                const SizedBox(height: 8),
+                                Text(
+                                    '状态 ${row.stage}${row.reason.isEmpty ? '' : ' · ${row.reason}'}'),
+                                const SizedBox(height: 8),
+                                Wrap(spacing: 24, runSpacing: 8, children: [
+                                  Text('失败 ${row.failed}'),
+                                  Text('健康 ${row.healthy}'),
+                                  Text('观察 / 等待 ${row.observing}'),
+                                  Text('延期 ${row.deferred}')
+                                ]),
+                                const SizedBox(height: 8),
+                                Text(fleetGate(row.gateReason),
+                                    style: TextStyle(
+                                        color: row.canActivate
+                                            ? const Color(0xff067647)
+                                            : const Color(0xff854a0e))),
+                                Wrap(spacing: 8, children: [
+                                  OutlinedButton(
+                                      onPressed:
+                                          !controller.busy && row.canPause
+                                              ? () => fleetAction(context,
+                                                  controller, 'pause-release',
+                                                  release: row.id)
+                                              : null,
+                                      child: const Text('暂停发布')),
+                                  OutlinedButton(
+                                      onPressed:
+                                          !controller.busy && row.canResume
+                                              ? () => fleetAction(context,
+                                                  controller, 'resume-release',
+                                                  release: row.id)
+                                              : null,
+                                      child: const Text('恢复发布')),
+                                  FilledButton(
+                                      key: ValueKey('fleet-activate-${row.id}'),
+                                      onPressed: !controller.busy &&
+                                              row.canActivate
+                                          ? () => fleetAction(
+                                              context, controller, 'activate',
+                                              release: row.id)
+                                          : null,
+                                      child: const Text('推进下一环 / 批次')),
+                                ]),
+                              ]))),
+                const SizedBox(height: 16),
+                const Text('最近 20 条管理审计',
+                    style:
+                        TextStyle(fontSize: 18, fontWeight: FontWeight.w600)),
+                for (final row in d.audit)
+                  ListTile(
+                      contentPadding: EdgeInsets.zero,
+                      dense: true,
+                      title: Text(
+                          '${row['action']} · ${row['target']} · ${row['actor']}'),
+                      subtitle: Text(
+                          '${fleetTime(row['at'])} · ${row['reason'] ?? '—'} · ${row['result'] ?? '—'}')),
+              ])),
+            ]);
+      });
+}
