+          'at': '2026-11-14T23:10:00Z',
+          'reason': 'monthly_drill',
+          'result': 'ok'
+        }
+      ],
+    };
+
+class FakeFleet implements FleetAdminApi {
+  Map<String, dynamic> value = fixture();
+  final writes = <Map<String, Object?>>[];
+  int? error;
+  Completer<FleetDashboard>? pending;
+  @override
+  Future<FleetDashboard> fetch() async {
+    if (error != null) throw FleetAdminFailure(error!);
+    if (pending != null) return await pending!.future;
+    return FleetDashboard.from(value);
+  }
+
+  @override
+  Future<FleetDashboard> act(String action,
+      {int? generation, String? release, required String reason}) async {
+    if (error != null) throw FleetAdminFailure(error!);
+    writes.add({
+      'action': action,
+      'generation': generation,
+      'release': release,
+      'reason': reason
+    });
+    if (action == 'stop') (value['safety'] as Map)['enabled'] = false;
+    if (action == 'resume') (value['safety'] as Map)['enabled'] = true;
+    return FleetDashboard.from(value);
+  }
+
+  @override
+  void close() {}
+}
+
+Future<void> mount(WidgetTester tester, FleetAdminController controller,
+    {bool panel = false}) async {
+  tester.view.physicalSize = const Size(1200, 900);
+  tester.view.devicePixelRatio = 1;
+  addTearDown(tester.view.resetPhysicalSize);
+  addTearDown(tester.view.resetDevicePixelRatio);
+  await tester.pumpWidget(MaterialApp(
+      theme: ThemeData(
+          fontFamily: 'FleetTest',
+          useMaterial3: true,
+          colorScheme:
+              ColorScheme.fromSeed(seedColor: const Color(0xff0a6fa8))),
+      home: Scaffold(
+          body: RepaintBoundary(
+              key: const ValueKey('fleet-render'),
+              child: Material(
+                  color: Colors.white,
+                  child: Column(children: [
+                    FleetAdminHeader(controller: controller),
+                    if (panel)
+                      Expanded(child: FleetAdminPanel(controller: controller))
+                  ]))))));
+  await tester.pumpAndSettle();
+}
+
+void main() {
+  test('nonpublisher response omits all sensitive aggregate fields', () {
+    final d = FleetDashboard.from({
