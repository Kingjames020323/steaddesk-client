+    expect(d.audit, isEmpty);
+  });
+  test('malformed publisher safety never becomes legitimate stopped state', () {
+    final data = fixture();
+    (data['safety'] as Map)['enabled'] = 1;
+    expect(() => FleetDashboard.from(data), throwsA(isA<FleetAdminFailure>()));
+  });
+  test('reason bounds preserve Unicode but reject controls', () {
+    expect(validFleetReason('例行演练'), true);
+    expect(validFleetReason(' '), false);
+    expect(validFleetReason('a\nb'), false);
+    expect(validFleetReason('x' * 121), false);
+    expect(validFleetReason('🔧' * 120), true);
+  });
+  test('only TLS approved fixed origin is accepted', () {
+    for (final s in [
+      'http://localhost',
+      'https://user:secret@example.invalid',
+      'https://example.invalid/other',
+      'https://example.invalid/?q=1'
+    ]) {
+      expect(() => FleetAdminHttp.endpoint(Uri.parse(s)),
+          throwsA(isA<FleetAdminFailure>()));
+    }
+    expect(
+        FleetAdminHttp.endpoint(Uri.parse('https://example.invalid/ops/v1'))
+            .path,
+        '/ops/v1/fleet-updates');
