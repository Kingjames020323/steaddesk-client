+
+Map<String, dynamic> fixture(
+        {bool publisher = true,
+        bool enabled = true,
+        bool resume = true,
+        bool activate = false}) =>
+    {
+      'capabilities': {
+        'publish': publisher,
+        'stop': publisher,
+        'resume': resume
+      },
+      'safety': {
+        'enabled': enabled,
+        'generation': 8,
+        'operator': 'test_operator',
+        'changed_at': '2026-11-14T23:10:00Z'
+      },
+      'batches': [
+        {
+          'id': 'test-release',
+          'ring': 1,
+          'batch': 0,
+          'stage': 'paused',
+          'reason': 'review_requested',
+          'failed': 1,
+          'healthy': 12,
+          'pending': 3,
+          'deferred_devices': 4,
+          'can_activate': activate,
+          'gate_reason': activate ? 'eligible' : 'small_sample',
+          'can_pause': false,
+          'can_resume': true
