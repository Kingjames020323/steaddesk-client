+          origin: original.origin, account: original.account, token: 'test-b'),
+      FleetAdminIdentity(
+          origin: Uri.parse('https://new.example.invalid'),
+          account: original.account,
+          token: original.token),
+      FleetAdminIdentity(
+          origin: original.origin, account: 'other', token: original.token)
