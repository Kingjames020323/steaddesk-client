index 0000000..cee2315
--- /dev/null
+++ b/flutter/lib/steaddesk/metrics/metric_quality.dart
@@ -0,0 +1,11 @@
+/// Retain only the optional v1 quality fields at IPC and storage boundaries.
+Map<String, dynamic>? metricQuality(Object? value) {
+  if (value is! Map) return null;
+  final mode = value['mode'];
+  final base = value['base'];
+  if (mode != 'auto' && mode != 'manual') return null;
+  if (base != null && base != 'best' && base != 'balanced' && base != 'low') {
+    return null;
+  }
+  return {'mode': mode, 'base': base};
+}
