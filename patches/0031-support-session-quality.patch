+++ b/flutter/test/steaddesk/session_quality_test.dart
@@ -0,0 +1,162 @@
+import 'package:flutter_hbb/steaddesk/session_quality.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  testWidgets('auto applies one native preset after fresh startup samples',
+      (tester) async {
+    for (final test in [
+      ('true', [70, 180, 50], 'balanced'),
+      ('false', [40], 'low'),
+      ('true', [200, 102], 'low'),
+      ('true', [201, 99], 'balanced'),
+      ('true', <int>[], 'balanced'),
+      ('false', <int>[], 'balanced'),
+    ]) {
+      final writes = <String>[];
+      final records = <String>[];
+      final q = SessionQuality(writes.add, (m, b) => records.add('$m/$b'),
+          clock: tester.binding.clock.now);
+      q.observe({'delay': '999'});
+      q.ready(test.$1);
+      for (final sample in test.$2) {
+        q.observe({'delay': '$sample'});
+      }
+      await tester.pump(const Duration(milliseconds: 4999));
+      expect(writes, isEmpty);
+      q.ready(test.$1);
+      await tester.pump(const Duration(milliseconds: 1));
+      expect(writes, [test.$3]);
+      expect(records, ['auto/null', 'auto/${test.$3}']);
+      q.observe({'delay': '999'});
+      q.disconnected();
+      q.ready('false');
+      await tester.pump(const Duration(seconds: 6));
+      expect(writes, [test.$3]);
+      q.dispose();
+    }
+  });
+
+  testWidgets('freshness is based only on new RTTs, including repeated values',
+      (tester) async {
+    final q =
+        SessionQuality((_) {}, (_, __) {}, clock: tester.binding.clock.now);
+    q.ready('true');
+    q.observe({'delay': '65', 'fps': '{}'});
+    await tester.pump(const Duration(seconds: 4));
+    q.observe({'delay': '', 'fps': '{"0":1,"2":0}'});
+    expect(q.fps, {0: 1, 2: 0});
+    expect(q.delay, 65);
+    await tester.pump(const Duration(seconds: 1));
+    expect(q.delay, isNull);
+    q.observe({'delay': '80'});
+    await tester.pump(const Duration(seconds: 4));
+    q.observe({'delay': '80'});
+    await tester.pump(const Duration(seconds: 4));
+    expect(q.delay, 80);
+    q.disconnected();
+    q.observe({'delay': '7', 'fps': '{"0":42}'});
+    expect(q.delay, isNull);
+    expect(q.route, isNull);
+    expect(q.fps, isEmpty);
+    q.dispose();
+  });
+
+  testWidgets('manual wins pending decision and survives reconnects',
+      (tester) async {
+    final writes = <String>[];
+    final q =
+        SessionQuality(writes.add, (_, __) {}, clock: tester.binding.clock.now);
+    q.ready('true');
+    q.selectManual('best');
+    expect(q.manual, isTrue);
+    q.disconnected();
+    q.ready('false');
+    await tester.pump(const Duration(seconds: 8));
+    expect(writes, ['best']);
+    q.selectManual('custom');
+    expect(q.base, isNull);
+    expect(writes, ['best', 'custom']);
+    final moved = SessionQuality(writes.add, (_, __) {},
+        canStart: false, clock: tester.binding.clock.now);
+    moved.restore(q.snapshot(detach: true), owner: true);
+    moved.ready('true');
+    await tester.pump(const Duration(seconds: 5));
+    expect(moved.manual, isTrue);
+    expect(writes, ['best', 'custom']);
+    q.dispose();
+    moved.dispose();
+  });
+
+  testWidgets('transfer keeps original deadline and has only one writer',
+      (tester) async {
+    final writes = <String>[];
+    SessionQuality view(bool owner) => SessionQuality(writes.add, (_, __) {},
+        canStart: owner, clock: tester.binding.clock.now);
+    final q = view(true)..ready('true');
+    q.observe({'delay': '220'});
+    await tester.pump(const Duration(seconds: 3));
+    final monitor = view(false)
+      ..restore(q.snapshot(detach: false), owner: false);
+    expect(monitor.canSelect, isFalse);
+    monitor.selectManual('best');
+    expect(writes, isEmpty);
+    final moved = view(false)..restore(q.snapshot(detach: true), owner: true);
+    expect(moved.canSelect, isTrue);
+    expect(q.canSelect, isFalse);
+    expect(moved.delay, isNull);
+    expect(moved.route, 'direct');
+    await tester.pump(const Duration(seconds: 2));
+    expect(writes, ['low']);
+    q.dispose();
+    monitor.dispose();
+    moved.dispose();
+  });
+
+  testWidgets(
+      'surviving monitor takes over without reapplying manual selection',
+      (tester) async {
+    final writes = <String>[];
+    final q =
+        SessionQuality(writes.add, (_, __) {}, clock: tester.binding.clock.now)
+          ..ready('false');
+    q.selectManual('balanced');
+    final duplicate = q.snapshot(detach: false);
+    final monitor = SessionQuality(writes.add, (_, __) {},
+        canStart: false, clock: tester.binding.clock.now)
+      ..restore(duplicate, owner: false);
+    expect(monitor.manual, isTrue);
+    expect(monitor.canSelect, isFalse);
+    final movedObserver = SessionQuality(writes.add, (_, __) {},
+        canStart: false, clock: tester.binding.clock.now)
+      ..restore(monitor.snapshot(detach: true), owner: true);
+    expect(movedObserver.isOwner, isFalse);
+    movedObserver.dispose();
+    q.selectManual('low');
+    monitor.restore(q.snapshot(detach: true), owner: true);
+    monitor.restore(duplicate, owner: false);
+    expect(monitor.canSelect, isTrue);
+    expect(monitor.manual, isTrue);
+    expect(monitor.base, 'low');
+    monitor.selectManual('best');
+    await tester.pump(const Duration(seconds: 6));
+    expect(writes, ['balanced', 'low', 'best']);
+    q.dispose();
+    monitor.dispose();
+  });
+
+  testWidgets('closing or losing the transport cancels pending writes',
+      (tester) async {
+    final writes = <String>[];
+    final q =
+        SessionQuality(writes.add, (_, __) {}, clock: tester.binding.clock.now);
+    q.ready('false');
+    q.observe({'delay': '450'});
+    q.disconnected();
+    await tester.pump(const Duration(seconds: 10));
+    expect(writes, isEmpty);
+    q.ready('true');
+    q.dispose();
+    await tester.pump(const Duration(seconds: 5));
+    expect(writes, isEmpty);
+  });
+}
