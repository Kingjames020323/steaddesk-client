new file mode 100644
index 0000000..b129e60
--- /dev/null
+++ b/flutter/lib/steaddesk/quality_badge.dart
@@ -0,0 +1,59 @@
+import 'package:flutter/material.dart';
+
+/// The owner expires RTT independently from FPS; null always paints unknown.
+class QualityBadge extends StatelessWidget {
+  final int? delay;
+  final String? route;
+  final String unknown;
+  final Map<int, int> fps;
+  final int display;
+  final String Function(int) monitorLabel;
+  final List<String> details;
+
+  const QualityBadge({
+    super.key,
+    required this.delay,
+    required this.route,
+    required this.unknown,
+    required this.fps,
+    required this.display,
+    required this.monitorLabel,
+    required this.details,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final ms = delay;
+    final color = ms == null
+        ? const Color(0xff6b7280)
+        : ms < 80
+            ? const Color(0xff047857)
+            : ms <= 200
+                ? const Color(0xffb45309)
+                : const Color(0xffb91c1c);
+    final value = ms == null ? unknown : '$ms ms';
+    final label = [if (route != null) route!, value].join(' · ');
+    final screens = display < 0 ? (fps.keys.toList()..sort()) : [display];
+    final tip = [
+      label,
+      for (final screen in screens)
+        if (fps[screen] != null) '${monitorLabel(screen)}: ${fps[screen]} FPS',
+      ...details,
+    ];
+    return Tooltip(
+        message: tip.join('\n'),
+        child: Padding(
+            padding: const EdgeInsets.symmetric(horizontal: 6),
+            child: Row(mainAxisSize: MainAxisSize.min, children: [
+              Container(
+                  width: 4,
+                  height: 16,
+                  decoration: BoxDecoration(
+                      color: color, borderRadius: BorderRadius.circular(2))),
+              const SizedBox(width: 4),
+              Text(label,
+                  style: const TextStyle(
+                      fontFeatures: [FontFeature.tabularFigures()]))
+            ])));
+  }
+}
diff --git a/flutter/lib/steaddesk/session_quality.dart b/flutter/lib/steaddesk/session_quality.dart
new file mode 100644
index 0000000..ced6656
--- /dev/null
+++ b/flutter/lib/steaddesk/session_quality.dart
@@ -0,0 +1,191 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+
+/// Session-local overlay on the native image quality presets. Only incoming RTT
+/// fields refresh latency; the core continues to own its adaptive encoder.
+class SessionQuality extends ChangeNotifier {
+  static const window = Duration(seconds: 5);
+  final void Function(String) _apply;
+  final void Function(String, String?) _record;
+  final DateTime Function() _now;
+  bool _canStart;
+  bool _closed = false;
+  bool _connected = false;
+  bool manual = false;
+  String? base, route;
+  Map<int, int> fps = const {};
+  int? _lastDelay;
+  DateTime? _until, _freshUntil;
+  final _samples = <int>[];
+  Timer? _startup, _expiry;
+
+  SessionQuality(this._apply, this._record,
+      {bool canStart = true, DateTime Function()? clock})
+      : _canStart = canStart,
+        _now = clock ?? DateTime.now {
+    _record('auto', null);
+  }
+
+  bool get isOwner => !_closed && _canStart;
+
+  bool get canSelect => !_closed && _canStart && _connected;
+
+  int? get delay =>
+      _freshUntil != null && _now().isBefore(_freshUntil!) ? _lastDelay : null;
+
+  void ready(String? direct) {
+    if (_closed) return;
+    route = direct == 'true'
+        ? 'direct'
+        : direct == 'false'
+            ? 'relay'
+            : null;
+    _connected = true;
+    if (_canStart && !manual && base == null && _until == null) {
+      _schedule(_now().add(window));
+    }
+    notifyListeners();
+  }
+
+  void _schedule(DateTime deadline) {
+    _until = deadline;
+    _startup = Timer(deadline.difference(_now()), _chooseOnce);
+  }
+
+  void _chooseOnce() {
+    if (_closed || !_connected || manual || _until == null) return;
+    _samples.sort();
+    final n = _samples.length;
+    final high = n > 0 &&
+        (route == 'relay' || _samples[(n - 1) ~/ 2] + _samples[n ~/ 2] > 300);
+    _cancelStartup();
+    base = high ? 'low' : 'balanced';
+    _apply(base!);
+    _record('auto', base);
+    notifyListeners();
+  }
+
+  void selectManual(String preset) {
+    if (!canSelect ||
+        !const {'best', 'balanced', 'low', 'custom'}.contains(preset)) return;
+    _cancelStartup();
+    manual = true;
+    base = preset == 'custom' ? null : preset;
+    _apply(preset);
+    _record('manual', base);
+    notifyListeners();
+  }
+
+  void observe(Map<String, dynamic> event) {
+    if (_closed || !_connected) return;
+    final at = _now();
+    if (_until != null && !at.isBefore(_until!)) _chooseOnce();
+    final sample = int.tryParse(event['delay']?.toString() ?? '');
+    bool changed = false;
+    if (sample != null && sample >= 0) {
+      _lastDelay = sample;
+      if (_until != null) _samples.add(sample);
+      _freshUntil = at.add(window);
+      _expiry?.cancel();
+      _expiry = Timer(window, () {
+        _lastDelay = null;
+        _freshUntil = null;
+        notifyListeners();
+      });
+      changed = true;
+    }
+    final raw = event['fps'];
+    if (raw is String && raw.isNotEmpty && raw != '{}') {
+      try {
+        final map = jsonDecode(raw);
+        if (map is Map<String, dynamic>) {
+          final current = <int, int>{};
+          for (final entry in map.entries) {
+            final display = int.tryParse(entry.key);
+            final value = entry.value;
+            if (display != null && display >= 0 && value is int && value >= 0) {
+              current[display] = value;
+            }
+          }
+          if (!mapEquals(current, fps)) {
+            fps = Map.unmodifiable(current);
+            changed = true;
+          }
+        }
+      } on FormatException {
+        // An invalid FPS payload does not affect the independently timed RTT.
+      }
+    }
+    if (changed) notifyListeners();
+  }
+
+  void _cancelStartup() {
+    _startup?.cancel();
+    _startup = null;
+    _until = null;
+    _samples.clear();
+  }
+
+  void disconnected() {
+    if (_closed) return;
+    _cancelStartup();
+    _expiry?.cancel();
+    _freshUntil = null;
+    _lastDelay = null;
+    _connected = false;
+    route = null;
+    fps = const {};
+    notifyListeners();
+  }
+
+  /// IPC between windows viewing this transport. Carry the original deadline;
+  /// a move does not extend its sampling period or manufacture a fresh RTT.
+  Map<String, dynamic> snapshot({required bool detach}) {
+    final value = <String, dynamic>{
+      'manual': manual,
+      'base': base,
+      'route': route,
+      'connected': _connected,
+      'owner': _canStart,
+      if (_until != null) 'until': _until!.millisecondsSinceEpoch,
+      if (_until != null) 'samples': List.of(_samples),
+    };
+    if (detach) {
+      _canStart = false;
+      _cancelStartup();
+    }
+    return value;
+  }
+
+  void restore(Map<String, dynamic> data, {required bool owner}) {
+    // A delayed cached snapshot from opening this monitor may arrive after the
+    // old main view has already transferred ownership to it.
+    if (_closed || (_canStart && !owner)) return;
+    _cancelStartup();
+    _canStart = owner && data['owner'] == true;
+    manual = data['manual'] == true;
+    base = data['base'];
+    route = data['route'];
+    _connected = data['connected'] == true;
+    if (_connected &&
+        _canStart &&
+        !manual &&
+        base == null &&
+        data['until'] is int) {
+      _samples.addAll((data['samples'] as List).whereType<int>());
+      _schedule(DateTime.fromMillisecondsSinceEpoch(data['until']));
+    }
+    _record(manual ? 'manual' : 'auto', base);
+    notifyListeners();
+  }
+
+  @override
+  void dispose() {
+    _closed = true;
+    _cancelStartup();
+    _expiry?.cancel();
+    super.dispose();
+  }
+}
