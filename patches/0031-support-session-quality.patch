@@ -0,0 +1,53 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/quality_badge.dart';
+
+void main() {
+  Widget badge(int? delay, int display, Map<int, int> fps) => MaterialApp(
+      home: QualityBadge(
+          delay: delay,
+          route: delay == null ? null : 'Relay',
+          unknown: 'Unknown',
+          fps: fps,
+          display: display,
+          monitorLabel: (i) => 'Screen ${i + 1}',
+          details: const []));
+
+  testWidgets('RTT boundaries and unknown use distinct signal colors',
+      (t) async {
+    for (final entry in <int?, int>{
+      null: 0xff6b7280,
+      79: 0xff047857,
+      80: 0xffb45309,
+      200: 0xffb45309,
+      201: 0xffb91c1c,
+    }.entries) {
+      await t.pumpWidget(badge(entry.key, 0, {0: 0}));
+      final bar = find.descendant(
+          of: find.byType(QualityBadge), matching: find.byType(Container));
+      final deco = t.widget<Container>(bar).decoration as BoxDecoration;
+      expect(deco.color, Color(entry.value));
+      expect(
+          find.text(entry.key == null ? 'Unknown' : 'Relay · ${entry.key} ms'),
+          findsOneWidget);
+      expect(find.textContaining('FPS'), findsNothing);
+    }
+  });
+
+  testWidgets('tooltip uses the selected display or each available monitor',
+      (t) async {
+    const frames = {2: 30, 0: 0};
+    for (final display in [2, -1, 1]) {
+      await t.pumpWidget(badge(50, display, frames));
+      final message = t.widget<Tooltip>(find.byType(Tooltip)).message!;
+      if (display == -1) {
+        expect(message, contains('Screen 1: 0 FPS\nScreen 3: 30 FPS'));
+      } else if (display == 2) {
+        expect(message, contains('Screen 3: 30 FPS'));
+        expect(message, isNot(contains('Screen 1')));
+      } else {
+        expect(message, isNot(contains('FPS')));
+      }
+    }
+  });
+}
