new file mode 100644
index 0000000..4cdf69f
--- /dev/null
+++ b/flutter/lib/steaddesk/check_categories.dart
@@ -0,0 +1,39 @@
+const checkCategoryIds = ['printers', 'payment', 'devices', 'all'];
+
+String checkCategoryForType(String type) => switch (type) {
+      'printer' => 'printers',
+      'payment' => 'payment',
+      _ => 'devices',
+    };
+
+List<String> availableCheckCategories(Iterable<String> types) {
+  final categories = types.map(checkCategoryForType).toSet();
+  return [
+    for (final id in checkCategoryIds)
+      if (categories.contains(id) || (id == 'all' && categories.isNotEmpty)) id,
+  ];
+}
+
+String checkCategoryLabel(String category, String language) {
+  final labels = switch (language.toLowerCase().split(RegExp('[-_]')).first) {
+    'zh' => const {
+        'printers': '检查打印机',
+        'payment': '检查刷卡机',
+        'devices': '检查店内设备',
+        'all': '全部检查',
+      },
+    'es' => const {
+        'printers': 'Revisar impresoras',
+        'payment': 'Revisar terminales de pago',
+        'devices': 'Revisar equipos de la tienda',
+        'all': 'Revisar todo',
+      },
+    _ => const {
+        'printers': 'Check printers',
+        'payment': 'Check card terminals',
+        'devices': 'Check store devices',
+        'all': 'Check all',
+      },
+  };
+  return labels[category]!;
+}
