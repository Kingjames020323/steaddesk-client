diff --git a/flutter/test/steaddesk/quick_category_merchant_test.dart b/flutter/test/steaddesk/quick_category_merchant_test.dart
new file mode 100644
index 0000000..f717a8b
--- /dev/null
+++ b/flutter/test/steaddesk/quick_category_merchant_test.dart
@@ -0,0 +1,142 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/check_categories.dart';
+import 'package:flutter_hbb/steaddesk/quick/check.dart';
+import 'package:flutter_hbb/steaddesk/quick/probe.dart';
+
+void main() {
+  final owner = (
+    origin: Uri.https('fixture.invalid'),
+    device: '123456789',
+    binding: 'test'
+  );
+  const kinds = [
+    'printer',
+    'payment',
+    'host',
+    'secondary',
+    'kiosk',
+    'order_display',
+    'kds',
+    'tablet',
+    'other',
+    'legacy_oven'
+  ];
+  final entries = <Json>[
+    for (var i = 0; i < kinds.length; i++)
+      {
+        'id': 'i_$i',
+        'name': kinds[i],
+        'model': 'fixture',
+        'type': kinds[i],
+        'ip': '192.168.7.${i + 1}',
+        'no_ping': kinds[i] == 'payment'
+      },
+  ];
+  late Directory dir;
+  late MerchantChecks checks;
+  late List<String> starts, probes, connections;
+  late List<Json> reports;
+  var now = 1800000000;
+  String? substitute;
+  bool denyStart = false;
+  setUp(() async {
+    dir = await Directory.systemTemp.createTemp('merchant-categories');
+    now = 1800000000;
+    substitute = null;
+    denyStart = false;
+    starts = [];
+    probes = [];
+    connections = [];
+    reports = [];
+    checks = MerchantChecks(File('${dir.path}/checks'), () async => owner,
+        (actual, op, version, body) async {
+      expect(actual, owner);
+      if (op == 'identity') return {'key_version': 3};
+      if (op == 'report') {
+        reports.add(body);
+        return {'state': 'completed', 'id': 'r_123'};
+      }
+      final cat = op == 'start' ? body['category'] as String : 'all';
+      if (op == 'start') {
+        starts.add(cat);
+        expect(body, {'category': cat});
+        if (denyStart) throw const CheckFailure('limited', 429);
+      } else {
+        expect(op, 'inventory');
+        expect(body, isEmpty);
+      }
+      final selected = (op == 'start' ? substitute : null) ?? cat;
+      return {
+        'device_id': owner.device,
+        'store_id': 's_42',
+        'allowed': true,
+        'probe_details': true,
+        'expires_at': now + 900,
+        'revision': 'a' * 64,
+        'category': cat,
+        'categories': checkCategoryIds,
+        'entries': entries
+            .where((e) =>
+                selected == 'all' ||
+                checkCategoryForType(e['type']) == selected)
+            .toList()
+      };
+    },
+        (row) => checkRegisteredDevice(row, ping: (ip) async {
+              probes.add(row['type']);
+              return 'timeout';
+            }, connect: (ip, port) async {
+              connections.add('$ip:$port');
+              return 'unreachable';
+            }),
+        clock: () => now);
+  });
+  tearDown(() => dir.delete(recursive: true));
+
+  test(
+      'each start sends only category, probes its lease and reports under that category',
+      () async {
+    await checks.sync();
+    expect(checks.approvedCategories, checkCategoryIds);
+    expect(starts, isEmpty);
+    for (final category in checkCategoryIds) {
+      probes.clear();
+      connections.clear();
+      final rows = await checks.run(category);
+      expect(
+          probes,
+          kinds.where(
+              (k) => category == 'all' || checkCategoryForType(k) == category));
+      expect(
+          connections,
+          ['printers', 'all'].contains(category)
+              ? ['192.168.7.1:9100', '192.168.7.1:515', '192.168.7.1:631']
+              : isEmpty);
+      if (category == 'payment') expect(rows.single['outcome'], 'undetectable');
+      expect(reports.last['category'], category);
+      expect((reports.last['results'] as List).map((r) => r['id']),
+          rows.map((r) => r['id']));
+      await expectLater(checks.run(category), throwsA(isA<CheckRateLimit>()));
+    }
+    expect(starts, checkCategoryIds);
+    now += 60;
+    await checks.run('printers');
+    expect(starts.last, 'printers');
+  });
+  test('wrong-category lease, unknown category and server quota never probe',
+      () async {
+    await expectLater(checks.run('unexpected'), throwsA(isA<CheckFailure>()));
+    expect(starts, isEmpty);
+    substitute = 'printers';
+    await expectLater(checks.run('payment'), throwsFormatException);
+    expect(probes, isEmpty);
+    expect(reports, isEmpty);
+    substitute = null;
+    denyStart = true;
+    await expectLater(checks.run('devices'), throwsA(isA<CheckRateLimit>()));
+    expect(probes, isEmpty);
+    expect(checks.approvedUntil, isNotNull);
+  });
+}
