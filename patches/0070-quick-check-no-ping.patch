diff --git a/flutter/lib/steaddesk/quick/result_line.dart b/flutter/lib/steaddesk/quick/result_line.dart
new file mode 100644
index 0000000..8d796f6
--- /dev/null
+++ b/flutter/lib/steaddesk/quick/result_line.dart
@@ -0,0 +1,48 @@
+import 'package:flutter/material.dart';
+
+const supportCheckLabels = {
+  'reachable': '通',
+  'unreachable': '不通',
+  'timeout': '超时',
+  'unknown': '未知',
+  'undetectable': '无法检测',
+};
+
+String merchantUndetectableLabel(String locale) {
+  switch (locale.toLowerCase().split(RegExp('[-_]')).first) {
+    case 'zh':
+      return '无法检测';
+    case 'es':
+      return 'No se puede detectar';
+    default:
+      return 'Cannot detect';
+  }
+}
+
+class QuickCheckResultLine extends StatelessWidget {
+  final Map row;
+  final String label;
+  final bool showIp;
+  final bool showMissingLatency;
+
+  const QuickCheckResultLine(this.row, this.label,
+      {super.key, this.showIp = false, this.showMissingLatency = true});
+
+  @override
+  Widget build(BuildContext context) {
+    final latency = row['latency_ms'];
+    return Text.rich(TextSpan(children: [
+      TextSpan(text: "${row['name']} · "),
+      if (showIp) TextSpan(text: "${row['ip']} · "),
+      TextSpan(
+          text: label,
+          style: row['outcome'] == 'undetectable'
+              ? const TextStyle(color: Colors.grey)
+              : null),
+      if (latency != null)
+        TextSpan(text: ' · $latency ms')
+      else if (showMissingLatency)
+        const TextSpan(text: ' · —'),
+    ]));
+  }
+}
