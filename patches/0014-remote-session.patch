+            onPressed: recording.toggle),
+      MenuButton(
+          ffi: ffi,
+          child: Text(translate('Fullscreen')),
+          onPressed: () =>
+              stateGlobal.setFullscreen(!stateGlobal.fullscreen.value)),
+      MenuButton(
+          ffi: ffi,
