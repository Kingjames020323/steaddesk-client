+class _RecordingTime extends StatefulWidget {
+  final RecordingModel model;
+  const _RecordingTime({required this.model});
+  @override
+  State<_RecordingTime> createState() => _RecordingTimeState();
+}
+
+class _RecordingTimeState extends State<_RecordingTime> {
+  late final Timer tick;
+  @override
+  void initState() {
+    super.initState();
+    tick = Timer.periodic(const Duration(seconds: 1), (_) => setState(() {}));
+  }
+
+  @override
+  void dispose() {
+    tick.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final t = widget.model.elapsed.elapsed;
+    return Text(
+        '● ${translate("Recording in progress")} ${t.inMinutes}:${(t.inSeconds % 60).toString().padLeft(2, "0")}',
+        style: _numbers.copyWith(color: _danger));
+  }
+}
