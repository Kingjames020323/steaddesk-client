+part of '../desktop/widgets/remote_toolbar.dart';
+
+// TODO(U-01): Replace the inline session colors with the shared theme tokens.
+const _ocean = Color(0xff0a6fa8);
+const _ink = Color(0xff0b2e42);
+const _surface = Color(0xffeaf4f9);
+const _danger = Color(0xffdc2626);
+const _numbers = TextStyle(fontFeatures: [ui.FontFeature.tabularFigures()]);
+
+enum _PanelMode { expanded, compact, hidden }
+
+class SessionSurface extends StatefulWidget {
+  final String id;
+  final FFI ffi;
+  final ToolbarState state;
+  final Widget canvas;
+  final bool ready;
+  final Function(VoidCallback) setRemoteState;
+  const SessionSurface(
+      {super.key,
+      required this.id,
+      required this.ffi,
+      required this.state,
+      required this.canvas,
+      required this.ready,
+      required this.setRemoteState});
+
+  @override
+  State<SessionSurface> createState() => _SessionSurfaceState();
+}
+
+class _SessionSurfaceState extends State<SessionSurface> {
+  static const panelKey = 'steaddesk-session-panel';
+  late _PanelMode panel;
+  @override
+  void initState() {
+    super.initState();
+    final stored = bind.getLocalFlutterOption(k: panelKey);
+    panel = _PanelMode.values.firstWhere((mode) => mode.name == stored,
+        orElse: () => _PanelMode.expanded);
+  }
+
+  void changePanel(_PanelMode mode) {
+    setState(() => panel = mode);
+    bind.setLocalFlutterOption(k: panelKey, v: mode.name);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final model = Provider.of<FfiModel>(context);
+    final ffi = widget.ffi;
+    final android = widget.ready && model.isPeerAndroid;
+    return Obx(() {
+      final grabbed = ffi.inputModel.relativeMouseMode.value;
+      return ColoredBox(
+          color: _surface,
+          child: Column(children: [
+            IgnorePointer(
+                ignoring: grabbed,
+                child: MenuButtonTheme(
+                    data: MenuButtonThemeData(
+                        style: ButtonStyle(
+                            foregroundColor: MaterialStateProperty.resolveWith(
+                                (states) =>
+                                    states.contains(MaterialState.disabled)
+                                        ? const Color(0xff9ca3af)
+                                        : _ocean),
+                            overlayColor: const MaterialStatePropertyAll(
+                                Color(0xfff3f4f6)),
+                            shape: MaterialStatePropertyAll(
+                                RoundedRectangleBorder(
+                                    borderRadius: BorderRadius.circular(6))))),
+                    child: _SessionHeader(session: widget))),
+            Expanded(
+                child: Row(children: [
+              if (widget.ready)
+                IgnorePointer(
+                    ignoring: grabbed,
+                    child: _DevicePanel(
+                        ffi: ffi, mode: panel, change: changePanel)),
+              Expanded(child: LayoutBuilder(builder: (context, bounds) {
+                final barHeight =
+                    android ? math.min(36.0, bounds.maxHeight / 3) : 0.0;
+                return Stack(fit: StackFit.expand, children: [
+                  Positioned.fill(
+                      bottom: barHeight, child: ClipRect(child: widget.canvas)),
+                  if (android)
+                    AnimatedBuilder(
+                        animation: ffi.canvasModel,
+                        builder: (context, _) {
+                          final c = ffi.canvasModel;
+                          final rect = model.rect;
+                          if (rect == null || rect.isEmpty)
+                            return const SizedBox.shrink();
+                          final visible = Rect.fromLTWH(c.x, c.y,
+                                  rect.width * c.scale, rect.height * c.scale)
+                              .intersect(Rect.fromLTWH(0, 0, bounds.maxWidth,
+                                  bounds.maxHeight - barHeight));
+                          if (visible.isEmpty) return const SizedBox.shrink();
+                          return Positioned(
+                              left: visible.left,
+                              top: visible.bottom,
+                              width: visible.width,
+                              height: barHeight,
+                              child: IgnorePointer(
+                                  ignoring: grabbed,
+                                  child: _AndroidKeys(ffi: ffi)));
+                        }),
+                ]);
+              })),
+            ]))
+          ]));
+    });
+  }
+}
+
+class _SessionHeader extends StatelessWidget {
+  final SessionSurface session;
+  const _SessionHeader({required this.session});
+
+  @override
+  Widget build(BuildContext context) {
+    final ffi = session.ffi;
+    final model = Provider.of<FfiModel>(context);
+    final recording = Provider.of<RecordingModel>(context);
+    final pi = model.pi;
+    final alias = gFFI.abModel.find(session.id)?.alias ?? '';
