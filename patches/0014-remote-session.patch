+class _DevicePanel extends StatelessWidget {
+  final FFI ffi;
+  final _PanelMode mode;
+  final ValueChanged<_PanelMode> change;
+  const _DevicePanel(
+      {required this.ffi, required this.mode, required this.change});
+
+  Future<void> menu(BuildContext context, Offset point) async {
+    final box = Overlay.of(context).context.findRenderObject() as RenderBox;
+    final local = box.globalToLocal(point);
+    final next = await showMenu<_PanelMode>(
+        context: context,
+        position:
+            RelativeRect.fromRect(local & Size.zero, Offset.zero & box.size),
+        items: [
+          if (mode == _PanelMode.expanded)
+            PopupMenuItem(
+                value: _PanelMode.compact,
+                child: Text(translate('Collapse panel'))),
+          if (mode == _PanelMode.compact)
+            PopupMenuItem(
+                value: _PanelMode.expanded,
+                child: Text(translate('Expand panel'))),
+          PopupMenuItem(
+              value: _PanelMode.hidden, child: Text(translate('Hide panel'))),
+        ]);
+    if (next != null && context.mounted) change(next);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final model = Provider.of<FfiModel>(context);
+    final pi = model.pi;
+    final expand = IconButton(
+        icon: const Icon(Icons.chevron_right),
+        color: _ocean,
+        tooltip: translate('Expand panel'),
+        onPressed: () => change(_PanelMode.expanded));
+    if (mode == _PanelMode.hidden)
+      return SizedBox(
+          width: 18,
+          child: Center(
+              child: IconButton(
+                  padding: EdgeInsets.zero,
+                  constraints: const BoxConstraints(),
+                  icon: const Icon(Icons.chevron_right, size: 18),
+                  color: _ocean,
+                  tooltip: translate('Expand panel'),
+                  onPressed: () => change(_PanelMode.expanded))));
+    final reduced = MediaQuery.disableAnimationsOf(context) ||
+        bind.mainGetOptionSync(key: kOptionAllowAlwaysSoftwareRender) == 'Y';
+    final border = BorderRadius.circular(20);
+    Widget glow(Alignment at, Color color) => DecoratedBox(
+        decoration: BoxDecoration(
+            gradient: RadialGradient(
+                center: at,
+                radius: .9,
+                colors: [color.withOpacity(.26), color.withOpacity(0)])));
+    Widget field(String label, String value) => Padding(
+        padding: const EdgeInsets.fromLTRB(12, 5, 12, 5),
+        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+          Text(translate(label),
+              style: const TextStyle(fontSize: 11, color: Color(0xff4b5563))),
+          SelectableText(value, style: _numbers.copyWith(color: _ink)),
+        ]));
+    final compact = mode == _PanelMode.compact;
+    final width = compact
+        ? 44.0
+        : math.min(194.0, MediaQuery.sizeOf(context).width * .25);
+    return Align(
+        alignment: Alignment.topLeft,
+        widthFactor: 1,
+        child: Container(
+            width: width,
+            margin: const EdgeInsets.all(10),
+            decoration: BoxDecoration(borderRadius: border, boxShadow: const [
+              BoxShadow(
+                  color: Color(0x240b3c5a),
+                  offset: Offset(0, 10),
+                  blurRadius: 30)
+            ]),
+            child: GestureDetector(
+                behavior: HitTestBehavior.opaque,
+                onSecondaryTapDown: (event) =>
+                    menu(context, event.globalPosition),
+                child: ClipRRect(
+                    borderRadius: border,
+                    child: Stack(children: [
+                      if (!reduced)
+                        Positioned.fill(
+                            child: Stack(fit: StackFit.expand, children: [
+                          glow(Alignment.topLeft, const Color(0xff1fa7e0)),
+                          glow(Alignment.centerRight, const Color(0xff34c3a6)),
+                          glow(Alignment.bottomLeft, _ocean),
+                        ])),
+                      if (!reduced)
+                        Positioned.fill(
+                            child: BackdropFilter(
+                                filter:
+                                    ui.ImageFilter.blur(sigmaX: 28, sigmaY: 28),
+                                child: const SizedBox.expand())),
+                      Container(
+                          decoration: BoxDecoration(
+                              borderRadius: border,
+                              border:
+                                  Border.all(color: const Color(0xc7ffffff)),
+                              color: reduced ? const Color(0xffe8f4fa) : null,
+                              gradient: reduced
+                                  ? null
+                                  : const LinearGradient(
+                                      begin: Alignment.topLeft,
+                                      end: Alignment.bottomRight,
+                                      colors: [
+                                          Color(0x9effffff),
+                                          Color(0x6bffffff)
+                                        ])),
+                          child: compact
+                              ? expand
+                              : SingleChildScrollView(
+                                  child: Column(
+                                      mainAxisSize: MainAxisSize.min,
+                                      crossAxisAlignment:
+                                          CrossAxisAlignment.stretch,
+                                      children: [
+                                      Row(children: [
+                                        const SizedBox(width: 12),
+                                        Expanded(
+                                            child: Text(
+                                                translate('Device status'),
+                                                overflow: TextOverflow.ellipsis,
+                                                style: const TextStyle(
+                                                    color: _ink,
+                                                    fontWeight:
+                                                        FontWeight.w600))),
+                                        IconButton(
+                                            tooltip:
+                                                translate('Collapse panel'),
+                                            icon:
+                                                const Icon(Icons.chevron_left),
+                                            onPressed: () =>
+                                                change(_PanelMode.compact))
+                                      ]),
+                                      const Divider(height: 1),
+                                      if (pi.platform.isNotEmpty)
+                                        field('Platform', pi.platform),
+                                      if (model.isPeerAndroid &&
+                                          pi.hostname.isNotEmpty)
+                                        field('Device model', pi.hostname),
+                                      AnimatedBuilder(
+                                          animation: ffi.canvasModel,
+                                          builder: (context, _) {
+                                            final rect = model.rect;
+                                            return rect == null || rect.isEmpty
+                                                ? const SizedBox.shrink()
+                                                : field('Resolution',
+                                                    '${rect.width.toInt()} × ${rect.height.toInt()}');
+                                          }),
+                                      Obx(() {
+                                        final value =
+                                            ConnectionTypeState.find(ffi.id)
+                                                .direct
+                                                .value;
+                                        if (value != ConnectionType.strDirect &&
+                                            value !=
+                                                ConnectionType.strIndirect) {
+                                          return const SizedBox.shrink();
+                                        }
+                                        return field(
+                                            'Connection type',
+                                            translate(value ==
+                                                    ConnectionType.strDirect
+                                                ? 'Direct connection'
+                                                : 'Relay connection'));
+                                      }),
+                                      if (pi.version.isNotEmpty)
+                                        field('SteadDesk version', pi.version),
+                                      const SizedBox(height: 10),
+                                    ]))),
+                    ])))));
+  }
+}
