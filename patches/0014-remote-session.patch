+class _Latency extends StatelessWidget {
+  final FFI ffi;
+  const _Latency({required this.ffi});
+  @override
+  Widget build(BuildContext context) => AnimatedBuilder(
+      animation: ffi.qualityMonitorModel,
+      builder: (context, _) {
+        final q = ffi.qualityMonitorModel.data;
+        if (q.delay == null) return const SizedBox.shrink();
+        final details = [
+          if (q.targetBitrate != null)
+            '${translate("Bitrate")}: ${q.targetBitrate} kb/s',
+          if (q.fps != null) 'FPS: ${q.fps}',
+          if (q.codecFormat != null) '${translate("Codec")}: ${q.codecFormat}',
+        ].join('\n');
+        return Padding(
+            padding: const EdgeInsets.symmetric(horizontal: 6),
+            child: Tooltip(
+                message: details,
+                child: Text('${q.delay} ms', style: _numbers)));
+      });
+}
