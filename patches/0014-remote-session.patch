+            constraints: const BoxConstraints(),
+            color: _ocean,
+            iconSize: 18,
+            icon: FittedBox(child: Icon(icon)),
+            onPressed: enabled ? press : null));
+    return Material(
+        color: Colors.white,
+        child: Row(children: [
+          key('Back', Icons.arrow_back, input.onMobileBack),
+          key('Home', Icons.home_outlined, input.onMobileHome),
+          key('Recent apps', Icons.filter_none, input.onMobileApps),
+          key('Volume down', Icons.volume_down_outlined,
+              input.onMobileVolumeDown),
+          key('Volume up', Icons.volume_up_outlined, input.onMobileVolumeUp),
+          key('Power menu', Icons.power_settings_new, input.onMobilePower),
+        ]));
+  }
+}
