+        if (pi.displaysCount.value <= 1 ||
+            (!privacy.isEmpty &&
+                !allowDisplaySwitchInPrivacyMode(pi, privacy.value))) {
+          return const SizedBox.shrink();
+        }
+        return _MonitorMenu(
+            id: session.id,
+            ffi: ffi,
+            edge: _ToolbarEdge.top,
+            setRemoteState: session.setRemoteState);
+      }),
+      _VoiceCallMenu(id: session.id, ffi: ffi),
