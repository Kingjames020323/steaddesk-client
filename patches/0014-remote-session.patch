+    final recordingLocked = isOptionFixed(kOptionAllowAutoRecordOutgoing) &&
+        mainGetLocalBoolOptionSync(kOptionAllowAutoRecordOutgoing);
+    final canToggle = !recordingLocked &&
+        bind.mainGetLocalOption(key: kOptionHideRecordingButton) != 'Y' &&
+        (recording.start || model.permissions['recording'] != false);
