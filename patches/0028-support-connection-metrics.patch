diff --git a/flutter/lib/steaddesk/metrics/metric_seed.dart b/flutter/lib/steaddesk/metrics/metric_seed.dart
new file mode 100644
index 0000000..dcd34d6
--- /dev/null
+++ b/flutter/lib/steaddesk/metrics/metric_seed.dart
@@ -0,0 +1,11 @@
+// Connection targets can contain an alternate server and its key. Persist only
+// a device ID. Direct IP endpoints and unrecognized input have no device ID.
+String? metricDeviceId(String target) {
+  var id = target.replaceAll(' ', '').split('@').first;
+  if (id.endsWith('/r') || id.endsWith(r'\r')) {
+    id = id.substring(0, id.length - 2);
+  }
+  return RegExp(r'^(?:[0-9]{1,32}|[a-zA-Z][a-zA-Z0-9_-]{5,15})$').hasMatch(id)
+      ? id
+      : null;
+}
diff --git a/flutter/lib/steaddesk/metrics/metric_session.dart b/flutter/lib/steaddesk/metrics/metric_session.dart
new file mode 100644
index 0000000..8edc79b
--- /dev/null
+++ b/flutter/lib/steaddesk/metrics/metric_session.dart
@@ -0,0 +1,310 @@
+import 'dart:async';
+import 'dart:convert';
+
+typedef MetricData = Map<String, dynamic>;
+
+/// One ordinary remote connection, including password correction, reconnects and
+/// window moves. Only finish() constructs the allowlisted on-disk row.
+class MetricSession {
+  static final _active = <MetricSession>{};
+  static const _interval = Duration(seconds: 10);
+  final MetricData _seed;
+  final Future<void> Function(MetricData) _write;
+  final DateTime Function() _clock;
+  final int _startMs;
+  int? _readyMs, _authMs, _frameMs, _endedMs;
+  String? _path, _failure, _end;
+  int _reconnects = 0;
+  bool _live = false;
+  bool _detached = false;
+  Timer? _timer;
+  int? _nextSampleMs;
+  final _delay = _Samples();
+  final _fps = _Samples();
+  Future<void>? _finishing;
+
+  MetricSession(this._seed, this._write, {DateTime Function()? clock})
+      : _clock = clock ?? _elapsedClock(),
+        _startMs = DateTime.parse(_seed['started_at']).millisecondsSinceEpoch {
+    _active.add(this);
+  }
+
+  static DateTime Function() _elapsedClock() {
+    final anchor = DateTime.now().toUtc();
+    final elapsed = Stopwatch()..start();
+    return () => anchor.add(elapsed.elapsed);
+  }
+
+  int get _now => _clock().millisecondsSinceEpoch;
+  bool get _stopped => _detached || _finishing != null;
+
+  void ready(String? direct) {
+    if (_stopped) return;
+    if (_frameMs == null && _readyMs == null) {
+      _readyMs = _now;
+      if (direct == 'true' || direct == 'false') {
+        _path = direct == 'true' ? 'direct' : 'relay';
+      }
+    }
+  }
+
+  void authenticated() {
+    if (_stopped) return;
+    if (_frameMs == null) _authMs ??= _now;
+    _failure = null;
+    if (!_live) _startSampling();
+  }
+
+  void firstFrame([DateTime? observedAt]) {
+    if (_stopped) return;
+    // Native buffers may still deliver the previous image while the reconnect
+    // dialog is visible. Require a new live login to recover a failed round.
+    if (!_live && (_end != null || _reconnects != 0)) return;
+    _frameMs ??= observedAt?.millisecondsSinceEpoch ?? _now;
+    _failure = _end = null;
+    _endedMs = null;
+  }
+
+  void message(String type, String title, String text) {
+    if (_stopped) return;
+    if (type == 're-input-password' ||
+        (type == 'input-2fa' && title == 'Wrong 2FA Code')) {
+      _failure = 'auth_failed';
+      return;
+    }
+    final restart = type == 'restarting' || type == 'restarting-show';
+    if (title != 'Connection Error' && title != 'Login Error' && !restart) {
+      return;
+    }
+    if (_frameMs != null) {
+      _end = text == 'Closed manually by the peer'
+          ? 'closed_by_peer'
+          : 'disconnected';
+    } else {
+      if (title == 'Connection Error' && text == 'Remote desktop is offline') {
+        _failure = 'offline';
+      } else if (title == 'Connection Error' && text == 'Timeout') {
+        _failure = 'timeout';
+      } else {
+        _failure = null;
+      }
+      _end = 'connection_failed';
+    }
+    _endedMs ??= _now;
+    _stopSamples();
+  }
+
+  void reconnect() {
+    if (_stopped) return;
+    _reconnects++;
+    if (_frameMs == null) {
+      // Phase differences must use one transport. The click remains the
+      // original one even when only a later attempt produces an image.
+      _readyMs = _authMs = _endedMs = null;
+      _failure = _end = _path = null;
+    }
+    _stopSamples();
+  }
+
+  void quality(MetricData event, int display) {
+    if (!_live || _stopped) return;
+    final now = _now;
+    final delay = int.tryParse(event['delay']?.toString() ?? '');
+    if (delay != null && delay >= 0) _delay.update(delay, now);
+    final raw = event['fps'];
+    if (raw is! String || raw.isEmpty || raw == '{}') return;
+    // The core reports FPS per display. All-displays mode has no single FPS.
+    // A new FPS report replaces an earlier pending observation even when the
+    // selected display is absent. Delay-only updates carry the empty map.
+    _fps.clearPending();
+    if (display < 0) return;
+    try {
+      final map = jsonDecode(raw);
+      final value = map is Map ? map[display.toString()] : null;
+      if (value is int && value >= 0) _fps.update(value, now);
+    } on FormatException {
+      // A malformed event supplies no observation.
+    }
+  }
+
+  void _stopSamples() {
+    _live = false;
+    _timer?.cancel();
+    _timer = null;
+    _fps.clearPending();
+    _delay.clearPending();
+  }
+
+  /// Private IPC only. Never send cached peer info or original login events.
+  MetricData detachForTransfer() {
+    final data = <String, dynamic>{
+      'seed': _seed,
+      'ready': _readyMs,
+      'auth': _authMs,
+      'frame': _frameMs,
+      'ended': _endedMs,
+      'path': _path,
+      'failure': _failure,
+      'end': _end,
+      'reconnects': _reconnects,
+      'live': _live,
+      'next_sample': _nextSampleMs,
+      'delay': _delay.snapshot(),
+      'fps': _fps.snapshot(),
+    };
+    _detached = true;
+    _stopSamples();
+    _active.remove(this);
+    return data;
+  }
+
+  MetricSession.restore(
+      MetricData data, Future<void> Function(MetricData) write,
+      {DateTime Function()? clock})
+      : _seed = data['seed'],
+        _write = write,
+        _clock = clock ?? _elapsedClock(),
+        _startMs =
+            DateTime.parse(data['seed']['started_at']).millisecondsSinceEpoch {
+    _readyMs = data['ready'];
+    _authMs = data['auth'];
+    _frameMs = data['frame'];
+    _endedMs = data['ended'];
+    _path = data['path'];
+    _failure = data['failure'];
+    _end = data['end'];
+    _reconnects = data['reconnects'];
+    _delay.restore(data['delay']);
+    _fps.restore(data['fps']);
+    _active.add(this);
+    if (data['live'] == true) _startSampling(data['next_sample']);
+  }
+
+  void _startSampling([int? next]) {
+    _live = true;
+    final now = _now;
+    _nextSampleMs = next ?? now + _interval.inMilliseconds;
+    final remaining = _nextSampleMs! - now;
+    _timer = Timer(Duration(milliseconds: remaining < 0 ? 0 : remaining), () {
+      final at = _now;
+      final since = at - _interval.inMilliseconds;
+      _delay.sample(since);
+      _fps.sample(since);
+      _startSampling(at + _interval.inMilliseconds);
+    });
+  }
+
+  static int? _difference(int? end, int? start) =>
+      end == null || start == null || end < start ? null : end - start;
+
+  Future<void> finish({String? end = 'closed_by_agent'}) {
+    if (_detached) return Future.value();
+    return _finishing ??= _finish(end);
+  }
+
+  Future<void> _finish(String? end) async {
+    _stopSamples();
+    final reason = _end ?? end;
+    final duration = _difference(_endedMs ?? _now, _startMs);
+    final row = <String, dynamic>{
+      'v': 1,
+      'session': _seed['session'],
+      'device_id': _seed['device_id'],
+      'started_at': _seed['started_at'],
+      'ms': {
+        'lookup': null,
+        'route': null,
+        'auth': _difference(_authMs, _readyMs),
+        'first_frame': _difference(_frameMs, _authMs),
+        'total':
+            _seed['clicked'] == true ? _difference(_frameMs, _startMs) : null,
+      },
+      'path': _path,
+      'result': _frameMs != null
+          ? 'ok'
+          : _failure ?? (reason == 'closed_by_agent' ? 'cancelled' : null),
+      'delay_ms': _delay.summary(),
+      'fps': _fps.summary(),
+      'reconnects': _reconnects,
+      'duration_s': duration == null ? null : duration ~/ 1000,
+      'end': reason,
+    };
+    try {
+      for (var attempt = 0; attempt < 2; attempt++) {
+        try {
+          await _write(row);
+          return;
+        } catch (error) {
+          if (attempt == 1) {
+            // The exception text can contain an account-specific file path.
+            print('Support metric write failed (${error.runtimeType})');
+          } else {
+            await Future<void>.delayed(const Duration(milliseconds: 100));
+          }
+        }
+      }
+    } finally {
+      _active.remove(this);
+    }
+  }
+
+  static Future<void> shutdown() async {
+    await Future.wait(_active.toList().map((s) => s.finish(end: 'app_exit')));
+  }
+}
+
+class _Samples {
+  final _counts = <int, int>{};
+  int? _pending, _at;
+
+  void update(int value, int now) {
+    _pending = value;
+    _at = now;
+  }
+
+  void clearPending() {
+    _pending = _at = null;
+  }
+
+  void sample(int since) {
+    final value = _pending;
+    if (value != null && _at! >= since) {
+      _counts.update(value, (n) => n + 1, ifAbsent: () => 1);
+    }
+    clearPending();
+  }
+
+  MetricData snapshot() => {
+        'counts': {for (final e in _counts.entries) e.key.toString(): e.value},
+        'pending': _pending,
+        'at': _at,
+      };
+  void restore(MetricData data) {
+    _pending = data['pending'];
+    _at = data['at'];
+    final counts = data['counts'] as Map<String, dynamic>;
+    for (final e in counts.entries) {
+      _counts[int.parse(e.key)] = e.value as int;
+    }
+  }
+
+  MetricData? summary() {
+    if (_counts.isEmpty) return null;
+    final keys = _counts.keys.toList()..sort();
+    final size = _counts.values.reduce((a, b) => a + b);
+    int at(int index) {
+      for (final k in keys) {
+        index -= _counts[k]!;
+        if (index < 0) return k;
+      }
+      return keys.last;
+    }
+
+    final lower = at((size - 1) ~/ 2), upper = at(size ~/ 2);
+    return {
+      'min': keys.first,
+      'median': lower == upper ? lower : (lower + upper) / 2,
+      'max': keys.last
+    };
+  }
+}
diff --git a/flutter/lib/steaddesk/metrics/metrics_store.dart b/flutter/lib/steaddesk/metrics/metrics_store.dart
new file mode 100644
index 0000000..aa040d4
--- /dev/null
+++ b/flutter/lib/steaddesk/metrics/metrics_store.dart
@@ -0,0 +1,243 @@
+import 'dart:convert';
+import 'dart:ffi';
+import 'dart:io';
+import 'dart:isolate';
+
+import 'package:ffi/ffi.dart';
+import 'package:path/path.dart' as p;
+import 'package:uuid/uuid.dart';
+
+import 'metric_seed.dart';
+
+const _name = 'support-metrics-v1.jsonl';
+const _limit = 5000;
+const _stats = ['min', 'median', 'max'];
+const _columns = [
+  'v',
+  'session',
+  'device_id',
+  'started_at',
+  'ms.lookup',
+  'ms.route',
+  'ms.auth',
+  'ms.first_frame',
+  'ms.total',
+  'path',
+  'result',
+  'delay_ms.min',
+  'delay_ms.median',
+  'delay_ms.max',
+  'fps.min',
+  'fps.median',
+  'fps.max',
+  'reconnects',
+  'duration_s',
+  'end',
+];
+final _uuid = RegExp(
+    r'^[\da-f]{8}-[\da-f]{4}-[\da-f]{4}-[\da-f]{4}-[\da-f]{12}$',
+    caseSensitive: false);
+
+/// Serialize a scalar as an Excel-safe, RFC 4180 CSV field.
+String metricsCsvCell(Object? value) {
+  var text = value?.toString() ?? '';
+  if (value is String && RegExp(r'^\s*[=+@-]|^[\t\r\n]').hasMatch(text)) {
+    text = "'$text";
+  }
+  if (text.contains(RegExp('[,"\r\n]'))) {
+    return '"${text.replaceAll('"', '""')}"';
+  }
+  return text;
+}
+
+Map<String, dynamic> _approved(Map<String, dynamic> row) {
+  final session = row['session'];
+  final at = row['started_at'];
+  if (row['v'] != 1 ||
+      session is! String ||
+      !_uuid.hasMatch(session) ||
+      at is! String ||
+      DateTime.tryParse(at)?.isUtc != true) {
+    throw const FormatException('Invalid metrics session');
+  }
+  num? number(dynamic n) => n is num && n.isFinite && n >= 0 ? n : null;
+  Map<String, dynamic>? group(String key, List<String> fields) {
+    final values = row[key];
+    if (values is! Map) return null;
+    return {for (final field in fields) field: number(values[field])};
+  }
+
+  dynamic member(String key, List<String> allowed) =>
+      allowed.contains(row[key]) ? row[key] : null;
+  final id = row['device_id'];
+  return {
+    'v': 1,
+    'session': session.toLowerCase(),
+    'device_id': id is String && metricDeviceId(id) == id ? id : null,
+    'started_at': at,
+    'ms': {
+      // No Flutter event exposes an isolated lookup or route duration.
+      'lookup': null,
+      'route': null,
+      for (final stage in ['auth', 'first_frame', 'total'])
+        stage: row['ms'] is Map ? number(row['ms'][stage]) : null,
+    },
+    'path': member('path', ['direct', 'relay']),
+    'result': member(
+        'result', ['ok', 'auth_failed', 'offline', 'timeout', 'cancelled']),
+    'delay_ms': group('delay_ms', _stats),
+    'fps': group('fps', _stats),
+    'reconnects': number(row['reconnects']),
+    'duration_s': number(row['duration_s']),
+    'end': member('end', [
+      'closed_by_agent',
+      'app_exit',
+      'disconnected',
+      'closed_by_peer',
+      'connection_failed'
+    ]),
+  };
+}
+
+// Dart's POSIX File.lock is per process, so two Flutter engines can acquire it.
+// flock on independently opened handles also excludes other isolates in the
+// same process. This blocking section runs only on a disposable worker isolate.
+T _posixLocked<T>(String path, T Function() work) {
+  final libc = DynamicLibrary.process();
+  final open = libc.lookupFunction<
+      Pointer<Void> Function(Pointer<Utf8>, Pointer<Utf8>),
+      Pointer<Void> Function(Pointer<Utf8>, Pointer<Utf8>)>('fopen');
+  final fd = libc.lookupFunction<Int32 Function(Pointer<Void>),
+      int Function(Pointer<Void>)>('fileno');
+  final lock =
+      libc.lookupFunction<Int32 Function(Int32, Int32), int Function(int, int)>(
+          'flock');
+  final close = libc.lookupFunction<Int32 Function(Pointer<Void>),
+      int Function(Pointer<Void>)>('fclose');
+  return using((arena) {
+    final handle = open(path.toNativeUtf8(allocator: arena),
+        'ab'.toNativeUtf8(allocator: arena));
+    if (handle == nullptr) throw FileSystemException('Open metrics lock', path);
+    try {
+      if (lock(fd(handle), 2 /* LOCK_EX */) != 0) {
+        throw FileSystemException('Acquire metrics lock', path);
+      }
+      return work();
+    } finally {
+      close(handle);
+    }
+  });
+}
+
+class MetricsStore {
+  final Directory applicationSupport;
+  MetricsStore(this.applicationSupport);
+
+  Directory get _accounts =>
+      Directory(p.join(applicationSupport.path, 'support-metrics'));
+
+  File _file(String account) {
+    // Feed UUIDv5 ASCII bytes to preserve Unicode account names. The resulting
+    // path component is bounded and case-stable on Windows.
+    final folder = account.isEmpty
+        ? 'anonymous'
+        : const Uuid().v5('ec419373-5282-4528-9127-2f225e94d2e2',
+            base64Url.encode(utf8.encode(account)));
+    return File(p.join(_accounts.path, folder, _name));
+  }
+
+  T _locked<T>(String account, T Function(File) action) {
+    final target = _file(account);
+    target.parent.createSync(recursive: true);
+    final lockPath = '${target.path}.lock';
+    if (!Platform.isWindows) {
+      return _posixLocked(lockPath, () => action(target));
+    }
+    final lock = File(lockPath).openSync(mode: FileMode.append);
+    try {
+      lock.lockSync(FileLock.blockingExclusive);
+      return action(target);
+    } finally {
+      lock.closeSync();
+    }
+  }
+
+  static List<String> _lines(File file) {
+    // The live file is authoritative. A process killed while rotating may
+    // leave its uncommitted sibling behind. Rename is the sole commit point.
+    final staging = File('${file.path}.tmp');
+    if (staging.existsSync()) staging.deleteSync();
+    if (!file.existsSync()) return [];
+    final data = file.readAsBytesSync();
+    final end = data.lastIndexOf(10) + 1;
+    if (end != data.length) {
+      // An append interrupted mid-write can end inside a UTF-8 scalar.
+      final handle = file.openSync(mode: FileMode.append);
+      try {
+        handle.truncateSync(end);
+        handle.flushSync();
+      } finally {
+        handle.closeSync();
+      }
+    }
+    return LineSplitter.split(utf8.decode(data.sublist(0, end))).toList();
+  }
+
+  Future<void> append(String account, Map<String, dynamic> row) {
+    final clean = _approved(row);
+    return Isolate.run(() => _locked(account, (file) {
+          final lines = _lines(file);
+          for (final line in lines) {
+            if (jsonDecode(line)['session'] == clean['session']) return;
+          }
+          final encoded = jsonEncode(clean);
+          if (lines.length < _limit) {
+            file.writeAsStringSync('$encoded\n',
+                mode: FileMode.append, flush: true);
+          } else {
+            final retained = lines.skip(lines.length - _limit + 1);
+            final staging = File('${file.path}.tmp');
+            staging.writeAsStringSync('${retained.join('\n')}\n$encoded\n',
+                flush: true);
+            // Same-directory rename, including MoveFileEx(REPLACE_EXISTING) on Windows.
+            // A failed replacement leaves the old log intact and retries are safe.
+            staging.renameSync(file.path);
+          }
+        }));
+  }
+
+  Future<String> csv(String account) =>
+      Isolate.run(() => _locked(account, (file) {
+            final output = StringBuffer('${_columns.join(',')}\r\n');
+            for (final line in _lines(file)) {
+              final row = _approved(jsonDecode(line) as Map<String, dynamic>);
+              final values = _columns.map((column) {
+                final parts = column.split('.');
+                final value = row[parts.first];
+                return metricsCsvCell(
+                    parts.length == 1 ? value : value?[parts.last]);
+              });
+              output.write('${values.join(',')}\r\n');
+            }
+            return output.toString();
+          }));
+
+  Future<void> exportCsv(String account, File destination) async {
+    final output = await csv(account);
+    final accounts = (await _accounts.resolveSymbolicLinks()).toLowerCase();
+    final parent = await destination.parent.resolveSymbolicLinks();
+    final location = p.normalize(parent).toLowerCase();
+    if (p.equals(accounts, location) || p.isWithin(accounts, location)) {
+      throw const FormatException('Choose a file outside metrics storage');
+    }
+    // Replace the destination entry; never truncate in place through a link.
+    final temp = await Directory(parent).createTemp('.support-export-');
+    try {
+      final file = File(p.join(temp.path, 'export.csv'));
+      await file.writeAsString(output, flush: true);
+      await file.rename(destination.path);
+    } finally {
+      await temp.delete(recursive: true);
+    }
+  }
+}
