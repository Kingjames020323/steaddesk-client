+++ b/flutter/test/steaddesk/metrics_journey_test.dart
@@ -0,0 +1,72 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_hbb/steaddesk/metrics/metric_session.dart';
+import 'package:flutter_hbb/steaddesk/metrics/metrics_store.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('one account receives four session rows and can export its own history',
+      () async {
+    final directory = await Directory.systemTemp.createTemp('metrics-journey');
+    addTearDown(() => directory.delete(recursive: true));
+    final store = MetricsStore(directory);
+    final start = DateTime.utc(2026, 1, 1);
+    var now = start;
+    MetricSession begin(int n) => MetricSession({
+          'session': '00000000-0000-4000-8000-${n.toString().padLeft(12, '0')}',
+          'device_id': '123456789',
+          'account': 'test-operator',
+          'started_at': start.toIso8601String(),
+          'clicked': true,
+        }, (row) => store.append('test-operator', row), clock: () => now);
+
+    final ok = begin(1);
+    now = start.add(const Duration(milliseconds: 100));
+    ok.ready('true');
+    now = start.add(const Duration(milliseconds: 400));
+    ok.authenticated();
+    now = start.add(const Duration(milliseconds: 900));
+    ok.firstFrame();
+    await ok.finish();
+    await ok.finish();
+
+    final denied = begin(2);
+    denied.message('re-input-password', 'Password Error', 'Wrong Password');
+    await denied.finish();
+    final offline = begin(3);
+    offline.message('error', 'Connection Error', 'Remote desktop is offline');
+    await offline.finish();
+    final dropped = begin(4);
+    dropped.ready('false');
+    dropped.authenticated();
+    dropped.firstFrame();
+    dropped.message('error', 'Connection Error', 'Reset by the peer');
+    await dropped.finish();
+
+    final file = directory
+        .listSync(recursive: true)
+        .whereType<File>()
+        .singleWhere((f) => f.path.endsWith('support-metrics-v1.jsonl'));
+    final rows =
+        (await file.readAsLines()).map((s) => jsonDecode(s) as Map).toList();
+    expect(
+        rows.map((r) => r['result']), ['ok', 'auth_failed', 'offline', 'ok']);
+    expect(rows.map((r) => r['session']).toSet(), hasLength(4));
+    expect(rows[0]['ms'], {
+      'lookup': null,
+      'route': null,
+      'auth': 300,
+      'first_frame': 500,
+      'total': 900
+    });
+    expect(rows[0]['path'], 'direct');
+    expect(rows[3]['path'], 'relay');
+    expect(rows[3]['end'], 'disconnected');
+    final export = File('${directory.path}/selected.csv');
+    await store.exportCsv('test-operator', export);
+    expect(await export.readAsLines(), hasLength(5));
+    expect(const LineSplitter().convert(await store.csv('different-operator')),
+        hasLength(1));
+  });
+}
