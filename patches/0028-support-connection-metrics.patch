+
+export 'metric_session.dart';
+
+class SupportMetrics {
+  static const enabled = true;
+
+  static Map<String, dynamic>? begin(String id, {bool clicked = true}) {
+    if (!isDesktop) return null;
+    return {
+      'session': const Uuid().v4(),
+      'started_at': DateTime.now().toUtc().toIso8601String(),
+      'clicked': clicked,
+      'device_id': metricDeviceId(id),
+      // Child engines do not own login. The main window fills this at dispatch.
+      'account': desktopType == DesktopType.main
+          ? gFFI.userModel.userName.value
+          : null,
+    };
+  }
+
+  static Map<String, dynamic>? fromChild(dynamic value) {
+    if (value is! Map) return null;
+    return {
+      ...Map<String, dynamic>.from(value),
+      'account': gFFI.userModel.userName.value
+    };
+  }
+
+  static Future<MetricsStore> _store() async =>
+      MetricsStore(await getApplicationSupportDirectory());
+
+  static Future<void> Function(Map<String, dynamic>) _writer(String account) =>
+      (row) async => (await _store()).append(account, row);
+
+  static Future<void> shutdown() => MetricSession.shutdown();
+
+  static MetricSession? attach(Map<String, dynamic>? seed) {
+    if (seed == null || seed['account'] is! String) return null;
+    return MetricSession(seed, _writer(seed['account'] as String));
+  }
+
+  static MetricSession? resume(Map<String, dynamic> snapshot) {
+    final account = snapshot['seed']?['account'];
+    if (account is! String) return null;
+    return MetricSession.restore(snapshot, _writer(account));
+  }
+
+  static Future<void> exportCsv(String account, String path) async =>
+      (await _store()).exportCsv(account, File(path));
+}
