diff --git a/flutter/test/steaddesk/metric_session_test.dart b/flutter/test/steaddesk/metric_session_test.dart
new file mode 100644
index 0000000..3aa2e0e
--- /dev/null
+++ b/flutter/test/steaddesk/metric_session_test.dart
@@ -0,0 +1,220 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/metrics/metric_session.dart';
+
+void main() {
+  final start = DateTime.utc(2026, 11, 13);
+  late DateTime now;
+  late List<Map<String, dynamic>> rows;
+  late Map<String, dynamic> seed;
+  setUp(() {
+    now = start;
+    rows = [];
+    seed = {
+      'session': '0ec3b445-302e-4d79-a4ab-7e9e769fd441',
+      'device_id': '100200300',
+      'account': 'sample-agent',
+      'started_at': start.toIso8601String(),
+      'clicked': true,
+    };
+  });
+  Future<void> write(Map<String, dynamic> row) async => rows.add(row);
+  MetricSession begin() => MetricSession(seed, write, clock: () => now);
+  void after(int ms) => now = start.add(Duration(milliseconds: ms));
+  tearDown(() => MetricSession.shutdown());
+
+  test('success measures only observed phases of the first displayed round',
+      () async {
+    final s = begin();
+    after(500);
+    s.ready('true');
+    after(550);
+    s.ready('false'); // same round's duplicate callback
+    after(750);
+    s.authenticated();
+    after(800);
+    s.authenticated();
+    after(950);
+    s.firstFrame();
+    after(1000);
+    s.firstFrame();
+    after(18650);
+    await Future.wait([s.finish(), s.finish()]);
+    expect(rows.single, {
+      'v': 1,
+      'session': seed['session'],
+      'device_id': seed['device_id'],
+      'started_at': seed['started_at'],
+      'ms': {
+        'lookup': null,
+        'route': null,
+        'auth': 250,
+        'first_frame': 200,
+        'total': 950
+      },
+      'path': 'direct',
+      'result': 'ok',
+      'delay_ms': null,
+      'fps': null,
+      'reconnects': 0,
+      'duration_s': 18,
+      'end': 'closed_by_agent',
+    });
+  });
+
+  test('wrong password alone is auth_failed, corrected password can succeed',
+      () async {
+    final s = begin()
+      ..ready('false')
+      ..message('re-input-password', 'Wrong Password', '');
+    await s.finish();
+    expect(rows.single['result'], 'auth_failed');
+    expect(rows.single['ms']['auth'], isNull);
+    rows.clear();
+    final corrected = begin()
+      ..ready('false')
+      ..message('re-input-password', 'Wrong Password', '');
+    after(400);
+    corrected.authenticated();
+    after(500);
+    corrected.firstFrame();
+    await corrected.finish();
+    expect(rows.single['result'], 'ok');
+    expect(rows.single['path'], 'relay');
+    expect(rows.single['end'], 'closed_by_agent');
+  });
+
+  test('offline, timeout, unknown failures, and local cancellation', () async {
+    for (final cause in {
+      'Remote desktop is offline': 'offline',
+      'Timeout': 'timeout',
+      'ID does not exist': null
+    }.entries) {
+      rows.clear();
+      final s = begin();
+      s.message('error', 'Connection Error', cause.key);
+      await s.finish();
+      expect(rows.single['result'], cause.value);
+      expect(rows.single['end'], 'connection_failed');
+      expect(rows.single['path'], isNull);
+      expect(rows.single['ms'].values.every((dynamic v) => v == null), isTrue);
+    }
+    rows.clear();
+    final s = begin()..message('input-password', 'Password Required', '');
+    await s.finish();
+    expect(rows.single['result'], 'cancelled');
+  });
+
+  test(
+      'loss after display retains success and records disconnect until recovery',
+      () async {
+    final s = begin()
+      ..ready('false')
+      ..authenticated()
+      ..firstFrame();
+    after(2100);
+    s.message('error', 'Connection Error', 'Reset by the peer');
+    s.firstFrame(); // delayed frame while disconnected
+    after(9000);
+    await s.finish();
+    expect(rows.single['end'], 'disconnected');
+    expect(rows.single['result'], 'ok');
+    expect(rows.single['duration_s'], 2);
+
+    rows.clear();
+    after(0);
+    final r = begin()
+      ..ready('true')
+      ..authenticated()
+      ..firstFrame();
+    r.message('restarting-show', 'Connecting...', '');
+    r.reconnect();
+    after(2000);
+    r.ready('false');
+    r.authenticated();
+    r.firstFrame();
+    await r.finish();
+    expect(rows.single['end'], 'closed_by_agent');
+    expect(rows.single['reconnects'], 1);
+    expect(rows.single['ms']['total'], 0);
+    expect(rows.single['path'], 'direct');
+  });
+
+  test(
+      'later transport errors supersede a wrong password; only the recovered round supplies phases',
+      () async {
+    final s = begin()
+      ..ready('true')
+      ..message('re-input-password', 'Wrong Password', '');
+    s.message('error', 'Connection Error', 'Key mismatch');
+    await s.finish();
+    expect(rows.single['result'], isNull);
+    rows.clear();
+    final r = begin()
+      ..ready('true')
+      ..message('error', 'Connection Error', 'Timeout');
+    r.reconnect();
+    after(500);
+    r.firstFrame();
+    after(800);
+    r.ready('false');
+    after(900);
+    r.authenticated();
+    after(1200);
+    r.firstFrame();
+    await r.finish();
+    expect(rows.single['path'], 'relay');
+    expect(rows.single['ms'], {
+      'lookup': null,
+      'route': null,
+      'auth': 100,
+      'first_frame': 300,
+      'total': 1200
+    });
+  });
+
+  testWidgets(
+      'sampling consumes only fresh per-field observations every ten seconds',
+      (tester) async {
+    final s = MetricSession(seed, write, clock: tester.binding.clock.now)
+      ..ready('true')
+      ..authenticated()
+      ..firstFrame();
+    s.quality({'fps': '{"0":99}'}, 0);
+    s.quality({'fps': '{"0":4}', 'delay': '20'}, 0);
+    await tester.pump(const Duration(seconds: 10));
+    s.quality({'delay': '10', 'fps': '{}'}, 0);
+    await tester.pump(const Duration(seconds: 10));
+    await tester.pump(const Duration(seconds: 10));
+    s.quality({'fps': '{"1":0}'}, 1);
+    await tester.pump(const Duration(seconds: 10));
+    s.quality({'fps': '{"0":99,"1":1}'}, -1);
+    s.quality({'delay': '999'}, -1);
+    await tester.pump(const Duration(seconds: 2));
+    await s.finish();
+    expect(rows.single['delay_ms'], {'min': 10, 'median': 15, 'max': 20});
+    expect(rows.single['fps'], {'min': 0, 'median': 2, 'max': 4});
+  });
+
+  test(
+      'tab move transfers UUID, age and first round; shutdown flushes only owner',
+      () async {
+    seed['clicked'] = false;
+    final s = begin()
+      ..ready('false')
+      ..authenticated();
+    final data = s.detachForTransfer();
+    final observedFrame = start.add(const Duration(milliseconds: 75));
+    final next = MetricSession.restore(data, write, clock: () => now);
+    after(160); // ownership reply arrives after live image in the new window
+    next.firstFrame(observedFrame);
+    await s.finish();
+    expect(rows, isEmpty);
+    await MetricSession.shutdown();
+    expect(rows.single['session'], seed['session']);
+    expect(rows.single['ms']['total'], isNull);
+    expect(rows.single['ms']['first_frame'], 75);
+    expect(rows.single['end'], 'app_exit');
+    await next.finish();
+    expect(rows, hasLength(1));
+  });
+}
