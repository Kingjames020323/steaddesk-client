+import 'dart:convert';
+import 'dart:io';
+import 'dart:isolate';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/metrics/metrics_store.dart';
+
+String _id(int i) => '00000000-0000-4000-8000-${i.toString().padLeft(12, '0')}';
+
+Map<String, dynamic> _row(int i) => {
+      'v': 1,
+      'session': _id(i),
+      'device_id': '10203040',
+      'started_at': '2026-11-13T19:00:00Z',
+      'ms': <String, dynamic>{
+        'lookup': null,
+        'route': null,
+        'auth': null,
+        'first_frame': 50,
+        'total': 220
+      },
+      'path': 'direct',
+      'result': 'ok',
+      'delay_ms': {'min': 3, 'median': 5.5, 'max': 8},
+      'fps': null,
+      'reconnects': 0,
+      'duration_s': 12,
+      'end': 'closed_by_agent',
+    };
+
+void main() {
+  late Directory root;
+  late MetricsStore store;
+  setUp(() async {
+    root = await Directory.systemTemp.createTemp('sd-metrics-');
+    store = MetricsStore(root);
+  });
+  tearDown(() => root.delete(recursive: true));
+  Future<File> log() async => (await root
+          .list(recursive: true)
+          .where(
+              (f) => f is File && f.path.endsWith('support-metrics-v1.jsonl'))
+          .toList())
+      .single as File;
+
+  test('CSV quotes embedded separators and prevents spreadsheet expressions',
+      () {
+    expect(metricsCsvCell('a,"b"'), '"a,""b"""');
+    expect(metricsCsvCell('a\nb'), '"a\nb"');
+    expect(metricsCsvCell(' =1'), "' =1");
+    expect(metricsCsvCell('\t+1'), "'\t+1");
+    expect(metricsCsvCell(1.5), '1.5');
+    expect(metricsCsvCell(null), '');
+  });
+
+  test('stable account identity, isolated signed-out rows and idempotent retry',
+      () async {
+    await store.append('../A/示例', _row(1));
+    await store.append('../A/示例', _row(1)..['result'] = 'timeout');
+    await store.append('../a/示例', _row(2));
+    await store.append('', _row(3));
+    await store.append('anonymous', _row(4));
+    for (final item
+        in {'../A/示例': 1, '../a/示例': 2, '': 3, 'anonymous': 4}.entries) {
+      final export = await MetricsStore(root).csv(item.key);
+      expect(LineSplitter.split(export), hasLength(2));
+      expect(export, contains(_id(item.value)));
+      expect(export, isNot(contains('timeout')));
+    }
+  });
+
+  test('only schema fields and sanitized device IDs reach disk', () async {
+    final input = _row(1)
+      ..['password'] = 'top-secret'
+      ..['device_id'] = '=bad/path,foo'
+      ..['ms']['lookup'] = 99
+      ..['ms']['route'] = 123
+      ..['ms']['filename'] = 'top-secret';
+    await store.append('demo', input);
+    final text = await (await log()).readAsString();
+    expect(text, isNot(contains('top-secret')));
+    expect(text, isNot(contains('bad/path')));
+    final saved = jsonDecode(text) as Map;
+    expect(saved.keys, unorderedEquals(_row(1).keys));
+    expect(saved['device_id'], isNull);
+    expect(saved['ms']['lookup'], isNull);
+    expect(saved['ms']['route'], isNull);
+    expect(saved['ms'], isNot(contains('filename')));
+    expect(saved['fps'], isNull);
+  });
+
+  test('isolates concurrently append once, including concurrent retries',
+      () async {
+    final path = root.path;
+    await Future.wait([
+      for (var n = 0; n < 12; n++)
+        Isolate.run(
+            () => MetricsStore(Directory(path)).append('demo', _row(n % 8)))
+    ]);
+    final rows = (await (await log()).readAsLines())
+        .map((line) => jsonDecode(line)['session']);
+    expect(rows, unorderedEquals([for (var i = 0; i < 8; i++) _id(i)]));
+  });
+
+  test(
+      'recover interrupted UTF-8 tail and retain committed prefix byte for byte',
+      () async {
+    await store.append('demo', _row(1));
+    final file = await log();
+    final before = await file.readAsBytes();
+    final stale = File('${file.path}.tmp');
+    await stale.writeAsString('interrupted rotation');
+    await file.writeAsBytes([123, 34, 0xe4], mode: FileMode.append);
+    expect(LineSplitter.split(await store.csv('demo')), hasLength(2));
+    await store.append('demo', _row(2));
+    final after = await file.readAsBytes();
+    expect(await stale.exists(), isFalse);
+    expect(after.take(before.length), orderedEquals(before));
+    expect((await file.readAsLines()).map((l) => jsonDecode(l)['session']),
+        [_id(1), _id(2)]);
+  });
+
+  test('5001st session rotates the oldest only and leaves no staging copy',
+      () async {
+    await store.append('demo', _row(0));
+    final file = await log();
+    final seeded = [for (var i = 1; i < 5000; i++) jsonEncode(_row(i))];
+    await file.writeAsString('${seeded.join('\n')}\n', mode: FileMode.append);
+    await store.append('demo', _row(5000));
+    await store.append('demo', _row(5000));
+    final ids = (await file.readAsLines()).map((l) => jsonDecode(l)['session']);
+    expect(ids, orderedEquals([for (var i = 1; i <= 5000; i++) _id(i)]));
+    expect(await file.parent.list().length, 2); // active log and stable lock
+  });
+
+  test(
+      'CSV exported to selected file includes header even for an empty account',
+      () async {
+    const header =
+        'v,session,device_id,started_at,ms.lookup,ms.route,ms.auth,ms.first_frame,ms.total,path,result,delay_ms.min,delay_ms.median,delay_ms.max,fps.min,fps.median,fps.max,reconnects,duration_s,end\r\n';
+    expect(await store.csv('no rows'), header);
+    await store.append('demo', _row(8));
+    final dest = File('${root.path}/chosen.csv');
+    await store.exportCsv('demo', dest);
+    expect(await dest.readAsString(),
+        '${header}1,${_id(8)},10203040,2026-11-13T19:00:00Z,,,,50,220,direct,ok,3,5.5,8,,,,0,12,closed_by_agent\r\n');
+    final file = await log();
+    await expectLater(store.exportCsv('demo', file), throwsFormatException);
+    expect(jsonDecode(await file.readAsString())['session'], _id(8));
+  });
+}
