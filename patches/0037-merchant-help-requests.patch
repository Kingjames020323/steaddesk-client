+++ b/flutter/lib/steaddesk/help/merchant_help_image.dart
@@ -0,0 +1,74 @@
+import 'dart:io';
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:file_picker/file_picker.dart';
+
+Future<Uint8List?> pickHelpScreenshot() async {
+  final pick = await FilePicker.platform.pickFiles(
+      type: FileType.custom,
+      allowedExtensions: ['png'],
+      allowMultiple: false,
+      withData: false);
+  if (pick == null) return null;
+  final path = pick.files.single.path;
+  if (path == null) throw const FormatException();
+  final file = File(path);
+  if (await file.length() > 524288) throw const FormatException();
+  final bytes = BytesBuilder();
+  await for (final block in file.openRead()) {
+    if (bytes.length + block.length > 524288) throw const FormatException();
+    bytes.add(block);
+  }
+  return cleanHelpScreenshot(bytes.takeBytes());
+}
+
+Future<Uint8List> cleanHelpScreenshot(Uint8List bytes) async {
+  if (bytes.length < 45 || bytes.length > 524288) throw const FormatException();
+  final data = ByteData.sublistView(bytes);
+  if (data.getUint32(0) != 0x89504e47 ||
+      data.getUint32(4) != 0x0d0a1a0a ||
+      data.getUint32(8) != 13 ||
+      data.getUint32(12) != 0x49484452) throw const FormatException();
+  final w = data.getUint32(16), h = data.getUint32(20);
+  if (w == 0 || h == 0 || w > 1600 || h > 1600 || w * h > 1600000) {
+    throw const FormatException();
+  }
+  // Drop auxiliary chunks before decoding, including metadata and profiles.
+  // Only static PNG image data, palette and transparency are needed.
+  final clean = BytesBuilder()..add(bytes.sublist(0, 8));
+  var ended = false;
+  for (var i = 8; i < bytes.length;) {
+    if (i + 12 > bytes.length) throw const FormatException();
+    final size = data.getUint32(i);
+    final tag = String.fromCharCodes(bytes.sublist(i + 4, i + 8));
+    final end = i + 12 + size;
+    if (end > bytes.length || ended || ['acTL', 'fcTL', 'fdAT'].contains(tag)) {
+      throw const FormatException();
+    }
+    if (['IHDR', 'PLTE', 'tRNS', 'IDAT', 'IEND'].contains(tag)) {
+      clean.add(Uint8List.sublistView(bytes, i, end));
+    }
+    ended = tag == 'IEND';
+    i = end;
+  }
+  if (!ended) throw const FormatException();
+  final codec = await ui.instantiateImageCodec(clean.takeBytes());
+  try {
+    if (codec.frameCount != 1) throw const FormatException();
+    final image = (await codec.getNextFrame()).image;
+    try {
+      if (image.width != w || image.height != h) throw const FormatException();
+      final encoded = await image.toByteData(format: ui.ImageByteFormat.png);
+      if (encoded == null || encoded.lengthInBytes > 524288) {
+        throw const FormatException();
+      }
+      return encoded.buffer
+          .asUint8List(encoded.offsetInBytes, encoded.lengthInBytes);
+    } finally {
+      image.dispose();
+    }
+  } finally {
+    codec.dispose();
+  }
+}
