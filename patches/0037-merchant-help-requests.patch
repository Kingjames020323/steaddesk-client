+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/widgets.dart';
+import 'package:path_provider/path_provider.dart';
+
+import '../../common.dart' show translate;
+import '../../models/native_model.dart' show PlatformFFI;
+import '../../models/platform_model.dart' show bind;
+import '../merchant_build.dart' show merchantVersion;
+import 'merchant_help_client.dart';
+import 'merchant_help_image.dart';
+import 'merchant_help_widget.dart';
+
+Widget merchantHelpEntry() => MerchantHelpEntry(
+    label: translate,
+    pick: pickHelpScreenshot,
+    open: () async {
+      final directory = await getApplicationSupportDirectory();
+      return MerchantHelpClient(
+          File('${directory.path}/merchant-help-receipt.json'), () async {
+        final configured = await bind.mainGetOption(key: 'api-server');
+        final device = await bind.mainGetMyId();
+        if (device.isEmpty) throw HelpFailure(0, 'configuration');
+        final profile = bind.mainGetLocalOption(key: 'user_info');
+        final account = profile.isEmpty
+            ? ''
+            : (jsonDecode(profile)['name'] as String? ?? '');
+        return (
+          origin: configuredHelpOrigin(configured),
+          device: device,
+          account: account
+        );
+      }, (category, message, digest, secret) {
+        final signed = PlatformFFI.instance.helpSigner!.sign(
+            category: category,
+            message: message,
+            screenshotSha256: digest,
+            receiptSecret: secret);
+        return (secret: signed.receiptSecret, request: signed.request);
+      }, merchantVersion);
+    });
