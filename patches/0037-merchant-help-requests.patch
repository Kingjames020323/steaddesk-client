+import 'dart:async';
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:flutter/material.dart';
+import 'merchant_help_client.dart';
+
+const helpCategories = {
+  'printer': 'Printer',
+  'menu': 'Menu',
+  'checkout': 'Checkout operation',
+  'network': 'Network',
+  'frozen': 'Device frozen',
+  'other': 'Other',
+};
+
+class MerchantHelpEntry extends StatefulWidget {
+  final Future<MerchantHelpClient> Function() open;
+  final String Function(String) label;
+  final Future<Uint8List?> Function() pick;
+  const MerchantHelpEntry(
+      {super.key, required this.open, required this.label, required this.pick});
+  @override
+  State<MerchantHelpEntry> createState() => _MerchantHelpEntryState();
+}
+
+class _MerchantHelpEntryState extends State<MerchantHelpEntry> {
+  MerchantHelpClient? client;
+  bool busy = false, online = true, expanded = false;
+  String? error;
+  Timer? timer;
+  @override
+  void initState() {
+    super.initState();
+    unawaited(run(() async {
+      client = await widget.open();
+      await client!.initialize();
+      if (client!.record != null) await client!.refresh();
+    }));
+    timer = Timer.periodic(const Duration(seconds: 8), (_) {
+      if (client?.record != null) {
+        unawaited(run(() => client!.refresh(), polling: true));
+      }
+    });
+  }
+
+  @override
+  void dispose() {
+    timer?.cancel();
+    super.dispose();
+  }
+
+  Future<void> run(Future<void> Function() work, {bool polling = false}) async {
+    if (busy || !mounted) return;
+    setState(() {
+      busy = true;
+      if (!polling) error = null;
+    });
+    try {
+      await work();
+      online = true;
+      if (polling && error == 'Connection interrupted. Retrying.') error = null;
+    } catch (e) {
+      online = false;
+      error = e is HelpFailure
+          ? switch (e.status) {
+              403 => 'Contact support to register this device again.',
+              429 => 'Too many requests. Try again later.',
+              409 => 'An active request already exists.',
+              400 => 'Check the message and the device clock.',
+              _ => e.code == 'configuration'
+                  ? 'Configure the support server to request help.'
+                  : 'Connection interrupted. Retrying.',
+            }
+          : 'Connection interrupted. Retrying.';
+    } finally {
+      if (mounted) setState(() => busy = false);
+    }
+  }
+
+  Future<void> open() async {
+    await run(() async {
+      if (client == null) {
+        client = await widget.open();
+        await client!.initialize();
+      }
+      await client!.capabilities();
+      expanded = true;
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final c = client;
+    final t = widget.label;
+    final hasTicket = c?.record != null;
+    final v = c?.view;
+    final closed = v?['state'] == 'closed';
+    final end = v?['ended_at'];
+    if (expanded && closed && end is int && c!.now() - end >= 60) {
+      // Only collapse once per ticket; the merchant can still reopen the bar.
+      if (lastCollapsed != v!['id']) {
+        expanded = false;
+        lastCollapsed = v['id'] as String;
+      }
+    }
+    return Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      if (!expanded || c == null)
+        OutlinedButton.icon(
+          onPressed: busy ? null : open,
+          icon: Icon(hasTicket ? Icons.headset_mic : Icons.support_agent),
+          label: Text(t(hasTicket ? 'View help request' : 'Contact support')),
+        )
+      else ...[
+        Row(children: [
+          Expanded(
+              child: Text(t('Contact support'),
+                  style: Theme.of(context).textTheme.titleMedium)),
+          IconButton(
+              tooltip: t('Collapse help'),
+              icon: const Icon(Icons.expand_less),
+              onPressed: () => setState(() => expanded = false)),
+        ]),
+        if (!hasTicket)
+          HelpComposer(
+              label: t,
+              enabled: !busy,
+              screenshots: c.screenshots,
+              pick: widget.pick,
+              create: (category, message, image) => run(() async {
+                    await c.create(category, message, image);
+                    await c.refresh();
+                  }))
+        else if (v == null)
+          Text(t('Restoring your request…'))
+        else
+          HelpWaiting(
+              view: v,
+              cards: c.cards,
+              label: t,
+              now: c.now(),
+              online: online,
+              busy: busy,
+              act: (name, body) => run(() => c.act(name, body)),
+              again: closed
+                  ? () => run(() async {
+                        await c.forget();
+                        await c.capabilities();
+                      })
+                  : null),
+        if (c.attachmentPending) Text(t('Screenshot upload pending')),
+        if (hasTicket && !online)
+          TextButton(
+              onPressed: busy ? null : () => run(c.refresh),
+              child: Text(t('Retry'))),
+      ],
+      if (error != null)
+        Text(t(error!),
+            style: TextStyle(color: Theme.of(context).colorScheme.error)),
+      if (c?.notice != null) Text(t(c!.notice!)),
+    ]);
+  }
+
+  String? lastCollapsed;
+}
+
+class HelpComposer extends StatefulWidget {
+  final String Function(String) label;
+  final bool enabled, screenshots;
+  final Future<Uint8List?> Function() pick;
+  final Future<void> Function(String, String, Uint8List?) create;
+  const HelpComposer(
+      {super.key,
+      required this.label,
+      required this.enabled,
+      required this.screenshots,
+      required this.pick,
+      required this.create});
+  @override
+  State<HelpComposer> createState() => _HelpComposerState();
+}
+
+class _HelpComposerState extends State<HelpComposer> {
+  final text = TextEditingController();
+  Uint8List? png;
+  String? imageError;
+  bool selecting = false;
+  @override
+  void dispose() {
+    text.dispose();
+    super.dispose();
+  }
+
+  Future<void> select() async {
+    final t = widget.label;
+    setState(() {
+      selecting = true;
+      imageError = null;
+    });
+    try {
+      final next = await widget.pick();
+      if (next == null || !mounted) return;
+      final yes = await showDialog<bool>(
+          context: context,
+          builder: (ctx) => AlertDialog(
+                  title: Text(t('Preview screenshot')),
+                  content: Image.memory(next, fit: BoxFit.contain),
+                  actions: [
+                    TextButton(
+                        onPressed: () => Navigator.pop(ctx, false),
+                        child: Text(t('Remove'))),
+                    FilledButton(
+                        onPressed: () => Navigator.pop(ctx, true),
+                        child: Text(t('Use screenshot'))),
+                  ]));
+      if (yes == true) png = next;
+    } catch (_) {
+      imageError =
+          'Choose a static PNG up to 512 KiB and 1600 pixels per side.';
+    } finally {
+      if (mounted) setState(() => selecting = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final t = widget.label;
+    final tooLong = utf8.encode(text.text).length > 1024;
+    final ready = widget.enabled && !selecting && !tooLong;
+    return Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      Text(t('Select a reason to join the queue.')),
+      const SizedBox(height: 6),
+      Text(t('Includes device ID, app version and available health checks.')),
+      const SizedBox(height: 8),
+      TextField(
+          controller: text,
+          enabled: widget.enabled,
+          maxLines: 2,
+          onChanged: (_) => setState(() {}),
+          decoration: InputDecoration(
+              labelText: t('Message (optional)'),
+              errorText: tooLong ? t('Use at most 1024 UTF-8 bytes.') : null,
+              border: const OutlineInputBorder())),
+      if (widget.screenshots) ...[
+        if (png != null)
+          Row(children: [
+            Image.memory(png!, width: 48, height: 36),
+            TextButton(
+                onPressed: ready ? () => setState(() => png = null) : null,
+                child: Text(t('Remove')))
+          ])
+        else
+          TextButton.icon(
+              onPressed: ready ? select : null,
+              icon: const Icon(Icons.image_outlined),
+              label: Text(t('Choose screenshot'))),
+        if (imageError != null) Text(t(imageError!)),
+      ],
+      const SizedBox(height: 8),
+      Wrap(spacing: 8, runSpacing: 4, children: [
+        for (final e in helpCategories.entries)
+          OutlinedButton(
+              onPressed: ready
+                  ? () => widget.create(
+                      e.key, text.text, widget.screenshots ? png : null)
+                  : null,
+              child: Text(t(e.value))),
+      ]),
+    ]);
+  }
+}
+
+class HelpWaiting extends StatelessWidget {
+  final HelpJson view;
+  final List<HelpJson> cards;
+  final int now;
+  final bool online, busy;
+  final String Function(String) label;
+  final void Function(String, HelpJson) act;
+  final VoidCallback? again;
+  const HelpWaiting(
+      {super.key,
+      required this.view,
+      required this.cards,
+      required this.now,
+      required this.online,
+      required this.busy,
+      required this.label,
+      required this.act,
+      this.again});
+  @override
+  Widget build(BuildContext context) {
+    final t = label;
+    String format(String key, Object value) =>
+        t(key).replaceFirst('%s', value.toString());
+    final state = view['state'];
+    final queued = state == 'queued', closed = state == 'closed';
+    final wait = (now - (view['queued_at'] as int? ?? now)).clamp(0, 1 << 31);
+    final eta = view['eta_minutes'];
+    String time(int seconds) => TimeOfDay.fromDateTime(
+            DateTime.fromMillisecondsSinceEpoch(seconds * 1000))
+        .format(context);
+    Widget button(String key, String action, [HelpJson body = const {}]) =>
+        OutlinedButton(
+            onPressed: busy ? null : () => act(action, body),
+            child: Text(t(key)));
+    return Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      if (view['lane'] == 'unverified')
+        Text(t('Awaiting manual device verification')),
+      if (queued) ...[
+        if (view['ahead'] is int)
+          Text(format('%s ahead of you', view['ahead']),
+              style: Theme.of(context).textTheme.titleLarge),
+        Text(format('Waiting for %s min', wait ~/ 60),
+            style: TextStyle(
+                color: wait > 900
+                    ? Colors.red.shade800
+                    : wait > 300
+                        ? Colors.orange.shade900
+                        : null)),
+        if (online &&
+            eta is List &&
+            eta.length == 2 &&
+            eta.every((v) => v is int))
+          Text(t('Estimated wait: %s–%s min')
+              .replaceFirst('%s', '${eta[0]}')
+              .replaceFirst('%s', '${eta[1]}')),
+        if (!online && view['queue_updated_at'] is int)
+          Text(format('Last updated %s', time(view['queue_updated_at']))),
+        for (final card in cards.take(3))
+          Card(
+              child: Padding(
+                  padding: const EdgeInsets.all(8),
+                  child: Column(
+                      crossAxisAlignment: CrossAxisAlignment.stretch,
+                      children: [
+                        for (final step
+                            in (card['steps'] as List).whereType<String>())
+                          Text(step),
+                        button('This solved my problem', 'self-resolve', {
+                          'card_id': card['card_id'],
+                          'card_version': card['card_version']
+                        }),
+                      ]))),
+        button('Request a callback', 'callback'),
+      ] else if (state == 'claimed') ...[
+        Text(format('Handled by %s', view['handler'] ?? '—'),
+            style: Theme.of(context).textTheme.titleMedium),
+        if (view['claimed_at'] is int)
+          Text(format('Claimed at %s', time(view['claimed_at']))),
+      ] else if (state == 'callback_requested')
+        Text(t('Callback requested'))
+      else if (closed) ...[
+        Text(t('Request closed'),
+            style: Theme.of(context).textTheme.titleMedium),
+        if (view['close_result'] != 'self_resolved' &&
+            view['feedback'] == null &&
+            view['ended_at'] is int &&
+            now - view['ended_at'] <= 600) ...[
+          button('Resolved', 'feedback', {'feedback': 'resolved'}),
+          button('Still needs help', 'feedback', {'feedback': 'not_resolved'}),
+        ],
+        if (again != null)
+          TextButton(
+              onPressed: busy ? null : again,
+              child: Text(t('Start another request'))),
+      ],
+      if (queued || state == 'claimed' || state == 'callback_requested')
+        button('Cancel help request', 'cancel'),
+    ]);
+  }
+}
