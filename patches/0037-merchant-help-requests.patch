diff --git a/flutter/test/steaddesk/merchant_help_test.dart b/flutter/test/steaddesk/merchant_help_test.dart
new file mode 100644
index 0000000..fc645c8
--- /dev/null
+++ b/flutter/test/steaddesk/merchant_help_test.dart
@@ -0,0 +1,313 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:crypto/crypto.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/help/merchant_help_client.dart';
+import 'package:flutter_hbb/steaddesk/help/merchant_help_image.dart';
+import 'package:flutter_hbb/steaddesk/help/merchant_help_widget.dart';
+
+const request = {
+  'id': 'example-ticket',
+  'state': 'queued',
+  'version': 1,
+  'queued_at': 1200,
+  'ahead': 2
+};
+
+class _LoopbackHttp extends HttpOverrides {}
+
+void main() {
+  late Directory dir;
+  late File journal;
+  var seconds = 1200, signs = 0;
+  var account = '';
+  setUp(() {
+    dir = Directory.systemTemp.createTempSync('merchant-help-test-');
+    journal = File('${dir.path}/receipt');
+    seconds = 1200;
+    signs = 0;
+    account = '';
+  });
+  tearDown(() => dir.deleteSync(recursive: true));
+  MerchantHelpClient client(HelpSend send) => MerchantHelpClient(
+          journal,
+          () async => (
+                origin: Uri.https('example.invalid'),
+                device: '123456789',
+                account: account
+              ), (category, text, digest, secret) {
+        signs++;
+        return (
+          secret: secret ?? 'fixture-only',
+          request: <String, dynamic>{
+            'category': category,
+            'message': text,
+            'screenshot_sha256': digest,
+            'ts': seconds,
+            'device_id': '123456789'
+          }
+        );
+      }, '1.5.0-sd.1', clock: () => seconds, send: send);
+
+  test('JSON writes advertise encoded byte length to the HTTP service',
+      () async {
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    addTearDown(() => server.close(force: true));
+    final body = {'message': '测试'};
+    final bytes = utf8.encode(jsonEncode(body));
+    final check = server.first.then((req) async {
+      expect(req.contentLength, bytes.length);
+      expect(req.headers.value(HttpHeaders.transferEncodingHeader), isNull);
+      expect(await utf8.decoder.bind(req).join(), jsonEncode(body));
+      req.response.headers.contentType = ContentType.json;
+      req.response.write('{}');
+      await req.response.close();
+    });
+    await HttpOverrides.runWithHttpOverrides(
+        () => sendHelp(Uri.parse('http://127.0.0.1:${server.port}'), 'POST',
+            'requests', 'test-receipt', body, 'test-key', null),
+        _LoopbackHttp());
+    await check;
+  });
+
+  test('lost create response recovers from disk with the original receipt only',
+      () async {
+    var created = false, posts = 0;
+    Future<HelpJson> api(Uri origin, String method, String path, String? secret,
+        HelpJson? body, String? key, int? version) async {
+      expect(secret, 'fixture-only');
+      if (path == 'requests') {
+        expect(journal.existsSync(), isTrue);
+        expect(body!['message'], ' test ');
+        expect(body.containsKey('secret'), isFalse);
+        expect(key, isNotEmpty);
+        posts++;
+        created = true;
+        throw const SocketException('disconnected');
+      }
+      if (path == 'me') {
+        expect(created, isTrue);
+        return request;
+      }
+      if (path == 'me/step-cards') return {'cards': []};
+      expect(path, 'me/diagnostic');
+      return {};
+    }
+
+    await expectLater(client(api).create('printer', ' test ', null),
+        throwsA(isA<SocketException>()));
+    final restarted = client(api);
+    await restarted.initialize();
+    await restarted.refresh();
+    expect(restarted.view!['ahead'], 2);
+    expect([signs, posts], [1, 1]);
+    expect(journal.readAsStringSync(), isNot(contains(' test ')));
+    account = 'another-account';
+    await expectLater(restarted.refresh(), throwsA(isA<HelpFailure>()));
+    expect(journal.existsSync(), isFalse);
+  });
+
+  test(
+      'undelivered create repeats original key; expiry refreshes signature only',
+      () async {
+    final posts = <String?>[];
+    final timestamps = <int>[];
+    final c = client((origin, method, path, secret, body, key, version) async {
+      if (path == 'me') throw HelpFailure(404);
+      if (path == 'me/step-cards') return {'cards': []};
+      if (path == 'me/diagnostic') return {};
+      posts.add(key);
+      timestamps.add(body!['ts']);
+      expect(secret, 'fixture-only');
+      if (posts.length < 3) throw const SocketException('offline');
+      return request;
+    });
+    await expectLater(
+        c.create('menu', '', null), throwsA(isA<SocketException>()));
+    await expectLater(c.refresh(), throwsA(isA<SocketException>()));
+    seconds += 301;
+    await c.refresh();
+    expect(posts.toSet().length, 1);
+    expect(timestamps, [1200, 1200, 1501]);
+    expect(signs, 2);
+    expect(c.view!['state'], 'queued');
+  });
+
+  test(
+      'interrupted merchant action is delivered with the same key and If-Match',
+      () async {
+    final keys = <String?>[];
+    Future<HelpJson> api(Uri origin, String method, String path, String? secret,
+        HelpJson? body, String? key, int? version) async {
+      if (path == 'me/callback') {
+        keys.add(key);
+        expect(version, 1);
+        if (keys.length == 1) throw const SocketException('offline');
+        return {...request, 'state': 'callback_requested', 'version': 2};
+      }
+      if (path == 'me/diagnostic') return {};
+      return request;
+    }
+
+    final c = client(api);
+    await c.create('frozen', '', null);
+    await expectLater(c.act('callback', {}), throwsA(isA<SocketException>()));
+    final restarted = client(api);
+    await restarted.initialize();
+    await restarted.refresh();
+    expect(keys.length, 2);
+    expect(keys.first, keys.last);
+    expect(restarted.view!['state'], 'callback_requested');
+  });
+
+  test('screenshot opt-in, digest, bounded chunks and terminal cleanup',
+      () async {
+    final image = Uint8List.fromList(List.generate(32800, (i) => i % 256));
+    final chunks = <int>[];
+    final c = client((origin, method, path, secret, body, key, version) async {
+      if (path == 'capabilities') {
+        expect(secret, isNull);
+        return {'screenshots': true};
+      }
+      if (path == 'requests') {
+        expect(body!['screenshot_sha256'], sha256.convert(image).toString());
+      }
+      if (path == 'me/step-cards') return {'cards': []};
+      if (path.contains('chunks/')) {
+        final part = base64Decode(body!['data']);
+        chunks.add(part.length);
+        expect(body['chunk_sha256'], sha256.convert(part).toString());
+        expect(body['total'], 2);
+        expect(body['size'], image.length);
+      }
+      if (path == 'me/cancel') {
+        return {...request, 'state': 'cancelled', 'version': 2};
+      }
+      return request;
+    });
+    await expectLater(
+        c.create('other', '', image), throwsA(isA<HelpFailure>()));
+    await c.capabilities();
+    await c.create('other', '', image);
+    await c.refresh();
+    expect(chunks, [32768, 32]);
+    expect(c.attachmentPending, false);
+    await c.act('cancel', {});
+    expect(journal.existsSync(), false);
+    final unavailable =
+        client((a, b, c, d, e, f, g) async => {'screenshots': 'true'});
+    await unavailable.capabilities();
+    expect(unavailable.screenshots, isFalse);
+    for (final value in [
+      '',
+      'http://example.invalid',
+      'https://user@example.invalid',
+      'https://example.invalid/path'
+    ]) {
+      expect(() => configuredHelpOrigin(value), throwsA(isA<HelpFailure>()));
+    }
+  });
+
+  testWidgets(
+      'static PNG strips ancillary blocks and rejects animations and size excess',
+      (tester) async {
+    final raw = base64Decode(
+        'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVR4nGNgAAIAAAUAAXpeqz8AAAAASUVORK5CYII=');
+    Uint8List inserted(String type) => Uint8List.fromList([
+          ...raw.take(33),
+          0,
+          0,
+          0,
+          0,
+          ...ascii.encode(type),
+          0,
+          0,
+          0,
+          0,
+          ...raw.skip(33)
+        ]);
+    final clean =
+        await tester.runAsync(() => cleanHelpScreenshot(inserted('tEXt')));
+    expect(clean, isNotNull);
+    expect(ascii.decode(clean!, allowInvalid: true), isNot(contains('tEXt')));
+    await expectLater(
+        cleanHelpScreenshot(inserted('acTL')), throwsFormatException);
+    final oversized = Uint8List.fromList(raw);
+    ByteData.sublistView(oversized).setUint32(16, 1601);
+    await expectLater(cleanHelpScreenshot(oversized), throwsFormatException);
+  });
+
+  testWidgets(
+      'six reasons each create immediately and optional message stays unchanged',
+      (tester) async {
+    final selections = <String>[];
+    await tester.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: HelpComposer(
+                label: (s) => s,
+                enabled: true,
+                screenshots: false,
+                pick: () async => null,
+                create: (category, text, png) async {
+                  selections.add(category);
+                  expect(text, ' test ');
+                  expect(png, isNull);
+                }))));
+    await tester.enterText(find.byType(TextField), ' test ');
+    for (final reason in helpCategories.values) {
+      await tester.tap(find.text(reason));
+      await tester.pump();
+    }
+    expect(selections, helpCategories.keys.toList());
+    expect(find.text('Choose screenshot'), findsNothing);
+  });
+
+  testWidgets(
+      'empty cards withhold self-resolution; claimed and closed views follow server state',
+      (tester) async {
+    final actions = <String>[];
+    Future<void> show(HelpJson view, [List<HelpJson> cards = const []]) =>
+        tester.pumpWidget(MaterialApp(
+            home: Scaffold(
+                body: HelpWaiting(
+                    view: view,
+                    cards: cards,
+                    label: (s) => s,
+                    now: 1500,
+                    online: true,
+                    busy: false,
+                    act: (name, body) => actions.add(name)))));
+    await show(request);
+    expect(find.text('2 ahead of you'), findsOneWidget);
+    expect(find.text('This solved my problem'), findsNothing);
+    expect(find.textContaining('Estimated wait'), findsNothing);
+    await show({
+      ...request,
+      'eta_minutes': [5, 10]
+    }, [
+      {
+        'card_id': 'demo',
+        'card_version': 1,
+        'steps': ['Check paper']
+      }
+    ]);
+    await tester.tap(find.text('This solved my problem'));
+    expect(actions, ['self-resolve']);
+    expect(find.text('Estimated wait: 5–10 min'), findsOneWidget);
+    await show({...request, 'state': 'claimed', 'handler': 'Example helper'});
+    expect(find.text('Handled by Example helper'), findsOneWidget);
+    expect(find.text('Request a callback'), findsNothing);
+    await show({...request, 'state': 'closed', 'ended_at': 1490});
+    expect(find.text('Still needs help'), findsOneWidget);
+    await show({
+      ...request,
+      'state': 'closed',
+      'ended_at': 1490,
+      'close_result': 'self_resolved'
+    });
+    expect(find.text('Still needs help'), findsNothing);
+  });
+}
