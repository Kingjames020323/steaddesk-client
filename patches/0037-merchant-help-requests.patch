@@ -0,0 +1,341 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:crypto/crypto.dart';
+import 'package:uuid/uuid.dart';
+
+typedef HelpJson = Map<String, dynamic>;
+typedef HelpScope = ({Uri origin, String device, String account});
+typedef HelpSign = ({String secret, HelpJson request}) Function(
+    String category, String message, String digest, String? secret);
+typedef HelpSend = Future<HelpJson> Function(Uri origin, String method,
+    String path, String? secret, HelpJson? body, String? key, int? version);
+
+class HelpFailure implements Exception {
+  final int status;
+  final String code;
+  HelpFailure(this.status, [this.code = '']);
+}
+
+Uri configuredHelpOrigin(String value) {
+  final uri = Uri.tryParse(value);
+  if (uri == null ||
+      uri.scheme != 'https' ||
+      uri.host.isEmpty ||
+      uri.userInfo.isNotEmpty ||
+      uri.hasQuery ||
+      uri.hasFragment ||
+      (uri.path.isNotEmpty && uri.path != '/')) {
+    throw HelpFailure(0, 'configuration');
+  }
+  return Uri.parse(uri.origin);
+}
+
+Future<HelpJson> sendHelp(Uri origin, String method, String path,
+    String? secret, HelpJson? body, String? key, int? version) async {
+  final client = HttpClient()..connectionTimeout = const Duration(seconds: 8);
+  Future<HelpJson> send() async {
+    final request =
+        await client.openUrl(method, origin.resolve('/ops/v1/help/$path'));
+    request.followRedirects = false;
+    request.headers.set(HttpHeaders.acceptHeader, 'application/json');
+    if (secret != null) {
+      request.headers.set(HttpHeaders.authorizationHeader, 'Help $secret');
+    }
+    if (key != null) request.headers.set('Idempotency-Key', key);
+    if (version != null) request.headers.set('If-Match', '"$version"');
+    if (body != null) {
+      request.headers.contentType = ContentType.json;
+      final payload = utf8.encode(jsonEncode(body));
+      request.contentLength = payload.length;
+      request.add(payload);
+    }
+    final response = await request.close();
+    final bytes = BytesBuilder(copy: false);
+    await for (final chunk in response) {
+      if (bytes.length + chunk.length > 65536) {
+        throw HelpFailure(response.statusCode);
+      }
+      bytes.add(chunk);
+    }
+    HelpJson? data;
+    try {
+      final parsed = jsonDecode(utf8.decode(bytes.takeBytes()));
+      if (parsed is HelpJson) data = parsed;
+    } on FormatException {/* Error bodies may be empty. */}
+    if (response.statusCode < 200 || response.statusCode >= 300) {
+      final error = data?['error'];
+      throw HelpFailure(response.statusCode,
+          error is Map && error['code'] is String ? error['code'] : '');
+    }
+    if (data == null) throw const FormatException();
+    return data;
+  }
+
+  try {
+    return await send().timeout(const Duration(seconds: 15));
+  } finally {
+    client.close(force: true);
+  }
+}
+
+// Only the main merchant panel owns this journal. The account-private support
+// directory is supplied by the host. Persist a complete retry before any POST.
+class MerchantHelpClient {
+  final File journal;
+  final Future<HelpScope> Function() scope;
+  final HelpSign sign;
+  final HelpSend send;
+  final String merchantVersion;
+  final int Function() now;
+  MerchantHelpClient(this.journal, this.scope, this.sign, this.merchantVersion,
+      {this.send = sendHelp, int Function()? clock})
+      : now = clock ?? (() => DateTime.now().millisecondsSinceEpoch ~/ 1000);
+
+  HelpJson? record, view;
+  List<HelpJson> cards = [];
+  bool screenshots = false;
+  String? notice;
+  bool get pending => record != null && view == null;
+  bool get attachmentPending => record?['png'] != null;
+
+  String fingerprint(HelpScope owner) => sha256
+      .convert(utf8.encode(
+          jsonEncode([owner.origin.origin, owner.device, owner.account])))
+      .toString();
+
+  Future<void> save() async {
+    final entry = record;
+    if (entry == null) {
+      if (await journal.exists()) await journal.delete();
+      return;
+    }
+    await journal.parent.create(recursive: true);
+    final next = File('${journal.path}.next');
+    await next.writeAsString(jsonEncode(entry), flush: true);
+    await next.rename(journal.path);
+  }
+
+  Future<void> forget() async {
+    view = null;
+    cards = [];
+    record = null;
+    await save();
+  }
+
+  Future<HelpScope> owner() async {
+    final current = await scope();
+    if (record != null && record!['owner'] != fingerprint(current)) {
+      await forget();
+      throw HelpFailure(0, 'owner');
+    }
+    return current;
+  }
+
+  Future<void> initialize() async {
+    final leftover = File('${journal.path}.next');
+    if (await leftover.exists()) await leftover.delete();
+    if (await journal.exists()) {
+      record = jsonDecode(await journal.readAsString()) as HelpJson;
+      view = record?['view'] as HelpJson?;
+      await owner();
+    }
+  }
+
+  Future<void> capabilities() async {
+    screenshots = false;
+    final current = await owner();
+    try {
+      final data = await send(
+          current.origin, 'GET', 'capabilities', null, null, null, null);
+      screenshots = data['screenshots'] == true;
+    } catch (_) {/* Older or unreachable servers default to text only. */}
+  }
+
+  Future<HelpJson> call(String method, String path,
+      {HelpJson? body, String? key, int? version}) async {
+    final current = await owner();
+    final result = await send(current.origin, method, path,
+        record!['secret'] as String, body, key, version);
+    await owner();
+    return result;
+  }
+
+  Future<void> create(String category, String message, Uint8List? png) async {
+    final current = await owner();
+    if (record != null) throw HelpFailure(409);
+    if (utf8.encode(message).length > 1024) throw HelpFailure(400, 'message');
+    if (png != null && !screenshots) throw HelpFailure(400);
+    final signed = sign(category, message,
+        png == null ? '' : sha256.convert(png).toString(), null);
+    if (signed.request['device_id'] != current.device) {
+      throw HelpFailure(0, 'owner');
+    }
+    notice = null;
+    record = {
+      'owner': fingerprint(current),
+      'secret': signed.secret,
+      'key': const Uuid().v4(),
+      'signed': signed.request,
+      'diagnostic': {
+        'v': 1,
+        'sampled_at': now(),
+        'merchant_version': merchantVersion,
+        'health': 'unknown',
+      },
+      if (png != null) 'png': base64Encode(png),
+    };
+    await save();
+    await submit();
+  }
+
+  Future<void> submit() async {
+    var signed = record!['signed'] as HelpJson;
+    if ((now() - (signed['ts'] as int)).abs() > 300) {
+      final current = await owner();
+      final refreshed = sign(signed['category'], signed['message'],
+          signed['screenshot_sha256'], record!['secret']);
+      if (refreshed.secret != record!['secret'] ||
+          refreshed.request['device_id'] != current.device) {
+        throw HelpFailure(0, 'owner');
+      }
+      signed = refreshed.request;
+      record!['signed'] = signed;
+      await save();
+    }
+    try {
+      final data =
+          await call('POST', 'requests', body: signed, key: record!['key']);
+      await accept(data);
+    } on HelpFailure catch (failure) {
+      if (failure.status == 409) {
+        try {
+          await accept(await call('GET', 'me'));
+          return;
+        } on HelpFailure catch (recovery) {
+          if (recovery.status != 404) rethrow;
+        }
+      }
+      if ([400, 403, 409, 413, 429].contains(failure.status)) await forget();
+      rethrow;
+    }
+  }
+
+  Future<void> accept(HelpJson data) async {
+    final version = data['version'];
+    if (data['id'] is! String ||
+        version is! int ||
+        !['queued', 'claimed', 'callback_requested', 'closed', 'cancelled']
+            .contains(data['state'])) {
+      throw const FormatException();
+    }
+    if (view != null &&
+        (data['id'] != view!['id'] || version < view!['version'])) return;
+    record!.remove('signed');
+    final action = record!['action'];
+    if (action is Map && version > action['version']) record!.remove('action');
+    record!['view'] = view = data;
+    if (data['state'] != 'queued') cards = [];
+    if (data['state'] == 'closed' || data['state'] == 'cancelled') {
+      record!.remove('png');
+      record!.remove('diagnostic');
+    }
+    await save();
+    if (data['state'] == 'cancelled') {
+      await forget();
+      notice = 'Help request cancelled';
+    }
+  }
+
+  Future<void> refresh() async {
+    if (record == null) return;
+    await owner();
+    if (view?['state'] == 'closed' &&
+        now() - (view!['ended_at'] as int) > 600) {
+      await forget();
+      return;
+    }
+    try {
+      await accept(await call('GET', 'me'));
+    } on HelpFailure catch (e) {
+      if (e.status != 404) rethrow;
+      if (record?['signed'] == null) {
+        await forget();
+        return;
+      }
+      await submit();
+    }
+    if (record?['action'] != null) await sendAction();
+    if (view?['state'] == 'queued') {
+      final list = (await call('GET', 'me/step-cards'))['cards'] as List;
+      cards = list
+          .whereType<HelpJson>()
+          .where((c) =>
+              c['card_id'] is String &&
+              c['card_version'] is int &&
+              c['steps'] is List)
+          .take(3)
+          .toList();
+    }
+    if (record?['diagnostic'] != null) {
+      await call('PUT', 'me/diagnostic', body: record!['diagnostic']);
+      record!.remove('diagnostic');
+      await save();
+    }
+    if (attachmentPending) await upload();
+  }
+
+  Future<void> upload() async {
+    final png = base64Decode(record!['png'] as String);
+    final digest = sha256.convert(png).toString();
+    const width = 32768;
+    final total = (png.length + width - 1) ~/ width;
+    for (var i = 0; i < total; i++) {
+      final part = Uint8List.sublistView(
+          png, i * width, i + 1 == total ? png.length : (i + 1) * width);
+      await call('PUT', 'me/screenshot/chunks/$i', body: {
+        'total': total,
+        'size': png.length,
+        'sha256': digest,
+        'chunk_sha256': sha256.convert(part).toString(),
+        'data': base64Encode(part),
+      });
+    }
+    record!.remove('png');
+    await save();
+  }
+
+  Future<void> act(String action, HelpJson body) async {
+    if (record!['action'] != null) {
+      await refresh();
+      return;
+    }
+    record!['action'] = {
+      'name': action,
+      'body': body,
+      'key': const Uuid().v4(),
+      'version': view!['version']
+    };
+    await save();
+    await sendAction();
+  }
+
+  Future<void> sendAction() async {
+    final action = record!['action'] as HelpJson;
+    try {
+      final result = await call('POST', 'me/${action['name']}',
+          body: action['body'], key: action['key'], version: action['version']);
+      record!.remove('action');
+      await accept(result);
+    } on HelpFailure catch (e) {
+      if (e.status >= 500 || e.status == 429) rethrow;
+      record?.remove('action');
+      await save();
+      if (e.status != 409 && e.status != 412) rethrow;
+      await accept(await call('GET', 'me'));
+      notice = 'The request changed. Its latest status is shown.';
+    }
+  }
+}
