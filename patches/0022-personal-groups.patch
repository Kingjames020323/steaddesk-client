@@ -0,0 +1,229 @@
+part of 'support_home.dart';
+
+class _DraggedDevice {
+  final String owner, id;
+  const _DraggedDevice(this.owner, this.id);
+}
+
+extension _GroupTree on _DirectoryState {
+  Future<String?> _prompt(String title,
+      {String initial = '', bool device = false}) {
+    final form = GlobalKey<FormState>();
+    var value = initial;
+    return showDialog<String>(
+        context: context,
+        builder: (ctx) {
+          void submit() {
+            if (form.currentState!.validate()) {
+              Navigator.pop(
+                  ctx, device ? directSupportId(value) : value.trim());
+            }
+          }
+
+          return AlertDialog(
+              title: Text(translate(title)),
+              content: Form(
+                  key: form,
+                  child: TextFormField(
+                      initialValue: initial,
+                      autofocus: true,
+                      maxLength: device ? 24 : 80,
+                      decoration: InputDecoration(
+                          labelText:
+                              translate(device ? 'Device ID' : 'Group name')),
+                      onChanged: (s) => value = s,
+                      onFieldSubmitted: (_) => submit(),
+                      validator: (s) {
+                        if (device && directSupportId(s ?? '') == null)
+                          return translate('Enter a 9–10 digit device ID');
+                        if ((s ?? '').trim().isEmpty)
+                          return translate('Enter a group name');
+                        return null;
+                      })),
+              actions: [
+                TextButton(
+                    onPressed: () => Navigator.pop(ctx),
+                    child: Text(translate('Cancel'))),
+                TextButton(onPressed: submit, child: Text(translate('Confirm')))
+              ]);
+        });
+  }
+
+  Future<void> createGroup(String owner,
+      [Iterable<String> devices = const []]) async {
+    final name = await _prompt('New group');
+    if (name != null)
+      await changeGroup(
+          () => _PersonalGroups.store.create(owner, name, devices), owner);
+  }
+
+  Future<void> _renameGroup(PersonalGroup group, String owner) async {
+    final name = await _prompt('Rename', initial: group.name);
+    if (name != null)
+      await changeGroup(
+          () => _PersonalGroups.store.rename(owner, group.id, name), owner);
+  }
+
+  Future<void> _addDevice(PersonalGroup group, String owner) async {
+    final id = await _prompt('Add device…', device: true);
+    if (id != null)
+      await changeGroup(
+          () => _PersonalGroups.store.members(owner, group.id, [id]), owner);
+  }
+
+  Future<void> _detailsGroup(String label, Iterable<String> ids) =>
+      showDialog<void>(
+          context: context,
+          builder: (ctx) => AlertDialog(
+                  title: Text(label),
+                  content: SizedBox(
+                      width: 320,
+                      child: ListView(shrinkWrap: true, children: [
+                        Text('${translate('Devices')} · ${ids.length}'),
+                        for (final id in ids) SelectableText(id)
+                      ])),
+                  actions: [
+                    TextButton(
+                        onPressed: () => Navigator.pop(ctx),
+                        child: Text(translate('Close')))
+                  ]));
+
+  Future<String?> _groupMenu(Offset point, List<PopupMenuEntry<String>> items) {
+    final box = Overlay.of(context).context.findRenderObject() as RenderBox;
+    return showMenu<String>(
+        color: Colors.white,
+        surfaceTintColor: Colors.transparent,
+        shape: RoundedRectangleBorder(
+            borderRadius: BorderRadius.circular(8),
+            side: const BorderSide(color: Color(0xffe5e7eb))),
+        constraints: const BoxConstraints(minWidth: 230, maxWidth: 350),
+        context: context,
+        position: RelativeRect.fromRect(
+            box.globalToLocal(point) & Size.zero, Offset.zero & box.size),
+        items: items);
+  }
+
+  PopupMenuItem<String> _item(String action, String label) =>
+      PopupMenuItem(value: action, child: Text(translate(label)));
+
+  Future<void> managedMenu(
+      String key, String label, Offset point, String owner) async {
+    final admin = gFFI.userModel.isLogin && gFFI.userModel.isAdmin.value;
+    final choice = await _groupMenu(point, [
+      for (final text in ['Add device…', 'Rename', 'Who can see this group'])
+        PopupMenuItem(
+            enabled: false,
+            child: Row(mainAxisSize: MainAxisSize.min, children: [
+              if (!admin) const Icon(Icons.lock_outline, size: 14),
+              Flexible(child: Text(translate(text))),
+              const SizedBox(width: 10),
+              Text(translate(admin ? 'Coming soon' : 'Administrators only'),
+                  style: const TextStyle(fontSize: 12))
+            ])),
+      _item('details', 'Details (read-only)'),
+      _item('copy', 'Copy group into My groups…')
+    ]);
+    if (!mounted || owner != account || choice == null) return;
+    final ids = _entries()
+        .where((r) {
+          final d = r.device;
+          return d.merchant != null &&
+              (key == '*' ||
+                  key == d.merchant ||
+                  key == '${d.merchant}/${d.store}');
+        })
+        .map((r) => r.device.id)
+        .toList();
+    if (choice == 'details') {
+      await _detailsGroup(label, ids);
+      return;
+    }
+    final dest = await showDialog<String>(
+        context: context,
+        builder: (ctx) => SimpleDialog(
+                title: Text(translate('Copy group into My groups…')),
+                children: [
+                  for (final g in groups)
+                    SimpleDialogOption(
+                        onPressed: () => Navigator.pop(ctx, g.id),
+                        child: Text(g.name)),
+                  SimpleDialogOption(
+                      onPressed: () => Navigator.pop(ctx, 'new'),
+                      child: Text(translate('New group…')))
+                ]));
+    if (!mounted || account != owner || dest == null) return;
+    if (dest == 'new') {
+      await createGroup(owner, ids);
+    } else {
+      await changeGroup(
+          () => _PersonalGroups.store.members(owner, dest, ids), owner);
+    }
+  }
+
+  Future<void> _personalMenu(
+      PersonalGroup group, Offset point, String owner) async {
+    final choice = await _groupMenu(point, [
+      _item('add', 'Add device…'),
+      _item('rename', 'Rename'),
+      _item('details', 'Details'),
+      const PopupMenuDivider(),
+      _item('delete', 'Delete group (keep devices)')
+    ]);
+    if (!mounted || owner != account) return;
+    switch (choice) {
+      case 'add':
+        await _addDevice(group, owner);
+        break;
+      case 'rename':
+        await _renameGroup(group, owner);
+        break;
+      case 'details':
+        await _detailsGroup(group.name, group.devices);
+        break;
+      case 'delete':
+        await changeGroup(
+            () => _PersonalGroups.store.delete(owner, group.id), owner);
+        break;
+    }
+  }
+
+  Widget personalNode(PersonalGroup group, String owner) {
+    final key = 'mine/${group.id}';
+    return DragTarget<_DraggedDevice>(
+        onWillAcceptWithDetails: (d) =>
+            d.data.owner == owner && account == owner,
+        onAcceptWithDetails: (d) => changeGroup(
+            () => _PersonalGroups.store.members(owner, group.id, [d.data.id]),
+            owner),
+        builder: (context, candidates, _) => CallbackShortcuts(
+                bindings: {
+                  const SingleActivator(LogicalKeyboardKey.f2): () =>
+                      _renameGroup(group, owner)
+                },
+                child: Focus(
+                    child: Builder(
+                        builder: (focused) => InkWell(
+                            onTap: () {
+                              Focus.of(focused).requestFocus();
+                              selectScope(key);
+                            },
+                            onSecondaryTapDown: (e) =>
+                                _personalMenu(group, e.globalPosition, owner),
+                            child: Container(
+                                color: scope == key || candidates.isNotEmpty
+                                    ? const Color(0xffdff2fa)
+                                    : null,
+                                padding: const EdgeInsets.symmetric(
+                                    horizontal: 14, vertical: 9),
+                                child: Row(children: [
+                                  const Icon(Icons.folder_outlined, size: 16),
+                                  const SizedBox(width: 6),
+                                  Expanded(
+                                      child: Text(group.name,
+                                          maxLines: 1,
+                                          overflow: TextOverflow.ellipsis)),
+                                  Text(
+                                      '${group.devices.where((id) => presence[id] == true).length}/${group.devices.length}')
+                                ])))))));
+  }
+}
