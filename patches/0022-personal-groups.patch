diff --git a/flutter/test/personal_groups_test.dart b/flutter/test/personal_groups_test.dart
new file mode 100644
index 0000000..0f204f8
--- /dev/null
+++ b/flutter/test/personal_groups_test.dart
@@ -0,0 +1,105 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import '../lib/steaddesk/personal_groups.dart';
+
+void main() {
+  late Directory dir;
+  late File file;
+  late PersonalGroups store;
+  late int resets;
+  PersonalGroups open() => PersonalGroups(() async => file,
+      onReset: () => resets++, onChanged: () {});
+  setUp(() async {
+    dir = await Directory.systemTemp.createTemp('support-groups-test-');
+    file = File('${dir.path}/support-groups-v1.json');
+    resets = 0;
+    store = open();
+  });
+  tearDown(() => dir.delete(recursive: true));
+
+  test(
+      'v1 migration preserves original bytes and all accounts; rename keeps the ID across restarts',
+      () async {
+    const v1 =
+        '{"version":1, "accounts":{"demo":{"Desk":["101","101"]},"second":{"Desk":[]}}}\n';
+    await file.writeAsString(v1);
+    final group = (await store.list('demo')).single;
+    final other = (await store.list('second')).single;
+    expect(
+        group.id,
+        matches(RegExp(
+            r'^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$')));
+    expect(other.id, isNot(group.id));
+    final backup = File('${dir.path}/support-groups-v1.migrated.json');
+    expect(await backup.readAsString(), v1);
+    expect(jsonDecode(await file.readAsString())['version'], 2);
+    await store.rename('demo', group.id, 'Checkout');
+    final renamed = (await open().list('demo')).single;
+    expect(renamed.id, group.id);
+    expect(renamed.devices, {'101'});
+    expect(renamed.name, 'Checkout');
+    expect(renamed.updatedAt.isUtc, true);
+    expect((await open().list('second')).single.name, 'Desk');
+    expect(await backup.readAsString(), v1);
+    expect(resets, 0);
+  });
+
+  for (final sample in {
+    'broken JSON': utf8.encode('{'),
+    'invalid UTF-8': [0xff, 0xfe],
+    'unknown version': utf8.encode('{"version":3,"accounts":{}}'),
+    'malformed members':
+        utf8.encode('{"version":1,"accounts":{"demo":{"Desk":[null]}}}')
+  }.entries) {
+    test('${sample.key}: concurrent readers reset once and preserve bytes',
+        () async {
+      await file.writeAsBytes(sample.value);
+      await Future.wait(List.generate(6, (_) => store.list('demo')));
+      final backups = await dir
+          .list()
+          .where((f) => f.path.contains('support-groups.corrupt-'))
+          .toList();
+      expect(backups, hasLength(1));
+      expect(await File(backups.single.path).readAsBytes(), sample.value);
+      expect(jsonDecode(await file.readAsString()),
+          {'version': 2, 'accounts': {}});
+      await open().create('demo', 'Restored');
+      expect((await store.list('demo')).single.name, 'Restored');
+      expect(resets, 1);
+    });
+  }
+
+  test('finishes reset interrupted after the corrupt file was moved', () async {
+    final backup = File('${dir.path}/support-groups.corrupt-previous.json');
+    await backup.writeAsString('{');
+    await File('${file.path}.reset')
+        .writeAsString('{"version":2,"accounts":{}}');
+    expect(await store.list('demo'), isEmpty);
+    await open().list('demo');
+    expect(resets, 1);
+    expect(jsonDecode(await file.readAsString())['version'], 2);
+    expect(await backup.readAsString(), '{');
+  });
+
+  test(
+      'concurrent edits, no-op additions, removal and failed renames preserve other groups',
+      () async {
+    await store.create('demo', 'Desk');
+    await store.create('demo', 'Other', ['101']);
+    final group = (await store.list('demo')).first;
+    await Future.wait(
+        List.generate(20, (i) => store.members('demo', group.id, ['$i'])));
+    final written = await file.readAsBytes();
+    await store.members('demo', group.id, ['7']);
+    expect(await file.readAsBytes(), written);
+    expect((await store.list('demo')).first.devices, hasLength(20));
+    await expectLater(
+        store.rename('demo', group.id, 'Other'), throwsFormatException);
+    await store.members('demo', group.id, ['7'], remove: true);
+    expect((await store.list('demo')).first.devices.contains('7'), false);
+    await store.delete('demo', group.id);
+    expect((await store.list('demo')).single.devices, {'101'});
+  });
+}
