diff --git a/flutter/lib/steaddesk/personal_groups.dart b/flutter/lib/steaddesk/personal_groups.dart
new file mode 100644
index 0000000..17ce4e9
--- /dev/null
+++ b/flutter/lib/steaddesk/personal_groups.dart
@@ -0,0 +1,224 @@
+import 'dart:convert';
+import 'dart:io';
+import 'package:uuid/uuid.dart';
+
+class PersonalGroup {
+  final String id;
+  String name;
+  final Set<String> devices;
+  DateTime updatedAt;
+  PersonalGroup(this.id, this.name, this.devices, this.updatedAt);
+
+  factory PersonalGroup.create(String name, Iterable<String> devices) =>
+      PersonalGroup(
+          const Uuid().v4(), name, devices.toSet(), DateTime.now().toUtc());
+
+  Map<String, Object> toJson() => {
+        'id': id,
+        'name': name,
+        'device_ids': devices.toList(),
+        'updated_at': updatedAt.toIso8601String()
+      };
+}
+
+typedef _Accounts = Map<String, List<PersonalGroup>>;
+
+class PersonalGroups {
+  final Future<File> Function() file;
+  final void Function() onReset, onChanged;
+  Future<void> _pending = Future.value();
+  PersonalGroups(this.file, {required this.onReset, required this.onChanged});
+
+  static final _uuid = RegExp(
+      r'^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$',
+      caseSensitive: false);
+
+  static List<String> _ids(dynamic value) {
+    if (value is! List || !value.every((id) => id is String && id.isNotEmpty)) {
+      throw const FormatException('device_ids');
+    }
+    return value.cast<String>();
+  }
+
+  static (_Accounts, bool) _decode(List<int> bytes) {
+    final raw = jsonDecode(utf8.decode(bytes));
+    if (raw is! Map ||
+        raw['accounts'] is! Map ||
+        raw['version'] is! int ||
+        !const [1, 2].contains(raw['version'])) {
+      throw const FormatException('version/accounts');
+    }
+    final old = raw['version'] == 1;
+    final accounts = <String, List<PersonalGroup>>{};
+    final uuids = <String>{};
+    for (final entry in (raw['accounts'] as Map<String, dynamic>).entries) {
+      final groups = accounts[entry.key] = [];
+      final value = entry.value;
+      if (old && value is Map<String, dynamic>) {
+        for (final g in value.entries) {
+          if (g.key.trim().isEmpty) throw const FormatException('group name');
+          groups.add(PersonalGroup.create(g.key, _ids(g.value)));
+        }
+      } else if (!old && value is List) {
+        final names = <String>{};
+        for (final row in value) {
+          if (row
+              case {
+                'id': String id,
+                'name': String name,
+                'updated_at': String timestamp,
+                'device_ids': final devices
+              }) {
+            final date = DateTime.tryParse(timestamp);
+            if (!_uuid.hasMatch(id) ||
+                !uuids.add(id.toLowerCase()) ||
+                name.trim().isEmpty ||
+                !names.add(name) ||
+                date == null ||
+                !date.isUtc) {
+              throw const FormatException('invalid group');
+            }
+            groups.add(PersonalGroup(id, name, _ids(devices).toSet(), date));
+          } else {
+            throw const FormatException('group');
+          }
+        }
+      } else {
+        throw const FormatException('account');
+      }
+    }
+    return (accounts, old);
+  }
+
+  static Future<void> _replace(File target, List<int> bytes) async {
+    final tmp = File('${target.path}.tmp');
+    await tmp.writeAsBytes(bytes, flush: true);
+    await tmp.rename(target.path);
+  }
+
+  Future<void> _save(File f, _Accounts accounts) => _replace(
+      f, utf8.encode(jsonEncode({'version': 2, 'accounts': accounts})));
+
+  Future<_Accounts> _read(File f) async {
+    // Recovery moves the broken file aside. Finish an interrupted replacement
+    // before another reader or edit opens an empty store.
+    final reset = File('${f.path}.reset');
+    if (!await f.exists()) {
+      if (await reset.exists()) {
+        await reset.rename(f.path);
+        onReset();
+      }
+      return {};
+    }
+    final bytes = await f.readAsBytes();
+    late final (_Accounts, bool) parsed;
+    try {
+      parsed = _decode(bytes);
+    } on FormatException {
+      final stamp =
+          DateTime.now().toUtc().toIso8601String().replaceAll(':', '-');
+      await _save(reset, {});
+      await f.rename('${f.parent.path}/support-groups.corrupt-$stamp.json');
+      await reset.rename(f.path);
+      onReset();
+      return {};
+    }
+    final (accounts, old) = parsed;
+    if (old) {
+      final backup = File('${f.parent.path}/support-groups-v1.migrated.json');
+      // Retain the first backup if a v1 file is subsequently re-imported.
+      if (!await backup.exists()) {
+        await _replace(backup, bytes);
+      } else if (base64Encode(await backup.readAsBytes()) !=
+          base64Encode(bytes)) {
+        await _replace(
+            File(
+                '${f.parent.path}/support-groups-v1.migrated-${DateTime.now().toUtc().microsecondsSinceEpoch}.json'),
+            bytes);
+      }
+      await _save(f, accounts);
+    }
+    return accounts;
+  }
+
+  // Serialize reads as well: an initial read can migrate or recover the file.
+  Future<T> _locked<T>(Future<T> Function(File, _Accounts) action) {
+    final next = _pending.then((_) async {
+      final f = await file();
+      await f.parent.create(recursive: true);
+      final lock = await File('${f.path}.lock').open(mode: FileMode.append);
+      try {
+        await lock.lock(FileLock.blockingExclusive);
+        return await action(f, await _read(f));
+      } finally {
+        await lock.close();
+      }
+    });
+    _pending = next.then<void>((_) {}, onError: (Object _) {});
+    return next;
+  }
+
+  Future<List<PersonalGroup>> list(String account) =>
+      _locked((_, accounts) async =>
+          [...?accounts[account]]..sort((a, b) => a.name.compareTo(b.name)));
+
+  Future<List<String>> forDevice(String account, String id) async =>
+      account.isEmpty
+          ? []
+          : [
+              for (final g in await list(account))
+                if (g.devices.contains(id)) g.name
+            ];
+
+  Future<void> _edit(String account, bool Function(List<PersonalGroup>) edit) =>
+      _locked((f, accounts) async {
+        if (account.isEmpty) throw StateError('Sign in');
+        if (!edit(accounts.putIfAbsent(account, () => []))) return;
+        await _save(f, accounts);
+        onChanged();
+      });
+
+  static void _checkName(List<PersonalGroup> groups, String name,
+      [String? except]) {
+    if (name.isEmpty || groups.any((g) => g.name == name && g.id != except)) {
+      throw const FormatException('Group name is empty or already in use');
+    }
+  }
+
+  Future<void> create(String account, String name,
+          [Iterable<String> devices = const []]) =>
+      _edit(account, (groups) {
+        _checkName(groups, name.trim());
+        groups.add(PersonalGroup.create(name.trim(), devices));
+        return true;
+      });
+
+  Future<void> rename(String account, String id, String name) =>
+      _edit(account, (groups) {
+        final group = groups.firstWhere((g) => g.id == id);
+        final next = name.trim();
+        if (next == group.name) return false;
+        _checkName(groups, next, id);
+        group.name = next;
+        group.updatedAt = DateTime.now().toUtc();
+        return true;
+      });
+
+  Future<void> members(String account, String id, Iterable<String> devices,
+          {bool remove = false}) =>
+      _edit(account, (groups) {
+        final group = groups.firstWhere((g) => g.id == id);
+        final count = group.devices.length;
+        if (remove) {
+          group.devices.removeAll(devices);
+        } else {
+          group.devices.addAll(devices);
+        }
+        if (count == group.devices.length) return false;
+        group.updatedAt = DateTime.now().toUtc();
+        return true;
+      });
+
+  Future<void> delete(String account, String id) => _edit(
+      account, (groups) => groups.remove(groups.firstWhere((g) => g.id == id)));
+}
