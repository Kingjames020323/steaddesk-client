+import 'package:flutter/material.dart';
+
+class PowerMenuButton extends StatelessWidget {
+  const PowerMenuButton(
+      {super.key,
+      required this.visible,
+      required this.enabled,
+      required this.activeConnection,
+      required this.send});
+  final bool visible, enabled;
+  final String Function() activeConnection;
+  final Future<void> Function(String connection) send;
+
+  @override
+  Widget build(BuildContext context) {
+    if (!visible) return const SizedBox.shrink();
+    return Expanded(
+        child: IconButton(
+      tooltip: '电源菜单',
+      padding: EdgeInsets.zero,
+      constraints: const BoxConstraints(),
+      iconSize: 18,
+      color: const Color(0xff0a6fa8),
+      icon: const FittedBox(child: Icon(Icons.power_settings_new)),
+      onPressed: !enabled
+          ? null
+          : () async {
+              final connection = activeConnection();
+              if (connection.isEmpty || connection == '0') return;
+              final confirmed = await showDialog<bool>(
+                context: context,
+                builder: (dialog) => AlertDialog(
+                  title: const Text('电源菜单'),
+                  content: const Text('将在对方屏幕上打开电源菜单，菜单里有关机和重启'),
+                  actions: [
+                    TextButton(
+                        onPressed: () => Navigator.pop(dialog, false),
+                        child: const Text('取消')),
+                    TextButton(
+                        onPressed: () => Navigator.pop(dialog, true),
+                        child: const Text('打开')),
+                  ],
+                ),
+              );
+              if (confirmed == true &&
+                  context.mounted &&
+                  activeConnection() == connection) {
+                await send(connection);
+              }
+            },
+    ));
+  }
+}
