+// The peer receives its ordinary input event even when ops is unavailable.
+Future<void> _recordPowerRequest(String peer, String session, String connection) async {
+  OpsHealthHttp? api;
+  try {
+    final token = bind.mainGetLocalOption(key: 'access_token');
+    if (token.isEmpty) return;
+    final origin = Uri.parse(await bind.mainGetApiServer());
+    if (origin.scheme != 'https' || bind.mainGetLocalOption(key: 'access_token') != token) return;
+    final path = toolbarSessionRoute(peer: peer, session: session,
+        connection: connection, cases: false, caseId: null);
+    api = OpsHealthHttp(origin, token);
+    await api.request('POST', '$path/power-menu-requested', {});
+  } catch (_) {
+    // Audit delivery is best effort. Do not retry or replay the input event.
+  } finally {
+    api?.close();
+  }
+}
