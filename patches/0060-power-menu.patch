+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/power_menu.dart';
+
+void main() {
+  testWidgets('only a confirmed request for the same connection is sent',
+      (tester) async {
+    var connection = 'first';
+    final sent = <String>[];
+    Widget screen(bool android) => MaterialApp(
+            home: Scaffold(
+                body: Row(children: [
+          PowerMenuButton(
+              visible: android,
+              enabled: true,
+              activeConnection: () => connection,
+              send: (id) async {
+                sent.add(id);
+              }),
+        ])));
+    await tester.pumpWidget(screen(false));
+    expect(find.byTooltip('电源菜单'), findsNothing);
+    await tester.pumpWidget(screen(true));
+    Future<void> choose(String label, {String? changeTo}) async {
+      await tester.tap(find.byTooltip('电源菜单'));
+      await tester.pumpAndSettle();
+      if (changeTo != null) connection = changeTo;
+      await tester.tap(find.text(label));
+      await tester.pumpAndSettle();
+    }
+
+    await choose('取消');
+    await choose('打开', changeTo: 'second');
+    expect(sent, isEmpty);
+    await choose('打开');
+    expect(sent, ['second']);
+  });
+}
