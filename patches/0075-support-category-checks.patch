diff --git a/flutter/test/steaddesk/category_support_test.dart b/flutter/test/steaddesk/category_support_test.dart
new file mode 100644
index 0000000..e36efae
--- /dev/null
+++ b/flutter/test/steaddesk/category_support_test.dart
@@ -0,0 +1,163 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/ops_health.dart';
+import 'package:flutter_hbb/steaddesk/check_categories.dart';
+import 'package:flutter_hbb/steaddesk/quick/check.dart' show Json;
+import 'package:flutter_hbb/steaddesk/quick/support.dart';
+import 'package:flutter_hbb/steaddesk/toolbar/actions.dart';
+import 'package:flutter_hbb/steaddesk/toolbar/category_menu.dart';
+
+class _Api extends Fake implements HealthApi {
+  List<String>? capabilities = checkCategoryIds;
+  final categories = <String>[];
+  final kinds = ['printer', 'payment', 'kds'];
+  late final entries = [
+    for (int i = 0; i < kinds.length; i++)
+      {
+        'id': 'r$i',
+        'name': 'Fixture $i',
+        'ip': '10.2.1.${i + 1}',
+        'type': kinds[i],
+        'model': ''
+      },
+  ];
+  @override
+  Future<Json> request(String method, String route, [Json? body]) async {
+    if (method == 'GET' && route.endsWith('/check-policy')) {
+      return {'store_id': 'demo', 'can_edit': false, 'allowed': true};
+    }
+    if (method == 'GET' && route.endsWith('/inventory')) {
+      return {
+        'entries': entries,
+        if (capabilities != null) 'categories': capabilities
+      };
+    }
+    if (method == 'POST' && route.endsWith('/checks')) {
+      expect(body!.keys, ['category']);
+      categories.add(body['category']);
+      return {'id': 'job'};
+    }
+    if (method == 'GET' && route.endsWith('/checks/job')) {
+      return {
+        'id': 'job',
+        'state': 'completed',
+        'category': categories.last,
+        'results': [
+          for (final row in entries)
+            if (categories.last == 'all' ||
+                checkCategoryForType(row['type']!) == categories.last)
+              {
+                'inventory_id': row['id'],
+                'name': row['name'],
+                'ip': row['ip'],
+                'outcome': 'reachable',
+                'latency_ms': 3
+              }
+        ]
+      };
+    }
+    throw StateError('Unexpected request');
+  }
+}
+
+void main() {
+  testWidgets(
+      'device inventory sends the chosen category, groups rows and hides absent categories',
+      (t) async {
+    final api = _Api();
+    final store = HealthStore(api, isCurrent: () => true)..available = true;
+    store.devices['demo'] = DeviceHealth.from(
+        {'device_id': 'demo', 'status': 'normal', 'reasons': []});
+    await t.pumpWidget(MaterialApp(
+        home:
+            Scaffold(body: storeInventory(store, 'demo', language: 'es-MX'))));
+    await t.pumpAndSettle();
+    for (final category in checkCategoryIds) {
+      final button =
+          find.widgetWithText(TextButton, checkCategoryLabel(category, 'es'));
+      expect(button, findsOneWidget);
+      await t.ensureVisible(button);
+      await t.tap(button);
+      await t.pumpAndSettle();
+      expect(api.categories.last, category);
+    }
+    for (final group in [
+      'Impresoras',
+      'Terminales de pago',
+      'Equipos de la tienda'
+    ]) {
+      expect(find.text(group), findsOneWidget);
+    }
+    api.entries.removeWhere((r) => r['type'] == 'payment');
+    final reload = find.text('刷新设备表');
+    await t.ensureVisible(reload);
+    await t.tap(reload);
+    await t.pumpAndSettle();
+    expect(find.text('Revisar terminales de pago'), findsNothing);
+    api.capabilities = null;
+    await t.tap(reload);
+    await t.pumpAndSettle();
+    expect(find.text('Revisar todo'), findsNothing);
+    expect(api.categories, checkCategoryIds);
+  });
+  testWidgets(
+      'session popup expands only approved categories, retains viewer gate and posts no targets',
+      (t) async {
+    final bodies = <Json>[];
+    var operator = true;
+    Future<void> show(List<String> categories) async {
+      await t.pumpWidget(MaterialApp(
+          home: Scaffold(
+              body: CategoryToolbarPopup(
+        categories: categories,
+        language: 'en_US',
+        tooltip: 'Actions',
+        enabled: true,
+        child: const Text('Menu'),
+        onSelected: (_) => fail('Unexpected legacy action'),
+        onQuick: (category) => submitToolbarAction((method, path,
+                [body]) async {
+          expect(method, 'POST');
+          expect(path, 'toolbar/demo/session');
+          bodies.add(body!);
+          return {};
+        }, 'toolbar/demo/session', ToolbarAction.quick, () => operator,
+            category: category),
+        itemBuilder: (_) => [
+          PopupMenuItem<Object>(
+              value: ToolbarAction.quick,
+              enabled: operator,
+              child: const Text('Legacy quick check')),
+          const PopupMenuItem<Object>(
+              value: ToolbarAction.logs, child: Text('Logs')),
+        ],
+      ))));
+      await t.pumpAndSettle();
+      await t.tap(find.text('Menu'));
+      await t.pumpAndSettle();
+    }
+
+    await show(['printers', 'all']);
+    expect(find.text('Check card terminals'), findsNothing);
+    expect(find.text('Logs'), findsOneWidget);
+    await t.tap(find.text('Check printers'));
+    await t.pumpAndSettle();
+    expect(bodies, [
+      {'action': 'quick_check', 'category': 'printers'}
+    ]);
+    operator = false;
+    await show(['all']);
+    expect(
+        t
+            .widget<PopupMenuItem<Object>>(
+                find.widgetWithText(PopupMenuItem<Object>, 'Check all'))
+            .enabled,
+        isFalse);
+    await t.tapAt(const Offset(780, 580));
+    await t.pumpAndSettle();
+    await show([]);
+    expect(find.text('Check all'), findsNothing);
+    expect(find.text('Legacy quick check'), findsNothing);
+    expect(bodies, hasLength(1));
+  });
+}
