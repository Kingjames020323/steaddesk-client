@@ -0,0 +1,48 @@
+import 'package:flutter/material.dart';
+import '../check_categories.dart';
+import 'actions.dart';
+
+class CategoryToolbarPopup extends StatelessWidget {
+  final List<String> categories;
+  final String language, tooltip;
+  final bool enabled;
+  final Widget child;
+  final PopupMenuItemBuilder<Object> itemBuilder;
+  final ValueChanged<Object> onSelected;
+  final ValueChanged<String> onQuick;
+  const CategoryToolbarPopup(
+      {super.key,
+      required this.categories,
+      required this.language,
+      required this.tooltip,
+      required this.enabled,
+      required this.child,
+      required this.itemBuilder,
+      required this.onSelected,
+      required this.onQuick});
+  @override
+  Widget build(BuildContext context) => PopupMenuButton<Object>(
+        enabled: enabled,
+        tooltip: tooltip,
+        child: child,
+        onSelected: (value) {
+          if (value is String && checkCategoryIds.contains(value)) {
+            if (categories.contains(value)) onQuick(value);
+          } else {
+            onSelected(value);
+          }
+        },
+        itemBuilder: (context) => [
+          for (final entry in itemBuilder(context))
+            if (entry is PopupMenuItem<Object> &&
+                entry.value == ToolbarAction.quick)
+              for (final category in categories)
+                PopupMenuItem<Object>(
+                    value: category,
+                    enabled: entry.enabled,
+                    child: Text(checkCategoryLabel(category, language)))
+            else
+              entry,
+        ],
+      );
+}
