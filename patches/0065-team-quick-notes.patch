index 0000000..5fb46e9
--- /dev/null
+++ b/flutter/lib/steaddesk/cases/team_notes.dart
@@ -0,0 +1,207 @@
+import 'package:flutter/material.dart';
+
+import '../ops_health.dart' show HealthFailure;
+
+typedef NotesRequest = Future<Map<String, dynamic>> Function(
+    int? version, List<String>? replacement);
+
+const defaultNotes = ['重启打印机', '重新插网线', '换纸卷', '重打订单'];
+
+class TeamNotes extends StatefulWidget {
+  const TeamNotes(
+      {super.key, required this.insert, this.request, this.admin = false});
+  final ValueChanged<String> insert;
+  final NotesRequest? request;
+  final bool admin;
+
+  @override
+  State<TeamNotes> createState() => _TeamNotesState();
+}
+
+class _TeamNotesState extends State<TeamNotes> {
+  List<String> notes = defaultNotes;
+  int? version;
+  bool? canEdit;
+  bool loading = false;
+  String? message;
+
+  @override
+  void initState() {
+    super.initState();
+    if (widget.request != null) refresh();
+  }
+
+  void apply(Map<String, dynamic> data) {
+    final received = List<String>.from(data['notes'] as List);
+    final revision = data['version'] as int;
+    final admin = data['can_edit'] as bool;
+    notes = received;
+    version = revision;
+    canEdit = admin;
+  }
+
+  Future<void> refresh({String? feedback}) async {
+    setState(() => loading = true);
+    try {
+      final response = await widget.request!(null, null);
+      if (!mounted) return;
+      apply(response);
+      message = feedback;
+    } catch (_) {
+      if (!mounted) return;
+      notes = defaultNotes;
+      version = null;
+      canEdit = null;
+      message = '需要连接 ops';
+    } finally {
+      if (mounted) setState(() => loading = false);
+    }
+  }
+
+  Future<void> edit(bool add) async {
+    final before = version;
+    if (before == null || loading) return;
+    final updated = await showDialog<List<String>>(
+        context: context,
+        useRootNavigator: false,
+        builder: (_) => _Editor(notes: notes, add: add));
+    if (updated == null || !mounted) return;
+    setState(() => loading = true);
+    try {
+      final response = await widget.request!(before, updated);
+      if (mounted) {
+        setState(() {
+          apply(response);
+          message = null;
+          loading = false;
+        });
+      }
+    } catch (e) {
+      if (mounted) {
+        await refresh(
+            feedback: e is HealthFailure && e.status == 409
+                ? '其他管理员已修改常用备注，请核对后再编辑。'
+                : '未能确认保存，请核对当前列表。');
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final online = version != null;
+    final editable = online && !loading;
+    return Wrap(
+        spacing: 6,
+        runSpacing: 6,
+        crossAxisAlignment: WrapCrossAlignment.center,
+        children: [
+          const Text('常用：'),
+          for (final note in notes)
+            OutlinedButton(
+                style: OutlinedButton.styleFrom(
+                    minimumSize: const Size(0, 28),
+                    tapTargetSize: MaterialTapTargetSize.shrinkWrap),
+                onPressed: () => widget.insert(note),
+                child: Text('+ $note')),
+          if (canEdit ?? widget.admin) ...[
+            IconButton(
+                tooltip: !online ? '需要连接 ops' : '新增常用备注',
+                icon: const Icon(Icons.add),
+                onPressed:
+                    editable && notes.length < 30 ? () => edit(true) : null),
+            IconButton(
+                tooltip: !online ? '需要连接 ops' : '编辑常用备注',
+                icon: const Icon(Icons.edit_outlined),
+                onPressed: editable ? () => edit(false) : null),
+          ],
+          if (widget.request != null)
+            IconButton(
+                tooltip: '刷新常用备注',
+                icon: const Icon(Icons.refresh),
+                onPressed: loading ? null : refresh),
+          if (message != null)
+            Text(message!, style: Theme.of(context).textTheme.bodySmall),
+        ]);
+  }
+}
+
+class _Editor extends StatefulWidget {
+  const _Editor({required this.notes, required this.add});
+  final List<String> notes;
+  final bool add;
+  @override
+  State<_Editor> createState() => _EditorState();
+}
+
+class _EditorState extends State<_Editor> {
+  late final rows = [
+    for (final text in widget.notes) TextEditingController(text: text),
+    if (widget.add) TextEditingController(),
+  ];
+  final removed = <TextEditingController>[];
+  String? error;
+  @override
+  void dispose() {
+    for (final row in [...rows, ...removed]) {
+      row.dispose();
+    }
+    super.dispose();
+  }
+
+  void move(int from, int to) =>
+      setState(() => rows.insert(to, rows.removeAt(from)));
+  void save() {
+    final values = rows.map((row) => row.text.trim()).toList();
+    if (values.any((s) => s.isEmpty || s.runes.length > 60)) {
+      setState(() => error = '每条常用备注限 1–60 字。');
+    } else {
+      Navigator.of(context).pop(values);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => AlertDialog(
+          title: Text(widget.add ? '新增常用备注' : '编辑常用备注'),
+          content: SizedBox(
+              width: 460,
+              child: SingleChildScrollView(
+                  child: Column(mainAxisSize: MainAxisSize.min, children: [
+                for (var i = 0; i < rows.length; i++)
+                  Row(key: ObjectKey(rows[i]), children: [
+                    Expanded(
+                        child: TextField(
+                            controller: rows[i],
+                            maxLength: 60,
+                            autofocus: widget.add && i == rows.length - 1,
+                            decoration:
+                                InputDecoration(labelText: '备注 ${i + 1}'))),
+                    IconButton(
+                        tooltip: '上移',
+                        icon: const Icon(Icons.arrow_upward),
+                        onPressed: i > 0 ? () => move(i, i - 1) : null),
+                    IconButton(
+                        tooltip: '下移',
+                        icon: const Icon(Icons.arrow_downward),
+                        onPressed:
+                            i + 1 < rows.length ? () => move(i, i + 1) : null),
+                    IconButton(
+                        tooltip: '删除',
+                        icon: const Icon(Icons.delete_outline),
+                        onPressed: () =>
+                            setState(() => removed.add(rows.removeAt(i)))),
+                  ]),
+                if (rows.length < 30)
+                  TextButton.icon(
+                      onPressed: () =>
+                          setState(() => rows.add(TextEditingController())),
+                      icon: const Icon(Icons.add),
+                      label: const Text('添加一条')),
+                if (error != null) Text(error!),
+              ]))),
+          actions: [
+            TextButton(
+                onPressed: () => Navigator.of(context).pop(),
+                child: const Text('取消')),
+            FilledButton(onPressed: save, child: const Text('保存')),
+          ]);
+}
