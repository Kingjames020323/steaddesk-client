diff --git a/flutter/test/steaddesk/team_notes_test.dart b/flutter/test/steaddesk/team_notes_test.dart
new file mode 100644
index 0000000..274b67a
--- /dev/null
+++ b/flutter/test/steaddesk/team_notes_test.dart
@@ -0,0 +1,71 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/steaddesk/cases/team_notes.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  testWidgets(
+      'staff reads a team edit on refresh; offline admins see disabled controls',
+      (tester) async {
+    var stored = ['第一条'];
+    var revision = 1;
+    var online = true;
+    var selected = '';
+    Widget panel(bool admin, String key) => TeamNotes(
+        key: ValueKey(key),
+        admin: admin,
+        insert: (value) => selected = value,
+        request: (version, replacement) async {
+          if (!online) throw StateError('offline');
+          if (replacement != null) {
+            expect(admin, isTrue);
+            expect(version, revision);
+            stored = replacement;
+            revision++;
+          }
+          return {
+            'version': revision,
+            'notes': List.of(stored),
+            'can_edit': admin
+          };
+        });
+    await tester.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: Column(
+                children: [panel(true, 'admin'), panel(false, 'staff')]))));
+    await tester.pumpAndSettle();
+    expect(find.byTooltip('新增常用备注'), findsOneWidget);
+    expect(find.byTooltip('编辑常用备注'), findsOneWidget);
+    await tester.tap(find.byTooltip('新增常用备注'));
+    await tester.pumpAndSettle();
+    await tester.enterText(find.byType(TextField).last, '第二条');
+    await tester.tap(find.byTooltip('上移').last);
+    await tester.pump();
+    await tester.tap(find.text('保存'));
+    await tester.pumpAndSettle();
+    expect(stored, ['第二条', '第一条']);
+    expect(find.text('+ 第二条'), findsOneWidget);
+    await tester.tap(find.byTooltip('刷新常用备注').last);
+    await tester.pumpAndSettle();
+    expect(find.text('+ 第二条'), findsNWidgets(2));
+    await tester.tap(find.text('+ 第二条').last);
+    expect(selected, '第二条');
+    await tester.tap(find.byTooltip('编辑常用备注'));
+    await tester.pumpAndSettle();
+    await tester.enterText(find.byType(TextField).first, '修改');
+    await tester.tap(find.byTooltip('删除').last);
+    await tester.pump();
+    await tester.tap(find.text('保存'));
+    await tester.pumpAndSettle();
+    expect(stored, ['修改']);
+    online = false;
+    await tester.tap(find.byTooltip('刷新常用备注').first);
+    await tester.pumpAndSettle();
+    expect(find.text('+ 修改'), findsNothing);
+    expect(find.text('+ 重启打印机'), findsOneWidget);
+    final buttons = tester
+        .widgetList<IconButton>(find.byType(IconButton))
+        .where((b) => b.tooltip == '需要连接 ops');
+    expect(buttons.length, 2);
+    expect(buttons.every((b) => b.onPressed == null), isTrue);
+  });
+}
