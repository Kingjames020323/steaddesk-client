+#[cfg(any(not(any(target_os = "android", target_os = "ios")), test))]
+fn read_password(reader: impl std::io::Read) -> Option<String> {
+    use std::io::Read;
+
+    const MAX_BYTES: usize = 1024;
+    // One extra byte detects overflow even after a trailing CRLF.
+    let limit = MAX_BYTES + 3;
+    let mut input = Vec::with_capacity(limit + 1);
+    let password = reader
+        .take(limit as u64)
+        .read_to_end(&mut input)
+        .ok()
+        .and_then(|_| {
+            let line = match input.strip_suffix(b"\n") {
+                Some(line) => line.strip_suffix(b"\r").unwrap_or(line),
+                None => &input,
+            };
+            if line.is_empty()
+                || line.len() > MAX_BYTES
+                || line.iter().any(|&b| matches!(b, 0 | b'\n' | b'\r'))
+            {
+                return None;
+            }
+            std::str::from_utf8(line).ok().map(str::to_owned)
+        });
+    hbb_common::sodiumoxide::utils::memzero(&mut input);
+    password
+}
