+        assert!(scope.prepare_directory(&download).is_err());
+    }
+
+    #[test]
+    fn revoke_grant_keeps_only_logs() {
+        let mut dev = Device::new();
+        let s = &mut dev.1;
+        assert_eq!(s.default_dir(), Some(s.storage.join("Download")));
+        s.authorized = false;
+        assert!(!s.allows(&s.storage.join("DCIM/image")));
+        assert_eq!(s.default_dir(), Some(s.logs.clone()));
+        s.logs = PathBuf::new();
