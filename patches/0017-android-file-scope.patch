+//! Device-side allowlist. The two anchors come from Android and the local logger.
+use std::path::{Component, Path, PathBuf};
+
+pub const DENIED: &str = "This location is not allowed";
+pub const PUBLIC: [(&str, &str); 4] = [
+    ("download", "Download"),
+    ("pictures", "Pictures"),
+    ("dcim", "DCIM"),
+    ("movies", "Movies"),
+];
+
+pub struct Scope {
+    pub storage: PathBuf,
+    pub authorized: bool,
+    pub home: PathBuf,
+    pub logs: PathBuf,
+}
+
+// Resolve every existing component, including symlinks, in filesystem order.
+// Only a genuinely missing tail may be created. In particular a dangling link
+// is present according to symlink_metadata and must fail canonicalization.
+fn within(anchor: &Path, root: &Path, path: &Path) -> bool {
+    if !anchor.is_absolute() || anchor.parent().is_none() {
+        return false;
+    }
+    let Ok(subdir) = root.strip_prefix(anchor) else {
+        return false;
+    };
+    let Ok(tail) = path.strip_prefix(root) else {
+        return false;
+    };
+    if subdir.as_os_str().is_empty() {
+        return false;
+    }
+    let Ok(mut real) = anchor.canonicalize() else {
+        return false;
+    };
+    let mut missing = false;
+    let mut followed_link = false;
+    let mut descend = |at: &mut PathBuf, part: &std::ffi::OsStr| -> Option<bool> {
+        at.push(part);
+        if !missing {
+            match at.symlink_metadata() {
+                Ok(meta) if meta.is_symlink() => {
+                    *at = at.canonicalize().ok()?;
+                    return Some(true);
+                }
+                Ok(_) => (),
+                Err(err) if err.kind() == std::io::ErrorKind::NotFound => missing = true,
+                Err(_) => return None,
+            }
+        }
+        Some(false)
+    };
+    // A symlink replacing a configured allowlist root cannot redefine it.
+    for component in subdir.components() {
+        let Component::Normal(part) = component else {
+            return false;
+        };
+        if descend(&mut real, part) != Some(false) {
+            return false;
+        }
+    }
+    let expected = real.clone();
+    for component in tail.components() {
+        match component {
+            Component::Normal(part) => {
+                let Some(link) = descend(&mut real, part) else {
+                    return false;
+                };
+                followed_link |= link;
+            }
+            // A replaced link or missing intermediate must not change the meaning of "..".
+            Component::ParentDir if !followed_link && real.is_dir() => {
+                real.pop();
+            }
+            Component::CurDir => (),
+            _ => return false,
+        }
+        if !real.starts_with(&expected) {
+            return false;
+        }
+    }
+    true
+}
+
+impl Scope {
+    pub fn allows(&self, path: &Path) -> bool {
+        if !path.is_absolute() {
+            return false;
+        }
+        // Filter by the lexical root first. Operations such as unlink act on
+        // the link itself, even when it resolves to a permitted file.
+        (path.starts_with(&self.logs) && within(&self.home, &self.logs, path))
+            || (self.authorized
+                && PUBLIC.iter().any(|(_, name)| {
+                    let root = self.storage.join(name);
+                    path.starts_with(&root) && within(&self.storage, &root, path)
+                }))
+    }
+
+    pub fn rename_allowed(&self, source: &Path, name: &str) -> bool {
+        let mut parts = Path::new(name).components();
+        matches!(parts.next(), Some(Component::Normal(n)) if n == name)
+            && parts.next().is_none()
+            && self.allows(source)
+            && source.parent().is_some_and(|p| self.allows(&p.join(name)))
+    }
+
+    // Some Android images create the public media directories lazily. Only
+    // initialize an advertised root, never arbitrary paths from a read request.
+    pub fn prepare_directory(&self, path: &Path) -> std::io::Result<()> {
+        if !self.allows(path) {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                DENIED,
+            ));
+        }
+        if path == self.logs || PUBLIC.iter().any(|(_, dir)| path == self.storage.join(dir)) {
+            std::fs::create_dir_all(path)?;
+        }
+        Ok(())
+    }
+
+    pub fn default_dir(&self) -> Option<PathBuf> {
+        [self.storage.join("Download"), self.logs.clone()]
+            .into_iter()
+            .find(|p| self.allows(p))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        fs,
+        os::unix::fs::symlink,
+        sync::atomic::{AtomicUsize, Ordering},
+    };
+    struct Device(PathBuf, Scope);
+    impl Device {
+        fn new() -> Self {
+            static NEXT: AtomicUsize = AtomicUsize::new(0);
+            let temp = std::env::temp_dir().join(format!(
+                "sd-scope-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir(&temp).unwrap();
+            let storage = temp.join("emulated/12");
+            let home = storage.join("Android/data/test.app/files");
+            let logs = home.join("test/Logs");
+            fs::create_dir_all(&logs).unwrap();
+            for (_, dir) in PUBLIC {
+                fs::create_dir_all(storage.join(dir)).unwrap();
+            }
+            Self(
+                temp,
+                Scope {
+                    storage,
+                    home,
+                    logs,
+                    authorized: true,
+                },
+            )
+        }
+    }
+    impl Drop for Device {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    #[test]
+    fn exact_roots_and_non_owner_user() {
+        let dev = Device::new();
+        let s = &dev.1;
+        for (_, dir) in PUBLIC {
+            assert!(s.allows(&s.storage.join(dir).join("new/sub/file")));
+        }
+        for name in [
+            "",
+            "Download2/file",
+            "Android/data",
+            "Android/data/another/files",
+            "../0/Download",
+        ] {
+            assert!(!s.allows(&s.storage.join(name)));
+        }
+        assert!(!s.allows(Path::new("/system")));
+        assert!(!s.allows(Path::new("Download/file")));
+        assert!(!s.allows(&s.home));
+        assert!(s.allows(&s.logs.join("today.log")));
+    }
+    #[test]
+    fn normalize_before_membership() {
+        let dev = Device::new();
+        let s = &dev.1;
+        fs::create_dir(s.storage.join("Download/sub")).unwrap();
+        assert!(s.allows(&s.storage.join("Download/sub//./../out")));
+        assert!(!s.allows(&s.storage.join("Download/../Android/data")));
+        assert!(!s.allows(&s.storage.join("Download/missing/../../outside")));
+    }
+    #[test]
+    fn symlinks_missing_tails_and_sidecars() {
+        let dev = Device::new();
+        let s = &dev.1;
+        let dl = s.storage.join("Download");
+        symlink(&s.home, dl.join("escape")).unwrap();
+        symlink(s.home.join("missing"), dl.join("dangling")).unwrap();
+        symlink(s.home.join("private"), dl.join("job.download")).unwrap();
+        symlink(&s.home, dl.join("job.digest")).unwrap();
+        for name in [
+            "escape",
+            "escape/sub",
+            "escape/../file",
+            "dangling",
+            "dangling/new",
+            "job.download",
+            "job.digest",
+        ] {
+            assert!(!s.allows(&dl.join(name)), "{name}");
+        }
+        symlink(&dl, s.home.join("back")).unwrap();
+        assert!(!s.allows(&s.home.join("back/file")));
+        fs::remove_dir(s.storage.join("Pictures")).unwrap();
+        symlink(&s.home, s.storage.join("Pictures")).unwrap();
+        assert!(!s.allows(&s.storage.join("Pictures/private")));
+    }
+    #[test]
+    fn parent_after_symlink_cannot_change_meaning_on_replacement() {
+        let dev = Device::new();
+        let scope = &dev.1;
+        let root = scope.storage.join("Download");
+        fs::create_dir_all(root.join("one/two")).unwrap();
+        symlink(root.join("one/two"), root.join("alias")).unwrap();
+        assert!(scope.allows(&root.join("alias/inside")));
+        assert!(!scope.allows(&root.join("alias/../../secret")));
+    }
+
+    #[test]
+    fn rename_checks_both_endpoints() {
+        let dev = Device::new();
+        let s = &dev.1;
+        let dl = s.storage.join("Download");
+        symlink(&s.home, dl.join("outside")).unwrap();
+        assert!(s.rename_allowed(&dl.join("old"), "new"));
+        for name in ["../Android/data", "/system", "outside", "", ".", ".."] {
+            assert!(!s.rename_allowed(&dl.join("old"), name));
+        }
+        assert!(!s.rename_allowed(&dl.join("outside"), "new"));
+    }
+    #[test]
+    fn fresh_device_can_open_download_without_creating_arbitrary_directories() {
+        let mut dev = Device::new();
+        let scope = &mut dev.1;
+        let download = scope.storage.join("Download");
+        fs::remove_dir(&download).unwrap();
+        assert_eq!(scope.default_dir().as_ref(), Some(&download));
+        scope.prepare_directory(&download).unwrap();
+        assert!(download.is_dir());
+        let unknown = download.join("missing");
+        scope.prepare_directory(&unknown).unwrap();
+        assert!(!unknown.exists());
