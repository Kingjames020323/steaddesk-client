+import 'dart:convert';
+
+/// Locations advertised by a merchant Android peer for this connection.
+class RemoteFileScope {
+  final bool authorized;
+  final Map<String, String> locations;
+
+  RemoteFileScope._(this.authorized, this.locations);
+
+  static RemoteFileScope? fromPeerAdditions(Object? encoded) {
+    if (encoded is! String || encoded.isEmpty) return null;
+    try {
+      final additions = jsonDecode(encoded);
+      if (additions is! Map) return null;
+      final scope = additions['steaddesk_file_scope'];
+      if (scope is! Map) return null;
+      final locations = <String, String>{};
+      for (final key in ['download', 'pictures', 'dcim', 'movies', 'logs']) {
+        final path = scope[key];
+        locations[key] = path is String && path.startsWith('/') ? path : '';
+      }
+      return RemoteFileScope._(scope['authorized'] == true, locations);
+    } on FormatException {
+      return null;
+    }
+  }
+
+  bool requiresGrant(String key) => key != 'logs' && !authorized;
+
+  String? availablePath(String key) {
+    final path = locations[key];
+    return requiresGrant(key) || path == null || path.isEmpty ? null : path;
+  }
+
+  String? get initialDirectory =>
+      availablePath('download') ?? availablePath('logs');
+}
