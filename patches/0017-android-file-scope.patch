+//! Coordinate namespace changes across the Android connection and CM threads.
+//! Ordinary peer operations may overlap. Renames and removals can replace a
+//! subtree or unlink a symlink, so exclude them during path checks and I/O
+//! in every peer session.
+use hbb_common::tokio::sync::RwLock;
+
+pub static PEER_IO: RwLock<()> = RwLock::const_new(());
