+  test(
+      'KB UTF-8 response budget accepts three full cards; old routes keep their limit',
+      () async {
+    final three = [
+      for (var i = 0; i < 3; i++)
+        {
+          ...offer,
+          'locales': {
+            for (final l in locales.keys)
+              l: {'title': '台' * 120, 'steps': List.filled(12, '台' * 400)}
+          }
+        }
+    ];
+    final data = utf8.encode(jsonEncode({'cards': three}));
+    expect(data.length, inInclusiveRange(65537, 256 * 1024));
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    addTearDown(() => server.close(force: true));
+    server.listen((req) async {
+      req.response.headers.contentType = ContentType.json;
+      req.response.add(data);
+      await req.response.close();
+    });
+    await HttpOverrides.runWithHttpOverrides(() async {
+      final origin = Uri.parse('http://127.0.0.1:${server.port}');
+      expect(
+          (await sendHelp(origin, 'GET', 'me/kb-cards', 'fixture', null, null,
+              null))['cards'],
+          three);
+      await expectLater(
+          sendHelp(origin, 'GET', 'me/step-cards', 'fixture', null, null, null),
+          throwsA(isA<HelpFailure>()));
+    }, _LocalNetwork());
+  });
