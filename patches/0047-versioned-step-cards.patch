@@ -0,0 +1,119 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+import '../../common.dart' show gFFI;
+import '../../models/platform_model.dart' show bind;
+import '../support_help.dart';
+import 'admin_panel.dart';
+
+class KbAdminHost extends StatelessWidget {
+  const KbAdminHost({super.key});
+  @override
+  Widget build(BuildContext context) => Obx(() {
+        final account = gFFI.userModel.userName.value;
+        if (account.isEmpty) return const SizedBox.shrink();
+        return _BoundAdmin(key: ValueKey(account), account: account);
+      });
+}
+
+class _BoundAdmin extends StatefulWidget {
+  final String account;
+  const _BoundAdmin({super.key, required this.account});
+  @override
+  State<_BoundAdmin> createState() => _BoundAdminState();
+}
+
+class _BoundAdminState extends State<_BoundAdmin> {
+  SupportHelpApi? api;
+  Uri? origin;
+  String? token;
+  Timer? timer;
+  bool allowed = false, checking = false;
+  Route<void>? opened;
+
+  bool current() =>
+      mounted &&
+      gFFI.userModel.userName.value == widget.account &&
+      token == bind.mainGetLocalOption(key: 'access_token') &&
+      origin == Uri.tryParse(bind.mainGetOptionSync(key: 'api-server'));
+
+  @override
+  void initState() {
+    super.initState();
+    scheduleMicrotask(check);
+    timer = Timer.periodic(const Duration(seconds: 12), (_) => check());
+  }
+
+  void revoke() {
+    allowed = false;
+    final route = opened;
+    opened = null;
+    if (route != null && route.isActive) route.navigator?.removeRoute(route);
+  }
+
+  Future<void> check() async {
+    if (!mounted || checking) return;
+    checking = true;
+    try {
+      if (api == null || !current()) {
+        revoke();
+        api?.dispose();
+        api = null;
+        token = bind.mainGetLocalOption(key: 'access_token');
+        origin = Uri.tryParse(bind.mainGetOptionSync(key: 'api-server'));
+        if (token!.isEmpty || origin?.scheme != 'https') return;
+        final expectedOrigin = origin, expectedToken = token;
+        api = SupportHelpApi(
+            origin!,
+            widget.account,
+            token!,
+            () =>
+                current() &&
+                origin == expectedOrigin &&
+                token == expectedToken);
+      }
+      final active = api!;
+      final access = await active.kb('GET', 'access');
+      if (access['manage'] != true) {
+        revoke();
+        return;
+      }
+      if (mounted && active == api && current()) allowed = true;
+    } catch (_) {
+      revoke();
+    } finally {
+      checking = false;
+      if (mounted) setState(() {});
+    }
+  }
+
+  Future<void> open() async {
+    final active = api;
+    if (!allowed || opened != null || active == null || !current()) return;
+    final route = DialogRoute<void>(
+        context: context,
+        builder: (_) => Dialog(
+            child: KbAdminPanel(
+                call: active.kb,
+                current: () => mounted && allowed && active == api && current(),
+                denied: () {
+                  if (mounted) setState(revoke);
+                })));
+    opened = route;
+    await Navigator.of(context, rootNavigator: true).push(route);
+    if (identical(opened, route)) opened = null;
+  }
+
+  @override
+  void dispose() {
+    timer?.cancel();
+    revoke();
+    api?.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => allowed && current()
+      ? TextButton(onPressed: open, child: const Text('步骤卡'))
+      : const SizedBox.shrink();
+}
