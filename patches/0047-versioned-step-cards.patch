@@ -0,0 +1,551 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:math' as math;
+import 'package:flutter/material.dart';
+import 'package:uuid/uuid.dart';
+import '../help/merchant_help_widget.dart' show HelpWaiting;
+import '../support_help.dart' show HelpRow, HelpStaffError, helpReasons;
+
+typedef KbCall = Future<HelpRow> Function(String method, String route,
+    {HelpRow? body, int? version, String? key, Map<String, String>? query});
+const _languages = {'zh': '中文', 'en': 'English', 'es': 'Español'};
+const _states = {'draft': '草稿', 'published': '已发布', 'withdrawn': '已下架'};
+final _codes = [
+  'unreachable',
+  'timeout',
+  for (final kind in ['printer', 'host', 'secondary', 'payment', 'other'])
+    for (final outcome in ['unreachable', 'timeout']) '${kind}_$outcome'
+];
+
+class KbAdminPanel extends StatefulWidget {
+  final KbCall call;
+  final bool Function() current;
+  final VoidCallback denied;
+  const KbAdminPanel(
+      {super.key,
+      required this.call,
+      required this.current,
+      required this.denied});
+  @override
+  State<KbAdminPanel> createState() => _KbAdminPanelState();
+}
+
+class _KbAdminPanelState extends State<KbAdminPanel> {
+  final titles = {
+    for (final lang in _languages.keys) lang: TextEditingController()
+  };
+  final steps = {
+    for (final lang in _languages.keys)
+      lang: List.generate(12, (_) => TextEditingController())
+  };
+  final stepCount = {for (final lang in _languages.keys) lang: 1};
+  final reason = TextEditingController();
+  Set<String> categories = {}, codes = {};
+  List<HelpRow> cards = [], history = [];
+  HelpRow? selected, historical;
+  String? nextCard;
+  int? nextVersion;
+  String language = 'zh', original = '', message = '';
+  String? lastWrite, writeKey;
+  bool busy = true, loaded = false, preview = false;
+
+  @override
+  void initState() {
+    super.initState();
+    scheduleMicrotask(() async {
+      busy = false;
+      await run(() async {
+        await list();
+        if (!alive) return;
+        if (cards.isNotEmpty) {
+          await detail(cards.first['id']);
+        } else {
+          load(null);
+        }
+        loaded = true;
+      });
+    });
+  }
+
+  @override
+  void dispose() {
+    for (final c in [
+      ...titles.values,
+      ...steps.values.expand((items) => items),
+      reason
+    ]) {
+      c.dispose();
+    }
+    super.dispose();
+  }
+
+  bool get alive => mounted && widget.current();
+  List<String> lines(String lang) => [
+        for (final field in steps[lang]!.take(stepCount[lang]!))
+          if (field.text.trim().isNotEmpty) field.text.trim()
+      ];
+  void removeStep(int index) {
+    final fields = steps[language]!;
+    final count = stepCount[language]!;
+    for (var i = index; i < count - 1; i++) {
+      fields[i].text = fields[i + 1].text;
+    }
+    fields[count - 1].clear();
+    setState(() => stepCount[language] = math.max(1, count - 1));
+  }
+
+  HelpRow edit() => {
+        'locales': {
+          for (final lang in _languages.keys)
+            lang: {'title': titles[lang]!.text.trim(), 'steps': lines(lang)}
+        },
+        'reasons': [
+          for (final key in helpReasons.keys)
+            if (categories.contains(key)) key
+        ],
+        'check_codes': [
+          for (final key in _codes)
+            if (codes.contains(key)) key
+        ],
+      };
+  bool get valid =>
+      categories.isNotEmpty &&
+      _languages.keys.every((lang) =>
+          titles[lang]!.text.trim().runes.length <= 120 &&
+          lines(lang).length <= 12 &&
+          lines(lang).every((s) => s.runes.length <= 400));
+  bool get complete =>
+      valid &&
+      _languages.keys.every((lang) =>
+          titles[lang]!.text.trim().isNotEmpty && lines(lang).isNotEmpty);
+
+  Future<void> run(Future<void> Function() work) async {
+    if (busy || !alive) return;
+    setState(() {
+      busy = true;
+      message = '';
+    });
+    try {
+      await work();
+    } catch (e) {
+      if (!mounted) return;
+      if (!widget.current() ||
+          e is HelpStaffError && (e.status == 401 || e.status == 403)) {
+        widget.denied();
+        return;
+      }
+      message = e is HelpStaffError && (e.status == 409 || e.status == 412)
+          ? '服务端版本已变化。请重新载入后审核。'
+          : e is HelpStaffError && (e.status == 400 || e.status == 422)
+              ? '请核对步骤、三种语言及审核原因。'
+              : '无法确认操作结果，请重试。';
+    } finally {
+      if (mounted) setState(() => busy = false);
+    }
+  }
+
+  Future<void> list({bool more = false}) async {
+    final cursor = more ? nextCard : null;
+    final result = await widget.call('GET', 'cards',
+        query: cursor == null ? null : {'after': cursor});
+    if (!alive) return;
+    final next = result['next'] as String?;
+    if (next != null && cursor != null && next.compareTo(cursor) <= 0) {
+      throw const HelpStaffError(500);
+    }
+    final rows = List<HelpRow>.from(result['cards']);
+    final distinct = <String, HelpRow>{
+      if (more)
+        for (final r in cards) r['id']: r,
+      for (final r in rows) r['id']: r
+    };
+    if (selected != null) {
+      distinct.putIfAbsent(selected!['id'], () => selected!);
+    }
+    cards = distinct.values.toList();
+    nextCard = next;
+  }
+
+  Future<void> detail(String id, {bool more = false}) async {
+    final cursor = more ? nextVersion : null;
+    final result = await widget.call('GET', 'cards/$id',
+        query: cursor == null ? null : {'before': '$cursor'});
+    if (!alive) return;
+    final next = result['next'] as int?;
+    if (next != null && cursor != null && next >= cursor) {
+      throw const HelpStaffError(500);
+    }
+    if (!more) load(result['card']);
+    history = [if (more) ...history, ...List<HelpRow>.from(result['history'])];
+    nextVersion = next;
+  }
+
+  void load(HelpRow? card) {
+    selected = card;
+    for (final lang in _languages.keys) {
+      final copy = card?['locales']?[lang];
+      titles[lang]!.text = copy?['title'] ?? '';
+      final items = List<String>.from(copy?['steps'] ?? []);
+      if (items.length > 12) throw const HelpStaffError(500);
+      stepCount[lang] = math.max(1, items.length);
+      for (var i = 0; i < 12; i++) {
+        steps[lang]![i].text = i < items.length ? items[i] : '';
+      }
+    }
+    categories = Set<String>.from(card?['reasons'] ?? []);
+    codes = Set<String>.from(card?['check_codes'] ?? []);
+    history = [];
+    nextVersion = null;
+    original = jsonEncode(edit());
+    reason.clear();
+    historical = null;
+    preview = false;
+    lastWrite = writeKey = null;
+  }
+
+  Future<void> write(String operation) => run(() async {
+        final id = selected?['id'];
+        final version = selected?['version'] as int?;
+        final drafting = operation == 'draft';
+        final data = drafting ? edit() : {'reason': reason.text.trim()};
+        final method = drafting && id != null ? 'PUT' : 'POST';
+        final path = id == null
+            ? 'cards'
+            : drafting
+                ? 'cards/$id'
+                : 'cards/$id/$operation';
+        final fingerprint = jsonEncode([method, path, version, data]);
+        if (fingerprint != lastWrite) {
+          lastWrite = fingerprint;
+          writeKey = const Uuid().v4();
+        }
+        final card = await widget.call(method, path,
+            version: version, body: data, key: writeKey);
+        if (!alive) return;
+        load(card);
+        cards = [...cards.where((row) => row['id'] != card['id']), card];
+        await detail(card['id']);
+      });
+  void change() => setState(() {});
+  @override
+  Widget build(BuildContext context) {
+    if (!widget.current()) return const SizedBox.shrink();
+    final dirty = jsonEncode(edit()) != original;
+    final ready = loaded && !busy;
+    final selectedId = selected?['id'];
+    final stats = selected?['stats'];
+    final rate = stats?['rate_30d'];
+    final review = selectedId != null &&
+        !dirty &&
+        ready &&
+        reason.text.trim().isNotEmpty &&
+        reason.text.trim().runes.length <= 240;
+    return ConstrainedBox(
+        constraints: const BoxConstraints(maxWidth: 1040, maxHeight: 800),
+        child:
+            Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+          Padding(
+              padding: const EdgeInsets.fromLTRB(16, 8, 8, 0),
+              child: Row(children: [
+                Expanded(
+                    child: Text('步骤卡',
+                        style: Theme.of(context).textTheme.titleLarge)),
+                IconButton(
