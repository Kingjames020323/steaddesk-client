+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:visibility_detector/visibility_detector.dart';
+
+String cardLanguage(String value) {
+  final language = value.trim().toLowerCase().split(RegExp('[-_]')).first;
+  return const {'zh', 'es'}.contains(language) ? language : 'en';
+}
+
+class StepCardTile extends StatefulWidget {
+  final String title;
+  final List<String> steps;
+  final String Function(String) label;
+  final Future<void> Function(bool expanded)? acknowledge;
+  final VoidCallback? solve;
+  final bool online;
+  const StepCardTile(
+      {super.key,
+      required this.title,
+      required this.steps,
+      required this.label,
+      this.acknowledge,
+      this.solve,
+      this.online = true});
+
+  @override
+  State<StepCardTile> createState() => _StepCardTileState();
+}
+
+class _StepCardTileState extends State<StepCardTile>
+    with WidgetsBindingObserver {
+  final visibility = UniqueKey();
+  bool currentRoute = true;
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    final next = ModalRoute.of(context)?.isCurrent ?? true;
+    if (next && !currentRoute) {
+      WidgetsBinding.instance.addPostFrameCallback((_) {
+        if (mounted) unawaited(confirm());
+      });
+    }
+    currentRoute = next;
+  }
+
+  bool visible = false, shown = false, expanded = false, used = false;
+  bool sending = false, failed = false;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) unawaited(confirm());
+  }
+
+  @override
+  void didUpdateWidget(covariant StepCardTile old) {
+    super.didUpdateWidget(old);
+    if (widget.online && !old.online) {
+      WidgetsBinding.instance.addPostFrameCallback((_) {
+        if (mounted) unawaited(confirm());
+      });
+    }
+  }
+
+  bool get onScreen =>
+      mounted &&
+      visible &&
+      widget.online &&
+      currentRoute &&
+      (WidgetsBinding.instance.lifecycleState == null ||
+          WidgetsBinding.instance.lifecycleState == AppLifecycleState.resumed);
+
+  Future<void> confirm() async {
+    final report = widget.acknowledge;
+    if (!onScreen ||
+        sending ||
+        report == null ||
+        (shown && (!expanded || used))) return;
+    sending = true;
+    try {
+      if (!shown) {
+        await report(false);
+        if (!mounted) return;
+        shown = true;
+      }
+      if (onScreen && expanded && !used) {
+        await report(true);
+        if (!mounted) return;
+        used = true;
+      }
+      failed = false;
+    } catch (_) {
+      failed = true;
+    } finally {
+      sending = false;
+      if (mounted) setState(() {});
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final content = Card(
+        child: ExpansionTile(
+            title: Text(widget.title),
+            onExpansionChanged: (value) {
+              setState(() => expanded = value);
+              if (value) unawaited(confirm());
+            },
+            childrenPadding: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+            expandedCrossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+          for (var i = 0; i < widget.steps.length; i++)
+            Padding(
+                padding: const EdgeInsets.only(bottom: 6),
+                child: Text('${i + 1}. ${widget.steps[i]}')),
+          if (failed)
+            TextButton(
+                onPressed: widget.online ? confirm : null,
+                child: Text(widget.label('Confirm card display'))),
+          OutlinedButton(
+              onPressed: widget.online && shown ? widget.solve : null,
+              child: Text(widget.label('This solved my problem'))),
+        ]));
+    if (widget.acknowledge == null) return content;
+    return VisibilityDetector(
+        key: visibility,
+        onVisibilityChanged: (info) {
+          visible = info.visibleFraction > 0;
+          if (visible) unawaited(confirm());
+        },
+        child: content);
+  }
+}
