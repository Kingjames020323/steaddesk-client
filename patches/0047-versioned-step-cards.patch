+  test(
+      'restored receipt selects legacy when KB is off or missing; KB confirmations remain ticket-bound',
+      () async {
+    final dir = await Directory.systemTemp.createTemp('kb-receipt-fixture');
+    addTearDown(() => dir.delete(recursive: true));
+    final owner = (
+      origin: Uri.https('example.invalid'),
+      device: '123456789',
+      account: 'fixture'
+    );
+    for (final enabled in [false, true]) {
+      var advertised = false, calls = <String>[];
+      Future<HelpJson> send(Uri origin, String method, String path,
+          String? secret, HelpJson? body, String? key, int? version) async {
+        calls.add(path);
+        if (path == 'capabilities') return {'kb': advertised};
+        expect(secret, 'synthetic-receipt');
+        if (path == 'me') return Map<String, dynamic>.from(ticket);
+        if (path == 'me/step-cards') {
+          return {
+            'cards': [
+              {
+                'card_id': 'old',
+                'card_version': 1,
+                'steps': ['Old card']
+              }
+            ]
+          };
+        }
+        if (path == 'me/kb-cards') {
+          if (!advertised) throw HelpFailure(404);
+          return {
+            'cards': [offer]
+          };
+        }
+        expect(body, {
+          'card_id': 'fixture',
+          'card_version': 2,
+          'offer_id': 'display-fixture'
+        });
+        return {'accepted': true};
+      }
+
+      final c = MerchantHelpClient(
+          File('${dir.path}/journal'),
+          () async => owner,
+          (_, __, ___, ____) => throw StateError('unexpected signing'),
+          '1',
+          send: send,
+          useKb: enabled);
+      c.record = {'owner': c.fingerprint(owner), 'secret': 'synthetic-receipt'};
+      await c.refresh();
+      expect(c.cards.single['card_id'], 'old');
+      expect(calls.contains('me/kb-cards'), enabled);
+      advertised = true;
+      calls.clear();
+      await c.capabilities();
+      await c.refresh();
+      if (enabled) {
+        expect(c.cards.single['card_id'], 'fixture');
+        await expectLater(
+            c.confirmCard('different-ticket', c.cards.single, false),
+            throwsA(isA<HelpFailure>()));
+        await c.confirmCard('test-ticket', c.cards.single, false);
+        await c.confirmCard('test-ticket', c.cards.single, true);
+        expect(calls.where((r) => r == 'me/kb-shown').length, 1);
+        expect(calls.last, 'me/kb-used');
+      } else {
+        expect(c.cards.single['card_id'], 'old');
+        expect(calls.contains('me/kb-cards'), isFalse);
+      }
+    }
+  });
