diff --git a/flutter/test/steaddesk/case_dialog_test.dart b/flutter/test/steaddesk/case_dialog_test.dart
new file mode 100644
index 0000000..93b26b6
--- /dev/null
+++ b/flutter/test/steaddesk/case_dialog_test.dart
@@ -0,0 +1,153 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../../lib/steaddesk/cases/case_dialog.dart';
+import '../../lib/steaddesk/cases/case_store.dart';
+
+class _Store extends Fake implements CaseStore {
+  bool expired = false;
+  Map<String, dynamic>? submitted;
+  String? deferred;
+
+  @override
+  Future<bool> isAppendOnly(String account, String id) async => expired;
+
+  @override
+  Future<void> save(String account, String id,
+      {String? category,
+      String? result,
+      Map<String, dynamic>? followUp,
+      String? transferredTo,
+      required String note,
+      bool? expectedAppendOnly}) async {
+    if (expired && expectedAppendOnly == false)
+      throw const CaseEditWindowExpired();
+    submitted = {
+      'category': category,
+      'result': result,
+      'follow_up': followUp,
+      'transferred_to': transferredTo,
+      'note': note
+    };
+  }
+
+  @override
+  Future<void> defer(String account, String id,
+      {required String note, bool? expectedAppendOnly}) async {
+    deferred = note;
+  }
+}
+
+Future<void> _open(WidgetTester t, _Store store,
+    {List<String> colleagues = const []}) async {
+  await t.binding.setSurfaceSize(const Size(1280, 800));
+  addTearDown(() => t.binding.setSurfaceSize(null));
+  await t.pumpWidget(MaterialApp(
+      home: Builder(
+          builder: (context) => Scaffold(
+              body: TextButton(
+                  onPressed: () => showCaseCloseDialog(context,
+                          store: store,
+                          account: 'test-agent',
+                          colleagues: colleagues,
+                          record: {
+                            'id': 'test-case',
+                            'display_name': '示例门店 · 测试设备',
+                            'note': '原始随手记',
+                            'status': 'draft',
+                            'started_at': '2026-01-01T09:00:00Z',
+                            'ended_at': '2026-01-01T09:14:00Z',
+                            'auto': {'files': 0}
+                          }),
+                  child: const Text('open'))))));
+  await t.tap(find.text('open'));
+  await t.pumpAndSettle();
+}
+
+void main() {
+  testWidgets(
+      'number, Tab and Enter validate and close a case without using a pointer',
+      (t) async {
+    final store = _Store();
+    await _open(t, store);
+    await t.sendKeyEvent(LogicalKeyboardKey.enter);
+    await t.pumpAndSettle();
+    expect(find.text('请选择问题类型'), findsOneWidget);
+    expect(store.submitted, isNull);
+    await t.sendKeyEvent(LogicalKeyboardKey.digit3);
+    await t.pumpAndSettle();
+    await t.sendKeyEvent(LogicalKeyboardKey.tab);
+    await t.pumpAndSettle();
+    await t.sendKeyEvent(LogicalKeyboardKey.enter);
+    await t.pumpAndSettle();
+    expect(store.submitted, {
+      'category': 'printer',
+      'result': 'resolved',
+      'follow_up': null,
+      'transferred_to': null,
+      'note': '原始随手记'
+    });
+    expect(find.byType(Dialog), findsNothing);
+  });
+
+  testWidgets(
+      'conditional follow-up and transfer validate and only submit relevant fields',
+      (t) async {
+    final store = _Store();
+    await _open(t, store, colleagues: ['test-agent', 'test-peer']);
+    await t.tap(find.text('4 网络'));
+    await t.tap(find.text('未解决'));
+    await t.tap(find.text('保存（Enter）'));
+    await t.pumpAndSettle();
+    expect(find.text('请选择跟进日期'), findsOneWidget);
+    expect(find.text('test-agent'), findsOneWidget);
+    await t.tap(find.text('明天'));
+    await t.tap(find.text('转给同事…'));
+    await t.pumpAndSettle();
+    expect(find.text('跟进人'), findsNothing);
+    await t.tap(find.text('保存（Enter）'));
+    await t.pumpAndSettle();
+    expect(find.text('请选择或填写同事账号'), findsOneWidget);
+    await t.tap(find.byType(DropdownButtonFormField<String>));
+    await t.pumpAndSettle();
+    await t.tap(find.text('test-peer').last);
+    await t.pumpAndSettle();
+    await t.tap(find.text('+ 重新插网线'));
+    await t.tap(find.text('保存（Enter）'));
+    await t.pumpAndSettle();
+    expect(store.submitted, {
+      'category': 'network',
+      'result': 'transferred',
+      'follow_up': null,
+      'transferred_to': 'test-peer',
+      'note': '原始随手记\n重新插网线'
+    });
+  });
+
+  testWidgets(
+      'defer keeps edited notes; an expiry during editing requires confirming the addition',
+      (t) async {
+    final store = _Store();
+    await _open(t, store);
+    await t.tap(find.text('+ 重打订单'));
+    await t.tap(find.text('稍后补'));
+    await t.pumpAndSettle();
+    expect(store.deferred, '原始随手记\n重打订单');
+    expect(store.submitted, isNull);
+    await t.tap(find.text('open'));
+    await t.pumpAndSettle();
+    await t.tap(find.text('3 打印机'));
+    await t.tap(find.text('已解决'));
+    await t.tap(find.text('+ 换纸卷'));
+    store.expired = true;
+    await t.tap(find.text('保存（Enter）'));
+    await t.pumpAndSettle();
+    expect(find.text('已超过 24 小时，请确认要追加的说明后保存'), findsOneWidget);
+    expect(find.text('原始随手记'), findsOneWidget);
+    expect(store.submitted, isNull);
+    await t.tap(find.text('保存（Enter）'));
+    await t.pumpAndSettle();
+    expect(store.submitted?['note'], '\n换纸卷');
+  });
+}
diff --git a/flutter/test/steaddesk/case_inbox_test.dart b/flutter/test/steaddesk/case_inbox_test.dart
new file mode 100644
index 0000000..10f5d29
--- /dev/null
+++ b/flutter/test/steaddesk/case_inbox_test.dart
@@ -0,0 +1,102 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/cases/case_inbox.dart';
+import 'package:flutter_hbb/steaddesk/cases/case_store.dart';
+
+class _Store implements CaseStore {
+  final records = <String, CaseRecord>{};
+  @override
+  Future<bool> addDraft(String account, CaseRecord record) async {
+    if (records.containsKey(record['id'])) return false;
+    records[record['id']] = {...record, 'appends': [], 'note': ''};
+    return true;
+  }
+
+  @override
+  Future<List<CaseRecord>> pending(String account) async =>
+      records.values.where((r) => r['agent'] == account).toList();
+  @override
+  Future<bool> isAppendOnly(String account, String id) async => false;
+  @override
+  Future<void> defer(String account, String id,
+      {required String note, bool? expectedAppendOnly}) async {}
+  @override
+  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
+}
+
+CaseRecord _ended(String id, String account, {bool interrupted = false}) => {
+      'id': id,
+      'device_id': id,
+      'display_name': 'Demo $id',
+      'agent': account,
+      'started_at': '2026-11-13T12:00:00Z',
+      'ended_at': '2026-11-13T12:01:00Z',
+      'interrupted': interrupted,
+      'auto': <String, dynamic>{},
+    };
+
+void main() {
+  testWidgets(
+      'queues normal sessions, keeps disconnect quiet, suppresses duplicate IPC',
+      (t) async {
+    final inbox = CaseInbox(_Store());
+    var activations = 0;
+    await t.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: PendingCasesBar(
+      account: 'demo',
+      inbox: inbox,
+      colleagues: () => [],
+      showMainWindow: () async {
+        activations++;
+      },
+    ))));
+    await inbox.ended(_ended('net', 'demo', interrupted: true));
+    await t.pumpAndSettle();
+    expect(find.text('待补结案 1'), findsOneWidget);
+    expect(activations, 0);
+    await inbox.ended(_ended('one', 'demo'));
+    await inbox.ended(_ended('one', 'demo'));
+    await inbox.ended(_ended('two', 'demo'));
+    await t.pumpAndSettle();
+    expect(find.text('结案 · Demo one'), findsOneWidget);
+    expect(find.text('结案 · Demo two'), findsNothing);
+    await t.tap(find.text('稍后补'));
+    await t.pumpAndSettle();
+    expect(find.text('结案 · Demo two'), findsOneWidget);
+    await t.tap(find.text('稍后补'));
+    await t.pumpAndSettle();
+    expect(find.text('待补结案 3'), findsOneWidget);
+    expect(activations, 2);
+    await t.tap(find.text('待补结案 3'));
+    await t.pumpAndSettle();
+    await t.tap(find.text('Demo net'));
+    await t.pumpAndSettle();
+    expect(find.text('结案 · Demo net'), findsOneWidget);
+  });
+
+  testWidgets('account change removes the old account editor and drafts',
+      (t) async {
+    final inbox = CaseInbox(_Store());
+    Widget app(String account) => MaterialApp(
+            home: Scaffold(
+                body: PendingCasesBar(
+          account: account,
+          inbox: inbox,
+          colleagues: () => [],
+          showMainWindow: () async {},
+        )));
+    await t.pumpWidget(app('first'));
+    await inbox.ended(_ended('private', 'first'));
+    await t.pumpAndSettle();
+    expect(find.text('结案 · Demo private'), findsOneWidget);
+    await t.pumpWidget(app('second'));
+    await t.pumpAndSettle();
+    expect(find.textContaining('private'), findsNothing);
+    expect(find.text('待补结案 1'), findsNothing);
+    await t.pumpWidget(app('first'));
+    await t.pumpAndSettle();
+    expect(find.text('待补结案 1'), findsOneWidget);
+    expect(find.text('结案 · Demo private'), findsNothing);
+  });
+}
diff --git a/flutter/test/steaddesk/case_session_test.dart b/flutter/test/steaddesk/case_session_test.dart
new file mode 100644
index 0000000..cdbb57b
--- /dev/null
+++ b/flutter/test/steaddesk/case_session_test.dart
@@ -0,0 +1,141 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/steaddesk/cases/case_session_ledger.dart';
+
+void main() {
+  late String account;
+  late List<CaseData> writes;
+  late CaseSessionLedger ledger;
+  var sequence = 0;
+  setUp(() {
+    account = 'test-agent';
+    writes = [];
+    ledger = CaseSessionLedger((event) => account.isEmpty
+        ? null
+        : {
+            'agent': account,
+            'id': 'test-${sequence++}',
+            'device_id': event['connection']
+          });
+  });
+  final start = DateTime.utc(2026);
+  CaseData event(String kind, int seconds,
+          [String connection = 'test-device']) =>
+      {
+        'kind': kind,
+        'connection': connection,
+        'at': start.add(Duration(seconds: seconds)).toIso8601String(),
+        'event_id': '${sequence++}'
+      };
+  Future<bool> save(CaseData record) async {
+    writes.add(record);
+    return true;
+  }
+
+  Future<bool> emit(String kind, int seconds, [String id = 'test-device']) =>
+      ledger.receive(event(kind, seconds, id), save);
+
+  test('failed handshake, failed auth and a 29s session create no case',
+      () async {
+    await emit('interrupted', 2);
+    await emit('closed', 100);
+    await emit('established', 101);
+    await emit('closed', 130);
+    expect(writes, isEmpty);
+    expect(caseEndKind('re-input-password', 'Wrong Password', ''), isNull);
+    expect(caseEndKind('error', 'Login Error', 'Rejected'), isNull);
+  });
+  test(
+      'two monitor handshakes, moved tab and repeated last close yield one case at 30s',
+      () async {
+    await emit('established', 1);
+    account = 'new-agent';
+    await emit('established', 2);
+    await emit('closed', 31);
+    await emit('closed', 32);
+    expect(writes.single, containsPair('agent', 'test-agent'));
+    expect(writes.single['started_at'],
+        start.add(const Duration(seconds: 1)).toIso8601String());
+    expect(writes.single['interrupted'], isFalse);
+  });
+  test('interrupted transport retries, then reconnect starts a distinct case',
+      () async {
+    await emit('established', 0);
+    final firstHandshake = event('established', 1);
+    await ledger.receive(firstHandshake, save);
+    final loss = event('interrupted', 31);
+    await ledger.receive(loss, save);
+    await ledger.receive(
+        firstHandshake, save); // lost acknowledgement, late retry
+    await emit('established', 35);
+    await ledger.receive(loss, save); // delayed by another monitor
+    await emit('closed', 65);
+    expect(writes.map((r) => r['interrupted']), [true, false]);
+    expect(writes.map((r) => r['id']).toSet(), hasLength(2));
+  });
+  test('durable ack failure retries the same snapshot and UUID', () async {
+    await emit('established', 0);
+    final loss = event('interrupted', 30);
+    CaseData? attempted;
+    expect(
+        await ledger.receive(loss, (row) async {
+          attempted = row;
+          return false;
+        }),
+        isFalse);
+    await ledger.receive(loss, save);
+    await ledger.receive(loss, save);
+    expect(writes.single, attempted);
+  });
+  test('overlapping devices end independently; signed-out start stays unowned',
+      () async {
+    await emit('established', 0, 'one');
+    await emit('established', 0, 'two');
+    account = '';
+    await emit('established', 0, 'three');
+    account = 'new-agent';
+    await emit('established', 1, 'three');
+    await Future.wait([
+      emit('closed', 30, 'one'),
+      emit('interrupted', 30, 'two'),
+      emit('closed', 30, 'three')
+    ]);
+    expect(writes.map((r) => r['device_id']), ['one', 'two']);
+  });
+  test(
+      'orderly app shutdown drains eligible active and unacknowledged rounds as drafts',
+      () async {
+    await emit('established', 0, 'old');
+    final old = event('closed', 30, 'old');
+    CaseData? failed;
+    await ledger.receive(old, (record) async {
+      failed = record;
+      return false;
+    });
+    await emit('established', 10, 'active');
+    await emit('established', 29, 'young');
+    await ledger.shutdown(start.add(const Duration(seconds: 40)), save);
+    // Child teardown and an old unacknowledged retry may still reach main.
+    await ledger.receive(old, save);
+    await emit('closed', 41, 'active');
+    await ledger.shutdown(start.add(const Duration(seconds: 42)), save);
+    expect(writes.map((r) => r['device_id']), ['old', 'active']);
+    expect(writes.first['id'], failed!['id']);
+    expect(writes.every((r) => r['interrupted'] == true), isTrue);
+  });
+  test(
+      'core reason distinguishes remote stop, network loss and in-session messages',
+      () {
+    expect(
+        caseEndKind('error', 'Connection Error', 'Closed manually by the peer'),
+        'closed');
+    expect(caseEndKind('error', 'Connection Error', 'Reset by the peer'),
+        'interrupted');
+    expect(caseEndKind('error', 'Connection Error', 'Timeout'), 'interrupted');
+    expect(caseEndKind('relay-hint', 'Connection Error', 'os error 10054'),
+        'interrupted');
+    expect(caseEndKind('restarting-show', 'Connecting...', ''), 'interrupted');
+    expect(caseEndKind('restarting', 'Restarting remote device', ''), 'closed');
+    expect(caseEndKind('elevation-error', 'Elevation Error', ''), isNull);
+    expect(caseEndKind('custom-error', 'Privacy mode', 'Peer denied'), isNull);
+  });
+}
diff --git a/flutter/test/steaddesk/case_store_test.dart b/flutter/test/steaddesk/case_store_test.dart
new file mode 100644
index 0000000..0efc0e3
--- /dev/null
+++ b/flutter/test/steaddesk/case_store_test.dart
@@ -0,0 +1,175 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import '../../lib/steaddesk/cases/case_store.dart';
+
+void main() {
+  late Directory dir;
+  late File target;
+  late DateTime now;
+  late int resets;
+  late LocalCaseStore store;
+  LocalCaseStore open() => LocalCaseStore(
+      file: () async => target, clock: () => now, onCorrupt: () => resets++);
+
+  String id(int n) =>
+      '00000000-0000-4000-8000-${n.toString().padLeft(12, '0')}';
+  CaseRecord session(int n) => {
+        'id': id(n),
+        'device_id': 'demo-device-$n',
+        'display_name': 'Demo Station $n',
+        'started_at':
+            now.subtract(const Duration(minutes: 3)).toIso8601String(),
+        'ended_at': now.toIso8601String(),
+        'note': 'session note',
+      };
+  Future<List<dynamic>> rows(String account) async =>
+      jsonDecode(await target.readAsString())['accounts'][account] as List;
+  setUp(() async {
+    dir = await Directory.systemTemp.createTemp('sd-case-store-');
+    target = File('${dir.path}/$caseStoreFileName');
+    now = DateTime.utc(2026, 1, 1, 12);
+    resets = 0;
+    store = open();
+  });
+  tearDown(() => dir.delete(recursive: true));
+
+  test(
+      'overlapping writers across instances preserve isolated draft IDs and retries',
+      () async {
+    final jobs = [
+      for (var n = 0; n < 15; n++)
+        open().addDraft(n.isEven ? 'demo-a' : 'demo-b', session(n)),
+    ];
+    expect(await Future.wait(jobs), everyElement(isTrue));
+    expect(await open().addDraft('demo-a', session(0)), isFalse);
+    final pending = await open().pending('demo-a');
+    expect(pending, hasLength(8));
+    expect(await open().pending('demo-b'), hasLength(7));
+    final row = pending.singleWhere((r) => r['id'] == id(0));
+    expect(row, containsPair('display_name', 'Demo Station 0'));
+    expect(row, containsPair('merchant_code', null));
+    expect(row, containsPair('category', null));
+    expect(row, containsPair('result', null));
+    expect(row, containsPair('status', 'draft'));
+    await expectLater(
+        store.append('demo-b', id(0), 'foreign note'), throwsStateError);
+    expect(await store.pending(''), isEmpty);
+  });
+
+  test(
+      'follow-up and transfer must be complete; a successful edit clears stale fields',
+      () async {
+    await store.addDraft('demo', session(1));
+    Future<void> save(String? category, String? result,
+            {Map<String, dynamic>? follow, String? to}) =>
+        store.save('demo', id(1),
+            category: category,
+            result: result,
+            followUp: follow,
+            transferredTo: to,
+            note: 'revised');
+    await expectLater(save(null, null), throwsFormatException);
+    await expectLater(save('other', 'unresolved'), throwsFormatException);
+    await expectLater(
+        save('other', 'onsite', follow: {'owner': 'demo', 'due': '2026-02-30'}),
+        throwsFormatException);
+    await expectLater(
+        save('other', 'transferred', to: ' '), throwsFormatException);
+    expect((await store.pending('demo')).single['note'], 'session note');
+    const follow = {'owner': 'demo', 'due': '2026-01-02'};
+    await save('network', 'unresolved', follow: follow);
+    expect((await rows('demo')).single['follow_up'], follow);
+    await save('printer', 'transferred', to: 'other-demo');
+    final row = (await rows('demo')).single;
+    expect(row['follow_up'], isNull);
+    expect(row['transferred_to'], 'other-demo');
+    expect(row['note'], 'revised');
+    expect(await store.pending('demo'), isEmpty);
+    expect(await open().addDraft('demo', session(1)), isFalse);
+  });
+
+  test(
+      'store rechecks the 24-hour boundary and only appends to the original note',
+      () async {
+    await store.addDraft('demo', session(2));
+    now = now.add(const Duration(hours: 24));
+    expect(await store.isAppendOnly('demo', id(2)), isFalse);
+    await store.defer('demo', id(2),
+        note: 'original', expectedAppendOnly: false);
+    now = now.add(const Duration(microseconds: 1));
+    expect(await store.isAppendOnly('demo', id(2)), isTrue);
+    await expectLater(
+        store.save('demo', id(2),
+            category: 'printer',
+            result: 'resolved',
+            note: 'stale replacement',
+            expectedAppendOnly: false),
+        throwsA(isA<CaseEditWindowExpired>()));
+    expect((await store.pending('demo')).single['note'], 'original');
+    await store.defer('demo', id(2),
+        note: 'next shift', expectedAppendOnly: true);
+    await store.save('demo', id(2),
+        category: 'printer',
+        result: 'resolved',
+        note: 'verified',
+        expectedAppendOnly: true);
+    await expectLater(
+        store.save('demo', id(2),
+            category: 'menu', result: 'not_needed', note: 'rewrite'),
+        throwsStateError);
+    await store.append('demo', id(2), 'customer confirmed');
+    final row = (await rows('demo')).single;
+    expect(row['note'], 'original');
+    expect(row['category'], 'printer');
+    expect(row['appends'], [
+      for (final text in ['next shift', 'verified', 'customer confirmed'])
+        {'at': now.toIso8601String(), 'by': 'demo', 'text': text}
+    ]);
+    expect(await open().pending('demo'), isEmpty);
+  });
+
+  test('corrupt bytes backed up and one reader reports the reset', () async {
+    const broken = [0xff, 0xfe];
+    await target.writeAsBytes(broken);
+    await Future.wait([open().pending('demo'), open().pending('demo')]);
+    expect(resets, 1);
+    final backups =
+        await dir.list().where((f) => f.path.contains('.corrupt-')).toList();
+    expect(await File(backups.single.path).readAsBytes(), broken);
+    expect(jsonDecode(await target.readAsString()),
+        {'version': 1, 'accounts': {}});
+    expect(await store.addDraft('demo', session(0)), isTrue);
+  });
+
+  test(
+      '2000-record cap evicts oldest completed cases, preserving drafts and other accounts',
+      () async {
+    await store.addDraft('demo', session(0));
+    await store.addDraft('other-agent', session(0));
+    final initial = jsonDecode(await target.readAsString());
+    final template = initial['accounts']['demo'].single;
+    initial['accounts']['demo'] = [
+      template,
+      for (var n = 1999; n >= 1; n--)
+        {
+          ...template,
+          'id': id(n),
+          'status': 'saved',
+          'category': 'menu',
+          'result': 'resolved',
+          'created_at': now.add(Duration(seconds: n)).toIso8601String(),
+        }
+    ];
+    await target.writeAsString(jsonEncode(initial));
+    await store.addDraft('demo', session(2000));
+    final retained = await rows('demo');
+    expect(retained, hasLength(2000));
+    expect(retained.map((r) => r['id']), isNot(contains(id(1))));
+    expect((await store.pending('demo')).map((r) => r['id']),
+        unorderedEquals([id(0), id(2000)]));
+    expect(await store.pending('other-agent'), hasLength(1));
+    expect(resets, 0);
+  });
+}
