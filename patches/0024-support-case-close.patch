+import 'dart:convert';
+import 'dart:io';
+
+const caseFieldsRequired = true;
+const caseStoreFileName = 'support-cases-v1.json';
+
+const caseCategories = [
+  'menu',
+  'pos_operation',
+  'printer',
+  'network',
+  'payment_device',
+  'crash',
+  'hardware',
+  'other',
+];
+const caseResults = [
+  'resolved',
+  'unresolved',
+  'onsite',
+  'transferred',
+  'not_needed',
+];
+
+typedef CaseRecord = Map<String, dynamic>;
+typedef _Accounts = Map<String, List<CaseRecord>>;
+
+class CaseEditWindowExpired implements Exception {
+  const CaseEditWindowExpired();
+}
+
+abstract class CaseStore {
+  Future<List<CaseRecord>> pending(String account);
+  Future<bool> addDraft(String account, CaseRecord record);
+  Future<bool> isAppendOnly(String account, String id);
+  Future<void> defer(String account, String id,
+      {required String note, bool? expectedAppendOnly});
+  Future<void> save(String account, String id,
+      {String? category,
+      String? result,
+      Map<String, dynamic>? followUp,
+      String? transferredTo,
+      required String note,
+      bool? expectedAppendOnly});
+  Future<void> append(String account, String id, String text);
+}
+
+class LocalCaseStore implements CaseStore {
+  final Future<File> Function() file;
+  final DateTime Function() clock;
+  final void Function()? onCorrupt;
+  LocalCaseStore(
+      {required this.file, DateTime Function()? clock, this.onCorrupt})
+      : clock = clock ?? DateTime.now;
+
+  // All store instances in the main engine share the queue. The separate lock
+  // file stays in place when a writer atomically replaces the JSON file.
+  static Future<void> _queue = Future.value();
+  static final _id = RegExp(
+      r'^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$');
+
+  static DateTime _timestamp(dynamic value) {
+    final time = value is String ? DateTime.tryParse(value) : null;
+    if (time == null || !time.isUtc) {
+      throw const FormatException('UTC timestamp');
+    }
+    return time;
+  }
+
+  static bool _present(dynamic value) =>
+      value is String && value.trim().isNotEmpty;
+
+  static void _validateSession(CaseRecord row) {
+    if (row['id'] is! String ||
+        !_id.hasMatch(row['id']) ||
+        !_present(row['device_id']) ||
+        (row['display_name'] != null && row['display_name'] is! String) ||
+        (row['auto'] != null && row['auto'] is! Map) ||
+        _timestamp(row['ended_at']).isBefore(_timestamp(row['started_at']))) {
+      throw const FormatException('case session');
+    }
+  }
+
+  static _Accounts _decode(List<int> bytes) {
+    final raw = jsonDecode(utf8.decode(bytes));
+    if (raw is! Map ||
+        raw['version'] != 1 ||
+        raw['accounts'] is! Map<String, dynamic>) {
+      throw const FormatException('version/accounts');
+    }
+    final accounts = <String, List<CaseRecord>>{};
+    for (final entry in (raw['accounts'] as Map<String, dynamic>).entries) {
+      final rows = entry.value;
+      if (rows is! List) throw const FormatException('case list');
+      final records = accounts[entry.key] = [];
+      final ids = <String>{};
+      for (final row in rows) {
+        if (row is! CaseRecord ||
+            row['agent'] != entry.key ||
+            row['note'] is! String ||
+            row['appends'] is! List ||
+            (row['follow_up'] != null &&
+                (row['follow_up'] is! Map ||
+                    !_present(row['follow_up']['owner']) ||
+                    !_validDue(row['follow_up']['due']))) ||
+            (row['transferred_to'] != null &&
+                !_present(row['transferred_to'])) ||
+            !const ['draft', 'saved'].contains(row['status']) ||
+            (row['category'] != null &&
+                !caseCategories.contains(row['category'])) ||
+            (row['result'] != null && !caseResults.contains(row['result']))) {
+          throw const FormatException('case record');
+        }
+        _validateSession(row);
+        if (!ids.add(row['id'])) {
+          throw const FormatException('duplicate case id');
+        }
+        _timestamp(row['created_at']);
+        _timestamp(row['updated_at']);
+        for (final addition in row['appends']) {
+          if (addition is! Map ||
+              !_present(addition['by']) ||
+              !_present(addition['text'])) {
+            throw const FormatException('append');
+          }
+          _timestamp(addition['at']);
+        }
+        records.add(row);
+      }
+    }
+    return accounts;
+  }
+
+  static Future<void> _replace(File target, _Accounts accounts) async {
+    final tmp = File('${target.path}.tmp');
+    await tmp.writeAsString(jsonEncode({'version': 1, 'accounts': accounts}),
+        flush: true);
+    await tmp.rename(target.path);
+  }
+
+  Future<_Accounts> _read(File target) async {
+    if (!await target.exists()) return {};
+    final bytes = await target.readAsBytes();
+    try {
+      return _decode(bytes);
+    } on FormatException {
+      final stamp = clock().toUtc().toIso8601String().replaceAll(':', '-');
+      final prefix = '${target.path}.corrupt-$stamp';
+      var backup = File(prefix);
+      for (var n = 1; await backup.exists(); n++) {
+        backup = File('$prefix-$n');
+      }
+      // Leave the original file in place until both its backup and the fresh
+      // replacement are durable. An interrupted reset can then be retried.
+      await backup.writeAsBytes(bytes, flush: true);
+      await _replace(target, {});
+      onCorrupt?.call();
+      return {};
+    }
+  }
+
+  Future<T> _locked<T>(Future<T> Function(File, _Accounts) action) {
+    final next = _queue.then((_) async {
+      final target = await file();
+      await target.parent.create(recursive: true);
+      final lock =
+          await File('${target.path}.lock').open(mode: FileMode.append);
+      try {
+        await lock.lock(FileLock.blockingExclusive);
+        return await action(target, await _read(target));
+      } finally {
+        await lock.close();
+      }
+    });
+    _queue = next.then<void>((_) {}, onError: (Object _) {});
+    return next;
+  }
+
+  static int _newestFirst(CaseRecord a, CaseRecord b) =>
+      _timestamp(b['created_at']).compareTo(_timestamp(a['created_at']));
+
+  static void _trim(List<CaseRecord> rows) {
+    final excess = rows.length - 2000;
+    if (excess <= 0) return;
+    final saved = rows.where((row) => row['status'] == 'saved').toList()
+      ..sort((a, b) => _newestFirst(b, a));
+    final evict = saved.take(excess).map((row) => row['id']).toSet();
+    rows.removeWhere((row) => evict.contains(row['id']));
+  }
+
+  @override
+  Future<List<CaseRecord>> pending(String account) =>
+      _locked((_, accounts) async => [
+            ...?accounts[account]?.where((row) => row['status'] == 'draft')
+          ]..sort(_newestFirst));
+
+  @override
+  Future<bool> addDraft(String account, CaseRecord record) =>
+      _locked((target, accounts) async {
+        if (!_present(account)) throw StateError('Sign in');
+        _validateSession(record);
+        final rows = accounts.putIfAbsent(account, () => []);
+        if (rows.any((row) => row['id'] == record['id'])) return false;
+        final now = clock().toUtc().toIso8601String();
+        rows.add({
+          'id': record['id'],
+          'device_id': record['device_id'],
+          'display_name': record['display_name'] ?? record['device_id'],
+          'merchant_code': record['merchant_code'],
+          'store_code': record['store_code'],
+          'agent': account,
+          'started_at': record['started_at'],
+          'ended_at': record['ended_at'],
+          'category': null,
+          'result': null,
+          'follow_up': null,
+          'transferred_to': null,
+          'note': record['note'] as String? ?? '',
+          'auto': record['auto'] ?? <String, dynamic>{},
+          'help_id': null,
+          'created_at': now,
+          'updated_at': now,
+          'appends': [],
+          'status': 'draft',
+        });
+        _trim(rows);
+        await _replace(target, accounts);
+        return true;
+      });
+
+  static CaseRecord _find(_Accounts accounts, String account, String id) =>
+      (accounts[account] ?? const <CaseRecord>[])
+          .firstWhere((row) => row['id'] == id);
+
+  static bool _expired(CaseRecord row, DateTime now) =>
+      now.difference(_timestamp(row['created_at'])) > const Duration(hours: 24);
+
+  @override
+  Future<bool> isAppendOnly(String account, String id) =>
+      _locked((_, accounts) async =>
+          _expired(_find(accounts, account, id), clock().toUtc()));
+
+  Future<void> _edit(String account, String id,
+          void Function(CaseRecord, DateTime, bool) edit,
+          {bool? expectedAppendOnly}) =>
+      _locked((target, accounts) async {
+        final row = _find(accounts, account, id);
+        final now = clock().toUtc();
+        final expired = _expired(row, now);
+        if (expectedAppendOnly == false && expired) {
+          throw const CaseEditWindowExpired();
+        }
+        edit(row, now, expired);
+        row['updated_at'] = now.toIso8601String();
+        _trim(accounts[account]!);
+        await _replace(target, accounts);
+      });
+
+  static void _note(
+      CaseRecord row, DateTime now, String note, bool appendOnly) {
+    if (!appendOnly) {
+      row['note'] = note;
+    } else if (note.trim().isNotEmpty) {
+      (row['appends'] as List)
+          .add({'at': now.toIso8601String(), 'by': row['agent'], 'text': note});
+    }
+  }
+
+  @override
+  Future<void> defer(String account, String id,
+          {required String note, bool? expectedAppendOnly}) =>
+      _edit(account, id, (row, now, expired) {
+        if (row['status'] != 'draft') throw StateError('Case already closed');
+        _note(row, now, note, expired);
+      }, expectedAppendOnly: expectedAppendOnly);
+
+  static bool _validDue(dynamic value) {
+    if (value is! String || !RegExp(r'^\d{4}-\d{2}-\d{2}$').hasMatch(value)) {
+      return false;
+    }
+    final date = DateTime.tryParse('${value}T00:00:00Z');
+    return date != null && date.toIso8601String().startsWith('${value}T');
+  }
+
+  @override
+  Future<void> save(String account, String id,
+          {String? category,
+          String? result,
+          Map<String, dynamic>? followUp,
+          String? transferredTo,
+          required String note,
+          bool? expectedAppendOnly}) =>
+      _edit(account, id, (row, now, expired) {
+        if (expired && row['status'] == 'saved') {
+          throw StateError('Case is append only');
+        }
+        if ((category == null
+                ? caseFieldsRequired
+                : !caseCategories.contains(category)) ||
+            (result == null
+                ? caseFieldsRequired
+                : !caseResults.contains(result))) {
+          throw const FormatException('category/result');
+        }
+        final needsFollowUp = result == 'unresolved' || result == 'onsite';
+        if (needsFollowUp &&
+            (!_present(followUp?['owner']) || !_validDue(followUp?['due']))) {
+          throw const FormatException('follow_up');
+        }
+        if (result == 'transferred' && !_present(transferredTo)) {
+          throw const FormatException('transferred_to');
+        }
+        row['category'] = category;
+        row['result'] = result;
+        row['follow_up'] = needsFollowUp
+            ? {'owner': followUp!['owner'], 'due': followUp['due']}
+            : null;
+        row['transferred_to'] =
+            result == 'transferred' ? transferredTo!.trim() : null;
+        row['status'] = 'saved';
+        _note(row, now, note, expired);
+      }, expectedAppendOnly: expectedAppendOnly);
+
+  @override
+  Future<void> append(String account, String id, String text) =>
+      _edit(account, id, (row, now, _) {
+        if (!_present(text)) throw const FormatException('append text');
+        _note(row, now, text, true);
+      });
+}
