diff --git a/flutter/lib/steaddesk/cases/case_session.dart b/flutter/lib/steaddesk/cases/case_session.dart
new file mode 100644
index 0000000..d6db6e5
--- /dev/null
+++ b/flutter/lib/steaddesk/cases/case_session.dart
@@ -0,0 +1,114 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:desktop_multi_window/desktop_multi_window.dart';
+import 'package:flutter/foundation.dart';
+import 'package:uuid/uuid.dart';
+
+import '../../common.dart' show gFFI;
+import '../../consts.dart' show kMainWindowId;
+import '../../models/platform_model.dart' show bind;
+import '../support_device.dart';
+import 'case_session_ledger.dart';
+
+class CaseSession {
+  static const _uuid = Uuid();
+  static final _ledger = CaseSessionLedger(_snapshot);
+  static final _sending = <String, Future<void>>{};
+
+  static CaseData? _snapshot(CaseData event) {
+    // The main engine owns login and address-book state. Child engines do not
+    // load the active account. Snapshot here rather than attributing on close.
+    final account = gFFI.userModel.userName.value.trim();
+    if (account.isEmpty) return null;
+    final id = event['device_id'] as String;
+    final ab = gFFI.abModel;
+    final peers = [
+      for (final book in {ab.current, ...ab.addressbooks.values}) ...book.peers,
+      ...gFFI.groupModel.peers,
+      ...gFFI.recentPeersModel.peers,
+    ].where((peer) => peer.id == id);
+    final alias = peers.map((peer) => peer.alias).firstWhere(
+        (s) => s.isNotEmpty,
+        orElse: () => bind.mainGetPeerOptionSync(id: id, key: 'alias'));
+    final device = SupportDevice(
+        id: id,
+        alias: alias,
+        hostnames: [
+          event['hostname'] as String,
+          ...peers.map((p) => p.hostname)
+        ],
+        platform: event['platform'] as String,
+        groupName: '',
+        online: null);
+    final name = device.alias.isNotEmpty
+        ? device.alias
+        : device.name.isEmpty
+            ? id
+            : device.name;
+    return {
+      'id': _uuid.v4(),
+      'device_id': id,
+      'device_name': name,
+      'display_name': name,
+      'merchant_code': device.merchant,
+      'store_code': device.store,
+      'agent': account,
+      'note': '',
+      'auto': {'files': null, 'recording_id': null}
+    };
+  }
+
+  static Future<bool> route(
+          String message, Future<bool> Function(CaseData) ended) =>
+      _ledger.receive(jsonDecode(message) as CaseData, ended);
+
+  static Future<void> shutdown(Future<bool> Function(CaseData) ended) =>
+      _ledger.shutdown(DateTime.now().toUtc(), ended);
+
+  static void established(
+      String connection, String peerId, String hostname, String platform) {
+    unawaited(_send(connection, 'established',
+        {'device_id': peerId, 'hostname': hostname, 'platform': platform}));
+  }
+
+  static void message(
+      String connection, String type, String title, String text) {
+    final kind = caseEndKind(type, title, text);
+    if (kind != null) unawaited(_send(connection, kind));
+  }
+
+  static Future<void> closed(String connection) => _send(connection, 'closed');
+
+  static Future<void> _send(String connection, String kind, [CaseData? data]) {
+    if (connection.isEmpty) return Future.value();
+    final message = jsonEncode({
+      'connection': connection,
+      'kind': kind,
+      'at': DateTime.now().toUtc().toIso8601String(),
+      'event_id': _uuid.v4(),
+      ...?data
+    });
+    final next = (_sending[connection] ?? Future<void>.value()).then((_) async {
+      for (var attempt = 0; attempt < 3; attempt++) {
+        if (attempt > 0) {
+          await Future<void>.delayed(Duration(milliseconds: 200 * attempt));
+        }
+        try {
+          final ack = await DesktopMultiWindow.invokeMethod(
+                  kMainWindowId, 'steaddesk.case.lifecycle', message)
+              .timeout(const Duration(seconds: 3));
+          if (ack == true) return;
+        } catch (_) {
+          // Same event ID and timestamp on retry, including a lost reply.
+        }
+      }
+      debugPrint(
+          'Case lifecycle event $kind was not acknowledged by the main window');
+    });
+    _sending[connection] = next;
+    return next.whenComplete(() {
+      if (identical(_sending[connection], next)) _sending.remove(connection);
+    });
+  }
+}
diff --git a/flutter/lib/steaddesk/cases/case_session_ledger.dart b/flutter/lib/steaddesk/cases/case_session_ledger.dart
new file mode 100644
index 0000000..bc41d38
--- /dev/null
+++ b/flutter/lib/steaddesk/cases/case_session_ledger.dart
@@ -0,0 +1,133 @@
+// An authenticated transport can have several monitor windows. Their events
+// converge here, in the main engine, including after a tab moves to a window.
+typedef CaseData = Map<String, dynamic>;
+
+String? caseEndKind(String type, String title, String text) {
+  if (type == 'restarting-show' && title == 'Connecting...') {
+    return 'interrupted';
+  }
+  if (title == 'Connecting...' &&
+      text == 'Someone turns on privacy mode, exit') {
+    return 'closed';
+  }
+  if (title == 'Restarting remote device' && type.startsWith('restarting')) {
+    return 'closed';
+  }
+  if (title != 'Connection Error') return null;
+  if (const {'Connection not allowed', 'Incoming only mode', '连接未加密，已拒绝，请联系管理员'}
+      .contains(text)) {
+    return 'discard';
+  }
+  if (const {
+    'Closed manually by the peer',
+    'Closed manually by web console',
+    'Connection failed due to inactivity',
+    'closed'
+  }.contains(text)) {
+    return 'closed';
+  }
+  // This is the terminal transport error channel. A failed handshake or
+  // failed login has no established round, so it cannot produce a report.
+  return 'interrupted';
+}
+
+class CaseSessionLedger {
+  final CaseData? Function(CaseData event) snapshot;
+  final _active = <String, CaseData>{};
+  final _endedAt = <String, DateTime>{};
+  final _unacknowledged = <String, CaseData>{};
+  Future<void> _queue = Future.value();
+  DateTime? _lastShutdown;
+
+  CaseSessionLedger(this.snapshot);
+
+  Future<bool> receive(CaseData event, Future<bool> Function(CaseData) save) {
+    final next = _queue.then((_) => _receive(event, save));
+    _queue = next.then<void>((_) {}, onError: (Object _) {});
+    return next;
+  }
+
+  Future<bool> _receive(
+      CaseData event, Future<bool> Function(CaseData) save) async {
+    final connection = event['connection'] as String;
+    final at = DateTime.parse(event['at'] as String).toUtc();
+    final key = event['event_id'] as String;
+    if (_unacknowledged.containsKey(key)) return _persist(key, save);
+    if (_lastShutdown != null && !at.isAfter(_lastShutdown!)) return true;
+    // Ignore duplicate monitor events and IPC retries from the previous round.
+    // Sender retries last only seconds. Expire old terminal markers after a minute.
+    _endedAt.removeWhere(
+        (_, time) => at.difference(time) > const Duration(minutes: 1));
+    final endedAt = _endedAt[connection];
+    if (endedAt != null && !at.isAfter(endedAt)) return true;
+    final current = _active[connection];
+    if (event['kind'] == 'established') {
+      if (current == null) {
+        // Keep even an anonymous start until it ends; changing accounts later
+        // must never adopt an already-open session.
+        _active[connection] = {
+          ...?snapshot(event),
+          'started_at': at.toIso8601String()
+        };
+      }
+      return true;
+    }
+    if (!_finish(connection, at, event['kind'] as String, key)) return true;
+    return _persist(key, save);
+  }
+
+  bool _finish(String connection, DateTime at, String kind, String key) {
+    final current = _active[connection];
+    if (current != null && at.isBefore(DateTime.parse(current['started_at']))) {
+      return false;
+    }
+    _endedAt[connection] = at;
+    _active.remove(connection);
+    if (kind == 'discard' ||
+        current == null ||
+        current['agent'] == null ||
+        at.difference(DateTime.parse(current['started_at'])) <
+            const Duration(seconds: 30)) {
+      return false;
+    }
+    _unacknowledged[key] = {
+      ...current,
+      'ended_at': at.toIso8601String(),
+      'interrupted': kind == 'interrupted'
+    };
+    return true;
+  }
+
+  Future<bool> _persist(
+      String key, Future<bool> Function(CaseData) save) async {
+    if (!await save(_unacknowledged[key]!)) return false;
+    _unacknowledged.remove(key);
+    return true;
+  }
+
+  /// Window destruction can stop child Dart engines before dispose completes.
+  /// Drain the same main-engine queue, keeping failed writes retryable by ID.
+  Future<void> shutdown(DateTime at, Future<bool> Function(CaseData) save) {
+    final next = _queue.then((_) async {
+      for (final connection in _active.keys.toList()) {
+        _finish(connection, at.toUtc(), 'interrupted',
+            'shutdown-${_active[connection]!['id']}');
+      }
+      _lastShutdown = at;
+      Object? failed;
+      for (final entry in _unacknowledged.entries.toList()) {
+        entry.value['interrupted'] = true;
+        try {
+          if (!await _persist(entry.key, save)) {
+            failed = StateError('Case draft write was not acknowledged');
+          }
+        } catch (error) {
+          failed = error;
+        }
+      }
+      if (failed != null) throw failed;
+    });
+    _queue = next.then<void>((_) {}, onError: (Object _) {});
+    return next;
+  }
+}
