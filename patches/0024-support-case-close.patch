diff --git a/flutter/lib/steaddesk/cases/case_inbox.dart b/flutter/lib/steaddesk/cases/case_inbox.dart
new file mode 100644
index 0000000..632d2d7
--- /dev/null
+++ b/flutter/lib/steaddesk/cases/case_inbox.dart
@@ -0,0 +1,292 @@
+import 'dart:async';
+import 'dart:collection';
+import 'dart:io';
+
+import 'package:flutter/material.dart';
+import 'package:path_provider/path_provider.dart';
+
+import 'case_dialog.dart';
+import 'case_store.dart';
+
+/// The main window is the single owner of persistence and of the modal queue.
+class CaseInbox extends ChangeNotifier {
+  final CaseStore store;
+  CaseInbox(this.store);
+  final _prompts = Queue<({String account, String id})>();
+  bool recovered = false;
+
+  Future<bool> ended(Map<String, dynamic> event) async {
+    final account = event['agent'] as String;
+    final id = event['id'] as String;
+    final record = Map<String, dynamic>.of(event)..remove('interrupted');
+    final inserted = await store.addDraft(account, record);
+    if (inserted) {
+      if (event['interrupted'] != true) {
+        _prompts.add((account: account, id: id));
+      }
+      notifyListeners();
+    }
+    return true;
+  }
+
+  void selectAccount(String account) {
+    _prompts.removeWhere((item) => item.account != account);
+  }
+
+  String? next(String account) {
+    selectAccount(account);
+    return _prompts.isEmpty ? null : _prompts.removeFirst().id;
+  }
+
+  void reportRecovery() {
+    recovered = true;
+    notifyListeners();
+  }
+}
+
+final _inbox = CaseInbox(LocalCaseStore(
+    file: () async => File(
+        '${(await getApplicationSupportDirectory()).path}/$caseStoreFileName'),
+    onCorrupt: _reportRecovery));
+void _reportRecovery() => _inbox.reportRecovery();
+Future<bool> caseEnded(Map<String, dynamic> event) => _inbox.ended(event);
+
+class PendingCasesBar extends StatefulWidget {
+  const PendingCasesBar({
+    super.key,
+    required this.account,
+    required this.colleagues,
+    required this.showMainWindow,
+    this.inbox,
+  });
+  final String account;
+  final List<String> Function() colleagues;
+  final Future<void> Function() showMainWindow;
+  final CaseInbox? inbox;
+
+  @override
+  State<PendingCasesBar> createState() => _PendingCasesBarState();
+}
+
+class _PendingCasesBarState extends State<PendingCasesBar> {
+  CaseInbox get inbox => widget.inbox ?? _inbox;
+  List<Map<String, dynamic>> rows = [];
+  bool failed = false;
+  bool draining = false;
+  int revision = 0;
+  int accountEpoch = 0;
+  Route<void>? host;
+
+  @override
+  void initState() {
+    super.initState();
+    inbox.addListener(_changed);
+    _changed();
+  }
+
+  @override
+  void didUpdateWidget(PendingCasesBar oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.account != widget.account) {
+      accountEpoch++;
+      // The editor, colleague list and date picker all belong to this route.
+      final old = host;
+      if (old != null) {
+        WidgetsBinding.instance.addPostFrameCallback((_) {
+          if (old.isActive) old.navigator?.removeRoute(old);
+        });
+      }
+      inbox.selectAccount(widget.account);
+      rows = [];
+      failed = false;
+      _changed();
+    }
+  }
+
+  @override
+  void dispose() {
+    inbox.removeListener(_changed);
+    final old = host;
+    if (old != null) {
+      WidgetsBinding.instance.addPostFrameCallback((_) {
+        if (old.isActive) old.navigator?.removeRoute(old);
+      });
+    }
+    super.dispose();
+  }
+
+  void _changed() {
+    final generation = ++revision;
+    WidgetsBinding.instance.addPostFrameCallback((_) async {
+      if (!mounted || generation != revision || widget.account.isEmpty) return;
+      try {
+        final list = await inbox.store.pending(widget.account);
+        if (!mounted || generation != revision) return;
+        setState(() {
+          rows = list;
+          failed = false;
+        });
+        if (inbox.recovered) {
+          inbox.recovered = false;
+          ScaffoldMessenger.maybeOf(context)?.showSnackBar(
+            const SnackBar(content: Text('结案文件损坏，已备份并重置。')),
+          );
+        }
+        if (!draining) unawaited(_drain());
+      } catch (_) {
+        if (mounted && generation == revision) setState(() => failed = true);
+      }
+    });
+    WidgetsBinding.instance.ensureVisualUpdate();
+  }
+
+  Future<void> _drain() async {
+    if (draining) return;
+    draining = true;
+    try {
+      while (mounted && widget.account.isNotEmpty) {
+        final id = inbox.next(widget.account);
+        if (id == null) break;
+        final account = widget.account;
+        final epoch = accountEpoch;
+        try {
+          final list = await inbox.store.pending(account);
+          if (!mounted || epoch != accountEpoch) continue;
+          final match = list.where((row) => row['id'] == id);
+          if (match.isEmpty) continue;
+          await widget.showMainWindow();
+          if (mounted && epoch == accountEpoch) await _open(match.first);
+        } catch (_) {
+          // A durable draft remains available from the main window.
+          if (mounted && epoch == accountEpoch) {
+            ScaffoldMessenger.maybeOf(context)?.showSnackBar(
+              const SnackBar(content: Text('结案窗口未打开，可从待补结案重试。')),
+            );
+          }
+        }
+      }
+    } finally {
+      draining = false;
+    }
+  }
+
+  Future<void> _browse() async {
+    if (draining) return;
+    draining = true;
+    try {
+      await _open(null);
+    } finally {
+      draining = false;
+      if (mounted) _changed();
+    }
+  }
+
+  // One removable route isolates the entire dialog stack for the signed-in account.
+  Future<void> _open(Map<String, dynamic>? record) async {
+    final account = widget.account;
+    final epoch = accountEpoch;
+    final nav = Navigator.of(context, rootNavigator: true);
+    late final RawDialogRoute<void> route;
+    route = RawDialogRoute<void>(
+      barrierDismissible: false,
+      barrierColor: Colors.transparent,
+      transitionDuration: Duration.zero,
+      pageBuilder: (_, __, ___) => Navigator(
+        onGenerateRoute: (_) => PageRouteBuilder<void>(
+          opaque: false,
+          transitionDuration: Duration.zero,
+          pageBuilder: (_, __, ___) => _CaseFlow(start: (inner) async {
+            try {
+              final selected = record ?? await _choose(inner);
+              if (selected != null &&
+                  inner.mounted &&
+                  mounted &&
+                  epoch == accountEpoch) {
+                await showCaseCloseDialog(inner,
+                    store: inbox.store,
+                    account: account,
+                    record: selected,
+                    colleagues: widget.colleagues());
+              }
+            } finally {
+              if (route.isActive) nav.removeRoute(route);
+            }
+          }),
+        ),
+      ),
+    );
+    host = route;
+    // On Flutter 3.24 removeRoute does not complete Navigator.push's future.
+    nav.push(route);
+    await route.completed;
+    if (identical(host, route)) host = null;
+    if (mounted) _changed();
+  }
+
+  Future<Map<String, dynamic>?> _choose(BuildContext inner) =>
+      showDialog<Map<String, dynamic>>(
+        context: inner,
+        useRootNavigator: false,
+        builder: (context) => AlertDialog(
+          title: const Text('待补结案'),
+          content: SizedBox(
+            width: 420,
+            child: ListView(shrinkWrap: true, children: [
+              for (final row in rows)
+                ListTile(
+                  title: Text((row['display_name'] ??
+                          row['device_name'] ??
+                          row['device_id'])
+                      .toString()),
+                  subtitle: Text(DateTime.parse(row['ended_at'] as String)
+                      .toLocal()
+                      .toString()
+                      .split('.')
+                      .first),
+                  onTap: () => Navigator.of(context).pop(row),
+                ),
+            ]),
+          ),
+          actions: [
+            TextButton(
+                onPressed: () => Navigator.of(context).pop(),
+                child: const Text('关闭'))
+          ],
+        ),
+      );
+
+  @override
+  Widget build(BuildContext context) {
+    if (widget.account.isEmpty || (rows.isEmpty && !failed)) {
+      return const SizedBox.shrink();
+    }
+    return Align(
+      alignment: Alignment.centerLeft,
+      child: TextButton.icon(
+        icon: const Icon(Icons.assignment_outlined, size: 18),
+        label: Text(failed ? '结案列表读取失败，重试' : '待补结案 ${rows.length}'),
+        onPressed: failed ? _changed : _browse,
+      ),
+    );
+  }
+}
+
+class _CaseFlow extends StatefulWidget {
+  const _CaseFlow({required this.start});
+  final Future<void> Function(BuildContext) start;
+  @override
+  State<_CaseFlow> createState() => _CaseFlowState();
+}
+
+class _CaseFlowState extends State<_CaseFlow> {
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (mounted) widget.start(context);
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) => const SizedBox.shrink();
+}
