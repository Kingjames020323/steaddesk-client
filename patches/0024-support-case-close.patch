diff --git a/flutter/lib/steaddesk/cases/case_dialog.dart b/flutter/lib/steaddesk/cases/case_dialog.dart
new file mode 100644
index 0000000..d81aa8d
--- /dev/null
+++ b/flutter/lib/steaddesk/cases/case_dialog.dart
@@ -0,0 +1,628 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+import '../theme.dart';
+import 'case_store.dart';
+
+const _categories = {
+  'menu': '菜单',
+  'pos_operation': '收银操作',
+  'printer': '打印机',
+  'network': '网络',
+  'payment_device': '支付设备',
+  'crash': '系统或应用崩溃',
+  'hardware': '硬件',
+  'other': '其他',
+};
+const _results = {
+  'resolved': '已解决',
+  'unresolved': '未解决',
+  'onsite': '需上门',
+  'transferred': '转给同事…',
+  'not_needed': '商户不需要了',
+};
+const _phrases = ['重启打印机', '重新插网线', '换纸卷', '重打订单'];
+
+Future<void> showCaseCloseDialog(
+  BuildContext context, {
+  required CaseStore store,
+  required String account,
+  required Map<String, dynamic> record,
+  Iterable<String> colleagues = const [],
+}) async {
+  final appendOnly = await store.isAppendOnly(account, record['id'] as String);
+  if (!context.mounted) return;
+  await showDialog<void>(
+    context: context,
+    useRootNavigator: false,
+    barrierDismissible: false,
+    barrierColor: const Color(0x590E3A52),
+    builder: (_) => _CaseCloseDialog(
+      store: store,
+      account: account,
+      record: record,
+      appendOnly: appendOnly,
+      colleagues: colleagues
+          .map((name) => name.trim())
+          .where((name) => name.isNotEmpty && name != account)
+          .toSet()
+          .toList()
+        ..sort(),
+    ),
+  );
+}
+
+class _CaseCloseDialog extends StatefulWidget {
+  const _CaseCloseDialog(
+      {required this.store,
+      required this.account,
+      required this.record,
+      required this.appendOnly,
+      required this.colleagues});
+  final CaseStore store;
+  final String account;
+  final Map<String, dynamic> record;
+  final bool appendOnly;
+  final List<String> colleagues;
+
+  @override
+  State<_CaseCloseDialog> createState() => _CaseCloseDialogState();
+}
+
+class _CaseCloseDialogState extends State<_CaseCloseDialog> {
+  late bool appendOnly = widget.appendOnly;
+  bool get lockedFields => appendOnly && widget.record['status'] == 'saved';
+  String get original => widget.record['note'] as String? ?? '';
+  late final note = TextEditingController(text: appendOnly ? '' : original);
+  late final owner = TextEditingController(
+      text: widget.record['follow_up']?['owner'] as String? ?? widget.account);
+  late final colleague =
+      TextEditingController(text: widget.record['transferred_to'] as String?);
+  late String? category = widget.record['category'] as String?;
+  late String? result = widget.record['result'] as String?;
+  late DateTime? due =
+      DateTime.tryParse(widget.record['follow_up']?['due'] as String? ?? '');
+
+  final categoryNodes = {for (final key in _categories.keys) key: FocusNode()};
+  final resultNodes = {for (final key in _results.keys) key: FocusNode()};
+  final ownerNode = FocusNode(),
+      dateNode = FocusNode(),
+      colleagueNode = FocusNode(),
+      noteNode = FocusNode();
+  final formFocus = FocusNode(skipTraversal: true);
+  var busy = false;
+  String? error;
+
+  bool get followUp => result == 'unresolved' || result == 'onsite';
+  bool get transfer => result == 'transferred';
+
+  @override
+  void initState() {
+    super.initState();
+    _categoryTabStop();
+    FocusManager.instance.addEarlyKeyEventHandler(_key);
+  }
+
+  void _categoryTabStop() {
+    // The category chips form one Tab stop. Number keys can reach every chip.
+    for (final entry in categoryNodes.entries) {
+      entry.value.skipTraversal =
+          entry.key != (category ?? _categories.keys.first);
+    }
+  }
+
+  @override
+  void dispose() {
+    FocusManager.instance.removeEarlyKeyEventHandler(_key);
+    for (final node in [
+      ...categoryNodes.values,
+      ...resultNodes.values,
+      ownerNode,
+      dateNode,
+      colleagueNode,
+      noteNode,
+      formFocus
+    ]) {
+      node.dispose();
+    }
+    note.dispose();
+    owner.dispose();
+    colleague.dispose();
+    super.dispose();
+  }
+
+  void selectCategory(String value) {
+    setState(() {
+      category = value;
+      error = null;
+    });
+    _categoryTabStop();
+    categoryNodes[value]!.requestFocus();
+  }
+
+  KeyEventResult _key(KeyEvent event) {
+    if (event is! KeyDownEvent ||
+        !formFocus.hasFocus ||
+        ModalRoute.of(context)?.isCurrent != true) {
+      return KeyEventResult.ignored;
+    }
+    final keyboard = HardwareKeyboard.instance;
+    if (keyboard.isAltPressed ||
+        keyboard.isControlPressed ||
+        keyboard.isMetaPressed ||
+        keyboard.isShiftPressed) {
+      return KeyEventResult.ignored;
+    }
+    final key = event.logicalKey;
+    if (key == LogicalKeyboardKey.enter ||
+        key == LogicalKeyboardKey.numpadEnter) {
+      // Let a Chinese input method commit its active composition first.
+      for (final field in [note, owner, colleague]) {
+        if (!field.value.composing.isCollapsed) return KeyEventResult.ignored;
+      }
+      if (!busy && !lockedFields) {
+        for (final entry in resultNodes.entries) {
+          if (entry.value.hasPrimaryFocus) {
+            setState(() => result = entry.key);
+            break;
+          }
+        }
+      }
+      _submit();
+      return KeyEventResult.handled;
+    }
+    if (busy ||
+        lockedFields ||
+        noteNode.hasFocus ||
+        ownerNode.hasFocus ||
+        colleagueNode.hasFocus) {
+      return KeyEventResult.ignored;
+    }
+    final index = key.keyId - LogicalKeyboardKey.digit1.keyId;
+    final pad = key.keyId - LogicalKeyboardKey.numpad1.keyId;
+    final digit = index >= 0 && index < 8 ? index : pad;
+    if (digit < 0 || digit >= _categories.length) return KeyEventResult.ignored;
+    selectCategory(_categories.keys.elementAt(digit));
+    return KeyEventResult.handled;
+  }
+
+  void _missing(FocusNode node, String message) {
+    setState(() => error = message);
+    node.requestFocus();
+    final target = node.context;
+    if (target != null) Scrollable.ensureVisible(target, alignment: .5);
+  }
+
+  Future<void> _submit({bool later = false}) async {
+    if (busy) return;
+    if (!later && !lockedFields) {
+      if (caseFieldsRequired && category == null) {
+        return _missing(categoryNodes.values.first, '请选择问题类型');
+      }
+      if (caseFieldsRequired && result == null) {
+        return _missing(resultNodes.values.first, '请选择处理结果');
+      }
+      if (followUp && owner.text.trim().isEmpty) {
+        return _missing(ownerNode, '请填写跟进人');
+      }
+      if (followUp && due == null) return _missing(dateNode, '请选择跟进日期');
+      if (transfer &&
+          (colleague.text.trim().isEmpty ||
+              colleague.text.trim() == widget.account)) {
+        return _missing(colleagueNode, '请选择或填写同事账号');
+      }
+    }
+    setState(() {
+      busy = true;
+      error = null;
+    });
+    final id = widget.record['id'] as String;
+    try {
+      if (later) {
+        if (widget.record['status'] == 'saved') {
+          Navigator.of(context).pop();
+          return;
+        }
+        if (appendOnly ? note.text.trim().isNotEmpty : note.text != original) {
+          await widget.store.defer(widget.account, id,
+              note: note.text, expectedAppendOnly: appendOnly);
+        }
+      } else if (lockedFields) {
+        if (note.text.trim().isNotEmpty) {
+          await widget.store.append(widget.account, id, note.text);
+        }
+      } else {
+        await widget.store.save(widget.account, id,
+            category: category,
+            result: result,
+            followUp: followUp
+                ? {'owner': owner.text.trim(), 'due': _date(due!)}
+                : null,
+            transferredTo: transfer ? colleague.text.trim() : null,
+            note: note.text,
+            expectedAppendOnly: appendOnly);
+      }
+      if (mounted) Navigator.of(context).pop();
+    } on CaseEditWindowExpired {
+      if (!mounted) return;
+      setState(() {
+        appendOnly = true;
+        if (note.text.startsWith(original)) {
+          note.text = note.text.substring(original.length);
+        }
+        busy = false;
+        error = '已超过 24 小时，请确认要追加的说明后保存';
+      });
+      noteNode.requestFocus();
+    } catch (_) {
+      if (mounted) {
+        setState(() {
+          busy = false;
+          error = '写入失败，请重试';
+        });
+      }
+    }
+  }
+
+  String _date(DateTime day) =>
+      '${day.year}-${day.month.toString().padLeft(2, '0')}-${day.day.toString().padLeft(2, '0')}';
+
+  static const _muted =
+      TextStyle(fontSize: 12, color: SteadDeskTheme.secondaryText);
+
+  Widget _heading(String title, {bool requiredField = false, String? hint}) =>
+      Padding(
+          padding: const EdgeInsets.only(bottom: 8),
+          child: Text.rich(TextSpan(
+            text: title,
+            style: const TextStyle(
+                fontSize: 13,
+                fontWeight: FontWeight.w600,
+                color: SteadDeskTheme.bodyHighContrast),
+            children: [
+              if (requiredField && caseFieldsRequired)
+                const TextSpan(
+                    text: ' *', style: TextStyle(color: SteadDeskTheme.danger)),
+              if (hint != null)
+                TextSpan(
+                    text: '  $hint',
+                    style: _muted.copyWith(fontWeight: FontWeight.normal)),
+            ],
+          )));
+
+  Widget _choice(String label, bool selected, VoidCallback? activate,
+          {FocusNode? focus, bool autofocus = false, double height = 34}) =>
+      Semantics(
+          selected: selected,
+          child: SizedBox(
+              height: height,
+              child: OutlinedButton(
+                focusNode: focus,
+                autofocus: autofocus,
+                style: OutlinedButton.styleFrom(
+                  minimumSize: Size.zero,
+                  padding: const EdgeInsets.symmetric(horizontal: 12),
+                  tapTargetSize: MaterialTapTargetSize.shrinkWrap,
+                  shape: RoundedRectangleBorder(
+                      borderRadius: BorderRadius.circular(6)),
+                  side: BorderSide(
+                      color: selected
+                          ? SteadDeskTheme.action
+                          : SteadDeskTheme.divider,
+                      width: selected ? 2 : 1),
+                  backgroundColor: selected
+                      ? SteadDeskTheme.brandSurface
+                      : SteadDeskTheme.page,
+                  foregroundColor: selected
+                      ? SteadDeskTheme.action
+                      : SteadDeskTheme.bodyHighContrast,
+                  textStyle: Theme.of(context).textTheme.labelLarge?.copyWith(
+                      fontSize: 13,
+                      fontWeight:
+                          selected ? FontWeight.w600 : FontWeight.normal),
+                ),
+                onPressed: activate,
+                child: Text(label),
+              )));
+
+  Widget _followUp() {
+    final now = DateTime.now();
+    final tomorrow = DateTime(now.year, now.month, now.day + 1);
+    final after = DateTime(now.year, now.month, now.day + 2);
+    final custom = due != null &&
+        !DateUtils.isSameDay(due, tomorrow) &&
+        !DateUtils.isSameDay(due, after);
+    return Container(
+      width: double.infinity,
+      margin: const EdgeInsets.only(top: 12),
+      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
+      decoration: BoxDecoration(
+          color: const Color(0xFFFFF7E6),
+          borderRadius: BorderRadius.circular(8)),
+      child: Wrap(
+          spacing: 10,
+          runSpacing: 8,
+          crossAxisAlignment: WrapCrossAlignment.center,
+          children: [
+            const Text('跟进',
+                style: TextStyle(
+                    color: SteadDeskTheme.attentionText,
+                    fontWeight: FontWeight.w600)),
+            SizedBox(
+                width: 100,
+                child: TextField(
+                    controller: owner,
+                    focusNode: ownerNode,
+                    readOnly: lockedFields,
+                    style: const TextStyle(fontSize: 13),
+                    decoration: const InputDecoration(
+                        labelText: '跟进人', isDense: true))),
+            _choice('明天', DateUtils.isSameDay(due, tomorrow),
+                lockedFields ? null : () => setState(() => due = tomorrow),
+                focus: dateNode, height: 30),
+            _choice('后天', DateUtils.isSameDay(due, after),
+                lockedFields ? null : () => setState(() => due = after),
+                height: 30),
+            _choice(
+                custom ? _date(due!) : '自定…',
+                custom,
+                lockedFields
+                    ? null
+                    : () async {
+                        final selected = await showDatePicker(
+                            context: context,
+                            useRootNavigator: false,
+                            initialDate: due ?? tomorrow,
+                            firstDate: DateTime(
+                                due != null && due!.isBefore(now)
+                                    ? due!.year
+                                    : now.year),
+                            lastDate: DateTime((due?.year ?? now.year) + 100));
+                        if (mounted && selected != null) {
+                          setState(() => due = selected);
+                        }
+                      },
+                height: 30),
+          ]),
+    );
+  }
+
+  Widget _transfer() {
+    final names = widget.colleagues;
+    if (names.isEmpty || lockedFields) {
+      return TextField(
+          controller: colleague,
+          focusNode: colleagueNode,
+          readOnly: lockedFields,
+          decoration: const InputDecoration(labelText: '同事账号'));
+    }
+    return DropdownButtonFormField<String>(
+      focusNode: colleagueNode,
+      isExpanded: true,
+      decoration: const InputDecoration(labelText: '同事账号'),
+      value: names.contains(colleague.text) ? colleague.text : null,
+      items: [
+        for (final name in names)
+          DropdownMenuItem(value: name, child: Text(name))
+      ],
+      onChanged: (name) => setState(() => colleague.text = name ?? ''),
+    );
+  }
+
+  String? get duration {
+    final start =
+        DateTime.tryParse(widget.record['started_at'] as String? ?? '');
+    final end = DateTime.tryParse(widget.record['ended_at'] as String? ?? '');
+    if (start == null || end == null || end.isBefore(start)) return null;
+    final elapsed = end.difference(start);
+    if (elapsed.inMinutes == 0) return '${elapsed.inSeconds} 秒';
+    if (elapsed.inSeconds % 60 == 0) return '${elapsed.inMinutes} 分钟';
+    return '${elapsed.inMinutes} 分 ${elapsed.inSeconds % 60} 秒';
+  }
+
+  Widget _note() {
+    final appends = widget.record['appends'] as List? ?? [];
+    return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+      _heading('备注',
+          hint: !appendOnly && original.isNotEmpty ? '已带入随手记' : null),
+      if (appendOnly && original.isNotEmpty) SelectableText(original),
+      if (appendOnly)
+        for (final entry in appends.whereType<Map>())
+          Text('${entry['by']} · ${entry['text']}'),
+      TextField(
+          focusNode: noteNode,
+          controller: note,
+          minLines: 3,
+          maxLines: 4,
+          style: const TextStyle(fontSize: 13),
+          decoration: InputDecoration(
+              hintText: appendOnly ? '追加说明（原备注已锁定）' : '填写处理步骤',
+              border:
+                  OutlineInputBorder(borderRadius: BorderRadius.circular(8)),
+              isDense: true)),
+      const SizedBox(height: 8),
+      Wrap(
+          spacing: 6,
+          runSpacing: 6,
+          crossAxisAlignment: WrapCrossAlignment.center,
+          children: [
+            const Text('常用：', style: _muted),
+            for (final phrase in _phrases)
+              SizedBox(
+                  height: 28,
+                  child: OutlinedButton(
+                      style: OutlinedButton.styleFrom(
+                          minimumSize: Size.zero,
+                          tapTargetSize: MaterialTapTargetSize.shrinkWrap,
+                          foregroundColor: SteadDeskTheme.secondaryText,
+                          side: const BorderSide(color: Color(0xFFCBD5E1)),
+                          shape: RoundedRectangleBorder(
+                              borderRadius: BorderRadius.circular(6)),
+                          padding: const EdgeInsets.symmetric(horizontal: 10),
+                          textStyle: Theme.of(context)
+                              .textTheme
+                              .labelLarge
+                              ?.copyWith(fontSize: 12)),
+                      onPressed: () {
+                        final value = note.text.isEmpty
+                            ? phrase
+                            : '${note.text}\n$phrase';
+                        note.value = TextEditingValue(
+                            text: value,
+                            selection:
+                                TextSelection.collapsed(offset: value.length));
+                      },
+                      child: Text('+ $phrase'))),
+          ]),
+    ]);
+  }
+
+  Widget _fields() {
+    final auto = widget.record['auto'] as Map?;
+    final facts = [
+      if (duration != null) '时长 $duration',
+      if (auto?['files'] != null) '传输 ${auto!['files']} 个文件',
+      if (auto?['recording_id'] != null && auto!['recording_id'] != '')
+        '录像 #${auto['recording_id']}',
+    ];
+    return SingleChildScrollView(
+      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 16),
+      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+        _heading('问题类型', requiredField: true, hint: '按 1–8 选择'),
+        Wrap(spacing: 8, runSpacing: 8, children: [
+          for (final (i, entry) in _categories.entries.indexed)
+            _choice('${i + 1} ${entry.value}', category == entry.key,
+                lockedFields ? null : () => selectCategory(entry.key),
+                focus: categoryNodes[entry.key],
+                autofocus: !categoryNodes[entry.key]!.skipTraversal),
+        ]),
+        const SizedBox(height: 16),
+        _heading('结果', requiredField: true),
+        Wrap(spacing: 8, runSpacing: 8, children: [
+          for (final entry in _results.entries)
+            _choice(
+                entry.value,
+                result == entry.key,
+                lockedFields
+                    ? null
+                    : () => setState(() {
+                          result = entry.key;
+                          error = null;
+                        }),
+                focus: resultNodes[entry.key]),
+        ]),
+        if (followUp) _followUp(),
+        if (transfer) _transfer(),
+        const SizedBox(height: 16),
+        _note(),
+        if (facts.isNotEmpty)
+          ExpansionTile(
+              tilePadding: EdgeInsets.zero,
+              dense: true,
+              title: const Text('自动记录', style: _muted),
+              expandedAlignment: Alignment.centerLeft,
+              children: [
+                Align(
+                    alignment: Alignment.centerLeft,
+                    child: Text(facts.join(' · '), style: _muted))
+              ]),
+      ]),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final record = widget.record;
+    final isDraft = record['status'] != 'saved';
+    final name = [
+      record['display_name'],
+      record['device_name'],
+      record['device_id']
+    ]
+        .whereType<String>()
+        .firstWhere((s) => s.trim().isNotEmpty, orElse: () => '');
+    final helpId = record['help_id'];
+    final subtitle = [
+      if (duration != null) '会话 $duration',
+      if (helpId != null && helpId != '') '求助 #$helpId'
+    ];
+    return Focus(
+        focusNode: formFocus,
+        child: Dialog(
+          backgroundColor: SteadDeskTheme.page,
+          surfaceTintColor: Colors.transparent,
+          insetPadding:
+              const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
+          shape:
+              RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
+          child: SizedBox(
+              width: 600,
+              child: Column(
+                  mainAxisSize: MainAxisSize.min,
+                  crossAxisAlignment: CrossAxisAlignment.stretch,
+                  children: [
+                    Padding(
+                        padding: const EdgeInsets.fromLTRB(24, 20, 24, 14),
