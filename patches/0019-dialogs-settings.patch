@@ -0,0 +1,68 @@
+import 'package:flutter/material.dart';
+import 'package:settings_ui/settings_ui.dart';
+import '../common.dart' show translate;
+import '../models/platform_model.dart' show bind;
+import 'dialogs.dart' show steadUsesChinese;
+import 'theme.dart';
+
+const _mobileTheme = SettingsThemeData(
+  settingsListBackground: SteadDeskTheme.page,
+  settingsSectionBackground: SteadDeskTheme.page,
+  titleTextColor: SteadDeskTheme.heading,
+  settingsTileTextColor: SteadDeskTheme.body,
+  dividerColor: SteadDeskTheme.divider,
+  tileHighlightColor: SteadDeskTheme.hover,
+);
+
+class SteadManagedNetwork extends StatelessWidget {
+  const SteadManagedNetwork({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final managed =
+        steadUsesChinese ? '由 SteadDesk 统一配置' : 'Configured by SteadDesk';
+    const fields = {
+      'ID Server': 'custom-rendezvous-server',
+      'Relay Server': 'relay-server',
+      'API Server': 'api-server',
+      'Key': 'key',
+    };
+    return Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      for (final field in fields.entries) ...[
+        const Divider(
+            color: SteadDeskTheme.rowDivider, height: 1, thickness: 1),
+        Padding(
+            padding: const EdgeInsets.symmetric(vertical: 6),
+            child: Wrap(
+                alignment: WrapAlignment.spaceBetween,
+                spacing: 12,
+                children: [
+                  SelectableText(
+                      '${translate(field.key)}: ${bind.mainGetOptionSync(key: field.value)}'),
+                  Text(managed,
+                      style:
+                          const TextStyle(color: SteadDeskTheme.secondaryText)),
+                ])),
+      ],
+    ]);
+  }
+}
+
+/// Android settings_ui does not draw section dividers from its theme.
+class SteadSettingsList extends SettingsList {
+  SteadSettingsList(
+      {super.key, required List<AbstractSettingsSection> sections})
+      : super(lightTheme: _mobileTheme, sections: [
+          for (final section in sections)
+            if (section is SettingsSection)
+              CustomSettingsSection(
+                  child: DecoratedBox(
+                      decoration: const BoxDecoration(
+                          border: Border(
+                              bottom:
+                                  BorderSide(color: SteadDeskTheme.divider))),
+                      child: section))
+            else
+              section,
+        ]);
+}
