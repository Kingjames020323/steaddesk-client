index 0000000..8757137
--- /dev/null
+++ b/flutter/lib/steaddesk/dialogs.dart
@@ -0,0 +1,104 @@
+import 'package:flutter/material.dart';
+import '../common.dart' show CustomAlertDialog, translate;
+import '../consts.dart' show kCommConfKeyLang;
+import '../models/platform_model.dart' show bind, localeName;
+import 'theme.dart';
+
+bool get steadUsesChinese {
+  final saved = bind.mainGetLocalOption(key: kCommConfKeyLang);
+  return (saved.isEmpty ? (localeName as String? ?? '') : saved)
+      .toLowerCase()
+      .startsWith('zh');
+}
+
+String oidcButtonLabel(String provider) {
+  final label = steadUsesChinese ? '使用单点登录（OIDC）' : 'Use single sign-on (OIDC)';
+  return provider.isEmpty ? label : '$label · $provider';
+}
+
+String get oidcFailureHint => steadUsesChinese
+    ? '登录失败。可能原因：密码错误；连续输错后账号被临时锁定（约 30 分钟后自动解锁）；该账号不是客服账号（管理员请用账号密码登录）。'
+    : 'Login failed. Possible reasons: an incorrect password; a temporary lock after repeated failures (it clears automatically after about 30 minutes); or this is not a support account (administrators should sign in with their username and password).';
+
+Widget dialogAction(String key,
+        {required VoidCallback? onPressed, bool primary = true}) =>
+    TextButton(
+      onPressed: onPressed,
+      style: primary
+          ? SteadDeskTheme.button
+          : SteadDeskTheme.button.copyWith(
+              foregroundColor: MaterialStateProperty.resolveWith((states) =>
+                  states.contains(MaterialState.disabled)
+                      ? SteadDeskTheme.offline
+                      : SteadDeskTheme.body)),
+      child: Text(translate(key)),
+    );
+
+/// Keep upstream's focus, keyboard, scrolling and overlay dismissal behavior.
+class SteadDialog extends StatelessWidget {
+  const SteadDialog(
+      {super.key,
+      this.title,
+      this.titlePadding,
+      required this.content,
+      this.contentBoxConstraints = const BoxConstraints(maxWidth: 500),
+      this.actions,
+      this.onSubmit,
+      this.onCancel});
+  final Widget? title;
+  final EdgeInsetsGeometry? titlePadding;
+  final Widget content;
+  final BoxConstraints contentBoxConstraints;
+  final List<Widget>? actions;
+  final VoidCallback? onSubmit;
+  final VoidCallback? onCancel;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    const line = BorderSide(color: SteadDeskTheme.divider);
+    return Theme(
+      data: theme.copyWith(
+          dialogTheme: theme.dialogTheme.copyWith(
+              backgroundColor: SteadDeskTheme.page,
+              surfaceTintColor: Colors.transparent)),
+      child: CustomAlertDialog(
+          title: title,
+          titlePadding: titlePadding,
+          contentBoxConstraints: contentBoxConstraints,
+          content: Container(
+              decoration: BoxDecoration(
+                  border: Border(
+                      top: title == null ? BorderSide.none : line,
+                      bottom: actions == null ? BorderSide.none : line)),
+              padding: const EdgeInsets.symmetric(vertical: 12),
+              child: content),
+          actions: actions,
+          onSubmit: onSubmit,
+          onCancel: onCancel),
+    );
+  }
+}
+
+class SteadIncomingActions extends StatelessWidget {
+  const SteadIncomingActions(
+      {super.key, this.accept, this.elevate, required this.reject});
+  final VoidCallback? accept, elevate;
+  final VoidCallback reject;
+
+  @override
+  Widget build(BuildContext context) => Material(
+        color: SteadDeskTheme.page,
+        child: Column(mainAxisSize: MainAxisSize.min, children: [
+          const Divider(color: SteadDeskTheme.divider, height: 1, thickness: 1),
+          if (elevate != null)
+            Tooltip(
+                message: translate('accept_and_elevate_btn_tooltip'),
+                child: dialogAction('Accept and Elevate', onPressed: elevate)),
+          Wrap(alignment: WrapAlignment.center, children: [
+            if (accept != null) dialogAction('Accept', onPressed: accept),
+            dialogAction('Dismiss', onPressed: reject, primary: false),
+          ]),
+        ]),
+      );
+}
