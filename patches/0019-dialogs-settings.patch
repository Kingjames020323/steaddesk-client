diff --git a/flutter/lib/steaddesk/dialogs.dart b/flutter/lib/steaddesk/dialogs.dart
new file mode 100644
index 0000000..965e3b6
--- /dev/null
+++ b/flutter/lib/steaddesk/dialogs.dart
@@ -0,0 +1,160 @@
+import 'package:flutter/material.dart';
+import '../common.dart' show CustomAlertDialog, translate;
+import '../consts.dart' show kCommConfKeyLang;
+import '../models/platform_model.dart' show bind, localeName;
+import 'theme.dart';
+
+bool get steadUsesChinese {
+  final saved = bind.mainGetLocalOption(key: kCommConfKeyLang);
+  return (saved.isEmpty ? (localeName as String? ?? '') : saved)
+      .toLowerCase()
+      .startsWith('zh');
+}
+
+String oidcButtonLabel(String provider) {
+  final label = steadUsesChinese ? '使用单点登录（OIDC）' : 'Use single sign-on (OIDC)';
+  return provider.isEmpty ? label : '$label · $provider';
+}
+
+String get oidcFailureHint => steadUsesChinese
+    ? '登录失败。可能原因：密码错误；连续输错后账号被临时锁定（约 30 分钟后自动解锁）；该账号不是客服账号（管理员请用账号密码登录）。'
+    : 'Login failed. Possible reasons: an incorrect password; a temporary lock after repeated failures (it clears automatically after about 30 minutes); or this is not a support account (administrators should sign in with their username and password).';
+
+// Only reproduce public diagnostic labels. Arbitrary server text can be a
+// credential even when it has no recognizable token prefix or URL syntax.
+String oidcDetail(String message) {
+  final text = message.trim();
+  if (text.isEmpty) return '';
+  final label = text.split(RegExp(r'[:;\n\r?&#(]'))[0].trim().toLowerCase();
+  if (RegExp(r'^http [45][0-9]{2}$').hasMatch(label)) {
+    return label.toUpperCase();
+  }
+  const publicLabels = [
+    'oauth failed',
+    'Failed',
+    'Timeout',
+    'Invalid auth response',
+    'Wrong Password',
+    'Invalid credentials',
+    'Invalid password',
+    'Access denied',
+    'Unauthorized',
+    'Forbidden',
+    'Bad Request',
+    'Request failed',
+    'Internal Server Error',
+    'Connection refused',
+    'Network error',
+    'invalid_grant',
+    'access_denied',
+    'invalid_request',
+    'server_error',
+    'temporarily_unavailable',
+    'invalid_client',
+    'invalid_scope',
+    'unauthorized_client',
+    'unsupported_grant_type',
+    'login_required',
+    'interaction_required',
+    'consent_required',
+    'Account locked',
+    'Too many requests',
+    'Service unavailable',
+    'Authentication failed',
+  ];
+  for (final key in publicLabels) {
+    if (label == key.toLowerCase()) return translate(key);
+  }
+  return steadUsesChinese ? '服务端详情已隐藏' : 'Server details withheld';
+}
+
+String oidcFailureText(String message) {
+  final detail = oidcDetail(message);
+  if (detail.isEmpty) return oidcFailureHint;
+  final prefix = steadUsesChinese ? '详情：' : 'Details: ';
+  return '$oidcFailureHint\n$prefix$detail';
+}
+
+Widget dangerAction(String key, {required VoidCallback? onPressed}) =>
+    TextButton(
+        style: SteadDeskTheme.dangerButton,
+        onPressed: onPressed,
+        child: Text(translate(key)));
+
+Widget dialogAction(String key,
+        {required VoidCallback? onPressed, bool primary = true}) =>
+    TextButton(
+      onPressed: onPressed,
+      style: primary
+          ? SteadDeskTheme.button
+          : SteadDeskTheme.button.copyWith(
+              foregroundColor: MaterialStateProperty.resolveWith((states) =>
+                  states.contains(MaterialState.disabled)
+                      ? SteadDeskTheme.offline
+                      : SteadDeskTheme.body)),
+      child: Text(translate(key)),
+    );
+
+/// Keep upstream's focus, keyboard, scrolling and overlay dismissal behavior.
+class SteadDialog extends CustomAlertDialog {
+  static const _line = BorderSide(color: SteadDeskTheme.divider);
+
+  SteadDialog({
+    super.key,
+    Widget? title,
+    super.titlePadding,
+    required Widget content,
+    super.contentBoxConstraints,
+    List<Widget>? actions,
+    super.onSubmit,
+    super.onCancel,
+  }) : super(
+          title: title,
+          actions: actions,
+          content: Container(
+            decoration: BoxDecoration(
+              border: Border(
+                top: title == null ? BorderSide.none : _line,
+                bottom: actions == null ? BorderSide.none : _line,
+              ),
+            ),
+            padding: const EdgeInsets.symmetric(vertical: 12),
+            child: content,
+          ),
+        );
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    return Theme(
+      data: theme.copyWith(
+          dialogTheme: theme.dialogTheme.copyWith(
+              backgroundColor: SteadDeskTheme.page,
+              surfaceTintColor: Colors.transparent)),
+      child: super.build(context),
+    );
+  }
+}
+
+class SteadIncomingActions extends StatelessWidget {
+  const SteadIncomingActions(
+      {super.key, this.accept, this.elevate, required this.reject});
+  final VoidCallback? accept, elevate;
+  final VoidCallback reject;
+
+  @override
+  Widget build(BuildContext context) => Material(
+        color: SteadDeskTheme.page,
+        child: Column(mainAxisSize: MainAxisSize.min, children: [
+          const Divider(color: SteadDeskTheme.divider, height: 1, thickness: 1),
+          if (elevate != null)
+            Tooltip(
+                message: translate('accept_and_elevate_btn_tooltip'),
+                child: dialogAction('Accept and Elevate', onPressed: elevate)),
+          Wrap(alignment: WrapAlignment.center, children: [
+            if (accept != null) dialogAction('Accept', onPressed: accept),
+            dialogAction('Dismiss', onPressed: reject, primary: false),
+          ]),
+        ]),
+      );
+}
