diff --git a/flutter/lib/steaddesk/help_signer.dart b/flutter/lib/steaddesk/help_signer.dart
new file mode 100644
index 0000000..3233054
--- /dev/null
+++ b/flutter/lib/steaddesk/help_signer.dart
@@ -0,0 +1,57 @@
+import 'dart:convert';
+import 'dart:ffi';
+
+import 'package:ffi/ffi.dart';
+
+typedef _NativeSign = UintPtr Function(
+    Pointer<Uint8>, UintPtr, Pointer<Uint8>, UintPtr);
+typedef _Sign = int Function(Pointer<Uint8>, int, Pointer<Uint8>, int);
+
+/// Keep the receipt in application-private storage. Only [request] goes into the
+/// HTTPS POST body. Supply the original receipt when re-signing an expired retry.
+class SignedMerchantHelp {
+  final String receiptSecret;
+  final Map<String, dynamic> request;
+  SignedMerchantHelp._(this.receiptSecret, this.request);
+}
+
+class MerchantHelpSigner {
+  final DynamicLibrary _core;
+  MerchantHelpSigner(this._core);
+
+  SignedMerchantHelp sign(
+      {required String category,
+      String message = '',
+      String screenshotSha256 = '',
+      String? receiptSecret}) {
+    final input = utf8.encode(jsonEncode({
+      'category': category,
+      'message': message,
+      'screenshot_sha256': screenshotSha256,
+      if (receiptSecret != null) 'receipt_secret': receiptSecret,
+    }));
+    const capacity = 8192;
+    if (input.length > capacity) {
+      throw ArgumentError('Help fields exceed byte limit');
+    }
+    final fn = _core.lookupFunction<_NativeSign, _Sign>('steaddesk_sign_help');
+    final src = calloc<Uint8>(input.length);
+    final dest = calloc<Uint8>(capacity);
+    try {
+      src.asTypedList(input.length).setAll(0, input);
+      final count = fn(src, input.length, dest, capacity);
+      if (count <= 0 || count > capacity) {
+        throw StateError('Cannot sign help request');
+      }
+      final envelope = jsonDecode(utf8.decode(dest.asTypedList(count)))
+          as Map<String, dynamic>;
+      return SignedMerchantHelp._(envelope['receipt_secret'] as String,
+          envelope['request'] as Map<String, dynamic>);
+    } finally {
+      src.asTypedList(input.length).fillRange(0, input.length, 0);
+      dest.asTypedList(capacity).fillRange(0, capacity, 0);
+      calloc.free(src);
+      calloc.free(dest);
+    }
+  }
+}
