@@ -0,0 +1,38 @@
+import 'dart:ffi';
+import 'dart:io';
+import 'package:ffi/ffi.dart';
+import 'package:win32/win32.dart';
+export 'merchant_window_stub.dart' show merchantActiveTitle;
+import 'merchant_window_stub.dart' show merchantActiveTitle;
+
+// The upstream connection manager owns incoming connections in a separate
+// process. Activate its live panel instead of caching client IDs in the main UI.
+bool focusMerchantSession() {
+  if (!Platform.isWindows) return false;
+  return using((arena) {
+    final handle = FindWindow(
+        'FLUTTER_RUNNER_WIN32_WINDOW'.toNativeUtf16(allocator: arena),
+        merchantActiveTitle.toNativeUtf16(allocator: arena));
+    if (handle == 0) return false;
+    final pid = arena<Uint32>();
+    GetWindowThreadProcessId(handle, pid);
+    final process = OpenProcess(
+        PROCESS_ACCESS_RIGHTS.PROCESS_QUERY_LIMITED_INFORMATION,
+        FALSE,
+        pid.value);
+    if (process == 0) return false;
+    try {
+      final length = arena<Uint32>()..value = 32768;
+      final path = arena<Uint16>(length.value).cast<Utf16>();
+      if (QueryFullProcessImageName(process, 0, path, length) == 0 ||
+          path.toDartString(length: length.value).toLowerCase() !=
+              Platform.resolvedExecutable.toLowerCase()) {
+        return false;
+      }
+      ShowWindow(handle, SHOW_WINDOW_CMD.SW_RESTORE);
+      return SetForegroundWindow(handle) != 0;
+    } finally {
+      CloseHandle(process);
+    }
+  });
+}
