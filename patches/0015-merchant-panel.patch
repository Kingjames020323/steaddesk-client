@@ -0,0 +1,371 @@
+import 'dart:async';
+import 'package:device_info_plus/device_info_plus.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:window_manager/window_manager.dart';
+
+import '../common.dart';
+import '../consts.dart';
+import '../desktop/pages/desktop_home_page.dart' show setPasswordDialog;
+import '../models/platform_model.dart';
+import '../models/server_model.dart';
+import 'merchant_build.dart';
+import 'merchant_window_stub.dart'
+    if (dart.library.io) 'merchant_window_io.dart';
+
+bool get merchantWindows => merchantEdition && isWindows;
+bool get merchantAndroid => merchantEdition && isAndroid;
+const merchantSize = Size(360, 520);
+// TODO(U-01): replace these design-token values with shared theme references.
+const _blue = Color(0xff0a6fa8),
+    _pale = Color(0xffdff2fa),
+    _ink = Color(0xff0e3a52);
+const _green = Color(0xff15803d),
+    _warning = Color(0xff92400e),
+    _danger = Color(0xffdc2626);
+
+class MerchantPanel extends StatefulWidget {
+  final bool connectionManager;
+  const MerchantPanel({super.key, this.connectionManager = false});
+  @override
+  State<MerchantPanel> createState() => _MerchantPanelState();
+}
+
+class _MerchantPanelState extends State<MerchantPanel>
+    with WidgetsBindingObserver, WindowListener {
+  final model = gFFI.serverModel;
+  Timer? refresh;
+  bool? configured, notifications, battery;
+  bool busy = false;
+  String device = '', id = '';
+  bool? activeCaption;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    if (merchantWindows) windowManager.addListener(this);
+    model.addListener(changed);
+    if (widget.connectionManager) changed();
+    loadDevice();
+    sample();
+    refresh = Timer.periodic(const Duration(seconds: 3), (_) => sample());
+  }
+
+  Future<void> loadDevice() async {
+    try {
+      final info = DeviceInfoPlugin();
+      final name = merchantAndroid
+          ? await info.androidInfo.then((d) => '${d.brand} ${d.model}'.trim())
+          : await info.windowsInfo.then((d) => d.computerName);
+      if (mounted) setState(() => device = name);
+    } on Exception {/* Hide unavailable device names. */}
+  }
+
+  List<Client> get sessions => model.clients
+      .where((c) =>
+          c.authorized &&
+          !c.disconnected &&
+          !c.isFileTransfer &&
+          !c.isViewCamera &&
+          !c.isTerminal &&
+          c.portForward.isEmpty)
+      .toList();
+
+  void changed() {
+    if (!mounted) return;
+    if (widget.connectionManager) {
+      final active = sessions.isNotEmpty;
+      if (activeCaption != active) {
+        activeCaption = active;
+        windowManager.setTitle(
+            active ? merchantActiveTitle : 'SteadDesk · Connection manager');
+      }
+    }
+    setState(() {});
+  }
+
+  Future<void> sample() async {
+    if (busy || !mounted) return;
+    busy = true;
+    try {
+      final raw = await bind.mainGetMyId();
+      if (!mounted) return;
+      setState(() => id = raw);
+      if (merchantAndroid) {
+        if (configured != true) {
+          final has = await bind.mainGetCommon(key: 'permanent-password-set');
+          if (!mounted) return;
+          // A successful submission also completes setup while this read is pending.
+          if (configured != true) {
+            setState(() => configured = has == 'true'
+                ? true
+                : has == 'false'
+                    ? false
+                    : null);
+          }
+        }
+        await gFFI.invokeMethod('check_service');
+        if (configured == false) {
+          final n = androidVersion < 33 ||
+              await AndroidPermissionManager.check(kAndroid13Notification);
+          final b = await AndroidPermissionManager.check(
+              kRequestIgnoreBatteryOptimizations);
+          if (mounted)
+            setState(() {
+              notifications = n;
+              battery = b;
+            });
+        }
+      }
+    } catch (_) {
+      if (mounted && merchantAndroid && configured != true) {
+        setState(() => configured = null);
+      }
+    } finally {
+      busy = false;
+    }
+  }
+
+  @override
+  void onWindowFocus() {
+    if (merchantWindows && !widget.connectionManager) focusMerchantSession();
+  }
+
+  @override
+  void onWindowClose() {
+    if (merchantWindows && !widget.connectionManager) windowManager.hide();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) {
+      sample();
+    }
+  }
+
+  @override
+  void dispose() {
+    refresh?.cancel();
+    if (merchantWindows) windowManager.removeListener(this);
+    WidgetsBinding.instance.removeObserver(this);
+    model.removeListener(changed);
+    super.dispose();
+  }
+
+  Widget setup() {
+    Widget permission(String label, bool? granted, VoidCallback? request) =>
+        ListTile(
+            onTap: granted == false ? request : null,
+            title: Text(translate(label)),
+            trailing: Text(translate(granted == null
+                ? 'Checking'
+                : granted
+                    ? 'Granted'
+                    : 'Not granted')));
+    return ListView(padding: const EdgeInsets.all(24), children: [
+      brand(),
+      const SizedBox(height: 16),
+      Text(translate('First-time setup'),
+          style: const TextStyle(fontSize: 24, fontWeight: FontWeight.bold)),
+      permission('Screen Capture', model.mediaOk, () {
+        if (!model.mediaOk) model.startService();
+      }),
+      permission(
+          'Input Control', model.inputOk, () => showInputWarnAlert(gFFI)),
+      if (androidVersion >= 33)
+        permission('Notifications', notifications,
+            model.checkRequestNotificationPermission),
+      permission(
+          'Battery optimization exemption',
+          battery,
+          () => AndroidPermissionManager.request(
+              kRequestIgnoreBatteryOptimizations)),
+      TextButton(
+        onPressed: () => setPasswordDialog(notEmptyCallback: () {
+          if (mounted) setState(() => configured = true);
+        }),
+        child: Text(translate('Set permanent password')),
+      ),
+    ]);
+  }
+
+  Widget brand() => Row(children: [
+        Image.asset('assets/icon.png',
+            width: merchantAndroid ? 48 : 30,
+            height: merchantAndroid ? 48 : 30),
+        const SizedBox(width: 10),
+        const Flexible(
+            child: Text('SteadDesk',
+                style: TextStyle(
+                    fontWeight: FontWeight.w700, fontSize: 20, color: _ink))),
+      ]);
+
+  Widget identity() =>
+      Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+        Semantics(container: true, child: Text(translate('This device ID'))),
+        const SizedBox(height: 4),
+        Row(children: [
+          Expanded(
+              child: FittedBox(
+                  fit: BoxFit.scaleDown,
+                  alignment: Alignment.centerLeft,
+                  child: SelectableText(
+                      id.isEmpty ? translate('Generating ...') : id,
+                      style: TextStyle(
+                          fontSize: merchantAndroid ? 52 : 32,
+                          fontWeight: FontWeight.bold,
+                          letterSpacing: 1,
+                          fontFeatures: const [
+                            FontFeature.tabularFigures()
+                          ])))),
+          if (merchantWindows && id.isNotEmpty)
+            IconButton(
+                icon: const Icon(Icons.copy_outlined),
+                color: _blue,
+                tooltip: translate('Copy ID'),
+                onPressed: () => Clipboard.setData(ClipboardData(text: id)))
+        ]),
+        if (device.isNotEmpty) Text(device),
+      ]);
+
+  Widget status() {
+    final active = sessions;
+    if (active.isEmpty) {
+      final ready = model.connectStatus > 0 &&
+          id.isNotEmpty &&
+          (!merchantAndroid || (model.mediaOk && model.inputOk));
+      return Text(
+          translate(ready
+              ? (merchantAndroid ? 'Ready · No active assistance' : 'Ready')
+              : 'Not ready'),
+          style: TextStyle(
+              color: ready ? _green : _warning, fontWeight: FontWeight.w600));
+    }
+    return Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      for (final c in active)
+        Container(
+            margin: const EdgeInsets.only(bottom: 6),
+            padding: const EdgeInsets.all(14),
+            decoration: BoxDecoration(
+                color: const Color(0xfffff7e6),
+                borderRadius: BorderRadius.circular(10)),
+            child:
+                Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+              Text(translate('Remote assistance in progress'),
+                  style: const TextStyle(
+                      color: _warning, fontWeight: FontWeight.w600)),
+              if (c.name.trim().isNotEmpty) Text(c.name),
+              const SizedBox(height: 8),
+              FilledButton(
+                  style: FilledButton.styleFrom(
+                      backgroundColor: _danger,
+                      foregroundColor: Colors.white,
+                      shape: RoundedRectangleBorder(
+                          borderRadius: BorderRadius.circular(6))),
+                  onPressed: () {
+                    if (sessions.any((current) => current.id == c.id))
+                      bind.cmCloseConnection(connId: c.id);
+                  },
+                  child: Text(translate('End remote assistance'))),
+            ]))
+    ]);
+  }
+
+  Widget help() =>
+      Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+        Semantics(
+            container: true,
+            child: Text(translate('Need help?'),
+                style: const TextStyle(fontWeight: FontWeight.w600, color: _ink))),
+        const SizedBox(height: 8),
+        Text(translate('Give your device ID to support.')),
+        if (merchantPhone.trim().isNotEmpty) ...[
+          const SizedBox(height: 12),
+          Text(translate('Support phone')),
+          SelectableText(merchantPhone,
+              style: const TextStyle(fontSize: 20, color: _ink))
+        ],
+        const SizedBox(height: 20),
+        if (merchantAndroid)
+          Padding(
+              padding: const EdgeInsets.symmetric(vertical: 8),
+              child: Text('SteadDesk $merchantVersion')),
+      ]);
+
+  Widget content() {
+    if (merchantAndroid && configured != true) {
+      final page = configured == null
+          ? const Center(child: CircularProgressIndicator())
+          : setup();
+      return Column(children: [
+        if (sessions.isNotEmpty)
+          ConstrainedBox(
+              constraints: BoxConstraints(
+                  maxHeight: MediaQuery.sizeOf(context).height * .4),
+              child: SingleChildScrollView(child: status())),
+        Expanded(child: page),
+      ]);
+    }
+    if (merchantWindows)
+      return Column(children: [
+        GestureDetector(
+            onPanStart: (_) => windowManager.startDragging(),
+            child: Container(
+                color: _pale,
+                padding: const EdgeInsets.fromLTRB(20, 8, 8, 8),
+                child: Row(children: [
+                  Expanded(child: brand()),
+                  IconButton(
+                      tooltip: translate('Minimize'),
+                      icon: const Icon(Icons.minimize),
+                      onPressed: () => windowManager.minimize())
+                ]))),
+        Expanded(
+            child: ListView(
+                padding: const EdgeInsets.all(20),
+                children: [identity(), const SizedBox(height: 22), status()])),
+        const Divider(height: 1),
+        Padding(
+            padding: const EdgeInsets.all(16),
+            child: Align(alignment: Alignment.centerLeft, child: help())),
+      ]);
+    final details = Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        mainAxisAlignment: MainAxisAlignment.center,
+        children: [
+          brand(),
+          const SizedBox(height: 26),
+          status(),
+          const SizedBox(height: 22),
+          identity()
+        ]);
+    return LayoutBuilder(builder: (context, size) {
+      if (size.maxWidth < 640)
+        return ListView(padding: const EdgeInsets.all(24), children: [
+          details,
+          const SizedBox(height: 24),
+          Container(
+              color: _pale, padding: const EdgeInsets.all(16), child: help())
+        ]);
+      return Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+        Expanded(
+            flex: 2,
+            child: Center(
+                child: SingleChildScrollView(
+                    padding: const EdgeInsets.all(40), child: details))),
+        Expanded(
+            child: ColoredBox(
+                color: _pale,
+                child: SingleChildScrollView(
+                    padding: const EdgeInsets.symmetric(
+                        horizontal: 24, vertical: 40),
+                    child: help())))
+      ]);
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) =>
+      Scaffold(backgroundColor: Colors.white, body: SafeArea(child: content()));
+}
