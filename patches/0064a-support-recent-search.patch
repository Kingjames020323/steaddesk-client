+import 'dart:convert';
+
+enum SearchKind { deviceId, deviceName, store, group }
+
+class RecentSearch {
+  final String key, label;
+  final SearchKind kind;
+  const RecentSearch(this.key, this.label, this.kind);
+}
+
+class RecentSearchHistory {
+  List<RecentSearch> items = [];
+  static String option(String account) =>
+      'support-recent-search-v1-${Uri.encodeComponent(account)}';
+
+  RecentSearchHistory(String saved) {
+    if (saved.isEmpty) return;
+    try {
+      final records = jsonDecode(saved);
+      if (records is! List) return;
+      for (final record in records) {
+        if (record case [String key, String label, String kind]) {
+          final type = SearchKind.values.where((t) => t.name == kind);
+          if (type.isEmpty || items.any((r) => r.key == key)) continue;
+          items.add(RecentSearch(key, label, type.first));
+          if (items.length == 10) break;
+        }
+      }
+    } on FormatException {
+      // An unreadable preference can be replaced by the next selection.
+    }
+  }
+  String encode() => jsonEncode([
+        for (final r in items) [r.key, r.label, r.kind.name]
+      ]);
+  void remember(RecentSearch item) {
+    items = [item, ...items.where((r) => r.key != item.key).take(9)];
+  }
+}
