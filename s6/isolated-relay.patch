+    // The probe's APK is identical on both lab devices. The fixture public key
+    // is provisioned locally and is read from the private Flutter data directory.
+    #[cfg(target_os = "android")]
+    fn s6_lab_key() -> String {
+        let dir = APP_DIR.read().unwrap();
+        if Path::new(&*dir).is_absolute() {
+            if let Ok(key) = std::fs::read_to_string(Path::new(&*dir).join("s6-lab.pub")) {
+                return key;
+            }
+        }
+        RS_PUB_KEY.to_owned()
+    }
